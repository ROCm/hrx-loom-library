load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "sdk_probe.py",
    "sdk_repository.bzl",
    "sdk_tools.bzl",
    "source_policy.py",
])

iree_py_test(
    name = "sdk_probe_test",
    srcs = [
        "sdk_probe.py",
        "sdk_probe_test.py",
    ],
    main = "sdk_probe_test.py",
)

iree_py_test(
    name = "source_policy_test",
    srcs = [
        "source_policy.py",
        "source_policy_test.py",
    ],
    main = "source_policy_test.py",
)

iree_py_test(
    name = "catalog_test",
    srcs = ["catalog_test.py"],
    args = [
        "--catalog=$(rootpath //:catalog.json)",
        "--card=model/Qwen/Qwen3-Embedding-0.6B/model.json=$(rootpath //model/Qwen/Qwen3-Embedding-0.6B:model.json)",
        "--card=model/Qwen/Qwen3.8-27B/model.json=$(rootpath //model/Qwen/Qwen3.8-27B:model.json)",
        "--card=model/Qwen/Qwen3.8-Flash-Next/model.json=$(rootpath //model/Qwen/Qwen3.8-Flash-Next:model.json)",
        "--card=model/krea/Krea-2-Turbo/model.json=$(rootpath //model/krea/Krea-2-Turbo:model.json)",
        "--card=model/kyutai/pocket-tts/model.json=$(rootpath //model/kyutai/pocket-tts:model.json)",
        "--card=model/moonshine-ai/moonshine-streaming-tiny/model.json=$(rootpath //model/moonshine-ai/moonshine-streaming-tiny:model.json)",
    ],
    data = [
        "//:catalog.json",
        "//model/Qwen/Qwen3.8-27B:model.json",
        "//model/Qwen/Qwen3.8-Flash-Next:model.json",
        "//model/Qwen/Qwen3-Embedding-0.6B:model.json",
        "//model/krea/Krea-2-Turbo:model.json",
        "//model/kyutai/pocket-tts:model.json",
        "//model/moonshine-ai/moonshine-streaming-tiny:model.json",
    ],
    main = "catalog_test.py",
    deps = [
        "@hrx//loom/py/loom/model:catalog",
        "@hrx//loom/py/loom/model:manifest",
    ],
)
