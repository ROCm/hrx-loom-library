load(
    "@hrx//build_tools/bazel:python.bzl",
    "iree_py_library",
    "iree_py_test",
)

package(default_visibility = ["//visibility:private"])

iree_py_library(
    name = "dev_tools",
    srcs = glob(
        ["hrx_loom_library/**/*.py"],
        exclude = ["hrx_loom_library/**/*_test.py"],
    ),
)

iree_py_test(
    name = "bazel_tool_test",
    srcs = ["hrx_loom_library/bazel_tool_test.py"],
    main = "hrx_loom_library/bazel_tool_test.py",
    deps = [":dev_tools"],
)

iree_py_test(
    name = "benchmark_test",
    srcs = ["hrx_loom_library/commands/benchmark_test.py"],
    main = "hrx_loom_library/commands/benchmark_test.py",
    deps = [":dev_tools"],
)

