  "services": {
    "image": {
      "kind": "image",
      "version": 1,
      "options": [
        "workspace_limit_bytes"
      ],
      "interface": {
        "input": "text prompt",
        "output": "RGB image",
        "denoising_steps": 4
      },
      "constraints": {
        "width": {
          "minimum": 16,
          "maximum": 8192,
          "multiple_of": 16
        },
        "height": {
          "minimum": 16,
          "maximum": 8192,
          "multiple_of": 16
        },
        "text_tokens": {
          "minimum": 16,
          "maximum": 65536,
          "multiple_of": 16
        },
        "image_patches": {
          "expression": "(height / 16) * (width / 16)",
          "minimum": 16,
          "multiple_of": 16
        },
        "combined_sequence": {
          "expression": "image_patches + text_tokens",
          "maximum": 65536
        },
        "workspace_limit_bytes": {
          "minimum": 1,
          "description": "Exact overlapping VAE tiles when required; preparation rejects a shape that cannot meet the bound."
        }
      }
    }
  },
  "variants": {
    "bf16": {
      "description": "Original BF16 transformer, text encoder, and VAE.",
      "services": {
        "image": {
          "programs": [
            "source",
            "archive"
          ],
          "parameters": {
            "dit": {
              "files": [
                {
                  "path": "parameter/dit.safetensors",
                  "origin": "@checkpoint/transformer/diffusion_pytorch_model.safetensors",
                  "format": "safetensors"
                }
              ]
            },
            "text_encoder": {
              "files": [
