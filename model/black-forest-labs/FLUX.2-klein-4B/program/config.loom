// Standalone defaults for a 384x384 image, 512 text rows, and the four-step
// distilled schedule. Image preparation specializes every geometry value
// together before linking a serving stage. Reusable tensor motifs receive
// these facts as operands, not global reads.

config.def @klein.image_tokens = 576 : index

config.def @klein.time_count = 4 : index

config.def @klein.text_tokens = 512 : index

config.def @klein.latent_height = 48 : index

config.def @klein.latent_width = 48 : index

config.def @klein.vae_tile_height = 48 : index

config.def @klein.vae_tile_width = 48 : index

config.def @klein.batch_items = 1 : index
