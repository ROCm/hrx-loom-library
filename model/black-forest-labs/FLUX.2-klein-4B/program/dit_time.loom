// Sinusoidal timestep features and learned diffusion conditioning. Request
// times are already on the 0..1000 axis the transformer embeds, so the
// sinusoid applies no further scale. The complete physical output holds four
// adjacent BF16 modulation tables: dual-stream text, dual-stream image,
// single-stream, and output normalization. The intermediate embedding is
// scratch; padded rows are storage, not additional denoising steps.

config.decl @klein.time_count : %value: index where [range(%value, 1, 256)]

amdgpu.target<gfx11-generic> @dit_time_wave32 {subgroup_size = 32}

template.decl @time.sinusoidal_element_bf16(%half_width: index, %channel: index, %negative_log_period: f32, %time_scale: f32, %time: bf16) -> (bf16)

template.decl @activation.silu_bf16(%value: bf16) -> (bf16)

template.decl @klein.time_tables(%rows: index, %parameters: buffer, %times: buffer, %output: buffer)

command.decl @klein.time_linear_1() launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @klein.time_linear_2() launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @klein.time_modulation_text(%output_offset: offset) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @klein.time_modulation_image(%output_offset: offset) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @klein.time_modulation_single(%output_offset: offset) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @klein.time_modulation_output(%output_offset: offset) launch(%parameters: buffer, %input: buffer, %output: buffer)

kernel.def target(@dit_time_wave32) @klein_time_sinusoidal() {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %origin = index.constant 0 : offset
  %row = kernel.workgroup.id<x> : index
  %column = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%count]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x256xbf16>
  %valid = index.cmp ult, %row, %count : index
  %time = scf.if %valid -> (bf16) {
    %stored = view.load %input_view[%row] : view<[%count]xbf16> -> bf16
    scf.yield %stored : bf16
  } else {
    %padding_time = scalar.constant 0.0 : bf16
    scf.yield %padding_time : bf16
  }
  %half_width = index.constant 128 : index
  %negative_log_period = scalar.constant -9.2103403719761836 : f32
  %time_scale = scalar.constant 1.0 : f32
  %feature = template.apply<@time.sinusoidal_element_bf16>(%half_width, %column, %negative_log_period, %time_scale, %time) : (index, index, f32, f32, bf16) -> (bf16)
  view.store %feature, %output_view[%row, %column] : bf16, view<[%rows]x256xbf16>
  kernel.return
}

kernel.def target(@dit_time_wave32) @klein_time_silu() {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %groups_per_row = index.constant 12 : index
  %groups = index.mul %rows, %groups_per_row : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %width = index.constant 3072 : index
  %elements = index.mul %rows, %width : index
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<[%elements]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xbf16>
  %value = view.load %input_view[%element] : view<[%elements]xbf16> -> bf16
  %result = template.apply<@activation.silu_bf16>(%value) : (bf16) -> (bf16)
  view.store %result, %output_view[%element] : bf16, view<[%elements]xbf16>
  kernel.return
}

// Output tables per padded row: 18432 text, 18432 image, 9216 single-stream,
// and 6144 output-normalization BF16 values, each table complete before the next.
template.def<@klein.time_tables> @klein_time_tables(%rows: index, %parameters: buffer, %times: buffer, %output: buffer) {
  %feature_row_bytes = index.constant 512 : offset
  %hidden_row_bytes = index.constant 6144 : offset
  %dual_row_bytes = index.constant 36864 : offset
  %single_row_bytes = index.constant 18432 : offset
  %feature_bytes = index.scale %rows, %feature_row_bytes : index, offset -> offset
  %hidden_bytes = index.scale %rows, %hidden_row_bytes : index, offset -> offset
  %dual_bytes = index.scale %rows, %dual_row_bytes : index, offset -> offset
  %single_bytes = index.scale %rows, %single_row_bytes : index, offset -> offset
  %text_offset = index.constant 0 : offset
  %single_offset = index.add %dual_bytes, %dual_bytes : offset
  %output_offset = index.add %single_offset, %single_bytes : offset
  %features = buffer.alloca<global> align(256) %feature_bytes : buffer
  %hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %embedding = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %activated = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @klein_time_sinusoidal(%times, %features) : (buffer, buffer)
  command.launch @klein.time_linear_1(%parameters, %features, %hidden) : (buffer, buffer, buffer)
  kernel.launch @klein_time_silu(%hidden, %activated) : (buffer, buffer)
  command.launch @klein.time_linear_2(%parameters, %activated, %embedding) : (buffer, buffer, buffer)
  kernel.launch @klein_time_silu(%embedding, %activated) : (buffer, buffer)
  command.concurrent {
    command.launch @klein.time_modulation_text[%text_offset](%parameters, %activated, %output) : [offset](buffer, buffer, buffer)
    command.launch @klein.time_modulation_image[%dual_bytes](%parameters, %activated, %output) : [offset](buffer, buffer, buffer)
    command.launch @klein.time_modulation_single[%single_offset](%parameters, %activated, %output) : [offset](buffer, buffer, buffer)
    command.launch @klein.time_modulation_output[%output_offset](%parameters, %activated, %output) : [offset](buffer, buffer, buffer)
  }
  template.return
}

command.def public @klein.time_conditioning() launch(%parameters: buffer, %times: buffer, %output: buffer) {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  template.apply<@klein.time_tables>(%rows, %parameters, %times, %output) : (index, buffer, buffer, buffer)
  command.return
}
