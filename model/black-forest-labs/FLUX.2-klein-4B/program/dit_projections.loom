// double-block image query, key, value, and attention output
kernel.def target(@dit_projection_wave32) @klein_image_linear_3072_3072() {
  %rows = config.get @klein.image_tokens : index
  %minimum_wide_rows = index.constant 2048 : index
  %wide_row_tile = index.constant 256 : index
  %long_enough = index.cmp uge, %rows, %minimum_wide_rows : index
  %row_remainder = index.rem %rows, %wide_row_tile : index
  %c0_rows = index.constant 0 : index
  %whole_tiles = index.cmp eq, %row_remainder, %c0_rows : index
  %wide = scalar.andi %long_enough, %whole_tiles : i1
  %tiled_row_tile = index.constant 64 : index
  %workgroup_tile = scf.select %wide, %wide_row_tile, %tiled_row_tile : index
  %c1 = index.constant 1 : index
  %row_rounding = index.sub %workgroup_tile, %c1 : index
  %padded_rows = index.add %rows, %row_rounding : index
  %row_tiles = index.div %padded_rows, %workgroup_tile : index
  %wide_output_tiles = index.constant 24 : index
  %tiled_output_tiles = index.constant 48 : index
  %output_tiles = scf.select %wide, %wide_output_tiles, %tiled_output_tiles : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @klein.image_tokens : index
  %inputs = index.constant 3072 : index
  %outputs = index.constant 3072 : index
  %output_layout = encoding.layout.dense : encoding<layout>
  %minimum_wide_rows = index.constant 2048 : index
  %wide_row_tile = index.constant 256 : index
  %long_enough = index.cmp uge, %rows, %minimum_wide_rows : index
  %row_remainder = index.rem %rows, %wide_row_tile : index
  %c0_rows = index.constant 0 : index
  %whole_tiles = index.cmp eq, %row_remainder, %c0_rows : index
  %wide = scalar.andi %long_enough, %whole_tiles : i1
  scf.if %wide {
    %group_size = index.constant 4 : index
    template.apply<@projection.linear_wide_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
  } else {
    %minimum_grouped_rows = index.constant 2048 : index
    %group_size = template.apply<@klein.projection_row_group_size>(%rows, %minimum_grouped_rows) : (index, index) -> (index)
    template.apply<@projection.linear_tiled_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
  }
  kernel.return
}

