// Image columns start text tokens into each channel row; the image view spans
// from its first column to the last image column of channel 3071.
command.def public @klein.double_value(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %text = config.get @klein.text_tokens : index
  %image = config.get @klein.image_tokens : index
  %tokens = index.add %text, %image : index
  %origin = index.constant 0 : offset
  %input_row_bytes = index.constant 6144 : offset
  %element_bytes = index.constant 2 : offset
  %input_image = index.scale %text, %input_row_bytes : index, offset -> offset
  %output_image = index.scale %text, %element_bytes : index, offset -> offset
  %last_channel = index.constant 3071 : index
  %text_span = index.madd %last_channel, %tokens, %text : index
  %image_span = index.madd %last_channel, %tokens, %image : index
  %text_input = buffer.view %input[%origin] : buffer -> view<[%text]x3072xbf16>
  %image_input = buffer.view %input[%input_image] : buffer -> view<[%image]x3072xbf16>
  %text_output = buffer.view %output[%origin] : buffer -> view<[%text_span]xbf16>
  %image_output = buffer.view %output[%output_image] : buffer -> view<[%image_span]xbf16>
  %text_weight = command.parameter %parameters, "transformer_blocks.{}.attn.add_v_proj.weight"[%layer] : view<3072x3072xbf16>
  %image_weight = command.parameter %parameters, "transformer_blocks.{}.attn.to_v.weight"[%layer] : view<3072x3072xbf16>
  kernel.launch @klein_text_value_3072_3072(%text_input, %text_weight, %text_output) : (view<[%text]x3072xbf16>, view<3072x3072xbf16>, view<[%text_span]xbf16>)
  kernel.launch @klein_image_value_3072_3072(%image_input, %image_weight, %image_output) : (view<[%image]x3072xbf16>, view<3072x3072xbf16>, view<[%image_span]xbf16>)
  command.return
}

