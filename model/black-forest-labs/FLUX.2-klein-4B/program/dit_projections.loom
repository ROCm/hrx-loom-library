// Packed text embeddings [text, 7680] and latent tokens [image, 128] become
// one joint sequence: text rows first, then image rows.
command.def public @klein.dit_embedding() launch(%parameters: buffer, %text_input: buffer, %image_input: buffer, %output: buffer) {
  %text = config.get @klein.text_tokens : index
  %image = config.get @klein.image_tokens : index
  %origin = index.constant 0 : offset
  %output_row_bytes = index.constant 6144 : offset
  %output_image = index.scale %text, %output_row_bytes : index, offset -> offset
  %text_view = buffer.view %text_input[%origin] : buffer -> view<[%text]x7680xbf16>
  %image_view = buffer.view %image_input[%origin] : buffer -> view<[%image]x128xbf16>
  %text_output = buffer.view %output[%origin] : buffer -> view<[%text]x3072xbf16>
  %image_output = buffer.view %output[%output_image] : buffer -> view<[%image]x3072xbf16>
  %text_weight = command.parameter %parameters, "context_embedder.weight" : view<3072x7680xbf16>
  %image_weight = command.parameter %parameters, "x_embedder.weight" : view<3072x128xbf16>
  command.concurrent {
    kernel.launch @klein_text_linear_7680_3072(%text_view, %text_weight, %text_output) : (view<[%text]x7680xbf16>, view<3072x7680xbf16>, view<[%text]x3072xbf16>)
    kernel.launch @klein_image_linear_128_3072(%image_view, %image_weight, %image_output) : (view<[%image]x128xbf16>, view<3072x128xbf16>, view<[%image]x3072xbf16>)
  }
  command.return
}

// Modulated image rows [image, 3072] to packed latent velocity [image, 128].
command.def public @klein.dit_output() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %image = config.get @klein.image_tokens : index
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<[%image]x3072xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%image]x128xbf16>
  %weight = command.parameter %parameters, "proj_out.weight" : view<128x3072xbf16>
  kernel.launch @klein_image_linear_3072_128(%input_view, %weight, %output_view) : (view<[%image]x3072xbf16>, view<128x3072xbf16>, view<[%image]x128xbf16>)
  command.return
}

