// Commands bind checkpoint tensors to the leaves above.
command.def public @klein.time_linear_1() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<[%rows]x256xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x3072xbf16>
  %weight = command.parameter %parameters, "time_guidance_embed.timestep_embedder.linear_1.weight" : view<3072x256xbf16>
  kernel.launch @klein_time_linear_256_3072(%input_view, %weight, %output_view) : (view<[%rows]x256xbf16>, view<3072x256xbf16>, view<[%rows]x3072xbf16>)
  command.return
}

