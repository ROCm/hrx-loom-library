command.def public @klein.time_modulation_text(%output_offset: offset) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %count = config.get @klein.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
