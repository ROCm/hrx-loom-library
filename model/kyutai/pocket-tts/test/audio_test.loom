// Voice preprocessing is checked against a direct F64 convolution and known
// pause endpoints. The reference uses a Kaiser-windowed sinc with beta=5,
// independently evaluates I0 by quadrature, and sums complete input frames.
// Production uses F32 polyphase accumulation and reduced-angle trigonometry.
// Every sample, block count, and padded byte extent is observed within 2e-6.
//
// The waveforms and acceptance follow Pocket ec569b2 audio_utils.py and its
// SciPy resample_poly / Torch end_on_pause behavior: 20 ms analysis/fade,
// 80 ms appended silence, and 1920-sample blocks. Boundary waveforms have known
// retained endpoints, so the oracle does not repeat the RMS trimming algorithm.

func.decl @pocket.prepare_audio(%samples: buffer, %rate: i64, %channels: i64) -> (buffer, i32)

// Resampling uses 31 frames at eight rates with one, two, or six channels.
// The remaining trials exercise 20 ms and block boundaries, all-zero audio,
// and two voiced windows followed by four silent windows at 24 kHz.
func.def @audio_geometry(%trial: index) -> (index, index, index, index, i64, i64) {
  %resampling_trials = index.constant 24 : index
  %resampling = index.cmp ult, %trial, %resampling_trials : index
  %frames, %channels, %voiced, %retained, %up, %down = scf.if %resampling -> (index, index, index, index, i64, i64) {
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %c2 = index.constant 2 : index
    %c3 = index.constant 3 : index
    %c6 = index.constant 6 : index
    %rate_index = index.div %trial, %c3 : index
    %channel_index = index.rem %trial, %c3 : index
    %six_channels = index.cmp eq, %channel_index, %c2 : index
    %channel_pair = index.add %channel_index, %c1 : index
    %channels = scf.select %six_channels, %c6, %channel_pair : index
    %c1_i64 = scalar.constant 1 : i64
    %c2_i64 = scalar.constant 2 : i64
    %c3_i64 = scalar.constant 3 : i64
    %c4_i64 = scalar.constant 4 : i64
    %c80 = scalar.constant 80 : i64
    %c147 = scalar.constant 147 : i64
    %c160 = scalar.constant 160 : i64
    // Reduced ratios for 8, 16, 22.05, 24, 32, 44.1, 48, and 96 kHz.
    %ups = vector.from_elements %c3_i64, %c3_i64, %c160, %c1_i64, %c3_i64, %c80, %c1_i64, %c1_i64 : vector<8xi64>
    %downs = vector.from_elements %c1_i64, %c2_i64, %c147, %c1_i64, %c4_i64, %c147, %c2_i64, %c4_i64 : vector<8xi64>
    %up = vector.extract %ups[%rate_index] : vector<8xi64> -> i64
    %down = vector.extract %downs[%rate_index] : vector<8xi64> -> i64
    %frames = index.constant 31 : index
    scf.yield %frames, %channels, %frames, %c0, %up, %down : index, index, index, index, i64, i64
  } else {
    %pause_trial = index.sub %trial, %resampling_trials : index
    %c0 = scalar.constant 0 : i32
    %c479 = scalar.constant 479 : i32
    %c480 = scalar.constant 480 : i32
    %c481 = scalar.constant 481 : i32
    %c960 = scalar.constant 960 : i32
    %c1440 = scalar.constant 1440 : i32
    %c1920 = scalar.constant 1920 : i32
    %c1921 = scalar.constant 1921 : i32
    %c2880 = scalar.constant 2880 : i32
    %frame_counts = vector.from_elements %c479, %c480, %c481, %c1920, %c1921, %c1440, %c2880 : vector<7xi32>
    %voiced_counts = vector.from_elements %c479, %c480, %c481, %c1920, %c1921, %c0, %c960 : vector<7xi32>
    // Silence keeps all complete windows: upstream adds epsilon to each RMS.
    %retained_counts = vector.from_elements %c479, %c480, %c480, %c1920, %c1920, %c1440, %c960 : vector<7xi32>
    %frames32 = vector.extract %frame_counts[%pause_trial] : vector<7xi32> -> i32
    %voiced32 = vector.extract %voiced_counts[%pause_trial] : vector<7xi32> -> i32
    %retained32 = vector.extract %retained_counts[%pause_trial] : vector<7xi32> -> i32
    %frames = index.cast %frames32 : i32 to index
    %voiced = index.cast %voiced32 : i32 to index
    %retained = index.cast %retained32 : i32 to index
    %channels = index.constant 1 : index
    %unit = scalar.constant 1 : i64
    scf.yield %frames, %channels, %voiced, %retained, %unit, %unit : index, index, index, index, i64, i64
  }
  func.return %frames, %channels, %voiced, %retained, %up, %down : index, index, index, index, i64, i64
}

func.def @audio_dimensions(%trial: index) -> (index, index) {
  %frames, %channels, %voiced, %retained, %up, %down = func.call @audio_geometry(%trial) : (index) -> (index, index, index, index, i64, i64)
  %inputs = index.mul %frames, %channels : index
  %first_paused = index.constant 25 : index
  %short = index.cmp ult, %trial, %first_paused : index
  %one_block = index.constant 1920 : index
  %two_blocks = index.constant 3840 : index
  %outputs = scf.select %short, %one_block, %two_blocks : index
  func.return %inputs, %outputs : index, index
}

func.def @audio_waveform(%trial: index, %input: buffer) {
  %frames, %channels, %voiced, %retained, %up, %down = func.call @audio_geometry(%trial) : (index) -> (index, index, index, index, i64, i64)
  %count = index.mul %frames, %channels : index
  %voiced_count = index.mul %voiced, %channels : index
  %origin = index.constant 0 : offset
  %samples = buffer.view %input[%origin] : buffer -> view<[%count]xf32>
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %period = index.constant 17 : index
  %bias = scalar.constant 8 : i32
  %step = scalar.constant 0.0625 : f32
  %silence = scalar.constant 0.0 : f32
  scf.for %i = [%begin to %count step %unit] {
    %position = index.rem %i, %period : index
    %word = index.cast %position : index to i32
    %centered = scalar.subi %word, %bias : i32
    %value = scalar.sitofp %centered : i32 to f32
    %ramp = scalar.mulf %value, %step : f32
    %active = index.cmp ult, %i, %voiced_count : index
    %sample = scf.select %active, %ramp, %silence : f32
    view.store %sample, %samples[%i] : f32, view<[%count]xf32>
  }
  func.return
}

// I0(x) = integral(exp(x*cos(t)), t=0..pi)/pi. Sixteen midpoint samples
// on this half-period give the 32-point periodic trapezoid; for 0 <= x <= 5
// its first omitted Fourier term, 2*I32(x), is below 5e-23. This avoids
// sharing the production implementation's Bessel power-series recurrence.
func.def @audio_bessel_reference(%argument: f64) -> (f64) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %points = index.constant 16 : index
  %half = scalar.constant 0.5 : f64
  %pi = scalar.constant 3.1415926535897931 : f64
  %divisor = scalar.constant 16.0 : f64
  %c0 = scalar.constant 0.0 : f64
  %sum = scf.for %i = [%begin to %points step %unit](%sum = %c0 : f64) -> (f64) {
    %word = index.cast %i : index to i32
    %position = scalar.uitofp %word : i32 to f64
    %midpoint = scalar.addf %position, %half : f64
    %angle_scale = scalar.mulf %midpoint, %pi : f64
    %angle = scalar.divf %angle_scale, %divisor : f64
    %cosine = scalar.cosf %angle : f64
    %exponent = scalar.mulf %argument, %cosine : f64
    %term = scalar.expf %exponent : f64
    %next = scalar.addf %sum, %term : f64
    scf.yield %next : f64
  }
  %average = scalar.divf %sum, %divisor : f64
  func.return %average : f64
}

// Direct full-angle sinc times the beta=5 Kaiser window. The constant
// denominator I0(5) cancels when the complete filter is DC-normalized.
func.def @audio_tap_reference(%position: i64, %scale: i64) -> (f64) {
  %c0 = scalar.constant 0 : i64
  %unit = scalar.constant 1.0 : f64
  %pi = scalar.constant 3.1415926535897931 : f64
  %c10 = scalar.constant 10.0 : f64
  %beta = scalar.constant 5.0 : f64
  %position64 = scalar.sitofp %position : i64 to f64
  %scale64 = scalar.uitofp %scale : i64 to f64
  %cycles = scalar.divf %position64, %scale64 : f64
  %center = scalar.cmpi eq, %position, %c0 : i64
  %sinc = scf.if %center -> (f64) {
    scf.yield %unit : f64
  } else {
    %angle = scalar.mulf %pi, %cycles : f64
    %sine = scalar.sinf %angle : f64
    %value = scalar.divf %sine, %angle : f64
    scf.yield %value : f64
  }
  %normalized = scalar.divf %cycles, %c10 : f64
  %square = scalar.mulf %normalized, %normalized : f64
  %remaining = scalar.subf %unit, %square : f64
  %root = scalar.sqrtf %remaining : f64
  %argument = scalar.mulf %beta, %root : f64
  %window = func.call @audio_bessel_reference(%argument) : (f64) -> (f64)
  %tap = scalar.mulf %sinc, %window : f64
  func.return %tap : f64
}

func.def @audio_resampling_reference(%channels: index, %up: i64, %down: i64, %input: buffer, %output: buffer) {
  %frames = index.constant 31 : index
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<31x[%channels]xf32>
  %result = buffer.view %output[%origin] : buffer -> view<1920xf32>
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %c0 = scalar.constant 0.0 : f64
  %channels64 = index.cast %channels : index to i64
  %channel_divisor = scalar.uitofp %channels64 : i64 to f64
  %mono_bytes = index.constant 248 : offset
  %mono_storage = buffer.alloca<private> align(16) %mono_bytes : buffer
  %mono = buffer.view %mono_storage[%origin] : buffer -> view<31xf64>
  scf.for %frame = [%begin to %frames step %unit] {
    %sum = scf.for %channel = [%begin to %channels step %unit](%sum = %c0 : f64) -> (f64) {
      %value = view.load %source[%frame, %channel] : view<31x[%channels]xf32> -> f32
      %wide = scalar.extf %value : f32 to f64
      %next = scalar.addf %sum, %wide : f64
      scf.yield %next : f64
    }
    %value = scalar.divf %sum, %channel_divisor : f64
    view.store %value, %mono[%frame] : f64, view<31xf64>
  }
  %identity = scalar.cmpi eq, %up, %down : i64
  scf.if %identity {
    scf.for %i = [%begin to %frames step %unit] {
      %value = view.load %mono[%i] : view<31xf64> -> f64
      %rounded = scalar.fptrunc %value : f64 to f32
      view.store %rounded, %result[%i] : f32, view<1920xf32>
    }
  } else {
    %scale = scalar.maxui %up, %down : i64
    %c10 = scalar.constant 10 : i64
    %c2 = scalar.constant 2 : i64
    %c1 = scalar.constant 1 : i64
    %half = scalar.muli %scale, %c10 : i64
    %extent = scalar.muli %half, %c2 : i64
    %tap_count64 = scalar.addi %extent, %c1 : i64
    %tap_count = index.cast %tap_count64 : i64 to index
    %word = index.constant 8 : offset
    %bytes = index.scale %tap_count, %word : index, offset -> offset
    %storage = buffer.alloca<private> align(16) %bytes : buffer
    %taps = buffer.view %storage[%origin] : buffer -> view<[%tap_count]xf64>
    %sum = scf.for %i = [%begin to %tap_count step %unit](%sum = %c0 : f64) -> (f64) {
      %ordinal = index.cast %i : index to i64
      %position = scalar.subi %ordinal, %half : i64
      %value = func.call @audio_tap_reference(%position, %scale) : (i64, i64) -> (f64)
      view.store %value, %taps[%i] : f64, view<[%tap_count]xf64>
      %next = scalar.addf %sum, %value : f64
      scf.yield %next : f64
    }
    %up64 = scalar.uitofp %up : i64 to f64
    %normalization = scalar.divf %up64, %sum : f64
    %frames64 = scalar.constant 31 : i64
    %expanded = scalar.muli %frames64, %up : i64
    %tail = scalar.subi %down, %c1 : i64
    %rounded_count = scalar.addi %expanded, %tail : i64
    %count64 = scalar.divui %rounded_count, %down : i64
    %count = index.cast %count64 : i64 to index
    scf.for %i = [%begin to %count step %unit] {
      %ordinal = index.cast %i : index to i64
      %time = scalar.muli %ordinal, %down : i64
      %center = scalar.addi %time, %half : i64
      %sum = scf.for %j = [%begin to %frames step %unit](%sum = %c0 : f64) -> (f64) {
        %frame = index.cast %j : index to i64
        %source_time = scalar.muli %frame, %up : i64
        %tap = scalar.subi %center, %source_time : i64
        %inside = scalar.cmpi ult, %tap, %tap_count64 : i64
        %next = scf.if %inside -> (f64) {
          %tap_index_value = index.cast %tap : i64 to index
          %tap_index = index.assume %tap_index_value [ge(%tap_index_value, 0), lt(%tap_index_value, %tap_count)] : index
          %coefficient = view.load %taps[%tap_index] : view<[%tap_count]xf64> -> f64
          %sample = view.load %mono[%j] : view<31xf64> -> f64
          %product = scalar.mulf %coefficient, %sample : f64
          %next = scalar.addf %sum, %product : f64
          scf.yield %next : f64
        } else {
          scf.yield %sum : f64
        }
        scf.yield %next : f64
      }
      %value = scalar.mulf %sum, %normalization : f64
      %rounded = scalar.fptrunc %value : f64 to f32
      %position = index.assume %i [ge(%i, 0), lt(%i, 1920)] : index
      view.store %rounded, %result[%position] : f32, view<1920xf32>
    }
  }
  func.return
}

func.def @audio_reference(%trial: index, %input: buffer, %output: buffer) -> (i32, offset) {
  %frames, %channels, %voiced, %retained, %up, %down = func.call @audio_geometry(%trial) : (index) -> (index, index, index, index, i64, i64)
  %inputs, %outputs = func.call @audio_dimensions(%trial) : (index) -> (index, index)
  %origin = index.constant 0 : offset
  %sample_bytes = index.constant 4 : offset
  %bytes = index.scale %outputs, %sample_bytes : index, offset -> offset
  %c0 = scalar.constant 0 : i32
  buffer.fill %c0, %output[%origin], %bytes : i32
  %resampling_trials = index.constant 24 : index
  %resampling = index.cmp ult, %trial, %resampling_trials : index
  scf.if %resampling {
    func.call @audio_resampling_reference(%channels, %up, %down, %input, %output) : (index, i64, i64, buffer, buffer)
  } else {
    %source = buffer.view %input[%origin] : buffer -> view<[%inputs]xf32>
    %result = buffer.view %output[%origin] : buffer -> view<[%outputs]xf32>
    %begin = index.constant 0 : index
    %unit = index.constant 1 : index
    %window = index.constant 480 : index
    %fades = index.cmp uge, %retained, %window : index
    %last = index.sub %retained, %unit : index
    %c1 = scalar.constant 1.0 : f64
    %denominator = scalar.constant 479.0 : f64
    scf.for %i = [%begin to %retained step %unit] {
      %remaining = index.sub %last, %i : index
      %word = index.cast %remaining : index to i64
      %distance = scalar.uitofp %word : i64 to f64
      %fraction = scalar.divf %distance, %denominator : f64
      %clamped = scalar.minimumf %fraction, %c1 : f64
      %factor = scf.select %fades, %clamped, %c1 : f64
      %input_position = index.assume %i [ge(%i, 0), lt(%i, %inputs)] : index
      %sample = view.load %source[%input_position] : view<[%inputs]xf32> -> f32
      %wide = scalar.extf %sample : f32 to f64
      %faded = scalar.mulf %wide, %factor : f64
      %rounded = scalar.fptrunc %faded : f64 to f32
      %output_position = index.assume %i [ge(%i, 0), lt(%i, %outputs)] : index
      view.store %rounded, %result[%output_position] : f32, view<[%outputs]xf32>
    }
  }
  %block_samples = index.constant 1920 : index
  %blocks_index = index.div %outputs, %block_samples : index
  %blocks = index.cast %blocks_index : index to i32
  func.return %blocks, %bytes : i32, offset
}

// Observe the real returned extent and block count, and copy its available
// prefix into the test tensor. A wrong extent remains an explicit mismatch.
func.def @audio_observation(%trial: index, %input: buffer, %output: buffer) -> (i32, offset) {
  %frames, %channels, %voiced, %retained, %up, %down = func.call @audio_geometry(%trial) : (index) -> (index, index, index, index, i64, i64)
  %destination_rate = scalar.constant 24000 : i64
  %product = scalar.muli %destination_rate, %down : i64
  %rate = scalar.divui %product, %up : i64
  %channels64 = index.cast %channels : index to i64
  %result, %blocks = func.call @pocket.prepare_audio(%input, %rate, %channels64) : (buffer, i64, i64) -> (buffer, i32)
  %size = buffer.length %result
  %capacity = buffer.length %output
  %fits = index.cmp ule, %size, %capacity : offset
  %copy_size = scf.select %fits, %size, %capacity : offset
  %origin = index.constant 0 : offset
  buffer.copy %result[%origin], %output[%origin], %copy_size
  func.return %blocks, %size : i32, offset
}

func.def @audio_pause_trial(%trial: index) -> (index) {
  %resampling_trials = index.constant 24 : index
  %ordinal = index.add %trial, %resampling_trials : index
  func.return %ordinal : index
}

check.scenario public @voice_resampling {
  check.trial[24](%trial: index, %entropy: check.entropy) {
    %inputs, %outputs = check.generate<@audio_dimensions>(%trial) : (index) -> (index, index)
    %input = check.generate.fill value(0.0) : tensor<[%inputs]xf32>
    check.generate<@audio_waveform>(%trial, %input) : (index, tensor<[%inputs]xf32>) -> ()
    %output = check.generate.fill value(-123.0) : tensor<[%outputs]xf32>
    check.compare<@audio_observation, @audio_reference>(%trial, %input, %output) : (index, tensor<[%inputs]xf32>, tensor<[%outputs]xf32>) -> [actual(%blocks: i32, %size: offset), expected(%expected_blocks: i32, %expected_size: offset)] {
      check.expect.equal actual(%blocks) expected(%expected_blocks) : i32
      check.expect.equal actual(%size) expected(%expected_size) : offset
      check.expect.approximate actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(0.0) nan(different) : tensor<[%outputs]xf32>, tensor<[%outputs]xf32>
    }
  }
  check.return
}

check.scenario public @voice_pause_and_padding {
  check.trial[7](%trial: index, %entropy: check.entropy) {
    %ordinal = check.generate<@audio_pause_trial>(%trial) : (index) -> (index)
    %inputs, %outputs = check.generate<@audio_dimensions>(%ordinal) : (index) -> (index, index)
    %input = check.generate.fill value(0.0) : tensor<[%inputs]xf32>
    check.generate<@audio_waveform>(%ordinal, %input) : (index, tensor<[%inputs]xf32>) -> ()
    %output = check.generate.fill value(-123.0) : tensor<[%outputs]xf32>
    check.compare<@audio_observation, @audio_reference>(%ordinal, %input, %output) : (index, tensor<[%inputs]xf32>, tensor<[%outputs]xf32>) -> [actual(%blocks: i32, %size: offset), expected(%expected_blocks: i32, %expected_size: offset)] {
      check.expect.equal actual(%blocks) expected(%expected_blocks) : i32
      check.expect.equal actual(%size) expected(%expected_size) : offset
      check.expect.approximate actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(0.0) nan(different) : tensor<[%outputs]xf32>, tensor<[%outputs]xf32>
    }
  }
  check.return
}

check.benchmark<@voice_resampling> @voice_resampling_benchmark

check.benchmark<@voice_pause_and_padding> @voice_pause_and_padding_benchmark
