// Oracle: Pocket ec569b2, SciPy 1.18.1 resample_poly, and Torch 2.9.1
// end_on_pause. Whole output is checked, including fade, silence, and padding.
// Rates exercise interpolation, decimation, coprime phases, and identity;
// mono, stereo, and six channels use independently averaged reference input.

func.decl @pocket.prepare_audio(%samples: buffer, %rate: i64, %channels: i64) -> (buffer, i32)

global.rodata.def @audio_inputs = align(16) bytes("")

global.rodata.def @audio_outputs = align(16) bytes("")

global.rodata.def @audio_records = align(16) bytes("")

func.def @audio_observations() -> (i32, f32) {
  %input_storage = global.load @audio_inputs : buffer
  %expected_storage = global.load @audio_outputs : buffer
  %record_storage = global.load @audio_records : buffer
  %origin = index.constant 0 : offset
  %cases = index.constant 31 : index
  %records = buffer.view %record_storage[%origin] : buffer -> view<31x7xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %initial_error = scalar.constant 0.0 : f32
  %first_error, %maximum_error = scf.for %i = [%c0 to %cases step %c1](%first_error = %c0_i32 : i32, %maximum_error = %initial_error : f32) -> (i32, f32) {
    %input_offset32 = view.load %records[%i, 0] : view<31x7xi32> -> i32
    %input_bytes32 = view.load %records[%i, 1] : view<31x7xi32> -> i32
    %rate32 = view.load %records[%i, 2] : view<31x7xi32> -> i32
    %channels32 = view.load %records[%i, 3] : view<31x7xi32> -> i32
    %expected_offset32 = view.load %records[%i, 4] : view<31x7xi32> -> i32
    %expected_count32 = view.load %records[%i, 5] : view<31x7xi32> -> i32
    %expected_blocks = view.load %records[%i, 6] : view<31x7xi32> -> i32
    %input_offset = index.cast %input_offset32 : i32 to offset
    %input_bytes = index.cast %input_bytes32 : i32 to offset
    %input = buffer.alloca<private> align(16) %input_bytes : buffer
    buffer.copy %input_storage[%input_offset], %input[%origin], %input_bytes
    %rate = scalar.extui %rate32 : i32 to i64
    %channels = scalar.extui %channels32 : i32 to i64
    %output, %blocks = func.call @pocket.prepare_audio(%input, %rate, %channels) : (buffer, i64, i64) -> (buffer, i32)
    %size = buffer.length %output
    %block_bytes = scalar.constant 7680 : i32
    %expected_bytes32 = scalar.muli %expected_blocks, %block_bytes : i32
    %expected_bytes = index.cast %expected_bytes32 : i32 to offset
    %same_size = index.cmp eq, %size, %expected_bytes : offset
    %same_blocks = scalar.cmpi eq, %blocks, %expected_blocks : i32
    %same = scalar.andi %same_size, %same_blocks : i1
    %ordinal = index.add %i, %c1 : index
    %ordinal32 = index.cast %ordinal : index to i32
    %error = scf.select %same, %c0_i32, %ordinal32 : i32
    %unset = scalar.cmpi eq, %first_error, %c0_i32 : i32
    %next_error = scf.select %unset, %error, %first_error : i32
    %next_maximum = scf.if %same -> (f32) {
      %expected_count = index.cast %expected_count32 : i32 to index
      %expected_offset = index.cast %expected_offset32 : i32 to offset
      %sample_bytes = index.constant 4 : offset
      %reference_bytes = index.scale %expected_count, %sample_bytes : index, offset -> offset
      %reference_storage = buffer.alloca<private> align(16) %reference_bytes : buffer
      buffer.copy %expected_storage[%expected_offset], %reference_storage[%origin], %reference_bytes
      %expected = buffer.view %reference_storage[%origin] : buffer -> view<[%expected_count]xf32>
      %block_samples = index.constant 1920 : index
      %blocks_index = index.cast %blocks : i32 to index
      %count = index.mul %blocks_index, %block_samples : index
      %actual = buffer.view %output[%origin] : buffer -> view<[%count]xf32>
      %maximum = scf.for %j = [%c0 to %count step %c1](%maximum = %maximum_error : f32) -> (f32) {
        %populated = index.cmp ult, %j, %expected_count : index
        %reference = scf.if %populated -> (f32) {
          %value = view.load %expected[%j] : view<[%expected_count]xf32> -> f32
          scf.yield %value : f32
        } else {
          scf.yield %initial_error : f32
        }
        %value = view.load %actual[%j] : view<[%count]xf32> -> f32
        %difference = scalar.subf %value, %reference : f32
        %distance = scalar.absf %difference : f32
        %next = scalar.maximumf %maximum, %distance : f32
        scf.yield %next : f32
      }
      scf.yield %maximum : f32
    } else {
      scf.yield %maximum_error : f32
    }
    scf.yield %next_error, %next_maximum : i32, f32
  }
  func.return %first_error, %maximum_error : i32, f32
}

check.case @upstream_voice_preparation {
  %error, %maximum = func.call @audio_observations() : () -> (i32, f32)
  %c0 = check.literal value(0) : i32
  %expected = check.literal value(0.0) : f32
  check.expect.equal actual(%error) expected(%c0) : i32
  check.expect.approximate actual(%maximum) expected(%expected) atol(1.9999999999999999e-06) rtol(0.0) nan(different) : f32, f32
  check.return
}
