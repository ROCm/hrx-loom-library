// Independent libm oracle with explicit F32 frequency/angle rounding.
// All 32 rotary frequencies and both planes are checked at positions spanning
// the default 4096-row capacity, including row zero and its final row.

func.decl @pocket.prepare_rotary(%capacity: i32) -> (buffer)

global.rodata.def @rotary_expected = align(16) bytes("")

global.rodata.def @rotary_positions = align(16) bytes("000000000100000002000000030000000f00000010000000110000001f00000020000000210000003f000000400000007f00000080000000ff00000000010000ff01000000020000ff03000000040000ff07000000080000fe0f0000ff0f0000")

func.def @rotary_error() -> (f32) {
  %capacity = scalar.constant 4096 : i32
  %storage = func.call @pocket.prepare_rotary(%capacity) : (i32) -> (buffer)
  %expected_storage = global.load @rotary_expected : buffer
  %position_storage = global.load @rotary_positions : buffer
  %origin = index.constant 0 : offset
  %actual = buffer.view %storage[%origin] : buffer -> view<2x4096x32xf32>
  %expected = buffer.view %expected_storage[%origin] : buffer -> view<2x24x32xf32>
  %positions = buffer.view %position_storage[%origin] : buffer -> view<24xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c32 = index.constant 32 : index
  %rows = index.constant 24 : index
  %initial_error = scalar.constant 0.0 : f32
  %error = scf.for %plane = [%c0 to %c2 step %c1](%maximum = %initial_error : f32) -> (f32) {
    %next = scf.for %row = [%c0 to %rows step %c1](%maximum = %maximum : f32) -> (f32) {
      %position32 = view.load %positions[%row] : view<24xi32> -> i32
      %position_value = index.cast %position32 : i32 to index
      %position = index.assume %position_value [range(%position_value, 0, 4095)] : index
      %next = scf.for %j = [%c0 to %c32 step %c1](%maximum = %maximum : f32) -> (f32) {
        %value = view.load %actual[%plane, %position, %j] : view<2x4096x32xf32> -> f32
        %reference = view.load %expected[%plane, %row, %j] : view<2x24x32xf32> -> f32
        %delta = scalar.subf %value, %reference : f32
        %distance = scalar.absf %delta : f32
        %next = scalar.maximumf %maximum, %distance : f32
        scf.yield %next : f32
      }
      scf.yield %next : f32
    }
    scf.yield %next : f32
  }
  func.return %error : f32
}

check.case @rotary_initialization {
  %actual = func.call @rotary_error() : () -> (f32)
  %expected = check.literal value(0.0) : f32
  check.expect.approximate actual(%actual) expected(%expected) atol(1.1999999999999999e-07) rtol(0.0) nan(different) : f32, f32
  check.return
}
