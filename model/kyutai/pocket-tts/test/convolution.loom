func.def @expected_convolution_f64(%input: buffer, %weight: buffer, %output: buffer, %bias: buffer) {
  %biased = scalar.constant false : i1
  func.call @convolution_expected(%biased, %output) : (i1, buffer)
  func.return
}

check.scenario public @convolution_f64 {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1.0) step(0.25) : tensor<3x11xf32>
    %weight = check.generate.iota offset(0.5) step(0.125) : tensor<3x3x3xbf16>
    %output = check.generate.fill value(-123.0) : tensor<3x5xf32>
    %bias = check.generate.iota offset(-0.5) step(0.125) : tensor<3xbf16>
    check.compare<@test_convolution_f64, @expected_convolution_f64>(%input, %weight, %output, %bias) : (tensor<3x11xf32>, tensor<3x3x3xbf16>, tensor<3x5xf32>, tensor<3xbf16>) -> () {
