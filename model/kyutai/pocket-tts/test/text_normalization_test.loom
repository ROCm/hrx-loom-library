// Pocket TTS 3.3.0's independent prepare_text_prompt observations, captured at
// upstream commit ec569b2dd3fec4a601b391aace185791e92b3785 with Unicode 15.0.
// generate_text_oracle.py evaluates the pinned upstream normalization functions
// through :text_normalization_fixture, producing only the small NPY data files.
// The captures preserve whitespace, uppercase expansion, punctuation/closers,
// embedded NUL, word-count tail selection, and single-pass space replacement.
// Record columns are input offset/length, output offset/length, and tail.
// The NPY byte arrays concatenate the exact captured UTF-8 input and output.

func.decl @pocket.normalize_text(%text: buffer) -> (buffer, i32)

func.def @normalization_observations(%records: view<357x5xi32>, %inputs: view<2456xi8>, %outputs: view<2460xi8>) -> (i32) {
  %count = index.constant 357 : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %first_error = scf.for %i = [%begin to %count step %c1](%first_error = %c0 : i32) -> (i32) {
    %input_position32 = view.load %records[%i, 0] : view<357x5xi32> -> i32
    %input_length32 = view.load %records[%i, 1] : view<357x5xi32> -> i32
    %expected_position32 = view.load %records[%i, 2] : view<357x5xi32> -> i32
    %expected_length32 = view.load %records[%i, 3] : view<357x5xi32> -> i32
    %expected_tail = view.load %records[%i, 4] : view<357x5xi32> -> i32
    %input_position = index.cast %input_position32 : i32 to index
    %input_length = index.cast %input_length32 : i32 to index
    %expected_position = index.cast %expected_position32 : i32 to index
    %expected_length = index.cast %expected_length32 : i32 to index
    %input_extent = index.cast %input_length : index to offset
    %input = buffer.alloca<private> align(1) %input_extent : buffer
    %input_view = buffer.view %input[%origin] : buffer -> view<[%input_length]xi8>
    scf.for %position = [%begin to %input_length step %c1] {
      %input_byte = index.add %input_position, %position : index
      // Captured offsets address the concatenated input byte array.
      %input_index = index.assume %input_byte [ge(%input_byte, 0), lt(%input_byte, 2456)] : index
      %byte = view.load %inputs[%input_index] : view<2456xi8> -> i8
      view.store %byte, %input_view[%position] : i8, view<[%input_length]xi8>
    }
    %actual, %tail = func.call @pocket.normalize_text(%input) : (buffer) -> (buffer, i32)
    %actual_extent = buffer.length %actual
    %actual_length = index.cast %actual_extent : offset to index
    %same_length = index.cmp eq, %actual_length, %expected_length : index
    %same = scf.if %same_length -> (i1) {
      %actual_view = buffer.view %actual[%origin] : buffer -> view<[%actual_length]xi8>
      %true = scalar.constant true : i1
      %same_text = scf.for %position = [%begin to %expected_length step %c1](%same_text = %true : i1) -> (i1) {
        %expected_byte = index.add %expected_position, %position : index
        %expected_index = index.assume %expected_byte [ge(%expected_byte, 0), lt(%expected_byte, 2460)] : index
        %expected = view.load %outputs[%expected_index] : view<2460xi8> -> i8
        %actual_byte = view.load %actual_view[%position] : view<[%actual_length]xi8> -> i8
        %same_byte = scalar.cmpi eq, %actual_byte, %expected : i8
        %next_same = scalar.andi %same_text, %same_byte : i1
        scf.yield %next_same : i1
      }
      %same_tail = scalar.cmpi eq, %tail, %expected_tail : i32
      %same = scalar.andi %same_text, %same_tail : i1
      scf.yield %same : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    %ordinal = index.add %i, %c1 : index
    %ordinal32 = index.cast %ordinal : index to i32
    %error = scf.select %same, %c0, %ordinal32 : i32
    %no_error = scalar.cmpi eq, %first_error, %c0 : i32
    %next_error = scf.select %no_error, %error, %first_error : i32
    scf.yield %next_error : i32
  }
  func.return %first_error : i32
}

check.case public @upstream_english_normalization {
  %records = check.file.read.npy path("text_normalization_records.npy") : view<357x5xi32>
  %inputs = check.file.read.npy path("text_normalization_inputs.npy") : view<2456xi8>
  %outputs = check.file.read.npy path("text_normalization_outputs.npy") : view<2460xi8>
  %error = func.call @normalization_observations(%records, %inputs, %outputs) : (view<357x5xi32>, view<2456xi8>, view<2460xi8>) -> (i32)
  %zero = check.literal value(0) : i32
  check.expect.equal actual(%error) expected(%zero) : i32
  check.return
}

check.benchmark<@upstream_english_normalization> @upstream_english_normalization_workload
