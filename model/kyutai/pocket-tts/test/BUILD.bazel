load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")
load("@hrx//build_tools/bazel:requirements.bzl", "apply_test_requirements")
load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

[
    filegroup(
        name = representation + "_card",
        srcs = ["//model/kyutai/pocket-tts:" + representation],
        output_group = "model_card",
    )
    for representation in [
        "source",
        "archive",
        "source_noncommercial",
        "archive_noncommercial",
    ]
]

# The card and acquisition lock identify provisioned assets without importing
# checkpoint bytes into the action graph or remote test outputs.
_SPEECH_REQUIREMENTS = apply_test_requirements(
    {},
    build_requirements = AMD_GPU_HARDWARE_PROFILE.build_requirements,
    resource_group = AMD_GPU_HARDWARE_PROFILE.resource_group,
    run_requirements = AMD_GPU_HARDWARE_PROFILE.run_requirements,
)

[
    iree_py_test(
        name = "speech_" + representation + "_test",
        size = "medium",
        srcs = ["speech_check.py"],
        args = [
            "--server=$(location @loom_sdk//:loom-serve)",
            "--model=$(location :" + representation + "_card)",
        ] + AMD_GPU_HARDWARE_PROFILE.runner_args,
        data = [
            ":" + representation + "_card",
            "@loom_sdk//:loom-serve",
        ],
        main = "speech_check.py",
        resource_group = _SPEECH_REQUIREMENTS["resource_group"],
        tags = ["manual"] + _SPEECH_REQUIREMENTS["tags"],
        target_compatible_with = _SPEECH_REQUIREMENTS["target_compatible_with"],
        deps = [
            "@hrx//loom/src/loom/serve/testing/loom_serve_testing:http",
            "@hrx//loom/src/loom/serve/testing/loom_serve_testing:model_staging",
        ],
    )
    for representation in [
        "source",
        "archive",
        "source_noncommercial",
        "archive_noncommercial",
    ]
]

loom_test(
    name = "attention",
    srcs = ["attention_test.loom"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    deps = [
        "//model/kyutai/pocket-tts/program:attention",
        "//model/kyutai/pocket-tts/program:normalization",
    ],
)

