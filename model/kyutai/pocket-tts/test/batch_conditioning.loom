// Pocket batch conditioning correctness and bounded workloads.
// Canonical test geometry is explicit in this leaf; weights are synthetic.

config.def @pocket.batch_capacity = 3 : index

config.def @pocket.context_capacity = 4 : index

config.def @pocket.request_capacity = 6 : index

config.def @pocket.threads = 128 : index

config.def @pocket.rotary_capacity = 16 : index

config.def @pocket.voice_capacity = 4 : index

config.def @pocket.voice_frame_capacity = 2 : index

amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

kernel.decl @pocket.batch.initialize_request() launch(%work: buffer, %state: buffer)

kernel.decl @pocket.batch.save_conditioning() launch(%work: buffer, %state: buffer, %conditioning: buffer)

kernel.decl @pocket.batch.restore_conditioning() launch(%work: buffer, %conditioning: buffer, %state: buffer)

kernel.decl @pocket.batch.pack_token() launch(%work: buffer, %output: buffer)

kernel.decl @pocket.batch.pack_seed() launch(%work: buffer, %requests: buffer, %output: buffer)

kernel.decl @pocket.batch.pack_voice() launch(%work: buffer, %output: buffer)

// Three uploads select residents 5, 0, and 3 and distinct reserved voice slots.
// Unequal prefixes occupy two and three positions in a four-position context.
kernel.def target(@pocket) @conditioning_work() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%work: buffer, %count: i32, %first: i32, %chunk: i32) {
  %origin = index.constant 0 : offset
  %words = buffer.view %work[%origin] : buffer -> view<32xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c6 = scalar.constant 6 : i32
  %token0 = scalar.constant 101 : i32
  %token1 = scalar.constant 202 : i32
  %token2 = scalar.constant 303 : i32
  view.store %count, %words[0] : i32, view<32xi32>
  view.store %first, %words[1] : i32, view<32xi32>
  view.store %c0, %words[2] : i32, view<32xi32>
  view.store %c3, %words[3] : i32, view<32xi32>
  view.store %c3, %words[4] : i32, view<32xi32>
  view.store %c3, %words[8] : i32, view<32xi32>
  view.store %c1, %words[9] : i32, view<32xi32>
  view.store %c0, %words[10] : i32, view<32xi32>
  view.store %chunk, %words[11] : i32, view<32xi32>
  view.store %c1, %words[12] : i32, view<32xi32>
  view.store %c1, %words[13] : i32, view<32xi32>
  view.store %token0, %words[14] : i32, view<32xi32>
  view.store %c3, %words[16] : i32, view<32xi32>
  view.store %c0, %words[17] : i32, view<32xi32>
  view.store %c1, %words[18] : i32, view<32xi32>
  view.store %c4, %words[19] : i32, view<32xi32>
  view.store %c2, %words[20] : i32, view<32xi32>
  view.store %c1, %words[21] : i32, view<32xi32>
  view.store %token1, %words[22] : i32, view<32xi32>
  view.store %c3, %words[24] : i32, view<32xi32>
  view.store %c2, %words[25] : i32, view<32xi32>
  view.store %c0, %words[26] : i32, view<32xi32>
  view.store %c6, %words[27] : i32, view<32xi32>
  view.store %c2, %words[28] : i32, view<32xi32>
  view.store %c0, %words[29] : i32, view<32xi32>
  view.store %token2, %words[30] : i32, view<32xi32>
  kernel.return
}

// Independent scalar rectangle copy: no cohort map, packed indexing, or
// flattened cache addressing. The test supplies explicit isolated row views.
kernel.def target(@pocket) @copy_prefix() {
  %c1 = index.constant 1 : index
  %planes = index.constant 12 : index
  %channels = index.constant 1024 : index
  kernel.launch.config workgroups(%planes, %c1, %c1) workgroup_size(%channels, %c1, %c1) : index
} launch(%source_storage: buffer, %target_storage: buffer, %positions: index) {
  %origin = index.constant 0 : offset
  %source = buffer.view %source_storage[%origin] : buffer -> view<12x4x1024xi32>
  %target = buffer.view %target_storage[%origin] : buffer -> view<12x3x1024xi32>
  %plane_value = kernel.workgroup.id<x> : index
  %plane = index.assume %plane_value [range(%plane_value, 0, 11)] : index
  %channel_value = kernel.workitem.id<x> : index
  %channel = index.assume %channel_value [range(%channel_value, 0, 1023)] : index
  %count = index.assume %positions [range(%positions, 1, 3)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  scf.for %position = [%c0 to %count step %c1] {
    %value = view.load %source[%plane, %position, %channel] : view<12x4x1024xi32> -> i32
    view.store %value, %target[%plane, %position, %channel] : i32, view<12x3x1024xi32>
  }
  kernel.return
}

kernel.def target(@pocket) @restore_prefix() {
  %c1 = index.constant 1 : index
  %planes = index.constant 12 : index
  %channels = index.constant 1024 : index
  kernel.launch.config workgroups(%planes, %c1, %c1) workgroup_size(%channels, %c1, %c1) : index
} launch(%source_storage: buffer, %target: buffer, %positions: index, %chunk: i32) {
  %source_origin = index.constant 0 : offset
  %source = buffer.view %source_storage[%source_origin] : buffer -> view<12x3x1024xi32>
  %plane_value = kernel.workgroup.id<x> : index
  %plane = index.assume %plane_value [range(%plane_value, 0, 11)] : index
  %channel_value = kernel.workitem.id<x> : index
  %channel = index.assume %channel_value [range(%channel_value, 0, 1023)] : index
  %count = index.assume %positions [range(%positions, 1, 3)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cache_origin = index.constant 144 : offset
  %cache = buffer.view %target[%cache_origin] : buffer -> view<12x4x1024xi32>
  scf.for %position = [%c0 to %count step %c1] {
    %value = view.load %source[%plane, %position, %channel] : view<12x3x1024xi32> -> i32
    view.store %value, %cache[%plane, %position, %channel] : i32, view<12x4x1024xi32>
  }
  %first_plane = index.cmp eq, %plane, %c0 : index
  %first_channel = index.cmp eq, %channel, %c0 : index
  %first = scalar.andi %first_plane, %first_channel : i1
  scf.if %first {
    %origin = index.constant 0 : offset
    %header = buffer.view %target[%origin] : buffer -> view<4xi32>
    %count32 = index.cast %count : index to i32
    view.store %count32, %header[0] : i32, view<4xi32>
    %cursor_origin = index.constant 4647592 : offset
    %cursor = buffer.view %target[%cursor_origin] : buffer -> view<2xi32>
    view.store %chunk, %cursor[0] : i32, view<2xi32>
  }
  kernel.return
}

// Entire banks are compared, including the immutable rotary prefix, unused fourth voice, cache padding,
// inactive residents, codec histories, and request cursors.
check.case public @retained_voices_and_reused_request_rows {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %work = check.generate.fill value(-1) : tensor<32xi32>
  %c0 = check.literal value(0) : i32
  %c1 = check.literal value(1) : i32
  %c2 = check.literal value(2) : i32
  %c3 = check.literal value(3) : i32
  %c4 = check.literal value(4) : i32
  %c5 = check.literal value(5) : i32
  %c6 = check.literal value(6) : i32
  %c7 = check.literal value(7) : i32
  %two_positions = check.literal value(2) : index
  %three_positions = check.literal value(3) : index
  kernel.launch @conditioning_work(%work, %c3, %c5, %c2) : (tensor<32xi32>, i32, i32, i32)
  %source = check.generate.iota offset(100) step(1) : tensor<6971400xi32>
  %source_expected = check.generate.iota offset(100) step(1) : tensor<6971400xi32>
  %actual_cache = check.generate.fill value(-7) : tensor<148480xi32>
  %expected_cache = check.generate.fill value(-7) : tensor<148480xi32>
  %source0 = check.tensor.view %source offset(144) : tensor<6971400xi32> -> tensor<12x4x1024xi32>
  %source3 = check.tensor.view %source offset(13942944) : tensor<6971400xi32> -> tensor<12x4x1024xi32>
  %source5 = check.tensor.view %source offset(23238144) : tensor<6971400xi32> -> tensor<12x4x1024xi32>
  %cache0 = check.tensor.view %expected_cache offset(4096) : tensor<148480xi32> -> tensor<12x3x1024xi32>
  %cache1 = check.tensor.view %expected_cache offset(151552) : tensor<148480xi32> -> tensor<12x3x1024xi32>
  %cache2 = check.tensor.view %expected_cache offset(299008) : tensor<148480xi32> -> tensor<12x3x1024xi32>
  kernel.launch @copy_prefix(%source3, %cache2, %three_positions) : (tensor<12x4x1024xi32>, tensor<12x3x1024xi32>, index)
  kernel.launch @copy_prefix(%source0, %cache0, %three_positions) : (tensor<12x4x1024xi32>, tensor<12x3x1024xi32>, index)
  kernel.launch @copy_prefix(%source5, %cache1, %two_positions) : (tensor<12x4x1024xi32>, tensor<12x3x1024xi32>, index)
  kernel.launch @pocket.batch.save_conditioning(%work, %source, %actual_cache) : (tensor<32xi32>, tensor<6971400xi32>, tensor<148480xi32>)
  check.expect.bitwise actual(%source) expected(%source_expected) : tensor<6971400xi32>
  %actual = check.generate.fill value(37) : tensor<6971400xi32>
  %expected = check.generate.fill value(37) : tensor<6971400xi32>
  %row0 = check.tensor.view %expected offset(0) : tensor<6971400xi32> -> tensor<1161900xi32>
  %row3 = check.tensor.view %expected offset(13942800) : tensor<6971400xi32> -> tensor<1161900xi32>
  %row5 = check.tensor.view %expected offset(23238000) : tensor<6971400xi32> -> tensor<1161900xi32>
  kernel.launch @clear_reference_row(%row0) : (tensor<1161900xi32>)
  kernel.launch @clear_reference_row(%row3) : (tensor<1161900xi32>)
  kernel.launch @clear_reference_row(%row5) : (tensor<1161900xi32>)
  kernel.launch @restore_prefix(%cache0, %row0, %three_positions, %c4) : (tensor<12x3x1024xi32>, tensor<1161900xi32>, index, i32)
  kernel.launch @restore_prefix(%cache2, %row3, %three_positions, %c6) : (tensor<12x3x1024xi32>, tensor<1161900xi32>, index, i32)
  kernel.launch @restore_prefix(%cache1, %row5, %two_positions, %c2) : (tensor<12x3x1024xi32>, tensor<1161900xi32>, index, i32)
  kernel.launch @pocket.batch.restore_conditioning(%work, %actual_cache, %actual) : (tensor<32xi32>, tensor<148480xi32>, tensor<6971400xi32>)
  kernel.launch @conditioning_work(%work, %c1, %c0, %c7) : (tensor<32xi32>, i32, i32, i32)
  kernel.launch @clear_reference_row(%row0) : (tensor<1161900xi32>)
  kernel.launch @restore_prefix(%cache1, %row0, %two_positions, %c7) : (tensor<12x3x1024xi32>, tensor<1161900xi32>, index, i32)
  kernel.launch @pocket.batch.restore_conditioning(%work, %actual_cache, %actual) : (tensor<32xi32>, tensor<148480xi32>, tensor<6971400xi32>)
  kernel.launch @conditioning_work(%work, %c0, %c5, %c2) : (tensor<32xi32>, i32, i32, i32)
  kernel.launch @pocket.batch.initialize_request(%work, %actual) : (tensor<32xi32>, tensor<6971400xi32>)
  kernel.launch @pocket.batch.save_conditioning(%work, %actual, %actual_cache) : (tensor<32xi32>, tensor<6971400xi32>, tensor<148480xi32>)
  kernel.launch @pocket.batch.restore_conditioning(%work, %actual_cache, %actual) : (tensor<32xi32>, tensor<148480xi32>, tensor<6971400xi32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<6971400xi32>
  check.expect.bitwise actual(%actual_cache) expected(%expected_cache) : tensor<148480xi32>
  check.return
}

check.case public @initialization_clears_only_selected_residents {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %work = check.generate.fill value(-1) : tensor<32xi32>
  %count = check.literal value(3) : i32
  %first = check.literal value(5) : i32
  %chunk = check.literal value(2) : i32
  kernel.launch @conditioning_work(%work, %count, %first, %chunk) : (tensor<32xi32>, i32, i32, i32)
  %source = check.generate.iota offset(100) step(1) : tensor<6971400xi32>
  %source_expected = check.generate.iota offset(100) step(1) : tensor<6971400xi32>
  kernel.launch @pocket.batch.initialize_request(%work, %source) : (tensor<32xi32>, tensor<6971400xi32>)
  %cleared = check.generate.fill value(0) : tensor<1161900xi32>
  %initialized0 = check.tensor.view %source offset(0) : tensor<6971400xi32> -> tensor<1161900xi32>
  %initialized3 = check.tensor.view %source offset(13942800) : tensor<6971400xi32> -> tensor<1161900xi32>
  %initialized5 = check.tensor.view %source offset(23238000) : tensor<6971400xi32> -> tensor<1161900xi32>
  check.expect.bitwise actual(%initialized0) expected(%cleared) : tensor<1161900xi32>
  check.expect.bitwise actual(%initialized3) expected(%cleared) : tensor<1161900xi32>
  check.expect.bitwise actual(%initialized5) expected(%cleared) : tensor<1161900xi32>
  %untouched12 = check.tensor.view %source offset(4647600) : tensor<6971400xi32> -> tensor<2323800xi32>
  %original12 = check.tensor.view %source_expected offset(4647600) : tensor<6971400xi32> -> tensor<2323800xi32>
  %untouched4 = check.tensor.view %source offset(18590400) : tensor<6971400xi32> -> tensor<1161900xi32>
  %original4 = check.tensor.view %source_expected offset(18590400) : tensor<6971400xi32> -> tensor<1161900xi32>
  check.expect.bitwise actual(%untouched12) expected(%original12) : tensor<2323800xi32>
  check.expect.bitwise actual(%untouched4) expected(%original4) : tensor<1161900xi32>
  check.return
}

check.case public @packed_tokens_seeds_and_waveform_blocks {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %work = check.generate.iota offset(0.0) step(0.125) : tensor<5792xf32>
  %count = check.literal value(3) : i32
  %first = check.literal value(5) : i32
  %chunk = check.literal value(2) : i32
  %c0 = check.literal value(0) : i32
  kernel.launch @conditioning_work(%work, %count, %first, %chunk) : (tensor<5792xf32>, i32, i32, i32)
  %tokens = check.generate.fill value(-17) : tensor<5xi32>
  %requests = check.generate.iota offset(1311768467750121217) step(1) : tensor<12xi64>
  %seeds = check.generate.fill value(-17) : tensor<4xi64>
  %blocks = check.generate.fill value(-17.0) : tensor<5764xf32>
  kernel.launch @pocket.batch.pack_token(%work, %tokens) : (tensor<5792xf32>, tensor<5xi32>)
  kernel.launch @pocket.batch.pack_seed(%work, %requests, %seeds) : (tensor<5792xf32>, tensor<12xi64>, tensor<4xi64>)
  kernel.launch @pocket.batch.pack_voice(%work, %blocks) : (tensor<5792xf32>, tensor<5764xf32>)
  kernel.launch @conditioning_work(%work, %c0, %first, %chunk) : (tensor<5792xf32>, i32, i32, i32)
  kernel.launch @pocket.batch.pack_token(%work, %tokens) : (tensor<5792xf32>, tensor<5xi32>)
  kernel.launch @pocket.batch.pack_seed(%work, %requests, %seeds) : (tensor<5792xf32>, tensor<12xi64>, tensor<4xi64>)
  kernel.launch @pocket.batch.pack_voice(%work, %blocks) : (tensor<5792xf32>, tensor<5764xf32>)
  %token_values = check.tensor.view %tokens offset(0) : tensor<5xi32> -> tensor<3xi32>
  %expected_tokens = check.generate.iota offset(101) step(101) : tensor<3xi32>
  check.expect.bitwise actual(%token_values) expected(%expected_tokens) : tensor<3xi32>
  %token_guard = check.tensor.view %tokens offset(12) : tensor<5xi32> -> tensor<2xi32>
  %expected_token_guard = check.generate.fill value(-17) : tensor<2xi32>
  check.expect.bitwise actual(%token_guard) expected(%expected_token_guard) : tensor<2xi32>
  %seed0 = check.tensor.view %seeds offset(0) : tensor<4xi64> -> tensor<1xi64>
  %seed1 = check.tensor.view %seeds offset(8) : tensor<4xi64> -> tensor<1xi64>
  %seed2 = check.tensor.view %seeds offset(16) : tensor<4xi64> -> tensor<1xi64>
  %expected_seed0 = check.tensor.view %requests offset(80) : tensor<12xi64> -> tensor<1xi64>
  %expected_seed1 = check.tensor.view %requests offset(0) : tensor<12xi64> -> tensor<1xi64>
  %expected_seed2 = check.tensor.view %requests offset(48) : tensor<12xi64> -> tensor<1xi64>
  check.expect.bitwise actual(%seed0) expected(%expected_seed0) : tensor<1xi64>
  check.expect.bitwise actual(%seed1) expected(%expected_seed1) : tensor<1xi64>
  check.expect.bitwise actual(%seed2) expected(%expected_seed2) : tensor<1xi64>
  %seed_guard = check.tensor.view %seeds offset(24) : tensor<4xi64> -> tensor<1xi64>
  %expected_seed_guard = check.generate.fill value(-17) : tensor<1xi64>
  check.expect.bitwise actual(%seed_guard) expected(%expected_seed_guard) : tensor<1xi64>
  %block0 = check.tensor.view %blocks offset(0) : tensor<5764xf32> -> tensor<1920xf32>
  %block1 = check.tensor.view %blocks offset(7680) : tensor<5764xf32> -> tensor<1920xf32>
  %block2 = check.tensor.view %blocks offset(15360) : tensor<5764xf32> -> tensor<1920xf32>
  %expected_block0 = check.tensor.view %work offset(128) : tensor<5792xf32> -> tensor<1920xf32>
  %expected_block1 = check.tensor.view %work offset(7808) : tensor<5792xf32> -> tensor<1920xf32>
  %expected_block2 = check.tensor.view %work offset(15488) : tensor<5792xf32> -> tensor<1920xf32>
  check.expect.bitwise actual(%block0) expected(%expected_block0) : tensor<1920xf32>
  check.expect.bitwise actual(%block1) expected(%expected_block1) : tensor<1920xf32>
  check.expect.bitwise actual(%block2) expected(%expected_block2) : tensor<1920xf32>
  %block_guard = check.tensor.view %blocks offset(23040) : tensor<5764xf32> -> tensor<4xf32>
  %expected_block_guard = check.generate.fill value(-17.0) : tensor<4xf32>
  check.expect.bitwise actual(%block_guard) expected(%expected_block_guard) : tensor<4xf32>
  check.return
}

kernel.def target(@pocket) @clear_reference_row() {
  %groups = index.constant 4539 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%storage: buffer) {
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %threads = index.constant 256 : index
  %base = index.mul %group, %threads : index
  %element = index.add %base, %lane : index
  %count = index.constant 1161900 : index
  %live = index.cmp ult, %element, %count : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %words = buffer.view %storage[%origin] : buffer -> view<1161900xi32>
    %c0 = scalar.constant 0 : i32
    view.store %c0, %words[%element] : i32, view<1161900xi32>
  }
  kernel.return
}

check.benchmark<@retained_voices_and_reused_request_rows> @retained_voices_and_reused_request_rows_workload

check.benchmark<@initialization_clears_only_selected_residents> @initialization_clears_only_selected_residents_workload

check.benchmark<@packed_tokens_seeds_and_waveform_blocks> @packed_tokens_seeds_and_waveform_blocks_workload
