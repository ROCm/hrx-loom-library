load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "LICENSE.pocket-tts",
    "model.json",
    "model.json.lock",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/kyutai/pocket-tts/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_PROGRAM_NAMES = [
    "attention",
    "audio",
    "batch_attention",
    "batch_conditioning",
    "batch_convolution",
    "batch_decode",
    "batch_flow_layers",
    "batch_flow_state",
    "batch_mimi_layers",
    "batch_normalization",
    "batch_pointwise",
    "batch_prefill",
    "batch_projection",
    "batch_request",
    "batch_sampling",
    "batch_voice",
    "batching",
    "control",
    "convolution",
    "dispatch",
    "flow_state",
    "layout",
    "normalization",
    "options",
    "pointwise",
    "prepare",
    "projection",
    "request_layout",
    "sampling",
    "rotary",
    "voice",
    "text_chunking",
    "text_normalization",
]

_MOTIFS = {
    "//motif/tensor:random": "library/motif/tensor/random",
    "//motif/text:unicode": "library/motif/text/unicode",
    "//motif/text:utf8": "library/motif/text/utf8",
}

_DATA = {
    ":LICENSE.pocket-tts": "LICENSE.pocket-tts",
    "//model/kyutai/pocket-tts/program:weights.loom": "program/weights.loom",
    "//motif/text:LICENSE.unicode": "library/motif/text/LICENSE.unicode",
}

[
    loom_model(
        name = representation + suffix,
        card = "model.json",
        data = _DATA,
        encoding = "preserve",
        files = {
            "//model/kyutai/pocket-tts/program:" + name + (".loom" if representation == "source" else ""): "program/" + name + (".loom" if representation == "source" else ".loombc")
            for name in _PROGRAM_NAMES
        } | {
            label + (".loom" if representation == "source" else ""): path + (".loom" if representation == "source" else ".loombc")
            for label, path in _MOTIFS.items()
        },
        lockfile = "model.json.lock",
        model_name = "pocket-tts",
        preset = preset,
        programs = representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
    ]
    for suffix, preset in [
        ("", "streaming"),
        ("_noncommercial", "streaming-noncommercial"),
    ]
]
