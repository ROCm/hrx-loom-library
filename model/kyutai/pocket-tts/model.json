  "services": {
    "speech": {
      "kind": "speech",
      "version": 2,
      "options": [
        "context_capacity",
        "rotary_capacity",
        "chunk_tokens",
        "input_tokens",
        "request_capacity",
        "batch_capacity",
        "threads",
        "voice_capacity",
        "voice_frame_capacity",
        "voice_audio_capacity"
      ],
      "interface": {
        "input": "English text and a registered voice ID",
        "output": {
          "sample_rate": 24000,
          "channels": 1,
          "block_samples": 1920,
          "internal_dtype": "f32",
          "pcm_dtype": "s16le"
        },
        "voices": [
          {
            "id": "alba",
            "frames": 126,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/alba-mackenna/casual.wav",
            "license": "CC-BY-4.0"
          },
          {
            "id": "marius",
            "frames": 126,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/voice-donations/Selfie.wav",
            "license": "CC0-1.0"
          },
          {
            "id": "jean",
            "frames": 123,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/ears/p010/freeform_speech_01_enhanced.wav",
            "license": "CC-BY-NC-4.0"
          },
          {
            "id": "anna",
            "frames": 154,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/vctk/p228_023_enhanced.wav",
            "license": "CC-BY-4.0"
          }
        ],
        "voice_preparation": "Native decoding preserves the recording geometry; CPU Loom mixes, resamples to 24 kHz, trims to the pinned end-on-pause policy, and pads complete 1920-sample blocks once per registration. Learned conditioning is reused by synthesis."
      },
      "constraints": {
        "context_capacity": {
          "minimum": 1,
          "maximum": 65536
        },
        "rotary_capacity": {
          "minimum": 16,
          "maximum": 1048576
        },
        "chunk_tokens": {
          "minimum": 1,
          "maximum": 512
        },
        "input_tokens": {
          "minimum": 1,
          "maximum": 65536
        },
        "request_capacity": {
          "minimum": 1,
          "maximum": 65536
        },
        "batch_capacity": {
          "minimum": 1,
          "maximum": 65536
        },
        "threads": {
          "minimum": 1,
          "maximum": 256
        },
        "capacity_relationships": [
          "batch_capacity <= request_capacity",
          "context_capacity >= 1 + voice_frame_capacity + chunk_tokens + generation_frames",
          "rotary_capacity >= context_capacity",
          "rotary_capacity >= 16 * max(voice_frame_capacity, generation_frames)"
        ],
        "generation_frames": "ceil(chunk_tokens * 25 / 6) + 25",
        "voice_capacity": {
          "minimum": 1,
          "maximum": 256
        },
        "voice_frame_capacity": {
          "minimum": 1,
          "maximum": 65535
        },
        "voice_audio_capacity": {
          "minimum": 4,
          "maximum": 1073741824,
          "unit": "bytes"
        }
      }
    }
  },
  "variants": {
    "english-three-voices": {
      "description": "Original English BF16 weights with Alba and Anna (CC-BY-4.0) and Marius (CC0-1.0) reference recordings.",
      "services": {
        "speech": {
          "programs": [
            "source",
            "archive"
          ],
          "parameters": {
            "model": {
              "files": [
                {
                  "path": "parameter/model.safetensors",
                  "origin": "@checkpoint/languages/english/model.safetensors",
                  "format": "safetensors"
                }
              ]
            }
          },
          "tokenizers": {
            "text": {
              "path": "tokenizer.json",
              "origin": "@tokenizer/languages/english/tokenizer.json",
              "format": "huggingface-json"
            }
          },
          "voices": {
            "alba": {
              "file": {
                "path": "voice/alba.wav",
                "origin": "@voice_reference/alba-mackenna/casual.wav"
              },
              "content_type": "audio/wav"
            },
            "marius": {
              "file": {
                "path": "voice/marius.wav",
                "origin": "@voice_reference/voice-donations/Selfie.wav"
              },
              "content_type": "audio/wav"
            },
            "anna": {
              "file": {
                "path": "voice/anna.wav",
                "origin": "@voice_reference/vctk/p228_023_enhanced.wav"
              },
              "content_type": "audio/wav"
            }
          }
        }
      }
    },
