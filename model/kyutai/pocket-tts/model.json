  "services": {
    "speech": {
      "kind": "speech",
      "version": 1,
      "options": [
        "context_capacity",
        "rotary_capacity",
        "chunk_tokens",
        "input_tokens",
        "request_capacity",
        "batch_capacity",
        "threads",
        "voices"
      ],
      "interface": {
        "input": "English text and a registered voice ID",
        "output": {
          "sample_rate": 24000,
          "channels": 1,
          "block_samples": 1920,
          "internal_dtype": "f32",
          "pcm_dtype": "s16le"
        },
        "voices": [
          {
            "id": "alba",
            "frames": 126,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/alba-mackenna/casual.wav",
            "license": "CC-BY-4.0"
          },
          {
            "id": "marius",
            "frames": 126,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/voice-donations/Selfie.wav",
            "license": "CC0-1.0"
          },
          {
            "id": "jean",
            "frames": 123,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/ears/p010/freeform_speech_01_enhanced.wav",
            "license": "CC-BY-NC-4.0"
          },
          {
            "id": "anna",
            "frames": 154,
            "reference": "https://huggingface.co/kyutai/tts-voices/resolve/323332d33f997de8394f24a193e1a76df720e01a/vctk/p228_023_enhanced.wav",
            "license": "CC-BY-4.0"
          }
        ],
        "parameter_layouts": {
          "voices": {
            "tensor": "waveforms",
            "dtype": "F32",
            "shape": [
              "voice_count",
              154,
              1920
            ],
            "preparation": "Downmix and resample to 24 kHz mono, trim to the pinned end-on-pause policy, then zero-pad to 1920-sample blocks."
          },
          "rotary": {
            "tensors": [
              "rotary.cosine",
              "rotary.sine"
            ],
            "dtype": "F32",
            "shape": [
              4096,
              32
            ],
            "preparation": "F32-rounded frequency and angle evaluation using the pinned Pocket rotary convention."
          }
        }
      },
      "constraints": {
        "context_capacity": {
          "minimum": 1,
          "maximum": 65536
        },
        "rotary_capacity": {
          "minimum": 16,
          "maximum": 1048576
        },
        "chunk_tokens": {
          "minimum": 1,
          "maximum": 512
        },
        "input_tokens": {
          "minimum": 1,
          "maximum": 65536
        },
        "request_capacity": {
          "minimum": 1,
          "maximum": 65536
        },
        "batch_capacity": {
          "minimum": 1,
          "maximum": 65536
        },
        "threads": {
          "minimum": 1,
          "maximum": 256
        },
        "voices": {
          "minimum_count": 1,
          "maximum_count": 256,
          "id_bytes": {
            "minimum": 1,
            "maximum": 64
          },
          "frames": {
            "minimum": 1,
            "maximum": 65535
          }
        },
        "capacity_relationships": [
          "batch_capacity <= request_capacity",
          "context_capacity >= 1 + maximum_voice_frames + chunk_tokens + generation_frames",
          "rotary_capacity >= context_capacity",
          "rotary_capacity >= 16 * max(maximum_voice_frames, generation_frames)"
        ],
        "generation_frames": "ceil(chunk_tokens * 25 / 6) + 25"
      }
    }
  },
