// Pocket parameter preparation policy for original checkpoint tensors.
// Returning zero staging bytes preserves the acquired tensor layout and dtype.
// Numerical providers interpret BF16/F32 tensors directly through their scoped
// parameter indices.

func.def public @prepare_weight(%key: buffer) -> (i64) {
  %bytes = scalar.constant 0 : i64
  func.return %bytes : i64
}
