// Pocket speech ABI 2 request control and batch retirement. CPU-owned
// immutable text packets feed phase-compatible work offers. Only completion
// advances cursors, publishes voice conditioning, or emits audio; device work
// never owns the request lifecycle.

func.decl import("runner") @execute_5(%stage: i32, %work: hal.buffer, %request: hal.buffer, %conditioning: hal.buffer, %stream: hal.buffer, %output: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.decl @pocket.check(%condition: i1, %diagnostic: buffer)

func.decl @pocket.prepare_text(%text: buffer, %chunk_tokens: i32, %input_tokens: i32) -> (buffer, i32)

template.decl pure @pocket.packet_stride(%tokens: index) -> (offset)

template.decl pure @pocket.batch_work_header_size(%capacity: index) -> (offset)

template.decl pure @pocket.batch_audio_offset(%capacity: index) -> (offset)

template.decl pure @pocket.batch_work_size(%capacity: index) -> (offset)

// Pocket TTS requires speed 1 and does not accept instructions
global.rodata.def @pocket.request_error = bytes("506f636b657420545453207265717569726573207370656564203120616e6420646f6573206e6f742061636365707420696e737472756374696f6e73")

// Pocket TTS did not terminate within the admitted generation extent
global.rodata.def @pocket.termination_error = bytes("506f636b65742054545320646964206e6f74207465726d696e6174652077697468696e207468652061646d69747465642067656e65726174696f6e20657874656e74")

// Pocket TTS produced a nonfinite EOS score
global.rodata.def @pocket.eos_error = bytes("506f636b6574205454532070726f64756365642061206e6f6e66696e69746520454f532073636f7265")

// Request header fields at byte offsets:
//  0: next numerical phase, advanced only after retirement.
//  4: current voice block or text token within that phase.
//  8: immutable registered voice ordinal.
// 12: immutable voice frame count.
// 16: immutable whole-input chunk count.
// 20: current chunk, also the sampling counter identity.
// 24: generated block index within the current chunk.
// 28: first eligible EOS block, or -1 before prediction.
// 32: I64 cumulative published audio position in frames.
// 40: eight reserved bytes; immutable text packets or uploaded PCM begin at 48.
func.def public @speech_prepare_request_v2(%model: buffer, %text: buffer, %voice: buffer, %instructions: buffer, %seed: i64, %speed: f32) -> (buffer, buffer) {
  %origin = index.constant 0 : offset
  %instruction_bytes = buffer.length %instructions
  %plain = index.cmp eq, %instruction_bytes, %origin : offset
  %normal = scalar.constant 1.0 : f32
  %normal_speed = scalar.cmpf oeq, %speed, %normal : f32
  %supported = scalar.andi %plain, %normal_speed : i1
  %error = global.load @pocket.request_error : buffer
  func.call @pocket.check(%supported, %error) : (i1, buffer)
  %voice_header = buffer.view %voice[%origin] : buffer -> view<2xi32>
  %voice_id = view.load %voice_header[0] : view<2xi32> -> i32
  %voice_frames = view.load %voice_header[1] : view<2xi32> -> i32
  %model_header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %chunk_limit = view.load %model_header[2] : view<12xi32> -> i32
  %input_limit = view.load %model_header[3] : view<12xi32> -> i32
  %packets, %chunks = func.call @pocket.prepare_text(%text, %chunk_limit, %input_limit) : (buffer, i32, i32) -> (buffer, i32)
  %packet_bytes = buffer.length %packets
  %header_bytes = index.constant 48 : offset
  %state_bytes = index.add %header_bytes, %packet_bytes : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %c0 = scalar.constant 0 : i32
  buffer.fill %c0, %state[%origin], %header_bytes : i32
  buffer.copy %packets[%origin], %state[%header_bytes], %packet_bytes
  %header = buffer.view %state[%origin] : buffer -> view<8xi32>
  %restore = scalar.constant 4 : i32
  view.store %restore, %header[0] : i32, view<8xi32>
  view.store %voice_id, %header[2] : i32, view<8xi32>
  view.store %voice_frames, %header[3] : i32, view<8xi32>
  view.store %chunks, %header[4] : i32, view<8xi32>
  %missing = scalar.constant -1 : i32
  view.store %missing, %header[7] : i32, view<8xi32>
  %payload_bytes = index.constant 16 : offset
  %payload = buffer.alloca<private> align(8) %payload_bytes : buffer
  buffer.fill %c0, %payload[%origin], %payload_bytes : i32
  %seed_view = buffer.view %payload[%origin] : buffer -> view<1xi64>
  view.store %seed, %seed_view[0] : i64, view<1xi64>
  func.return %state, %payload : buffer, buffer
}

func.def @pocket.current_packet(%model: buffer, %state: buffer) -> (offset) {
  %origin = index.constant 0 : offset
  %model_header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %header = buffer.view %state[%origin] : buffer -> view<8xi32>
  %tokens32 = view.load %model_header[2] : view<12xi32> -> i32
  %chunk32 = view.load %header[5] : view<8xi32> -> i32
  %tokens = index.cast %tokens32 : i32 to index
  %chunk = index.cast %chunk32 : i32 to index
  %stride = template.apply<@pocket.packet_stride>(%tokens) pure : (index) -> (offset)
  %relative = index.scale %chunk, %stride : index, offset -> offset
  %header_bytes = index.constant 48 : offset
  %packet = index.add %header_bytes, %relative : offset
  func.return %packet : offset
}

// Uploads supply only their next codec block. Synthesis begins by restoring
// already-published conditioning and never reads a waveform or mutates a slot.
func.def public @speech_prepare_work_v2(%model: buffer, %state: buffer) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<8xi32>
  %phase = view.load %header[0] : view<8xi32> -> i32
  %voice = view.load %header[2] : view<8xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %voice_phase = scalar.constant 2 : i32
  %voice_work = scalar.cmpi eq, %phase, %voice_phase : i32
  %record_size = index.constant 32 : offset
  %audio_size = index.constant 7712 : offset
  %size = scf.select %voice_work, %audio_size, %record_size : offset
  %work = buffer.alloca<private> align(8) %size : buffer
  buffer.fill %c0, %work[%origin], %size : i32
  %offer = buffer.view %work[%origin] : buffer -> view<8xi32>
  %cursor = view.load %header[1] : view<8xi32> -> i32
  %frames = view.load %header[3] : view<8xi32> -> i32
  %chunk = view.load %header[5] : view<8xi32> -> i32
  view.store %phase, %offer[0] : i32, view<8xi32>
  view.store %voice, %offer[1] : i32, view<8xi32>
  view.store %cursor, %offer[2] : i32, view<8xi32>
  view.store %chunk, %offer[3] : i32, view<8xi32>
  view.store %frames, %offer[4] : i32, view<8xi32>
  %text_phase = scalar.constant 5 : i32
  %text_work = scalar.cmpi eq, %phase, %text_phase : i32
  %token = scf.if %text_work -> (i32) {
    %packet = func.call @pocket.current_packet(%model, %state) : (buffer, buffer) -> (offset)
    %packet_header = index.constant 16 : offset
    %word = index.constant 4 : offset
    %cursor_index = index.cast %cursor : i32 to index
    %relative = index.scale %cursor_index, %word : index, offset -> offset
    %tokens = index.add %packet, %packet_header : offset
    %token_origin = index.add %tokens, %relative : offset
    %phase_token = buffer.view %state[%token_origin] : buffer -> view<1xi32>
    %value = view.load %phase_token[0] : view<1xi32> -> i32
    scf.yield %value : i32
  } else {
    %bos = scalar.constant -1 : i32
    scf.yield %bos : i32
  }
  view.store %token, %offer[6] : i32, view<8xi32>
  scf.if %voice_work {
    %block_bytes = index.constant 7680 : offset
    %header_bytes = index.constant 48 : offset
    %cursor_index = index.cast %cursor : i32 to index
    %relative = index.scale %cursor_index, %block_bytes : index, offset -> offset
    %audio_offset = index.add %header_bytes, %relative : offset
    buffer.copy %state[%audio_offset], %work[%record_size], %block_bytes
  }
  %tag = scalar.extui %phase : i32 to i64
  %unit = scalar.constant 1 : i64
  func.return %work, %unit, %tag : buffer, i64, i64
}

func.def public @speech_prepare_batch_v2(%model: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (buffer, buffer) {
  %origin = index.constant 0 : offset
  %model_header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %capacity32 = view.load %model_header[5] : view<12xi32> -> i32
  %capacity_value = scalar.assume %capacity32 [range(%capacity32, 1, 65536)] : i32
  %capacity = index.cast %capacity_value : i32 to index
  %length = buffer.length %ranges
  %bytes = index.cast %length : offset to i64
  %record_bytes = scalar.constant 24 : i64
  %count64 = scalar.divui %bytes, %record_bytes : i64
  %count_value = index.cast %count64 : i64 to index
  %count = index.assume %count_value [ge(%count_value, 1), le(%count_value, %capacity)] : index
  %records = buffer.view %ranges[%origin] : buffer -> view<[%count]x3xi64>
  %first = buffer.view %packed[%origin] : buffer -> view<8xi32>
  %phase = view.load %first[0] : view<8xi32> -> i32
  %voice_phase = scalar.constant 2 : i32
  %voice_work = scalar.cmpi eq, %phase, %voice_phase : i32
  %audio_offset = template.apply<@pocket.batch_audio_offset>(%capacity) pure : (index) -> (offset)
  %audio_size = template.apply<@pocket.batch_work_size>(%capacity) pure : (index) -> (offset)
  %size = scf.select %voice_work, %audio_size, %audio_offset : offset
  %payload = buffer.alloca<private> align(8) %size : buffer
  %c0 = scalar.constant 0 : i32
  buffer.fill %c0, %payload[%origin], %size : i32
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %header_words = index.add %capacity, %c2 : index
  %header = buffer.view %payload[%origin] : buffer -> view<[%header_words]xi32>
  %count32 = scalar.trunci %count64 : i64 to i32
  view.store %count32, %header[0] : i32, view<[%header_words]xi32>
  %phase_slot = index.add %capacity, %c1 : index
  view.store %phase, %header[%phase_slot] : i32, view<[%header_words]xi32>
  %work_header = template.apply<@pocket.batch_work_header_size>(%capacity) pure : (index) -> (offset)
  %work_stride = index.constant 32 : offset
  %begin = index.constant 0 : index
  scf.for %i = [%begin to %count step %c1] {
    %row64 = view.load %records[%i, 0] : view<[%count]x3xi64> -> i64
    %offset64 = view.load %records[%i, 1] : view<[%count]x3xi64> -> i64
    %offset_value = scalar.assume %offset64 [range(%offset64, 0, 505405440)] : i64
    %offset = index.cast %offset_value : i64 to offset
    %relative = index.scale %i, %work_stride : index, offset -> offset
    %target_offset = index.add %work_header, %relative : offset
    buffer.copy %packed[%offset], %payload[%target_offset], %work_stride
    scf.if %voice_work {
      %block_bytes = index.constant 7680 : offset
      %input_audio = index.add %offset, %work_stride : offset
      %relative_audio = index.scale %i, %block_bytes : index, offset -> offset
      %output_audio = index.add %audio_offset, %relative_audio : offset
      buffer.copy %packed[%input_audio], %payload[%output_audio], %block_bytes
    }
    %row = scalar.trunci %row64 : i64 to i32
    %map_index_value = index.add %i, %c1 : index
    %map_index = index.assume %map_index_value [ge(%map_index_value, 1), lt(%map_index_value, %header_words)] : index
    view.store %row, %header[%map_index] : i32, view<[%header_words]xi32>
  }
  // The retained CPU plan carries the phase and live count directly. Generation
  // has no model metadata and does not infer capacity from a payload's extent.
  %plan_bytes = index.constant 8 : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %plan_header = buffer.view %plan[%origin] : buffer -> view<2xi32>
  view.store %phase, %plan_header[0] : i32, view<2xi32>
  view.store %count32, %plan_header[1] : i32, view<2xi32>
  func.return %payload, %plan : buffer, buffer
}

func.def public @speech_generate_v2(%plan: buffer, %work: hal.buffer, %request: hal.buffer, %conditioning: hal.buffer, %stream: hal.buffer, %output: hal.buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %plan[%origin] : buffer -> view<2xi32>
  %phase = view.load %header[0] : view<2xi32> -> i32
  %execution = func.call @execute_5(%phase, %work, %request, %conditioning, %stream, %output) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %decode = scalar.constant 6 : i32
  %audio = scalar.cmpi eq, %phase, %decode : i32
  scf.if %audio {
    %count32 = view.load %header[1] : view<2xi32> -> i32
    %count = scalar.extui %count32 : i32 to i64
    %stride = scalar.constant 7684 : i64
    %length = scalar.muli %count, %stride : i64
    %c0 = scalar.constant 0 : i32
    %start = scalar.constant 0 : i64
    %feedback = func.call @feedback(%c0, %output, %start, %length) : (i32, hal.buffer, i64, i64) -> (i64)
  }
  func.return
}

func.def public @speech_complete_v2(%model: buffer, %state: buffer, %plan: buffer, %ordinal: i64, %feedback: buffer) -> (i64, i64, i64, i32) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<8xi32>
  %position_origin = index.constant 32 : offset
  %position_view = buffer.view %state[%position_origin] : buffer -> view<1xi64>
  %position = view.load %position_view[0] : view<1xi64> -> i64
  %batch = buffer.view %plan[%origin] : buffer -> view<2xi32>
  %phase = view.load %batch[0] : view<2xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %missing = scalar.constant -1 : i32
  %c0_i64 = scalar.constant 0 : i64
  %audio = scalar.cmpi eq, %phase, %c6 : i32
  %offset, %frames, %done = scf.if %audio -> (i64, i64, i32) {
    %packet_origin = func.call @pocket.current_packet(%model, %state) : (buffer, buffer) -> (offset)
    %packet = buffer.view %state[%packet_origin] : buffer -> view<4xi32>
    %stride = scalar.constant 7684 : i64
    %row_offset = scalar.muli %ordinal, %stride : i64
    %bounded_offset = scalar.assume %row_offset [range(%row_offset, 0, 503570940)] : i64
    %begin = index.cast %bounded_offset : i64 to offset
    %score_view = buffer.view %feedback[%begin] : buffer -> view<1xf32>
    %score = view.load %score_view[0] : view<1xf32> -> f32
    %bits = scalar.bitcast %score : f32 to i32
    %mask = scalar.constant 2139095040 : i32
    %exponent = scalar.andi %bits, %mask : i32
    %finite = scalar.cmpi ne, %exponent, %mask : i32
    %error = global.load @pocket.eos_error : buffer
    func.call @pocket.check(%finite, %error) : (i1, buffer)
    %step = view.load %header[6] : view<8xi32> -> i32
    %eos = view.load %header[7] : view<8xi32> -> i32
    %unseen = scalar.cmpi eq, %eos, %missing : i32
    %eligible = scalar.cmpi uge, %step, %c6 : i32
    %threshold = scalar.constant -4.0 : f32
    %predicted = scalar.cmpf ogt, %score, %threshold : f32
    %eligible_prediction = scalar.andi %eligible, %predicted : i1
    %first_prediction = scalar.andi %unseen, %eligible_prediction : i1
    %first_eos = scf.select %first_prediction, %step, %eos : i32
    view.store %first_eos, %header[7] : i32, view<8xi32>
    %tail = view.load %packet[1] : view<4xi32> -> i32
    %stop = scalar.addi %first_eos, %tail : i32
    %seen = scalar.cmpi ne, %first_eos, %missing : i32
    %past_tail = scalar.cmpi uge, %step, %stop : i32
    %complete = scalar.andi %seen, %past_tail : i1
    %next = scalar.addi %step, %c1 : i32
    %maximum = view.load %packet[2] : view<4xi32> -> i32
    %room = scalar.cmpi ult, %next, %maximum : i32
    %valid = scalar.ori %complete, %room : i1
    %termination_error = global.load @pocket.termination_error : buffer
    func.call @pocket.check(%valid, %termination_error) : (i1, buffer)
    view.store %next, %header[6] : i32, view<8xi32>
    %terminal = scf.if %complete -> (i32) {
      %chunk = view.load %header[5] : view<8xi32> -> i32
      %chunks = view.load %header[4] : view<8xi32> -> i32
      %next_chunk = scalar.addi %chunk, %c1 : i32
      %last = scalar.cmpi eq, %next_chunk, %chunks : i32
      view.store %next_chunk, %header[5] : i32, view<8xi32>
      view.store %c4, %header[0] : i32, view<8xi32>
      %done = scalar.extui %last : i1 to i32
      scf.yield %done : i32
    } else {
      scf.yield %c0 : i32
    }
    %block_frames = scalar.constant 1920 : i64
    %count = scf.select %complete, %c0_i64, %block_frames : i64
    %next_position = scalar.addi %position, %count : i64
    view.store %next_position, %position_view[0] : i64, view<1xi64>
    %header_bytes = scalar.constant 4 : i64
    %sample_offset = scalar.addi %row_offset, %header_bytes : i64
    scf.yield %sample_offset, %count, %terminal : i64, i64, i32
  } else {
    %phase_index = index.cast %phase : i32 to index
    scf.switch %phase_index {
      case 0 {
        view.store %c1, %header[0] : i32, view<8xi32>
      }
      case 1 {
        view.store %c2, %header[0] : i32, view<8xi32>
      }
      case 3 {
      }
      case 4 {
        view.store %c5, %header[0] : i32, view<8xi32>
        view.store %c0, %header[1] : i32, view<8xi32>
        view.store %c0, %header[6] : i32, view<8xi32>
        view.store %missing, %header[7] : i32, view<8xi32>
      }
      default {
        %cursor = view.load %header[1] : view<8xi32> -> i32
        %next = scalar.addi %cursor, %c1 : i32
        %voice = scalar.cmpi eq, %phase, %c2 : i32
        %voice_frames = view.load %header[3] : view<8xi32> -> i32
        %limit = scf.if %voice -> (i32) {
          scf.yield %voice_frames : i32
        } else {
          %packet_origin = func.call @pocket.current_packet(%model, %state) : (buffer, buffer) -> (offset)
          %packet = buffer.view %state[%packet_origin] : buffer -> view<4xi32>
          %tokens = view.load %packet[0] : view<4xi32> -> i32
          scf.yield %tokens : i32
        }
        %finished = scalar.cmpi eq, %next, %limit : i32
        %next_cursor = scf.select %finished, %c0, %next : i32
        %next_phase = scalar.addi %phase, %c1 : i32
        %phase_after = scf.select %finished, %next_phase, %phase : i32
        view.store %phase_after, %header[0] : i32, view<8xi32>
        view.store %next_cursor, %header[1] : i32, view<8xi32>
      }
    }
    %save = scalar.constant 3 : i32
    %published = scalar.cmpi eq, %phase, %save : i32
    %done = scalar.extui %published : i1 to i32
    scf.yield %c0_i64, %c0_i64, %done : i64, i64, i32
  }
  func.return %position, %offset, %frames, %done : i64, i64, i64, i32
}
