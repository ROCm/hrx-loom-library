{
  "$schema": "https://raw.githubusercontent.com/ROCm/hrx-system/main/loom/py/loom/model/model-card.v1.schema.json",
  "schema_version": 1,
  "model": {
    "id": "xinntao/Real-ESRGAN-x4plus",
    "name": "Real-ESRGAN x4plus",
    "description": "Four-times image super-resolution with the RRDBNet generator (23 residual-in-residual dense blocks).",
    "origin": {
      "kind": "hf",
      "repository": "Comfy-Org/Real-ESRGAN",
      "revision": "5fd49b7b278836f48af63ecd314d0f98ab336105"
    },
    "license": "BSD-3-Clause"
  },
  "origins": {
    "checkpoint": {
      "kind": "hf",
      "repository": "Comfy-Org/Real-ESRGAN",
      "revision": "5fd49b7b278836f48af63ecd314d0f98ab336105"
    }
  },
  "programs": {
    "source": {
      "directory": "program",
      "inputs": [
        {
          "path": "program/prepare.loom",
          "data": [
            "program/weights.loom"
          ]
        },
        "program/control.loom"
      ],
      "libraries": [
        "program/generate.loom",
        "program/request.loom",
        "program/convolution.loom",
        "program/config.loom",
        "program/geometry.loom"
      ]
    },
    "archive": {
      "directory": "program",
      "inputs": [
        {
          "path": "program/prepare.loombc",
          "data": [
            "program/weights.loom"
          ]
        },
        "program/control.loombc"
      ],
      "libraries": [
        "program/generate.loombc",
        "program/request.loombc",
        "program/convolution.loombc",
        "program/config.loombc",
        "program/geometry.loombc"
      ]
    }
  },
  "services": {
    "image": {
      "kind": "image",
      "version": 1,
      "options": [],
      "interface": {
        "input": "base64 of the raw RGB input image in the prompt, at a quarter of the requested height and width",
        "output": "RGB image at four times the input height and width"
      },
      "constraints": {
        "width": {
          "minimum": 256,
          "maximum": 4096,
          "multiple_of": 256
        },
        "height": {
          "minimum": 16,
          "maximum": 4096,
          "multiple_of": 16
        }
      }
    }
  },
  "variants": {
    "f32": {
      "description": "Original F32 checkpoint; convolution weights are rounded to BF16 on the device, with F32 accumulation and activations.",
      "services": {
        "image": {
          "programs": [
            "source",
            "archive"
          ],
          "parameters": {
            "esrgan": {
              "files": [
                {
                  "path": "parameter/esrgan.safetensors",
                  "origin": "@checkpoint/RealESRGAN_x4plus.safetensors",
                  "format": "safetensors"
                }
              ]
            }
          },
          "tokenizers": {
            "text": {
              "path": "tokenizer.json",
              "format": "huggingface-json"
            }
          }
        }
      }
    }
  },
  "presets": {
    "upscale": {
      "service": "image",
      "variant": "f32",
      "programs": "source",
      "execution": {
        "width": 1024,
        "height": 1024,
        "text_tokens": 16
      },
      "workload": {
        "description": "One 256x256 input upscaled to 1024x1024."
      }
    },
    "lifecycle": {
      "service": "image",
      "variant": "f32",
      "programs": "source",
      "execution": {
        "width": 256,
        "height": 256,
        "text_tokens": 16
      },
      "workload": {
        "description": "One 64x64 input upscaled to 256x256."
      }
    }
  }
}
