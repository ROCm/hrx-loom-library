// Image admission and cohort keys at their public request boundaries. The
// served extents are the 4x output: height 16 to 4096 in multiples of 16 and
// width 256 to 4096 in multiples of 256, so the quarter-size input fills
// whole 4-row tiles and 64-pixel convolution rows. No learned parameters are
// read.

func.decl @esrgan.image_geometry_valid(%height: i64, %width: i64) -> (i1)

func.decl @esrgan.image_tag(%height: i64, %width: i64) -> (i64)

check.case public @minimum {
  %height = check.literal value(16) : i64
  %width = check.literal value(256) : i64
  %actual = func.call @esrgan.image_geometry_valid(%height, %width) : (i64, i64) -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

check.case public @lifecycle {
  %height = check.literal value(256) : i64
  %width = check.literal value(256) : i64
  %actual = func.call @esrgan.image_geometry_valid(%height, %width) : (i64, i64) -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

check.case public @upscale {
  %height = check.literal value(1024) : i64
  %width = check.literal value(1024) : i64
  %actual = func.call @esrgan.image_geometry_valid(%height, %width) : (i64, i64) -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

