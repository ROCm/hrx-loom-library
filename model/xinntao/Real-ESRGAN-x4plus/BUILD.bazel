load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
    "tokenizer.json",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/xinntao/Real-ESRGAN-x4plus/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_PROGRAM_NAMES = [
    "config",
    "control",
    "convolution",
    "generate",
    "geometry",
    "prepare",
    "request",
]

# The prompt-alphabet tokenizer is authored here rather than fetched: the
# checkpoint publisher ships no tokenizer because the model reads no text.
[
    loom_model(
        name = representation + suffix,
        assets = {
            "tokenizer.json": "tokenizer.json",
        },
        card = "model.json",
        data = {
            "//model/xinntao/Real-ESRGAN-x4plus/program:weights.loom": "program/weights.loom",
        },
        encoding = "preserve",
        files = {
            "//model/xinntao/Real-ESRGAN-x4plus/program:" + name + (".loom" if representation == "source" else ""): "program/" + name + (".loom" if representation == "source" else ".loombc")
            for name in _PROGRAM_NAMES
        },
        lockfile = "model.json.lock",
        model_name = "real-esrgan-x4plus",
        preset = preset,
        programs = representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
    ]
    for suffix, preset in [
        ("", "upscale"),
        ("_lifecycle", "lifecycle"),
    ]
]
