// Device-side request and weight preparation. The request packet is the
// standard base64 of the input's raw RGB bytes, four characters per pixel
// (see control.loom); decoding scales each byte by 1/255 into the first
// sixteen-channel block of an F32 activation, channels 3 through 15 zero.
// Checkpoint convolutions are F32 OIHW; packing rounds them to the BF16
// [outputs][inputs*9] layout the convolution kernels read, blocked along the
// reduction as (c/16)*144 + tap*16 + c%16 and zero past the real inputs.

config.decl @esrgan.height : %value: index where [range(%value, 4, 1024), multiple_of(%value, 4)]

config.decl @esrgan.width : %value: index where [range(%value, 64, 1024), multiple_of(%value, 64)]

amdgpu.target<gfx11-generic> @esrgan_request_wave32 {subgroup_size = 32}

template.decl @esrgan.sextet(%character: i32) -> (i32)

// The six-bit value of one base64 character. Both the standard (+/) and the
// URL-safe (-_) alphabets are accepted. control.loom rejects any other byte
// before the request reaches the device, so the zero fallback is never taken.
template.def<@esrgan.sextet> device @esrgan_sextet(%character: i32) -> (i32) {
  %c0_i32 = scalar.constant 0 : i32
  %upper_first = scalar.constant 65 : i32
  %upper_last = scalar.constant 90 : i32
  %lower_first = scalar.constant 97 : i32
  %lower_last = scalar.constant 122 : i32
  %digit_first = scalar.constant 48 : i32
  %digit_last = scalar.constant 57 : i32
  %plus = scalar.constant 43 : i32
  %minus = scalar.constant 45 : i32
  %slash = scalar.constant 47 : i32
  %underscore = scalar.constant 95 : i32
  %lower_shift = scalar.constant 71 : i32
  %digit_shift = scalar.constant 4 : i32
  %c62 = scalar.constant 62 : i32
  %c63 = scalar.constant 63 : i32
  %upper_low = scalar.cmpi uge, %character, %upper_first : i32
  %upper_high = scalar.cmpi ule, %character, %upper_last : i32
  %upper = scalar.andi %upper_low, %upper_high : i1
  %lower_low = scalar.cmpi uge, %character, %lower_first : i32
  %lower_high = scalar.cmpi ule, %character, %lower_last : i32
  %lower = scalar.andi %lower_low, %lower_high : i1
  %digit_low = scalar.cmpi uge, %character, %digit_first : i32
  %digit_high = scalar.cmpi ule, %character, %digit_last : i32
  %digit = scalar.andi %digit_low, %digit_high : i1
  %is_plus = scalar.cmpi eq, %character, %plus : i32
  %is_minus = scalar.cmpi eq, %character, %minus : i32
  %is_62 = scalar.ori %is_plus, %is_minus : i1
  %is_slash = scalar.cmpi eq, %character, %slash : i32
  %is_underscore = scalar.cmpi eq, %character, %underscore : i32
  %is_63 = scalar.ori %is_slash, %is_underscore : i1
  %upper_value = scalar.subi %character, %upper_first : i32
  %lower_value = scalar.subi %character, %lower_shift : i32
  %digit_value = scalar.addi %character, %digit_shift : i32
  %v0 = scf.select %upper, %upper_value, %c0_i32 : i32
  %v1 = scf.select %lower, %lower_value, %v0 : i32
  %v2 = scf.select %digit, %digit_value, %v1 : i32
  %v3 = scf.select %is_62, %c62, %v2 : i32
  %value = scf.select %is_63, %c63, %v3 : i32
  template.return %value : i32
}

// One lane per input pixel: four characters in, three bytes out.
kernel.def target(@esrgan_request_wave32) @esrgan_decode() {
  %height = config.get @esrgan.height : index
  %width = config.get @esrgan.width : index
  %pixels = index.mul %height, %width : index
  %threads = index.constant 128 : index
  %groups = index.div %pixels, %threads : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%packet: buffer, %image: buffer) {
  %height = config.get @esrgan.height : index
  %width = config.get @esrgan.width : index
  %pixels = index.mul %height, %width : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %threads = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %pixel_value = index.madd %group, %threads, %lane : index
  %pixel = index.assume %pixel_value [ge(%pixel_value, 0), lt(%pixel_value, %pixels)] : index
  %characters = buffer.view %packet[%origin] : buffer -> view<[%pixels]x4xi8>
  %image_view = buffer.view %image[%origin] : buffer -> view<[%pixels]x16xf32>
  %k0 = view.load %characters[%pixel, %c0] : view<[%pixels]x4xi8> -> i8
  %k1 = view.load %characters[%pixel, %c1] : view<[%pixels]x4xi8> -> i8
  %k2 = view.load %characters[%pixel, %c2] : view<[%pixels]x4xi8> -> i8
  %k3 = view.load %characters[%pixel, %c3] : view<[%pixels]x4xi8> -> i8
  %w0 = scalar.extui %k0 : i8 to i32
  %w1 = scalar.extui %k1 : i8 to i32
  %w2 = scalar.extui %k2 : i8 to i32
  %w3 = scalar.extui %k3 : i8 to i32
  %s0 = template.apply<@esrgan.sextet>(%w0) : (i32) -> (i32)
  %s1 = template.apply<@esrgan.sextet>(%w1) : (i32) -> (i32)
  %s2 = template.apply<@esrgan.sextet>(%w2) : (i32) -> (i32)
  %s3 = template.apply<@esrgan.sextet>(%w3) : (i32) -> (i32)
  %i4 = scalar.constant 4 : i32
  %i16 = scalar.constant 16 : i32
  %i64 = scalar.constant 64 : i32
  // red = s0 s1[5:4], green = s1[3:0] s2[5:2], blue = s2[1:0] s3
  %red_high = scalar.muli %s0, %i4 : i32
  %red_low = scalar.divui %s1, %i16 : i32
  %red = scalar.addi %red_high, %red_low : i32
  %green_bits = scalar.remui %s1, %i16 : i32
  %green_high = scalar.muli %green_bits, %i16 : i32
  %green_low = scalar.divui %s2, %i4 : i32
  %green = scalar.addi %green_high, %green_low : i32
  %blue_bits = scalar.remui %s2, %i4 : i32
  %blue_high = scalar.muli %blue_bits, %i64 : i32
  %blue = scalar.addi %blue_high, %s3 : i32
  %scale = scalar.constant 255.0 : f32
  %red_float = scalar.uitofp %red : i32 to f32
  %green_float = scalar.uitofp %green : i32 to f32
  %blue_float = scalar.uitofp %blue : i32 to f32
  %red_value = scalar.divf %red_float, %scale : f32
  %green_value = scalar.divf %green_float, %scale : f32
  %blue_value = scalar.divf %blue_float, %scale : f32
  view.store %red_value, %image_view[%pixel, %c0] : f32, view<[%pixels]x16xf32>
  view.store %green_value, %image_view[%pixel, %c1] : f32, view<[%pixels]x16xf32>
  view.store %blue_value, %image_view[%pixel, %c2] : f32, view<[%pixels]x16xf32>
  %c0_f32 = scalar.constant 0.0 : f32
  %c16 = index.constant 16 : index
  scf.for %channel = [%c3 to %c16 step %c1] unroll {
    view.store %c0_f32, %image_view[%pixel, %channel] : f32, view<[%pixels]x16xf32>
  }
  kernel.return
}

// One lane per packed column of one output row.
kernel.def target(@esrgan_request_wave32) @esrgan_pack(%outputs: index, %inputs: index) {
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 144 : index
  %threads = index.constant 256 : index
  %c255 = index.constant 255 : index
  %rounded = index.add %inputs, %c15 : index
  %blocks = index.div %rounded, %c16 : index
  %columns = index.mul %blocks, %c144 : index
  %padded = index.add %columns, %c255 : index
  %groups = index.div %padded, %threads : index
  kernel.launch.config workgroups(%groups, %outputs, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%outputs: index, %inputs: index, %weight: buffer, %packed: buffer) where [range(%outputs, 32, 64), multiple_of(%outputs, 32), range(%inputs, 3, 192)] {
  %origin = index.constant 0 : offset
  %c9 = index.constant 9 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c144 = index.constant 144 : index
  %threads = index.constant 256 : index
  %rounded = index.add %inputs, %c15 : index
  %blocks = index.div %rounded, %c16 : index
  %columns = index.mul %blocks, %c144 : index
  %taps = index.mul %inputs, %c9 : index
  %group = kernel.workgroup.id<x> : index
  %row_value = kernel.workgroup.id<y> : index
  %row = index.assume %row_value [ge(%row_value, 0), lt(%row_value, %outputs)] : index
  %lane = kernel.workitem.id<x> : index
  %column = index.madd %group, %threads, %lane : index
  %source = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%taps]xf32>
  %target = buffer.view %packed[%origin] : buffer -> view<[%outputs]x[%columns]xbf16>
  %live = index.cmp ult, %column, %columns : index
  scf.if %live {
    %block = index.div %column, %c144 : index
    %within = index.rem %column, %c144 : index
    %tap = index.div %within, %c16 : index
    %slot = index.rem %within, %c16 : index
    %channel = index.madd %block, %c16, %slot : index
    %present = index.cmp ult, %channel, %inputs : index
    %value = scf.if %present -> (f32) {
      %index_value = index.madd %channel, %c9, %tap : index
      %index = index.assume %index_value [ge(%index_value, 0), lt(%index_value, %taps)] : index
      %loaded = view.load %source[%row, %index] : view<[%outputs]x[%taps]xf32> -> f32
      scf.yield %loaded : f32
    } else {
      %c0_f32 = scalar.constant 0.0 : f32
      scf.yield %c0_f32 : f32
    }
    %rounded_value = scalar.fptrunc %value : f32 to bf16
    view.store %rounded_value, %target[%row, %column] : bf16, view<[%outputs]x[%columns]xbf16>
  }
  kernel.return
}
