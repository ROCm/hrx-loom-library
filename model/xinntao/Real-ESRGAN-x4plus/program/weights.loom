// The checkpoint's F32 tensors need no per-key storage conversion. The
// convolution operands are packed to BF16 on the device inside each
// invocation (request.loom), since a parameter transform cannot change dtype.
// This preparation policy remains auxiliary input when providers are bytecode.

func.def public @prepare_weight(%key: buffer) -> (i64) {
  %bytes = scalar.constant 0 : i64
  func.return %bytes : i64
}
