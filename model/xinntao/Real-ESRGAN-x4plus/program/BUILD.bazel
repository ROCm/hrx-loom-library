load("//build_tools/bazel:defs.bzl", "loom_library")

package(default_visibility = ["//model/xinntao/Real-ESRGAN-x4plus:__subpackages__"])

exports_files([
    "config.loom",
    "control.loom",
    "convolution.loom",
    "generate.loom",
    "geometry.loom",
    "prepare.loom",
    "request.loom",
    "weights.loom",
])

loom_library(
    name = "config",
    srcs = ["config.loom"],
)

loom_library(
    name = "control",
    srcs = ["control.loom"],
    deps = [":geometry"],
)

loom_library(
    name = "convolution",
    srcs = ["convolution.loom"],
)

loom_library(
    name = "generate",
    srcs = ["generate.loom"],
    deps = [
        ":convolution",
        ":request",
    ],
)

loom_library(
    name = "geometry",
    srcs = ["geometry.loom"],
)

loom_library(
    name = "prepare",
    srcs = ["prepare.loom"],
    deps = [":geometry"],
)

loom_library(
    name = "request",
    srcs = ["request.loom"],
)

loom_library(
    name = "weights",
    srcs = ["weights.loom"],
)
