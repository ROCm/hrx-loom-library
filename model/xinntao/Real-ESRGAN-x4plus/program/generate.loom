// The image root runs Real-ESRGAN x4plus (RRDBNet: 64 features, 23 residual-
// in-residual dense blocks, 32-channel growth) on one decoded request image
// and writes packed RGBA8 at four times its height and width. Activations and
// packed weights live in the reflected invocation workspace; the F32
// checkpoint stays in shared parameter storage.

config.decl @esrgan.height : %value: index where [range(%value, 4, 1024), multiple_of(%value, 4)]

config.decl @esrgan.width : %value: index where [range(%value, 64, 1024), multiple_of(%value, 64)]

kernel.decl @esrgan_convolution(%grid_height: index, %grid_width: index, %grid_in_total: index, %grid_inputs: index, %grid_out_total: index, %grid_out_offset: index, %grid_outputs: index, %grid_upsample: index, %grid_lrelu_flag: index, %grid_residual_mode: index) launch(%height: index, %width: index, %in_total: index, %inputs: index, %out_total: index, %out_offset: index, %outputs: index, %upsample: index, %lrelu_flag: index, %residual_mode: index, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %skip: buffer, %output: buffer) where [range(%height, 1, 4096), range(%width, 64, 4096), multiple_of(%width, 64), range(%in_total, 16, 512), range(%inputs, 16, 512), multiple_of(%inputs, 16), range(%out_total, 32, 512), range(%out_offset, 0, 480), range(%outputs, 32, 512), multiple_of(%outputs, 32), range(%upsample, 1, 2), range(%lrelu_flag, 0, 1), range(%residual_mode, 0, 3)]

kernel.decl @esrgan_rgba_convolution(%grid_height: index, %grid_width: index) launch(%height: index, %width: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer) where [range(%height, 4, 8192), multiple_of(%height, 4), range(%width, 128, 8192), multiple_of(%width, 128)]

kernel.decl @esrgan_decode() launch(%packet: buffer, %image: buffer)

kernel.decl @esrgan_pack(%grid_outputs: index, %grid_inputs: index) launch(%outputs: index, %inputs: index, %weight: buffer, %packed: buffer) where [range(%outputs, 32, 64), multiple_of(%outputs, 32), range(%inputs, 3, 192)]

// One 3x3 layer: pack its checkpoint weight, then convolve. `inputs` is the
// padded reduction the kernel reads and `weight_inputs` the checkpoint's own
// input channels (3 for conv_first, otherwise equal).
command.def @esrgan.convolution(%height: index, %width: index, %in_total: index, %inputs: index, %out_total: index, %out_offset: index, %outputs: index, %upsample: index, %lrelu_flag: index, %residual_mode: index, %weight_inputs: index) launch(%weight: buffer, %bias: buffer, %input: buffer, %residual: buffer, %skip: buffer, %output: buffer) {
  %c16 = index.constant 16 : index
  %c288 = index.constant 288 : offset
  %blocks = index.div %inputs, %c16 : index
  %rows = index.mul %outputs, %blocks : index
  // 144 BF16 columns per output channel and input block.
  %packed_bytes = index.scale %rows, %c288 : index, offset -> offset
  %packed = buffer.alloca<global> align(256) %packed_bytes : buffer
  kernel.launch @esrgan_pack[%outputs, %weight_inputs](%outputs, %weight_inputs, %weight, %packed) : [index, index](index, index, buffer, buffer)
  kernel.launch @esrgan_convolution[%height, %width, %in_total, %inputs, %out_total, %out_offset, %outputs, %upsample, %lrelu_flag, %residual_mode](%height, %width, %in_total, %inputs, %out_total, %out_offset, %outputs, %upsample, %lrelu_flag, %residual_mode, %input, %packed, %bias, %residual, %skip, %output) : [index, index, index, index, index, index, index, index, index, index](index, index, index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// A residual dense block grows its 64-channel input in place to 192 channels
// (four 32-channel layers with leaky ReLU), then the fifth layer writes 64
// channels to the target through the residual epilogue: mode 1 scales by 0.2
// and adds the block input; mode 2 additionally scales by 0.2 and adds the
// RRDB input held in skip.
command.def @esrgan.dense_block(%residual_mode: index) launch(%weight1: buffer, %weight2: buffer, %weight3: buffer, %weight4: buffer, %weight5: buffer, %bias1: buffer, %bias2: buffer, %bias3: buffer, %bias4: buffer, %bias5: buffer, %source: buffer, %target: buffer, %skip: buffer) {
  %height = config.get @esrgan.height : index
  %width = config.get @esrgan.width : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c128 = index.constant 128 : index
  %c160 = index.constant 160 : index
  %c192 = index.constant 192 : index
  command.launch @esrgan.convolution[%height, %width, %c192, %c64, %c192, %c64, %c32, %c1, %c1, %c0, %c64](%weight1, %bias1, %source, %source, %source, %source) : [index, index, index, index, index, index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height, %width, %c192, %c96, %c192, %c96, %c32, %c1, %c1, %c0, %c96](%weight2, %bias2, %source, %source, %source, %source) : [index, index, index, index, index, index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height, %width, %c192, %c128, %c192, %c128, %c32, %c1, %c1, %c0, %c128](%weight3, %bias3, %source, %source, %source, %source) : [index, index, index, index, index, index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height, %width, %c192, %c160, %c192, %c160, %c32, %c1, %c1, %c0, %c160](%weight4, %bias4, %source, %source, %source, %source) : [index, index, index, index, index, index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height, %width, %c192, %c192, %c192, %c0, %c64, %c1, %c0, %residual_mode, %c192](%weight5, %bias5, %source, %source, %skip, %target) : [index, index, index, index, index, index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Residual-in-residual dense block `block`: A -> B -> C -> A, with A also the
// skip of the last dense block. B and C are scratch shared by every block.
command.def @esrgan.rrdb(%block: index) launch(%parameters: buffer, %a: buffer, %b: buffer, %c: buffer) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %w11 = command.parameter %parameters, "body.{}.rdb1.conv1.weight"[%block] : view<32x64x3x3xf32>
  %w12 = command.parameter %parameters, "body.{}.rdb1.conv2.weight"[%block] : view<32x96x3x3xf32>
  %w13 = command.parameter %parameters, "body.{}.rdb1.conv3.weight"[%block] : view<32x128x3x3xf32>
  %w14 = command.parameter %parameters, "body.{}.rdb1.conv4.weight"[%block] : view<32x160x3x3xf32>
  %w15 = command.parameter %parameters, "body.{}.rdb1.conv5.weight"[%block] : view<64x192x3x3xf32>
  %b11 = command.parameter %parameters, "body.{}.rdb1.conv1.bias"[%block] : view<32xf32>
  %b12 = command.parameter %parameters, "body.{}.rdb1.conv2.bias"[%block] : view<32xf32>
  %b13 = command.parameter %parameters, "body.{}.rdb1.conv3.bias"[%block] : view<32xf32>
  %b14 = command.parameter %parameters, "body.{}.rdb1.conv4.bias"[%block] : view<32xf32>
  %b15 = command.parameter %parameters, "body.{}.rdb1.conv5.bias"[%block] : view<64xf32>
  %w21 = command.parameter %parameters, "body.{}.rdb2.conv1.weight"[%block] : view<32x64x3x3xf32>
  %w22 = command.parameter %parameters, "body.{}.rdb2.conv2.weight"[%block] : view<32x96x3x3xf32>
  %w23 = command.parameter %parameters, "body.{}.rdb2.conv3.weight"[%block] : view<32x128x3x3xf32>
  %w24 = command.parameter %parameters, "body.{}.rdb2.conv4.weight"[%block] : view<32x160x3x3xf32>
  %w25 = command.parameter %parameters, "body.{}.rdb2.conv5.weight"[%block] : view<64x192x3x3xf32>
  %b21 = command.parameter %parameters, "body.{}.rdb2.conv1.bias"[%block] : view<32xf32>
  %b22 = command.parameter %parameters, "body.{}.rdb2.conv2.bias"[%block] : view<32xf32>
  %b23 = command.parameter %parameters, "body.{}.rdb2.conv3.bias"[%block] : view<32xf32>
  %b24 = command.parameter %parameters, "body.{}.rdb2.conv4.bias"[%block] : view<32xf32>
  %b25 = command.parameter %parameters, "body.{}.rdb2.conv5.bias"[%block] : view<64xf32>
  %w31 = command.parameter %parameters, "body.{}.rdb3.conv1.weight"[%block] : view<32x64x3x3xf32>
  %w32 = command.parameter %parameters, "body.{}.rdb3.conv2.weight"[%block] : view<32x96x3x3xf32>
  %w33 = command.parameter %parameters, "body.{}.rdb3.conv3.weight"[%block] : view<32x128x3x3xf32>
  %w34 = command.parameter %parameters, "body.{}.rdb3.conv4.weight"[%block] : view<32x160x3x3xf32>
  %w35 = command.parameter %parameters, "body.{}.rdb3.conv5.weight"[%block] : view<64x192x3x3xf32>
  %b31 = command.parameter %parameters, "body.{}.rdb3.conv1.bias"[%block] : view<32xf32>
  %b32 = command.parameter %parameters, "body.{}.rdb3.conv2.bias"[%block] : view<32xf32>
  %b33 = command.parameter %parameters, "body.{}.rdb3.conv3.bias"[%block] : view<32xf32>
  %b34 = command.parameter %parameters, "body.{}.rdb3.conv4.bias"[%block] : view<32xf32>
  %b35 = command.parameter %parameters, "body.{}.rdb3.conv5.bias"[%block] : view<64xf32>
  command.launch @esrgan.dense_block[%c1](%w11, %w12, %w13, %w14, %w15, %b11, %b12, %b13, %b14, %b15, %a, %b, %b) : [index](view<32x64x3x3xf32>, view<32x96x3x3xf32>, view<32x128x3x3xf32>, view<32x160x3x3xf32>, view<64x192x3x3xf32>, view<32xf32>, view<32xf32>, view<32xf32>, view<32xf32>, view<64xf32>, buffer, buffer, buffer)
  command.launch @esrgan.dense_block[%c1](%w21, %w22, %w23, %w24, %w25, %b21, %b22, %b23, %b24, %b25, %b, %c, %c) : [index](view<32x64x3x3xf32>, view<32x96x3x3xf32>, view<32x128x3x3xf32>, view<32x160x3x3xf32>, view<64x192x3x3xf32>, view<32xf32>, view<32xf32>, view<32xf32>, view<32xf32>, view<64xf32>, buffer, buffer, buffer)
  command.launch @esrgan.dense_block[%c2](%w31, %w32, %w33, %w34, %w35, %b31, %b32, %b33, %b34, %b35, %c, %a, %a) : [index](view<32x64x3x3xf32>, view<32x96x3x3xf32>, view<32x128x3x3xf32>, view<32x160x3x3xf32>, view<64x192x3x3xf32>, view<32xf32>, view<32xf32>, view<32xf32>, view<32xf32>, view<64xf32>, buffer, buffer, buffer)
  command.return
}

// The batch payload is a 16-byte header followed by the single request's
// base64 characters; the output is RGBA8 at four times the input size.
command.def public @generate_image() launch(%parameters: buffer, %request: buffer, %output: buffer) {
  %height = config.get @esrgan.height : index
  %width = config.get @esrgan.width : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c23 = index.constant 23 : index
  %c64 = index.constant 64 : index
  %c192 = index.constant 192 : index
  %pixels = index.mul %height, %width : index
  %characters = index.mul %pixels, %c4 : index
  %height2 = index.mul %height, %c2 : index
  %width2 = index.mul %width, %c2 : index
  %height4 = index.mul %height, %c4 : index
  %width4 = index.mul %width, %c4 : index
  %header_bytes = index.constant 16 : offset
  %packet = buffer.view %request[%header_bytes] : buffer -> view<[%characters]xi8>
  // F32 activations: 16 channels for the decoded image, 64 for the trunk
  // feature, 192 for each dense-block buffer, 64 at 2x and 4x resolution.
  %image_stride = index.constant 64 : offset
  %feature_stride = index.constant 256 : offset
  %dense_stride = index.constant 768 : offset
  %double_stride = index.constant 1024 : offset
  %quadruple_stride = index.constant 4096 : offset
  %image_bytes = index.scale %pixels, %image_stride : index, offset -> offset
  %feature_bytes = index.scale %pixels, %feature_stride : index, offset -> offset
  %dense_bytes = index.scale %pixels, %dense_stride : index, offset -> offset
  %double_bytes = index.scale %pixels, %double_stride : index, offset -> offset
  %quadruple_bytes = index.scale %pixels, %quadruple_stride : index, offset -> offset
  %image = buffer.alloca<global> align(256) %image_bytes : buffer
  %feature = buffer.alloca<global> align(256) %feature_bytes : buffer
  %a = buffer.alloca<global> align(256) %dense_bytes : buffer
  %b = buffer.alloca<global> align(256) %dense_bytes : buffer
  %c = buffer.alloca<global> align(256) %dense_bytes : buffer
  %up1 = buffer.alloca<global> align(256) %double_bytes : buffer
  %up2 = buffer.alloca<global> align(256) %quadruple_bytes : buffer
  %hr = buffer.alloca<global> align(256) %quadruple_bytes : buffer
  kernel.launch @esrgan_decode(%packet, %image) : (view<[%characters]xi8>, buffer)
  %first_weight = command.parameter %parameters, "conv_first.weight" : view<64x3x3x3xf32>
  %first_bias = command.parameter %parameters, "conv_first.bias" : view<64xf32>
  // The trunk input is kept in the feature buffer for the long skip, and
  // starts the first dense-block buffer.
  command.launch @esrgan.convolution[%height, %width, %c16, %c16, %c64, %c0, %c64, %c1, %c0, %c0, %c3](%first_weight, %first_bias, %image, %feature, %feature, %feature) : [index, index, index, index, index, index, index, index, index, index, index](view<64x3x3x3xf32>, view<64xf32>, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height, %width, %c16, %c16, %c192, %c0, %c64, %c1, %c0, %c0, %c3](%first_weight, %first_bias, %image, %a, %a, %a) : [index, index, index, index, index, index, index, index, index, index, index](view<64x3x3x3xf32>, view<64xf32>, buffer, buffer, buffer, buffer)
  scf.for %block = [%c0 to %c23 step %c1] unroll {
    command.launch @esrgan.rrdb[%block](%parameters, %a, %b, %c) : [index](buffer, buffer, buffer, buffer)
  }
  %body_weight = command.parameter %parameters, "conv_body.weight" : view<64x64x3x3xf32>
  %body_bias = command.parameter %parameters, "conv_body.bias" : view<64xf32>
  %up1_weight = command.parameter %parameters, "conv_up1.weight" : view<64x64x3x3xf32>
  %up1_bias = command.parameter %parameters, "conv_up1.bias" : view<64xf32>
  %up2_weight = command.parameter %parameters, "conv_up2.weight" : view<64x64x3x3xf32>
  %up2_bias = command.parameter %parameters, "conv_up2.bias" : view<64xf32>
  %hr_weight = command.parameter %parameters, "conv_hr.weight" : view<64x64x3x3xf32>
  %hr_bias = command.parameter %parameters, "conv_hr.bias" : view<64xf32>
  %last_weight = command.parameter %parameters, "conv_last.weight" : view<3x64x3x3xf32>
  %last_bias = command.parameter %parameters, "conv_last.bias" : view<3xf32>
  // Trunk skip: feature += conv_body(trunk).
  command.launch @esrgan.convolution[%height, %width, %c192, %c64, %c64, %c0, %c64, %c1, %c0, %c3, %c64](%body_weight, %body_bias, %a, %feature, %feature, %feature) : [index, index, index, index, index, index, index, index, index, index, index](view<64x64x3x3xf32>, view<64xf32>, buffer, buffer, buffer, buffer)
  // Two nearest 2x upsamplings, each followed by a convolution and leaky ReLU.
  command.launch @esrgan.convolution[%height, %width, %c64, %c64, %c64, %c0, %c64, %c2, %c1, %c0, %c64](%up1_weight, %up1_bias, %feature, %up1, %up1, %up1) : [index, index, index, index, index, index, index, index, index, index, index](view<64x64x3x3xf32>, view<64xf32>, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height2, %width2, %c64, %c64, %c64, %c0, %c64, %c2, %c1, %c0, %c64](%up2_weight, %up2_bias, %up1, %up2, %up2, %up2) : [index, index, index, index, index, index, index, index, index, index, index](view<64x64x3x3xf32>, view<64xf32>, buffer, buffer, buffer, buffer)
  command.launch @esrgan.convolution[%height4, %width4, %c64, %c64, %c64, %c0, %c64, %c1, %c1, %c0, %c64](%hr_weight, %hr_bias, %up2, %hr, %hr, %hr) : [index, index, index, index, index, index, index, index, index, index, index](view<64x64x3x3xf32>, view<64xf32>, buffer, buffer, buffer, buffer)
  kernel.launch @esrgan_rgba_convolution[%height4, %width4](%height4, %width4, %hr, %last_weight, %last_bias, %output) : [index, index](index, index, buffer, view<3x64x3x3xf32>, view<3xf32>, buffer)
  command.return
}
