// Cold image preparation retains the original checkpoint sources and one
// default prompt stage. The source-owned state carries source ordinals so
// request stages reuse the same native base parameter domains. Z-Image-Turbo
// has no adapter path; the only deployment option is a workspace limit.

func.decl @zimage.bind_image_parameters(%stage: i32, %encoder: i32, %dit: i32, %vae: i32)

func.decl @zimage.declare_image_stage(%height: i64, %width: i64, %text: i64, %workspace_limit: i64) -> (i32)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

func.decl import("json") @parse_i64(%source: buffer, %offset: i64, %length: i64) -> (i64)

func.decl import("json") @unescape(%source: buffer, %offset: i64, %length: i64, %target: buffer, %target_offset: i64) -> (i64)

// Z-Image-Turbo has no adapters; leave the adapter asset empty
global.rodata.def @zimage.adapter_error = bytes("5a2d496d6167652d547572626f20686173206e6f2061646170746572733b206c6561766520746865206164617074657220617373657420656d707479")

// Z-Image-Turbo options accept only workspace_limit_bytes, once, as a positive integer
global.rodata.def @zimage.options_error = bytes("5a2d496d6167652d547572626f206f7074696f6e7320616363657074206f6e6c7920776f726b73706163655f6c696d69745f62797465732c206f6e63652c206173206120706f73697469766520696e7465676572")

// workspace_limit_bytes
global.rodata.def @zimage.workspace_option = bytes("776f726b73706163655f6c696d69745f6279746573")

// text_encoder
global.rodata.def @encoder_scope = bytes("746578745f656e636f646572")

// dit
global.rodata.def @dit_scope = bytes("646974")

// vae
global.rodata.def @vae_scope = bytes("766165")

// text
global.rodata.def @tokenizer = bytes("74657874")

// z-image-turbo
global.rodata.def @identifier = bytes("7a2d696d6167652d747572626f")

func.def @zimage.check_options(%valid: i1) {
  %condition = scalar.extui %valid : i1 to i32
  %error = global.load @zimage.options_error : buffer
  func.call @require(%condition, %error) : (i32, buffer)
  func.return
}

// Decodes one member name into private storage and compares it exactly.
func.def @zimage.option_named(%json: buffer, %begin: i64, %length: i64, %name: buffer) -> (i1) {
  %capacity_nonnegative = scalar.assume %length [range(%length, 0, 9223372036854775807)] : i64
  %capacity = index.cast %capacity_nonnegative : i64 to offset
  %decoded = buffer.alloca<private> align(1) %capacity : buffer
  %c0 = scalar.constant 0 : i64
  %size64 = func.call @unescape(%json, %begin, %length, %decoded, %c0) : (buffer, i64, i64, buffer, i64) -> (i64)
  %size_nonnegative = scalar.assume %size64 [range(%size64, 0, 9223372036854775807)] : i64
  %size = index.cast %size_nonnegative : i64 to offset
  %name_length = buffer.length %name
  %same_length = index.cmp eq, %size, %name_length : offset
  %equal = scf.if %same_length -> (i1) {
    %origin = index.constant 0 : offset
    %order = buffer.compare %decoded[%origin], %name[%origin], %size
    %c0_i32 = scalar.constant 0 : i32
    %same = scalar.cmpi eq, %order, %c0_i32 : i32
    scf.yield %same : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %equal : i1
}

// Options are a JSON object. An absent limit returns zero, which keeps the
// decoder untiled up to 128 latent pixels per axis.
func.def @zimage.workspace_limit(%options: buffer) -> (i64) {
  %fields, %type, %count64 = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object_type = scalar.constant 2 : i32
  %object = scalar.cmpi eq, %type, %object_type : i32
  func.call @zimage.check_options(%object) : (i1)
  %origin = index.constant 0 : offset
  %count_nonnegative = scalar.assume %count64 [range(%count64, 0, 9223372036854775807)] : i64
  %count = index.cast %count_nonnegative : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%count]x5xi64>
  %workspace_key = global.load @zimage.workspace_option : buffer
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %workspace, %seen = scf.for %i = [%c0 to %count step %c1](%workspace = %c0_i64 : i64, %seen = %c0_i64 : i64) -> (i64, i64) {
    %name_begin = view.load %records[%i, 0] : view<[%count]x5xi64> -> i64
    %name_length = view.load %records[%i, 1] : view<[%count]x5xi64> -> i64
    %value_begin = view.load %records[%i, 2] : view<[%count]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%count]x5xi64> -> i64
    %value_type = view.load %records[%i, 4] : view<[%count]x5xi64> -> i64
    %known = func.call @zimage.option_named(%options, %name_begin, %name_length, %workspace_key) : (buffer, i64, i64, buffer) -> (i1)
    %unique = scalar.cmpi eq, %seen, %c0_i64 : i64
    %number = scalar.cmpi eq, %value_type, %c1_i64 : i64
    %named = scalar.andi %known, %unique : i1
    %valid = scalar.andi %named, %number : i1
    func.call @zimage.check_options(%valid) : (i1)
    %value = func.call @parse_i64(%options, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
    %positive = scalar.cmpi sgt, %value, %c0_i64 : i64
    func.call @zimage.check_options(%positive) : (i1)
    scf.yield %value, %c1_i64 : i64, i64
  }
  func.return %workspace : i64
}

func.def public @image_prepare_v1(%height: i64, %width: i64, %text: i64, %directory: buffer, %adapter: buffer, %options: buffer) -> (i64, i64, buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %adapter_length = buffer.length %adapter
  %base = index.cmp eq, %adapter_length, %origin : offset
  %condition = scalar.extui %base : i1 to i32
  %error = global.load @zimage.adapter_error : buffer
  func.call @require(%condition, %error) : (i32, buffer)
  %workspace = func.call @zimage.workspace_limit(%options) : (buffer) -> (i64)
  %encoder_scope = global.load @encoder_scope : buffer
  %dit_scope = global.load @dit_scope : buffer
  %vae_scope = global.load @vae_scope : buffer
  %encoder = func.call @source_scope(%encoder_scope) : (buffer) -> (i32)
  %dit = func.call @source_scope(%dit_scope) : (buffer) -> (i32)
  %vae = func.call @source_scope(%vae_scope) : (buffer) -> (i32)
  %stage = func.call @zimage.declare_image_stage(%height, %width, %text, %workspace) : (i64, i64, i64, i64) -> (i32)
  func.call @zimage.bind_image_parameters(%stage, %encoder, %dit, %vae) : (i32, i32, i32, i32)
  // Native request transport bounds inputs and allocates only the payload.
  %capacity = scalar.constant 9223372036854775807 : i64
  %tokenizer = global.load @tokenizer : buffer
  %identifier = global.load @identifier : buffer
  %state_bytes = index.constant 64 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %state_view = buffer.view %state[%origin] : buffer -> view<8xi64>
  %stage64 = scalar.extui %stage : i32 to i64
  %encoder64 = scalar.extui %encoder : i32 to i64
  %dit64 = scalar.extui %dit : i32 to i64
  %vae64 = scalar.extui %vae : i32 to i64
  view.store %height, %state_view[0] : i64, view<8xi64>
  view.store %width, %state_view[1] : i64, view<8xi64>
  view.store %workspace, %state_view[2] : i64, view<8xi64>
  view.store %text, %state_view[3] : i64, view<8xi64>
  view.store %stage64, %state_view[4] : i64, view<8xi64>
  view.store %encoder64, %state_view[5] : i64, view<8xi64>
  view.store %dit64, %state_view[6] : i64, view<8xi64>
  view.store %vae64, %state_view[7] : i64, view<8xi64>
  %batch_units = scalar.constant 2 : i64
  func.return %batch_units, %capacity, %tokenizer, %identifier, %state : i64, i64, buffer, buffer, buffer
}
