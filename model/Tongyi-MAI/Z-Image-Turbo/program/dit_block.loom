// Transformer blocks. Each block normalizes the residual stream, attends,
// normalizes the attention projection again, and adds it back; the SwiGLU
// feed-forward repeats the pattern. Noise-refiner and main blocks scale both
// first norms by 1 + scale and gate both residuals by tanh(gate) from the
// step's modulation row; context-refiner blocks are unmodulated. Modulation
// immediates are byte offsets of the step's scale_msa; gate_msa, scale_mlp,
// and gate_mlp follow at 7680-byte strides.
//
//   refiner  image rows of the unified hidden state, every key live
//   context  caption rows, once per request, keys follow the caption mask
//   layer    [image, caption] rows, keys follow the whole key mask; the caption
//            projections read the mask and zero unattended caption tiles
//
// The hidden state advances in place. Rotations and the SwiGLU product advance
// their source-owned buffers in place. Lifetimes begin immediately before each
// producer and end at the last use.

config.decl @zimage.image_tokens : %value: index where [range(%value, 32, 65536), multiple_of(%value, 32)]

config.decl @zimage.text_tokens : %value: index where [range(%value, 32, 65536), multiple_of(%value, 32)]

command.decl @zimage.refiner_attention_norm(%layer: index, %offset: offset) launch(%parameters: buffer, %modulation: buffer, %input: buffer, %output: buffer)

command.decl @zimage.refiner_ffn_norm(%layer: index, %offset: offset) launch(%parameters: buffer, %modulation: buffer, %input: buffer, %output: buffer)

command.decl @zimage.refiner_attention_residual(%layer: index, %offset: offset) launch(%parameters: buffer, %modulation: buffer, %update: buffer, %residual: buffer)

command.decl @zimage.refiner_ffn_residual(%layer: index, %offset: offset) launch(%parameters: buffer, %modulation: buffer, %update: buffer, %residual: buffer)

command.decl @zimage.refiner_query_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer)

command.decl @zimage.refiner_key_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer)

command.decl @zimage.refiner_query(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @zimage.refiner_key(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @zimage.refiner_value(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

