command.decl @zimage.refiner_up(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @zimage.refiner_down(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @zimage.refiner_swiglu() launch(%gate: buffer, %up: buffer, %output: buffer)

command.decl @zimage.refiner_attention() launch(%query: buffer, %key: buffer, %value: buffer, %output: buffer)

command.decl @zimage.context_attention_norm(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.decl @zimage.context_ffn_norm(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

