  %unattended = scalar.constant 0 : i8
  %attended = scalar.cmpi ne, %state, %unattended : i8
  scf.if %attended {
    template.apply<@projection.linear_tiled_bf16>(%texts, %inputs, %outputs, %row_tiles, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
