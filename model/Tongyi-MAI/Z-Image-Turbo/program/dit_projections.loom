// Original BF16 transformer projections. Time, embedding, and output leaves add
// their BF16 bias to the F32 accumulator before the single BF16 rounding; the
// attention and feed-forward leaves have no bias. Image and text leaves cover
// the noise refiner (image rows), the context refiner (caption rows), and the
// unified layers, whose [image, caption] rows share one weight. Time leaves run
// over sixteen padded timestep rows; padded rows are storage, not extra steps.
// Each leaf fixes its contraction shape before applying the shared arithmetic.

config.decl @zimage.image_tokens : %value: index where [range(%value, 32, 65536), multiple_of(%value, 32)]

config.decl @zimage.text_tokens : %value: index where [range(%value, 32, 65536), multiple_of(%value, 32)]

amdgpu.target<gfx11-generic> @tensor_projection_rdna3

amdgpu.target<gfx11-generic> @dit_projection_wave32 {subgroup_size = 32}

template.decl @projection.linear_bf16(%rows: index, %inputs: index, %outputs: index, %row_origin: index, %output_origin: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)

template.decl @projection.bias_storage_bf16(%outputs: index, %output_origin: index, %weight_is_bf16: i1, %result: vector<8xf32>, %bias: buffer) -> (vector<8xf32>)

template.decl @projection.store_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)

amdgpu.target<gfx11-generic> @tensor_projection_tiled_rdna3

template.decl @projection.linear_tiled_bf16(%rows: index, %inputs: index, %outputs: index, %row_tile_group_size: index, %output_layout: encoding<layout>, %input: buffer, %weight: buffer, %output: buffer)

template.decl @zimage.projection_row_group_size(%rows: index, %minimum_grouped_rows: index) -> (index)

// Whole-height traversal keeps input reuse at small row counts; bounded row
// groups shorten the revisited input panel once the sequence is long.
template.def<@zimage.projection_row_group_size> device @dit_projection_row_group_size(%rows: index, %minimum_grouped_rows: index) -> (index) {
  %use_grouped = index.cmp uge, %rows, %minimum_grouped_rows : index
  %group_size = scf.if %use_grouped -> (index) {
    %group = index.constant 8 : index
    scf.yield %group : index
  } else {
    %rounding = index.constant 63 : index
    %tile = index.constant 64 : index
    %padded_rows = index.add %rows, %rounding : index
    %row_tiles = index.div %padded_rows, %tile : index
    scf.yield %row_tiles : index
  }
  template.return %group_size : index
}

template.decl @zimage.caption_tile_zero(%rows: index, %outputs: index, %output_layout: encoding<layout>, %output: buffer)

// Zero one whole-height 64x64 caption tile with the tiled helper's wave
// ownership: eight waves own a 4x2 grid of 16x32 outputs. Rows are a multiple
// of 32, so every wave owns a complete fragment or no output.
template.def<@zimage.caption_tile_zero> target(@tensor_projection_tiled_rdna3) requires [#target.subgroup.size<32>] @caption_tile_zero(%rows: index, %outputs: index, %output_layout: encoding<layout>, %output: buffer) {
  %origin = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %tile = index.constant 16 : index
  %wave_outputs = index.constant 32 : index
  %workgroup_tile = index.constant 64 : index
  %row_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %subgroup = kernel.subgroup.id : index
  %wave_row_group = index.div %subgroup, %c2 : index
  %wave_output_group = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_row_group, %tile : index
  %wave_output = index.mul %wave_output_group, %wave_outputs : index
  %row_origin = index.mul %row_tile, %workgroup_tile : index
  %output_origin = index.mul %output_tile, %workgroup_tile : index
  %result_row = index.add %row_origin, %wave_row : index
  %result_column0 = index.add %output_origin, %wave_output : index
  %result_column1 = index.add %result_column0, %tile : index
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%outputs]xbf16, %output_layout>
  %c0_0 = vector.splatf 0.0 : vector<8xf32>
  %zeros = vector.fragment<init> %c0_0 shape [%tile, %tile] : vector<8xf32>
  %result_valid = index.cmp ult, %result_row, %rows : index
  scf.if %result_valid {
    vector.fragment.store<result> %zeros, %output_view[%result_row, %result_column0] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%outputs]xbf16, %output_layout>
    vector.fragment.store<result> %zeros, %output_view[%result_row, %result_column1] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%outputs]xbf16, %output_layout>
  }
  template.return
}

amdgpu.target<gfx11-generic> @tensor_projection_wide_rdna3

template.decl @projection.linear_wide_bf16(%rows: index, %inputs: index, %outputs: index, %row_tile_group_size: index, %output_layout: encoding<layout>, %input: buffer, %weight: buffer, %output: buffer)

// t_embedder.mlp.0
kernel.def target(@dit_projection_wave32) @zimage_time_linear_256_1024() {
  %rows = index.constant 16 : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 64 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %rows = index.constant 16 : index
  %inputs = index.constant 256 : index
  %outputs = index.constant 1024 : index
  %projection_tile = index.constant 16 : index
  %row_tile_id = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %row_origin = index.mul %row_tile_id, %projection_tile : index
  %output_origin = index.mul %output_tile, %projection_tile : index
  %result = template.apply<@projection.linear_bf16>(%rows, %inputs, %outputs, %row_origin, %output_origin, %input, %weight) : (index, index, index, index, index, buffer, buffer) -> (vector<8xf32>)
  %weight_is_bf16 = scalar.constant true : i1
  %biased = template.apply<@projection.bias_storage_bf16>(%outputs, %output_origin, %weight_is_bf16, %result, %bias) : (index, index, i1, vector<8xf32>, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %output_layout, %biased, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

