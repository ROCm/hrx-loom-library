command.def public @zimage.layer_value(%layer: index) launch(%parameters: buffer, %input: buffer, %mask: buffer, %output: buffer) {
  %images = config.get @zimage.image_tokens : index
  %texts = config.get @zimage.text_tokens : index
  %tokens = index.add %images, %texts : index
  %origin = index.constant 0 : offset
  %fused = command.parameter %parameters, "layers.{}.attention.qkv.weight"[%layer] : view<11520x3840xbf16>
  %weight = view.subview %fused[7680, 0] : view<11520x3840xbf16> -> view<3840x3840xbf16>
  // Caption columns start image tokens into each channel row; each view spans
  // from its first column to its last column of channel 3839.
  %input_row_bytes = index.constant 7680 : offset
  %element_bytes = index.constant 2 : offset
  %mask_element_bytes = index.constant 1 : offset
  %input_text = index.scale %images, %input_row_bytes : index, offset -> offset
  %output_text = index.scale %images, %element_bytes : index, offset -> offset
  %mask_text = index.scale %images, %mask_element_bytes : index, offset -> offset
  %text_mask = buffer.view %mask[%mask_text] : buffer -> view<[%texts]xi8>
  %last_channel = index.constant 3839 : index
  %image_span = index.madd %last_channel, %tokens, %images : index
  %text_span = index.madd %last_channel, %tokens, %texts : index
  %image_input = buffer.view %input[%origin] : buffer -> view<[%images]x3840xbf16>
  %text_input = buffer.view %input[%input_text] : buffer -> view<[%texts]x3840xbf16>
  %image_output = buffer.view %output[%origin] : buffer -> view<[%image_span]xbf16>
  %text_output = buffer.view %output[%output_text] : buffer -> view<[%text_span]xbf16>
  command.concurrent {
    kernel.launch @zimage_unified_image_value_3840_3840(%image_input, %weight, %image_output) : (view<[%images]x3840xbf16>, view<3840x3840xbf16>, view<[%image_span]xbf16>)
    kernel.launch @zimage_unified_text_value_3840_3840(%text_input, %weight, %text_mask, %text_output) : (view<[%texts]x3840xbf16>, view<3840x3840xbf16>, view<[%texts]xi8>, view<[%text_span]xbf16>)
  }
  command.return
}
