// Standalone defaults for a 384x384 image, 512 caption rows, and the
// eight-step distilled schedule. Image preparation specializes every geometry
// value together before linking a serving stage. Reusable tensor motifs
// receive these facts as operands, not global reads.

config.def @zimage.image_tokens = 576 : index

config.def @zimage.time_count = 8 : index

config.def @zimage.text_tokens = 512 : index

config.def @zimage.latent_height = 48 : index

config.def @zimage.latent_width = 48 : index

config.def @zimage.vae_tile_height = 48 : index

config.def @zimage.vae_tile_width = 48 : index

config.def @zimage.batch_items = 1 : index
