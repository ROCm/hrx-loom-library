// Causal grouped-query attention for the Qwen3 text encoder. Token-major
// inputs have 32 query heads and eight key/value heads with 128 channels per
// head. The byte mask marks the right-padded <|endoftext|> rows invalid as keys;
// padded queries still attend to every valid prompt row, matching the reference.

config.decl @zimage.text_tokens : %value: index where [range(%value, 32, 65536), multiple_of(%value, 32)]

amdgpu.target<gfx11-generic> @tensor_expanded_attention_rdna3

amdgpu.target<gfx11-generic> @encoder_attention_wave64 {subgroup_size = 64}

template.decl @attention.expanded_masked_gqa_128_bf16(%tokens: index, %query_heads: index, %key_value_heads: index, %causal: i1, %value_layout: encoding<layout>, %query: buffer, %key: buffer, %value: buffer, %mask: buffer) -> (vector<8xbf16>)

template.decl @attention.store_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %output: buffer)

kernel.def target(@encoder_attention_wave64) @encoder_attention() {
  %tokens = config.get @zimage.text_tokens : index
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %heads = index.constant 32 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %heads, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %output: buffer) {
  %tokens = config.get @zimage.text_tokens : index
  %query_heads = index.constant 32 : index
  %key_value_heads = index.constant 8 : index
  %causal = scalar.constant true : i1
  %value_layout = encoding.layout.dense : encoding<layout>
  %result = template.apply<@attention.expanded_masked_gqa_128_bf16>(%tokens, %query_heads, %key_value_heads, %causal, %value_layout, %query, %key, %value, %mask) : (index, index, index, i1, encoding<layout>, buffer, buffer, buffer, buffer) -> (vector<8xbf16>)
  template.apply<@attention.store_128_bf16>(%tokens, %query_heads, %result, %output) : (index, index, vector<8xbf16>, buffer)
  kernel.return
}

// Inputs are token-major Q32/KV8 with 128 channels per head. The mask has one
// byte per row; row zero is always valid, so each query reads only valid keys
// at or before its sequence index and never sees an empty key set.
command.def public @zimage.encoder_attention() launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %output: buffer) {
  kernel.launch @encoder_attention(%query, %key, %value, %mask, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}
