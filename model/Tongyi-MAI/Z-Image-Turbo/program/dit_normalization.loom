// Query and key norms with rotation. Rotary tables hold image rows, then
// caption rows, 512 bytes each; the context refiner starts at the caption rows.
command.def public @zimage.refiner_query_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "noise_refiner.{}.attention.q_norm.weight"[%layer] : view<128xbf16>
  kernel.launch @zimage_refiner_rotary(%input, %weight, %cosine, %sine, %output) : (buffer, view<128xbf16>, buffer, buffer, buffer)
  command.return
}

command.def public @zimage.refiner_key_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "noise_refiner.{}.attention.k_norm.weight"[%layer] : view<128xbf16>
  kernel.launch @zimage_refiner_rotary(%input, %weight, %cosine, %sine, %output) : (buffer, view<128xbf16>, buffer, buffer, buffer)
  command.return
}

command.def public @zimage.context_query_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %images = config.get @zimage.image_tokens : index
  %texts = config.get @zimage.text_tokens : index
  %row_bytes = index.constant 512 : offset
  %text_origin = index.scale %images, %row_bytes : index, offset -> offset
  %text_cosine = buffer.view %cosine[%text_origin] : buffer -> view<[%texts]x128xf32>
  %text_sine = buffer.view %sine[%text_origin] : buffer -> view<[%texts]x128xf32>
  %weight = command.parameter %parameters, "context_refiner.{}.attention.q_norm.weight"[%layer] : view<128xbf16>
  kernel.launch @zimage_context_rotary(%input, %weight, %text_cosine, %text_sine, %output) : (buffer, view<128xbf16>, view<[%texts]x128xf32>, view<[%texts]x128xf32>, buffer)
  command.return
}

command.def public @zimage.context_key_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %images = config.get @zimage.image_tokens : index
  %texts = config.get @zimage.text_tokens : index
  %row_bytes = index.constant 512 : offset
  %text_origin = index.scale %images, %row_bytes : index, offset -> offset
  %text_cosine = buffer.view %cosine[%text_origin] : buffer -> view<[%texts]x128xf32>
  %text_sine = buffer.view %sine[%text_origin] : buffer -> view<[%texts]x128xf32>
  %weight = command.parameter %parameters, "context_refiner.{}.attention.k_norm.weight"[%layer] : view<128xbf16>
  kernel.launch @zimage_context_rotary(%input, %weight, %text_cosine, %text_sine, %output) : (buffer, view<128xbf16>, view<[%texts]x128xf32>, view<[%texts]x128xf32>, buffer)
  command.return
}

command.def public @zimage.layer_query_rotary(%layer: index) launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "layers.{}.attention.q_norm.weight"[%layer] : view<128xbf16>
  kernel.launch @zimage_layer_rotary(%input, %weight, %cosine, %sine, %output) : (buffer, view<128xbf16>, buffer, buffer, buffer)
