// Block norms. Input is the residual stream; output is a separate normalized
// buffer. The offset selects the block's time row in the modulation table.
command.def public @zimage.refiner_attention_norm(%layer: index, %offset: offset) launch(%parameters: buffer, %modulation: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "noise_refiner.{}.attention_norm1.weight"[%layer] : view<3840xbf16>
  %scale = buffer.view %modulation[%offset] : buffer -> view<3840xbf16>
  kernel.launch @zimage_refiner_modulate(%input, %weight, %scale, %output) : (buffer, view<3840xbf16>, view<3840xbf16>, buffer)
  command.return
}

command.def public @zimage.refiner_ffn_norm(%layer: index, %offset: offset) launch(%parameters: buffer, %modulation: buffer, %input: buffer, %output: buffer) {
  %scale_bytes = index.constant 15360 : offset
  %scale_offset = index.add %offset, %scale_bytes : offset
  %weight = command.parameter %parameters, "noise_refiner.{}.ffn_norm1.weight"[%layer] : view<3840xbf16>
  %scale = buffer.view %modulation[%scale_offset] : buffer -> view<3840xbf16>
  kernel.launch @zimage_refiner_modulate(%input, %weight, %scale, %output) : (buffer, view<3840xbf16>, view<3840xbf16>, buffer)
  command.return
}

