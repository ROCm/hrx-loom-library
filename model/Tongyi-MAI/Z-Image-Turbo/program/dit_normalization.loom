  %gate = buffer.view %modulation[%gate_offset] : buffer -> view<3840xbf16>
  kernel.launch @zimage_refiner_residual(%update, %weight, %gate, %residual) : (buffer, view<3840xbf16>, view<3840xbf16>, buffer)
