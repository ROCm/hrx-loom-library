// The final table stores the unactivated scale row. Input is the unified
// hidden state; only its leading image rows are normalized.
command.def public @zimage.final_norm(%offset: offset) launch(%modulation: buffer, %input: buffer, %output: buffer) {
  %scale = buffer.view %modulation[%offset] : buffer -> view<3840xbf16>
  kernel.launch @zimage_final_modulate(%input, %scale, %output) : (buffer, view<3840xbf16>, buffer)
  command.return
}
