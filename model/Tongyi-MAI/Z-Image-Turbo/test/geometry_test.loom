// Image admission, VAE workspace policy, and cohort keys at their public
// request boundaries. Admission requires 16-aligned pixel extents, 32-aligned
// caption rows, and at least 32 image patches in a multiple of 32. Expected
// tiles follow from the 128-latent decoder cap and the 30-pixel overlap rule;
// no learned parameters are read.

func.decl @zimage.image_geometry_valid(%height: i64, %width: i64, %text: i64) -> (i1)

func.decl @zimage.vae_workspace_tile(%height: i64, %width: i64, %limit: i64) -> (i64, i64)

func.decl @zimage.image_tag(%height: i64, %width: i64, %text: i64) -> (i64)

check.case public @minimum_patches {
  %height = check.literal value(64) : i64
  %width = check.literal value(128) : i64
  %text = check.literal value(32) : i64
  %actual = func.call @zimage.image_geometry_valid(%height, %width, %text) : (i64, i64, i64) -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

