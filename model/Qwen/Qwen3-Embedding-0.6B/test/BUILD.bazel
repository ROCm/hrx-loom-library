load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")
load("@hrx//build_tools/bazel:requirements.bzl", "apply_test_requirements")
load("@hrx//loom/target/amd/xdna:execution_profiles.bzl", "XDNA_HARDWARE_PROFILE")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "math",
    srcs = ["math_test.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//model/Qwen/Qwen3-Embedding-0.6B/program:math"],
)

loom_test(
    name = "cohort",
    srcs = ["cohort_test.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//model/Qwen/Qwen3-Embedding-0.6B/program:cohort"],
)

loom_test(
    name = "attention",
    # Compile with the production module to exercise its private recurrence
    # leaves without expanding their model-facing linking surface.
    srcs = [
        "attention_test.loom",
        "//model/Qwen/Qwen3-Embedding-0.6B/program:attention.loom",
    ],
    execution_profiles = [XDNA_HARDWARE_PROFILE],
    deps = [
        "//model/Qwen/Qwen3-Embedding-0.6B/program:tile_math",
        "//motif/format/bfp16ebs8:aie2p",
    ],
)

[
    filegroup(
        name = representation + "_card",
        srcs = ["//model/Qwen/Qwen3-Embedding-0.6B:" + representation],
        output_group = "model_card",
    )
    for representation in [
        "source",
        "archive",
    ]
]

_REQUIREMENTS = apply_test_requirements(
    {},
    build_requirements = XDNA_HARDWARE_PROFILE.build_requirements,
    resource_group = XDNA_HARDWARE_PROFILE.resource_group,
    run_requirements = XDNA_HARDWARE_PROFILE.run_requirements,
)

# Full weights remain externally provisioned; the card and lock carry their
# trusted cache identity. The composition requires an eight-column context.
[
    iree_py_test(
        name = "embedding_" + representation + "_test",
        size = "large",
        srcs = [
            "embedding_check.py",
            "reference_inputs.py",
        ],
        args = [
            "--server=$(location @loom_sdk//:loom-serve)",
            "--model=$(location :" + representation + "_card)",
            "--reference=$(location reference.json)",
            "--device=xdna://0?columns=8",
        ],
        data = [
            ":" + representation + "_card",
            "publisher.f32",
            "reference.json",
            "@loom_sdk//:loom-serve",
        ],
        imports = ["."],
        main = "embedding_check.py",
        resource_group = _REQUIREMENTS["resource_group"],
        tags = [
            "manual",
            "stress",
        ] + _REQUIREMENTS["tags"],
        target_compatible_with = _REQUIREMENTS["target_compatible_with"],
        deps = [
            "@hrx//loom/src/loom/serve/testing/loom_serve_testing:http",
            "@hrx//loom/src/loom/serve/testing/loom_serve_testing:model_staging",
        ],
    )
    for representation in [
        "source",
        "archive",
    ]
]
