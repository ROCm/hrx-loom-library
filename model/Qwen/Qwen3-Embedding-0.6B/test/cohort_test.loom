func.decl @request_layout(%request: buffer) -> (offset, offset, offset, offset)

func.decl @select_cohort(%request: buffer, %owner: offset, %control: offset)

func.decl @cohort_payload(%request: buffer, %owner: offset, %control: offset) -> (buffer)

// Construct the prepared-input contract with one distinct token ID per row.
// The production selector owns every admission and continuation decision.
func.def @uniform_request(%rows: index, %tokens: index) -> (buffer, offset, offset) where [range(%rows, 1, 8193), range(%tokens, 1, 32768)] {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %header_bytes = index.constant 32 : offset
  %row_bytes = index.constant 16 : offset
  %id_bytes = index.constant 4 : offset
  %directory_bytes = index.scale %rows, %row_bytes : index, offset -> offset
  %payload_offset = index.add %header_bytes, %directory_bytes : offset
  %sequence_bytes = index.scale %tokens, %id_bytes : index, offset -> offset
  %payload_bytes = index.scale %rows, %sequence_bytes : index, offset -> offset
  %prepared_bytes = index.add %payload_offset, %payload_bytes : offset
  %prepared = buffer.alloca<private> align(8) %prepared_bytes : buffer
  %header = buffer.view %prepared[%origin] : buffer -> view<4xi64>
  %rows64 = index.cast %rows : index to i64
  %tokens64 = index.cast %tokens : index to i64
  %count = scalar.muli %rows64, %tokens64 : i64
  %dimensions = scalar.constant 257 : i64
  %alignment_bias = scalar.constant 7 : i64
  %mask = scalar.constant -8 : i64
  %rounded = scalar.addi %tokens64, %alignment_bias : i64
  %aligned = scalar.andi %rounded, %mask : i64
  %slots = scalar.muli %rows64, %aligned : i64
  view.store %rows64, %header[0] : i64, view<4xi64>
  view.store %dimensions, %header[1] : i64, view<4xi64>
  view.store %count, %header[2] : i64, view<4xi64>
  view.store %slots, %header[3] : i64, view<4xi64>
  %directory = buffer.view %prepared[%header_bytes] : buffer -> view<[%rows]x2xi64>
  scf.for %row = [%begin to %rows step %step] {
    %relative = index.scale %row, %sequence_bytes : index, offset -> offset
    %offset = index.add %payload_offset, %relative : offset
    %offset64 = index.cast %offset : offset to i64
    view.store %offset64, %directory[%row, 0] : i64, view<[%rows]x2xi64>
    view.store %tokens64, %directory[%row, 1] : i64, view<[%rows]x2xi64>
    %ids = buffer.view %prepared[%offset] : buffer -> view<[%tokens]xi32>
    %id = index.cast %row : index to i32
    scf.for %position = [%begin to %tokens step %step] {
      view.store %id, %ids[%position] : i32, view<[%tokens]xi32>
    }
  }
  %bytes, %prefix_bytes, %owner_offset, %control_offset = func.call @request_layout(%prepared) : (buffer) -> (offset, offset, offset, offset)
  %request = buffer.alloca<private> align(8) %bytes : buffer
  buffer.copy %prepared[%origin], %request[%origin], %prefix_bytes
  %owner = buffer.view %request[%owner_offset] : buffer -> view<2xi64>
  %zero64 = scalar.constant 0 : i64
  view.store %zero64, %owner[0] : i64, view<2xi64>
  view.store %zero64, %owner[1] : i64, view<2xi64>
  func.return %request, %owner_offset, %control_offset : buffer, offset, offset
}

// Observe the producer's summary and cursor rather than recomputing its policy.
func.def @next_cohort(%request: buffer, %owner_offset: offset, %control_offset: offset) -> (i64, i64, i64, i64) {
  func.call @select_cohort(%request, %owner_offset, %control_offset) : (buffer, offset, offset)
  %summary = buffer.view %request[%control_offset] : buffer -> view<4xi64>
  %rows = view.load %summary[1] : view<4xi64> -> i64
  %tokens = view.load %summary[2] : view<4xi64> -> i64
  %owner = buffer.view %request[%owner_offset] : buffer -> view<2xi64>
  %begin = view.load %owner[0] : view<2xi64> -> i64
  %end = view.load %owner[1] : view<2xi64> -> i64
  func.return %rows, %tokens, %begin, %end : i64, i64, i64, i64
}

func.def @metadata_row(%payload: buffer, %row: index) -> (i32, i32, i32, i32) where [range(%row, 0, 32767)] {
  %header_bytes = index.constant 96 : offset
  %record_bytes = index.constant 64 : offset
  %relative = index.scale %row, %record_bytes : index, offset -> offset
  %offset = index.add %header_bytes, %relative : offset
  %metadata = buffer.view %payload[%offset] : buffer -> view<16xi32>
  %id = view.load %metadata[0] : view<16xi32> -> i32
  %identity = view.load %metadata[1] : view<16xi32> -> i32
  %position = view.load %metadata[2] : view<16xi32> -> i32
  %dimensions = view.load %metadata[3] : view<16xi32> -> i32
  func.return %id, %identity, %position, %dimensions : i32, i32, i32, i32
}

check.case @logical_rows_span_three_cohorts {
  %count = check.literal value(8193) : index
  %length = check.literal value(1) : index
  %request, %owner, %control = func.call @uniform_request(%count, %length) : (index, index) -> (buffer, offset, offset)
  %first_rows, %first_tokens, %first_begin, %first_end = func.call @next_cohort(%request, %owner, %control) : (buffer, offset, offset) -> (i64, i64, i64, i64)
  %zero = check.literal value(0) : i64
  %full = check.literal value(4096) : i64
  check.expect.equal actual(%first_rows) expected(%full) : i64
  check.expect.equal actual(%first_tokens) expected(%full) : i64
  check.expect.equal actual(%first_begin) expected(%zero) : i64
  check.expect.equal actual(%first_end) expected(%full) : i64
  %second_rows, %second_tokens, %second_begin, %second_end = func.call @next_cohort(%request, %owner, %control) : (buffer, offset, offset) -> (i64, i64, i64, i64)
  %twice = check.literal value(8192) : i64
  check.expect.equal actual(%second_rows) expected(%full) : i64
  check.expect.equal actual(%second_tokens) expected(%full) : i64
  check.expect.equal actual(%second_begin) expected(%full) : i64
  check.expect.equal actual(%second_end) expected(%twice) : i64
  %last_rows, %last_tokens, %last_begin, %last_end = func.call @next_cohort(%request, %owner, %control) : (buffer, offset, offset) -> (i64, i64, i64, i64)
  %one = check.literal value(1) : i64
  %all = check.literal value(8193) : i64
  check.expect.equal actual(%last_rows) expected(%one) : i64
  check.expect.equal actual(%last_tokens) expected(%one) : i64
  check.expect.equal actual(%last_begin) expected(%twice) : i64
  check.expect.equal actual(%last_end) expected(%all) : i64
  %payload = func.call @cohort_payload(%request, %owner, %control) : (buffer, offset, offset) -> (buffer)
  %first_slot = check.literal value(0) : index
  %padding_slot = check.literal value(1) : index
  %id, %identity, %position, %dimensions = func.call @metadata_row(%payload, %first_slot) : (buffer, index) -> (i32, i32, i32, i32)
  %padding_id, %padding, %padding_position, %padding_dimensions = func.call @metadata_row(%payload, %padding_slot) : (buffer, index) -> (i32, i32, i32, i32)
  %expected_id = check.literal value(8192) : i32
  %expected_identity = check.literal value(0) : i32
  %invalid = check.literal value(-1) : i32
  check.expect.equal actual(%id) expected(%expected_id) : i32
  check.expect.equal actual(%identity) expected(%expected_identity) : i32
  check.expect.equal actual(%padding) expected(%invalid) : i32
  check.return
}

check.case @full_context_keeps_original_positions {
  %count = check.literal value(2) : index
  %length = check.literal value(32768) : index
  %request, %owner, %control = func.call @uniform_request(%count, %length) : (index, index) -> (buffer, offset, offset)
  %first_rows, %first_tokens, %first_begin, %first_end = func.call @next_cohort(%request, %owner, %control) : (buffer, offset, offset) -> (i64, i64, i64, i64)
  %rows, %tokens, %begin, %end = func.call @next_cohort(%request, %owner, %control) : (buffer, offset, offset) -> (i64, i64, i64, i64)
  %one = check.literal value(1) : i64
  %two = check.literal value(2) : i64
  %context = check.literal value(32768) : i64
  check.expect.equal actual(%first_rows) expected(%one) : i64
  check.expect.equal actual(%first_tokens) expected(%context) : i64
  check.expect.equal actual(%rows) expected(%one) : i64
  check.expect.equal actual(%tokens) expected(%context) : i64
  check.expect.equal actual(%begin) expected(%one) : i64
  check.expect.equal actual(%end) expected(%two) : i64
  %payload = func.call @cohort_payload(%request, %owner, %control) : (buffer, offset, offset) -> (buffer)
  %last_slot = check.literal value(32767) : index
  %id, %identity, %position, %dimensions = func.call @metadata_row(%payload, %last_slot) : (buffer, index) -> (i32, i32, i32, i32)
  %expected_id = check.literal value(1) : i32
  %expected_identity = check.literal value(0) : i32
  %last_position = check.literal value(32767) : i32
  %expected_dimensions = check.literal value(257) : i32
  check.expect.equal actual(%id) expected(%expected_id) : i32
  check.expect.equal actual(%identity) expected(%expected_identity) : i32
  check.expect.equal actual(%position) expected(%last_position) : i32
  check.expect.equal actual(%dimensions) expected(%expected_dimensions) : i32
  check.return
}
