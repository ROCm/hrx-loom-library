// Query/key epilogue for the fixed embedding pipeline. This role shares row
// normalization and projection output duties with its paired value worker,
// then normalizes requested embedding prefixes in the final cohort phase.
// array.cxx supplies local/peer banks, exact output offsets, channels, and
// barrier endpoints. No storage or execution context is created here.
func.decl inline @qwen3_embedding.shared_block_attention_keys(%input: view<32x128xbf16>, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.shared_block_dense_result(%input: view<16x4x64xbf16>, %output: view<16x4x64xbf16>)

func.decl inline @qwen3_embedding.shared_block_four_rows(%input: view<4x1024xbf16>, %output: view<128x4x8xbf16>)

func.decl inline @qwen3_embedding.shared_block_left(%input: view<32x128xbf16>, %output: view<4096xbf16>)

func.decl noinline @qwen3_embedding.shared_copy_output(%input: view<4096xbf16>, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.shared_dense_block_values(%input: view<32x128xbf16>, %output: view<16x4x64xbf16>)

func.decl inline @qwen3_embedding.shared_dense_heads(%input: view<32x128xbf16>, %scale: view<128xbf16>, %rope: view<32x2x64xbf16>)

func.decl inline @qwen3_embedding.shared_dense_rows(%input: view<16x4x64xf32>, %output: view<32x128xbf16>)

func.decl inline @qwen3_embedding.shared_normalize_shared(%rows: view<1024xbf16>, %scale: view<1024xbf16>)

func.decl inline @qwen3_embedding.shared_retain_residual_panel(%input: view<4096xbf16>, %output: view<32x128xbf16>, %record: index, %feature: index) where [range(%record, 0, 7), range(%feature, 0, 896), multiple_of(%feature, 128)]

func.decl inline @qwen3_embedding.shared_swiglu_dense(%gate_storage: buffer, %up_storage: buffer, %slot: offset, %swap_tables: i1)

func.decl inline @qwen3_embedding.block_attention_keys(%input: view<32x128xbf16>, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.attention_query(%storage: buffer, %input: channel<tile<4624xi32>>, %probabilities: channel<tile<4096xbf16>>, %results: channel<tile<4096xbf16>>, %output: buffer, %output_base: offset, %panel_stride: offset, %emit_output: i1)

func.decl inline @qwen3_embedding.attention_value(%storage: buffer, %input: channel<tile<4624xi32>>, %probabilities: channel<tile<4096xbf16>>, %results: channel<tile<4096xbf16>>, %output: buffer, %output_base: offset, %panel_stride: offset, %emit_output: i1)

func.decl inline @qwen3_embedding.copy_output(%input: view<4096xbf16>, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.wait(%channel: channel<tile<16xi32>>)

func.decl inline @qwen3_embedding.signal(%channel: channel<tile<16xi32>>)

func.decl inline @qwen3_embedding.normalize_shared(%length: index, %input: view<1024xbf16>, %scale: view<1024xbf16>, %output: view<1024xbf16>)

template.decl @normalization.l2_prefix_bf16(%width: index, %dimension_count: i32, %minimum_norm_squared: f32, %normalized: view<[%width]xbf16>, %output: view<[%width]xf32>)

func.decl inline @qwen3_embedding.block_four_rows(%input: view<4x1024xbf16>, %output: view<128x4x8xbf16>)

func.decl noinline @qwen3_embedding.pack_dense_activations(%storage: buffer, %input: offset)

func.decl noinline @qwen3_embedding.dense_accumulate(%storage: buffer, %output_storage: buffer, %output_offset: offset, %first_chunk: i1)

func.decl inline @qwen3_embedding.retain_residual_panel(%input: view<4096xbf16>, %output: view<32x128xbf16>, %record: index, %feature: index)

func.decl inline @qwen3_embedding.swiglu_dense(%gate: view<4096xf32>, %up: view<4096xf32>, %table_ab: buffer, %table_cd: buffer, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.dense_rows(%input: view<16x4x64xf32>, %secondary: view<16x4x64xf32>, %first: i1, %output: view<32x128xbf16>)

func.decl inline @qwen3_embedding.dense_heads(%input: view<32x128xbf16>, %scale: view<128xbf16>, %rope: view<32x2x64xbf16>)

func.decl inline @qwen3_embedding.block_dense_result(%input: view<16x4x64xbf16>, %output: view<16x4x64xbf16>)

func.decl inline @qwen3_embedding.dense_block_values(%input: view<32x128xbf16>, %output: view<16x4x64xbf16>)

func.decl inline @qwen3_embedding.identity(%output: view<8x8xbf16>)

func.decl inline @qwen3_embedding.block_right(%input: view<32x128xbf16>, %output: view<4096xbf16>)

func.decl inline @bfp16ebs8.pack_bf16_residual_aie2p(%storage: buffer, %input: offset, %output: offset, %identity: offset, %count: i32)

func.decl inline @qwen3_embedding.block_left(%input: view<32x128xbf16>, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.three_products(%storage: buffer, %temporary: view<8x8xf32>, %output: view<32x128xbf16>)

// Owns dense epilogues while its ingress peer owns the softmax and global writes.
func.def public inline @qwen3_embedding.query_key_epilogue(%sequence_storage: buffer, %origin: offset, %dimension_storage: buffer, %local_storage: buffer, %result_offset: offset, %peer_storage: buffer, %activation_stream: channel<tile<2048xi32>>, %zero: index, %one: index, %incoming_arrival: channel<tile<16xi32>>, %outgoing_arrival: channel<tile<16xi32>>, %incoming_departure: channel<tile<16xi32>>, %outgoing_departure: channel<tile<16xi32>>, %normalization_stream: channel<tile<4096xbf16>>, %weight_stream: channel<tile<4624xi32>>, %activation_offset: offset, %projection_stream: channel<tile<4096xbf16>>, %probability_stream: channel<tile<4096xbf16>>, %column_offset: index, %dimension_row_base: index, %row_column: index, %skip_column: index, %layer: index, %dense_group: index) {
  %sequence_ids = buffer.view %sequence_storage[%origin] : buffer -> view<128xi32>
  %dimensions = buffer.view %dimension_storage[%origin] : buffer -> view<2x4xi32>
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %capacity = index.constant 128 : index
  %chunk_words = index.constant 512 : index
  %vector_step = index.constant 32 : index
  %record_stride = index.constant 8192 : offset
  %episode_input_stride = index.constant 8192 : offset
  %episode_output_stride = index.constant 524288 : offset

  %identity_offset = index.constant 27008 : offset
  %temporary_offset = index.constant 10368 : offset
  %scores_offset = index.constant 9344 : offset
  %packed_low = index.constant 4672 : offset
  %right_high = index.constant 27136 : offset
  %right_low = index.constant 45632 : offset
  %right_stride = index.constant 1152 : offset
  %right_count = scalar.constant 16 : i32
  %left_count = scalar.constant 64 : i32
  %identity = buffer.view %local_storage[%identity_offset] : buffer -> view<8x8xbf16>
  %temporary = buffer.view %local_storage[%temporary_offset] : buffer -> view<8x8xf32>
  %scores = buffer.view %local_storage[%scores_offset] : buffer -> view<128xf32>
  %raw = buffer.view %local_storage[%origin] : buffer -> view<4096xbf16>
  %raw_matrix = buffer.view %local_storage[%origin] : buffer -> view<32x128xbf16>
  %blocked = buffer.view %local_storage[%result_offset] : buffer -> view<4096xbf16>

  %last_chunk = index.constant 7 : index
  %dense_input_stride = index.constant 32768 : offset
  %dense_packed_offset = index.constant 27008 : offset
  %dense_result_offset = index.constant 31680 : offset
  %dense_primary = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_secondary = buffer.view %local_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_primary_bits = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_secondary_bits = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_blocked_values = buffer.view %local_storage[%dense_result_offset] : buffer -> view<16x4x64xbf16>
  %dense_scale_offset = index.constant 8192 : offset
  %dense_scale_stride = index.constant 256 : offset
  %dense_rope_offset = index.constant 8704 : offset
  %dense_scales = buffer.view %local_storage[%dense_scale_offset] : buffer -> view<256xbf16>
  %dense_rope_bits = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<4096xbf16>
  %dense_rope = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<32x2x64xbf16>
  %scale_words = index.constant 256 : index
  %episode_state_stride = index.constant 2924544 : offset
  %c3 = index.constant 3 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c16 = index.constant 16 : index
  %c24 = index.constant 24 : index
  %layers = index.constant 29 : index
  %learned_layers = index.constant 28 : index

  %initial_layer = index.cmp eq, %layer, %zero : index
  %constant_base = index.constant 497172480 : offset
  %constant_stride = index.constant 8192 : offset
  %constant_relative = index.scale %layer, %constant_stride : index, offset -> offset
  %constant_offset = index.add %constant_base, %constant_relative : offset
  %final_layer = index.cmp eq, %layer, %learned_layers : index
  %learned_layer = index.cmp ult, %layer, %learned_layers : index
  %active_groups = scf.select %final_layer, %one, %c7 : index

  %panels = index.constant 2 : index
  scf.for %episode = [%zero to %panels step %one] {
    %episode_input_offset = index.scale %episode, %episode_input_stride : index, offset -> offset
    %episode_state_offset = index.scale %episode, %episode_state_stride : index, offset -> offset
    %episode_output_offset = index.scale %episode, %episode_output_stride : index, offset -> offset
    %reload_metadata = index.cmp eq, %dense_group, %zero : index
    scf.if %reload_metadata {
      %metadata_read, %metadata_incoming = channel.acquire %activation_stream : channel<tile<2048xi32>> -> (read<tile<2048xi32>>, view<2048xi32>)
      %metadata_bf16 = view.bitcast %metadata_incoming : view<2048xi32> -> view<4096xbf16>
      %metadata_rows = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>
      scf.for %token = [%zero to %capacity step %one] {
        %sequence = view.load %metadata_rows[%token, 1] : view<128x16xi32> -> i32
        view.store %sequence, %sequence_ids[%token] : i32, view<128xi32>
      }
      %dimension_metadata_rows = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>

      scf.for %dimension_member = [%zero to %c2 step %one] {
        %dimension_member_relative = index.mul %dimension_member, %c32 : index
        %dimension_member_base = index.add %dimension_row_base, %dimension_member_relative : index
        scf.for %dimension_token = [%zero to %c4 step %one] {
          %dimension_row = index.add %dimension_member_base, %dimension_token : index
          %dimension_count = view.load %dimension_metadata_rows[%dimension_row, 3] : view<128x16xi32> -> i32
          view.store %dimension_count, %dimensions[%dimension_member, %dimension_token] : i32, view<2x4xi32>
        }
      }
      channel.release %metadata_read : read<tile<2048xi32>>
    }
    %query_key_group = index.cmp eq, %dense_group, %zero : index
    %head_group = index.cmp ult, %dense_group, %c2 : index
    %output_group = index.cmp eq, %dense_group, %c2 : index
    %down_group = index.cmp eq, %dense_group, %c6 : index
    %residual_group = scalar.ori %output_group, %down_group : i1
    %gate_or_later = index.cmp uge, %dense_group, %c3 : index
    %before_down = index.cmp ult, %dense_group, %c6 : index
    %mlp_group = scalar.andi %gate_or_later, %before_down : i1
    %post_norm_group = index.cmp eq, %dense_group, %c3 : index
    %normalize_rows = scalar.ori %query_key_group, %post_norm_group : i1
    %gather_initial = scalar.andi %initial_layer, %query_key_group : i1
    %wide_chunks = scf.select %down_group, %c24, %c16 : index
    %dense_chunks = scf.select %residual_group, %wide_chunks, %c8 : index
    %dense_roles = scf.select %residual_group, %one, %c2 : index
    %last_dense_role = index.sub %dense_roles, %one : index
    %last_chunk = index.sub %dense_chunks, %one : index
    scf.if %normalize_rows {
      %row_raw = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<4096xbf16>
      %row_width = index.constant 1024 : index
      %row_bytes = index.constant 2048 : offset
      %row_slot_base = index.constant 31680 : offset
      %row_slot_stride = index.constant 16384 : offset
      %row_scale = buffer.view %local_storage[%row_slot_base] : buffer -> view<1024xbf16>

      %row_gamma_read, %row_gamma_record = channel.acquire %activation_stream : channel<tile<2048xi32>> -> (read<tile<2048xi32>>, view<2048xi32>)
      %row_gamma_values = view.bitcast %row_gamma_record : view<2048xi32> -> view<4096xbf16>
      channel.release %row_gamma_read : read<tile<2048xi32>>
      scf.for %row_record = [%zero to %c8 step %one] {
        %row_input_read, %row_input_record = channel.acquire %activation_stream : channel<tile<2048xi32>> -> (read<tile<2048xi32>>, view<2048xi32>)
        %row_input_values = view.bitcast %row_input_record : view<2048xi32> -> view<4096xbf16>
        %owns_rows = index.cmp eq, %row_record, %row_column : index
        scf.if %owns_rows {
          func.call @qwen3_embedding.shared_copy_output(%row_input_values, %row_raw) : (view<4096xbf16>, view<4096xbf16>)
        }
        channel.release %row_input_read : read<tile<2048xi32>>
      }
      func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)

      func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
      %row_records = scf.select %final_layer, %c4, %c2 : index
      scf.for %output_record = [%zero to %row_records step %one] {
        %row_write, %row_destination = channel.reserve %normalization_stream : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)

        channel.publish %row_write : write<tile<4096xbf16>>
      }
      func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
    }
    scf.if %learned_layer {
      %group_last_read, %completed_chunks = scf.while(%chunk_index = %zero : index) -> (read<tile<4624xi32>, mutable>, index) {
        // Projection groups contain 8, 16, or 24 chunks, with one or two roles.
        %dense_chunk = index.assume %chunk_index [range(%chunk_index, 0, 23)] : index
        %dense_input_read, %dense_input_view = channel.acquire %activation_stream : channel<tile<2048xi32>> -> (read<tile<2048xi32>>, view<2048xi32>)
        %dense_input_values = view.bitcast %dense_input_view : view<2048xi32> -> view<4096xbf16>
        func.call @qwen3_embedding.pack_dense_activations(%local_storage, %activation_offset) : (buffer, offset)
        channel.release %dense_input_read : read<tile<2048xi32>>
        %chunk_last_read, %completed_roles = scf.while(%role_index = %zero : index) -> (read<tile<4624xi32>, mutable>, index) {
          %dense_role = index.assume %role_index [range(%role_index, 0, 1)] : index
          %weight_read, %weight_values = channel.acquire<mutable> %weight_stream : channel<tile<4624xi32>> -> (read<tile<4624xi32>, mutable>, view<4624xi32>)
          %first_dense_projection = index.cmp eq, %dense_role, %zero : index
          %projection_storage = scf.if %first_dense_projection -> (buffer) {
            scf.yield %peer_storage : buffer
          } else {
            scf.yield %local_storage : buffer
          }
          %first_dense_chunk = index.cmp eq, %dense_chunk, %zero : index
          func.call @qwen3_embedding.dense_accumulate(%local_storage, %projection_storage, %dense_result_offset, %first_dense_chunk) : (buffer, buffer, offset, i1)
          %next_role = index.add %dense_role, %one : index
          %more_roles = index.cmp ult, %next_role, %dense_roles : index
          scf.condition %more_roles, %weight_read, %next_role : i1, read<tile<4624xi32>, mutable>, index
        } do(%completed_weight: read<tile<4624xi32>, mutable>, %following_role: index) {
          channel.release %completed_weight : read<tile<4624xi32>, mutable>
          scf.yield %following_role : index
        }
        %next_chunk = index.add %dense_chunk, %one : index
        %more_chunks = index.cmp ult, %next_chunk, %dense_chunks : index
        scf.condition %more_chunks, %chunk_last_read, %next_chunk : i1, read<tile<4624xi32>, mutable>, index
      } do(%completed_chunk: read<tile<4624xi32>, mutable>, %following_chunk: index) {
        channel.release %completed_chunk : read<tile<4624xi32>, mutable>
        scf.yield %following_chunk : index
      }
      %head_records = scf.select %head_group, %c2, %one : index
      %preparation_records = scf.select %residual_group, %c8, %head_records : index
      scf.for %record = [%zero to %preparation_records step %one] {
        %first_record = index.cmp eq, %record, %zero : index
        %preparation_read, %preparation_incoming = channel.acquire %activation_stream : channel<tile<2048xi32>> -> (read<tile<2048xi32>>, view<2048xi32>)
        %preparation_values = view.bitcast %preparation_incoming : view<2048xi32> -> view<4096xbf16>
        scf.if %head_group {
          scf.if %first_record {
            scf.for %word = [%zero to %scale_words step %vector_step] {
              %value = vector.load %preparation_values[%word] : view<4096xbf16> -> vector<32xbf16>
              vector.store %value, %dense_scales[%word] : vector<32xbf16>, view<256xbf16>
            }
          } else {
            func.call @qwen3_embedding.shared_copy_output(%preparation_values, %dense_rope_bits) : (view<4096xbf16>, view<4096xbf16>)
          }
        } else {
          scf.if %residual_group {

            %skip_rows = view.bitcast %dense_secondary_bits : view<4096xbf16> -> view<32x128xbf16>
            func.call @qwen3_embedding.shared_retain_residual_panel(%preparation_values, %skip_rows, %record, %skip_column) : (view<4096xbf16>, view<32x128xbf16>, index, index)
          } else {
          }
        }
        channel.release %preparation_read : read<tile<2048xi32>>
      }
      func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
      func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
      %epilogue_roles = scf.select %head_group, %c2, %one : index
      %epilogue_members = index.mul %epilogue_roles, %c2 : index
      scf.for %projection_member = [%zero to %epilogue_members step %one] {
        %projection_role = index.div %projection_member, %c2 : index
        %head_member = index.rem %projection_member, %c2 : index

        %first_projection = index.cmp eq, %projection_role, %zero : index
        %normalize_projection = scalar.ori %first_projection, %query_key_group : i1
        %head_normalization = scalar.andi %head_group, %normalize_projection : i1
        %epilogue_raw = buffer.view %peer_storage[%origin] : buffer -> view<4096xbf16>
        %epilogue_raw_matrix = buffer.view %peer_storage[%origin] : buffer -> view<32x128xbf16>

        %head_slot_stride = index.constant 16384 : offset
        %head_slot_base = index.constant 31680 : offset
        %head_slot_relative = index.scale %head_member, %head_slot_stride : index, offset -> offset
        %head_slot = index.add %head_slot_base, %head_slot_relative : offset
        %head_primary = buffer.view %peer_storage[%head_slot] : buffer -> view<16x4x64xf32>
        %head_secondary = buffer.view %local_storage[%head_slot] : buffer -> view<16x4x64xf32>
        %head_primary_flat = buffer.view %peer_storage[%head_slot] : buffer -> view<4096xf32>
        %head_secondary_flat = buffer.view %local_storage[%head_slot] : buffer -> view<4096xf32>
        %head_primary_narrow = buffer.view %peer_storage[%head_slot] : buffer -> view<4096xbf16>
        %head_primary_blocks = buffer.view %peer_storage[%head_slot] : buffer -> view<16x4x64xbf16>
        %head_skip = buffer.view %local_storage[%head_slot] : buffer -> view<4096xbf16>
        scf.if %mlp_group {
          %swap_silu_tables = scalar.constant true : i1
          func.call @qwen3_embedding.shared_swiglu_dense(%peer_storage, %local_storage, %head_slot, %swap_silu_tables) : (buffer, buffer, offset, i1)
        } else {
          %selected_dense_rows = scf.select %first_projection, %head_primary, %head_secondary : view<16x4x64xf32>
          func.call @qwen3_embedding.shared_dense_rows(%selected_dense_rows, %epilogue_raw_matrix) : (view<16x4x64xf32>, view<32x128xbf16>)
          scf.if %head_normalization {
            %first_head_member = index.cmp eq, %head_member, %zero : index
            %member_storage = scf.select %first_head_member, %local_storage, %peer_storage : buffer
            %member_rope = buffer.view %member_storage[%dense_rope_offset] : buffer -> view<32x2x64xbf16>
            %scale_relative = index.scale %projection_role, %dense_scale_stride : index, offset -> offset
            %scale_offset = index.add %dense_scale_offset, %scale_relative : offset
            %head_scale = buffer.view %peer_storage[%scale_offset] : buffer -> view<128xbf16>
            func.call @qwen3_embedding.shared_dense_heads(%epilogue_raw_matrix, %head_scale, %member_rope) : (view<32x128xbf16>, view<128xbf16>, view<32x2x64xbf16>)
          }
        }
        %head_write, %head_destination = channel.reserve %projection_stream : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
        scf.if %mlp_group {
          %head_destination_blocks = view.bitcast %head_destination : view<4096xbf16> -> view<16x4x64xbf16>
          func.call @qwen3_embedding.shared_block_dense_result(%head_primary_blocks, %head_destination_blocks) : (view<16x4x64xbf16>, view<16x4x64xbf16>)
        } else {
          scf.if %normalize_projection {
            scf.if %head_group {
              scf.if %first_projection {
                func.call @qwen3_embedding.shared_block_left(%epilogue_raw_matrix, %head_destination) : (view<32x128xbf16>, view<4096xbf16>)
              } else {
                func.call @qwen3_embedding.shared_block_attention_keys(%epilogue_raw_matrix, %head_destination) : (view<32x128xbf16>, view<4096xbf16>)
              }
            } else {
              func.call @qwen3_embedding.shared_copy_output(%epilogue_raw, %head_destination) : (view<4096xbf16>, view<4096xbf16>)
            }
          } else {
            %head_transposed = view.bitcast %head_destination : view<4096xbf16> -> view<16x4x64xbf16>
            func.call @qwen3_embedding.shared_dense_block_values(%epilogue_raw_matrix, %head_transposed) : (view<32x128xbf16>, view<16x4x64xbf16>)
          }
        }
        channel.publish %head_write : write<tile<4096xbf16>>

        %last_head_member = index.cmp eq, %head_member, %one : index
        scf.if %last_head_member {

          %next_episode = index.add %episode, %one : index
          %next_projection = index.add %projection_role, %one : index
          %later_episode = index.cmp ult, %next_episode, %panels : index
          %later_projection = index.cmp ult, %next_projection, %epilogue_roles : index
          %internal_join = scalar.ori %later_episode, %later_projection : i1
          scf.if %internal_join {
            func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
            func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
            func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
            func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
          }
        }
      }

      channel.release %group_last_read : read<tile<4624xi32>, mutable>
    }
  }
  func.return
}

func.def public inline @qwen3_embedding.query_key_epilogue.attention(%sequence_storage: buffer, %origin: offset, %dimension_storage: buffer, %local_storage: buffer, %result_offset: offset, %peer_storage: buffer, %activation_stream: channel<tile<2048xi32>>, %zero: index, %one: index, %incoming_arrival: channel<tile<16xi32>>, %outgoing_arrival: channel<tile<16xi32>>, %incoming_departure: channel<tile<16xi32>>, %outgoing_departure: channel<tile<16xi32>>, %normalization_stream: channel<tile<4096xbf16>>, %weight_stream: channel<tile<4624xi32>>, %activation_offset: offset, %projection_stream: channel<tile<4096xbf16>>, %probability_stream: channel<tile<4096xbf16>>, %column_offset: index, %dimension_row_base: index, %row_column: index, %skip_column: index, %layer: index) {
  %sequence_ids = buffer.view %sequence_storage[%origin] : buffer -> view<128xi32>
  %dimensions = buffer.view %dimension_storage[%origin] : buffer -> view<2x4xi32>
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %capacity = index.constant 128 : index
  %chunk_words = index.constant 512 : index
  %vector_step = index.constant 32 : index
  %record_stride = index.constant 8192 : offset
  %episode_input_stride = index.constant 8192 : offset
  %episode_output_stride = index.constant 524288 : offset

  %identity_offset = index.constant 27008 : offset
  %temporary_offset = index.constant 10368 : offset
  %scores_offset = index.constant 9344 : offset
  %packed_low = index.constant 4672 : offset
  %right_high = index.constant 27136 : offset
  %right_low = index.constant 45632 : offset
  %right_stride = index.constant 1152 : offset
  %right_count = scalar.constant 16 : i32
  %left_count = scalar.constant 64 : i32
  %identity = buffer.view %local_storage[%identity_offset] : buffer -> view<8x8xbf16>
  %temporary = buffer.view %local_storage[%temporary_offset] : buffer -> view<8x8xf32>
  %scores = buffer.view %local_storage[%scores_offset] : buffer -> view<128xf32>
  %raw = buffer.view %local_storage[%origin] : buffer -> view<4096xbf16>
  %raw_matrix = buffer.view %local_storage[%origin] : buffer -> view<32x128xbf16>
  %blocked = buffer.view %local_storage[%result_offset] : buffer -> view<4096xbf16>

  %last_chunk = index.constant 7 : index
  %dense_input_stride = index.constant 32768 : offset
  %dense_packed_offset = index.constant 27008 : offset
  %dense_result_offset = index.constant 31680 : offset
  %dense_primary = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_secondary = buffer.view %local_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_primary_bits = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_secondary_bits = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_blocked_values = buffer.view %local_storage[%dense_result_offset] : buffer -> view<16x4x64xbf16>
  %dense_scale_offset = index.constant 8192 : offset
  %dense_scale_stride = index.constant 256 : offset
  %dense_rope_offset = index.constant 8704 : offset
  %dense_scales = buffer.view %local_storage[%dense_scale_offset] : buffer -> view<256xbf16>
  %dense_rope_bits = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<4096xbf16>
  %dense_rope = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<32x2x64xbf16>
  %scale_words = index.constant 256 : index
  %episode_state_stride = index.constant 2924544 : offset
  %c3 = index.constant 3 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c16 = index.constant 16 : index
  %c24 = index.constant 24 : index
  %layers = index.constant 29 : index
  %learned_layers = index.constant 28 : index

  %initial_layer = index.cmp eq, %layer, %zero : index
  %constant_base = index.constant 497172480 : offset
  %constant_stride = index.constant 8192 : offset
  %constant_relative = index.scale %layer, %constant_stride : index, offset -> offset
  %constant_offset = index.add %constant_base, %constant_relative : offset
  %final_layer = index.cmp eq, %layer, %learned_layers : index
  %learned_layer = index.cmp ult, %layer, %learned_layers : index
  %active_groups = scf.select %final_layer, %one, %c7 : index

  %attention_emits = scalar.constant false : i1
  func.call @qwen3_embedding.attention_query(%local_storage, %weight_stream, %probability_stream, %probability_stream, %local_storage, %origin, %episode_state_stride, %attention_emits) : (buffer, channel<tile<4624xi32>>, channel<tile<4096xbf16>>, channel<tile<4096xbf16>>, buffer, offset, offset, i1)

  func.return
}
