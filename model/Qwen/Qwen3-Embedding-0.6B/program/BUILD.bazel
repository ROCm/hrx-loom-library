load("//build_tools/bazel:defs.bzl", "loom_library")

package(default_visibility = ["//model/Qwen/Qwen3-Embedding-0.6B:__subpackages__"])

exports_files([
    "array.loom",
    "command.loom",
    "control.loom",
    "policy.loom",
    "prepare.loom",
    "protocol.loom",
    "tile_math.loom",
    "workers_epilogue.loom",
    "workers_ingress.loom",
    "workers_query.loom",
    "workers_value.loom",
])

loom_library(
    name = "array",
    srcs = ["array.loom"],
    deps = [
        ":workers_epilogue",
        ":workers_ingress",
        ":workers_query",
        ":workers_value",
    ],
)

loom_library(
    name = "command",
    srcs = ["command.loom"],
    deps = [
        ":array",
    ],
)

loom_library(
    name = "control",
    srcs = ["control.loom"],
)

loom_library(
    name = "policy",
    srcs = ["policy.loom"],
)

loom_library(
    name = "prepare",
    srcs = ["prepare.loom"],
    data = ["policy.loom"],
)

loom_library(
    name = "protocol",
    srcs = ["protocol.loom"],
)

loom_library(
    name = "tile_math",
    srcs = ["tile_math.loom"],
)

loom_library(
    name = "workers_epilogue",
    srcs = ["workers_epilogue.loom"],
    deps = [
        "//motif/format/bfp16ebs8:aie2p",
        "//motif/tensor:prefix_norm",
        ":protocol",
        ":tile_math",
    ],
)

loom_library(
    name = "workers_ingress",
    srcs = ["workers_ingress.loom"],
    deps = [
        "//motif/format/bfp16ebs8:aie2p",
        ":protocol",
        ":tile_math",
    ],
)

loom_library(
    name = "workers_query",
    srcs = ["workers_query.loom"],
    deps = [
        "//motif/format/bfp16ebs8:aie2p",
        "//motif/tensor:prefix_norm",
        ":protocol",
        ":tile_math",
    ],
)

loom_library(
    name = "workers_value",
    srcs = ["workers_value.loom"],
    deps = [
        "//motif/format/bfp16ebs8:aie2p",
        "//motif/tensor:prefix_norm",
        ":protocol",
        ":tile_math",
    ],
)
