// The dense matrix leaf receives both architectural load-FIFO state chains
// explicitly. Reading them once at the calling core's entry preserves the
// ownership of LF0 and LF1 across its retained panel loop and native calls.

func.def public inline @qwen3_embedding.load_fifos() -> (aie2p.load_fifo, aie2p.load_fifo) {
  %activation, %weight = aie2p.load_fifo.state : aie2p.load_fifo, aie2p.load_fifo
  func.return %activation, %weight : aie2p.load_fifo, aie2p.load_fifo
}
