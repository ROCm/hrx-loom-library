// Parameter preparation policy for an already packed resident bank. Returning
// zero requests no additional device-side preparation storage; the selected
// tensor is bound directly. Native BFP conversion belongs to prepare_assets.py,
// and the bank's exact layout is the command program's parameter contract.
func.def public @prepare_weight(%key: buffer) -> (i64) {
  %bytes = scalar.constant 0 : i64
  func.return %bytes : i64
}
