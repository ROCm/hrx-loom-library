// Runtime-only normalization layout: 28 layer records, final normalization,
// SiLU, then four rotary records. Each record is 8192 bytes. Learned scales
// come unchanged from the original checkpoint. The policy appends computed
// SiLU/rotary bytes to the same input stream; no table payload is embedded here.

target.decl @qwen3_embedding.array

pipeline.def<kernel> public retain target(@qwen3_embedding.array) @qwen3_embedding.pack_constants() run(%output_arg: buffer, %input_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  // Column seven retains the eight-column deployment's executable geometry.
  %memory = pipeline.memory<workgroup>[7, 3] : pool
  %origin = index.constant 0 : offset
  %record_bytes = index.constant 8192 : offset
  %layer_bytes = index.constant 4608 : offset
  %final_origin = index.constant 129024 : offset
  %math_origin = index.constant 131072 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %record_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %record_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x8192xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x8192xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x8192xi8>, index -> channel<tile<8192xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x8192xi8>, index -> channel<tile<8192xi8>>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %layers = index.constant 28 : index
  %learned_records = index.constant 29 : index
  %records = index.constant 34 : index
  pipeline.strand workers([7, 2], [1, 1], [1, 1]) {
    scf.for %record = [%c0 to %records step %c1] {
      %write, %incoming = channel.reserve %inputs : channel<tile<8192xi8>> -> (write<tile<8192xi8>>, view<8192xi8>)
      %learned = index.cmp ult, %record, %learned_records : index
      scf.if %learned {
        %layer = index.cmp ult, %record, %layers : index
        scf.if %layer {
          %offset = index.scale %record, %layer_bytes : index, offset -> offset
          %source = buffer.view %input[%offset] : buffer -> view<4608xi8>
          %destination = view.subview %incoming[0] : view<8192xi8> -> view<4608xi8>
          %copy = kernel.async.copy %source to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4608xi8> to view<4608xi8> -> kernel.async.token
          %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
          kernel.async.wait %group {newer_groups = 0} : kernel.async.group
        } else {
          %source = buffer.view %input[%final_origin] : buffer -> view<2048xi8>
          %destination = view.subview %incoming[0] : view<8192xi8> -> view<2048xi8>
          %copy = kernel.async.copy %source to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2048xi8> to view<2048xi8> -> kernel.async.token
          %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
          kernel.async.wait %group {newer_groups = 0} : kernel.async.group
        }
      } else {
        %table = index.sub %record, %learned_records : index
        %table_offset = index.scale %table, %record_bytes : index, offset -> offset
        %offset = index.add %math_origin, %table_offset : offset
        %source = buffer.view %input[%offset] : buffer -> view<8192xi8>
        %copy = kernel.async.copy %source to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<8192xi8> to view<8192xi8> -> kernel.async.token
        %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      }
      channel.publish %write : write<tile<8192xi8>>
      %read, %outgoing = channel.acquire %outputs : channel<tile<8192xi8>> -> (read<tile<8192xi8>>, view<8192xi8>)
      %offset = index.scale %record, %record_bytes : index, offset -> offset
      %destination = buffer.view %output[%offset] : buffer -> view<8192xi8>
      %copy = kernel.async.copy %outgoing to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8192xi8> to view<8192xi8> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<8192xi8>>
    }
  }
  pipeline.strand workers([7, 3], [1, 1], [1, 1]) {
    %width = index.constant 8192 : index
    %step = index.constant 64 : index
    %layer_count = index.constant 4608 : index
    %final_count = index.constant 2048 : index
    %final_offset = index.constant 512 : index
    %padding = vector.splati 0 : vector<64xi8>
    scf.for %record = [%c0 to %records step %c1] {
      %write, %outgoing = channel.reserve %outputs : channel<tile<8192xi8>> -> (write<tile<8192xi8>>, view<8192xi8>)
      %read, %incoming = channel.acquire %inputs : channel<tile<8192xi8>> -> (read<tile<8192xi8>>, view<8192xi8>)
      %learned = index.cmp ult, %record, %learned_records : index
      scf.if %learned {
        scf.for %position = [%c0 to %width step %step] {
          vector.store %padding, %outgoing[%position] : vector<64xi8>, view<8192xi8>
        }
        %layer = index.cmp ult, %record, %layers : index
        %count = scf.select %layer, %layer_count, %final_count : index
        %base = scf.select %layer, %c0, %final_offset : index
        scf.for %position = [%c0 to %count step %step] {
          %value = vector.load %incoming[%position] : view<8192xi8> -> vector<64xi8>
          %target = index.add %base, %position : index
          vector.store %value, %outgoing[%target] : vector<64xi8>, view<8192xi8>
        }
      } else {
        scf.for %position = [%c0 to %width step %step] {
          %value = vector.load %incoming[%position] : view<8192xi8> -> vector<64xi8>
          vector.store %value, %outgoing[%position] : vector<64xi8>, view<8192xi8>
        }
      }
      channel.release %read : read<tile<8192xi8>>
      channel.publish %write : write<tile<8192xi8>>
    }
  }
}

command.def public @qwen3_embedding.prepare_constants() launch(%output: buffer, %input: buffer) {
  kernel.launch @qwen3_embedding.pack_constants(%output, %input) : (buffer, buffer)
  command.return
}
