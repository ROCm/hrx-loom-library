// Resident 28-layer Qwen3 embedding on the 8-column, 4-row Strix Halo NPU.
// The cohort kernel borrows eight packed projection bindings, normalization
// constants, original BF16 embedding rows, request metadata, result storage,
// and mutable state. Initialization owns array routing and local storage;
// invocation owns request bindings and retires all workers before returning.
// Core names identify physical placement. Repeated placements call shared
// query/key and probability/value roles with immediate resource selectors.
// All files in this provider share one private linker scope.
func.decl inline @qwen3_embedding.panels.query_key_ingress_root(%cohort_panel_count: index, %attention_window_tokens: index)

func.decl inline @qwen3_embedding.panels.probability_value_peer_root(%cohort_panel_count: index, %attention_window_tokens: index)

func.decl inline @qwen3_embedding.panels.query_key_ingress(%cohort_panel_count: index, %attention_window_tokens: index)

func.decl inline @qwen3_embedding.panels.probability_value_peer(%cohort_panel_count: index, %attention_window_tokens: index)

func.decl inline @qwen3_embedding.panels.query_key_terminal(%cohort_panel_count: index, %attention_window_tokens: index)

low.func.decl target<amd.xdna.aie2p.configuration> @qwen3_embedding.panels.run_layer(%metadata: reg<aie2p.config.binding>, %state: reg<aie2p.config.binding>)

