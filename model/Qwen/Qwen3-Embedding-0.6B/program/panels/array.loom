func.decl inline @qwen3_embedding.panels.probability_value_interior(%cohort_panel_count: index, %attention_window_tokens: index, %dimension_row_base: index, %row_column: index, %arrival_write_lock: i32, %arrival_address: i32, %arrival_ready_lock: i32, %departure_ready_lock: i32, %departure_address: i32, %departure_free_lock: i32, %row_free_lock: i32, %row_ready_lock: i32, %feature_offset: index, %probability_ready_lock: i32, %probability_free_lock: i32, %context_free_lock: i32, %context_ready_lock: i32)

