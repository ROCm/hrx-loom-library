aie2p.target<core> @qwen3_embedding.panels.packed_core

// The worker geometry matches the finite DMA plan configured below.
// Dense panels contain 128 tokens; attention visits 64-token waves within
// each independent window. These values never select matrix tile extents.
func.def pure inline @qwen3_embedding.panels.cohort_shape() -> (index, index) {
  %cohort_panel_count = index.constant 4 : index
  %attention_window_tokens = index.constant 256 : index
  func.return %cohort_panel_count, %attention_window_tokens : index, index
}

func.def inline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.core_c4_r4() {
  %cohort_panel_count, %attention_window_tokens = func.call @qwen3_embedding.panels.cohort_shape() : () -> (index, index)
  func.call @qwen3_embedding.panels.query_key_ingress(%cohort_panel_count, %attention_window_tokens) : (index, index)
  func.return
}

