// Register/FIFO packing for compensated BFP16EBS8 attention and projection.
// High and residual operands share the caller's local storage. Explicit FIFO
// state publishes complete packed records before the owning channel releases
// the storage. These routines perform no host conversion or external transfer.
target.decl @qwen3_embedding.panels.core

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_native(%storage: reg<aie2p.ep>, %input_offset: reg<aie2p.er>, %output_offset: reg<aie2p.er>, %count: reg<aie2p.er>) asm {
  %input_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %input_modifier = mov.modifier %input_offset
  %input = padda.modifier %input_storage, %input_modifier
  %output_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_modifier = mov.modifier %output_offset
  %output = padda.modifier %output_storage, %output_modifier
  %pointer = mov.store-fifo.pointer %output
  %low = vlda.store-fifo.low512 %output, 0
  %fifo = vlda.store-fifo.high512 %output, %low, 64
  %position = mova.fifo.store.position 0
  %c0 = mov.short 0
  %c1 = mov.short 1
  %step = mov.i32 128
  set.rounding 12
  low.br ^pack(%c0: reg<aie2p.er>, %input: reg<aie2p.ep>, %pointer: reg<aie2p.mpfs>, %fifo: reg<aie2p.mstfifo>, %position: reg<aie2p.mr26_fifo_st>)
^pack(%index: reg<aie2p.er>, %source: reg<aie2p.ep>, %destination: reg<aie2p.mpfs>, %state: reg<aie2p.mstfifo>, %offset: reg<aie2p.mr26_fifo_st>):
  %condition = lt %index, %count
  low.cond_br %condition, ^update, ^finish : reg<aie2p.er>
^update:
  %lower = vlda.convert.bf16x32.to.f32x32 %source, 0
  %upper = vlda.convert.bf16x32.to.f32x32 %source, 64
  %values = concat(%lower, %upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %pushed, %next_destination, %next_offset = vst.push.bfp16ebs8.from.fp32 %state, %values, %destination, %offset
  %flushed, %final_destination, %final_offset = vst.flush.convert.512 %pushed, %next_destination, %next_offset
  %base = mov.address-to-scalar %source
  %next_address = add.rr %base, %step
  %next_source = mov.scalar-to-address %next_address
  %next_index = add.rr %index, %c1
  low.br ^pack(%next_index: reg<aie2p.er>, %next_source: reg<aie2p.ep>, %final_destination: reg<aie2p.mpfs>, %flushed: reg<aie2p.mstfifo>, %final_offset: reg<aie2p.mr26_fifo_st>)
^finish:
  return
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_four_native(%storage: reg<aie2p.ep>, %input_offset: reg<aie2p.er>, %output_offset: reg<aie2p.er>, %count: reg<aie2p.er>) asm {
  %input_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %input_modifier = mov.modifier %input_offset
  %input = padda.modifier %input_storage, %input_modifier
  %output_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_modifier = mov.modifier %output_offset
  %output = padda.modifier %output_storage, %output_modifier
  %pointer = mov.store-fifo.pointer %output
  %low = vlda.store-fifo.low512 %output, 0
  %fifo = vlda.store-fifo.high512 %output, %low, 64
  %position = mova.fifo.store.position 0
  set.rounding 12
  low.br ^pack(%count: reg<aie2p.er>, %input: reg<aie2p.ep>, %pointer: reg<aie2p.mpfs>, %fifo: reg<aie2p.mstfifo>, %position: reg<aie2p.mr26_fifo_st>)
^pack(%remaining: reg<aie2p.er>, %source: reg<aie2p.ep>, %destination: reg<aie2p.mpfs>, %state: reg<aie2p.mstfifo>, %offset: reg<aie2p.mr26_fifo_st>):
  low.cond_br %remaining, ^update, ^finish : reg<aie2p.er>
^update:
  %lower_first_lower = vlda.convert.bf16x32.to.f32x32 %source, 0
  %lower_first_upper = vlda.convert.bf16x32.to.f32x32 %source, 64
  %lower_first = concat(%lower_first_lower, %lower_first_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %lower_second_source = padda %source, 128
  %lower_second_lower = vlda.convert.bf16x32.to.f32x32 %lower_second_source, 0
  %lower_second_upper = vlda.convert.bf16x32.to.f32x32 %lower_second_source, 64
  %lower_second = concat(%lower_second_lower, %lower_second_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %lower_next_source = padda %lower_second_source, 128
  %upper_first_lower = vlda.convert.bf16x32.to.f32x32 %lower_next_source, 0
  %upper_first_upper = vlda.convert.bf16x32.to.f32x32 %lower_next_source, 64
  %upper_first = concat(%upper_first_lower, %upper_first_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %upper_second_source = padda %lower_next_source, 128
  %upper_second_lower = vlda.convert.bf16x32.to.f32x32 %upper_second_source, 0
  %upper_second_upper = vlda.convert.bf16x32.to.f32x32 %upper_second_source, 64
  %upper_second = concat(%upper_second_lower, %upper_second_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %upper_next_source = padda %upper_second_source, 128
  %lower_pair_first_pushed, %lower_pair_middle_pointer, %lower_pair_middle_position = vst.push.bfp16ebs8.from.fp32 %state, %lower_first, %destination, %offset
  %lower_pair_first_flushed, %lower_pair_first_pointer, %lower_pair_first_position = vst.flush.convert.512 %lower_pair_first_pushed, %lower_pair_middle_pointer, %lower_pair_middle_position
  %lower_pair_second_pushed, %lower_pair_final_pointer, %lower_pair_final_position = vst.push.bfp16ebs8.from.fp32 %lower_pair_first_flushed, %lower_second, %lower_pair_first_pointer, %lower_pair_first_position
  %lower_pair_second_flushed, %lower_pair_output_pointer, %lower_pair_output_position = vst.flush.convert.512 %lower_pair_second_pushed, %lower_pair_final_pointer, %lower_pair_final_position
  %upper_pair_first_pushed, %upper_pair_middle_pointer, %upper_pair_middle_position = vst.push.bfp16ebs8.from.fp32 %lower_pair_second_flushed, %upper_first, %lower_pair_output_pointer, %lower_pair_output_position
  %upper_pair_first_flushed, %upper_pair_first_pointer, %upper_pair_first_position = vst.flush.convert.512 %upper_pair_first_pushed, %upper_pair_middle_pointer, %upper_pair_middle_position
  %upper_pair_second_pushed, %upper_pair_final_pointer, %upper_pair_final_position = vst.push.bfp16ebs8.from.fp32 %upper_pair_first_flushed, %upper_second, %upper_pair_first_pointer, %upper_pair_first_position
  %upper_pair_second_flushed, %upper_pair_output_pointer, %upper_pair_output_position = vst.flush.convert.512 %upper_pair_second_pushed, %upper_pair_final_pointer, %upper_pair_final_position
  %next_remaining = add.nc.immediate %remaining, -4
  low.br ^pack(%next_remaining: reg<aie2p.er>, %upper_next_source: reg<aie2p.ep>, %upper_pair_output_pointer: reg<aie2p.mpfs>, %upper_pair_second_flushed: reg<aie2p.mstfifo>, %upper_pair_output_position: reg<aie2p.mr26_fifo_st>)
^finish:
  return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high(%storage: buffer, %input: offset, %output: offset, %count: i32) {
  low.invoke @qwen3_embedding.panels.pack_high_native(%storage, %input, %output, %count) : (buffer, offset, offset, i32)
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_four(%storage: buffer, %input: offset, %output: offset, %count: i32) {
  low.invoke @qwen3_embedding.panels.pack_high_four_native(%storage, %input, %output, %count) : (buffer, offset, offset, i32)
  func.return
}

func.def inline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_four_inline(%storage: buffer, %input: offset, %output: offset, %count: i32) {
  low.invoke @qwen3_embedding.panels.pack_high_four_native(%storage, %input, %output, %count) : (buffer, offset, offset, i32)
  func.return
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_residual_native(%storage: reg<aie2p.ep>, %input_offset: reg<aie2p.er>, %high_output_offset: reg<aie2p.er>, %residual_output_offset: reg<aie2p.er>, %count: reg<aie2p.er>) asm {
  %input_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %input_modifier = mov.modifier %input_offset
  %input = padda.modifier %input_storage, %input_modifier
  %high_output_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %high_output_modifier = mov.modifier %high_output_offset
  %high_output = padda.modifier %high_output_storage, %high_output_modifier
  %residual_output_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %residual_output_modifier = mov.modifier %residual_output_offset
  %residual_output = padda.modifier %residual_output_storage, %residual_output_modifier
  %c0 = mov.short 0
  %c1 = mov.short 1
  %input_step = mov.i32 128
  %output_step = mov.i32 72
  set.rounding 12
  %identity_offset = mov.i32 65280
  %identity_modifier = mov.modifier %identity_offset
  %identity = padda.modifier %storage, %identity_modifier
  %identity_lower = vlda.convert.bf16x32.to.f32x32 %identity, 0
  %identity_upper = vlda.convert.bf16x32.to.f32x32 %identity, 64
  %identity_values = concat(%identity_lower, %identity_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %identity_encoded = vconv.bfp16ebs8.fp32 %identity_values
  %matrix_control = mova.i32 780
  %subtract_control = mova.i32 60
  low.br ^pack(%c0: reg<aie2p.er>, %input: reg<aie2p.ep>, %high_output: reg<aie2p.ep>, %residual_output: reg<aie2p.ep>)
^pack(%index: reg<aie2p.er>, %source: reg<aie2p.ep>, %high_address: reg<aie2p.ep>, %residual_address: reg<aie2p.ep>):
  %condition = lt %index, %count
  low.cond_br %condition, ^update, ^finish : reg<aie2p.er>
^update:
  %lower = vlda.convert.bf16x32.to.f32x32 %source, 0
  %upper = vlda.convert.bf16x32.to.f32x32 %source, 64
  %values = concat(%lower, %upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %encoded_high = vconv.bfp16ebs8.fp32 %values
  %decoded_high = mmul.bfp16ebs8.m8n8k8 %encoded_high, %identity_encoded, %matrix_control
  %residual = vsub.f32x64 %values, %decoded_high, %subtract_control
  %high_pointer = mov.store-fifo.pointer %high_address
  %high_low = vlda.store-fifo.low512 %high_address, 0
  %high_fifo = vlda.store-fifo.high512 %high_address, %high_low, 64
  %high_position = mova.fifo.store.position 0
  %high_pushed, %next_high_destination, %next_high_offset = vst.push.bfp16ebs8.from.fp32 %high_fifo, %values, %high_pointer, %high_position
  %high_flushed, %final_high_destination, %final_high_offset = vst.flush.convert.512 %high_pushed, %next_high_destination, %next_high_offset
  %residual_pointer = mov.store-fifo.pointer %residual_address
  %residual_low = vlda.store-fifo.low512 %residual_address, 0
  %residual_fifo = vlda.store-fifo.high512 %residual_address, %residual_low, 64
  %residual_position = mova.fifo.store.position 0
  %residual_pushed, %next_residual_destination, %next_residual_offset = vst.push.bfp16ebs8.from.fp32 %residual_fifo, %residual, %residual_pointer, %residual_position
  %residual_flushed, %final_residual_destination, %final_residual_offset = vst.flush.convert.512 %residual_pushed, %next_residual_destination, %next_residual_offset
  %source_base = mov.address-to-scalar %source
  %next_source_address = add.rr %source_base, %input_step
  %next_source = mov.scalar-to-address %next_source_address
  %high_base = mov.address-to-scalar %high_address
  %next_high_scalar = add.rr %high_base, %output_step
  %next_high_address = mov.scalar-to-address %next_high_scalar
  %residual_base = mov.address-to-scalar %residual_address
  %next_residual_scalar = add.rr %residual_base, %output_step
  %next_residual_address = mov.scalar-to-address %next_residual_scalar
  %next_index = add.rr %index, %c1
  low.br ^pack(%next_index: reg<aie2p.er>, %next_source: reg<aie2p.ep>, %next_high_address: reg<aie2p.ep>, %next_residual_address: reg<aie2p.ep>)
^finish:
  return
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.store_fifo_initialize(%storage: reg<aie2p.ep>, %output_offset: reg<aie2p.er>) -> (reg<aie2p.mpfs>, reg<aie2p.mstfifo>, reg<aie2p.mr26_fifo_st>) asm {
  %output_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_modifier = mov.modifier %output_offset
  %output = padda.modifier %output_storage, %output_modifier
  %pointer = mov.store-fifo.pointer %output
  %low = vlda.store-fifo.low512 %output, 0
  %fifo = vlda.store-fifo.high512 %output, %low, 64
  %position = mova.fifo.store.position 0
  set.rounding 12
  return %pointer, %fifo, %position
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.store_bfp_row(%values: reg<aie2p.mbms x4>, %pointer: reg<aie2p.mpfs>, %fifo: reg<aie2p.mstfifo>, %position: reg<aie2p.mr26_fifo_st>) -> (reg<aie2p.mpfs>, reg<aie2p.mstfifo>, reg<aie2p.mr26_fifo_st>) asm {
  %pushed, %next_pointer, %next_position = vst.push.bfp16ebs8.from.fp32 %fifo, %values, %pointer, %position
  %flushed, %final_pointer, %final_position = vst.flush.convert.512 %pushed, %next_pointer, %next_position
  return %final_pointer, %flushed, %final_position
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.input_pointer(%storage: reg<aie2p.ep>, %input_offset: reg<aie2p.er>) -> (reg<aie2p.ep>) asm {
  %input_storage = copy %storage : reg<aie2p.ep> -> reg<aie2p.ep>
  %input_modifier = mov.modifier %input_offset
  %input = padda.modifier %input_storage, %input_modifier
  return %input
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.store_bfp_pair(%source: reg<aie2p.ep>, %pointer: reg<aie2p.mpfs>, %fifo: reg<aie2p.mstfifo>, %position: reg<aie2p.mr26_fifo_st>) -> (reg<aie2p.ep>, reg<aie2p.mpfs>, reg<aie2p.mstfifo>, reg<aie2p.mr26_fifo_st>) asm {
  %first_lower = vlda.convert.bf16x32.to.f32x32 %source, 0
  %first_upper = vlda.convert.bf16x32.to.f32x32 %source, 64
  %first_values = concat(%first_lower, %first_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %first_pushed, %middle_pointer, %middle_position = vst.push.bfp16ebs8.from.fp32 %fifo, %first_values, %pointer, %position
  %first_flushed, %first_pointer, %first_position = vst.flush.convert.512 %first_pushed, %middle_pointer, %middle_position
  %second_source = padda %source, 128
  %second_lower = vlda.convert.bf16x32.to.f32x32 %second_source, 0
  %second_upper = vlda.convert.bf16x32.to.f32x32 %second_source, 64
  %second_values = concat(%second_lower, %second_upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %second_pushed, %final_pointer, %final_position = vst.push.bfp16ebs8.from.fp32 %first_flushed, %second_values, %first_pointer, %first_position
  %second_flushed, %output_pointer, %output_position = vst.flush.convert.512 %second_pushed, %final_pointer, %final_position
  %next_source = padda %second_source, 128
  return %next_source, %output_pointer, %second_flushed, %output_position
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.bfp_identity() -> (reg<aie2p.mexa>) asm {
  set.rounding 12
  %identity = mov.local-address 524032
  %lower = vlda.convert.bf16x32.to.f32x32 %identity, 0
  %upper = vlda.convert.bf16x32.to.f32x32 %identity, 64
  %values = concat(%lower, %upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %encoded = vconv.bfp16ebs8.fp32 %values
  return %encoded
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.store_residual_bfp_row(%source: reg<aie2p.ep>, %identity: reg<aie2p.mexa>, %pointer: reg<aie2p.mpfs>, %fifo: reg<aie2p.mstfifo>, %position: reg<aie2p.mr26_fifo_st>) -> (reg<aie2p.ep>, reg<aie2p.mpfs>, reg<aie2p.mstfifo>, reg<aie2p.mr26_fifo_st>) asm {
  %lower = vlda.convert.bf16x32.to.f32x32 %source, 0
  %upper = vlda.convert.bf16x32.to.f32x32 %source, 64
  %values = concat(%lower, %upper) : (reg<aie2p.mbms x2>, reg<aie2p.mbms x2>) -> reg<aie2p.mbms x4>
  %encoded_high = vconv.bfp16ebs8.fp32 %values
  %matrix_control = mova.i32 780
  %decoded_high = mmul.bfp16ebs8.m8n8k8 %encoded_high, %identity, %matrix_control
  %subtract_control = mova.i32 60
  %residual = vsub.f32x64 %values, %decoded_high, %subtract_control
  %pushed, %next_pointer, %next_position = vst.push.bfp16ebs8.from.fp32 %fifo, %residual, %pointer, %position
  %flushed, %final_pointer, %final_position = vst.flush.convert.512 %pushed, %next_pointer, %next_position
  %next_source = padda %source, 128
  return %next_source, %final_pointer, %flushed, %final_position
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_residual(%storage: buffer, %input: offset, %high_output: offset, %residual_output: offset, %count: i32) {
  low.invoke @qwen3_embedding.panels.pack_high_residual_native(%storage, %input, %high_output, %residual_output, %count) : (buffer, offset, offset, offset, i32)
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_high_residual_stream(%storage: buffer, %input: offset, %high_output: offset, %residual_output: offset, %count: i32) {
  %row_count = index.cast %count : i32 to index
  %pair_shift = index.constant 1 : index
  %pair_count = index.shrui %row_count, %pair_shift : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %high_source = low.invoke @qwen3_embedding.panels.input_pointer(%storage, %input) : (buffer, offset) -> (buffer)
  %high_pointer, %high_fifo, %high_position = low.invoke @qwen3_embedding.panels.store_fifo_initialize(%storage, %high_output) : (buffer, offset) -> (aie2p.store_fifo.pointer, aie2p.store_fifo, aie2p.store_fifo.position)
  %final_high_source, %final_high_pointer, %final_high_fifo, %final_high_position = scf.for %pair = [%begin to %pair_count step %step](%current_high_source = %high_source : buffer, %current_high_pointer = %high_pointer : aie2p.store_fifo.pointer, %current_high_fifo = %high_fifo : aie2p.store_fifo, %current_high_position = %high_position : aie2p.store_fifo.position) -> (buffer, aie2p.store_fifo.pointer, aie2p.store_fifo, aie2p.store_fifo.position) {
    %next_high_source, %next_high_pointer, %next_high_fifo, %next_high_position = low.invoke @qwen3_embedding.panels.store_bfp_pair(%current_high_source, %current_high_pointer, %current_high_fifo, %current_high_position) : (buffer, aie2p.store_fifo.pointer, aie2p.store_fifo, aie2p.store_fifo.position) -> (buffer, aie2p.store_fifo.pointer, aie2p.store_fifo, aie2p.store_fifo.position)
    scf.yield %next_high_source, %next_high_pointer, %next_high_fifo, %next_high_position : buffer, aie2p.store_fifo.pointer, aie2p.store_fifo, aie2p.store_fifo.position
  }
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.pack_attention_panel(%storage: buffer, %input: offset, %high_output: offset, %residual_output: offset, %count: i32, %sequence_output: view<64xi32>) {
  low.invoke @qwen3_embedding.panels.pack_high_residual_native(%storage, %input, %high_output, %residual_output, %count) : (buffer, offset, offset, offset, i32)
  %record = buffer.view %storage[%input] : buffer -> view<4624xi32>
  %metadata = index.constant 4096 : index
  %sequences = vector.load %record[%metadata] : view<4624xi32> -> vector<64xi32>
  vector.store %sequences, %sequence_output[0] : vector<64xi32>, view<64xi32>
  func.return
}

