// SiLU lookup and repeated activation-stream control.
// Model lookup tables retain their BF16 rounding contract. Stream commands
// update the bound source address, iteration geometry, receiver, and sender
// in that order; each caller owns its descriptor until completion.
target.decl @qwen3_embedding.panels.core

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.silu_lookup(%table_ab: reg<aie2p.ep>, %table_cd: reg<aie2p.ep>, %indices: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %address_ab = mov.address-to-scalar %table_ab
  %address_cd = mov.address-to-scalar %table_cd
  %base_ab = vbcst.32 %address_ab
  %base_cd = vbcst.32 %address_cd
  %selection_bits = mov.i32 52428
  %selection = copy %selection_bits : reg<aie2p.er> -> reg<aie2p.ers16>
  %base = vsel.32 %base_ab, %base_cd, %selection
  %twice = vadd.32 %indices, %indices
  %four_times = vadd.32 %twice, %twice
  %pointers = vadd.32 %base, %four_times
  %first = slice %pointers[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %second = slice %pointers[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %values0 = vldb.4x16.lo %first
  %values1 = vldb.4x16.hi %first
  %values2 = vldb.4x16.lo %second
  %values3 = vldb.4x16.hi %second
  %low = concat(%values0, %values1) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %high = concat(%values2, %values3) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %mode = mova.i32 24
  %values = vshuffle %low, %high, %mode
  return %values
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.silu_product(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %zero = acc.clear.f32x64
  %mode = mova.i32 60
  %products = vmac.bf16x32 %zero, %left, %right, %mode
  %c0 = mov.short 0
  %zero_lanes = vbcst.16 %c0
  %canonical = vmac.bf16x32 %products, %zero_lanes, %zero_lanes, %mode
  %low = slice %canonical[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %values = vmov.accumulator512.to.vector512 %low
  return %values
}

low.func.def target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.activation_stream_c0_r2(%offset: reg<aie2p.er>, %iteration: reg<aie2p.er>, %receiver_task: reg<aie2p.er>, %sender_task: reg<aie2p.er>) asm {
  %binding = mov.local-address 523576
  %base_low = lda %binding, 0
  %base_high = lda %binding, 4
  %address_low = add.rr %base_low, %offset
  %carry = ltu %address_low, %base_low
  %address_high = add.rr %base_high, %carry
  %address_route = mov.i32 1
  %address_command = mov.i32 1167396
  mov.ms %address_route
  mov.ms %address_command
  mov.ms %address_low
  mov.ms.last %address_high
  %geometry_route = mov.i32 1
  %geometry_command = mov.i32 118840
  mov.ms %geometry_route
  mov.ms %geometry_command
  mov.ms.last %iteration
  %receive_route = mov.i32 -2147483648
  %receive_command = mov.i32 122380
  mov.ms %receive_route
  mov.ms %receive_command
  mov.ms.last %receiver_task
  %send_route = mov.i32 1
  %send_command = mov.i32 -2147364324
  mov.ms %send_route
  mov.ms %send_command
  mov.ms.last %sender_task
  return
}

low.func.def target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.activation_stream_reset_c0_r2() asm {
  %c0 = mov.short 0
  %reset_route = mov.i32 1
  %reset_command = mov.i32 118840
  mov.ms %reset_route
  mov.ms %reset_command
  mov.ms.last %c0
  return
}

low.func.def target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.activation_stream_c4_r4(%offset: reg<aie2p.er>, %iteration: reg<aie2p.er>, %receiver_task: reg<aie2p.er>, %sender_task: reg<aie2p.er>) asm {
  %binding = mov.local-address 523576
  %base_low = lda %binding, 0
  %base_high = lda %binding, 4
  %address_low = add.rr %base_low, %offset
  %carry = ltu %address_low, %base_low
  %address_high = add.rr %base_high, %carry
  %address_route = mov.i32 1
  %address_command = mov.i32 -2146316092
  mov.ms %address_route
  mov.ms %address_command
  mov.ms %address_low
  mov.ms.last %address_high
  %geometry_route = mov.i32 1
  %geometry_command = mov.i32 -2147364648
  mov.ms %geometry_route
  mov.ms %geometry_command
  mov.ms.last %iteration
  %receive_route = mov.i32 -2147483648
  %receive_command = mov.i32 122380
  mov.ms %receive_route
  mov.ms %receive_command
  mov.ms.last %receiver_task
  %send_route = mov.i32 1
  %send_command = mov.i32 -2147364324
  mov.ms %send_route
  mov.ms %send_command
  mov.ms.last %sender_task
  return
}

low.func.def target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.activation_stream_reset_c4_r4() asm {
  %c0 = mov.short 0
  %reset_route = mov.i32 1
  %reset_command = mov.i32 -2147364648
  mov.ms %reset_route
  mov.ms %reset_command
  mov.ms.last %c0
  return
}
