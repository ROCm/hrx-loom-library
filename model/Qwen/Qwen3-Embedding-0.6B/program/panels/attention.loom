    %empty_maximum = vector.select %block_present, %block_maximum_values, %c0_0_1 : vector<16xf32>
    %maximum_candidate = vector.maxnumf<nnan|nsz> %old_maximum_values, %block_maximum_values : vector<16xf32>
    %old_present_for_maximum = vector.cmpf ogt, %old_sum_values, %c0_0_1 : vector<16xf32> -> vector<16xi1>
    %next_maximum_values = vector.select %old_present_for_maximum, %maximum_candidate, %empty_maximum : vector<16xf32>
    %old_delta = vector.subf<nnan|nsz> %old_maximum_values, %next_maximum_values : vector<16xf32>
    %old_scale_candidate = vector.expf<afn> %old_delta : vector<16xf32>
    %old_present_for_scale = vector.cmpf ogt, %old_sum_values, %c0_0_1 : vector<16xf32> -> vector<16xi1>
    %old_scale_values = vector.select %old_present_for_scale, %old_scale_candidate, %c0_0_1 : vector<16xf32>
    %next_maximum_narrow_values = vector.fptrunc<daz> %next_maximum_values : vector<16xf32> to vector<16xbf16>
    %next_maximum_narrow = vector.extract %next_maximum_narrow_values[0] : vector<16xbf16> -> bf16
    %old_scale_narrow_values = vector.fptrunc<daz> %old_scale_values : vector<16xf32> to vector<16xbf16>
    %old_scale_narrow = vector.extract %old_scale_narrow_values[0] : vector<16xbf16> -> bf16
    %old_sum_pairs = vector.interleave<0> %old_sum_narrow_values, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %old_scale_pairs = vector.interleave<0> %old_scale_narrow_values, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %rescaled_old_sum_values = vector.dot2f %old_sum_pairs, %old_scale_pairs, %c0_0_1 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
    view.store %next_maximum_narrow, %running_maxima[%query] : bf16, view<64xbf16>
    view.store %old_scale_narrow, %old_scales[%query] : bf16, view<64xbf16>
    %sums = scf.for %position = [%c0 to %c64 step %c16](%sum = %c0_0_1 : vector<16xf32>) -> (vector<16xf32>) {
      %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
      %wide = vector.extf<daz> %input : vector<16xbf16> to vector<16xf32>
      %shifted = vector.subf<nnan|nsz> %wide, %next_maximum_values : vector<16xf32>
      %exponents = vector.expf<afn> %shifted : vector<16xf32>
      %narrow = vector.fptrunc<daz> %exponents : vector<16xf32> to vector<16xbf16>
      vector.store %narrow, %matrix[%query, %position] : vector<16xbf16>, view<64x64xbf16>
      %next = vector.addf<reassoc|nnan|ninf|nsz> %sum, %exponents : vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
    %block_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %sums, %c0_0 : vector<16xf32>, f32
    %block_sum_values = vector.splat %block_sum : vector<16xf32>
    %next_sum_values = vector.addf<nnan|ninf|nsz> %rescaled_old_sum_values, %block_sum_values : vector<16xf32>
    %denominators = vector.maxnumf<nnan|nsz> %next_sum_values, %c1_0_1 : vector<16xf32>
    %denominator = vector.extract %denominators[0] : vector<16xf32> -> f32
    %inverse = scalar.divf<arcp> %c1_0, %denominator : f32
    %inverse_values = vector.insert %inverse into %denominators[0] : f32, vector<16xf32>
    %next_sum_narrow_values = vector.fptrunc<daz> %next_sum_values : vector<16xf32> to vector<16xbf16>
    %next_sum_narrow = vector.extract %next_sum_narrow_values[0] : vector<16xbf16> -> bf16
    %inverse_narrow_values = vector.fptrunc<daz> %inverse_values : vector<16xf32> to vector<16xbf16>
    %inverse_narrow = vector.extract %inverse_narrow_values[0] : vector<16xbf16> -> bf16
    view.store %next_sum_narrow, %running_sums[%query] : bf16, view<64xbf16>
    view.store %inverse_narrow, %inverse_sums[%query] : bf16, view<64xbf16>
  }
  func.return
}

func.def inline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.normalize_row_pair(%length: index, %input: view<1024xbf16>, %scale: view<1024xbf16>, %output: view<1024xbf16>) {
  %begin = index.constant 0 : index
  %step = index.constant 32 : index
  %output_step = index.constant 16 : index
  %head_length = index.constant 128 : index
  %is_head = index.cmp eq, %length, %head_length : index
  %head_inverse = vector.constant 0.0078125 : vector<16xbf16>
  %row_inverse = vector.constant 0.0009765625 : vector<16xbf16>
  %width_inverse = scf.select %is_head, %head_inverse, %row_inverse : vector<16xbf16>
  %c0_0 = vector.constant 0.0 : vector<16xf32>
  %narrow_zero = vector.constant 0.0 : vector<16xbf16>
  %squares, %sum_error = scf.for %position = [%begin to %length step %step](%partial = %c0_0 : vector<16xf32>, %error = %c0_0 : vector<16xf32>) -> (vector<16xf32>, vector<16xf32>) {
    %values = vector.load %input[%position] : view<1024xbf16> -> vector<32xbf16>
    %products = vector.dot2f %values, %values, %c0_0 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
    %adjusted = vector.subf<nnan|ninf|nsz> %products, %error : vector<16xf32>
    %next = vector.addf<nnan|ninf|nsz> %partial, %adjusted : vector<16xf32>
    %increment = vector.subf<nnan|ninf|nsz> %next, %partial : vector<16xf32>
    %next_error = vector.subf<nnan|ninf|nsz> %increment, %adjusted : vector<16xf32>
    scf.yield %next, %next_error : vector<16xf32>, vector<16xf32>
  }
  %squares_bf16 = vector.fptrunc<daz> %squares : vector<16xf32> to vector<16xbf16>
  %squares_high = vector.extf<daz> %squares_bf16 : vector<16xbf16> to vector<16xf32>
  %squares_remainder = vector.subf<nnan|ninf|nsz> %squares, %squares_high : vector<16xf32>
  %squares_low = vector.fptrunc<daz> %squares_remainder : vector<16xf32> to vector<16xbf16>
  %squares_middle = vector.extf<daz> %squares_low : vector<16xbf16> to vector<16xf32>
  %squares_residual = vector.subf<nnan|ninf|nsz> %squares_remainder, %squares_middle : vector<16xf32>
  %squares_tail = vector.fptrunc<daz> %squares_residual : vector<16xf32> to vector<16xbf16>
  %squares_tail_pair = vector.interleave<0> %squares_tail, %narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %squares_pair = vector.interleave<0> %squares_bf16, %squares_low : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %width_pair = vector.interleave<0> %width_inverse, %width_inverse : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %leading_means = vector.dot2f %squares_pair, %width_pair, %c0_0 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %means = vector.dot2f %squares_tail_pair, %width_pair, %leading_means : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %c0_0_1 = scalar.constant 0.0 : f32
  %mean = vector.reduce<addf, reassoc|nnan|ninf|nsz> %means, %c0_0_1 : vector<16xf32>, f32
  %mean_vector = vector.splat %mean : vector<16xf32>
  %epsilon = vector.constant 9.9999999999999995e-07 : vector<16xf32>
  %variance_vector = vector.addf<nnan|ninf|nsz> %mean_vector, %epsilon : vector<16xf32>
  %variance = vector.extract %variance_vector[0] : vector<16xf32> -> f32
  %inverse = scalar.rsqrtf<afn> %variance : f32
  %inverse_vector = vector.splat %inverse : vector<16xf32>
  %inverse_bf16 = vector.fptrunc<daz> %inverse_vector : vector<16xf32> to vector<16xbf16>
  %inverse_high = vector.extf<daz> %inverse_bf16 : vector<16xbf16> to vector<16xf32>
  %inverse_remainder = vector.subf<nnan|ninf|nsz> %inverse_vector, %inverse_high : vector<16xf32>
  %inverse_low = vector.fptrunc<daz> %inverse_remainder : vector<16xf32> to vector<16xbf16>
  %inverse_middle = vector.extf<daz> %inverse_low : vector<16xbf16> to vector<16xf32>
  %inverse_residual = vector.subf<nnan|ninf|nsz> %inverse_remainder, %inverse_middle : vector<16xf32>
  %inverse_tail = vector.fptrunc<daz> %inverse_residual : vector<16xf32> to vector<16xbf16>
  %inverse_tail_pair = vector.interleave<0> %inverse_tail, %narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %inverse_pair = vector.interleave<0> %inverse_bf16, %inverse_low : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  scf.for %position = [%begin to %length step %output_step] {
    %input_value = vector.load %input[%position] : view<1024xbf16> -> vector<16xbf16>
    %input_pair = vector.interleave<0> %input_value, %input_value : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %leading_normalized = vector.dot2f %input_pair, %inverse_pair, %c0_0 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
    %normalized = vector.dot2f %input_pair, %inverse_tail_pair, %leading_normalized : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
    %normalized_bf16 = vector.fptrunc<daz> %normalized : vector<16xf32> to vector<16xbf16>
    %normalized_pair = vector.interleave<0> %normalized_bf16, %narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %scale_value = vector.load %scale[%position] : view<1024xbf16> -> vector<16xbf16>
    %scale_pair = vector.interleave<0> %scale_value, %narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %scaled = vector.dot2f %normalized_pair, %scale_pair, %c0_0 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
    %result = vector.fptrunc<daz> %scaled : vector<16xf32> to vector<16xbf16>
    vector.store %result, %output[%position] : vector<16xbf16>, view<1024xbf16>
  }
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.normalize_rows_pair(%row_storage: buffer, %scale_storage: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %width = index.constant 1024 : index
  %row_slot_base = index.constant 31680 : offset
  %row_slot_stride = index.constant 16384 : offset
  %row_bytes = index.constant 2048 : offset
  %row_scale = buffer.view %scale_storage[%row_slot_base] : buffer -> view<1024xbf16>
  scf.for %row_member = [%c0 to %c2 step %c1] {
    %slot_relative = index.scale %row_member, %row_slot_stride : index, offset -> offset
    %slot = index.add %row_slot_base, %slot_relative : offset
    scf.for %row_token = [%c0 to %c4 step %c1] {
      %token_relative = index.scale %row_token, %row_bytes : index, offset -> offset
      %token_offset = index.add %slot, %token_relative : offset
      %row_values = buffer.view %row_storage[%token_offset] : buffer -> view<1024xbf16>
      func.call @qwen3_embedding.panels.normalize_row_pair(%width, %row_values, %row_scale, %row_values) : (index, view<1024xbf16>, view<1024xbf16>, view<1024xbf16>)
    }
  }
  func.return
}
