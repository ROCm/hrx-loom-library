// Native online attention over a 64-key panel.
// Scores use compensated BFP operands and F32 accumulation. Sequence masking,
// online maximum/sum recurrence, and BF16 boundaries match the model's
// independent embedding reference. Callers own the packed operands and scratch
// ranges; the routines neither allocate nor transfer external storage.
low.func.decl inline target<amd.xdna.aie2p.core> @qwen3_embedding.panels.dot128(%weights: reg<aie2p.ep>, %weight_offset: reg<aie2p.er>, %activations: reg<aie2p.ep>, %activation_offset: reg<aie2p.er>, %initial0: reg<aie2p.mbms x4>, %initial1: reg<aie2p.mbms x4>, %initial2: reg<aie2p.mbms x4>, %initial3: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>)

target.decl @qwen3_embedding.panels.core

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.online_score64(%storage: buffer, %left_high: offset, %left_low: offset, %output_offset: offset, %output_row_base: index) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %right_high = index.constant 45696 : offset
  %right_low = index.constant 54976 : offset
  %right_stride = index.constant 1152 : offset
  %partial_offset = index.constant 9344 : offset
  %partials = buffer.view %storage[%partial_offset] : buffer -> view<4x64xf32>
  %c0_0 = vector.constant 0.0 : vector<64xf32>
  %initial = vector.fragment<init> %c0_0 shape [%c8, %c8] : vector<64xf32>
  scf.for %panel = [%begin to %end step %c1] {
    %relative = index.scale %panel, %right_stride : index, offset -> offset
    %high_offset = index.add %right_high, %relative : offset
    %low_offset = index.add %right_low, %relative : offset
    %column = index.mul %panel, %c8 : index
    %partial_span0 = view.subview %partials[0, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile0 = view.bitcast %partial_span0 : view<1x64xf32> -> view<8x8xf32>
    %partial_span1 = view.subview %partials[1, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile1 = view.bitcast %partial_span1 : view<1x64xf32> -> view<8x8xf32>
    %partial_span2 = view.subview %partials[2, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile2 = view.bitcast %partial_span2 : view<1x64xf32> -> view<8x8xf32>
    %partial_span3 = view.subview %partials[3, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile3 = view.bitcast %partial_span3 : view<1x64xf32> -> view<8x8xf32>
    %product_count = index.constant 2 : index
    %second_product = index.constant 2 : index
    %product0, %product1, %product2, %product3 = scf.for %product_phase = [%begin to %product_count step %c1](%accumulator0 = %initial : vector<64xf32>, %accumulator1 = %initial : vector<64xf32>, %accumulator2 = %initial : vector<64xf32>, %accumulator3 = %initial : vector<64xf32>) -> (vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>) {
      %left_residual_product = index.cmp eq, %product_phase, %second_product : index
      %right_residual_product = index.cmp eq, %product_phase, %c1 : index
      %product_right = scf.select %right_residual_product, %low_offset, %high_offset : offset
      %product_left = scf.select %left_residual_product, %left_low, %left_high : offset
      %next0, %next1, %next2, %next3 = low.invoke @qwen3_embedding.panels.dot128(%storage, %product_right, %storage, %product_left, %accumulator0, %accumulator1, %accumulator2, %accumulator3) : (buffer, offset, buffer, offset, vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>) -> (vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>)
      scf.yield %next0, %next1, %next2, %next3 : vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>
    }
    vector.fragment.store<result> %product0, %partial_tile0[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    vector.fragment.store<result> %product1, %partial_tile1[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    vector.fragment.store<result> %product2, %partial_tile2[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    vector.fragment.store<result> %product3, %partial_tile3[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    %output = buffer.view %storage[%output_offset] : buffer -> view<64x64xbf16>
    %blocks = index.constant 4 : index
    scf.for %result_block = [%begin to %blocks step %c1] {
      %result_base = index.mul %result_block, %c8 : index
      %output_result_base = index.add %output_row_base, %result_base : index
      %wide = vector.load %partials[%result_block, 0] : view<4x64xf32> -> vector<64xf32>
      %flat = vector.fptrunc<daz> %wide : vector<64xf32> to vector<64xbf16>
      %narrow = vector.bitcast %flat : vector<64xbf16> to vector<8x8xbf16>
      %transposed = vector.transpose<[1, 0]> %narrow : vector<8x8xbf16> -> vector<8x8xbf16>
      %output_tile = view.subview %output[%output_result_base, %column] : view<64x64xbf16> -> view<8x8xbf16>
      %values0 = vector.extract %transposed[0] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values0, %output_tile[0, 0] : vector<8xbf16>, view<8x8xbf16>
      %values1 = vector.extract %transposed[1] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values1, %output_tile[1, 0] : vector<8xbf16>, view<8x8xbf16>
      %values2 = vector.extract %transposed[2] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values2, %output_tile[2, 0] : vector<8xbf16>, view<8x8xbf16>
      %values3 = vector.extract %transposed[3] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values3, %output_tile[3, 0] : vector<8xbf16>, view<8x8xbf16>
      %values4 = vector.extract %transposed[4] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values4, %output_tile[4, 0] : vector<8xbf16>, view<8x8xbf16>
      %values5 = vector.extract %transposed[5] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values5, %output_tile[5, 0] : vector<8xbf16>, view<8x8xbf16>
      %values6 = vector.extract %transposed[6] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values6, %output_tile[6, 0] : vector<8xbf16>, view<8x8xbf16>
      %values7 = vector.extract %transposed[7] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values7, %output_tile[7, 0] : vector<8xbf16>, view<8x8xbf16>
    }
  }
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.online_score64_strided(%storage: buffer, %left_high: offset, %left_low: offset, %output_offset: offset, %output_row_base: index) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %right_high = index.constant 45696 : offset
  %right_low = index.constant 54976 : offset
  %right_stride = index.constant 1152 : offset
  %partial_offset = index.constant 9344 : offset
  %partials = buffer.view %storage[%partial_offset] : buffer -> view<4x64xf32>
  %c0_0 = vector.constant 0.0 : vector<64xf32>
  %initial = vector.fragment<init> %c0_0 shape [%c8, %c8] : vector<64xf32>
  scf.for %panel = [%begin to %end step %c1] {
    %relative = index.scale %panel, %right_stride : index, offset -> offset
    %high_offset = index.add %right_high, %relative : offset
    %low_offset = index.add %right_low, %relative : offset
    %column = index.mul %panel, %c8 : index
    %partial_span0 = view.subview %partials[0, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile0 = view.bitcast %partial_span0 : view<1x64xf32> -> view<8x8xf32>
    %partial_span1 = view.subview %partials[1, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile1 = view.bitcast %partial_span1 : view<1x64xf32> -> view<8x8xf32>
    %partial_span2 = view.subview %partials[2, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile2 = view.bitcast %partial_span2 : view<1x64xf32> -> view<8x8xf32>
    %partial_span3 = view.subview %partials[3, 0] : view<4x64xf32> -> view<1x64xf32>
    %partial_tile3 = view.bitcast %partial_span3 : view<1x64xf32> -> view<8x8xf32>
    %product_count = index.constant 2 : index
    %second_product = index.constant 2 : index
    %product0, %product1, %product2, %product3 = scf.for %product_phase = [%begin to %product_count step %c1](%accumulator0 = %initial : vector<64xf32>, %accumulator1 = %initial : vector<64xf32>, %accumulator2 = %initial : vector<64xf32>, %accumulator3 = %initial : vector<64xf32>) -> (vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>) {
      %left_residual_product = index.cmp eq, %product_phase, %second_product : index
      %right_residual_product = index.cmp eq, %product_phase, %c1 : index
      %product_right = scf.select %right_residual_product, %low_offset, %high_offset : offset
      %product_left = scf.select %left_residual_product, %left_low, %left_high : offset
      %next0, %next1, %next2, %next3 = low.invoke @qwen3_embedding.panels.dot128(%storage, %product_right, %storage, %product_left, %accumulator0, %accumulator1, %accumulator2, %accumulator3) : (buffer, offset, buffer, offset, vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>) -> (vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>)
      scf.yield %next0, %next1, %next2, %next3 : vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>
    }
    vector.fragment.store<result> %product0, %partial_tile0[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    vector.fragment.store<result> %product1, %partial_tile1[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    vector.fragment.store<result> %product2, %partial_tile2[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    vector.fragment.store<result> %product3, %partial_tile3[0, 0] shape [%c8, %c8] : vector<64xf32>, view<8x8xf32>
    %output = buffer.view %storage[%output_offset] : buffer -> view<64x64xbf16, #encoding.layout.strided<strides=[64, 1]>>
    %blocks = index.constant 4 : index
    scf.for %result_block = [%begin to %blocks step %c1] {
      %result_base = index.mul %result_block, %c8 : index
      %output_result_base = index.add %output_row_base, %result_base : index
      %wide = vector.load %partials[%result_block, 0] : view<4x64xf32> -> vector<64xf32>
      %flat = vector.fptrunc<daz> %wide : vector<64xf32> to vector<64xbf16>
      %narrow = vector.bitcast %flat : vector<64xbf16> to vector<8x8xbf16>
      %transposed = vector.transpose<[1, 0]> %narrow : vector<8x8xbf16> -> vector<8x8xbf16>
      %output_tile = view.subview %output[%output_result_base, %column] : view<64x64xbf16, #encoding.layout.strided<strides=[64, 1]>> -> view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values0 = vector.extract %transposed[0] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values0, %output_tile[0, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values1 = vector.extract %transposed[1] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values1, %output_tile[1, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values2 = vector.extract %transposed[2] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values2, %output_tile[2, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values3 = vector.extract %transposed[3] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values3, %output_tile[3, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values4 = vector.extract %transposed[4] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values4, %output_tile[4, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values5 = vector.extract %transposed[5] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values5, %output_tile[5, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values6 = vector.extract %transposed[6] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values6, %output_tile[6, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
      %values7 = vector.extract %transposed[7] : vector<8x8xbf16> -> vector<8xbf16>
      vector.store %values7, %output_tile[7, 0] : vector<8xbf16>, view<8x8xbf16, #encoding.layout.strided<strides=[64, 1]>>
    }
  }
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.online_softmax64(%storage: buffer, %query_base: index, %key_base: index) {
  %matrix_offset = index.constant 0 : offset
  %running_maximum_offset = index.constant 19072 : offset
  %running_sum_offset = index.constant 19200 : offset
  %old_scale_offset = index.constant 19328 : offset
  %inverse_sum_offset = index.constant 19456 : offset
  %query_sequence_offset = index.constant 18816 : offset
  %key_sequence_offset = index.constant 19584 : offset
  %matrix = buffer.view %storage[%matrix_offset] : buffer -> view<64x64xbf16>
  %query_sequences = buffer.view %storage[%query_sequence_offset] : buffer -> view<64xi32>
  %key_sequences = buffer.view %storage[%key_sequence_offset] : buffer -> view<64xi32>
  %running_maxima = buffer.view %storage[%running_maximum_offset] : buffer -> view<64xbf16>
  %running_sums = buffer.view %storage[%running_sum_offset] : buffer -> view<64xbf16>
  %old_scales = buffer.view %storage[%old_scale_offset] : buffer -> view<64xbf16>
  %inverse_sums = buffer.view %storage[%inverse_sum_offset] : buffer -> view<64xbf16>
  %c0_0_2 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c0_0 = scalar.constant 0.0 : f32
  %c1_0 = scalar.constant 1.0 : f32
  %integer_zero = scalar.constant 0 : i32
  %integer_one = scalar.constant 1 : i32
  %factor = scalar.constant 0.088388347648318433 : f32
  %negative_infinity = scalar.constant -inf : f32
  %c0_0_1 = vector.constant 0.0 : vector<16xf32>
  %narrow_zeros = vector.constant 0.0 : vector<16xbf16>
  %c1_0_1 = vector.constant 1.0 : vector<16xf32>
  %infinities = vector.constant -inf : vector<16xf32>
  %lanes = vector.iota %integer_zero step %integer_one : vector<16xi32>
  scf.for %query = [%c0_0_2 to %c64 step %c1] {
    %absolute_query = index.add %query_base, %query : index
    %query_sequence = view.load %query_sequences[%query] : view<64xi32> -> i32
    %valid = scalar.cmpi sge, %query_sequence, %integer_zero : i32
    %valid_lanes = vector.splat %valid : vector<16xi1>
    %query_sequence_lanes = vector.splat %query_sequence : vector<16xi32>
    %query_integer = index.cast %absolute_query : index to i32
    %query_indices = vector.splat %query_integer : vector<16xi32>
    %maxima = scf.for %position = [%c0_0_2 to %c64 step %c16](%maximum = %infinities : vector<16xf32>) -> (vector<16xf32>) {
      %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
      %factor_vector = vector.splat %factor : vector<16xf32>
      %high = vector.fptrunc<daz> %factor_vector : vector<16xf32> to vector<16xbf16>
      %high_f32 = vector.extf<daz> %high : vector<16xbf16> to vector<16xf32>
      %remainder = vector.subf %factor_vector, %high_f32 : vector<16xf32>
      %middle = vector.fptrunc<daz> %remainder : vector<16xf32> to vector<16xbf16>
      %middle_f32 = vector.extf<daz> %middle : vector<16xbf16> to vector<16xf32>
      %tail_f32 = vector.subf %remainder, %middle_f32 : vector<16xf32>
      %tail = vector.fptrunc<daz> %tail_f32 : vector<16xf32> to vector<16xbf16>
      %c0_0_2 = vector.constant 0.0 : vector<16xf32>
      %narrow_zero = vector.constant 0.0 : vector<16xbf16>
      %factor_pair = vector.interleave<0> %high, %middle : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %tail_pair = vector.interleave<0> %tail, %narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %repeated = vector.interleave<0> %input, %input : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %leading = vector.dot2f %repeated, %factor_pair, %c0_0_2 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
      %product = vector.dot2f %repeated, %tail_pair, %leading : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
      %result = vector.fptrunc<daz> %product : vector<16xf32> to vector<16xbf16>
      %wide = vector.extf<daz> %result : vector<16xbf16> to vector<16xf32>
      %key_sequence_lanes = vector.load %key_sequences[%position] : view<64xi32> -> vector<16xi32>
      %same = vector.cmpi eq, %key_sequence_lanes, %query_sequence_lanes : vector<16xi32> -> vector<16xi1>
      %relative_position = index.add %key_base, %position : index
      %position_integer = index.cast %relative_position : index to i32
      %positions = vector.splat %position_integer : vector<16xi32>
      %keys = vector.addi %positions, %lanes : vector<16xi32>
      %causal = vector.cmpi ule, %keys, %query_indices : vector<16xi32> -> vector<16xi1>
      %same_causal = vector.andi %same, %causal : vector<16xi1>
      %visible = vector.andi %same_causal, %valid_lanes : vector<16xi1>
      %masked = vector.select %visible, %wide, %infinities : vector<16xf32>
      %narrow = vector.fptrunc<daz> %masked : vector<16xf32> to vector<16xbf16>
      vector.store %narrow, %matrix[%query, %position] : vector<16xbf16>, view<64x64xbf16>
      %next = vector.maxnumf<nnan|nsz> %maximum, %masked : vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
    %block_maximum = vector.reduce<maxnumf, reassoc|nnan|nsz> %maxima, %negative_infinity : vector<16xf32>, f32
    %old_maximum_narrow = view.load %running_maxima[%query] : view<64xbf16> -> bf16
    %old_maximum = scalar.extf<daz> %old_maximum_narrow : bf16 to f32
    %old_maximum_values = vector.splat %old_maximum : vector<16xf32>
    %old_sum_narrow = view.load %running_sums[%query] : view<64xbf16> -> bf16
    %old_sum = scalar.extf<daz> %old_sum_narrow : bf16 to f32
    %old_sum_values = vector.splat %old_sum : vector<16xf32>
    %old_sum_narrow_values = vector.splat %old_sum_narrow : vector<16xbf16>
    %block_maximum_values = vector.splat %block_maximum : vector<16xf32>
    %block_present = vector.cmpf ogt, %block_maximum_values, %infinities : vector<16xf32> -> vector<16xi1>
    %empty_maximum = vector.select %block_present, %block_maximum_values, %c0_0_1 : vector<16xf32>
    %maximum_candidate = vector.maxnumf<nnan|nsz> %old_maximum_values, %block_maximum_values : vector<16xf32>
    %old_present_for_maximum = vector.cmpf ogt, %old_sum_values, %c0_0_1 : vector<16xf32> -> vector<16xi1>
    %next_maximum_values = vector.select %old_present_for_maximum, %maximum_candidate, %empty_maximum : vector<16xf32>
    %old_delta = vector.subf<nnan|nsz> %old_maximum_values, %next_maximum_values : vector<16xf32>
    %old_scale_candidate = vector.expf<afn> %old_delta : vector<16xf32>
    %old_present_for_scale = vector.cmpf ogt, %old_sum_values, %c0_0_1 : vector<16xf32> -> vector<16xi1>
    %old_scale_values = vector.select %old_present_for_scale, %old_scale_candidate, %c0_0_1 : vector<16xf32>
    %next_maximum_narrow_values = vector.fptrunc<daz> %next_maximum_values : vector<16xf32> to vector<16xbf16>
    %next_maximum_narrow = vector.extract %next_maximum_narrow_values[0] : vector<16xbf16> -> bf16
    %old_scale_narrow_values = vector.fptrunc<daz> %old_scale_values : vector<16xf32> to vector<16xbf16>
    %old_scale_narrow = vector.extract %old_scale_narrow_values[0] : vector<16xbf16> -> bf16
    %old_sum_pairs = vector.interleave<0> %old_sum_narrow_values, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %old_scale_pairs = vector.interleave<0> %old_scale_narrow_values, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
    %rescaled_old_sum_values = vector.dot2f %old_sum_pairs, %old_scale_pairs, %c0_0_1 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
    view.store %next_maximum_narrow, %running_maxima[%query] : bf16, view<64xbf16>
    view.store %old_scale_narrow, %old_scales[%query] : bf16, view<64xbf16>
    %sums = scf.for %position = [%c0_0_2 to %c64 step %c16](%sum = %c0_0_1 : vector<16xf32>) -> (vector<16xf32>) {
      %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
      %wide = vector.extf<daz> %input : vector<16xbf16> to vector<16xf32>
      %shifted = vector.subf<nnan|nsz> %wide, %next_maximum_values : vector<16xf32>
      %exponents = vector.expf<afn> %shifted : vector<16xf32>
      %narrow = vector.fptrunc<daz> %exponents : vector<16xf32> to vector<16xbf16>
      vector.store %narrow, %matrix[%query, %position] : vector<16xbf16>, view<64x64xbf16>
      %next = vector.addf<reassoc|nnan|ninf|nsz> %sum, %exponents : vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
    %block_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %sums, %c0_0 : vector<16xf32>, f32
    %block_sum_values = vector.splat %block_sum : vector<16xf32>
    %next_sum_values = vector.addf<nnan|ninf|nsz> %rescaled_old_sum_values, %block_sum_values : vector<16xf32>
    %sum_present = vector.cmpf ogt, %next_sum_values, %c0_0_1 : vector<16xf32> -> vector<16xi1>
    %denominators = vector.select %sum_present, %next_sum_values, %c1_0_1 : vector<16xf32>
    %denominator = vector.extract %denominators[0] : vector<16xf32> -> f32
    %inverse = scalar.divf<arcp> %c1_0, %denominator : f32
    %inverse_values = vector.insert %inverse into %denominators[0] : f32, vector<16xf32>
    %next_sum_narrow_values = vector.fptrunc<daz> %next_sum_values : vector<16xf32> to vector<16xbf16>
    %next_sum_narrow = vector.extract %next_sum_narrow_values[0] : vector<16xbf16> -> bf16
    %inverse_narrow_values = vector.fptrunc<daz> %inverse_values : vector<16xf32> to vector<16xbf16>
    %inverse_narrow = vector.extract %inverse_narrow_values[0] : vector<16xbf16> -> bf16
    view.store %next_sum_narrow, %running_sums[%query] : bf16, view<64xbf16>
    view.store %inverse_narrow, %inverse_sums[%query] : bf16, view<64xbf16>
  }
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.online_mask64(%storage: buffer, %query_base: index, %key_base: index) {
  %matrix_offset = index.constant 0 : offset
  %running_maximum_offset = index.constant 19072 : offset
  %running_sum_offset = index.constant 19200 : offset
  %old_scale_offset = index.constant 19328 : offset
  %inverse_sum_offset = index.constant 19456 : offset
  %query_sequence_offset = index.constant 18816 : offset
  %key_sequence_offset = index.constant 19584 : offset
  %matrix = buffer.view %storage[%matrix_offset] : buffer -> view<64x64xbf16>
  %query_sequences = buffer.view %storage[%query_sequence_offset] : buffer -> view<64xi32>
  %key_sequences = buffer.view %storage[%key_sequence_offset] : buffer -> view<64xi32>
  %running_maxima = buffer.view %storage[%running_maximum_offset] : buffer -> view<64xbf16>
  %running_sums = buffer.view %storage[%running_sum_offset] : buffer -> view<64xbf16>
  %old_scales = buffer.view %storage[%old_scale_offset] : buffer -> view<64xbf16>
  %inverse_sums = buffer.view %storage[%inverse_sum_offset] : buffer -> view<64xbf16>
  %c0_0_2 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c0_0 = scalar.constant 0.0 : f32
  %c1_0 = scalar.constant 1.0 : f32
  %integer_zero = scalar.constant 0 : i32
  %integer_one = scalar.constant 1 : i32
  %factor = scalar.constant 0.088388347648318433 : f32
  %negative_infinity = scalar.constant -inf : f32
  %c0_0_1 = vector.constant 0.0 : vector<16xf32>
  %narrow_zeros = vector.constant 0.0 : vector<16xbf16>
  %c1_0_1 = vector.constant 1.0 : vector<16xf32>
  %infinities = vector.constant -inf : vector<16xf32>
  %lanes = vector.iota %integer_zero step %integer_one : vector<16xi32>
  scf.for %query = [%c0_0_2 to %c64 step %c1] {
    %absolute_query = index.add %query_base, %query : index
    %query_sequence = view.load %query_sequences[%query] : view<64xi32> -> i32
    %valid = scalar.cmpi sge, %query_sequence, %integer_zero : i32
    %valid_lanes = vector.splat %valid : vector<16xi1>
    %query_sequence_lanes = vector.splat %query_sequence : vector<16xi32>
    %query_integer = index.cast %absolute_query : index to i32
    %query_indices = vector.splat %query_integer : vector<16xi32>
    %maxima = scf.for %position = [%c0_0_2 to %c64 step %c16](%maximum = %infinities : vector<16xf32>) -> (vector<16xf32>) {
      %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
      %factor_vector = vector.splat %factor : vector<16xf32>
      %high = vector.fptrunc<daz> %factor_vector : vector<16xf32> to vector<16xbf16>
      %high_f32 = vector.extf<daz> %high : vector<16xbf16> to vector<16xf32>
      %remainder = vector.subf %factor_vector, %high_f32 : vector<16xf32>
      %middle = vector.fptrunc<daz> %remainder : vector<16xf32> to vector<16xbf16>
      %middle_f32 = vector.extf<daz> %middle : vector<16xbf16> to vector<16xf32>
      %tail_f32 = vector.subf %remainder, %middle_f32 : vector<16xf32>
      %tail = vector.fptrunc<daz> %tail_f32 : vector<16xf32> to vector<16xbf16>
      %c0_0_2 = vector.constant 0.0 : vector<16xf32>
      %narrow_zero = vector.constant 0.0 : vector<16xbf16>
      %factor_pair = vector.interleave<0> %high, %middle : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %tail_pair = vector.interleave<0> %tail, %narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %repeated = vector.interleave<0> %input, %input : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %leading = vector.dot2f %repeated, %factor_pair, %c0_0_2 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
      %product = vector.dot2f %repeated, %tail_pair, %leading : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
      %result = vector.fptrunc<daz> %product : vector<16xf32> to vector<16xbf16>
      %wide = vector.extf<daz> %result : vector<16xbf16> to vector<16xf32>
      %key_sequence_lanes = vector.load %key_sequences[%position] : view<64xi32> -> vector<16xi32>
      %same = vector.cmpi eq, %key_sequence_lanes, %query_sequence_lanes : vector<16xi32> -> vector<16xi1>
      %relative_position = index.add %key_base, %position : index
      %position_integer = index.cast %relative_position : index to i32
      %positions = vector.splat %position_integer : vector<16xi32>
      %keys = vector.addi %positions, %lanes : vector<16xi32>
      %causal = vector.cmpi ule, %keys, %query_indices : vector<16xi32> -> vector<16xi1>
      %same_causal = vector.andi %same, %causal : vector<16xi1>
      %visible = vector.andi %same_causal, %valid_lanes : vector<16xi1>
      %masked = vector.select %visible, %wide, %infinities : vector<16xf32>
      %narrow = vector.fptrunc<daz> %masked : vector<16xf32> to vector<16xbf16>
      vector.store %narrow, %matrix[%query, %position] : vector<16xbf16>, view<64x64xbf16>
      %next = vector.maxnumf<nnan|nsz> %maximum, %masked : vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
  }
  func.return
}

func.def noinline target(@qwen3_embedding.panels.core) @qwen3_embedding.panels.online_recurrence64_value(%storage: buffer) {
  %matrix_offset = index.constant 18816 : offset
  %running_maximum_offset = index.constant 64768 : offset
  %running_sum_offset = index.constant 64896 : offset
  %old_scale_offset = index.constant 65024 : offset
  %inverse_sum_offset = index.constant 65152 : offset
  %matrix = buffer.view %storage[%matrix_offset] : buffer -> view<64x64xbf16>
  %running_maxima = buffer.view %storage[%running_maximum_offset] : buffer -> view<64xbf16>
  %running_sums = buffer.view %storage[%running_sum_offset] : buffer -> view<64xbf16>
  %old_scales = buffer.view %storage[%old_scale_offset] : buffer -> view<64xbf16>
  %inverse_sums = buffer.view %storage[%inverse_sum_offset] : buffer -> view<64xbf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c0_0 = scalar.constant 0.0 : f32
  %c1_0 = scalar.constant 1.0 : f32
  %integer_zero = scalar.constant 0 : i32
  %integer_one = scalar.constant 1 : i32
  %factor = scalar.constant 0.088388347648318433 : f32
  %negative_infinity = scalar.constant -inf : f32
  %c0_0_1 = vector.constant 0.0 : vector<16xf32>
  %narrow_zeros = vector.constant 0.0 : vector<16xbf16>
  %c1_0_1 = vector.constant 1.0 : vector<16xf32>
  %infinities = vector.constant -inf : vector<16xf32>
  %lanes = vector.iota %integer_zero step %integer_one : vector<16xi32>
  scf.for %query = [%c0 to %c64 step %c1] {
    %maxima = scf.for %position = [%c0 to %c64 step %c16](%maximum = %infinities : vector<16xf32>) -> (vector<16xf32>) {
      %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
      %wide = vector.extf<daz> %input : vector<16xbf16> to vector<16xf32>
      %next = vector.maxnumf<nnan|nsz> %maximum, %wide : vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
    %block_maximum = vector.reduce<maxnumf, reassoc|nnan|nsz> %maxima, %negative_infinity : vector<16xf32>, f32
    %old_maximum_narrow = view.load %running_maxima[%query] : view<64xbf16> -> bf16
    %old_maximum = scalar.extf<daz> %old_maximum_narrow : bf16 to f32
    %old_maximum_values = vector.splat %old_maximum : vector<16xf32>
    %old_sum_narrow = view.load %running_sums[%query] : view<64xbf16> -> bf16
    %old_sum = scalar.extf<daz> %old_sum_narrow : bf16 to f32
    %old_sum_values = vector.splat %old_sum : vector<16xf32>
    %old_sum_narrow_values = vector.splat %old_sum_narrow : vector<16xbf16>
    %block_maximum_values = vector.splat %block_maximum : vector<16xf32>
