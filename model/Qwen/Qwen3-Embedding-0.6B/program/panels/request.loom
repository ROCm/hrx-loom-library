// Request activation, output completion, and worker retirement.
// Preparation has already installed all borrowed addresses. Activation makes
// the initial streams visible, completion waits for the final output DMA, and
// retirement stops all thirty-two cores before the invocation releases state.
target.decl @qwen3_embedding.panels.configuration

low.func.decl target<amd.xdna.aie2p.configuration> @qwen3_embedding.panels.wait_attention_join()

