// Query/key ingress on core (4,4), owning its metadata, embedding gathers, and neighbor barriers.
// The role retains local and peer storage until its arrival/departure
// barriers retire each phase. Native helpers preserve BFP/F32 arithmetic,
// sequence isolation, and explicit FIFO/lock ownership across token panels.
func.decl noinline @qwen3_embedding.panels.online_score64_strided(%storage: buffer, %left_high: offset, %left_low: offset, %output_offset: offset, %output_row_base: index)

func.decl noinline @qwen3_embedding.panels.online_softmax64(%storage: buffer, %query_base: index, %key_base: index)

