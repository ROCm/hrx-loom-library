^block_6(%block_6_index: index, %block_6_offset: offset, %block_6_offset_1: offset):
  %cmp_1 = index.cmp slt, %block_6_index, %panel_count : index
  cfg.cond_br %cmp_1, ^block_7, ^block_150
^block_7:
  %episode = index.assume %block_6_index [range(%block_6_index, 0, 3)] : index
