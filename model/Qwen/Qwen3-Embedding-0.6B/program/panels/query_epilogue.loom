^block_8:
  low.invoke @qwen3_embedding.panels.acquire_lock_51(%acquire_credit_result) : (i32)
  %local_address_74980_result = low.invoke @qwen3_embedding.panels.local_address_74980() : () -> (buffer)
  %aligned_storage_3 = buffer.assume.alignment %local_address_74980_result {minimum_alignment = 128} : buffer
  %metadata_incoming = buffer.view %aligned_storage_3[%lane_origin] : buffer -> view<2048xi32>
  %dimension_metadata_rows = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>
  cfg.br ^block_9(%epoch_layer_boundary: index, %block_6_offset: offset, %block_6_offset_1: offset)
^block_9(%block_9_index: index, %block_9_offset: offset, %block_9_offset_1: offset):
  %cmp_2 = index.cmp slt, %block_9_index, %panel_shift : index
  cfg.cond_br %cmp_2, ^block_10, ^block_14
^block_10:
  %dimension_member = index.assume %block_9_index [range(%block_9_index, 0, 1)] : index
  %dimension_member_base = index.madd %dimension_member, %c32, %dimension_row_base : index
  cfg.br ^block_11(%epoch_layer_boundary: index, %block_9_offset: offset, %block_9_offset_1: offset)
