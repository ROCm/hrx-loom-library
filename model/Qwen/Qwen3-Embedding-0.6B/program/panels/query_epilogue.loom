  %dense_scales = buffer.view %aligned_storage[%dense_scale_offset] : buffer -> view<256xbf16>
  %dense_rope_bits = buffer.view %aligned_storage[%dense_rope_offset] : buffer -> view<4096xbf16>
  %c0_0 = vector.constant 0.0 : vector<64xf32>
  %c0 = vector.constant 0 : vector<16xi32>
  %head_inverse = vector.constant 0.0078125 : vector<16xbf16>
  %c0_0_1 = vector.constant 0.0 : vector<16xf32>
  %narrow_zero = vector.constant 0.0 : vector<16xbf16>
