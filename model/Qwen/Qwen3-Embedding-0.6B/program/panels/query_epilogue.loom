  %dense_chunks = scf.select %residual_group, %wide_chunks, %panel_waves : index
  %dense_roles = scf.select %residual_group, %panel_one, %panel_shift : index
  %last_dense_role = index.sub %dense_roles, %panel_one : index
  %last_chunk = index.sub %dense_chunks, %panel_one : index
