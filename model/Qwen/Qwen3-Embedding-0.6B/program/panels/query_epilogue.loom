  %query_key_group = index.cmp eq, %dense_group, %epoch_layer_boundary : index
  %head_group = index.cmp ult, %dense_group, %panel_shift : index
  %output_group = index.cmp eq, %dense_group, %panel_shift : index
  %down_group = index.cmp eq, %dense_group, %c6 : index
