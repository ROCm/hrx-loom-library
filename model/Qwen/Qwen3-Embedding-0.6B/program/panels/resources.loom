low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.epoch_start_c0_r2(%epoch_gate_acquire: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
