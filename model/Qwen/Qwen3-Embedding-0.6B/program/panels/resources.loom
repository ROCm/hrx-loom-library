// Immediate local-memory and lock access for the placed resident workers.
// Native lock numbers include the neighboring-bank selection bits. Template
// callers select these exact instruction forms from placement-time facts;
// lock ownership and release credit remain explicit at the worker callsite.
// Local-address suffixes are physical addresses in the core's bank window.
global.rodata.decl @qwen3_embedding.panels.epoch_bounds

target.decl @qwen3_embedding.panels.core

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.attention_join_c0_r2() asm {
  %arrived = mov.short 1
  rel %arrived, 62
  %released = mov.short -2
  acq %released, 62
  return
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.attention_join_c0_r3() asm {
  %arrived = mov.short 1
  rel %arrived, 56
  %released = mov.short -2
  acq %released, 56
  return
}

low.func.def inline target<amd.xdna.aie2p.core>(@qwen3_embedding.panels.core) @qwen3_embedding.panels.attention_join_c2_r2() asm {
  %arrived = mov.short 1
  rel %arrived, 58
  %released = mov.short -2
  acq %released, 58
  return
}

