// Local storage and initial data for the resident worker placement.
// Core ranges, epoch bounds, and output-lane constants are installed before
// any worker executes. Bank addresses agree with the role resource accessors;
// their lifetimes span all layers. Epoch transitions update the layer bounds;
// the output-lane constants remain unchanged.
target.decl @qwen3_embedding.panels.configuration

global.rodata.def @qwen3_embedding.panels.epoch_bounds = align(4) bytes("0000000001000000")

global.rodata.def @qwen3_embedding.panels.finish_lanes = align(64) bytes("00000100020003000400050006000700080009000a000b000c000d000e000f0010001100120013001400150016001700180019001a001b001c001d001e001f00")

