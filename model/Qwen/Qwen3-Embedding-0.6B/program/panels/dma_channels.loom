// Core and memory-tile DMA channel configuration.
// Descriptor rings preserve the worker lock-credit protocol and publication
// order. Queue repetition keeps packed weight panels resident across token
// groups; later epoch refills wait for these finite queues to drain.
target.decl @qwen3_embedding.panels.configuration

