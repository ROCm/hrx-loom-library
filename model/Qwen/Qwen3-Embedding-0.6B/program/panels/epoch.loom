// Finite DMA queue refill and four-layer epoch transition.
// Weight receivers must drain before their repeated tasks are rearmed. Layer
// bounds are published only after every core reports the attention-phase join;
// restarting a core preserves the invocation's resident bindings and buffers.
target.decl @qwen3_embedding.panels.configuration

low.func.decl target<amd.xdna.aie2p.configuration> @qwen3_embedding.panels.wait_attention_join()

