// External-memory descriptors for model bindings and request state.
// Static transfer geometry is installed once; request preparation supplies
// relocated addresses. Descriptor IDs are part of the core control-packet ABI
// and remain stable while one resident invocation processes every layer.
target.decl @qwen3_embedding.panels.configuration

