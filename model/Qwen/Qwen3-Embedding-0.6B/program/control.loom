// Registered finite cohorts share stable roots and own independent panel ranges.
type.decl import("finite", "batch") @FiniteBatch

func.decl import("finite", "batch_count") @finite_batch_count(%batch: ptr<@FiniteBatch>) -> (i64)

func.decl import("finite", "batch_state") @finite_batch_state(%batch: ptr<@FiniteBatch>, %ordinal: i64) -> (buffer)

func.decl import("finite", "batch_offer") @finite_batch_offer(%batch: ptr<@FiniteBatch>, %ordinal: i64, %units: i64, %tag: i64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl @prepare_sequences(%request: buffer) -> (buffer)

func.decl @request_layout(%request: buffer) -> (offset, offset, offset, offset)

func.decl @select_cohort(%request: buffer, %owner_offset: offset, %control_offset: offset)

func.decl @cohort_payload(%request: buffer, %owner_offset: offset, %control_offset: offset) -> (buffer)

func.decl import("finite", "batch_release") @finite_batch_release(%batch: ptr<@FiniteBatch>, %ordinal: i64)

func.decl import("finite", "batch_buffer") @finite_batch_buffer(%batch: ptr<@FiniteBatch>, %ordinal: i64, %root: i32) -> (hal.buffer)

func.decl import("finite", "batch_origin") @finite_batch_origin(%batch: ptr<@FiniteBatch>, %ordinal: i64) -> (i64)

func.decl import("storage") @copy(%source: hal.buffer, %source_offset: i64, %target: hal.buffer, %target_offset: i64, %length: i64) -> (i64)

func.decl import("storage") @completed(%slot: i32) -> (buffer)

func.decl import("runner") @execute_7(%stage: i32, %input: hal.buffer, %output: hal.buffer, %metadata: hal.buffer, %vectors: hal.buffer, %state: hal.buffer, %requests: hal.buffer, %replies: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.def @is_complete(%state: buffer) -> (i1) {
  %record_offset = index.constant 32 : offset
  %record = buffer.view %state[%record_offset] : buffer -> view<16xi32>
  %cursor = view.load %record[6] : view<16xi32> -> i32
  %mask = scalar.constant 1023 : i32
  %final_phase = scalar.constant 225 : i32
  %phase = scalar.andi %cursor, %mask : i32
  %done = scalar.cmpi eq, %phase, %final_phase : i32
  func.return %done : i1
}

func.def public @embedding_request_storage(%state: buffer, %request: buffer) -> (i64) {
  %total, %prepared_bytes, %owner_offset, %control_offset = func.call @request_layout(%request) : (buffer) -> (offset, offset, offset, offset)
  %header_bytes = index.constant 32 : offset
  %record_offset = index.add %control_offset, %header_bytes : offset
  %record = buffer.view %request[%record_offset] : buffer -> view<16xi32>
  %panels32 = view.load %record[4] : view<16xi32> -> i32
  %panels = scalar.extui %panels32 : i32 to i64
  func.return %panels : i64
}

func.def public @embedding_prepare_request_v1(%state: buffer, %request: buffer) -> (buffer, i64, i64) {
  %prepared = func.call @prepare_sequences(%request) : (buffer) -> (buffer)
  %total, %prepared_bytes, %owner_offset, %control_offset = func.call @request_layout(%prepared) : (buffer) -> (offset, offset, offset, offset)
  %result = buffer.alloca<private> align(8) %total : buffer
  %origin = index.constant 0 : offset
  buffer.copy %prepared[%origin], %result[%origin], %prepared_bytes
  %owner = buffer.view %result[%owner_offset] : buffer -> view<2xi64>
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  view.store %c0, %owner[1] : i64, view<2xi64>
  func.call @select_cohort(%result, %owner_offset, %control_offset) : (buffer, offset, offset)
  func.return %result, %c1, %c0 : buffer, i64, i64
}

func.def public @embedding_prepare_batch_v1(%state: buffer, %tags: buffer, %batch: ptr<@FiniteBatch>) -> (i32, buffer, buffer) {
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %request = func.call @finite_batch_state(%batch, %c0) : (ptr<@FiniteBatch>, i64) -> (buffer)
  %total, %prepared_bytes, %owner_offset, %control_offset = func.call @request_layout(%request) : (buffer) -> (offset, offset, offset, offset)
  %origin = index.constant 0 : offset
  %fixed_state_bytes = index.constant 96 : offset
  %first_panel = func.call @finite_batch_origin(%batch, %c0) : (ptr<@FiniteBatch>, i64) -> (i64)
  %first32 = scalar.trunci %first_panel : i64 to i32
  %record_relative = index.constant 32 : offset
  %request_record_offset = index.add %control_offset, %record_relative : offset
  %request_record = buffer.view %request[%request_record_offset] : buffer -> view<16xi32>
  view.store %first32, %request_record[9] : i32, view<16xi32>
  %cursor = view.load %request_record[6] : view<16xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %initial = scalar.cmpi eq, %cursor, %c0_i32 : i32
  %payload = scf.if %initial -> (buffer) {
    %initial_payload = func.call @cohort_payload(%request, %owner_offset, %control_offset) : (buffer, offset, offset) -> (buffer)
    scf.yield %initial_payload : buffer
  } else {
    %packet = buffer.alloca<private> align(8) %fixed_state_bytes : buffer
    buffer.copy %request[%control_offset], %packet[%origin], %fixed_state_bytes
    scf.yield %packet : buffer
  }
  %request_summary = buffer.view %request[%control_offset] : buffer -> view<4xi64>
  %count64 = view.load %request_summary[1] : view<4xi64> -> i64
  %bounded_count = scalar.assume %count64 [range(%count64, 1, 4096)] : i64
  %count = index.cast %bounded_count : i64 to index
  %offset_bytes = index.constant 8 : offset
  %directory_bytes = index.scale %count, %offset_bytes : index, offset -> offset
  %state_bytes = index.add %fixed_state_bytes, %directory_bytes : offset
  buffer.copy %request[%control_offset], %state[%origin], %state_bytes
  %done = func.call @is_complete(%state) : (buffer) -> (i1)
  %rows64 = scf.select %done, %count64, %c0 : i64
  %bounded_rows = scalar.assume %rows64 [range(%rows64, 0, 4096)] : i64
  %rows = index.cast %bounded_rows : i64 to index
  %summary = buffer.view %state[%origin] : buffer -> view<4xi64>
  %dimensions = view.load %summary[0] : view<4xi64> -> i64
  %tokens = view.load %summary[2] : view<4xi64> -> i64
  %element_bytes = scalar.constant 4 : i64
  %row_bytes = scalar.muli %dimensions, %element_bytes : i64
  %output_bytes = scalar.muli %rows64, %row_bytes : i64
  %minimum_output = scalar.constant 16 : i64
  %physical_bytes = scalar.maxui %output_bytes, %minimum_output : i64
  %header_length = index.constant 56 : offset
  %row_record_bytes = index.constant 16 : offset
  %rows_length = index.scale %rows, %row_record_bytes : index, offset -> offset
  %plan_length = index.add %header_length, %rows_length : offset
  %plan = buffer.alloca<private> align(8) %plan_length : buffer
  %plan_values = buffer.view %plan[%origin] : buffer -> view<7xi64>
  view.store %physical_bytes, %plan_values[0] : i64, view<7xi64>
  view.store %output_bytes, %plan_values[1] : i64, view<7xi64>
  view.store %c1, %plan_values[2] : i64, view<7xi64>
  view.store %rows64, %plan_values[3] : i64, view<7xi64>
  view.store %c0, %plan_values[4] : i64, view<7xi64>
  view.store %rows64, %plan_values[5] : i64, view<7xi64>
  %published_tokens = scf.select %done, %tokens, %c0 : i64
  view.store %published_tokens, %plan_values[6] : i64, view<7xi64>
  %vectors = buffer.view %plan[%header_length] : buffer -> view<[%rows]x2xi64>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %rows step %step] {
    %ordinal = index.cast %i : index to i64
    %offset = scalar.muli %ordinal, %row_bytes : i64
    view.store %offset, %vectors[%i, 0] : i64, view<[%rows]x2xi64>
    view.store %dimensions, %vectors[%i, 1] : i64, view<[%rows]x2xi64>
  }
  func.return %c0_i32, %payload, %plan : i32, buffer, buffer
}

func.def public @embedding_run_v1(%state: buffer, %stage: i32, %input: hal.buffer, %output: hal.buffer, %batch: ptr<@FiniteBatch>) {
  %c0 = scalar.constant 0 : i64
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c4_i32 = scalar.constant 4 : i32
  %metadata = func.call @finite_batch_buffer(%batch, %c0, %c0_i32) : (ptr<@FiniteBatch>, i64, i32) -> (hal.buffer)
  %vectors = func.call @finite_batch_buffer(%batch, %c0, %c1_i32) : (ptr<@FiniteBatch>, i64, i32) -> (hal.buffer)
  %persistent = func.call @finite_batch_buffer(%batch, %c0, %c2_i32) : (ptr<@FiniteBatch>, i64, i32) -> (hal.buffer)
  %requests = func.call @finite_batch_buffer(%batch, %c0, %c3_i32) : (ptr<@FiniteBatch>, i64, i32) -> (hal.buffer)
  %replies = func.call @finite_batch_buffer(%batch, %c0, %c4_i32) : (ptr<@FiniteBatch>, i64, i32) -> (hal.buffer)
  %origin = index.constant 0 : offset
  %summary = buffer.view %state[%origin] : buffer -> view<4xi64>
  %record_offset = index.constant 32 : offset
  %record = buffer.view %state[%record_offset] : buffer -> view<16xi32>
  %first32 = view.load %record[9] : view<16xi32> -> i32
  %first = scalar.extui %first32 : i32 to i64
  %metadata_stride = scalar.constant 8192 : i64
  %output_stride = scalar.constant 524288 : i64
  %metadata_base = scalar.muli %first, %metadata_stride : i64
  %output_base = scalar.muli %first, %output_stride : i64
  %done = func.call @is_complete(%state) : (buffer) -> (i1)
  scf.if %done {
    %dimensions = view.load %summary[0] : view<4xi64> -> i64
    %count64 = view.load %summary[1] : view<4xi64> -> i64
    %bounded_count = scalar.assume %count64 [range(%count64, 1, 4096)] : i64
    %count = index.cast %bounded_count : i64 to index
    %rows_offset = index.constant 96 : offset
    %rows = buffer.view %state[%rows_offset] : buffer -> view<[%count]xi64>
    %element_bytes = scalar.constant 4 : i64
    %length = scalar.muli %dimensions, %element_bytes : i64
    %begin = index.constant 0 : index
    %step = index.constant 1 : index
    scf.for %i = [%begin to %count step %step] {
      %relative = view.load %rows[%i] : view<[%count]xi64> -> i64
      %source_offset = scalar.addi %output_base, %relative : i64
      %ordinal = index.cast %i : index to i64
      %target_offset = scalar.muli %ordinal, %length : i64
      %gather = func.call @copy(%vectors, %source_offset, %output, %target_offset, %length) : (hal.buffer, i64, hal.buffer, i64, i64) -> (i64)
    }
  } else {
    %cursor = view.load %record[6] : view<16xi32> -> i32
    %initial = scalar.cmpi eq, %cursor, %c0_i32 : i32
    scf.if %initial {
      %metadata_bytes = view.load %summary[3] : view<4xi64> -> i64
      %payload_offset = scalar.constant 96 : i64
      %upload = func.call @copy(%input, %payload_offset, %metadata, %metadata_base, %metadata_bytes) : (hal.buffer, i64, hal.buffer, i64, i64) -> (i64)
    }
    %packet_offset = scalar.constant 32 : i64
    %packet_bytes = scalar.constant 64 : i64
    %publish = func.call @copy(%input, %packet_offset, %requests, %c0, %packet_bytes) : (hal.buffer, i64, hal.buffer, i64, i64) -> (i64)
    %execute = func.call @execute_7(%stage, %input, %output, %metadata, %vectors, %persistent, %requests, %replies) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %reply = func.call @feedback(%c0_i32, %replies, %c0, %packet_bytes) : (i32, hal.buffer, i64, i64) -> (i64)
  }
  func.return
}

func.def public @embedding_collect_batch_v1(%state: buffer, %batch: ptr<@FiniteBatch>) {
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %request = func.call @finite_batch_state(%batch, %c0) : (ptr<@FiniteBatch>, i64) -> (buffer)
  %total, %prepared_bytes, %owner_offset, %control_offset = func.call @request_layout(%request) : (buffer) -> (offset, offset, offset, offset)
  %origin = index.constant 0 : offset
  %done = func.call @is_complete(%state) : (buffer) -> (i1)
  scf.if %done {
    func.call @finite_batch_release(%batch, %c0) : (ptr<@FiniteBatch>, i64)
    %header = buffer.view %request[%origin] : buffer -> view<4xi64>
    %sequences = view.load %header[0] : view<4xi64> -> i64
    %owner = buffer.view %request[%owner_offset] : buffer -> view<2xi64>
    %end = view.load %owner[1] : view<2xi64> -> i64
    %more = scalar.cmpi ult, %end, %sequences : i64
    scf.if %more {
      func.call @select_cohort(%request, %owner_offset, %control_offset) : (buffer, offset, offset)
    }
    %units = scalar.extui %more : i1 to i64
    func.call @finite_batch_offer(%batch, %c0, %units, %c0) : (ptr<@FiniteBatch>, i64, i64, i64)
  } else {
    %c0_i32 = scalar.constant 0 : i32
    %reply = func.call @completed(%c0_i32) : (i32) -> (buffer)
    %record_relative = index.constant 32 : offset
    %record_offset = index.add %control_offset, %record_relative : offset
    %record_bytes = index.constant 64 : offset
    buffer.copy %reply[%origin], %request[%record_offset], %record_bytes
    %record = buffer.view %request[%record_offset] : buffer -> view<16xi32>
    %allowance = scalar.constant 64 : i32
    %restore = scalar.constant 1 : i32
    view.store %allowance, %record[7] : i32, view<16xi32>
    view.store %restore, %record[8] : i32, view<16xi32>
    func.call @finite_batch_offer(%batch, %c0, %c1, %c0) : (ptr<@FiniteBatch>, i64, i64, i64)
  }
  func.return
}
