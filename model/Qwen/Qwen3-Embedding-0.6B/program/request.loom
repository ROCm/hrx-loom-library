// Dispatch admission follows input publication. One finite work record is
// consumed per epoch; native completion publishes its joined progress reply.
pipeline.def public @request.receive() run(%requests: buffer, %records: channel<tile<4096xbf16>>, %header_storage: buffer) {
  %origin = index.constant 0 : offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %record = channel.reserve %records : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
    %words = view.bitcast %record : view<4096xbf16> -> view<2048xi32>
    %header = view.subview %words[0] : view<2048xi32> -> view<16xi32>
    %external_header = buffer.view %requests[%origin] : buffer -> view<16xi32>
    %copy = kernel.async.copy %external_header to %header {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    %saved = buffer.view %header_storage[%origin] : buffer -> view<16xi32>
    %metadata = vector.load %header[0] : view<16xi32> -> vector<16xi32>
    vector.store %metadata, %saved[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<4096xbf16>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %record = channel.acquire %records : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)
    channel.release %read : read<tile<4096xbf16>>
  }
}

pipeline.def public @request.reply() run(%replies: buffer, %records: channel<tile<4096xbf16>>, %header_storage: buffer) {
  %origin = index.constant 0 : offset
  pipeline.strand workers([1, 2], [1, 1], [1, 1]) {
    %write, %record = channel.reserve %records : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
    %words = view.bitcast %record : view<4096xbf16> -> view<2048xi32>
    %payload = view.subview %words[0] : view<2048xi32> -> view<16xi32>
    %external_payload = buffer.view %replies[%origin] : buffer -> view<16xi32>
    %saved = buffer.view %header_storage[%origin] : buffer -> view<16xi32>
    %metadata = vector.load %saved[0] : view<16xi32> -> vector<16xi32>
    vector.store %metadata, %payload[0] : vector<16xi32>, view<16xi32>
    %copy = kernel.async.copy %payload to %external_payload {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<4096xbf16>>
  }
  pipeline.strand workers([1, 3], [1, 1], [1, 1]) {
    %read, %record = channel.acquire %records : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)
    channel.release %read : read<tile<4096xbf16>>
  }
}
