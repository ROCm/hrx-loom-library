      %result = vector.fptrunc<daz> %product : vector<16xf32> to vector<16xbf16>
      %wide = vector.extf<daz> %result : vector<16xbf16> to vector<16xf32>
      %key_sequence_lanes = vector.load %key_sequences[%position] : view<64xi32> -> vector<16xi32>
      %same = vector.cmpi eq, %key_sequence_lanes, %query_sequence_lanes : vector<16xi32> -> vector<16xi1>
      %relative_position = index.add %key_base, %position : index
      %position_integer = index.cast %relative_position : index to i32
      %positions = vector.splat %position_integer : vector<16xi32>
      %keys = vector.addi %positions, %lanes : vector<16xi32>
      %causal = vector.cmpi ule, %keys, %query_indices : vector<16xi32> -> vector<16xi1>
      %same_causal = vector.andi %same, %causal : vector<16xi1>
      %visible = vector.andi %same_causal, %valid_lanes : vector<16xi1>
      %masked = vector.select %visible, %wide, %infinities : vector<16xf32>
      %narrow = vector.fptrunc<daz> %masked : vector<16xf32> to vector<16xbf16>
      vector.store %narrow, %matrix[%query, %position] : vector<16xbf16>, view<64x64xbf16>
      %next = vector.maxnumf<nnan|nsz> %maximum, %masked : vector<16xf32>
      scf.yield %next : vector<16xf32>
    }
  }
  func.return
}

func.def inline @qwen3_embedding.online_recurrence64(%storage: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  scf.for %query = [%begin to %end step %step] {
    func.call @qwen3_embedding.recurrence_prepare_row(%storage, %query) : (buffer, index)
    func.call @qwen3_embedding.recurrence_exp_row(%storage) : (buffer)
    func.call @qwen3_embedding.recurrence_finish_row(%storage, %query) : (buffer, index)
  }
  func.return
}

func.def inline @attention_scale_tile(%input: vector<64xbf16>, %scale: vector<8xbf16>) -> (vector<64xbf16>) {
  %tile = vector.bitcast %input : vector<64xbf16> to vector<4x16xbf16>
  %c0_vector = vector.splatf 0.0 : vector<16xf32>
  %narrow_zeros = vector.splatf 0.0 : vector<16xbf16>
  %scales = vector.concat<0> %scale, %scale : vector<8xbf16>, vector<8xbf16> -> vector<16xbf16>
  %scale_pairs = vector.interleave<0> %scales, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %row0 = vector.extract %tile[0] : vector<4x16xbf16> -> vector<16xbf16>
  %pairs0 = vector.interleave<0> %row0, %row0 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %product0 = vector.dot2f %pairs0, %scale_pairs, %c0_vector : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %result0 = vector.fptrunc<daz> %product0 : vector<16xf32> to vector<16xbf16>
  %row1 = vector.extract %tile[1] : vector<4x16xbf16> -> vector<16xbf16>
  %pairs1 = vector.interleave<0> %row1, %row1 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %product1 = vector.dot2f %pairs1, %scale_pairs, %c0_vector : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %result1 = vector.fptrunc<daz> %product1 : vector<16xf32> to vector<16xbf16>
  %row2 = vector.extract %tile[2] : vector<4x16xbf16> -> vector<16xbf16>
  %pairs2 = vector.interleave<0> %row2, %row2 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %product2 = vector.dot2f %pairs2, %scale_pairs, %c0_vector : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %result2 = vector.fptrunc<daz> %product2 : vector<16xf32> to vector<16xbf16>
  %row3 = vector.extract %tile[3] : vector<4x16xbf16> -> vector<16xbf16>
  %pairs3 = vector.interleave<0> %row3, %row3 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %product3 = vector.dot2f %pairs3, %scale_pairs, %c0_vector : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %result3 = vector.fptrunc<daz> %product3 : vector<16xf32> to vector<16xbf16>
  %low = vector.concat<0> %result0, %result1 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %high = vector.concat<0> %result2, %result3 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %result = vector.concat<0> %low, %high : vector<32xbf16>, vector<32xbf16> -> vector<64xbf16>
  func.return %result : vector<64xbf16>
}

func.def public inline @qwen3_embedding.attention_query(%storage: buffer, %input: channel<tile<4624xi32>>, %probabilities: channel<tile<4096xbf16>>, %results: channel<tile<4096xbf16>>, %output: buffer, %output_base: offset, %panel_stride: offset, %emit_output: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %origin = index.constant 0 : offset
  %query_high = index.constant 27008 : offset
  %query_low = index.constant 36288 : offset
  %query_high_second = index.constant 31616 : offset
  %query_low_second = index.constant 40896 : offset
  %key_high = index.constant 45696 : offset
  %key_low = index.constant 54976 : offset
  %query_sequence_offset = index.constant 18816 : offset
  %maximum_offset = index.constant 19072 : offset
  %sum_offset = index.constant 19200 : offset
  %scale_offset = index.constant 19328 : offset
  %inverse_offset = index.constant 19456 : offset
  %key_sequence_offset = index.constant 19584 : offset
  %identity_offset = index.constant 19840 : offset
  %half_bytes = index.constant 8192 : offset
  %wave_bytes = index.constant 16384 : offset
  %pack_count = scalar.constant 128 : i32
  %metadata_word = index.constant 4096 : index
  %identity = buffer.view %storage[%identity_offset] : buffer -> view<8x8xbf16>
  func.call @qwen3_embedding.identity(%identity) : (view<8x8xbf16>)
  %query_sequences = buffer.view %storage[%query_sequence_offset] : buffer -> view<64xi32>
  %key_sequences = buffer.view %storage[%key_sequence_offset] : buffer -> view<64xi32>
  %maxima = buffer.view %storage[%maximum_offset] : buffer -> view<64xbf16>
  %sums = buffer.view %storage[%sum_offset] : buffer -> view<64xbf16>
  %scales = buffer.view %storage[%scale_offset] : buffer -> view<64xbf16>
  %inverses = buffer.view %storage[%inverse_offset] : buffer -> view<64xbf16>
  %score_values = buffer.view %storage[%origin] : buffer -> view<4096xbf16>
  %c0_vector = vector.splatf 0.0 : vector<64xbf16>
  scf.for %wave = [%c0 to %c4 step %c1] {
    %query_read, %query_payload = channel.acquire %input : channel<tile<4624xi32>> -> (read<tile<4624xi32>>, view<4624xi32>)
    %query_ids = vector.load %query_payload[%metadata_word] : view<4624xi32> -> vector<64xi32>
    vector.store %query_ids, %query_sequences[0] : vector<64xi32>, view<64xi32>
    func.call @bfp16ebs8.pack_bf16_aie2p(%storage, %origin, %query_high, %pack_count) : (buffer, offset, offset, i32)
    channel.release %query_read : read<tile<4624xi32>>
    vector.store %c0_vector, %maxima[0] : vector<64xbf16>, view<64xbf16>
    vector.store %c0_vector, %sums[0] : vector<64xbf16>, view<64xbf16>
    %key_count = index.add %wave, %c1 : index
    %query_base = index.mul %wave, %c64 : index
    scf.for %key = [%c0 to %key_count step %c1] {
      %key_read, %key_payload = channel.acquire<mutable> %input : channel<tile<4624xi32>> -> (read<tile<4624xi32>, mutable>, view<4624xi32>)
      %key_ids = vector.load %key_payload[%metadata_word] : view<4624xi32> -> vector<64xi32>
      vector.store %key_ids, %key_sequences[0] : vector<64xi32>, view<64xi32>
      func.call @bfp16ebs8.pack_bf16_aie2p(%storage, %origin, %key_high, %pack_count) : (buffer, offset, offset, i32)
      func.call @bfp16ebs8.pack_bf16_residual_aie2p(%storage, %origin, %key_low, %identity_offset, %pack_count) : (buffer, offset, offset, offset, i32)
      func.call @qwen3_embedding.online_score64(%storage, %query_high, %query_low, %origin, %c0) : (buffer, offset, offset, offset, index)
      func.call @qwen3_embedding.online_score64(%storage, %query_high_second, %query_low_second, %origin, %c32) : (buffer, offset, offset, offset, index)
      %key_base = index.mul %key, %c64 : index
      func.call @qwen3_embedding.online_mask64(%storage, %query_base, %key_base) : (buffer, index, index)
      func.call @qwen3_embedding.online_recurrence64(%storage) : (buffer)
      %probability_write, %probability_payload = channel.reserve %probabilities : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
      func.call @qwen3_embedding.copy_output(%score_values, %probability_payload) : (view<4096xbf16>, view<4096xbf16>)
      channel.publish %probability_write : write<tile<4096xbf16>>
      %state_write, %state_payload = channel.reserve %probabilities : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
      %scale_values = vector.load %scales[0] : view<64xbf16> -> vector<64xbf16>
      %inverse_values = vector.load %inverses[0] : view<64xbf16> -> vector<64xbf16>
      vector.store %scale_values, %state_payload[0] : vector<64xbf16>, view<4096xbf16>
      vector.store %inverse_values, %state_payload[64] : vector<64xbf16>, view<4096xbf16>
      channel.publish %state_write : write<tile<4096xbf16>>
      channel.release %key_read : read<tile<4624xi32>, mutable>
      %value_read, %unused_value = channel.acquire %input : channel<tile<4624xi32>> -> (read<tile<4624xi32>>, view<4624xi32>)
      %next_key = index.add %key, %c1 : index
      %last_key = index.cmp eq, %next_key, %key_count : index
      scf.if %last_key {
        scf.if %emit_output {
          %panel = index.div %wave, %c2 : index
          %panel_wave = index.rem %wave, %c2 : index
          %panel_relative = index.scale %panel, %panel_stride : index, offset -> offset
          %wave_relative = index.scale %panel_wave, %wave_bytes : index, offset -> offset
          %panel_base = index.add %output_base, %panel_relative : offset
          %wave_base = index.add %panel_base, %wave_relative : offset
          scf.for %half = [%c0 to %c2 step %c1] {
            %result_read, %result_payload = channel.acquire %results : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)
            %half_relative = index.scale %half, %half_bytes : index, offset -> offset
            %address = index.add %wave_base, %half_relative : offset
            %external = buffer.view %output[%address] : buffer -> view<4096xbf16>
            %copy = kernel.async.copy %result_payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %completion = kernel.async.group %copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %completion {newer_groups = 0} : kernel.async.group
            channel.release %result_read : read<tile<4096xbf16>>
          }
        }
      }
      channel.release %value_read : read<tile<4624xi32>>
    }
  }
  func.return
}

func.def public inline @qwen3_embedding.attention_value(%storage: buffer, %input: channel<tile<4624xi32>>, %probabilities: channel<tile<4096xbf16>>, %results: channel<tile<4096xbf16>>, %output: buffer, %output_base: offset, %panel_stride: offset, %emit_output: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %origin = index.constant 0 : offset
  %probability_offset = index.constant 18816 : offset
  %value_high = index.constant 43456 : offset
  %identity_offset = index.constant 62720 : offset
  %scale_offset = index.constant 62848 : offset
  %inverse_offset = index.constant 62976 : offset
  %pack_count = scalar.constant 128 : i32
  %identity = buffer.view %storage[%identity_offset] : buffer -> view<8x8xbf16>
  func.call @qwen3_embedding.identity(%identity) : (view<8x8xbf16>)
  %probability_local = buffer.view %storage[%probability_offset] : buffer -> view<4096xbf16>
  %scales = buffer.view %storage[%scale_offset] : buffer -> view<64xbf16>
  %inverses = buffer.view %storage[%inverse_offset] : buffer -> view<64xbf16>
  %maximum_offset = index.constant 63104 : offset
  %sum_offset = index.constant 63232 : offset
  %maxima = buffer.view %storage[%maximum_offset] : buffer -> view<64xbf16>
  %sums = buffer.view %storage[%sum_offset] : buffer -> view<64xbf16>
  %c0_vector = vector.splatf 0.0 : vector<64xbf16>
  scf.for %wave = [%c0 to %c4 step %c1] {
    %query_read, %unused_query = channel.acquire %input : channel<tile<4624xi32>> -> (read<tile<4624xi32>>, view<4624xi32>)
    channel.release %query_read : read<tile<4624xi32>>
    %key_count = index.add %wave, %c1 : index
    scf.for %key = [%c0 to %key_count step %c1] {
      %key_read, %unused_key = channel.acquire %input : channel<tile<4624xi32>> -> (read<tile<4624xi32>>, view<4624xi32>)
      %probability_read, %probability_payload = channel.acquire %probabilities : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)
      func.call @qwen3_embedding.copy_output(%probability_payload, %probability_local) : (view<4096xbf16>, view<4096xbf16>)
      channel.release %probability_read : read<tile<4096xbf16>>
      %state_read, %state_payload = channel.acquire %probabilities : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)
      %scale_values = vector.load %state_payload[0] : view<4096xbf16> -> vector<64xbf16>
      %inverse_values = vector.load %state_payload[64] : view<4096xbf16> -> vector<64xbf16>
      vector.store %scale_values, %scales[0] : vector<64xbf16>, view<64xbf16>
      vector.store %inverse_values, %inverses[0] : vector<64xbf16>, view<64xbf16>
      channel.release %state_read : read<tile<4096xbf16>>
      channel.release %key_read : read<tile<4624xi32>>
      %value_read, %value_payload = channel.acquire %input : channel<tile<4624xi32>> -> (read<tile<4624xi32>>, view<4624xi32>)
      func.call @bfp16ebs8.pack_bf16_aie2p(%storage, %origin, %value_high, %pack_count) : (buffer, offset, offset, i32)
      %previous = index.cmp ne, %key, %c0 : index
      %next_key = index.add %key, %c1 : index
      %last_key = index.cmp eq, %next_key, %key_count : index
      scf.if %last_key {
        scf.for %half = [%c0 to %c2 step %c1] {
          func.call @qwen3_embedding.online_value_half(%storage, %half, %previous) : (buffer, index, i1)
        }
        scf.for %half = [%c0 to %c2 step %c1] {
          %result_write, %result_payload = channel.reserve %results : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
          func.call @qwen3_embedding.online_value_result(%storage, %half, %result_payload) : (buffer, index, view<4096xbf16>)
          channel.publish %result_write : write<tile<4096xbf16>>
          scf.if %emit_output {
            %read, %payload = channel.acquire %results : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)
            %panel = index.div %wave, %c2 : index
            %panel_wave = index.rem %wave, %c2 : index
            %panel_offset = index.scale %panel, %panel_stride : index, offset -> offset
            %wave_bytes = index.constant 16384 : offset
            %half_bytes = index.constant 8192 : offset
            %wave_offset = index.scale %panel_wave, %wave_bytes : index, offset -> offset
            %half_offset = index.scale %half, %half_bytes : index, offset -> offset
            %panel_base = index.add %output_base, %panel_offset : offset
            %wave_base = index.add %panel_base, %wave_offset : offset
            %address = index.add %wave_base, %half_offset : offset
            %external = buffer.view %output[%address] : buffer -> view<4096xbf16>
            %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %completion = kernel.async.group %copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %completion {newer_groups = 0} : kernel.async.group
            channel.release %read : read<tile<4096xbf16>>
          }
        }
        channel.release %value_read : read<tile<4624xi32>>
      } else {
        // Packed V and all PV workspace are private. Returning this credit
        // lets the next K arrive while the current value product runs.
        channel.release %value_read : read<tile<4624xi32>>
        scf.for %half = [%c0 to %c2 step %c1] {
          func.call @qwen3_embedding.online_value_half(%storage, %half, %previous) : (buffer, index, i1)
        }
      }
    }
  }
  func.return
}

func.def public inline @qwen3_embedding.block_attention_keys(%input: view<32x128xbf16>, %output: view<4096xbf16>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %blocks = index.constant 4 : index
  scf.for %block = [%c0 to %blocks step %c1] {
    %row_base = index.mul %block, %c8 : index
    %block_base = index.mul %block, %c16 : index
    scf.for %reduction = [%c0 to %c16 step %c1] {
      %column = index.mul %reduction, %c8 : index
      %tile = index.add %block_base, %reduction : index
      %tile_base = index.mul %tile, %c64 : index
      scf.for %lane = [%c0 to %c8 step %c1] {
        %row = index.add %row_base, %lane : index
        %values = vector.load %input[%row, %column] : view<32x128xbf16> -> vector<8xbf16>
        %lane_offset = index.mul %lane, %c8 : index
        %destination = index.add %tile_base, %lane_offset : index
        vector.store %values, %output[%destination] : vector<8xbf16>, view<4096xbf16>
      }
    }
  }
  func.return
}

