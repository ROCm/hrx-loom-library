func.def public inline target(@qwen3_embedding.packed_core) @qwen3_embedding.shared_swiglu_dense(%gate_storage: buffer, %up_storage: buffer, %slot: offset, %swap_tables: i1) {
  %table_ab = scf.select %swap_tables, %up_storage, %gate_storage : buffer
  %table_cd = scf.select %swap_tables, %gate_storage, %up_storage : buffer
  %gate = buffer.view %gate_storage[%slot] : buffer -> view<4096xf32>
  %up = buffer.view %up_storage[%slot] : buffer -> view<4096xf32>
  %output = buffer.view %gate_storage[%slot] : buffer -> view<4096xbf16>
  func.call @qwen3_embedding.swiglu_dense(%gate, %up, %table_ab, %table_cd, %output) : (view<4096xf32>, view<4096xf32>, buffer, buffer, view<4096xbf16>)
  func.return
}

