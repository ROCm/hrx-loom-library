// Resident compensated-BF16 attention for a 256-slot cohort. Each query/value
// pair retains one 128-query panel and visits four 64-token K/V windows. The
// channel protocol owns operand credits; paired workers exchange probabilities
// and result tiles. Sequence IDs mask cross-request attention. F32 online
// maxima, sums, and output accumulators preserve normalization across windows.
// Dense-block packing and the callable arithmetic leaves share tile storage
// with the dense phases, whose completion precedes attention entry.

aie2p.target<core> @qwen3_embedding.packed_core

func.decl inline @qwen3_embedding.identity(%output: view<8x8xbf16>)

func.decl inline @qwen3_embedding.copy_output(%input: view<4096xbf16>, %output: view<4096xbf16>)

func.decl inline @qwen3_embedding.dot64(%weights: buffer, %weight_offset: offset, %activations: buffer, %activation_offset: offset, %initial0: vector<64xf32>, %initial1: vector<64xf32>, %initial2: vector<64xf32>, %initial3: vector<64xf32>) -> (vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>)

func.decl inline @qwen3_embedding.dot128(%weights: buffer, %weight_offset: offset, %activations: buffer, %activation_offset: offset, %initial0: vector<64xf32>, %initial1: vector<64xf32>, %initial2: vector<64xf32>, %initial3: vector<64xf32>) -> (vector<64xf32>, vector<64xf32>, vector<64xf32>, vector<64xf32>)

func.def public inline @qwen3_embedding.dense_block_values(%input: view<32x128xbf16>, %output: view<16x4x64xbf16>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c8 = index.constant 8 : index
  scf.for %feature_block = [%c0 to %c16 step %c1] {
    %feature_base = index.mul %feature_block, %c8 : index
    scf.for %token_block = [%c0 to %c4 step %c1] {
      %token_base = index.mul %token_block, %c8 : index
      %lane0 = index.constant 0 : index
      %source_row0 = index.add %token_base, %lane0 : index
      %row0 = vector.load %input[%source_row0, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane1 = index.constant 1 : index
      %source_row1 = index.add %token_base, %lane1 : index
      %row1 = vector.load %input[%source_row1, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane2 = index.constant 2 : index
      %source_row2 = index.add %token_base, %lane2 : index
      %row2 = vector.load %input[%source_row2, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane3 = index.constant 3 : index
      %source_row3 = index.add %token_base, %lane3 : index
      %row3 = vector.load %input[%source_row3, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane4 = index.constant 4 : index
      %source_row4 = index.add %token_base, %lane4 : index
      %row4 = vector.load %input[%source_row4, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane5 = index.constant 5 : index
      %source_row5 = index.add %token_base, %lane5 : index
      %row5 = vector.load %input[%source_row5, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane6 = index.constant 6 : index
      %source_row6 = index.add %token_base, %lane6 : index
      %row6 = vector.load %input[%source_row6, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %lane7 = index.constant 7 : index
      %source_row7 = index.add %token_base, %lane7 : index
      %row7 = vector.load %input[%source_row7, %feature_base] : view<32x128xbf16> -> vector<8xbf16>
      %join8_0 = vector.concat<0> %row0, %row1 : vector<8xbf16>, vector<8xbf16> -> vector<16xbf16>
      %join8_2 = vector.concat<0> %row2, %row3 : vector<8xbf16>, vector<8xbf16> -> vector<16xbf16>
      %join8_4 = vector.concat<0> %row4, %row5 : vector<8xbf16>, vector<8xbf16> -> vector<16xbf16>
      %join8_6 = vector.concat<0> %row6, %row7 : vector<8xbf16>, vector<8xbf16> -> vector<16xbf16>
      %join16_0 = vector.concat<0> %join8_0, %join8_2 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %join16_2 = vector.concat<0> %join8_4, %join8_6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
      %join32_0 = vector.concat<0> %join16_0, %join16_2 : vector<32xbf16>, vector<32xbf16> -> vector<64xbf16>
      %tile = vector.bitcast %join32_0 : vector<64xbf16> to vector<8x8xbf16>
      %transposed = vector.transpose<[1, 0]> %tile : vector<8x8xbf16> -> vector<8x8xbf16>
      %values = vector.bitcast %transposed : vector<8x8xbf16> to vector<64xbf16>
      vector.store %values, %output[%feature_block, %token_block, 0] : vector<64xbf16>, view<16x4x64xbf16>
    }
  }
  func.return
}

func.decl inline @bfp16ebs8.pack_bf16_aie2p(%storage: buffer, %input: offset, %output: offset, %count: i32)

func.decl inline @bfp16ebs8.pack_bf16_residual_aie2p(%storage: buffer, %input: offset, %output: offset, %identity: offset, %count: i32)

func.def inline @qwen3_embedding.attention_exp(%input: vector<16xf32>) -> (vector<16xf32>) {
  %floor = vector.splatf -86.900000000000006 : vector<16xf32>
  %bounded = vector.maxnumf<nnan|nsz> %input, %floor : vector<16xf32>
  %c0_value = vector.splatf 0.0 : vector<16xf32>
  %high = vector.fptrunc<daz> %bounded : vector<16xf32> to vector<16xbf16>
  %high_f32 = vector.extf<daz> %high : vector<16xbf16> to vector<16xf32>
  %remainder = vector.subf %bounded, %high_f32 : vector<16xf32>
  %middle = vector.fptrunc<daz> %remainder : vector<16xf32> to vector<16xbf16>
  %middle_f32 = vector.extf<daz> %middle : vector<16xbf16> to vector<16xf32>
  %tail_f32 = vector.subf %remainder, %middle_f32 : vector<16xf32>
  %tail = vector.fptrunc<daz> %tail_f32 : vector<16xf32> to vector<16xbf16>
  %coefficient_high = vector.splatf 1.4453125 : vector<16xbf16>
  %coefficient_middle = vector.splatf -0.00262451171875 : vector<16xbf16>
  %coefficient_tail = vector.splatf 7.0631504058837891e-06 : vector<16xbf16>
  %input0 = vector.interleave<0> %high, %middle : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %factor0 = vector.interleave<0> %coefficient_high, %coefficient_high : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %partial0 = vector.dot2f %input0, %factor0, %c0_value : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %input1 = vector.interleave<0> %tail, %high : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %factor1 = vector.interleave<0> %coefficient_high, %coefficient_middle : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %partial1 = vector.dot2f %input1, %factor1, %partial0 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %input2 = vector.interleave<0> %middle, %high : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %factor2 = vector.interleave<0> %coefficient_middle, %coefficient_tail : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %scaled = vector.dot2f %input2, %factor2, %partial1 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %hybrid_zero = vector.splatf 0.0 : vector<16xf32>
  %hybrid_narrow_zero = vector.splatf 0.0 : vector<16xbf16>
  %hybrid_high = vector.fptrunc<daz> %scaled : vector<16xf32> to vector<16xbf16>
  %hybrid_high_f32 = vector.extf<daz> %hybrid_high : vector<16xbf16> to vector<16xf32>
  %hybrid_residual = vector.subf<nnan|ninf|nsz> %scaled, %hybrid_high_f32 : vector<16xf32>
  %hybrid_residual_bf16 = vector.fptrunc<daz> %hybrid_residual : vector<16xf32> to vector<16xbf16>
  %hybrid_native = vector.exp2f<nnan|ninf|nsz|afn> %hybrid_high_f32 : vector<16xf32>
  %hybrid_magic = vector.splatf 12582912.0 : vector<16xf32>
  %hybrid_biased = vector.addf<nnan|ninf|nsz> %hybrid_high_f32, %hybrid_magic : vector<16xf32>
  %hybrid_integer = vector.subf<nnan|ninf|nsz> %hybrid_biased, %hybrid_magic : vector<16xf32>
  %hybrid_centered = vector.subf<nnan|ninf|nsz> %hybrid_high_f32, %hybrid_integer : vector<16xf32>
  %hybrid_centered_bits = vector.bitcast %hybrid_centered : vector<16xf32> to vector<16xi32>
  %hybrid_sign_shift = vector.splati 31 : vector<16xi32>
  %hybrid_sign_mask = vector.shrsi %hybrid_centered_bits, %hybrid_sign_shift : vector<16xi32>
  %hybrid_one_bits = vector.splati 1065353216 : vector<16xi32>
  %hybrid_wrap_bits = vector.andi %hybrid_sign_mask, %hybrid_one_bits : vector<16xi32>
  %hybrid_wrap = vector.bitcast %hybrid_wrap_bits : vector<16xi32> to vector<16xf32>
  %hybrid_fraction = vector.addf<nnan|ninf|nsz> %hybrid_centered, %hybrid_wrap : vector<16xf32>
  %hybrid_fraction_bf16 = vector.fptrunc<daz> %hybrid_fraction : vector<16xf32> to vector<16xbf16>
  %hybrid_quadratic = vector.splatf 0.23985324739716779 : vector<16xbf16>
  %hybrid_linear = vector.splatf -0.23464084701717214 : vector<16xf32>
  %hybrid_fraction_zero = vector.interleave<0> %hybrid_fraction_bf16, %hybrid_narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %hybrid_quadratic_zero = vector.interleave<0> %hybrid_quadratic, %hybrid_narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %hybrid_partial = vector.dot2f %hybrid_fraction_zero, %hybrid_quadratic_zero, %hybrid_linear : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %hybrid_partial_bf16 = vector.fptrunc<daz> %hybrid_partial : vector<16xf32> to vector<16xbf16>
  %hybrid_residual_coefficient = vector.splatf 0.67764579207252162 : vector<16xbf16>
  %hybrid_variables = vector.interleave<0> %hybrid_fraction_bf16, %hybrid_residual_bf16 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %hybrid_coefficients = vector.interleave<0> %hybrid_partial_bf16, %hybrid_residual_coefficient : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %hybrid_constant = vector.splatf 1.0070049627383595 : vector<16xf32>
  %hybrid_correction = vector.dot2f %hybrid_variables, %hybrid_coefficients, %hybrid_constant : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %hybrid_correction_bf16 = vector.fptrunc<daz> %hybrid_correction : vector<16xf32> to vector<16xbf16>
  %hybrid_native_bf16 = vector.fptrunc<daz> %hybrid_native : vector<16xf32> to vector<16xbf16>
  %hybrid_native_zero = vector.interleave<0> %hybrid_native_bf16, %hybrid_narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %hybrid_correction_zero = vector.interleave<0> %hybrid_correction_bf16, %hybrid_narrow_zero : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %hybrid_product = vector.dot2f %hybrid_native_zero, %hybrid_correction_zero, %hybrid_zero : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %hybrid_rounded = vector.fptrunc<daz> %hybrid_product : vector<16xf32> to vector<16xbf16>
  %hybrid_result = vector.extf<daz> %hybrid_rounded : vector<16xbf16> to vector<16xf32>
  %below = vector.cmpf olt, %input, %floor : vector<16xf32> -> vector<16xi1>
  %finite = vector.select %below, %c0_value, %hybrid_result : vector<16xf32>
  func.return %finite : vector<16xf32>
}

func.def noinline target(@qwen3_embedding.packed_core) @qwen3_embedding.recurrence_prepare_row(%workspace: buffer, %query: index) where [range(%query, 0, 63)] {
  // The array supplies its 64-byte-aligned tile workspace.
  %storage = buffer.assume.alignment %workspace {minimum_alignment = 64} : buffer

  %matrix_offset = index.constant 0 : offset
  %running_maximum_offset = index.constant 19072 : offset
  %running_sum_offset = index.constant 19200 : offset
  %old_scale_offset = index.constant 19328 : offset
  %inverse_sum_offset = index.constant 19456 : offset
  %matrix = buffer.view %storage[%matrix_offset] : buffer -> view<64x64xbf16>
  %running_maxima = buffer.view %storage[%running_maximum_offset] : buffer -> view<64xbf16>
  %running_sums = buffer.view %storage[%running_sum_offset] : buffer -> view<64xbf16>
  %old_scales = buffer.view %storage[%old_scale_offset] : buffer -> view<64xbf16>
  %inverse_sums = buffer.view %storage[%inverse_sum_offset] : buffer -> view<64xbf16>
  %c0_0_2 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %integer_zero = scalar.constant 0 : i32
  %integer_one = scalar.constant 1 : i32
  %factor = scalar.constant 0.088388347648318433 : f32
  %negative_infinity = scalar.constant -inf : f32
  %c0_vector = vector.splatf 0.0 : vector<16xf32>
  %narrow_zeros = vector.splatf 0.0 : vector<16xbf16>
  %c1_vector = vector.splatf 1.0 : vector<16xf32>
  %infinities = vector.splatf -inf : vector<16xf32>
  %lanes = vector.iota %integer_zero step %integer_one : vector<16xi32>

  %maxima = scf.for %position = [%c0_0_2 to %c64 step %c16](%maximum = %infinities : vector<16xf32>) -> (vector<16xf32>) {
    %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
    %wide = vector.extf<daz> %input : vector<16xbf16> to vector<16xf32>
    %next = vector.maxnumf<nnan|nsz> %maximum, %wide : vector<16xf32>
    scf.yield %next : vector<16xf32>
  }
  %block_maximum = vector.reduce<maxnumf, reassoc|nnan|nsz> %maxima, %negative_infinity : vector<16xf32>, f32
  %old_maximum_narrow = view.load %running_maxima[%query] : view<64xbf16> -> bf16
  %old_maximum = scalar.extf<daz> %old_maximum_narrow : bf16 to f32
  %old_maximum_values = vector.splat %old_maximum : vector<16xf32>
  %old_sum_narrow = view.load %running_sums[%query] : view<64xbf16> -> bf16
  %old_sum = scalar.extf<daz> %old_sum_narrow : bf16 to f32
  %old_sum_values = vector.splat %old_sum : vector<16xf32>
  %old_sum_narrow_values = vector.splat %old_sum_narrow : vector<16xbf16>
  %block_maximum_values = vector.splat %block_maximum : vector<16xf32>
  %block_present = vector.cmpf ogt, %block_maximum_values, %infinities : vector<16xf32> -> vector<16xi1>
  %empty_maximum = vector.select %block_present, %block_maximum_values, %c0_vector : vector<16xf32>
  %maximum_candidate = vector.maxnumf<nnan|nsz> %old_maximum_values, %block_maximum_values : vector<16xf32>
  %old_present_for_maximum = vector.cmpf ogt, %old_sum_values, %c0_vector : vector<16xf32> -> vector<16xi1>
  %next_maximum_values = vector.select %old_present_for_maximum, %maximum_candidate, %empty_maximum : vector<16xf32>
  %old_delta = vector.subf<nnan|nsz> %old_maximum_values, %next_maximum_values : vector<16xf32>
  %scratch_offset = index.constant 19968 : offset
  %scratch = buffer.view %storage[%scratch_offset] : buffer -> view<80xf32>
  vector.store %old_delta, %scratch[0] : vector<16xf32>, view<80xf32>
  %next_maximum_narrow_values = vector.fptrunc<daz> %next_maximum_values : vector<16xf32> to vector<16xbf16>
  %next_maximum_narrow = vector.extract %next_maximum_narrow_values[0] : vector<16xbf16> -> bf16
  view.store %next_maximum_narrow, %running_maxima[%query] : bf16, view<64xbf16>
  scf.for %position = [%c0_0_2 to %c64 step %c16] {
    %input = vector.load %matrix[%query, %position] : view<64x64xbf16> -> vector<16xbf16>
    %wide = vector.extf<daz> %input : vector<16xbf16> to vector<16xf32>
    %shifted = vector.subf<nnan|nsz> %wide, %next_maximum_values : vector<16xf32>
    %output_position = index.add %position, %c16 : index
    vector.store %shifted, %scratch[%output_position] : vector<16xf32>, view<80xf32>
  }
  func.return
}

func.def noinline target(@qwen3_embedding.packed_core) @qwen3_embedding.recurrence_exp_row(%workspace: buffer) {
  // The array supplies its 64-byte-aligned tile workspace.
  %storage = buffer.assume.alignment %workspace {minimum_alignment = 64} : buffer
  %begin = index.constant 0 : index
  %end = index.constant 80 : index
  %step = index.constant 16 : index
  %scratch_offset = index.constant 19968 : offset
  %scratch = buffer.view %storage[%scratch_offset] : buffer -> view<80xf32>
  scf.for %position = [%begin to %end step %step] {
    %input = vector.load %scratch[%position] : view<80xf32> -> vector<16xf32>
    %exponent = func.call @qwen3_embedding.attention_exp(%input) : (vector<16xf32>) -> (vector<16xf32>)
    vector.store %exponent, %scratch[%position] : vector<16xf32>, view<80xf32>
  }
  func.return
}

func.def noinline target(@qwen3_embedding.packed_core) @qwen3_embedding.recurrence_finish_row(%workspace: buffer, %query: index) where [range(%query, 0, 63)] {
  // The array supplies its 64-byte-aligned tile workspace.
  %storage = buffer.assume.alignment %workspace {minimum_alignment = 64} : buffer
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 16 : index
  %matrix_offset = index.constant 0 : offset
  %sum_offset = index.constant 19200 : offset
  %scale_offset = index.constant 19328 : offset
  %inverse_offset = index.constant 19456 : offset
  %scratch_offset = index.constant 19968 : offset
  %matrix = buffer.view %storage[%matrix_offset] : buffer -> view<64x64xbf16>
  %running_sums = buffer.view %storage[%sum_offset] : buffer -> view<64xbf16>
  %scales = buffer.view %storage[%scale_offset] : buffer -> view<64xbf16>
  %inverses = buffer.view %storage[%inverse_offset] : buffer -> view<64xbf16>
  %scratch = buffer.view %storage[%scratch_offset] : buffer -> view<80xf32>
  %c0_vector = vector.splatf 0.0 : vector<16xf32>
  %narrow_zeros = vector.splatf 0.0 : vector<16xbf16>
  %c1_vector = vector.splatf 1.0 : vector<16xf32>
  %c0_value = scalar.constant 0.0 : f32
  %c1_value = scalar.constant 1.0 : f32
  %old_sum = view.load %running_sums[%query] : view<64xbf16> -> bf16
  %old_sum_values = vector.splat %old_sum : vector<16xbf16>
  %old_sum_wide = vector.extf<daz> %old_sum_values : vector<16xbf16> to vector<16xf32>
  %old_present = vector.cmpf ogt, %old_sum_wide, %c0_vector : vector<16xf32> -> vector<16xi1>
  %candidate_scale = vector.load %scratch[0] : view<80xf32> -> vector<16xf32>
  %scale = vector.select %old_present, %candidate_scale, %c0_vector : vector<16xf32>
  %scale_values = vector.fptrunc<daz> %scale : vector<16xf32> to vector<16xbf16>
  %scale_value = vector.extract %scale_values[0] : vector<16xbf16> -> bf16
  view.store %scale_value, %scales[%query] : bf16, view<64xbf16>
  %old_sum_pairs = vector.interleave<0> %old_sum_values, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %scale_pairs = vector.interleave<0> %scale_values, %narrow_zeros : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %rescaled_sum = vector.dot2f %old_sum_pairs, %scale_pairs, %c0_vector : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %sums = scf.for %position = [%begin to %end step %step](%sum = %c0_vector : vector<16xf32>) -> (vector<16xf32>) {
    %source_position = index.add %position, %step : index
    %exponent = vector.load %scratch[%source_position] : view<80xf32> -> vector<16xf32>
    %narrow = vector.fptrunc<daz> %exponent : vector<16xf32> to vector<16xbf16>
    vector.store %narrow, %matrix[%query, %position] : vector<16xbf16>, view<64x64xbf16>
    %next = vector.addf<reassoc|nnan|ninf|nsz> %sum, %exponent : vector<16xf32>
    scf.yield %next : vector<16xf32>
  }
  %block_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %sums, %c0_value : vector<16xf32>, f32
  %block_sum_values = vector.splat %block_sum : vector<16xf32>
  %next_sum = vector.addf<nnan|ninf|nsz> %rescaled_sum, %block_sum_values : vector<16xf32>
  %sum_present = vector.cmpf ogt, %next_sum, %c0_vector : vector<16xf32> -> vector<16xi1>
  %denominators = vector.select %sum_present, %next_sum, %c1_vector : vector<16xf32>
  %denominator = vector.extract %denominators[0] : vector<16xf32> -> f32
  %inverse = scalar.divf<arcp> %c1_value, %denominator : f32
  %inverse_values = vector.insert %inverse into %denominators[0] : f32, vector<16xf32>
  %inverse_narrow_values = vector.fptrunc<daz> %inverse_values : vector<16xf32> to vector<16xbf16>
  %inverse_narrow = vector.extract %inverse_narrow_values[0] : vector<16xbf16> -> bf16
  %sum_narrow_values = vector.fptrunc<daz> %next_sum : vector<16xf32> to vector<16xbf16>
  %sum_narrow = vector.extract %sum_narrow_values[0] : vector<16xbf16> -> bf16
  view.store %sum_narrow, %running_sums[%query] : bf16, view<64xbf16>
  view.store %inverse_narrow, %inverses[%query] : bf16, view<64xbf16>
  func.return
}

func.def noinline target(@qwen3_embedding.packed_core) @qwen3_embedding.online_score64(%workspace: buffer, %left_high: offset, %left_low: offset, %output_offset: offset, %output_row_base: index) where [range(%output_row_base, 0, 32)] {
  // The array supplies its 64-byte-aligned tile workspace.
  %storage = buffer.assume.alignment %workspace {minimum_alignment = 64} : buffer
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %right_high = index.constant 45696 : offset
  %right_low = index.constant 54976 : offset
  %right_stride = index.constant 1152 : offset
  %partial_offset = index.constant 9344 : offset
  %partials = buffer.view %storage[%partial_offset] : buffer -> view<4x64xf32>
  %c0_0 = vector.splatf 0.0 : vector<64xf32>
  %initial = vector.fragment<init> %c0_0 shape [%c8, %c8] : vector<64xf32>
  scf.for %panel = [%begin to %end step %c1] {
