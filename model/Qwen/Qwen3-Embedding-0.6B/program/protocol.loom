// Arrival and departure messages for the fixed pipeline's shared-row barriers.
// signal owns and publishes one 64-byte channel record; wait acquires and retires
// one record. Payload values carry no state. The composition and worker roles
// establish endpoint order so a layer retires before shared storage is reused.
func.def public inline @qwen3_embedding.signal(%channel: channel<tile<16xi32>>) {
  %c0 = vector.constant 0 : vector<16xi32>
  %write, %payload = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  vector.store %c0, %payload[0] : vector<16xi32>, view<16xi32>
  channel.publish %write : write<tile<16xi32>>
  func.return
}

func.def public inline @qwen3_embedding.wait(%channel: channel<tile<16xi32>>) {
  %read, %payload = channel.acquire %channel : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
  channel.release %read : read<tile<16xi32>>
  func.return
}
