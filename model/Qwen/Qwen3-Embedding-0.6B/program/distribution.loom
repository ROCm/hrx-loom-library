// Retained dense-weight groups for the Qwen projection schedule. A column's
// 16-record or 24-record batch stays resident while every token panel consumes
// it. The caller joins compute phases before reusing the shared SRAM backing.
// These helpers express source ownership; placement and DMA resources belong
// to the array and the compiler.
func.def public inline @qwen3_embedding.fill_weights(%input: buffer, %base: offset, %count: index, %incoming: channel<tile<4624xi32>>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %record_bytes = index.constant 18496 : offset
  scf.for %record = [%c0 to %count step %c1] unroll {
    %relative = index.scale %record, %record_bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %input[%offset] : buffer -> view<4624xi32>
    %write, %payload = channel.reserve %incoming : channel<tile<4624xi32>> -> (write<tile<4624xi32>>, view<4624xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4624xi32> to view<4624xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<4624xi32>>
  }
  func.return
}

func.def inline @qwen3_embedding.forward_weights(%read: read<tile<4624xi32>>, %row0: channel<tile<4624xi32>>, %row1: channel<tile<4624xi32>>, %row2: channel<tile<4624xi32>>, %row3: channel<tile<4624xi32>>) -> (read<tile<4624xi32>>) {
  %retained, %a, %b, %c, %d = channel.fanout %read : read<tile<4624xi32>> -> (read<tile<4624xi32>>, read<tile<4624xi32>>, read<tile<4624xi32>>, read<tile<4624xi32>>, read<tile<4624xi32>>)

  %write0, %payload0 = channel.reserve %row0 : channel<tile<4624xi32>> -> (write<tile<4624xi32>>, view<4624xi32>)
  channel.copy %a -> %write0 : read<tile<4624xi32>>, write<tile<4624xi32>>
  %write1, %payload1 = channel.reserve %row1 : channel<tile<4624xi32>> -> (write<tile<4624xi32>>, view<4624xi32>)
  channel.copy %b -> %write1 : read<tile<4624xi32>>, write<tile<4624xi32>>
  %write2, %payload2 = channel.reserve %row2 : channel<tile<4624xi32>> -> (write<tile<4624xi32>>, view<4624xi32>)
  channel.copy %c -> %write2 : read<tile<4624xi32>>, write<tile<4624xi32>>
  %write3, %payload3 = channel.reserve %row3 : channel<tile<4624xi32>> -> (write<tile<4624xi32>>, view<4624xi32>)
  channel.copy %d -> %write3 : read<tile<4624xi32>>, write<tile<4624xi32>>
  func.return %retained : read<tile<4624xi32>>
}

