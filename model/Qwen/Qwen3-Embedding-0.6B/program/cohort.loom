// The immutable prepared-input prefix retains every original sequence once.
// A small owner cursor and bounded control/row directory follow that prefix.
func.def public @request_layout(%request: buffer) -> (offset, offset, offset, offset) {
  %origin = index.constant 0 : offset
  %header = buffer.view %request[%origin] : buffer -> view<4xi64>
  %count64 = view.load %header[0] : view<4xi64> -> i64
  %tokens64 = view.load %header[2] : view<4xi64> -> i64
  %bounded_count = scalar.assume %count64 [range(%count64, 1, 9223372036854775807)] : i64
  %bounded_tokens = scalar.assume %tokens64 [range(%tokens64, 1, 9223372036854775807)] : i64
  %count = index.cast %bounded_count : i64 to index
  %tokens = index.cast %bounded_tokens : i64 to index
  %header_bytes = index.constant 32 : offset
  %record_bytes = index.constant 16 : offset
  %token_bytes = index.constant 4 : offset
  %directory_bytes = index.scale %count, %record_bytes : index, offset -> offset
  %payload_bytes = index.scale %tokens, %token_bytes : index, offset -> offset
  %directory_end = index.add %header_bytes, %directory_bytes : offset
  %prepared_bytes = index.add %directory_end, %payload_bytes : offset
  %maximum_rows = index.constant 4096 : index
  %rows = index.min %count, %maximum_rows : index
  %row_bytes = index.constant 8 : offset
  %rows_bytes = index.scale %rows, %row_bytes : index, offset -> offset
  %fixed_control_bytes = index.constant 96 : offset
  %control_bytes = index.add %fixed_control_bytes, %rows_bytes : offset
  %owner_bytes = index.constant 16 : offset
  %total, %input_offset, %owner_offset, %control_offset = buffer.pack [align(8) %prepared_bytes, align(8) %owner_bytes, align(8) %control_bytes] : offset
  func.return %total, %prepared_bytes, %owner_offset, %control_offset : offset, offset, offset, offset
}

// Each sequence is independently bounded by the model context. Select the
// next whole prefix fitting the numerical arena, without scanning later rows.
// Only successful output collection advances this logical cursor.
func.def public @select_cohort(%request: buffer, %owner_offset: offset, %control_offset: offset) {
  %origin = index.constant 0 : offset
  %header = buffer.view %request[%origin] : buffer -> view<4xi64>
  %sequence_count = view.load %header[0] : view<4xi64> -> i64
  %dimensions = view.load %header[1] : view<4xi64> -> i64
  %bounded_count = scalar.assume %sequence_count [range(%sequence_count, 1, 9223372036854775807)] : i64
  %sequences = index.cast %bounded_count : i64 to index
  %header_bytes = index.constant 32 : offset
  %directory = buffer.view %request[%header_bytes] : buffer -> view<[%sequences]x2xi64>
  %owner = buffer.view %request[%owner_offset] : buffer -> view<2xi64>
  %start64 = view.load %owner[1] : view<2xi64> -> i64
  %bounded_start = scalar.assume %start64 [range(%start64, 0, 9223372036854775807)] : i64
  %start = index.cast %bounded_start : i64 to index
  %c0 = scalar.constant 0 : i64
  %c1 = index.constant 1 : index
  %c7 = scalar.constant 7 : i64
  %mask = scalar.constant -8 : i64
  %capacity = scalar.constant 32768 : i64
  %true = scalar.constant 1 : i1
  %end, %slots, %tokens, %unused = scf.while(%sequence = %start : index, %slot_count = %c0 : i64, %token_count = %c0 : i64, %packing = %true : i1) -> (index, i64, i64, i1) {
    %within = index.cmp ult, %sequence, %sequences : index
    %more = scalar.andi %within, %packing : i1
    scf.condition %more, %sequence, %slot_count, %token_count, %packing : i1, index, i64, i64, i1
  } do(%sequence: index, %slot_count: i64, %token_count: i64, %packing: i1) {
    %row = index.assume %sequence [lt(%sequence, %sequences)] : index
    %count = view.load %directory[%row, 1] : view<[%sequences]x2xi64> -> i64
    %rounded = scalar.addi %count, %c7 : i64
    %aligned = scalar.andi %rounded, %mask : i64
    %proposed_slots = scalar.addi %slot_count, %aligned : i64
    %fits = scalar.cmpi ule, %proposed_slots, %capacity : i64
    %next_sequence = index.add %sequence, %c1 : index
    %next_tokens = scalar.addi %token_count, %count : i64
    %selected_end = scf.select %fits, %next_sequence, %sequence : index
    %selected_slots = scf.select %fits, %proposed_slots, %slot_count : i64
    %selected_tokens = scf.select %fits, %next_tokens, %token_count : i64
    scf.yield %selected_end, %selected_slots, %selected_tokens, %fits : index, i64, i64, i1
  }
  %end64 = index.cast %end : index to i64
  %row_count = scalar.subi %end64, %start64 : i64
  %rounding = scalar.constant 127 : i64
  %panel_slots = scalar.constant 128 : i64
  %rounded_slots = scalar.addi %slots, %rounding : i64
  %panels64 = scalar.divui %rounded_slots, %panel_slots : i64
  %panels = scalar.trunci %panels64 : i64 to i32
  %panel_bytes = scalar.constant 8192 : i64
  %metadata_bytes = scalar.muli %panels64, %panel_bytes : i64
  %summary = buffer.view %request[%control_offset] : buffer -> view<4xi64>
  view.store %dimensions, %summary[0] : i64, view<4xi64>
  view.store %row_count, %summary[1] : i64, view<4xi64>
  view.store %tokens, %summary[2] : i64, view<4xi64>
  view.store %metadata_bytes, %summary[3] : i64, view<4xi64>
  view.store %start64, %owner[0] : i64, view<2xi64>
  view.store %end64, %owner[1] : i64, view<2xi64>
  %record_offset = index.add %control_offset, %header_bytes : offset
  %record = buffer.view %request[%record_offset] : buffer -> view<16xi32>
  %begin = index.constant 0 : index
  %record_end = index.constant 16 : index
  %c0_i32 = scalar.constant 0 : i32
  scf.for %i = [%begin to %record_end step %c1] {
    view.store %c0_i32, %record[%i] : i32, view<16xi32>
  }
  %c1_i32 = scalar.constant 1 : i32
  %tokens32 = scalar.trunci %tokens : i64 to i32
  %rows32 = scalar.trunci %row_count : i64 to i32
  %allowance = scalar.constant 64 : i32
  view.store %c1_i32, %record[0] : i32, view<16xi32>
  view.store %c1_i32, %record[1] : i32, view<16xi32>
  view.store %rows32, %record[2] : i32, view<16xi32>
  view.store %tokens32, %record[3] : i32, view<16xi32>
  view.store %panels, %record[4] : i32, view<16xi32>
  view.store %c1_i32, %record[5] : i32, view<16xi32>
  view.store %allowance, %record[7] : i32, view<16xi32>
  view.store %c1_i32, %record[8] : i32, view<16xi32>
  func.return
}

func.decl @create_metadata(%panel_count: i32) -> (buffer)

func.decl @append_sequence(%prepared: buffer, %ordinal: i64, %metadata: buffer, %panel_count: i32, %first_slot: i32, %identity: i32) -> (i32, i64, i64)

// Metadata is uploaded once per numerical cohort. Original IDs and the
// logical cursor stay on the host; only the current request record is repeated.
func.def public @cohort_payload(%request: buffer, %owner_offset: offset, %control_offset: offset) -> (buffer) {
  %origin = index.constant 0 : offset
  %owner = buffer.view %request[%owner_offset] : buffer -> view<2xi64>
  %start = view.load %owner[0] : view<2xi64> -> i64
  %summary = buffer.view %request[%control_offset] : buffer -> view<4xi64>
  %count64 = view.load %summary[1] : view<4xi64> -> i64
  %metadata_bytes64 = view.load %summary[3] : view<4xi64> -> i64
  %bounded_count = scalar.assume %count64 [range(%count64, 1, 4096)] : i64
  %count = index.cast %bounded_count : i64 to index
  %header_bytes = index.constant 32 : offset
  %record_offset = index.add %control_offset, %header_bytes : offset
  %record = buffer.view %request[%record_offset] : buffer -> view<16xi32>
  %panels = view.load %record[4] : view<16xi32> -> i32
  %metadata = func.call @create_metadata(%panels) : (i32) -> (buffer)
  %fixed_control_bytes = index.constant 96 : offset
  %rows_offset = index.add %control_offset, %fixed_control_bytes : offset
  %rows = buffer.view %request[%rows_offset] : buffer -> view<[%count]xi64>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %slots = scf.for %i = [%c0 to %count step %c1](%slot = %c0_i32 : i32) -> (i32) {
    %ordinal = index.cast %i : index to i64
    %sequence = scalar.addi %start, %ordinal : i64
    %identity = scalar.trunci %ordinal : i64 to i32
    %next, %last, %tokens = func.call @append_sequence(%request, %sequence, %metadata, %panels, %slot, %identity) : (buffer, i64, buffer, i32, i32, i32) -> (i32, i64, i64)
    view.store %last, %rows[%i] : i64, view<[%count]xi64>
    scf.yield %next : i32
  }
  %bounded_bytes = scalar.assume %metadata_bytes64 [range(%metadata_bytes64, 8192, 2097152)] : i64
  %metadata_bytes = index.cast %bounded_bytes : i64 to offset
  %payload_bytes = index.add %fixed_control_bytes, %metadata_bytes : offset
  %payload = buffer.alloca<private> align(8) %payload_bytes : buffer
  buffer.copy %request[%control_offset], %payload[%origin], %fixed_control_bytes
  buffer.copy %metadata[%origin], %payload[%fixed_control_bytes], %metadata_bytes
  func.return %payload : buffer
}
