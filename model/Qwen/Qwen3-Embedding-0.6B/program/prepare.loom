// Embedding service v1 preparation. The card supplies parameter scope model
// and tokenizer identity text. Original checkpoint tensors load through
// policy.loom; packed projections remain immutable across executions.
// Preparation registers one command stage and returns the token-slot capacity,
// input/output byte capacities, tokenizer, display name, and private host state.
// This composition accepts an empty service-options object.

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)

func.def public @embedding_prepare_v1(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer) {
  %c0 = scalar.constant 0 : i64
  %zero32 = scalar.constant 0 : i32
  %object_type = scalar.constant 2 : i32
  %fields, %type, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %type, %object_type : i32
  %empty = scalar.cmpi eq, %count, %c0 : i64
  %valid = scalar.andi %object, %empty : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %error = buffer.constant utf8("Model options must be an empty object.") : buffer
  func.call @require(%valid32, %error) : (i32, buffer)
  %root = buffer.constant utf8("qwen3_embedding.embed") : buffer
  %stage = func.call @stage(%root, %c0) : (buffer, i64) -> (i32)
  %checkpoint = buffer.constant utf8("model") : buffer
  %policy = buffer.constant utf8("policy.loom") : buffer
  %source = func.call @source_scope(%checkpoint) : (buffer) -> (i32)
  func.call @parameter(%stage, %zero32, %zero32, %source, %policy) : (i32, i32, i32, i32, buffer)
  %origin = index.constant 0 : offset
  %state_bytes = index.constant 8 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %state_view = buffer.view %state[%origin] : buffer -> view<1xi64>
  %units = scalar.constant 128 : i64
  view.store %units, %state_view[0] : i64, view<1xi64>
  %payload = scalar.constant 8192 : i64
  %output = scalar.constant 524288 : i64
  %tokenizer = buffer.constant utf8("text") : buffer
  %name = buffer.constant utf8("Qwen3-Embedding-0.6B") : buffer
  func.return %units, %payload, %output, %output, %tokenizer, %name, %state : i64, i64, i64, i64, buffer, buffer, buffer
}
