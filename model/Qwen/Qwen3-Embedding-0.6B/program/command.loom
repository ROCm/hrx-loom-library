// The immutable parameter index contains runtime-packed projection columns,
// runtime normalization/constants, and original BF16 embedding rows. Each view
// carries its own compiler-owned placement into the native array. A request
// owns 2,924,544 bytes of mutable state; no conversion runs during inference.

pipeline.decl<kernel> @qwen3_embedding.cohort() run(%projection0: buffer, %projection1: buffer, %projection2: buffer, %projection3: buffer, %projection4: buffer, %projection5: buffer, %projection6: buffer, %projection7: buffer, %constants: buffer, %embedding: buffer, %metadata: buffer, %output: buffer, %state: buffer)

command.program.def public @qwen3_embedding.embed() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %projection0 = command.parameter %parameters, "projection.0" : view<62146560xi8>
  %projection1 = command.parameter %parameters, "projection.1" : view<62146560xi8>
  %projection2 = command.parameter %parameters, "projection.2" : view<62146560xi8>
  %projection3 = command.parameter %parameters, "projection.3" : view<62146560xi8>
  %projection4 = command.parameter %parameters, "projection.4" : view<62146560xi8>
  %projection5 = command.parameter %parameters, "projection.5" : view<62146560xi8>
  %projection6 = command.parameter %parameters, "projection.6" : view<62146560xi8>
  %projection7 = command.parameter %parameters, "projection.7" : view<62146560xi8>
  %constants = command.parameter %parameters, "constants" : view<278528xi8>
  %embedding = command.parameter %parameters, "embed_tokens.weight" : view<151669x1024xbf16>
  %state_bytes = index.constant 2924544 : offset
  %state = buffer.alloca<global> align(64) %state_bytes : buffer
  kernel.launch @qwen3_embedding.cohort(%projection0, %projection1, %projection2, %projection3, %projection4, %projection5, %projection6, %projection7, %constants, %embedding, %input, %output, %state) : (view<62146560xi8>, view<62146560xi8>, view<62146560xi8>, view<62146560xi8>, view<62146560xi8>, view<62146560xi8>, view<62146560xi8>, view<62146560xi8>, view<278528xi8>, view<151669x1024xbf16>, buffer, buffer, buffer)
  command.return
}
