// Embedding stage launch ABI: one immutable parameter index, packed request
// metadata, and output storage. The resident I8 tensor is the prepared native
// bank, not raw quantized weights. A launch owns 2,924,544 bytes of aligned
// mutable global state; the pipeline owns all local-memory/channel storage.
pipeline.decl<kernel> @qwen3_embedding.cohort() run(%weights: buffer, %metadata: buffer, %output: buffer, %state: buffer)

command.program.def public @qwen3_embedding.embed() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weights = command.parameter %parameters, "resident" : view<808069120xi8>
  %state_bytes = index.constant 2924544 : offset
  %state = buffer.alloca<global> align(64) %state_bytes : buffer
  kernel.launch @qwen3_embedding.cohort(%weights, %input, %output, %state) : (view<808069120xi8>, buffer, buffer, buffer)
  command.return
}
