  %learned_layer = index.cmp ult, %layer, %learned_layers : index
  %active_groups = scf.select %final_layer, %one, %c7 : index

  %episode_input_offset = index.scale %panel_index, %episode_input_stride : index, offset -> offset
  %episode_state_offset = index.scale %panel_index, %episode_state_stride : index, offset -> offset
  %episode_output_offset = index.scale %panel_index, %episode_output_stride : index, offset -> offset
  %reload_metadata = index.cmp eq, %dense_group, %zero : index
  scf.if %reload_metadata {
    %metadata_base = index.add %metadata_initial, %episode_input_offset : offset
    %metadata_external = buffer.view %activations[%metadata_base] : buffer -> view<4096xbf16>
    %metadata_write, %metadata_incoming = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
    %metadata_bf16 = view.bitcast %metadata_incoming : view<2048xi32> -> view<4096xbf16>
    %metadata_copy = kernel.async.copy %metadata_external to %metadata_bf16 {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
    %metadata_group = kernel.async.group %metadata_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %metadata_group {newer_groups = 0} : kernel.async.group
    %gather_metadata = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>

    scf.for %gather_token = [%zero to %c32 step %one] {
      %gather_row = index.add %gather_row_base, %gather_token : index
      %gather_id = view.load %gather_metadata[%gather_row, 0] : view<128x16xi32> -> i32
      %gather_sequence = view.load %gather_metadata[%gather_row, 1] : view<128x16xi32> -> i32
      %gather_position = view.load %gather_metadata[%gather_row, 2] : view<128x16xi32> -> i32
      %gather_live = scalar.cmpi sge, %gather_sequence, %gather_sequence_zero : i32
      %gather_selected = scf.select %gather_live, %gather_id, %gather_invalid : i32
      %gather_position16 = scalar.trunci %gather_position : i32 to i16
      view.store %gather_selected, %gather_tokens[%gather_token] : i32, view<32xi32>
      view.store %gather_position16, %gather_positions[%gather_token] : i16, view<32xi16>
    }
    channel.publish %metadata_write : write<tile<2048xi32>>
  }
  %query_key_group = index.cmp eq, %dense_group, %zero : index
  %head_group = index.cmp ult, %dense_group, %c2 : index
  %output_group = index.cmp eq, %dense_group, %c2 : index
  %down_group = index.cmp eq, %dense_group, %c6 : index
  %residual_group = scalar.ori %output_group, %down_group : i1
  %gate_or_later = index.cmp uge, %dense_group, %c3 : index
  %before_down = index.cmp ult, %dense_group, %c6 : index
  %mlp_group = scalar.andi %gate_or_later, %before_down : i1
  %post_norm_group = index.cmp eq, %dense_group, %c3 : index
  %normalize_rows = scalar.ori %query_key_group, %post_norm_group : i1
  %gather_initial = scalar.andi %initial_layer, %query_key_group : i1
  %wide_chunks = scf.select %down_group, %c24, %c16 : index
  %dense_chunks = scf.select %residual_group, %wide_chunks, %c8 : index
  %dense_roles = scf.select %residual_group, %one, %c2 : index
  %last_dense_role = index.sub %dense_roles, %one : index
  scf.if %normalize_rows {
    %row_raw = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
    %row_width = index.constant 1024 : index
    %row_bytes = index.constant 2048 : offset
    %row_slot_base = index.constant 31680 : offset
    %row_slot_stride = index.constant 16384 : offset
    %row_scale = buffer.view %peer_storage[%row_slot_base] : buffer -> view<1024xbf16>

    %row_gamma_external = buffer.view %constants[%constant_offset] : buffer -> view<4096xbf16>
    %row_gamma_write, %row_gamma_record = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
    %row_gamma_values = view.bitcast %row_gamma_record : view<2048xi32> -> view<4096xbf16>
    %row_gamma_copy = kernel.async.copy %row_gamma_external to %row_gamma_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
    %row_gamma_group = kernel.async.group %row_gamma_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %row_gamma_group {newer_groups = 0} : kernel.async.group
    %input_gamma_word = index.constant 256 : index
    %post_gamma_word = index.constant 1280 : index
    %gamma_word = scf.select %query_key_group, %input_gamma_word, %post_gamma_word : index
    %row_gamma_selected = view.subview %row_gamma_values[%gamma_word] : view<4096xbf16> -> view<1024xbf16>
    scf.for %word = [%zero to %row_width step %vector_step] {
      %value = vector.load %row_gamma_selected[%word] : view<1024xbf16> -> vector<32xbf16>
      vector.store %value, %row_scale[%word] : vector<32xbf16>, view<1024xbf16>
    }
    channel.publish %row_gamma_write : write<tile<2048xi32>>
    scf.for %row_record = [%zero to %c8 step %one] {
      %row_input_write, %row_input_record = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
      %row_input_values = view.bitcast %row_input_record : view<2048xi32> -> view<4096xbf16>

      %row_input_base = index.add %row_input_initial, %episode_state_offset : offset
      %row_input_relative = index.scale %row_record, %record_stride : index, offset -> offset
      %row_input_address = index.add %row_input_base, %row_input_relative : offset
      %row_input_external = buffer.view %state[%row_input_address] : buffer -> view<4096xbf16>
      scf.if %gather_initial {
        %gather_rows = view.bitcast %row_input_values : view<4096xbf16> -> view<4x1024xbf16>
        %gather_record_base = index.mul %row_record, %c4 : index
        %gather_embedding_base = index.constant 0 : offset
        %gather_embedding_stride = index.constant 2048 : offset
        %gather_width = index.constant 1024 : index
        %gather_vector_step = index.constant 32 : index
        %gather_zeros = vector.splatf 0.0 : vector<32xbf16>
        scf.for %gather_member = [%zero to %c4 step %one] {
          %gather_token = index.add %gather_record_base, %gather_member : index
          %gather_id = view.load %gather_tokens[%gather_token] : view<32xi32> -> i32
          %gather_live = scalar.cmpi sge, %gather_id, %gather_sequence_zero : i32
          %gather_row = view.subview %gather_rows[%gather_member, 0] : view<4x1024xbf16> -> view<1x1024xbf16>
          %gather_destination = view.bitcast %gather_row : view<1x1024xbf16> -> view<1024xbf16>
          scf.if %gather_live {
            %gather_bounded = scalar.assume %gather_id [range(%gather_id, 0, 151668)] : i32
            %gather_index = index.cast %gather_bounded : i32 to index
            %gather_relative = index.scale %gather_index, %gather_embedding_stride : index, offset -> offset
            %gather_address = index.add %gather_embedding_base, %gather_relative : offset
            %gather_external = buffer.view %embedding[%gather_address] : buffer -> view<1024xbf16>
            %gather_embedding_copy = kernel.async.copy %gather_external to %gather_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1024xbf16> to view<1024xbf16> -> kernel.async.token
            %gather_embedding_group = kernel.async.group %gather_embedding_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %gather_embedding_group {newer_groups = 0} : kernel.async.group
          } else {
            scf.for %gather_element = [%zero to %gather_width step %gather_vector_step] {
              vector.store %gather_zeros, %gather_destination[%gather_element] : vector<32xbf16>, view<1024xbf16>
            }
          }
        }
        %persist_embedding_copy = kernel.async.copy %row_input_values to %row_input_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
        %persist_embedding_group = kernel.async.group %persist_embedding_copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %persist_embedding_group {newer_groups = 0} : kernel.async.group
      } else {
        %row_input_copy = kernel.async.copy %row_input_external to %row_input_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
        %row_input_group = kernel.async.group %row_input_copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %row_input_group {newer_groups = 0} : kernel.async.group
      }
      %owns_rows = index.cmp eq, %row_record, %row_column : index
      scf.if %owns_rows {
        func.call @qwen3_embedding.shared_copy_output(%row_input_values, %row_raw) : (view<4096xbf16>, view<4096xbf16>)
      }
      channel.publish %row_input_write : write<tile<2048xi32>>
    }
    func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
    scf.for %row_member = [%zero to %c2 step %one] {
      %slot_relative = index.scale %row_member, %row_slot_stride : index, offset -> offset
      %slot = index.add %row_slot_base, %slot_relative : offset
      %member_rows = buffer.view %local_storage[%slot] : buffer -> view<4x1024xbf16>
      scf.for %row_token = [%zero to %c4 step %one] {
        %token_relative = index.scale %row_token, %row_bytes : index, offset -> offset
        %token_offset = index.add %slot, %token_relative : offset
        %row_values = buffer.view %local_storage[%token_offset] : buffer -> view<1024xbf16>
        func.call @qwen3_embedding.shared_normalize_shared(%row_values, %row_scale) : (view<1024xbf16>, view<1024xbf16>)
      }
    }
    func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
    %row_records = scf.select %final_layer, %c4, %c2 : index
    scf.for %output_record = [%zero to %row_records step %one] {
      %row_read, %row_source = channel.acquire<mutable> %normalization_stream : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>, mutable>, view<4096xbf16>)
      scf.if %learned_layer {
        %slot_relative = index.scale %output_record, %row_slot_stride : index, offset -> offset
        %slot = index.add %row_slot_base, %slot_relative : offset
        %member_rows = buffer.view %local_storage[%slot] : buffer -> view<4x1024xbf16>
        %row_blocked = view.bitcast %row_source : view<4096xbf16> -> view<128x4x8xbf16>
        func.call @qwen3_embedding.shared_block_four_rows(%member_rows, %row_blocked) : (view<4x1024xbf16>, view<128x4x8xbf16>)
      }
      scf.if %final_layer {
        %output_member = index.div %output_record, %c2 : index
        %output_half = index.rem %output_record, %c2 : index
        %output_token_base = index.mul %output_half, %c2 : index
        %output_slot_relative = index.scale %output_member, %row_slot_stride : index, offset -> offset
        %output_slot = index.add %row_slot_base, %output_slot_relative : offset
        %output_rows = buffer.view %local_storage[%output_slot] : buffer -> view<4x1024xbf16>
        %output_values = view.bitcast %row_source : view<4096xbf16> -> view<2x1024xf32>
        scf.for %output_token = [%zero to %c2 step %one] {
          %source_token = index.add %output_token_base, %output_token : index
          %source_row = view.subview %output_rows[%source_token, 0] : view<4x1024xbf16> -> view<1x1024xbf16>
          %source_values = view.bitcast %source_row : view<1x1024xbf16> -> view<1024xbf16>
          %target_row = view.subview %output_values[%output_token, 0] : view<2x1024xf32> -> view<1x1024xf32>
          %target_values = view.bitcast %target_row : view<1x1024xf32> -> view<1024xf32>
          %dimension_count = view.load %dimensions[%output_member, %source_token] : view<2x4xi32> -> i32
          %prefix_width = index.constant 1024 : index
          %prefix_floor = scalar.constant 9.9999999999999992e-25 : f32
          %prefix_source = view.refine %source_values : view<1024xbf16> -> view<[%prefix_width]xbf16>
          %prefix_target = view.refine %target_values : view<1024xf32> -> view<[%prefix_width]xf32>
          template.apply<@normalization.l2_prefix_bf16>(%prefix_width, %dimension_count, %prefix_floor, %prefix_source, %prefix_target) : (index, i32, f32, view<[%prefix_width]xbf16>, view<[%prefix_width]xf32>)
        }

        %finish_member = index.div %output_record, %c2 : index
        %finish_half = index.rem %output_record, %c2 : index
        %finish_half_bytes = index.scale %finish_half, %record_stride : index, offset -> offset
        %finish_member_stride = index.constant 131072 : offset
        %finish_member_bytes = index.scale %finish_member, %finish_member_stride : index, offset -> offset

        %finish_base = index.add %finish_initial, %finish_member_bytes : offset
        %finish_relative = index.add %finish_base, %finish_half_bytes : offset
        %finish_address = index.add %finish_relative, %episode_output_offset : offset
        %finish_external = buffer.view %output[%finish_address] : buffer -> view<4096xbf16>
        %finish_copy = kernel.async.copy %row_source to %finish_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
        %finish_group = kernel.async.group %finish_copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %finish_group {newer_groups = 0} : kernel.async.group
      } else {

        %normalized_relative = index.scale %output_record, %record_stride : index, offset -> offset
        %normalized_base = index.add %normalized_initial, %episode_state_offset : offset
        %normalized_address = index.add %normalized_base, %normalized_relative : offset
        %normalized_external = buffer.view %state[%normalized_address] : buffer -> view<8x16x32xbf16, #encoding.layout.strided<strides=[16384, 256, 1]>>
        %normalized_local = view.bitcast %row_source : view<4096xbf16> -> view<8x16x32xbf16>
        %normalized_copy = kernel.async.copy %normalized_local to %normalized_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8x16x32xbf16> to view<8x16x32xbf16, #encoding.layout.strided<strides=[16384, 256, 1]>> -> kernel.async.token
        %normalized_group = kernel.async.group %normalized_copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %normalized_group {newer_groups = 0} : kernel.async.group
      }
      channel.release %row_read : read<tile<4096xbf16>, mutable>
    }
    func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
  }
  scf.if %learned_layer {
    %dense_residual_initial = scf.select %output_group, %dense_context_initial, %dense_mlp_initial : offset
    %dense_input_initial = scf.select %residual_group, %dense_residual_initial, %dense_normalized_initial : offset
    %dense_input_base = index.add %dense_input_initial, %episode_state_offset : offset
    %initial_input_relative = index.scale %zero, %dense_input_stride : index, offset -> offset
    %initial_input_address = index.add %dense_input_base, %initial_input_relative : offset
    %initial_input_external = buffer.view %state[%initial_input_address] : buffer -> view<4096xbf16>
    %initial_input_write, %initial_input_view = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
    %initial_input_values = view.bitcast %initial_input_view : view<2048xi32> -> view<4096xbf16>
    %initial_input_copy = kernel.async.copy %initial_input_external to %initial_input_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
    %initial_input_group = kernel.async.group %initial_input_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %initial_input_group {newer_groups = 0} : kernel.async.group
    // Raw storage is reusable after fanout; packed activations remain live
    // through this chunk's compute while the next raw record arrives.
    %last_dense_chunk, %completed_chunks = scf.while(%chunk_index = %zero : index, %ready_input = %initial_input_write : write<tile<2048xi32>>) -> (index, index) {
      %dense_chunk = index.assume %chunk_index [range(%chunk_index, 0, 23)] : index
      func.call @qwen3_embedding.pack_dense_activations(%local_storage, %activation_offset) : (buffer, offset)
      channel.publish %ready_input : write<tile<2048xi32>>
      %next_chunk = index.add %dense_chunk, %one : index
      %more_chunks = index.cmp ult, %next_chunk, %dense_chunks : index
      scf.condition %more_chunks, %dense_chunk, %next_chunk : i1, index, index
    } do(%current_chunk: index, %following_chunk: index) {
      %next_dense_chunk = index.assume %following_chunk [range(%following_chunk, 1, 23)] : index
      %first_dense_chunk = index.cmp eq, %current_chunk, %zero : index
      %two_roles = index.cmp ugt, %dense_roles, %one : index
      scf.if %two_roles {
        %first_weight, %first_values = channel.acquire<mutable> %weight_stream : channel<tile<4624xi32>> -> (read<tile<4624xi32>, mutable>, view<4624xi32>)
        %first_projection_weights_offset = index.constant 0 : offset
        %first_projection_activations_offset = index.constant 27008 : offset
        %first_projection_operand_storage = buffer.assume.alignment %local_storage {minimum_alignment = 64} : buffer
        %first_projection_weights = buffer.view %first_projection_operand_storage[%first_projection_weights_offset] : buffer -> view<16x2x576xi8>
        %first_projection_packed_activations = buffer.view %first_projection_operand_storage[%first_projection_activations_offset] : buffer -> view<2x4x576xi8>
        %first_projection_primary = buffer.view %first_projection_operand_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
        %first_projection_use_secondary = scalar.constant 0 : i1
        func.call @qwen3_embedding.dense_accumulate(%first_projection_weights, %first_projection_packed_activations, %first_projection_primary, %first_projection_primary, %first_projection_use_secondary, %first_dense_chunk) : (view<16x2x576xi8>, view<2x4x576xi8>, view<16x4x64xf32>, view<16x4x64xf32>, i1, i1)
        channel.release %first_weight : read<tile<4624xi32>, mutable>
      }
      %next_input_relative = index.scale %next_dense_chunk, %dense_input_stride : index, offset -> offset
      %next_input_address = index.add %dense_input_base, %next_input_relative : offset
      %next_input_external = buffer.view %state[%next_input_address] : buffer -> view<4096xbf16>
      %next_input_write, %next_input_view = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
      %next_input_values = view.bitcast %next_input_view : view<2048xi32> -> view<4096xbf16>
      %next_input_copy = kernel.async.copy %next_input_external to %next_input_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
      %next_input_group = kernel.async.group %next_input_copy : kernel.async.token -> kernel.async.group
      %last_weight, %last_values = channel.acquire<mutable> %weight_stream : channel<tile<4624xi32>> -> (read<tile<4624xi32>, mutable>, view<4624xi32>)
      %last_projection_weights_offset = index.constant 0 : offset
      %last_projection_activations_offset = index.constant 27008 : offset
      %last_projection_operand_storage = buffer.assume.alignment %local_storage {minimum_alignment = 64} : buffer
      %last_projection_weights = buffer.view %last_projection_operand_storage[%last_projection_weights_offset] : buffer -> view<16x2x576xi8>
      %last_projection_packed_activations = buffer.view %last_projection_operand_storage[%last_projection_activations_offset] : buffer -> view<2x4x576xi8>
      %last_projection_primary = buffer.view %last_projection_operand_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
      %last_projection_peer_storage = buffer.assume.alignment %peer_storage {minimum_alignment = 64} : buffer
      %last_projection_secondary = buffer.view %last_projection_peer_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
      func.call @qwen3_embedding.dense_accumulate(%last_projection_weights, %last_projection_packed_activations, %last_projection_primary, %last_projection_secondary, %two_roles, %first_dense_chunk) : (view<16x2x576xi8>, view<2x4x576xi8>, view<16x4x64xf32>, view<16x4x64xf32>, i1, i1)
      channel.release %last_weight : read<tile<4624xi32>, mutable>
      kernel.async.wait %next_input_group {newer_groups = 0} : kernel.async.group
      scf.yield %next_dense_chunk, %next_input_write : index, write<tile<2048xi32>>
    }
    %group_last_read = func.call @qwen3_embedding.ingress_dense_chunk(%local_storage, %peer_storage, %weight_stream, %dense_result_offset, %last_dense_chunk, %dense_roles) : (buffer, buffer, channel<tile<4624xi32>>, offset, index, index) -> (read<tile<4624xi32>, mutable>)
    %head_records = scf.select %head_group, %c2, %one : index
    %preparation_records = scf.select %residual_group, %c8, %head_records : index
    scf.for %record = [%zero to %preparation_records step %one] {
      %first_record = index.cmp eq, %record, %zero : index
      %preparation_write, %preparation_incoming = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
      %preparation_values = view.bitcast %preparation_incoming : view<2048xi32> -> view<4096xbf16>
      %later_record = index.cmp ne, %record, %zero : index
      %state_input = scalar.ori %residual_group, %later_record : i1
      scf.if %state_input {
        %record_relative = index.scale %record, %record_stride : index, offset -> offset

        %skip_address = index.add %skip_initial, %record_relative : offset

        %state_relative = scf.select %residual_group, %skip_address, %rotary_address : offset
        %address = index.add %state_relative, %episode_state_offset : offset
        %external = buffer.view %state[%address] : buffer -> view<4096xbf16>
        scf.if %gather_initial {
          %gather_rope_base = index.constant 245760 : offset
          %gather_rope_stride = index.constant 256 : offset
          %gather_rope_rows = view.bitcast %preparation_values : view<4096xbf16> -> view<32x128xbf16>
          scf.for %gather_token = [%zero to %c32 step %one] {
            %gather_position16 = view.load %gather_positions[%gather_token] : view<32xi16> -> i16
            %gather_position32 = scalar.extui %gather_position16 : i16 to i32
            %gather_bounded = scalar.assume %gather_position32 [range(%gather_position32, 0, 32767)] : i32
            %gather_position = index.cast %gather_bounded : i32 to index
            %gather_relative = index.scale %gather_position, %gather_rope_stride : index, offset -> offset
            %gather_address = index.add %gather_rope_base, %gather_relative : offset
            %gather_external = buffer.view %constants[%gather_address] : buffer -> view<128xbf16>
            %gather_row = view.subview %gather_rope_rows[%gather_token, 0] : view<32x128xbf16> -> view<1x128xbf16>
            %gather_destination = view.bitcast %gather_row : view<1x128xbf16> -> view<128xbf16>
            %gather_rotary_copy = kernel.async.copy %gather_external to %gather_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<128xbf16> to view<128xbf16> -> kernel.async.token
            %gather_rotary_group = kernel.async.group %gather_rotary_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %gather_rotary_group {newer_groups = 0} : kernel.async.group
          }
          %persist_rotary_copy = kernel.async.copy %preparation_values to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
          %persist_rotary_group = kernel.async.group %persist_rotary_copy : kernel.async.token -> kernel.async.group
          kernel.async.wait %persist_rotary_group {newer_groups = 0} : kernel.async.group
        } else {
          %copy = kernel.async.copy %external to %preparation_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
          %completion = kernel.async.group %copy : kernel.async.token -> kernel.async.group
          kernel.async.wait %completion {newer_groups = 0} : kernel.async.group
        }
      } else {
        %silu_address = index.constant 237568 : offset
        %address = scf.select %head_group, %constant_offset, %silu_address : offset
        %external = buffer.view %constants[%address] : buffer -> view<4096xbf16>
        %copy = kernel.async.copy %external to %preparation_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
        %completion = kernel.async.group %copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %completion {newer_groups = 0} : kernel.async.group
      }
      scf.if %head_group {
        scf.if %first_record {
          scf.for %word = [%zero to %scale_words step %vector_step] {
            %value = vector.load %preparation_values[%word] : view<4096xbf16> -> vector<32xbf16>
            vector.store %value, %dense_scales[%word] : vector<32xbf16>, view<256xbf16>
          }
        } else {
          func.call @qwen3_embedding.shared_copy_output(%preparation_values, %dense_rope_bits) : (view<4096xbf16>, view<4096xbf16>)
        }
      } else {
        scf.if %residual_group {

          %skip_rows = view.bitcast %dense_secondary_bits : view<4096xbf16> -> view<32x128xbf16>
          func.call @qwen3_embedding.shared_retain_residual_panel(%preparation_values, %skip_rows, %record, %skip_column) : (view<4096xbf16>, view<32x128xbf16>, index, index)
        } else {
          func.call @qwen3_embedding.shared_copy_output(%preparation_values, %raw) : (view<4096xbf16>, view<4096xbf16>)
        }
      }
      channel.publish %preparation_write : write<tile<2048xi32>>
    }
    func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
    func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
    scf.if %mlp_group {
      %lookup_source = buffer.view %local_storage[%origin] : buffer -> view<4096xbf16>
      %lookup_ab = buffer.view %peer_storage[%origin] : buffer -> view<8192xbf16>
      %lookup_cd = buffer.view %local_storage[%origin] : buffer -> view<8192xbf16>
      func.call @qwen3_embedding.shared_prepare_silu_lookup(%lookup_source, %lookup_ab, %lookup_cd) : (view<4096xbf16>, view<8192xbf16>, view<8192xbf16>)
    }
    func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
    %epilogue_roles = scf.select %head_group, %c2, %one : index
    scf.for %projection_role = [%zero to %epilogue_roles step %one] {
      %first_projection = index.cmp eq, %projection_role, %zero : index
      %normalize_projection = scalar.ori %first_projection, %query_key_group : i1
      %head_normalization = scalar.andi %head_group, %normalize_projection : i1
      scf.for %member = [%zero to %c2 step %one] {
        %head_read, %head_source = channel.acquire<mutable> %projection_stream : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>, mutable>, view<4096xbf16>)
        scf.if %residual_group {
          %skip_member_stride = index.constant 16384 : offset
          %skip_member_base = index.constant 31680 : offset
          %skip_member_relative = index.scale %member, %skip_member_stride : index, offset -> offset
          %skip_member_offset = index.add %skip_member_base, %skip_member_relative : offset
          %skip_member = buffer.view %peer_storage[%skip_member_offset] : buffer -> view<4096xbf16>
          func.call @qwen3_embedding.shared_dense_residual(%head_source, %skip_member) : (view<4096xbf16>, view<4096xbf16>)
        }
        scf.if %head_group {
          scf.if %normalize_projection {

            %query_stride = index.constant 131072 : offset
            %query_relative = index.scale %dense_group, %query_stride : index, offset -> offset
            %query_offset = index.add %query_initial, %query_relative : offset
            %head_initial = scf.select %first_projection, %query_offset, %key_initial : offset
            %head_row_stride = index.constant 8192 : offset
            %head_relative = index.scale %member, %head_row_stride : index, offset -> offset
            %head_base = index.add %head_initial, %episode_state_offset : offset
            %head_address = index.add %head_base, %head_relative : offset
            %head_external = buffer.view %state[%head_address] : buffer -> view<4096xbf16>
            %head_copy = kernel.async.copy %head_source to %head_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %head_group = kernel.async.group %head_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %head_group {newer_groups = 0} : kernel.async.group
          } else {

            %value_row_stride = index.constant 512 : offset
            %value_relative = index.scale %member, %value_row_stride : index, offset -> offset
            %value_base = index.add %value_initial, %episode_state_offset : offset
            %value_address = index.add %value_base, %value_relative : offset
            %value_external = buffer.view %state[%value_address] : buffer -> view<16x4x64xbf16, #encoding.layout.strided<strides=[1024, 64, 1]>>
            %value_local = view.bitcast %head_source : view<4096xbf16> -> view<16x4x64xbf16>
            %value_copy = kernel.async.copy %value_local to %value_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16x4x64xbf16> to view<16x4x64xbf16, #encoding.layout.strided<strides=[1024, 64, 1]>> -> kernel.async.token
            %value_group = kernel.async.group %value_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %value_group {newer_groups = 0} : kernel.async.group
          }
        } else {
          scf.if %mlp_group {
            %mlp_panel_unbounded = index.sub %dense_group, %c3 : index
            %mlp_panel = index.assume %mlp_panel_unbounded [range(%mlp_panel_unbounded, 0, 2)] : index
            %mlp_panel_stride = index.constant 262144 : offset
            %mlp_panel_relative = index.scale %mlp_panel, %mlp_panel_stride : index, offset -> offset

            %mlp_base = index.add %mlp_initial, %episode_state_offset : offset
            %mlp_panel_base = index.add %mlp_base, %mlp_panel_relative : offset
            %mlp_row_relative = index.scale %member, %record_stride : index, offset -> offset
            %mlp_address = index.add %mlp_panel_base, %mlp_row_relative : offset
            %mlp_external = buffer.view %state[%mlp_address] : buffer -> view<4096xbf16>
            %mlp_output_copy = kernel.async.copy %head_source to %mlp_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %mlp_output_completion = kernel.async.group %mlp_output_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %mlp_output_completion {newer_groups = 0} : kernel.async.group
          } else {
            %residual_row_stride = index.constant 65536 : offset
            %residual_row_relative = index.scale %member, %residual_row_stride : index, offset -> offset
            %residual_local = view.bitcast %head_source : view<4096xbf16> -> view<32x128xbf16>

            %residual_base = index.add %residual_initial, %episode_state_offset : offset
            %residual_address = index.add %residual_base, %residual_row_relative : offset
            %residual_external = buffer.view %state[%residual_address] : buffer -> view<32x128xbf16, #encoding.layout.strided<strides=[1024, 1]>>
            %residual_output_copy = kernel.async.copy %residual_local to %residual_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<32x128xbf16> to view<32x128xbf16, #encoding.layout.strided<strides=[1024, 1]>> -> kernel.async.token
            %residual_output_completion = kernel.async.group %residual_output_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %residual_output_completion {newer_groups = 0} : kernel.async.group
          }
        }
        channel.release %head_read : read<tile<4096xbf16>, mutable>
      }

      %next_projection = index.add %projection_role, %one : index

      %later_projection = index.cmp ult, %next_projection, %epilogue_roles : index

      scf.if %later_projection {
        func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
        func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
        func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
        func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
      }
    }

    channel.release %group_last_read : read<tile<4624xi32>, mutable>
  }
  func.return
}

// Gathers an interior token row group and participates in both barrier directions.
func.def public inline @qwen3_embedding.query_key_ingress(%sequence_storage: buffer, %origin: offset, %local_storage: buffer, %result_offset: offset, %peer_storage: buffer, %gather_storage: buffer, %activations: buffer, %activation_stream: channel<tile<2048xi32>>, %zero: index, %one: index, %constants: buffer, %embedding: buffer, %state: buffer, %incoming_arrival: channel<tile<16xi32>>, %outgoing_arrival: channel<tile<16xi32>>, %incoming_departure: channel<tile<16xi32>>, %outgoing_departure: channel<tile<16xi32>>, %projection_stream: channel<tile<4096xbf16>>, %output: buffer, %weight_stream: channel<tile<4624xi32>>, %activation_offset: offset, %probability_stream: channel<tile<4096xbf16>>, %result_stream: channel<tile<4096xbf16>>, %layer: index, %dense_group: index, %panel_index: index) {
  %sequence_ids = buffer.view %sequence_storage[%origin] : buffer -> view<128xi32>
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %capacity = index.constant 128 : index
  %chunk_words = index.constant 512 : index
  %vector_step = index.constant 32 : index
  %record_stride = index.constant 8192 : offset
  %episode_input_stride = index.constant 8192 : offset
  %episode_output_stride = index.constant 524288 : offset
  %column_offset = index.constant 2048 : index
  %identity_offset = index.constant 27008 : offset
  %temporary_offset = index.constant 10368 : offset
  %scores_offset = index.constant 9344 : offset
  %packed_low = index.constant 4672 : offset
  %right_high = index.constant 27136 : offset
  %right_low = index.constant 45632 : offset
  %right_stride = index.constant 1152 : offset
  %right_count = scalar.constant 16 : i32
  %left_count = scalar.constant 64 : i32
  %identity = buffer.view %local_storage[%identity_offset] : buffer -> view<8x8xbf16>
  %temporary = buffer.view %local_storage[%temporary_offset] : buffer -> view<8x8xf32>
  %scores = buffer.view %local_storage[%scores_offset] : buffer -> view<128xf32>
  %raw = buffer.view %local_storage[%origin] : buffer -> view<4096xbf16>
  %raw_matrix = buffer.view %local_storage[%origin] : buffer -> view<32x128xbf16>
  %blocked = buffer.view %local_storage[%result_offset] : buffer -> view<4096xbf16>

  %dense_input_stride = index.constant 32768 : offset
  %dense_packed_offset = index.constant 27008 : offset
  %dense_result_offset = index.constant 31680 : offset
  %dense_primary = buffer.view %local_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_secondary = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_primary_bits = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_secondary_bits = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_blocked_values = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<16x4x64xbf16>
  %dense_scale_offset = index.constant 8192 : offset
  %dense_scale_stride = index.constant 256 : offset
  %dense_rope_offset = index.constant 8704 : offset
  %dense_scales = buffer.view %local_storage[%dense_scale_offset] : buffer -> view<256xbf16>
  %dense_rope_bits = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<4096xbf16>
  %dense_rope = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<32x2x64xbf16>
  %scale_words = index.constant 256 : index
  %episode_state_stride = index.constant 3989504 : offset
  %c3 = index.constant 3 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c16 = index.constant 16 : index
  %c24 = index.constant 24 : index
  %layers = index.constant 29 : index
  %learned_layers = index.constant 28 : index
  %gather_position_offset = index.constant 128 : offset
  %gather_tokens = buffer.view %gather_storage[%origin] : buffer -> view<32xi32>
  %gather_positions = buffer.view %gather_storage[%gather_position_offset] : buffer -> view<32xi16>
  %metadata_initial = index.constant 0 : offset
  %gather_row_base = index.constant 64 : index
  %gather_invalid = scalar.constant -1 : i32
  %gather_sequence_zero = scalar.constant 0 : i32

  %initial_layer = index.cmp eq, %layer, %zero : index
  %constant_base = index.constant 0 : offset
  %constant_stride = index.constant 8192 : offset
  %constant_relative = index.scale %layer, %constant_stride : index, offset -> offset
  %constant_offset = index.add %constant_base, %constant_relative : offset
  %final_layer = index.cmp eq, %layer, %learned_layers : index
  %learned_layer = index.cmp ult, %layer, %learned_layers : index
  %active_groups = scf.select %final_layer, %one, %c7 : index

  %episode_input_offset = index.scale %panel_index, %episode_input_stride : index, offset -> offset
  %episode_state_offset = index.scale %panel_index, %episode_state_stride : index, offset -> offset
  %episode_output_offset = index.scale %panel_index, %episode_output_stride : index, offset -> offset
  %reload_metadata = index.cmp eq, %dense_group, %zero : index
  scf.if %reload_metadata {
    %metadata_base = index.add %metadata_initial, %episode_input_offset : offset
    %metadata_external = buffer.view %activations[%metadata_base] : buffer -> view<4096xbf16>
    %metadata_write, %metadata_incoming = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
    %metadata_bf16 = view.bitcast %metadata_incoming : view<2048xi32> -> view<4096xbf16>
    %metadata_copy = kernel.async.copy %metadata_external to %metadata_bf16 {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
    %metadata_group = kernel.async.group %metadata_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %metadata_group {newer_groups = 0} : kernel.async.group
    %metadata_rows = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>
    scf.for %token = [%zero to %capacity step %one] {
      %sequence = view.load %metadata_rows[%token, 1] : view<128x16xi32> -> i32
      view.store %sequence, %sequence_ids[%token] : i32, view<128xi32>
    }
    %gather_metadata = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>
    scf.for %gather_token = [%zero to %c32 step %one] {
      %gather_row = index.add %gather_row_base, %gather_token : index
      %gather_id = view.load %gather_metadata[%gather_row, 0] : view<128x16xi32> -> i32
      %gather_sequence = view.load %gather_metadata[%gather_row, 1] : view<128x16xi32> -> i32
      %gather_position = view.load %gather_metadata[%gather_row, 2] : view<128x16xi32> -> i32
      %gather_live = scalar.cmpi sge, %gather_sequence, %gather_sequence_zero : i32
      %gather_selected = scf.select %gather_live, %gather_id, %gather_invalid : i32
      %gather_position16 = scalar.trunci %gather_position : i32 to i16
      view.store %gather_selected, %gather_tokens[%gather_token] : i32, view<32xi32>
      view.store %gather_position16, %gather_positions[%gather_token] : i16, view<32xi16>
    }
    channel.publish %metadata_write : write<tile<2048xi32>>
  }
  %query_key_group = index.cmp eq, %dense_group, %zero : index
  %head_group = index.cmp ult, %dense_group, %c2 : index
  %output_group = index.cmp eq, %dense_group, %c2 : index
  %down_group = index.cmp eq, %dense_group, %c6 : index
  %residual_group = scalar.ori %output_group, %down_group : i1
  %gate_or_later = index.cmp uge, %dense_group, %c3 : index
  %before_down = index.cmp ult, %dense_group, %c6 : index
  %mlp_group = scalar.andi %gate_or_later, %before_down : i1
  %post_norm_group = index.cmp eq, %dense_group, %c3 : index
  %normalize_rows = scalar.ori %query_key_group, %post_norm_group : i1
  %gather_initial = scalar.andi %initial_layer, %query_key_group : i1
  %wide_chunks = scf.select %down_group, %c24, %c16 : index
  %dense_chunks = scf.select %residual_group, %wide_chunks, %c8 : index
  %dense_roles = scf.select %residual_group, %one, %c2 : index
  %last_dense_role = index.sub %dense_roles, %one : index
  scf.if %normalize_rows {
    %row_raw = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
    %row_width = index.constant 1024 : index
    %row_bytes = index.constant 2048 : offset
    %row_slot_base = index.constant 31680 : offset
    %row_slot_stride = index.constant 16384 : offset
    %row_scale = buffer.view %peer_storage[%row_slot_base] : buffer -> view<1024xbf16>
    %row_column = index.constant 4 : index
    %row_gamma_external = buffer.view %constants[%constant_offset] : buffer -> view<4096xbf16>
    %row_gamma_write, %row_gamma_record = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
    %row_gamma_values = view.bitcast %row_gamma_record : view<2048xi32> -> view<4096xbf16>
    %row_gamma_copy = kernel.async.copy %row_gamma_external to %row_gamma_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
    %row_gamma_group = kernel.async.group %row_gamma_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %row_gamma_group {newer_groups = 0} : kernel.async.group
    %input_gamma_word = index.constant 256 : index
    %post_gamma_word = index.constant 1280 : index
    %gamma_word = scf.select %query_key_group, %input_gamma_word, %post_gamma_word : index
    %row_gamma_selected = view.subview %row_gamma_values[%gamma_word] : view<4096xbf16> -> view<1024xbf16>
    scf.for %word = [%zero to %row_width step %vector_step] {
      %value = vector.load %row_gamma_selected[%word] : view<1024xbf16> -> vector<32xbf16>
      vector.store %value, %row_scale[%word] : vector<32xbf16>, view<1024xbf16>
    }
    channel.publish %row_gamma_write : write<tile<2048xi32>>
    scf.for %row_record = [%zero to %c8 step %one] {
      %row_input_write, %row_input_record = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
      %row_input_values = view.bitcast %row_input_record : view<2048xi32> -> view<4096xbf16>
      %row_input_initial = index.constant 2760704 : offset
      %row_input_base = index.add %row_input_initial, %episode_state_offset : offset
      %row_input_relative = index.scale %row_record, %record_stride : index, offset -> offset
      %row_input_address = index.add %row_input_base, %row_input_relative : offset
      %row_input_external = buffer.view %state[%row_input_address] : buffer -> view<4096xbf16>
      scf.if %gather_initial {
        %gather_rows = view.bitcast %row_input_values : view<4096xbf16> -> view<4x1024xbf16>
        %gather_record_base = index.mul %row_record, %c4 : index
        %gather_embedding_base = index.constant 0 : offset
        %gather_embedding_stride = index.constant 2048 : offset
        %gather_width = index.constant 1024 : index
        %gather_vector_step = index.constant 32 : index
        %gather_zeros = vector.splatf 0.0 : vector<32xbf16>
        scf.for %gather_member = [%zero to %c4 step %one] {
          %gather_token = index.add %gather_record_base, %gather_member : index
          %gather_id = view.load %gather_tokens[%gather_token] : view<32xi32> -> i32
          %gather_live = scalar.cmpi sge, %gather_id, %gather_sequence_zero : i32
          %gather_row = view.subview %gather_rows[%gather_member, 0] : view<4x1024xbf16> -> view<1x1024xbf16>
          %gather_destination = view.bitcast %gather_row : view<1x1024xbf16> -> view<1024xbf16>
          scf.if %gather_live {
            %gather_bounded = scalar.assume %gather_id [range(%gather_id, 0, 151668)] : i32
            %gather_index = index.cast %gather_bounded : i32 to index
