        channel.release %head_read : read<tile<4096xbf16>>
      }

      %next_projection = index.add %projection_role, %one : index

      %later_projection = index.cmp ult, %next_projection, %epilogue_roles : index

      scf.if %later_projection {
        func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
        func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
        func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
        func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
      }
    }

    channel.release %group_last_read : read<tile<4624xi32>, mutable>
  }
  func.return
}
