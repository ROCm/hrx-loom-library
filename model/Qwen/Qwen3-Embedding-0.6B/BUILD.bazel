load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/Qwen/Qwen3-Embedding-0.6B/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_PROGRAM_SOURCES = {
    "array": "array.loom",
    "command": "command.loom",
    "constants": "constants.loom",
    "control": "control.loom",
    "math": "math.loom",
    "packing": "packing.loom",
    "prepare": "prepare.loom",
    "protocol": "protocol.loom",
    "targets": "targets.loom",
    "tile_math": "tile_math.cxx",
    "workers_epilogue": "workers_epilogue.loom",
    "workers_ingress": "workers_ingress.loom",
    "workers_query": "workers_query.loom",
    "workers_value": "workers_value.loom",
}

_MOTIFS = {
    "//motif/format/bfp16ebs8:aie2p": "library/motif/format/bfp16ebs8/aie2p",
    "//motif/tensor:prefix_norm": "library/motif/tensor/prefix_norm",
}

[
    loom_model(
        name = representation,
        card = "model.json",
        data = {
            "//model/Qwen/Qwen3-Embedding-0.6B/program:policy.loom": "program/policy.loom",
        },
        encoding = "preserve",
        files = {
            "//model/Qwen/Qwen3-Embedding-0.6B/program:" + (source if representation == "source" else name): "program/" + (source if representation == "source" else name + ".loombc")
            for name, source in _PROGRAM_SOURCES.items()
        } | {
            label + (".loom" if representation == "source" else ""): path + (".loom" if representation == "source" else ".loombc")
            for label, path in _MOTIFS.items()
        },
        lockfile = "model.json.lock",
        model_name = "qwen3-embedding-0.6b",
        preset = "embedding",
        programs = representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
    ]
]
