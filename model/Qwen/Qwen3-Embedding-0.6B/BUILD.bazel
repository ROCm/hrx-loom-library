load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/Qwen/Qwen3-Embedding-0.6B/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_INPUTS = [
    "//model/Qwen/Qwen3-Embedding-0.6B/program:prepare",
    "//model/Qwen/Qwen3-Embedding-0.6B/program:control",
]

# The command program owns the executable closure. Its dependencies carry the
# array composition, worker providers, reusable motifs, and target contract.
_LIBRARIES = ["//model/Qwen/Qwen3-Embedding-0.6B/program:command"]

[
    loom_model(
        name = representation,
        card = "model.json",
        encoding = "preserve",
        form = "module" if representation == "archive" else "sources",
        inputs = _INPUTS,
        libraries = _LIBRARIES,
        lockfile = "model.json.lock",
        model_name = "qwen3-embedding-0.6b",
        preset = "embedding",
        programs = representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
    ]
]
