load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_PROGRAM_NAMES = [
    "array",
    "command",
    "control",
    "prepare",
    "protocol",
    "tile_math",
    "workers_epilogue",
    "workers_ingress",
    "workers_query",
    "workers_value",
]

_MOTIFS = {
    "//motif/format/bfp16ebs8:aie2p": "library/motif/format/bfp16ebs8/aie2p",
    "//motif/tensor:prefix_norm": "library/motif/tensor/prefix_norm",
}

_TEXT_PROVIDERS = {
    "source": _PROGRAM_NAMES,
    "archive": [],
    "mixed": ["prepare", "control"],
}

[
    loom_model(
        name = representation,
        card = "model.json",
        data = {
            "//model/Qwen/Qwen3-Embedding-0.6B/program:policy.loom": "program/policy.loom",
        },
        encoding = "preserve",
        files = {
            "//model/Qwen/Qwen3-Embedding-0.6B/program:" + name + (".loom" if name in text_providers else ""): "program/" + name + (".loom" if name in text_providers else ".loombc")
            for name in _PROGRAM_NAMES
        } | {
            label + (".loom" if representation == "source" else ""): path + (".loom" if representation == "source" else ".loombc")
            for label, path in _MOTIFS.items()
        },
        lockfile = "model.json.lock",
        model_name = "qwen3-embedding-0.6b",
        preset = "embedding",
        programs = representation,
        visibility = ["//visibility:public"],
    )
    for representation, text_providers in _TEXT_PROVIDERS.items()
]
