  "services": {
    "chat": {
      "kind": "text",
      "version": 1,
      "options": [
        "sampling"
      ],
      "interface": {
        "input": [
          "text messages",
          "tool definitions",
          "tool results"
        ],
        "output": [
          "content",
          "reasoning_content",
          "tool calls"
        ],
        "architecture": {
          "layers": 48,
          "recurrent_layers": 36,
          "sparse_attention_layers": 12,
          "experts": 512,
          "selected_experts": 10,
          "shared_experts": 1
        },
        "parameter_shards": {
          "scope": "model",
          "order": "Metadata shard first, followed by three tensor payload shards."
        },
        "drafting": "One through seven recursive Q8_0 MTP proposals verified by the target text service; canonical presets select three."
      },
      "constraints": {
        "targets": [
          "AMDGPU RDNA"
        ],
        "draft_depth": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "mtp": "Depths one through seven require parameters.draft; depth zero uses target-only execution.",
        "continuation_epochs": [
          1,
          2
        ],
        "context_capacity": {
          "multiple_of": 64
        },
        "prefill_capacity": {
          "maximum": 32768
        },
        "pool_capacity": {
          "minimum": 1
        },
        "state_storage": {
          "kv_bytes_per_pooled_token": 25344,
          "recurrent_endpoint_bytes": 115651840,
          "mtp_carry_bytes_per_retained_owner": 44032,
          "mtp_cache_bytes_per_pooled_token": 2116,
          "mtp_tail_bytes_per_execution_row": 768
        },
        "vision": "No image component is declared for this text composition."
      }
    }
  },
