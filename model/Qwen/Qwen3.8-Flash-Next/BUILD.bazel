load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/Qwen/Qwen3.8-Flash-Next/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_TEXT_INPUTS = [
    "//model/Qwen/Qwen3.8-Flash-Next/program:prepare",
    "//program/text/qwen3_8:chat",
    "//model/Qwen/Qwen3.8-Flash-Next/program:identity",
]

_INPUTS = {
    "text": _TEXT_INPUTS,
    "vision": _TEXT_INPUTS + [
        "//model/Qwen/Qwen3.8-Flash-Next/program:vision_prepare",
        "//model/Qwen/Qwen3.8-Flash-Next/program:vision_control",
    ],
}

# These roots supply service exports and stages selected by preparation.
# Their kernel, template, and motif dependencies belong to the providers.
_TEXT_LIBRARIES = [
    "//model/Qwen/Qwen3.8-Flash-Next/program:commands",
    "//program/text/qwen3_8:epoch",
]

_LIBRARIES = {
    "text": _TEXT_LIBRARIES,
    "vision": _TEXT_LIBRARIES + [
        "//model/Qwen/Qwen3.8-Flash-Next/program:vision_commands",
        "//program/text/qwen3_8:vision_pixels",
        "//program/text/qwen3_8:vision_stages",
    ],
}

[
    loom_model(
        name = representation + suffix,
        card = "model.json",
        encoding = "preserve",
        form = "module" if representation == "archive" else "sources",
        inputs = _INPUTS[family],
        libraries = _LIBRARIES[family],
        lockfile = "model.json.lock",
        model_name = "qwen3.8-flash-next",
        preset = preset,
        programs = ("vision-" if family == "vision" else "") + representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
    ]
    for suffix, preset, family in [
        ("", "chat", "text"),
        ("_mtp", "mtp", "text"),
        ("_mtp_continuation", "mtp-continuation", "text"),
        ("_long_context", "long-context", "text"),
        ("_long_context_mtp", "long-context-mtp", "text"),
        ("_vision", "vision", "vision"),
        ("_vision_mtp", "vision-mtp", "vision"),
    ]
]
