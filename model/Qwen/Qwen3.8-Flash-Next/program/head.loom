// Selected-row output mixing, vocabulary projection, and sampling. Target
// outputs score the complete vocabulary; predictor outputs use the accepted-
// history plan. BF16 logits are the sampling publication boundary.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

config.decl @qwen38.packet_capacity : %value: index where [range(%value, 2, 2147483646), multiple_of(%value, 2)]

func.decl pure @flash_next_token_workers(%capacity: index, %groups_per_token: index, %units: index) -> (index)

func.decl @qwen38_packet_selection_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_identity_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_policy_origin(%capacity: index) -> (offset)

func.decl pure @flash_next_output_capacity() -> (index)

amdgpu.target<gfx11-generic> @flash_next_head_wave32 {subgroup_size = 32}

func.decl readonly @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl @flash_next_store_logit(%expanded: i1, %rows: index, %row: index, %id: index, %sum: f32, %output: buffer)

func.decl @flash_next_q8_batch_partial(%width: index, %group_size: index, %batch_size: index, %first: index, %end: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (vector<[%group_size]xf32>)

kernel.decl @hc_down(%active_rows: index) launch(%capacity: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @hc_normalize(%neural_enabled: i1, %row_capacity: index) launch(%capacity_argument: index, %span: buffer, %residual: buffer, %gamma: buffer, %normalized: buffer)

kernel.decl @hc_up_mix(%neural_enabled: i1, %row_capacity: index) launch(%capacity_argument: index, %span: buffer, %normalized: buffer, %lowrank: buffer, %weight: buffer, %mixed: buffer)

template.decl @sampling.categorical_excluding(%bf16_storage: i1, %columns: index, %logits: buffer, %logits_origin: offset, %excluded_id: i32, %temperature: f32, %top_p: f32, %top_k: i32, %seed: i64, %position: i64) -> (i32)

// The epoch carries separate counts for packed input tokens and sampled rows.
func.def readonly inline @flash_next_selected_count(%epoch: buffer) -> (index) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = view.load %header[2] : view<3xi32> -> i32
  %value = index.cast %word : i32 to index
  %capacity = func.call pure @flash_next_output_capacity() : () -> (index)
  %count = index.assume %value [range(%value, 0, %capacity)] : index
  func.return %count : index
}

// The controller has already selected each requested last span row. Gather
// only those rows before the final hyperconnection and vocabulary projection.
kernel.def @flash_next_select_output_rows(%output_count: index) {
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%output_count, %c1, %units) : (index, index, index) -> (index)
  // The first workgroup also publishes an empty projection header.
  %groups = index.max %workers, %c1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch: buffer, %residual: buffer, %head_epoch: buffer, %selected: buffer) {
  %first = kernel.workgroup.id<x> : index
  %stride_row = kernel.workgroup.count<x> : index
  %thread = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %rows = func.call pure @flash_next_output_capacity() : () -> (index)
  %count = func.call readonly @flash_next_selected_count(%epoch) : (buffer) -> (index)
  %c0 = index.constant 0 : index
  %first_row = index.cmp eq, %first, %c0 : index
  %first_thread = index.cmp eq, %thread, %c0 : index
  %publishes = scalar.andi %first_row, %first_thread : i1
  scf.if %publishes {
    %output_header = buffer.view %head_epoch[%origin] : buffer -> view<3xi32>
    %count_word = index.cast %count : index to i32
    view.store %count_word, %output_header[0] : i32, view<3xi32>
  }
  scf.for %row = [%first to %count step %stride_row] {
    %tokens = config.get @flash_next.token_count : index
    %packet_capacity = config.get @qwen38.packet_capacity : index
    %selection_origin = func.call @qwen38_packet_selection_origin(%packet_capacity) : (index) -> (offset)
    %selections = buffer.view %epoch[%selection_origin] : buffer -> view<[%packet_capacity]xi32>
    %source_word = view.load %selections[%row] : view<[%packet_capacity]xi32> -> i32
    %source_value = index.cast %source_word : i32 to index
    %source = index.assume %source_value [range(%source_value, 0, 32767), lt(%source_value, %tokens)] : index
    %input = buffer.view %residual[%origin] : buffer -> view<[%tokens]x1280x8xbf16>
    %output = buffer.view %selected[%origin] : buffer -> view<[%rows]x1280x8xbf16>
    %chunks = index.constant 1280 : index
    %threads = index.constant 128 : index
    scf.for %chunk = [%thread to %chunks step %threads] {
      %values = vector.load %input[%source, %chunk, %c0] : view<[%tokens]x1280x8xbf16> -> vector<8xbf16>
      vector.store %values, %output[%row, %chunk, %c0] : vector<8xbf16>, view<[%rows]x1280x8xbf16>
    }
  }
  kernel.return
}

// Selected output rows share original vocabulary codes across a constant
// query group: four for small capacities and eight for larger capacities.
// A device-sized worker pool traverses live query/vocabulary panels instead
// of launching one workgroup for every reserved panel.
// Sampling still observes the checkpoint's BF16 logit publication boundary.
kernel.def target(@flash_next_head_wave32) @flash_next_vocabulary() {
  %groups = index.constant 62080 : index
  %rows = func.call pure @flash_next_output_capacity() : () -> (index)
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %wide = index.cmp ugt, %rows, %c4 : index
  %batch_size = scf.select %wide, %c8, %c4 : index
  %rounding = index.sub %batch_size, %c1 : index
  %padded = index.add %rows, %rounding : index
  %batches = index.div %padded, %batch_size : index
  %panels = index.mul %batches, %groups : index
  %units = target.execution.unit.count : index
  %groups_per_unit = index.constant 32 : index
  %budget = index.mul %units, %groups_per_unit : index
  %workers = index.min %panels, %budget : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%workers, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%expanded: i1, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = func.call pure @flash_next_output_capacity() : () -> (index)
  %worker = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c1 = index.constant 1 : index
  %wide = index.cmp ugt, %rows, %c4 : index
  %batch_size = scf.select %wide, %c8, %c4 : index
  %count = func.call @flash_next_token_count(%epoch, %rows) : (buffer, index) -> (index)
  %tail = index.sub %batch_size, %c1 : index
  %padded = index.add %count, %tail : index
  %batches = index.div %padded, %batch_size : index
  %groups = index.constant 62080 : index
  %panels = index.mul %batches, %groups : index
  scf.for %panel = [%worker to %panels step %workers] {
    %batch = index.div %panel, %groups : index
    %group = index.rem %panel, %groups : index
    %first = index.mul %batch, %batch_size : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %row = index.madd %group, %c4, %wave : index
    %width = index.constant 2560 : index
    %stride = index.constant 32 : index
    %part = func.call @flash_next_q8_batch_partial(%width, %batch_size, %batch_size, %first, %count, %row, %lane, %stride, %input, %weight) : (index, index, index, index, index, index, index, index, buffer, buffer) -> (vector<[%batch_size]xf32>)
    %sums = kernel.subgroup.reduce<addf> %part : vector<[%batch_size]xf32>
    %c0 = index.constant 0 : index
    %leader = index.cmp eq, %lane, %c0 : index
    scf.if %leader {
      scf.for %ordinal = [%c0 to %batch_size step %c1] unroll schedule(linear) {
        %token = index.add %first, %ordinal : index
        %live = index.cmp ult, %token, %count : index
        scf.if %live {
          %sum = vector.extract %sums[%ordinal] : vector<[%batch_size]xf32> -> f32
          func.call @flash_next_store_logit(%expanded, %rows, %token, %row, %sum, %output) : (i1, index, index, index, f32, buffer)
        }
      }
    }
  }
  kernel.return
}

kernel.def @flash_next_sample(%output_count: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%output_count, %c1, %units) : (index, index, index) -> (index)
  kernel.launch.config workgroups(%workers, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch: buffer, %logits: buffer, %output: buffer) {
  %first = kernel.workgroup.id<x> : index
  %stride_row = kernel.workgroup.count<x> : index
  %thread = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %count = func.call readonly @flash_next_selected_count(%epoch) : (buffer) -> (index)
  scf.for %row = [%first to %count step %stride_row] {
    %packet_capacity = config.get @qwen38.packet_capacity : index
    %identity_origin = func.call @qwen38_packet_identity_origin(%packet_capacity) : (index) -> (offset)
    %identities = buffer.view %epoch[%identity_origin] : buffer -> view<[%packet_capacity]x2xi32>
    %owner_word = view.load %identities[%row, 0] : view<[%packet_capacity]x2xi32> -> i32
    %position_word = view.load %identities[%row, 1] : view<[%packet_capacity]x2xi32> -> i32
    %owner_value = index.cast %owner_word : i32 to index
    %owner = index.assume %owner_value [ge(%owner_value, 0), lt(%owner_value, %packet_capacity)] : index
    %position = scalar.extui %position_word : i32 to i64
    %policy_begin = func.call @qwen38_packet_policy_origin(%packet_capacity) : (index) -> (offset)
    %policy_stride = index.constant 24 : offset
    %policy_relative = index.scale %owner, %policy_stride : index, offset -> offset
    %policy_origin = index.add %policy_begin, %policy_relative : offset
    %floats = buffer.view %epoch[%policy_origin] : buffer -> view<6xf32>
    %words = buffer.view %epoch[%policy_origin] : buffer -> view<6xi32>
    %seed_relative = index.constant 16 : offset
    %seed_origin = index.add %policy_origin, %seed_relative : offset
    %seeds = buffer.view %epoch[%seed_origin] : buffer -> view<1xi64>
    %temperature = view.load %floats[0] : view<6xf32> -> f32
    %top_p = view.load %floats[1] : view<6xf32> -> f32
    %top_k = view.load %words[2] : view<6xi32> -> i32
    %flags = view.load %words[3] : view<6xi32> -> i32
    %tool_bit = scalar.constant 2 : i32
    %c0_i32 = scalar.constant 0 : i32
    %none = scalar.constant -1 : i32
    %tool_open = scalar.constant 248058 : i32
    %permission = scalar.andi %flags, %tool_bit : i32
    %disabled = scalar.cmpi ne, %permission, %c0_i32 : i32
    %excluded = scf.select %disabled, %tool_open, %none : i32
    %seed = view.load %seeds[0] : view<1xi64> -> i64
    %row_bytes = index.constant 496640 : offset
    %logits_origin = index.scale %row, %row_bytes : index, offset -> offset
    // The checkpoint pads its physical vocabulary to 248320 rows. Only
    // the 248077 tokenizer IDs may be sampled.
    %columns = index.constant 248077 : index
    %bf16_storage = scalar.constant true : i1
    %selected = template.apply<@sampling.categorical_excluding>(%bf16_storage, %columns, %logits, %logits_origin, %excluded, %temperature, %top_p, %top_k, %seed, %position) : (i1, index, buffer, offset, i32, f32, f32, i32, i64, i64) -> (i32)
    %c0 = index.constant 0 : index
    %publishes = index.cmp eq, %thread, %c0 : index
    scf.if %publishes {
      %rows = func.call pure @flash_next_output_capacity() : () -> (index)
      %output_row = index.assume %row [ge(%row, 0), lt(%row, %rows)] : index
      %ids = buffer.view %output[%origin] : buffer -> view<[%rows]xi32>
      view.store %selected, %ids[%output_row] : i32, view<[%rows]xi32>
    }
    // Release sampling scratch before any wave starts its next row.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}

command.def @flash_next_head_mix(%live_rows: index, %predictor: index, %rows: index) launch(%parameters: buffer, %epoch: buffer, %residual: buffer, %hidden: buffer) {
  %residual_stride = index.constant 20480 : offset
  %rank_stride = index.constant 640 : offset
  %residual_bytes = index.scale %rows, %residual_stride : index, offset -> offset
  %rank_bytes = index.scale %rows, %rank_stride : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %residual_bytes : buffer
  %lowrank = buffer.alloca<global> align(256) %rank_bytes : buffer
  %c0 = index.constant 0 : index
  %draft = index.cmp ne, %predictor, %c0 : index
  %gamma, %down, %up = scf.if %draft -> (view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>) {
    %gamma = command.parameter %parameters, "blk.48.nextn.hc_head_norm.weight" : view<4x2560xf32>
    %down = command.parameter %parameters, "blk.48.nextn.hc_head_down.weight" : view<3481600xi8>
    %up = command.parameter %parameters, "blk.48.nextn.hc_head_up.weight" : view<3481600xi8>
    scf.yield %gamma, %down, %up : view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>
  } else {
    %gamma = command.parameter %parameters, "output_hc_norm.weight" : view<4x2560xf32>
    %down = command.parameter %parameters, "output_hc_down.weight" : view<3481600xi8>
    %up = command.parameter %parameters, "output_hc_up.weight" : view<3481600xi8>
    scf.yield %gamma, %down, %up : view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>
  }
  %enabled = scalar.constant true : i1
  kernel.launch @hc_normalize[%enabled, %live_rows](%rows, %epoch, %residual, %gamma, %normalized) : [i1, index](index, buffer, buffer, view<4x2560xf32>, buffer)
  kernel.launch @hc_down[%live_rows](%rows, %epoch, %normalized, %down, %lowrank) : [index](index, buffer, buffer, view<3481600xi8>, buffer)
  kernel.launch @hc_up_mix[%enabled, %live_rows](%rows, %epoch, %normalized, %lowrank, %up, %hidden) : [i1, index](index, buffer, buffer, buffer, view<3481600xi8>, buffer)
  command.return
}

command.def public @flash_next_head_logits(%predictor: index) launch(%parameters: buffer, %vocabulary_parameters: buffer, %epoch: buffer, %residual: buffer, %logits: buffer) {
  %expanded = scalar.constant true : i1
  %capacity = func.call pure @flash_next_output_capacity() : () -> (index)
  %count = func.call readonly @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  command.launch @flash_next_project_logits[%count, %predictor, %expanded](%parameters, %vocabulary_parameters, %epoch, %residual, %logits) : [index, index, i1](buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def @flash_next_project_logits(%live_rows: index, %predictor: index, %expanded: i1) launch(%parameters: buffer, %vocabulary_parameters: buffer, %epoch: buffer, %residual: buffer, %logits: buffer) {
  %rows = func.call pure @flash_next_output_capacity() : () -> (index)
  %hidden_stride = index.constant 5120 : offset
  %hidden_bytes = index.scale %rows, %hidden_stride : index, offset -> offset
  %hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.launch @flash_next_head_mix[%live_rows, %predictor, %rows](%parameters, %epoch, %residual, %hidden) : [index, index, index](buffer, buffer, buffer, buffer)
  %head = command.parameter %vocabulary_parameters, "output.weight" : view<675430400xi8>
  kernel.launch @flash_next_vocabulary(%expanded, %epoch, %hidden, %head, %logits) : (i1, buffer, buffer, view<675430400xi8>, buffer)
  command.return
}

kernel.decl @flash_next_draft_common_head(%live_rows: index) launch(%expanded: i1, %epoch: buffer, %plan: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_draft_rare_head(%live_rows: index) launch(%expanded: i1, %epoch: buffer, %plan: buffer, %carry: buffer, %input: buffer, %weight: buffer, %output: buffer)

command.def public @flash_next_draft_head(%neural_enabled: i1) launch(%parameters: buffer, %vocabulary_parameters: buffer, %epoch: buffer, %plan: buffer, %carry: buffer, %residual: buffer, %logits: buffer) {
  %expanded = scalar.constant true : i1
  %tokens = config.get @flash_next.token_count : index
  %count = func.call readonly @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  %c0 = index.constant 0 : index
  %live_rows = scf.select %neural_enabled, %count, %c0 : index
  command.launch @flash_next_project_draft_logits[%live_rows, %expanded](%parameters, %vocabulary_parameters, %epoch, %plan, %carry, %residual, %logits) : [index, i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @flash_next_project_draft_logits(%live_rows: index, %expanded: i1) launch(%parameters: buffer, %vocabulary_parameters: buffer, %epoch: buffer, %plan: buffer, %carry: buffer, %residual: buffer, %logits: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %hidden_stride = index.constant 5120 : offset
  %hidden_bytes = index.scale %tokens, %hidden_stride : index, offset -> offset
  %hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %predictor = index.constant 1 : index
  command.launch @flash_next_head_mix[%live_rows, %predictor, %tokens](%parameters, %epoch, %residual, %hidden) : [index, index, index](buffer, buffer, buffer, buffer)
  %head = command.parameter %vocabulary_parameters, "output.weight" : view<675430400xi8>
  kernel.launch @flash_next_draft_common_head[%live_rows](%expanded, %epoch, %plan, %hidden, %head, %logits) : [index](i1, buffer, buffer, buffer, view<675430400xi8>, buffer)
  kernel.launch @flash_next_draft_rare_head[%live_rows](%expanded, %epoch, %plan, %carry, %hidden, %head, %logits) : [index](i1, buffer, buffer, buffer, buffer, view<675430400xi8>, buffer)
  command.return
}

command.def public @flash_next_output_head() launch(%parameters: buffer, %epoch: buffer, %residual: buffer, %outputs: buffer) {
  %rows = func.call pure @flash_next_output_capacity() : () -> (index)
  %residual_stride = index.constant 20480 : offset
  %logit_stride = index.constant 496640 : offset
  %residual_bytes = index.scale %rows, %residual_stride : index, offset -> offset
  %logit_bytes = index.scale %rows, %logit_stride : index, offset -> offset
  %header_bytes = index.constant 12 : offset
  %selected = buffer.alloca<global> align(256) %residual_bytes : buffer
  %head_epoch = buffer.alloca<global> align(16) %header_bytes : buffer
  %logits = buffer.alloca<global> align(256) %logit_bytes : buffer
  %count = func.call readonly @flash_next_selected_count(%epoch) : (buffer) -> (index)
  kernel.launch @flash_next_select_output_rows[%count](%epoch, %residual, %head_epoch, %selected) : [index](buffer, buffer, buffer, buffer)
  %target = index.constant 0 : index
  %expanded = scalar.constant false : i1
  command.launch @flash_next_project_logits[%count, %target, %expanded](%parameters, %parameters, %head_epoch, %selected, %logits) : [index, index, i1](buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_sample[%count](%epoch, %logits, %outputs) : [index](buffer, buffer, buffer)
  command.return
}
