// Complete Flash-Next target epochs over packed spans. Layer ordering and
// output-only selection specialize per entry. The packet carries live
// token/span ownership, page maps, and retained frontiers.
func.decl readonly @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl readonly @flash_next_span_count(%epoch: buffer) -> (index)

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

config.decl @flash_next.dot_packet : %value: index where [range(%value, 0, 1)]

command.decl @flash_next_finish_output(%workload_count: index, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %epoch: buffer, %mapping: buffer, %rows: buffer, %arena: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %output: buffer, %capture: buffer, %inputs: buffer)

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

config.decl @flash_next.pool_capacity : %value: index where [range(%value, 64, 2147483584), multiple_of(%value, 64)]

kernel.decl @flash_next_map_tokens(%neural_enabled: i1) launch(%epoch: buffer, %mapping: buffer)

kernel.decl @flash_next_embedding_q8_0() launch(%epoch: buffer, %ids: buffer, %weight: buffer, %residual: buffer)

command.decl @flash_next_ple_residual(%stream: i1, %workload_count: index, %layer: index, %token_history_origin: offset, %convolution_history_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %origins: buffer, %tokens: buffer, %residual: buffer, %arena: buffer, %output: buffer, %capture: buffer, %cache: buffer)

command.decl @flash_next_output_head() launch(%parameters: buffer, %epoch: buffer, %residual: buffer, %outputs: buffer)

command.def public @flash_next_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %output_tokens: buffer) {
  // Ordinary stages erase all capture calls; no separate capture allocation.
  command.launch @flash_next_body(%parameters, %residual, %epoch, %rows, %state, %input_tokens, %residual) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @flash_next_output_head(%parameters, %epoch, %residual, %output_tokens) : (buffer, buffer, buffer, buffer)
  command.return
}

kernel.decl @hc_combine(%neural_enabled: i1) launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer)

command.decl @flash_next_gdn_attention(%workload_count: index, %span_count: index, %layer: index, %state_origin: offset) launch(%parameters: buffer, %span: buffer, %input: buffer, %rows: buffer, %arena: buffer, %output: buffer, %capture: buffer)

command.decl @flash_next_qsa_attention(%workload_count: index, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset, %mixed_inputs: index) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %working: buffer, %output: buffer, %capture: buffer, %inputs: buffer)

command.decl @flash_next_route(%workload_count: index, %layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer)

command.decl @flash_next_experts(%workload_count: index, %layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer, %output: buffer)

command.def public @flash_next_body() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %outputs_only = scalar.constant false : i1
  command.launch @flash_next_body_select[%outputs_only](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @flash_next_body_select(%outputs_only: i1) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 48 : index
  %stream = scalar.constant false : i1
  command.launch @flash_next_body_range[%outputs_only, %begin, %end, %stream](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : [i1, index, index, i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.decl @flash_next_hc_normalize_mix(%workload_count: index, %gamma: view<4x2560xf32>, %down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>, %injection_weight: view<4x10240xf32>) launch(%span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer)

command.decl @flash_next_hc_combine_mix(%packet_count: index, %workload_count: index, %allow_quantized: i1, %gamma: view<4x2560xf32>, %down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>, %injection_weight: view<4x10240xf32>) launch(%span: buffer, %residual: buffer, %projected: buffer, %previous_injection: buffer, %output: buffer, %injection: buffer, %mixed: buffer)

// One layer traversal serves ordinary and verifying packets. The token and
// span capacities bound storage, while the packet counts select device work.
command.def public @flash_next_body_range(%outputs_only: i1, %begin_layer: index, %end_layer: index, %stream: i1) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %neural_enabled = scalar.constant true : i1
  %allow_quantized = scalar.constant true : i1
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  %tokens = config.get @flash_next.token_count : index
  %mode = config.get @flash_next.dot_packet : index
  %c0 = index.constant 0 : index
  %short_packet = index.cmp ne, %mode, %c0 : index
  %live_workload_count = func.call readonly @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  %workload_count = scf.if %short_packet -> (index) {
    %short_workload_count = index.assume %live_workload_count [range(%live_workload_count, 1, 15)] : index
    scf.yield %short_workload_count : index
  } else {
    scf.yield %live_workload_count : index
  }
  %live_span_count = func.call readonly @flash_next_span_count(%epoch) : (buffer) -> (index)
  %span_count = scf.if %short_packet -> (index) {
    %short_span_count = index.assume %live_span_count [range(%live_span_count, 1, 15)] : index
    scf.yield %short_span_count : index
  } else {
    scf.yield %live_span_count : index
  }
  %pool = config.get @flash_next.pool_capacity : index
  %row_bytes = index.constant 20480 : offset
  %hidden_row_bytes = index.constant 5120 : offset
  %injection_row_bytes = index.constant 16 : offset
  %selection_row_bytes = index.constant 40 : offset
  %gate_row_bytes = index.constant 4 : offset
  %activation_bytes = index.scale %tokens, %row_bytes : index, offset -> offset
  %hidden_bytes = index.scale %tokens, %hidden_row_bytes : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_row_bytes : index, offset -> offset
  %selection_bytes = index.scale %tokens, %selection_row_bytes : index, offset -> offset
  %gate_bytes = index.scale %tokens, %gate_row_bytes : index, offset -> offset
  %mapping_stride = index.constant 16 : offset
  %mapping_bytes = index.scale %tokens, %mapping_stride : index, offset -> offset
  %mapping = buffer.alloca<global> align(16) %mapping_bytes : buffer
  kernel.launch @flash_next_map_tokens[%neural_enabled](%epoch, %mapping) : [i1](buffer, buffer)
  %initial_layer = index.constant 0 : index
  %initial = index.cmp eq, %begin_layer, %initial_layer : index
  scf.if %initial {
    %embedding = command.parameter %parameters, "token_embd.weight" : view<675430400xi8>
    kernel.launch @flash_next_embedding_q8_0(%epoch, %input_tokens, %embedding, %residual) : (buffer, buffer, view<675430400xi8>, buffer)
  }
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %last_layer = index.constant 47 : index
  %main_planes = index.constant 12 : index
  %gdn_stride = index.constant 3207168 : offset
  %main_token_stride = index.constant 2048 : offset
  %value_tile_offset = index.constant 2048 : offset
  %index_token_stride = index.constant 64 : offset
  %main_plane_bytes = index.scale %pool, %main_token_stride : index, offset -> offset
  %index_plane_bytes = index.scale %pool, %index_token_stride : index, offset -> offset
  %index_base = index.scale %main_planes, %main_plane_bytes : index, offset -> offset
  %token_history = index.constant 115458048 : offset
  %conv_history = index.constant 115458304 : offset
  %tail_base = index.constant 115642624 : offset
  %tail_stride = index.constant 768 : offset
  // PLE produces the first residual before hyperconnection setup when the
  // byte dependency splits the program here. This preserves parameter order
  // across small, normalized, and fused cohorts sharing the same weight bank.
  %starts_with_ple = index.cmp eq, %begin_layer, %c1 : index
  %initial_residual = scf.if %starts_with_ple -> (buffer) {
    %ple = buffer.alloca<global> align(256) %activation_bytes : buffer
    command.launch @flash_next_ple_residual[%stream, %workload_count, %begin_layer, %token_history, %conv_history](%parameters, %epoch, %mapping, %rows, %input_tokens, %residual, %state, %ple, %capture, %residual) : [i1, index, index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    scf.yield %ple : buffer
  } else {
    scf.yield %residual : buffer
  }
  %initial_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %initial_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  %initial_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%begin_layer] : view<4x2560xf32>
  %initial_down = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%begin_layer] : view<3481600xi8>
  %initial_up = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%begin_layer] : view<3481600xi8>
  %initial_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%begin_layer] : view<4x10240xf32>
  command.launch @flash_next_hc_normalize_mix[%workload_count, %initial_gamma, %initial_down, %initial_up, %initial_weight](%epoch, %initial_residual, %initial_injection, %initial_mixed) : [index, view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>, view<4x10240xf32>](buffer, buffer, buffer, buffer)

  %final, %final_mixed, %final_injection = scf.for %layer = [%begin_layer to %end_layer step %c1](%current = %initial_residual : buffer, %current_mixed = %initial_mixed : buffer, %current_injection = %initial_injection : buffer) -> (buffer, buffer, buffer) unroll {
    %at_ple = index.cmp eq, %layer, %c1 : index
    %following = index.cmp ne, %layer, %begin_layer : index
    %has_ple = scalar.andi %at_ple, %following : i1
    %input, %attention_mixed, %attention_injection = scf.if %has_ple -> (buffer, buffer, buffer) {
      %ple = buffer.alloca<global> align(256) %activation_bytes : buffer
      command.launch @flash_next_ple_residual[%stream, %workload_count, %layer, %token_history, %conv_history](%parameters, %epoch, %mapping, %rows, %input_tokens, %current, %state, %ple, %capture, %residual) : [i1, index, index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %ple_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
      %ple_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
      %ple_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%layer] : view<4x2560xf32>
      %ple_down = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%layer] : view<3481600xi8>
      %ple_up = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%layer] : view<3481600xi8>
      %ple_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%layer] : view<4x10240xf32>
      command.launch @flash_next_hc_normalize_mix[%workload_count, %ple_gamma, %ple_down, %ple_up, %ple_weight](%epoch, %ple, %ple_injection, %ple_mixed) : [index, view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>, view<4x10240xf32>](buffer, buffer, buffer, buffer)
      scf.yield %ple, %ple_mixed, %ple_injection : buffer, buffer, buffer
    } else {
      scf.yield %current, %current_mixed, %current_injection : buffer, buffer, buffer
    }
    %is_last = index.cmp eq, %layer, %last_layer : index
    %finish = scalar.andi %outputs_only, %is_last : i1
    %finished, %finished_mixed, %finished_injection = scf.if %finish -> (buffer, buffer, buffer) {
      %ordinal = index.div %layer, %c4 : index
      %key_origin = index.scale %ordinal, %main_plane_bytes : index, offset -> offset
      %value_origin = index.add %key_origin, %value_tile_offset : offset
      %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
      %index_origin = index.add %index_base, %index_relative : offset
      %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
      %tail_origin = index.add %tail_base, %tail_relative : offset
      command.launch @flash_next_finish_output[%workload_count, %layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %epoch, %mapping, %rows, %state, %input, %attention_mixed, %attention_injection, %residual, %capture, %input_tokens) : [index, index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      scf.yield %residual, %attention_mixed, %attention_injection : buffer, buffer, buffer
    } else {
      %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
      %ordinal = index.div %layer, %c4 : index
      %kind = index.rem %layer, %c4 : index
      %indexed = index.cmp eq, %kind, %c3 : index
      scf.if %indexed {
        %key_origin = index.scale %ordinal, %main_plane_bytes : index, offset -> offset
        %value_origin = index.add %key_origin, %value_tile_offset : offset
        %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
        %index_origin = index.add %index_base, %index_relative : offset
        %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
        %tail_origin = index.add %tail_base, %tail_relative : offset
        command.launch @flash_next_qsa_attention[%workload_count, %layer, %key_origin, %value_origin, %index_origin, %tail_origin, %mixed_inputs](%parameters, %epoch, %mapping, %rows, %attention_mixed, %state, %state, %projected, %capture, %input_tokens) : [index, index, offset, offset, offset, offset, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      } else {
        %gdn_ordinal = index.sub %layer, %ordinal : index
        %state_origin = index.scale %gdn_ordinal, %gdn_stride : index, offset -> offset
        command.launch @flash_next_gdn_attention[%workload_count, %span_count, %layer, %state_origin](%parameters, %epoch, %attention_mixed, %rows, %state, %projected, %capture) : [index, index, index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      }
      %attention = buffer.alloca<global> align(256) %activation_bytes : buffer
      %ffn_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
      %ffn_gamma = command.parameter %parameters, "blk.{}.hc_ffn_norm.weight"[%layer] : view<4x2560xf32>
      %ffn_down = command.parameter %parameters, "blk.{}.hc_ffn_down.weight"[%layer] : view<3481600xi8>
      %ffn_up = command.parameter %parameters, "blk.{}.hc_ffn_up.weight"[%layer] : view<3481600xi8>
      %ffn_weight = command.parameter %parameters, "blk.{}.hc_ffn_inject.weight"[%layer] : view<4x10240xf32>
      %ffn_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
      %intermediate = index.cmp ne, %layer, %last_layer : index
      command.launch @flash_next_hc_combine_mix[%workload_count, %workload_count, %intermediate, %ffn_gamma, %ffn_down, %ffn_up, %ffn_weight](%epoch, %input, %projected, %attention_injection, %attention, %ffn_injection, %ffn_mixed) : [index, index, i1, view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>, view<4x10240xf32>](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %ids = buffer.alloca<global> align(256) %selection_bytes : buffer
      %weights = buffer.alloca<global> align(256) %selection_bytes : buffer
      %shared_gate = buffer.alloca<global> align(256) %gate_bytes : buffer
      command.launch @flash_next_route[%workload_count, %layer](%parameters, %epoch, %ffn_mixed, %ids, %weights, %shared_gate) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer)
      %branch = buffer.alloca<global> align(256) %hidden_bytes : buffer
      command.launch @flash_next_experts[%workload_count, %layer](%parameters, %epoch, %ffn_mixed, %ids, %weights, %shared_gate, %branch) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %after_layer = index.add %layer, %c1 : index
      %last = index.cmp eq, %after_layer, %end_layer : index
      %output = scf.if %last -> (buffer) {
        scf.yield %residual : buffer
      } else {
        %temporary = buffer.alloca<global> align(256) %activation_bytes : buffer
        scf.yield %temporary : buffer
      }
      %before_ple = index.cmp eq, %layer, %c0 : index
      %separate = scalar.ori %before_ple, %last : i1
      %next_mixed, %next_injection = scf.if %separate -> (buffer, buffer) {
        kernel.launch @hc_combine[%neural_enabled](%epoch, %attention, %branch, %ffn_injection, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
        // PLE replaces this value before use; the final head gathers its own
        // rows. Neither boundary consumes a prepared attention mixer.
        scf.yield %attention_mixed, %attention_injection : buffer, buffer
      } else {
        %next_layer = index.add %layer, %c1 : index
        %next_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%next_layer] : view<4x2560xf32>
        %mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
        %injection = buffer.alloca<global> align(256) %injection_bytes : buffer
        %down_weight = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%next_layer] : view<3481600xi8>
        %up_weight = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%next_layer] : view<3481600xi8>
        %next_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%next_layer] : view<4x10240xf32>
        command.launch @flash_next_hc_combine_mix[%workload_count, %workload_count, %allow_quantized, %next_gamma, %down_weight, %up_weight, %next_weight](%epoch, %attention, %branch, %ffn_injection, %output, %injection, %mixed) : [index, index, i1, view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>, view<4x10240xf32>](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
        scf.yield %mixed, %injection : buffer, buffer
      }
      scf.yield %output, %next_mixed, %next_injection : buffer, buffer, buffer
    }
    scf.yield %finished, %finished_mixed, %finished_injection : buffer, buffer, buffer
  }
  command.return
}

// Only this root promises selected outputs rather than all target hidden rows.
// MTP and direct full-hidden consumers continue using flash_next_epoch/body.
command.def public @flash_next_epoch_output_only() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %output_tokens: buffer) {
  %outputs_only = scalar.constant true : i1
  command.launch @flash_next_body_select[%outputs_only](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %residual) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @flash_next_output_head(%parameters, %epoch, %residual, %output_tokens) : (buffer, buffer, buffer, buffer)
  command.return
}
