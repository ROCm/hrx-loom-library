// Routed and shared expert composition for one residual layer. Both branches
// consume the same mixed activation, and the four-stream residual remains
// live through final injection.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

command.program.decl @flash_next_hc_ffn(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer)

command.program.decl @flash_next_route(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer)

command.program.decl @flash_next_experts(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer, %output: buffer)

kernel.decl @hc_combine(%neural_enabled: i1) launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer)

// Routing and every branch consume the same packed mixed activation. The
// residual input survives until the final four-stream injection; inactive rows
// are neither read from transient publications nor written to the output.
command.program.def public @flash_next_ffn_residual(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %output: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %hidden_row_bytes = index.constant 5120 : offset
  %injection_row_bytes = index.constant 16 : offset
  %selection_row_bytes = index.constant 40 : offset
  %gate_row_bytes = index.constant 4 : offset
  %hidden_bytes = index.scale %tokens, %hidden_row_bytes : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_row_bytes : index, offset -> offset
  %selection_bytes = index.scale %tokens, %selection_row_bytes : index, offset -> offset
  %gate_bytes = index.scale %tokens, %gate_row_bytes : index, offset -> offset
  %mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %branch = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  %ids = buffer.alloca<global> align(256) %selection_bytes : buffer
  %weights = buffer.alloca<global> align(256) %selection_bytes : buffer
  %shared_gate = buffer.alloca<global> align(256) %gate_bytes : buffer
  command.program.launch @flash_next_hc_ffn[%neural_enabled, %layer](%parameters, %span, %residual, %injection, %mixed) : [i1, index](buffer, buffer, buffer, buffer, buffer)
  command.program.launch @flash_next_route[%neural_enabled, %layer](%parameters, %span, %mixed, %ids, %weights, %shared_gate) : [i1, index](buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @flash_next_experts[%neural_enabled, %layer](%parameters, %span, %mixed, %ids, %weights, %shared_gate, %branch) : [i1, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @hc_combine[%neural_enabled](%span, %residual, %branch, %injection, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
  command.return
}
