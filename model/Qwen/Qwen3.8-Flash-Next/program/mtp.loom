// Multi-token predictor input fusion and accepted-target catch-up. Embedding
// and hidden projections round independently before BF16 addition; catch-up
// reads committed carry before publishing its replacement.

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @flash_next_mtp_embedding(%neural_enabled: i1) launch(%span: buffer, %token_ids: buffer, %weight: buffer, %residual: buffer)

kernel.decl @flash_next_mtp_embedding_warm() launch(%source_capacity: index, %span: buffer, %mapping: buffer, %origins: buffer, %token_ids: buffer, %weight: buffer, %residual: buffer)

kernel.decl @flash_next_mtp_normalize(%neural_enabled: i1) launch(%width_value: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_mtp_normalize_warm() launch(%epoch: buffer, %mapping: buffer, %origins: buffer, %restored: buffer, %target: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_mtp_fuse(%neural_enabled: i1) launch(%epoch: buffer, %embedding: buffer, %hidden: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_mtp_embedding_matrix(%neural_enabled: i1) launch(%epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_mtp_hidden_matrix(%neural_enabled: i1) launch(%epoch: buffer, %input: buffer, %weight: buffer, %embedding: buffer, %output: buffer)

// Each projection rounds independently before the final BF16 addition. Batched
// cohorts reuse input and weight panels through the shared Q8 matrix core;
// small cohorts retain the wave reduction without an intermediate allocation.
// Small accepted prefixes retain the wave path. Matrix publication begins
// at capacity 128, shared by prompt batches and large verification cohorts.
command.program.def @flash_next_mtp_project(%neural_enabled: i1) launch(%parameters: buffer, %epoch: buffer, %embedding: buffer, %hidden: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "blk.48.nextn.eh_proj.weight" : view<2560x160x34xi8>
  %tokens = config.get @flash_next.token_count : index
  %matrix_threshold = index.constant 128 : index
  %matrix = index.cmp uge, %tokens, %matrix_threshold : index
  scf.if %matrix {
    %stride = index.constant 5120 : offset
    %bytes = index.scale %tokens, %stride : index, offset -> offset
    %projected_embedding = buffer.alloca<global> align(256) %bytes : buffer
    kernel.launch @flash_next_mtp_embedding_matrix[%neural_enabled](%epoch, %embedding, %weight, %projected_embedding) : [i1](buffer, buffer, view<2560x160x34xi8>, buffer)
    kernel.launch @flash_next_mtp_hidden_matrix[%neural_enabled](%epoch, %hidden, %weight, %projected_embedding, %output) : [i1](buffer, buffer, view<2560x160x34xi8>, buffer, buffer)
  } else {
    kernel.launch @flash_next_mtp_fuse[%neural_enabled](%epoch, %embedding, %hidden, %weight, %output) : [i1](buffer, buffer, buffer, view<2560x160x34xi8>, buffer)
  }
  command.return
}

// Both input owners share embedding lookup, normalization, and projection.
// The embedding table is byte-identical to the target's and shares its bank.
command.program.def @flash_next_mtp_embed_project(%neural_enabled: i1, %remapped: i1) launch(%parameters: buffer, %target_parameters: buffer, %epoch: buffer, %mapping: buffer, %origins: buffer, %ids: buffer, %normalized_hidden: buffer, %residual: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %embedding_stride = index.constant 5120 : offset
  %embedding_bytes = index.scale %tokens, %embedding_stride : index, offset -> offset
  %embedding = buffer.alloca<global> align(256) %embedding_bytes : buffer
  %normalized_embedding = buffer.alloca<global> align(256) %embedding_bytes : buffer
  %embedding_weight = command.parameter %target_parameters, "token_embd.weight" : view<675430400xi8>
  %embedding_norm = command.parameter %parameters, "blk.48.nextn.enorm.weight" : view<2560xf32>
  %embedding_width = index.constant 2560 : index
  scf.if %remapped {
    kernel.launch @flash_next_mtp_embedding_warm(%tokens, %epoch, %mapping, %origins, %ids, %embedding_weight, %embedding) : (index, buffer, buffer, buffer, buffer, view<675430400xi8>, buffer)
  } else {
    kernel.launch @flash_next_mtp_embedding[%neural_enabled](%epoch, %ids, %embedding_weight, %embedding) : [i1](buffer, buffer, view<675430400xi8>, buffer)
  }
  kernel.launch @flash_next_mtp_normalize[%neural_enabled](%embedding_width, %epoch, %embedding, %embedding_norm, %normalized_embedding) : [i1](index, buffer, buffer, view<2560xf32>, buffer)
  command.program.launch @flash_next_mtp_project[%neural_enabled](%parameters, %epoch, %normalized_embedding, %normalized_hidden, %residual) : [i1](buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Recursive proposals own a contiguous private hidden plane.
command.program.def public @flash_next_mtp_input(%neural_enabled: i1) launch(%parameters: buffer, %target_parameters: buffer, %epoch: buffer, %ids: buffer, %hidden: buffer, %residual: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %hidden_stride = index.constant 20480 : offset
  %hidden_bytes = index.scale %tokens, %hidden_stride : index, offset -> offset
  %normalized_hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %hidden_norm = command.parameter %parameters, "blk.48.nextn.hnorm.weight" : view<10240xf32>
  %hidden_width = index.constant 10240 : index
  kernel.launch @flash_next_mtp_normalize[%neural_enabled](%hidden_width, %epoch, %hidden, %hidden_norm, %normalized_hidden) : [i1](index, buffer, buffer, view<10240xf32>, buffer)
  %remapped = scalar.constant false : i1
  command.program.launch @flash_next_mtp_embed_project[%neural_enabled, %remapped](%parameters, %target_parameters, %epoch, %epoch, %epoch, %ids, %normalized_hidden, %residual) : [i1, i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Catch-up binds immutable target rows and restored first-row carry separately.
// Normalization finishes reading carry before projection overwrites residual.
command.program.def @flash_next_mtp_warm_input() launch(%parameters: buffer, %target_parameters: buffer, %epoch: buffer, %mapping: buffer, %origins: buffer, %ids: buffer, %target: buffer, %residual: buffer) {
  %neural_enabled = scalar.constant true : i1
  %tokens = config.get @flash_next.token_count : index
  %hidden_stride = index.constant 20480 : offset
  %hidden_bytes = index.scale %tokens, %hidden_stride : index, offset -> offset
  %normalized_hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %hidden_norm = command.parameter %parameters, "blk.48.nextn.hnorm.weight" : view<10240xf32>
  kernel.launch @flash_next_mtp_normalize_warm(%epoch, %mapping, %origins, %residual, %target, %hidden_norm, %normalized_hidden) : (buffer, buffer, buffer, buffer, buffer, view<10240xf32>, buffer)
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  %ordinary = index.constant 0 : index
  %remapped = index.cmp ne, %mixed_inputs, %ordinary : index
  command.program.launch @flash_next_mtp_embed_project[%neural_enabled, %remapped](%parameters, %target_parameters, %epoch, %mapping, %origins, %ids, %normalized_hidden, %residual) : [i1, i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

config.decl @flash_next.span_capacity : %value: index where [range(%value, 1, 2147483647)]

config.decl @flash_next.pool_capacity : %value: index where [range(%value, 64, 4194304), multiple_of(%value, 64)]

kernel.decl @flash_next_mtp_compact() launch(%accepted: buffer, %compact: buffer, %origins: buffer)

kernel.decl @flash_next_mtp_restore() launch(%epoch: buffer, %rows: buffer, %carry: buffer, %cache: buffer, %hidden: buffer)

kernel.decl @flash_next_mtp_ids() launch(%epoch: buffer, %origins: buffer, %target_tokens: buffer, %tokens: buffer, %rows: buffer, %cache: buffer)

kernel.decl @flash_next_mtp_commit() launch(%epoch: buffer, %rows: buffer, %origins: buffer, %target: buffer, %cache: buffer, %ids: buffer, %carry: buffer)

kernel.decl @flash_next_map_tokens(%neural_enabled: i1) launch(%epoch: buffer, %mapping: buffer)

command.program.decl @flash_next_hc_attn(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer)

command.program.decl @flash_next_qsa_append(%neural_enabled: i1, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset, %mixed_inputs: index, %remapped: i1, %origin_capacity: index) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %capture: buffer, %inputs: buffer, %origins: buffer)

// Catch-up consumes accepted target rows, not recursive draft hidden. Restore
// the committed partial block before replacing rejected entries. The first
// hidden row comes from old carry; publication follows every old-carry reader.
// Separate parameter roots select contiguous input, mixer, and append groups
// from the proposal's allocation without repacking or reading weights again.
command.program.def public @flash_next_mtp_warm() launch(%input_parameters: buffer, %mixer_parameters: buffer, %append_parameters: buffer, %embedding_parameters: buffer, %target_hidden: buffer, %accepted: buffer, %rows: buffer, %cache: buffer, %carry: buffer, %target_tokens: buffer) {
  %neural_enabled = scalar.constant true : i1
  %tokens = config.get @flash_next.token_count : index
  %pool = config.get @flash_next.pool_capacity : index
  %hidden_stride = index.constant 20480 : offset
  %mixed_stride = index.constant 5120 : offset
  %mapping_stride = index.constant 16 : offset
  %id_stride = index.constant 4 : offset
  %hidden_bytes = index.scale %tokens, %hidden_stride : index, offset -> offset
  %mixed_bytes = index.scale %tokens, %mixed_stride : index, offset -> offset
  %mapping_bytes = index.scale %tokens, %mapping_stride : index, offset -> offset
  %id_bytes = index.scale %tokens, %id_stride : index, offset -> offset
  %spans = config.get @flash_next.span_capacity : index
  %header_bytes = index.constant 12 : offset
  %descriptor_stride = index.constant 24 : offset
  %descriptor_bytes = index.scale %spans, %descriptor_stride : index, offset -> offset
  %epoch_bytes = index.add %header_bytes, %descriptor_bytes : offset
  %origin_bytes = index.scale %tokens, %id_stride : index, offset -> offset
  %epoch = buffer.alloca<global> align(16) %epoch_bytes : buffer
  %origins = buffer.alloca<global> align(16) %origin_bytes : buffer
  %residual = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %mixed = buffer.alloca<global> align(256) %mixed_bytes : buffer
  %injection = buffer.alloca<global> align(256) %mapping_bytes : buffer
  %mapping = buffer.alloca<global> align(16) %mapping_bytes : buffer
  %ids = buffer.alloca<global> align(16) %id_bytes : buffer
  kernel.launch @flash_next_mtp_compact(%accepted, %epoch, %origins) : (buffer, buffer, buffer)
  kernel.launch @flash_next_mtp_restore(%epoch, %rows, %carry, %cache, %residual) : (buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_mtp_ids(%epoch, %origins, %target_tokens, %ids, %rows, %cache) : (buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_map_tokens[%neural_enabled](%epoch, %mapping) : [i1](buffer, buffer)
  // Text catch-up reuses its compact IDs. Mixed catch-up keeps the original
  // feature allocation; descriptor compaction only changes the origin map.
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  %ordinary = index.constant 0 : index
  %is_mixed = index.cmp ne, %mixed_inputs, %ordinary : index
  %embedding_inputs = scf.select %is_mixed, %target_tokens, %ids : buffer
  command.program.launch @flash_next_mtp_warm_input(%input_parameters, %embedding_parameters, %epoch, %mapping, %origins, %embedding_inputs, %target_hidden, %residual) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %layer = index.constant 48 : index
  %key_origin = index.constant 0 : offset
  %tail_origin = index.constant 0 : offset
  %main_stride = index.constant 1024 : offset
  %value_origin = index.scale %pool, %main_stride : index, offset -> offset
  %index_origin = index.add %value_origin, %value_origin : offset
  command.program.launch @flash_next_hc_attn[%neural_enabled, %layer](%mixer_parameters, %epoch, %residual, %injection, %mixed) : [i1, index](buffer, buffer, buffer, buffer, buffer)
  // Warm stages specialize verification_width to zero, erasing capture. The
  // residual supplies that unused binding without reserving a capture plane.
  command.program.launch @flash_next_qsa_append[%neural_enabled, %layer, %key_origin, %value_origin, %index_origin, %tail_origin, %mixed_inputs, %is_mixed, %tokens](%append_parameters, %epoch, %mapping, %rows, %mixed, %cache, %residual, %target_tokens, %origins) : [i1, index, offset, offset, offset, offset, index, i1, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_mtp_commit(%epoch, %rows, %origins, %target_hidden, %cache, %ids, %carry) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
