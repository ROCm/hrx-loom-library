// Flash-Next original BF16 image service composition. The direct-import projector fits
// within 1 GiB and publishes 2560 F32 language features per merged patch.
// Shared policy owns upload directories, cohort plans, and execution edges.

type.decl import("finite", "batch") @FiniteBatch

func.decl import("finite", "batch_pack") @finite_batch_pack(%batch: ptr<@FiniteBatch>) -> (buffer, buffer)

func.decl import("finite", "batch_finish") @finite_batch_finish(%batch: ptr<@FiniteBatch>)

func.decl @qwen38_vision_forecast(%feature_columns: index, %parameter_capacity: i64, %ranges: buffer, %descriptors: buffer) -> (i64, i64, i64)

func.decl @qwen38_vision_prepare_batch(%feature_columns: index, %ranges: buffer, %packed: buffer) -> (i32, buffer, buffer)

func.decl @qwen38_vision_prepare_request(%request: buffer) -> (buffer, i64, i64)

func.decl @qwen38_vision_run(%stage: i32, %input: hal.buffer, %output: hal.buffer)

func.def public @qwen38_vision_forecast_memory(%state: buffer, %ranges: buffer, %descriptors: buffer) -> (i64, i64, i64) {
  %feature_columns = index.constant 2560 : index
  %parameter_capacity = scalar.constant 1073741824 : i64
  %private, %retained, %expanded = func.call @qwen38_vision_forecast(%feature_columns, %parameter_capacity, %ranges, %descriptors) : (index, i64, buffer, buffer) -> (i64, i64, i64)
  func.return %private, %retained, %expanded : i64, i64, i64
}

func.def public @text_image_prepare_batch_v1(%state: buffer, %stage_tags: buffer, %batch: ptr<@FiniteBatch>) -> (i32, buffer, buffer) {
  %ranges, %packed = func.call @finite_batch_pack(%batch) : (ptr<@FiniteBatch>) -> (buffer, buffer)
  %feature_columns = index.constant 2560 : index
  %stage, %payload, %plan = func.call @qwen38_vision_prepare_batch(%feature_columns, %ranges, %packed) : (index, buffer, buffer) -> (i32, buffer, buffer)
  func.return %stage, %payload, %plan : i32, buffer, buffer
}

func.def public @text_image_prepare_request_v1(%state: buffer, %request: buffer) -> (buffer, i64, i64) {
  %packet, %units, %tag = func.call @qwen38_vision_prepare_request(%request) : (buffer) -> (buffer, i64, i64)
  func.return %packet, %units, %tag : buffer, i64, i64
}

func.def public @text_image_run_v1(%stage: i32, %input: hal.buffer, %output: hal.buffer) {
  func.call @qwen38_vision_run(%stage, %input, %output) : (i32, hal.buffer, hal.buffer)
  func.return
}

func.def public @text_image_collect_batch_v1(%state: buffer, %batch: ptr<@FiniteBatch>) {
  func.call @finite_batch_finish(%batch) : (ptr<@FiniteBatch>)
  func.return
}
