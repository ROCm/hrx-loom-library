// Target-authoritative speculative verification. Sampling selects the
// accepted frontier before recurrent-state replay; accepted target hidden
// rows remain available to the predictor catch-up stage.

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

config.decl @flash_next.verification_width : %value: index where [range(%value, 0, 8)]

config.decl @qwen38.packet_capacity : %value: index where [range(%value, 2, 2147483646), multiple_of(%value, 2)]

command.decl @flash_next_body() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer)

command.decl @flash_next_output_head() launch(%parameters: buffer, %epoch: buffer, %residual: buffer, %outputs: buffer)

kernel.decl @flash_next_capture_ids() launch(%epoch: buffer, %input: buffer, %capture: buffer, %capture_origin: offset)

command.decl @flash_next_commit_state() launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer, %inputs: buffer)

kernel.decl @qwen38_accept_spans() launch(%mixed_inputs: index, %width: index, %token_capacity: index, %packet_capacity: index, %epoch: buffer, %inputs: buffer, %predictions: buffer, %committed: buffer, %replay: buffer, %results: buffer)

// Target sampling remains authoritative. Speculative cache writes become
// visible only through the accepted frontier; all non-page state commits from
// captured inputs at their original packed token offsets. Caller-owned final
// hidden rows and accepted offsets feed the predictor's catch-up stage.
command.def public @flash_next_verify() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %committed: buffer, %results: buffer) {
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  %tokens = config.get @flash_next.token_count : index
  %width = config.get @flash_next.verification_width : index
  %capture_stride = index.constant 774660 : offset
  %word_bytes = index.constant 4 : offset
  %capture_bytes = index.scale %tokens, %capture_stride : index, offset -> offset
  %prediction_bytes = index.scale %tokens, %word_bytes : index, offset -> offset
  %packet_capacity = config.get @qwen38.packet_capacity : index
  %header_bytes = index.constant 12 : offset
  %descriptor_stride = index.constant 24 : offset
  %descriptor_bytes = index.scale %packet_capacity, %descriptor_stride : index, offset -> offset
  %replay_bytes = index.add %header_bytes, %descriptor_bytes : offset
  %capture = buffer.alloca<global> align(256) %capture_bytes : buffer
  %predictions = buffer.alloca<global> align(256) %prediction_bytes : buffer
  %replay = buffer.alloca<global> align(256) %replay_bytes : buffer
  %ids_prefix = index.constant 774656 : offset
  %ids_origin = index.scale %tokens, %ids_prefix : index, offset -> offset
  kernel.launch @flash_next_capture_ids(%epoch, %input_tokens, %capture, %ids_origin) : (buffer, buffer, buffer, offset)
  command.launch @flash_next_body(%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @flash_next_output_head(%parameters, %epoch, %residual, %predictions) : (buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_accept_spans(%mixed_inputs, %width, %tokens, %packet_capacity, %epoch, %input_tokens, %predictions, %committed, %replay, %results) : (index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @flash_next_commit_state(%parameters, %capture, %replay, %rows, %state, %input_tokens) : (buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
