// All inputs use an embedding request program. Direct targets overlap the
// file read with a separate layer-zero prefix. The speculative target includes
// that layer in its verification recording.

func.decl @declare_stage(%root: buffer, %tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %draft_source: i32, %sidecar_roots: i32, %target_roots: i32, %verification: i64, %packet_capacity: i64, %mixed: i64) -> (i32)

// GPU-produced request metadata is cached host storage; activations and
// cache payload keep their existing device placement.
func.decl import("prepare", "host_storage") @request_storage(%bytes: i64, %alignment: i64) -> (i32)

func.decl @qwen38.control_context(%state: buffer) -> (i64, offset)

func.decl pure @flash_next_ple_request_layout(%tokens: index) -> (offset, offset)

func.def @declare_ple_stages(%tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %packet_capacity: i64, %mixed: i64, %enabled: i1) -> (i32, i32) {
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c0_i64 = scalar.constant 0 : i64
  %requests_root = buffer.constant utf8("flash_next_ple_requests") : buffer
  %requests = func.call @declare_stage(%requests_root, %tokens, %spans, %context, %pool, %model_source, %c0_i32, %c0_i32, %c0_i32, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
  %prefix = scf.if %enabled -> (i32) {
    scf.yield %c0_i32 : i32
  } else {
    %prefix_root = buffer.constant utf8("flash_next_ple_prefix") : buffer
    %stage = func.call @declare_stage(%prefix_root, %tokens, %spans, %context, %pool, %model_source, %c0_i32, %c0_i32, %c1_i32, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    scf.yield %stage : i32
  }
  func.return %requests, %prefix : i32, i32
}

func.def @flash_next_ple_prepare(%tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %packet_capacity: i64, %images: i1, %enabled: i1, %state: buffer) {
  %c0_i32 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %ordinary_requests, %ordinary_prefix = func.call @declare_ple_stages(%tokens, %spans, %context, %pool, %model_source, %packet_capacity, %c0_i64, %enabled) : (i64, i64, i64, i64, i32, i64, i64, i1) -> (i32, i32)
  %mixed_requests, %mixed_prefix = scf.if %images -> (i32, i32) {
    %mixed = scalar.constant 1 : i64
    %requests, %prefix = func.call @declare_ple_stages(%tokens, %spans, %context, %pool, %model_source, %packet_capacity, %mixed, %enabled) : (i64, i64, i64, i64, i32, i64, i64, i1) -> (i32, i32)
    scf.yield %requests, %prefix : i32, i32
  } else {
    scf.yield %c0_i32, %c0_i32 : i32, i32
  }
  %packet_index = index.cast %packet_capacity : i64 to index
  %request_extent, %record_origin = func.call pure @flash_next_ple_request_layout(%packet_index) : (index) -> (offset, offset)
  %request_bytes = index.cast %request_extent : offset to i64
  %request_alignment = scalar.constant 64 : i64
  %request_ordinal = func.call @request_storage(%request_bytes, %request_alignment) : (i64, i64) -> (i32)
  %retained_packet_capacity, %provider_origin = func.call @qwen38.control_context(%state) : (buffer) -> (i64, offset)
  %provider = buffer.view %state[%provider_origin] : buffer -> view<7xi32>
  view.store %ordinary_requests, %provider[0] : i32, view<7xi32>
  view.store %ordinary_prefix, %provider[1] : i32, view<7xi32>
  view.store %mixed_requests, %provider[2] : i32, view<7xi32>
  view.store %mixed_prefix, %provider[3] : i32, view<7xi32>
  view.store %model_source, %provider[4] : i32, view<7xi32>
  view.store %request_ordinal, %provider[5] : i32, view<7xi32>
  view.store %c0_i32, %provider[6] : i32, view<7xi32>
  func.return
}
