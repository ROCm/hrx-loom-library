// Cold preparation for finite PLE requests. The ordinary and mixed-input
// catalogs share the model parameter source; their stage origins and stable
// cached-host request ordinal live in the model-owned control payload.
// Provider words are ordinary requests/prefix, mixed requests/prefix, parameter
// source, request ordinal, and a one-time device-cache initialization flag.

func.decl @declare_stage(%root: buffer, %tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %draft_source: i32, %sidecar_roots: i32, %target_roots: i32, %verification: i64, %packet_capacity: i64, %mixed: i64) -> (i32)

// GPU-produced request metadata is cached host storage; activations and
// cache payload keep their existing device placement.
func.decl import("prepare", "host_storage") @request_storage(%bytes: i64, %alignment: i64) -> (i32)

func.decl @qwen38.control_context(%state: buffer) -> (i64, offset)

func.decl pure @flash_next_ple_request_layout(%tokens: index) -> (offset, offset)

// Append separate shape catalogs after the shared controller's contiguous
// target/proposal/warm/verification/continuation catalog is complete.
func.def @declare_ple_stages(%shapes: buffer, %shape_count: i64, %context: i64, %pool: i64, %model_source: i32, %packet_capacity: i64, %mixed: i64) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c0_i64 = scalar.constant 0 : i64
  %count_word = scalar.assume %shape_count [range(%shape_count, 1, 2147483647)] : i64
  %count = index.cast %count_word : i64 to index
  %pairs = buffer.view %shapes[%origin] : buffer -> view<[%count]x2xi64>
  %requests_root = buffer.constant utf8("flash_next_ple_requests") : buffer
  %prefix_root = buffer.constant utf8("flash_next_ple_prefix") : buffer
  %request_first = scf.for %i = [%begin to %count step %step](%first = %c0_i32 : i32) -> (i32) {
    %tokens = view.load %pairs[%i, 0] : view<[%count]x2xi64> -> i64
    %spans = view.load %pairs[%i, 1] : view<[%count]x2xi64> -> i64
    %stage = func.call @declare_stage(%requests_root, %tokens, %spans, %context, %pool, %model_source, %c0_i32, %c0_i32, %c0_i32, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    %initial = index.cmp eq, %i, %begin : index
    %selected = scf.select %initial, %stage, %first : i32
    scf.yield %selected : i32
  }
  %prefix_first = scf.for %i = [%begin to %count step %step](%first = %c0_i32 : i32) -> (i32) {
    %tokens = view.load %pairs[%i, 0] : view<[%count]x2xi64> -> i64
    %spans = view.load %pairs[%i, 1] : view<[%count]x2xi64> -> i64
    %stage = func.call @declare_stage(%prefix_root, %tokens, %spans, %context, %pool, %model_source, %c0_i32, %c0_i32, %c1_i32, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    %initial = index.cmp eq, %i, %begin : index
    %selected = scf.select %initial, %stage, %first : i32
    scf.yield %selected : i32
  }
  func.return %request_first, %prefix_first : i32, i32
}

func.def @flash_next_ple_prepare(%shapes: buffer, %shape_count: i64, %context: i64, %pool: i64, %model_source: i32, %packet_capacity: i64, %images: i1, %state: buffer) {
  %c0_i32 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %request_first, %prefix_first = func.call @declare_ple_stages(%shapes, %shape_count, %context, %pool, %model_source, %packet_capacity, %c0_i64) : (buffer, i64, i64, i64, i32, i64, i64) -> (i32, i32)
  %mixed_requests, %mixed_prefix = scf.if %images -> (i32, i32) {
    %mixed = scalar.constant 1 : i64
    %requests, %prefix = func.call @declare_ple_stages(%shapes, %shape_count, %context, %pool, %model_source, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i32, i64, i64) -> (i32, i32)
    scf.yield %requests, %prefix : i32, i32
  } else {
    scf.yield %c0_i32, %c0_i32 : i32, i32
  }
  %packet_index = index.cast %packet_capacity : i64 to index
  %request_extent, %record_origin = func.call pure @flash_next_ple_request_layout(%packet_index) : (index) -> (offset, offset)
  %request_bytes = index.cast %request_extent : offset to i64
  %request_alignment = scalar.constant 64 : i64
  %request_ordinal = func.call @request_storage(%request_bytes, %request_alignment) : (i64, i64) -> (i32)
  %retained_packet_capacity, %provider_origin = func.call @qwen38.control_context(%state) : (buffer) -> (i64, offset)
  %provider = buffer.view %state[%provider_origin] : buffer -> view<7xi32>
  view.store %request_first, %provider[0] : i32, view<7xi32>
  view.store %prefix_first, %provider[1] : i32, view<7xi32>
  view.store %mixed_requests, %provider[2] : i32, view<7xi32>
  view.store %mixed_prefix, %provider[3] : i32, view<7xi32>
  view.store %model_source, %provider[4] : i32, view<7xi32>
  view.store %request_ordinal, %provider[5] : i32, view<7xi32>
  view.store %c0_i32, %provider[6] : i32, view<7xi32>
  func.return
}
