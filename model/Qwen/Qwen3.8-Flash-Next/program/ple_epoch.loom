// Finite PLE input stages. Request generation reads retained token history
// without advancing it. The host controller orders cached consumption after
// read completion while layer zero runs independently in the same epoch.
// Cache storage shares the residual allocation, with disjoint source-owned
// ranges for activations, directory, packed rows, and mapping. The separately
// placed request root contains only the live count and finite HAL records.

config.decl @qwen38.packet_capacity : %value: index where [range(%value, 2, 2147483646), multiple_of(%value, 2)]

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @flash_next_map_tokens(%neural_enabled: i1) launch(%epoch: buffer, %mapping: buffer)

command.decl @flash_next_body_range(%outputs_only: i1, %begin: index, %end: index, %stream: i1) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer)

command.decl @flash_next_output_head() launch(%parameters: buffer, %epoch: buffer, %residual: buffer, %outputs: buffer)

kernel.decl @flash_next_ple_hash_ids() launch(%history_origin: offset, %span: buffer, %mapping: buffer, %origins: buffer, %tokens: buffer, %state: buffer, %rows: buffer)

kernel.decl @flash_next_ple_cache_begin() launch(%span: buffer, %cache: buffer, %transfers: buffer)

kernel.decl @flash_next_ple_cache_plan() launch(%header: buffer, %row_ids: buffer, %directory: buffer, %mapping: buffer, %transfers: buffer)

command.def public @flash_next_ple_requests() launch(%residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %tokens: buffer, %transfers: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %map_stride = index.constant 16 : offset
  %id_stride = index.constant 64 : offset
  %map_bytes = index.scale %capacity, %map_stride : index, offset -> offset
  %packet = config.get @qwen38.packet_capacity : index
  %id_bytes = index.scale %packet, %id_stride : index, offset -> offset
  %mapping = buffer.alloca<global> align(16) %map_bytes : buffer
  %ids = buffer.alloca<global> align(64) %id_bytes : buffer
  %enabled = scalar.constant true : i1
  %history = index.constant 115458048 : offset
  kernel.launch @flash_next_map_tokens[%enabled](%epoch, %mapping) : [i1](buffer, buffer)
  kernel.launch @flash_next_ple_hash_ids(%history, %epoch, %mapping, %rows, %tokens, %state, %ids) : (offset, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_ple_cache_begin(%epoch, %residual, %transfers) : (buffer, buffer, buffer)
  kernel.launch @flash_next_ple_cache_plan(%residual, %ids, %residual, %residual, %transfers) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @flash_next_ple_prefix() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %tokens: buffer, %outputs: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 1 : index
  %stream = scalar.constant true : i1
  %outputs_only = scalar.constant true : i1
  command.launch @flash_next_body_range[%outputs_only, %begin, %end, %stream](%parameters, %residual, %epoch, %rows, %state, %tokens, %residual) : [i1, index, index, i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @flash_next_ple_suffix() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %tokens: buffer, %outputs: buffer) {
  %begin = index.constant 1 : index
  %end = index.constant 48 : index
  %stream = scalar.constant true : i1
  %outputs_only = scalar.constant true : i1
  command.launch @flash_next_body_range[%outputs_only, %begin, %end, %stream](%parameters, %residual, %epoch, %rows, %state, %tokens, %residual) : [i1, index, index, i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @flash_next_output_head(%parameters, %epoch, %residual, %outputs) : (buffer, buffer, buffer, buffer)
  command.return
}
