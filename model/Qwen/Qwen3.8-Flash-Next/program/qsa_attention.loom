// Sparse-attention cache append and query composition. Paged K/V and
// compressed index blocks share physical page ownership, while partial-block
// history publishes to the retained writer. The cache arena and working-state
// buffer may alias; their row-directory offsets are relative to their own root.

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

command.decl @qsa_split_attention(%query_count: index, %maximum_queries: index, %key_origin: offset, %value_origin: offset) launch(%span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %query_gate: buffer, %arena: buffer, %selected_blocks: buffer, %output: buffer)

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

config.decl @flash_next.context_capacity : %value: index where [range(%value, 64, 262144), multiple_of(%value, 64)]

func.decl pure @qsa_score_layout(%tokens: index, %context: index) -> (index, offset, offset) where [range(%tokens, 1, 32768), range(%context, 64, 262144), multiple_of(%context, 64)]

command.decl @flash_next_capture_inputs(%neural_enabled: i1, %prefix_bytes: offset, %row_bytes: offset) launch(%epoch: buffer, %input: buffer, %capture: buffer)

func.decl pure @qsa_index_projection_rows(%count: index) -> (index, index)

kernel.decl @qsa_index_dot(%count: index, %width: index) launch(%width_arg: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qsa_index_matrix(%count: index, %width: index) launch(%width_arg: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

command.def @qsa_index_projection(%count: index, %width: index) launch(%span: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %dots, %matrix = func.call pure @qsa_index_projection_rows(%count) : (index) -> (index, index)
  command.concurrent {
    kernel.launch @qsa_index_dot[%dots, %width](%width, %input, %weight, %output) : [index, index](index, buffer, buffer, buffer)
    kernel.launch @qsa_index_matrix[%matrix, %width](%width, %span, %input, %weight, %output) : [index, index](index, buffer, buffer, buffer, buffer)
  }
  command.return
}

kernel.decl @qsa_prepare_queries(%neural_enabled: i1, %head_capacity: index) launch(%width: index, %heads: index, %head_stride: index, %span: buffer, %mapping: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qsa_prepare_queries_mixed(%neural_enabled: i1, %head_capacity: index) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %width: index, %heads: index, %head_stride: index, %span: buffer, %mapping: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qsa_prepare_queries_remapped(%neural_enabled: i1, %head_capacity: index) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %width: index, %heads: index, %head_stride: index, %span: buffer, %mapping: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qsa_pool_blocks(%neural_enabled: i1) launch(%tail_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %raw: buffer, %arena: buffer, %pooled: buffer)

kernel.decl @qsa_prepare_blocks(%neural_enabled: i1) launch(%coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer, %working: buffer)

kernel.decl @qsa_prepare_blocks_mixed(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer, %working: buffer)

kernel.decl @qsa_prepare_blocks_remapped(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer, %working: buffer)

kernel.decl @qsa_publish_tail(%neural_enabled: i1) launch(%tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_coordinates_text(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_coordinates_mixed(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_coordinates_remapped(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_append_kv(%neural_enabled: i1) launch(%key_origin: offset, %value_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %keys: buffer, %values: buffer, %weight: buffer, %arena: buffer)

kernel.decl @qsa_append_kv_mixed(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %key_origin: offset, %value_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %keys: buffer, %values: buffer, %weight: buffer, %arena: buffer)

kernel.decl @qsa_append_kv_remapped(%neural_enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %key_origin: offset, %value_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %keys: buffer, %values: buffer, %weight: buffer, %arena: buffer)

func.decl pure @qsa_cohort_capacity() -> (index)

kernel.decl @qsa_merge_cohorts(%cohort_tokens: index) launch(%epoch: buffer, %selected: buffer, %cohorts: buffer)

kernel.decl @qsa_cohort_attention(%cohort_tokens: index) launch(%key_origin: offset, %value_origin: offset, %epoch: buffer, %rows: buffer, %queries: buffer, %gates: buffer, %arena: buffer, %cohorts: buffer, %output: buffer)

func.decl pure @qsa_tile_rows(%end: index, %begin: index, %capacity: index) -> (index)

kernel.decl @qsa_score_blocks(%tile_rows: index) launch(%query_begin_arg: index, %index_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %arena: buffer, %scores: buffer)

kernel.decl @qsa_score_tiled(%tile_rows: index) launch(%query_begin_arg: index, %index_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %arena: buffer, %scores: buffer)

kernel.decl @qsa_select_blocks(%tile_rows: index) launch(%query_begin_arg: index, %span: buffer, %mapping: buffer, %scores: buffer, %selected: buffer)

template.decl @flash_next.project_dense_q8(%split_scales: i1, %workload_count: index, %inputs: index, %outputs: index, %blocks: index, %span: buffer, %input: buffer, %weight: view<[%outputs]x[%blocks]x34xi8>, %output: buffer)

// Append publishes the same paged K/V, complete index blocks, and partial tail
// for ordinary attention and predictor catch-up. No query or MoE work is needed
// when target acceptance supplies the hidden rows being caught up.
command.def public @flash_next_qsa_append(%workload_count: index, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset, %mixed_inputs: index, %remapped: i1, %origin_capacity: index) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %working: buffer, %capture: buffer, %inputs: buffer, %origins: buffer) {
  %empty_count = index.constant 0 : index
  %neural_enabled = index.cmp ne, %workload_count, %empty_count : index
  %plain = index.constant 0 : index
  %mixed = index.cmp ne, %mixed_inputs, %plain : index
  %last_target = index.constant 47 : index
  %predictor_layer = index.constant 48 : index
  %predictor = index.cmp eq, %layer, %predictor_layer : index
  %publishes_coordinates = index.cmp uge, %layer, %last_target : index
  %target_coordinate = index.constant 115651840 : offset
  %predictor_coordinate = index.constant 768 : offset
  %coordinate_origin = scf.select %predictor, %predictor_coordinate, %target_coordinate : offset
  %tokens = config.get @flash_next.token_count : index
  %c4 = index.constant 4 : index
  %index_width = index.constant 128 : index
  %small_width = index.constant 512 : index
  %hidden_width = index.constant 2560 : index
  %index_key_bytes = index.constant 256 : offset
  %small_row_bytes = index.constant 1024 : offset
  %small_bytes = index.scale %tokens, %small_row_bytes : index, offset -> offset
  %raw_bytes = index.scale %tokens, %index_key_bytes : index, offset -> offset
  %index_key_raw = buffer.alloca<global> align(256) %raw_bytes : buffer
  %pooled = buffer.alloca<global> align(256) %raw_bytes : buffer
  %keys = buffer.alloca<global> align(256) %small_bytes : buffer
  %values = buffer.alloca<global> align(256) %small_bytes : buffer
  %index_key_weight = command.parameter %parameters, "blk.{}.indexer.k_proj.weight"[%layer] : view<128x2560xbf16>
  %index_key_norm = command.parameter %parameters, "blk.{}.indexer.k_norm.weight"[%layer] : view<128xf32>
  %key_weight = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<512x80x34xi8>
  %value_weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<512x80x34xi8>
  %key_norm = command.parameter %parameters, "blk.{}.attn_k_norm.weight"[%layer] : view<256xf32>
  command.launch @qsa_index_projection[%workload_count, %index_width](%span, %input, %index_key_weight, %index_key_raw) : [index, index](buffer, buffer, view<128x2560xbf16>, buffer)
  %capture_base = index.constant 771584 : offset
  %ordinal = index.div %layer, %c4 : index
  %capture_relative = index.scale %ordinal, %index_key_bytes : index, offset -> offset
  %capture_prefix = index.add %capture_base, %capture_relative : offset
  command.launch @flash_next_capture_inputs[%neural_enabled, %capture_prefix, %index_key_bytes](%span, %index_key_raw, %capture) : [i1, offset, offset](buffer, buffer, buffer)
  kernel.launch @qsa_pool_blocks[%neural_enabled](%tail_origin, %span, %mapping, %rows, %index_key_raw, %working, %pooled) : [i1](offset, buffer, buffer, buffer, buffer, buffer, buffer)
  scf.if %mixed {
    scf.if %remapped {
      kernel.launch @qsa_prepare_blocks_remapped[%neural_enabled](%tokens, %origin_capacity, %inputs, %origins, %coordinate_origin, %index_origin, %span, %mapping, %rows, %pooled, %index_key_norm, %arena, %working) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, view<128xf32>, buffer, buffer)
    } else {
      kernel.launch @qsa_prepare_blocks_mixed[%neural_enabled](%tokens, %origin_capacity, %inputs, %origins, %coordinate_origin, %index_origin, %span, %mapping, %rows, %pooled, %index_key_norm, %arena, %working) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, view<128xf32>, buffer, buffer)
    }
  } else {
    kernel.launch @qsa_prepare_blocks[%neural_enabled](%coordinate_origin, %index_origin, %span, %mapping, %rows, %pooled, %index_key_norm, %arena, %working) : [i1](offset, offset, buffer, buffer, buffer, buffer, view<128xf32>, buffer, buffer)
  }
  scf.if %publishes_coordinates {
    scf.if %mixed {
      scf.if %remapped {
        kernel.launch @qsa_publish_coordinates_remapped[%neural_enabled](%tokens, %origin_capacity, %coordinate_origin, %inputs, %origins, %tail_origin, %span, %rows, %index_key_raw, %working) : [i1](index, index, offset, buffer, buffer, offset, buffer, buffer, buffer, buffer)
      } else {
        kernel.launch @qsa_publish_coordinates_mixed[%neural_enabled](%tokens, %origin_capacity, %coordinate_origin, %inputs, %origins, %tail_origin, %span, %rows, %index_key_raw, %working) : [i1](index, index, offset, buffer, buffer, offset, buffer, buffer, buffer, buffer)
      }
    } else {
      kernel.launch @qsa_publish_coordinates_text[%neural_enabled](%tokens, %origin_capacity, %coordinate_origin, %inputs, %origins, %tail_origin, %span, %rows, %index_key_raw, %working) : [i1](index, index, offset, buffer, buffer, offset, buffer, buffer, buffer, buffer)
    }
  } else {
    kernel.launch @qsa_publish_tail[%neural_enabled](%tail_origin, %span, %rows, %index_key_raw, %working) : [i1](offset, buffer, buffer, buffer, buffer)
  }
  %key_weight_block_size = index.constant 32 : index
  %key_weight_blocks = index.div %hidden_width, %key_weight_block_size : index
  %key_weight_shaped = view.refine %key_weight : view<512x80x34xi8> -> view<[%small_width]x[%key_weight_blocks]x34xi8>
  %dense_weight_layout0 = scalar.constant false : i1
  template.apply<@flash_next.project_dense_q8>(%dense_weight_layout0, %workload_count, %hidden_width, %small_width, %key_weight_blocks, %span, %input, %key_weight_shaped, %keys) : (i1, index, index, index, index, buffer, buffer, view<[%small_width]x[%key_weight_blocks]x34xi8>, buffer)
  %value_weight_block_size = index.constant 32 : index
  %value_weight_blocks = index.div %hidden_width, %value_weight_block_size : index
  %value_weight_shaped = view.refine %value_weight : view<512x80x34xi8> -> view<[%small_width]x[%value_weight_blocks]x34xi8>
  %dense_weight_layout1 = scalar.constant false : i1
  template.apply<@flash_next.project_dense_q8>(%dense_weight_layout1, %workload_count, %hidden_width, %small_width, %value_weight_blocks, %span, %input, %value_weight_shaped, %values) : (i1, index, index, index, index, buffer, buffer, view<[%small_width]x[%value_weight_blocks]x34xi8>, buffer)
  scf.if %mixed {
    scf.if %remapped {
      kernel.launch @qsa_append_kv_remapped[%neural_enabled](%tokens, %origin_capacity, %inputs, %origins, %key_origin, %value_origin, %span, %mapping, %rows, %keys, %values, %key_norm, %arena) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, buffer, view<256xf32>, buffer)
    } else {
      kernel.launch @qsa_append_kv_mixed[%neural_enabled](%tokens, %origin_capacity, %inputs, %origins, %key_origin, %value_origin, %span, %mapping, %rows, %keys, %values, %key_norm, %arena) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, buffer, view<256xf32>, buffer)
    }
  } else {
    kernel.launch @qsa_append_kv[%neural_enabled](%key_origin, %value_origin, %span, %mapping, %rows, %keys, %values, %key_norm, %arena) : [i1](offset, offset, buffer, buffer, buffer, buffer, buffer, view<256xf32>, buffer)
  }
  command.return
}

command.def public @flash_next_qsa_attention(%workload_count: index, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset, %mixed_inputs: index) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %working: buffer, %output: buffer, %capture: buffer, %inputs: buffer) {
  %remapped = scalar.constant false : i1
  %capacity = config.get @flash_next.token_count : index
  command.launch @flash_next_qsa_append[%workload_count, %layer, %key_origin, %value_origin, %index_origin, %tail_origin, %mixed_inputs, %remapped, %capacity](%parameters, %span, %mapping, %rows, %input, %arena, %working, %capture, %inputs, %span) : [index, index, offset, offset, offset, offset, index, i1, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.launch @flash_next_qsa_queries[%workload_count, %layer, %key_origin, %value_origin, %index_origin, %tail_origin, %mixed_inputs, %remapped, %capacity](%parameters, %span, %mapping, %rows, %input, %arena, %output, %capture, %inputs, %span) : [index, index, offset, offset, offset, offset, index, i1, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @flash_next_qsa_queries(%workload_count: index, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset, %mixed_inputs: index, %remapped: i1, %origin_capacity: index) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %output: buffer, %capture: buffer, %inputs: buffer, %origins: buffer) {
  %empty_count = index.constant 0 : index
  %neural_enabled = index.cmp ne, %workload_count, %empty_count : index
  %plain = index.constant 0 : index
  %mixed = index.cmp ne, %mixed_inputs, %plain : index
  %tokens = config.get @flash_next.token_count : index
  %capacity = config.get @flash_next.context_capacity : index
  %c4 = index.constant 4 : index
  %c24 = index.constant 24 : index
  %index_width = index.constant 128 : index
  %head_width = index.constant 256 : index
  %small_width = index.constant 512 : index
  %hidden_width = index.constant 2560 : index
  %output_width = index.constant 6144 : index
  %query_gate_width = index.constant 12288 : index
  %small_row_bytes = index.constant 1024 : offset
  %query_row_bytes = index.constant 24576 : offset
  %small_bytes = index.scale %tokens, %small_row_bytes : index, offset -> offset
  %query_bytes = index.scale %tokens, %query_row_bytes : index, offset -> offset
  %query_capacity, %output_bytes, %workspace_bytes = func.call pure @qsa_score_layout(%tokens, %capacity) : (index, index) -> (index, offset, offset)
  %index_query_raw = buffer.alloca<global> align(256) %small_bytes : buffer
  %index_query = buffer.alloca<global> align(256) %small_bytes : buffer
  %query_gate = buffer.alloca<global> align(256) %query_bytes : buffer
  %query = buffer.alloca<global> align(256) %output_bytes : buffer
  // Selection consumes every score before attention writes its first output.
  %workspace = buffer.alloca<global> align(256) %workspace_bytes : buffer
  %selection_row_bytes = index.constant 2048 : offset
  %selection_bytes = index.scale %tokens, %selection_row_bytes : index, offset -> offset
  %selected = buffer.alloca<global> align(256) %selection_bytes : buffer
  %index_query_weight = command.parameter %parameters, "blk.{}.indexer.q_proj.weight"[%layer] : view<512x2560xbf16>
  %index_query_norm = command.parameter %parameters, "blk.{}.indexer.q_norm.weight"[%layer] : view<128xf32>
  %query_weight = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<12288x80x34xi8>
  %query_norm = command.parameter %parameters, "blk.{}.attn_q_norm.weight"[%layer] : view<256xf32>
  %output_weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<2560x192x34xi8>
  command.launch @qsa_index_projection[%workload_count, %small_width](%span, %input, %index_query_weight, %index_query_raw) : [index, index](buffer, buffer, view<512x2560xbf16>, buffer)
  scf.if %mixed {
    scf.if %remapped {
      kernel.launch @qsa_prepare_queries_remapped[%neural_enabled, %c4](%tokens, %origin_capacity, %inputs, %origins, %index_width, %c4, %index_width, %span, %mapping, %index_query_raw, %index_query_norm, %index_query) : [i1, index](index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, view<128xf32>, buffer)
    } else {
      kernel.launch @qsa_prepare_queries_mixed[%neural_enabled, %c4](%tokens, %origin_capacity, %inputs, %origins, %index_width, %c4, %index_width, %span, %mapping, %index_query_raw, %index_query_norm, %index_query) : [i1, index](index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, view<128xf32>, buffer)
    }
  } else {
    kernel.launch @qsa_prepare_queries[%neural_enabled, %c4](%index_width, %c4, %index_width, %span, %mapping, %index_query_raw, %index_query_norm, %index_query) : [i1, index](index, index, index, buffer, buffer, buffer, view<128xf32>, buffer)
  }
  %query_weight_block_size = index.constant 32 : index
  %query_weight_blocks = index.div %hidden_width, %query_weight_block_size : index
  %query_weight_shaped = view.refine %query_weight : view<12288x80x34xi8> -> view<[%query_gate_width]x[%query_weight_blocks]x34xi8>
  %dense_weight_layout2 = scalar.constant false : i1
  template.apply<@flash_next.project_dense_q8>(%dense_weight_layout2, %workload_count, %hidden_width, %query_gate_width, %query_weight_blocks, %span, %input, %query_weight_shaped, %query_gate) : (i1, index, index, index, index, buffer, buffer, view<[%query_gate_width]x[%query_weight_blocks]x34xi8>, buffer)
  scf.if %mixed {
    scf.if %remapped {
      kernel.launch @qsa_prepare_queries_remapped[%neural_enabled, %c24](%tokens, %origin_capacity, %inputs, %origins, %head_width, %c24, %small_width, %span, %mapping, %query_gate, %query_norm, %query) : [i1, index](index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, view<256xf32>, buffer)
    } else {
      kernel.launch @qsa_prepare_queries_mixed[%neural_enabled, %c24](%tokens, %origin_capacity, %inputs, %origins, %head_width, %c24, %small_width, %span, %mapping, %query_gate, %query_norm, %query) : [i1, index](index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, view<256xf32>, buffer)
    }
  } else {
    kernel.launch @qsa_prepare_queries[%neural_enabled, %c24](%head_width, %c24, %small_width, %span, %mapping, %query_gate, %query_norm, %query) : [i1, index](index, index, index, buffer, buffer, buffer, view<256xf32>, buffer)
  }
  %query_zero = index.constant 0 : index
  %matrix_threshold = index.constant 32 : index
  %matrix_cohort = index.cmp uge, %workload_count, %matrix_threshold : index
  // Scoring shares one key panel across four queries, independently of the
  // larger cohort needed to amortize the final attention union.
  %matrix_score = index.cmp uge, %query_capacity, %c4 : index
  scf.for %query_begin = [%query_zero to %tokens step %query_capacity] unroll {
    %tile_rows = func.call pure @qsa_tile_rows(%workload_count, %query_begin, %query_capacity) : (index, index, index) -> (index)
    scf.if %matrix_score {
      kernel.launch @qsa_score_tiled[%tile_rows](%query_begin, %index_origin, %span, %mapping, %rows, %index_query, %arena, %workspace) : [index](index, offset, buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      kernel.launch @qsa_score_blocks[%tile_rows](%query_begin, %index_origin, %span, %mapping, %rows, %index_query, %arena, %workspace) : [index](index, offset, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    kernel.launch @qsa_select_blocks[%tile_rows](%query_begin, %span, %mapping, %workspace, %selected) : [index](index, buffer, buffer, buffer, buffer)
  }
  // Consecutive queries reuse a selected-key union. Small epochs instead
  // partition keys across waves. Both paths publish the same attended rows.
  %cohort_tokens = scf.select %matrix_cohort, %workload_count, %query_zero : index
  %split_tokens = scf.select %matrix_cohort, %query_zero, %workload_count : index
  %one_query = index.constant 1 : index
  %split_limit = index.sub %matrix_threshold, %one_query : index
  %maximum_split = index.min %tokens, %split_limit : index
  %can_form_cohort = index.cmp uge, %tokens, %matrix_threshold : index
  command.concurrent {
    command.serial {
      scf.if %can_form_cohort {
        %cohort_count = func.call pure @qsa_cohort_capacity() : () -> (index)
        %cohort_record_bytes = index.constant 8224 : offset
        %cohort_bytes = index.scale %cohort_count, %cohort_record_bytes : index, offset -> offset
        %cohorts = buffer.alloca<global> align(16) %cohort_bytes : buffer
        kernel.launch @qsa_merge_cohorts[%cohort_tokens](%span, %selected, %cohorts) : [index](buffer, buffer, buffer)
        kernel.launch @qsa_cohort_attention[%cohort_tokens](%key_origin, %value_origin, %span, %rows, %query, %query_gate, %arena, %cohorts, %workspace) : [index](offset, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      }
    }
    command.launch @qsa_split_attention[%split_tokens, %maximum_split, %key_origin, %value_origin](%span, %mapping, %rows, %query, %query_gate, %arena, %selected, %workspace) : [index, index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  }
  %output_weight_block_size = index.constant 32 : index
  %output_weight_blocks = index.div %output_width, %output_weight_block_size : index
  %output_weight_shaped = view.refine %output_weight : view<2560x192x34xi8> -> view<[%hidden_width]x[%output_weight_blocks]x34xi8>
  %dense_weight_layout3 = scalar.constant false : i1
  template.apply<@flash_next.project_dense_q8>(%dense_weight_layout3, %workload_count, %output_width, %hidden_width, %output_weight_blocks, %span, %workspace, %output_weight_shaped, %output) : (i1, index, index, index, index, buffer, buffer, view<[%hidden_width]x[%output_weight_blocks]x34xi8>, buffer)
  command.return
}
