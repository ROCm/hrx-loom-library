// GDN residual composition over four BF16 streams. The caller owns retained
// reader/writer rows and the arena; dispatch owns intermediate projections,
// recurrence, and gating before residual publication.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

command.program.decl @flash_next_hc_attn(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer)

command.program.decl @flash_next_gdn_attention(%layer: index, %state_origin: offset) launch(%parameters: buffer, %span: buffer, %input: buffer, %rows: buffer, %arena: buffer, %output: buffer, %capture: buffer)

kernel.decl @hc_combine(%neural_enabled: i1) launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer)

// The linear-attention half of a layer preserves the four residual streams.
// Only the active span advances recurrent state and publishes residual rows.
command.program.def public @flash_next_gdn_residual(%layer: index, %state_origin: offset) launch(%parameters: buffer, %span: buffer, %residual: buffer, %rows: buffer, %arena: buffer, %output: buffer, %capture: buffer) {
  %neural_enabled = scalar.constant true : i1
  %tokens = config.get @flash_next.token_count : index
  %hidden_row_bytes = index.constant 5120 : offset
  %injection_row_bytes = index.constant 16 : offset
  %hidden_bytes = index.scale %tokens, %hidden_row_bytes : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_row_bytes : index, offset -> offset
  %mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  command.program.launch @flash_next_hc_attn[%neural_enabled, %layer](%parameters, %span, %residual, %injection, %mixed) : [i1, index](buffer, buffer, buffer, buffer, buffer)
  command.program.launch @flash_next_gdn_attention[%layer, %state_origin](%parameters, %span, %mixed, %rows, %arena, %projected, %capture) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @hc_combine[%neural_enabled](%span, %residual, %projected, %injection, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
  command.return
}
