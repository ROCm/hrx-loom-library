// Parameter preparation policy for the model's GDN Q8 projections. Original
// scales and codes are permuted in place, without conversion or size changes.
// The loader reloads checkpoint bytes before each reactivation.
func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.def @has_tensor_suffix(%key: buffer, %prefix_length: offset, %suffix: buffer) -> (i1) {
  %length = buffer.length %key
  %suffix_length = buffer.length %suffix
  %minimum_length = index.add %prefix_length, %suffix_length : offset
  %fits = index.cmp uge, %length, %minimum_length : offset
  %matches = scf.if %fits -> (i1) {
    %origin = index.constant 0 : offset
    %suffix_origin = index.sub %length, %suffix_length : offset
    %comparison = buffer.compare %key[%suffix_origin], %suffix[%origin], %suffix_length
    %c0 = scalar.constant 0 : i32
    %equal = scalar.cmpi eq, %comparison, %c0 : i32
    scf.yield %equal : i1
  } else {
    %no = scalar.constant false : i1
    scf.yield %no : i1
  }
  func.return %matches : i1
}

// Only the named model tensors share this representation. Ordinary, mixed,
// and speculative consumers reach the same explicitly bound projection family.
func.def public @prepare_weight(%key: buffer) -> (i64) {
  %prefix = buffer.constant utf8("blk.") : buffer
  %length = buffer.length %key
  %prefix_length = buffer.length %prefix
  %fits = index.cmp uge, %length, %prefix_length : offset
  %bytes = scf.if %fits -> (i64) {
    %origin = index.constant 0 : offset
    %comparison = buffer.compare %key[%origin], %prefix[%origin], %prefix_length
    %c0 = scalar.constant 0 : i32
    %is_block = scalar.cmpi eq, %comparison, %c0 : i32
    %qkv_suffix = buffer.constant utf8(".attn_qkv.weight") : buffer
    %gate_suffix = buffer.constant utf8(".attn_gate.weight") : buffer
    %output_suffix = buffer.constant utf8(".ssm_out.weight") : buffer
    %is_qkv = func.call @has_tensor_suffix(%key, %prefix_length, %qkv_suffix) : (buffer, offset, buffer) -> (i1)
    %is_gate = func.call @has_tensor_suffix(%key, %prefix_length, %gate_suffix) : (buffer, offset, buffer) -> (i1)
    %is_output = func.call @has_tensor_suffix(%key, %prefix_length, %output_suffix) : (buffer, offset, buffer) -> (i1)
    %input_projection = scalar.ori %is_qkv, %is_gate : i1
    %gdn_projection = scalar.ori %input_projection, %is_output : i1
    %selected = scalar.andi %is_block, %gdn_projection : i1
    %size = scf.if %selected -> (i64) {
      %hidden = scalar.constant 2560 : i64
      %value = scalar.constant 6144 : i64
      %qkv = scalar.constant 10240 : i64
      %inputs = scf.select %is_output, %value, %hidden : i64
      %input_outputs = scf.select %is_qkv, %qkv, %value : i64
      %outputs = scf.select %is_output, %hidden, %input_outputs : i64
      %root = buffer.constant utf8("flash_next_prepare_q8") : buffer
      %tag = scalar.constant 0 : i64
      %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
      %input_key = buffer.constant utf8("flash_next.prepare_inputs") : buffer
      %output_key = buffer.constant utf8("flash_next.prepare_outputs") : buffer
      func.call @config_i64(%stage, %input_key, %inputs) : (i32, buffer, i64)
      func.call @config_i64(%stage, %output_key, %outputs) : (i32, buffer, i64)
      %block_width = scalar.constant 32 : i64
      %block_bytes = scalar.constant 34 : i64
      %blocks = scalar.divui %inputs, %block_width : i64
      %row_bytes = scalar.muli %blocks, %block_bytes : i64
      %total = scalar.muli %row_bytes, %outputs : i64
      scf.yield %total : i64
    } else {
      %empty = scalar.constant 0 : i64
      scf.yield %empty : i64
    }
    scf.yield %size : i64
  } else {
    %empty = scalar.constant 0 : i64
    scf.yield %empty : i64
  }
  func.return %bytes : i64
}
