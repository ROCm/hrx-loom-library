// Sparse-attention index projections, normalized rotary queries, compressed
// blocks, and partial tails. Immutable anchors supply old prefixes; only the
// selected writer publishes the next retained tail.

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

config.decl @flash_next.verification_width : %value: index where [range(%value, 0, 16)]

config.decl @flash_next.span_capacity : %value: index where [range(%value, 1, 2147483647)]

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

func.decl @flash_next_span_publishes(%verification: index, %epoch: buffer, %span: index) -> (i1)

func.decl @flash_next_span_count(%epoch: buffer) -> (index)

func.decl pure @flash_next_span_workers(%capacity: index) -> (index)

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl pure @flash_next_token_workers(%capacity: index, %groups_per_token: index, %units: index) -> (index)

func.decl @flash_next_token_rotary(%mapping: buffer, %token: index) -> (index)

func.decl @flash_next_token_coordinate(%mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %mapping: buffer, %inputs: buffer, %origins: buffer, %token: index, %lane: index) -> (index)

func.decl @qsa_group_coordinate(%mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %logical: index, %first: index, %source_first: index, %begin: index, %row: index, %axis: index, %inputs: buffer, %origins: buffer, %rows: buffer, %arena: buffer) -> (index)

func.decl @flash_next_token_binding(%mapping: buffer, %token: index) -> (index, index, index, index)

func.decl @flash_next_physical_token(%rows: buffer, %row: index, %position: index) -> (index)

func.decl @flash_next_cache_origin(%rows: buffer, %row: index, %plane_origin: offset) -> (offset)

func.decl @flash_next_row_state(%rows: buffer, %row: index, %position: index, %layer_origin: offset) -> (offset, offset)

amdgpu.target<gfx11-generic> @qsa_wave32 {subgroup_size = 32}

func.decl @qsa_rotary_coefficients(%position: index, %pair: index) -> (bf16, bf16)

template.decl @tensor.matrix.store_bf16_wave32(%remaining_rows: index, %outputs: index, %fragment_row: index, %result_column: index, %result: vector<8xf32>, %output_view: view<[%remaining_rows]x[%outputs]xbf16>)

// A nonempty packed row tile shares original BF16 operands across 128 tokens
// and 128 features. Eight wave32 groups retain eight F32 fragments each.
// One K64 input/weight panel lives in LDS; read-ahead retains the next panel
// in registers. Inactive rows and out-of-range features never publish storage.
func.def inline @qsa_bf16_matrix(%capacity: index, %end: index, %outputs: index, %input_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %input, %weight, %output = buffer.assume.noalias %input_arg, %weight_arg, %output_arg : buffer, buffer, buffer
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %tile = index.constant 128 : index
  %threads = index.constant 256 : index
  %inputs = index.constant 2560 : index
  %stages = index.constant 40 : index
  %stage_bytes = index.constant 18432 : offset
  %group = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %first = index.mul %batch, %tile : index
  %active = index.cmp ult, %first, %end : index
  scf.if %active {
    %channel_base = index.mul %group, %tile : index
    %workitem = kernel.workitem.id<x> : index
    %wave = kernel.subgroup.id : index
    %wave_columns = index.rem %wave, %c2 : index
    %wave_rows = index.div %wave, %c2 : index
    %wave_channel = index.mul %wave_columns, %c64 : index
    %wave_token = index.mul %wave_rows, %c32 : index
    %input_view = buffer.view %input[%origin] : buffer -> view<[%capacity]x2560xbf16>
    %weight_view = buffer.view %weight[%origin] : buffer -> view<[%outputs]x2560xbf16>
    %input_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
    %weight_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
    %input_stage_view = buffer.view %input_stage[%origin] : buffer -> view<128x72xbf16>
    %weight_stage_view = buffer.view %weight_stage[%origin] : buffer -> view<128x72xbf16>
    %weight_layout = encoding.layout.strided [1, %c72] : encoding<layout>
    %weight_fragment = buffer.view %weight_stage[%origin] : buffer -> view<64x128xbf16, %weight_layout>
    %inactive = vector.splatf 0.0 : vector<8xbf16>
    %initial = vector.splatf 0.0 : vector<8x8xf32>
    %result = scf.for %stage = [%c0 to %stages step %c1](%accumulators = %initial : vector<8x8xf32>) -> (vector<8x8xf32>) pipeline(%c2) {
      %input_k = index.mul %stage, %c64 : index
      scf.for %round = [%c0 to %c4 step %c1] unroll schedule(linear) {
        %packet = index.madd %round, %threads, %workitem : index
        %local_row = index.div %packet, %c8 : index
        %within_row = index.rem %packet, %c8 : index
        %local_k = index.mul %within_row, %c8 : index
        %k = index.add %input_k, %local_k : index
        %token = index.add %first, %local_row : index
        %live_token = index.cmp ult, %token, %end : index
        %safe_token = scf.select %live_token, %token, %c0 : index
        %input_loaded = vector.load %input_view[%safe_token, %k] : view<[%capacity]x2560xbf16> -> vector<8xbf16>
        %input_mask = vector.splat %live_token : vector<8xi1>
        %input_values = vector.select %input_mask, %input_loaded, %inactive : vector<8xbf16>
        vector.store %input_values, %input_stage_view[%local_row, %local_k] : vector<8xbf16>, view<128x72xbf16>
        %channel = index.add %channel_base, %local_row : index
        %live_channel = index.cmp ult, %channel, %outputs : index
        %selected_channel = scf.select %live_channel, %channel, %c0 : index
        %safe_channel = index.assume %selected_channel [ge(%selected_channel, 0), lt(%selected_channel, %outputs)] : index
        %weight_loaded = vector.load %weight_view[%safe_channel, %k] : view<[%outputs]x2560xbf16> -> vector<8xbf16>
        %weight_mask = vector.splat %live_channel : vector<8xi1>
        %weight_values = vector.select %weight_mask, %weight_loaded, %inactive : vector<8xbf16>
        vector.store %weight_values, %weight_stage_view[%local_row, %local_k] : vector<8xbf16>, view<128x72xbf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next = scf.for %part = [%c0 to %c4 step %c1](%partial = %accumulators : vector<8x8xf32>) -> (vector<8x8xf32>) unroll schedule(linear) {
        %fragment_k = index.mul %part, %c16 : index
        %tile_values = scf.for %ordinal = [%c0 to %c8 step %c1](%current = %partial : vector<8x8xf32>) -> (vector<8x8xf32>) unroll schedule(linear) {
          %row_fragment = index.div %ordinal, %c4 : index
          %column_fragment = index.rem %ordinal, %c4 : index
          %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
          %fragment_column = index.madd %column_fragment, %c16, %wave_channel : index
          %lhs = vector.fragment.load<lhs> %input_stage_view[%fragment_row, %fragment_k] shape [%c16, %c16] : view<128x72xbf16> -> vector<16xbf16>
          %rhs = vector.fragment.load<rhs> %weight_fragment[%fragment_k, %fragment_column] shape [%c16, %c16] : view<64x128xbf16, %weight_layout> -> vector<16xbf16>
          %values = vector.extract %current[%ordinal] : vector<8x8xf32> -> vector<8xf32>
          %accumulator = vector.fragment<result> %values shape [%c16, %c16] : vector<8xf32>
          %contracted = vector.mma %lhs, %rhs, %accumulator : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
          %updated = vector.insert %contracted into %current[%ordinal] : vector<8xf32>, vector<8x8xf32>
          scf.yield %updated : vector<8x8xf32>
        }
        scf.yield %tile_values : vector<8x8xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next : vector<8x8xf32>
    }
    %remaining = index.sub %end, %first : index
    %element_bytes = index.constant 2 : offset
    %row_bytes = index.scale %outputs, %element_bytes : index, offset -> offset
    %output_origin = index.scale %first, %row_bytes : index, offset -> offset
    %output_view = buffer.view %output[%output_origin] : buffer -> view<[%remaining]x[%outputs]xbf16>
    scf.for %ordinal = [%c0 to %c8 step %c1] unroll schedule(linear) {
      %row_fragment = index.div %ordinal, %c4 : index
      %column_fragment = index.rem %ordinal, %c4 : index
      %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
      %wave_column = index.add %channel_base, %wave_channel : index
      %fragment_column = index.madd %column_fragment, %c16, %wave_column : index
      %values = vector.extract %result[%ordinal] : vector<8x8xf32> -> vector<8xf32>
      template.apply<@tensor.matrix.store_bf16_wave32>(%remaining, %outputs, %fragment_row, %fragment_column, %values, %output_view) : (index, index, index, index, vector<8xf32>, view<[%remaining]x[%outputs]xbf16>)
    }
  }
  func.return
}

// Short indexer projections use one wave per dot. With a full tile of live
// tokens, the matrix projection shares both input and weight panels in LDS.
func.def public pure inline @qsa_index_projection_rows(%count: index) -> (index, index) {
  %tile = index.constant 128 : index
  %c0 = index.constant 0 : index
  %dense = index.cmp uge, %count, %tile : index
  %dots = scf.select %dense, %c0, %count : index
  %matrix = scf.select %dense, %count, %c0 : index
  func.return %dots, %matrix : index, index
}

kernel.def target(@qsa_wave32) @qsa_index_dot(%count: index, %width: index) {
  %c4 = index.constant 4 : index
  %groups = index.div %width, %c4 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %count, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%width: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.assume %width [range(%width, 128, 512), multiple_of(%width, 4)] : index
  %tokens = config.get @flash_next.token_count : index
  %token = kernel.workgroup.id<y> : index
  %group = kernel.workgroup.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %first_lane = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %stride = index.constant 256 : index
  %hidden = index.constant 2560 : index
  %row = index.madd %group, %c4, %wave : index
  %valid_row = index.cmp ult, %row, %rows : index
  %valid_token = index.cmp ult, %token, %tokens : index
  %valid = scalar.andi %valid_row, %valid_token : i1
  scf.if %valid {
    %first = index.mul %lane, %c8 : index
    %origin = index.constant 0 : offset
    %inputs = buffer.view %input[%origin] : buffer -> view<[%tokens]x2560xbf16>
    %weights = buffer.view %weight[%origin] : buffer -> view<[%rows]x2560xbf16>
    %outputs = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%rows]xbf16>
    %c0v = vector.splatf 0.0 : vector<4xf32>
    %partial = scf.for %channel = [%first to %hidden step %stride](%accumulator = %c0v : vector<4xf32>) -> (vector<4xf32>) {
      %values = vector.load %inputs[%token, %channel] : view<[%tokens]x2560xbf16> -> vector<8xbf16>
      %coefficients = vector.load %weights[%row, %channel] : view<[%rows]x2560xbf16> -> vector<8xbf16>
      %next = vector.dot2f %values, %coefficients, %accumulator : vector<8xbf16>, vector<8xbf16>, vector<4xf32>
      scf.yield %next : vector<4xf32>
    }
    %c0 = scalar.constant 0.0 : f32
    %lane_sum = vector.reduce<addf> %partial, %c0 : vector<4xf32>, f32
    %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    %leader = index.cmp eq, %lane, %first_lane : index
    scf.if %leader {
      %packed = scalar.fptrunc %sum : f32 to bf16
      view.store %packed, %outputs[%token, %row] : bf16, view<[%tokens]x[%rows]xbf16>
    }
  }
  kernel.return
}

kernel.def target(@qsa_wave32) @qsa_index_matrix(%count: index, %width: index) {
  %tile = index.constant 128 : index
  %padding = index.constant 127 : index
  %padded_width = index.add %width, %padding : index
  %padded_count = index.add %count, %padding : index
  %columns = index.div %padded_width, %tile : index
  %batches = index.div %padded_count, %tile : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%columns, %batches, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%width: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.assume %width [range(%width, 128, 512), multiple_of(%width, 4)] : index
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  func.call @qsa_bf16_matrix(%tokens, %end, %rows, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

// One wave retains a complete head in lane-private registers. Each lane owns
// up to eight channels separated by the wave width; only the first two rotate.
// The F32 norm accumulation and both BF16 rounding boundaries match the model.
// Input/output regions are disjoint. A stride of 16 writes packed rows, while
// 64 writes one member of a four-token cache panel without touching its peers.
func.def public inline @qsa_normalize_rotate(%width_arg: index, %position: index, %input: buffer, %input_origin: offset, %weight: buffer, %output: buffer, %output_origin: offset, %output_group_stride: index) {
  %width = index.assume %width_arg [range(%width_arg, 128, 256), multiple_of(%width_arg, 32)] : index
  %lane = kernel.subgroup.lane.id : index
  %stride = index.constant 32 : index
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%input_origin] : buffer -> view<[%width]xbf16>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%width]xf32>
  %group_width = index.constant 16 : index
  %groups = index.div %width, %group_width : index
  %output_layout = encoding.layout.strided [%output_group_stride, 1] : encoding<layout>
  %outputs = buffer.view %output[%output_origin] : buffer -> view<[%groups]x16xbf16, %output_layout>
  %c0 = scalar.constant 0.0 : f32
  %c0v = vector.splatf 0.0 : vector<8xf32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %partial, %values, %gammas = scf.for %slot = [%begin to %end step %step](%sum = %c0 : f32, %retained_values = %c0v : vector<8xf32>, %retained_gammas = %c0v : vector<8xf32>) -> (f32, vector<8xf32>, vector<8xf32>) unroll {
    %channel = index.madd %slot, %stride, %lane : index
    %active = index.cmp ult, %channel, %width : index
    %value, %gamma = scf.if %active -> (f32, f32) {
      %packed = view.load %inputs[%channel] : view<[%width]xbf16> -> bf16
      %value = scalar.extf %packed : bf16 to f32
      %gamma = view.load %weights[%channel] : view<[%width]xf32> -> f32
      scf.yield %value, %gamma : f32, f32
    } else {
      scf.yield %c0, %c0 : f32, f32
    }
    %next_sum = scalar.fmaf %value, %value, %sum : f32
    %next_values = vector.insert %value into %retained_values[%slot] : f32, vector<8xf32>
    %next_gammas = vector.insert %gamma into %retained_gammas[%slot] : f32, vector<8xf32>
    scf.yield %next_sum, %next_values, %next_gammas : f32, vector<8xf32>, vector<8xf32>
  }
  %sum = kernel.subgroup.reduce<addf> %partial : f32
  %width_i32 = index.cast %width : index to i32
  %width_f32 = scalar.uitofp %width_i32 : i32 to f32
  %mean = scalar.divf %sum, %width_f32 : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %biased = scalar.addf %mean, %epsilon : f32
  %inverse = scalar.rsqrtf<afn> %biased : f32
  %inverses = vector.splat %inverse : vector<8xf32>
  %unit = vector.mulf %values, %inverses : vector<8xf32>
  %scaled = vector.mulf %unit, %gammas : vector<8xf32>
  %normalized = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
  %rounded = vector.extf %normalized : vector<8xbf16> to vector<8xf32>
  %low = vector.extract %rounded[0] : vector<8xf32> -> f32
  %high = vector.extract %rounded[1] : vector<8xf32> -> f32
  %sine_packed, %cosine_packed = func.call @qsa_rotary_coefficients(%position, %lane) : (index, index) -> (bf16, bf16)
  %sine = scalar.extf %sine_packed : bf16 to f32
  %cosine = scalar.extf %cosine_packed : bf16 to f32
  %low_cosine = scalar.mulf %low, %cosine : f32
  %high_sine = scalar.mulf %high, %sine : f32
  %high_cosine = scalar.mulf %high, %cosine : f32
  %low_sine = scalar.mulf %low, %sine : f32
  %rotated_low = scalar.subf %low_cosine, %high_sine : f32
  %rotated_high = scalar.addf %high_cosine, %low_sine : f32
  %low_packed = scalar.fptrunc %rotated_low : f32 to bf16
  %high_packed = scalar.fptrunc %rotated_high : f32 to bf16
  %first = vector.insert %low_packed into %normalized[0] : bf16, vector<8xbf16>
  %result = vector.insert %high_packed into %first[1] : bf16, vector<8xbf16>
  scf.for %slot = [%begin to %end step %step] unroll {
    %channel = index.madd %slot, %stride, %lane : index
    %active = index.cmp ult, %channel, %width : index
    scf.if %active {
      %packed = vector.extract %result[%slot] : vector<8xbf16> -> bf16
      %group_value = index.div %channel, %group_width : index
      %group = index.assume %group_value [range(%group_value, 0, 15), lt(%group_value, %groups)] : index
      %component = index.rem %channel, %group_width : index
      view.store %packed, %outputs[%group, %component] : bf16, view<[%groups]x16xbf16, %output_layout>
    }
  }
  func.return
}

// Indexer and main queries use source coordinates independently of causal
// cache positions. Static entries erase packet and origins access for text.
template.decl @flash_next.qsa_prepare_queries(%mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %width: index, %heads: index, %head_stride: index, %span: buffer, %mapping: buffer, %input: buffer, %weight: buffer, %output: buffer)

template.def<@flash_next.qsa_prepare_queries> device @qsa_prepare_queries_body(%mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %width: index, %heads: index, %head_stride: index, %span: buffer, %mapping: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %count = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %end = index.mul %count, %heads : index
  %group = kernel.workgroup.id<x> : index
  %groups = kernel.workgroup.count<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %waves = index.constant 4 : index
  %first = index.madd %group, %waves, %wave : index
  %step = index.mul %groups, %waves : index
  scf.for %linear_head = [%first to %end step %step] {
    %token = index.div %linear_head, %heads : index
    %position = func.call @flash_next_token_coordinate(%mixed, %remapped, %source_capacity, %origin_capacity, %mapping, %inputs, %origins, %token, %lane) : (index, i1, index, index, buffer, buffer, buffer, index, index) -> (index)
    %input_element = index.mul %linear_head, %head_stride : index
    %output_element = index.mul %linear_head, %width : index
    %element_bytes = index.constant 2 : offset
    %input_origin = index.scale %input_element, %element_bytes : index, offset -> offset
    %output_origin = index.scale %output_element, %element_bytes : index, offset -> offset
    %output_group_stride = index.constant 16 : index
    func.call @qsa_normalize_rotate(%width, %position, %input, %input_origin, %weight, %output, %output_origin, %output_group_stride) : (index, index, buffer, offset, buffer, buffer, offset, index)
  }
  template.return
}

// Four wave-private queries share a physical group. The target bounds the
// group count; waves walk the live packed prefix without shared scratch.
func.def pure inline @qsa_query_workers(%heads: index, %units: index) -> (index) {
  %count = index.assume %heads [range(%heads, 4, 24)] : index
  %tokens = config.get @flash_next.token_count : index
  %waves = index.constant 4 : index
  %rounding = index.constant 3 : index
  %work = index.mul %tokens, %count : index
  %rounded = index.add %work, %rounding : index
  %groups = index.div %rounded, %waves : index
  %groups_per_unit = index.constant 32 : index
  %budget = index.mul %units, %groups_per_unit : index
  %workers = index.min %groups, %budget : index
  func.return %workers : index
}

kernel.def target(@qsa_wave32) @qsa_prepare_queries(%neural_enabled: i1, %heads: index) {
  %units = target.execution.unit.count : index
  %workers = func.call pure @qsa_query_workers(%heads, %units) : (index, index) -> (index)
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%width: index, %heads: index, %head_stride: index, %span: buffer, %mapping: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %mixed = index.constant 0 : index
  %remapped = scalar.constant false : i1
  %capacity = config.get @flash_next.token_count : index
  template.apply<@flash_next.qsa_prepare_queries>(%mixed, %remapped, %capacity, %capacity, %span, %span, %width, %heads, %head_stride, %span, %mapping, %input, %weight, %output) : (index, i1, index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@qsa_wave32) @qsa_prepare_queries_mixed(%neural_enabled: i1, %heads: index) {
  %units = target.execution.unit.count : index
  %workers = func.call pure @qsa_query_workers(%heads, %units) : (index, index) -> (index)
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
