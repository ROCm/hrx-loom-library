// Only the live incomplete block is retained. No read touches uninitialized
// history on a fresh span, and a fork publishes exclusively to its own writer.
template.decl @flash_next.qsa_publish_tail.body(%capacity: index, %verification: index, %publish_coordinates: i1, %mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

template.def<@flash_next.qsa_publish_tail.body> device @qsa_publish_tail_body(%capacity: index, %verification: index, %publish_coordinates: i1, %mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %source_inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer) {
  %first_span = kernel.workgroup.id<x> : index
  %span_stride = kernel.workgroup.count<x> : index
  %span_count = func.call @flash_next_span_count(%epoch) : (buffer) -> (index)
  scf.for %span = [%first_span to %span_count step %span_stride] {
    %publish = func.call @flash_next_span_publishes(%verification, %epoch, %span) : (index, buffer, index) -> (i1)
    scf.if %publish {
      %header = index.constant 12 : offset
      %record_bytes = index.constant 24 : offset
      %relative_origin = index.scale %span, %record_bytes : index, offset -> offset
      %record_origin = index.add %header, %relative_origin : offset
      %record = buffer.view %epoch[%record_origin] : buffer -> view<6xi32>
      %length_word = view.load %record[0] : view<6xi32> -> i32
      %begin_word = view.load %record[2] : view<6xi32> -> i32
      %length_value = index.cast %length_word : i32 to index
      %length = index.assume %length_value [range(%length_value, 1, %capacity)] : index
      %begin = index.cast %begin_word : i32 to index
      %position_word = view.load %record[1] : view<6xi32> -> i32
      %row_word = view.load %record[3] : view<6xi32> -> i32
      %first_value = index.cast %position_word : i32 to index
      %first = index.assume %first_value [range(%first_value, 0, 262143)] : index
      %row_value = index.cast %row_word : i32 to index
      %row = index.assume %row_value [range(%row_value, 0, 2147483647)] : index
      %reader, %writer = func.call @flash_next_row_state(%rows, %row, %first, %tail_origin) : (buffer, index, index, offset) -> (offset, offset)
      %logical_end = index.add %first, %length : index
      %c4 = index.constant 4 : index
      %tail_length = index.rem %logical_end, %c4 : index
      %tail_begin = index.sub %logical_end, %tail_length : index
      scf.if %publish_coordinates {
        %coordinate_lane = kernel.subgroup.lane.id : index
        %empty_tail = index.constant 0 : index
        %has_tail = index.cmp ne, %tail_length, %empty_tail : index
        %record_lane = index.cmp ult, %coordinate_lane, %c4 : index
        %publishes = scalar.andi %has_tail, %record_lane : i1
        scf.if %publishes {
          %axes = index.constant 3 : index
          %is_axis = index.cmp ult, %coordinate_lane, %axes : index
          %coordinate_word = scf.if %is_axis -> (i32) {
            %source_word = view.load %record[4] : view<6xi32> -> i32
            %source_first = index.cast %source_word : i32 to index
            %coordinate = func.call @qsa_group_coordinate(%mixed, %remapped, %source_capacity, %origin_capacity, %coordinate_origin, %tail_begin, %first, %source_first, %begin, %row, %coordinate_lane, %source_inputs, %origins, %rows, %arena) : (index, i1, index, index, offset, index, index, index, index, index, index, buffer, buffer, buffer, buffer) -> (index)
            %word = index.cast %coordinate : index to i32
            scf.yield %word : i32
          } else {
            %padding = scalar.constant 0 : i32
            scf.yield %padding : i32
          }
          %coordinate_reader, %coordinate_writer = func.call @flash_next_row_state(%rows, %row, %first, %coordinate_origin) : (buffer, index, index, offset) -> (offset, offset)
          %coordinates = buffer.view %arena[%coordinate_writer] : buffer -> view<4xi32>
          view.store %coordinate_word, %coordinates[%coordinate_lane] : i32, view<4xi32>
        }
      }
      %origin = index.constant 0 : offset
      %inputs = buffer.view %raw[%origin] : buffer -> view<[%capacity]x128xbf16>
      %previous = buffer.view %arena[%reader] : buffer -> view<3x128xbf16>
      %outputs = buffer.view %arena[%writer] : buffer -> view<3x128xbf16>
      %lane = kernel.subgroup.lane.id : index
      %channel = index.mul %lane, %c4 : index
      %c0 = index.constant 0 : index
      %c1 = index.constant 1 : index
      scf.for %slot = [%c0 to %tail_length step %c1] {
        %logical = index.add %tail_begin, %slot : index
        %prior = index.cmp ult, %logical, %first : index
        %packed = scf.if %prior -> (vector<4xbf16>) {
          %value = vector.load %previous[%slot, %channel] : view<3x128xbf16> -> vector<4xbf16>
          scf.yield %value : vector<4xbf16>
        } else {
          %relative = index.sub %logical, %first : index
          %token_value = index.add %begin, %relative : index
          %token = index.assume %token_value [range(%token_value, 0, 32767), lt(%token_value, %capacity)] : index
          %value = vector.load %inputs[%token, %channel] : view<[%capacity]x128xbf16> -> vector<4xbf16>
          scf.yield %value : vector<4xbf16>
        }
        vector.store %packed, %outputs[%slot, %channel] : vector<4xbf16>, view<3x128xbf16>
      }
    }
  }
  template.return
}

