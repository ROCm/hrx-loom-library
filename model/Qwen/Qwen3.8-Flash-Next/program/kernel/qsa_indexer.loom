// Completed four-token blocks are published once. An append that crosses a
// block boundary reads its old raw prefix from the immutable recurrent anchor.
// Four independent waves own neighboring tokens and stride the live prefix.
// Only the final member pools a block; inactive and incomplete blocks do not
// publish, regardless of which physical worker visits them.
kernel.def target(@qsa_wave32) @qsa_pool_blocks(%neural_enabled: i1) {
  %tokens = config.get @flash_next.token_count : index
  %wave_width = index.constant 32 : index
  %maximum_waves = index.constant 4 : index
  %waves = index.min %tokens, %maximum_waves : index
  %threads = index.mul %waves, %wave_width : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %padding = index.sub %waves, %c1 : index
  %rounded = index.add %tokens, %padding : index
  %panels = index.div %rounded, %waves : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%panels, %c1, %units) : (index, index, index) -> (index)
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%tail_origin: offset, %epoch_arg: buffer, %mapping_arg: buffer, %rows_arg: buffer, %raw: buffer, %arena: buffer, %pooled: buffer) {
  // Packed metadata is immutable until this epoch completes.
  %epoch = buffer.assume.memory_space<constant> %epoch_arg : buffer
  %mapping = buffer.assume.memory_space<constant> %mapping_arg : buffer
  %rows = buffer.assume.memory_space<constant> %rows_arg : buffer
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  %worker = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  %wave = kernel.subgroup.id : index
  %waves = kernel.subgroup.count : index
  %first_token = index.madd %worker, %waves, %wave : index
  %stride = index.mul %workers, %waves : index
  scf.for %token = [%first_token to %end step %stride] {
    %position, %row, %begin, %first = func.call @flash_next_token_binding(%mapping, %token) : (buffer, index) -> (index, index, index, index)
    %c4 = index.constant 4 : index
    %c3 = index.constant 3 : index
    %member = index.rem %position, %c4 : index
    %complete = index.cmp eq, %member, %c3 : index
    scf.if %complete {
      %reader, %writer = func.call @flash_next_row_state(%rows, %row, %first, %tail_origin) : (buffer, index, index, offset) -> (offset, offset)
      %block_begin = index.sub %position, %c3 : index
      %origin = index.constant 0 : offset
      %raw_view = buffer.view %raw[%origin] : buffer -> view<[%tokens]x128xbf16>
      %tail = buffer.view %arena[%reader] : buffer -> view<3x128xbf16>
      %outputs = buffer.view %pooled[%origin] : buffer -> view<[%tokens]x128xbf16>
      %lane = kernel.subgroup.lane.id : index
      %channel = index.mul %lane, %c4 : index
      %c0 = index.constant 0 : index
      %c1 = index.constant 1 : index
      %c0v = vector.splatf 0.0 : vector<4xf32>
      %total = scf.for %slot = [%c0 to %c4 step %c1](%sum = %c0v : vector<4xf32>) -> (vector<4xf32>) {
        %logical = index.add %block_begin, %slot : index
        %prior = index.cmp ult, %logical, %first : index
        %packed = scf.if %prior -> (vector<4xbf16>) {
          %tail_slot = index.assume %slot [range(%slot, 0, 2)] : index
          %value = vector.load %tail[%tail_slot, %channel] : view<3x128xbf16> -> vector<4xbf16>
          scf.yield %value : vector<4xbf16>
        } else {
          %relative = index.sub %logical, %first : index
          %input_token_value = index.add %begin, %relative : index
          %input_token = index.assume %input_token_value [range(%input_token_value, 0, 32767), lt(%input_token_value, %tokens)] : index
          %value = vector.load %raw_view[%input_token, %channel] : view<[%tokens]x128xbf16> -> vector<4xbf16>
          scf.yield %value : vector<4xbf16>
        }
        %value = vector.extf %packed : vector<4xbf16> to vector<4xf32>
        %next = vector.addf %sum, %value : vector<4xf32>
        scf.yield %next : vector<4xf32>
      }
      %quarter = vector.splatf 0.25 : vector<4xf32>
      %mean = vector.mulf %total, %quarter : vector<4xf32>
      %packed = vector.fptrunc %mean : vector<4xf32> to vector<4xbf16>
      vector.store %packed, %outputs[%token, %channel] : vector<4xbf16>, view<[%tokens]x128xbf16>
    }
  }
  kernel.return
}

template.decl @flash_next.qsa_prepare_blocks(%mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer, %working: buffer)

template.def<@flash_next.qsa_prepare_blocks> device @qsa_prepare_blocks_body(%mixed: index, %remapped: i1, %source_capacity: index, %origin_capacity: index, %inputs_arg: buffer, %origins_arg: buffer, %coordinate_origin: offset, %index_origin: offset, %epoch_arg: buffer, %mapping_arg: buffer, %rows_arg: buffer, %pooled: buffer, %weight: buffer, %arena: buffer, %working: buffer) {
  // Packed metadata is immutable until this epoch completes.
  %inputs = buffer.assume.memory_space<constant> %inputs_arg : buffer
  %origins = buffer.assume.memory_space<constant> %origins_arg : buffer
  %epoch = buffer.assume.memory_space<constant> %epoch_arg : buffer
  %mapping = buffer.assume.memory_space<constant> %mapping_arg : buffer
  %rows = buffer.assume.memory_space<constant> %rows_arg : buffer
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  %worker = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  %wave = kernel.subgroup.id : index
  %waves = kernel.subgroup.count : index
  %first_token = index.madd %worker, %waves, %wave : index
  %stride = index.mul %workers, %waves : index
  scf.for %token = [%first_token to %end step %stride] {
    %position, %row, %begin, %first = func.call @flash_next_token_binding(%mapping, %token) : (buffer, index) -> (index, index, index, index)
    %c4 = index.constant 4 : index
    %c3 = index.constant 3 : index
    %member = index.rem %position, %c4 : index
    %complete = index.cmp eq, %member, %c3 : index
    scf.if %complete {
      // The fourth member cannot precede position three. Preserve that bound
      // when selecting retained coordinates for packets shorter than a group.
      %complete_position = index.assume %position [ge(%position, 3)] : index
      %logical = index.sub %complete_position, %c3 : index
      %physical = func.call @flash_next_physical_token(%rows, %row, %logical) : (buffer, index, index) -> (index)
      %block = index.div %physical, %c4 : index
      %base = func.call @flash_next_cache_origin(%rows, %row, %index_origin) : (buffer, index, offset) -> (offset)
      %row_bytes = index.constant 256 : offset
      %input_origin = index.scale %token, %row_bytes : index, offset -> offset
      %output_relative = index.scale %block, %row_bytes : index, offset -> offset
      %output_origin = index.add %base, %output_relative : offset
      %width = index.constant 128 : index
      %output_group_stride = index.constant 16 : index
      %source = func.call @flash_next_token_rotary(%mapping, %token) : (buffer, index) -> (index)
      %relative = index.sub %token, %begin : index
