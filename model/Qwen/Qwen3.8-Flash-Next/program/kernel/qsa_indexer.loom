      %axis = index.rem %lane, %c3 : index
      %coordinate = func.call @qsa_group_coordinate(%mixed, %remapped, %source_capacity, %origin_capacity, %coordinate_origin, %logical, %first, %source_first, %begin, %row, %axis, %inputs, %origins, %rows, %working) : (index, i1, index, index, offset, index, index, index, index, index, index, buffer, buffer, buffer, buffer) -> (index)
      func.call @qsa_normalize_rotate(%width, %coordinate, %pooled, %input_origin, %weight, %arena, %output_origin, %output_group_stride) : (index, index, buffer, offset, buffer, buffer, offset, index)
    }
  }
  template.return
}

