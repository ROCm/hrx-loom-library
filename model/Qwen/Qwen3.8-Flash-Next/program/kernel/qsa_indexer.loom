// Every indexer layer consumes the old coordinate. Only the final layer uses
// these entries, fusing one shared coordinate update into raw-tail publication.
// Replay supplies original packed starts and source positions in descriptors;
// it needs neither a surviving token map nor a retained input allocation.
kernel.def target(@qsa_wave32) @qsa_publish_coordinates_text(%neural_enabled: i1) {
  %span_capacity = config.get @flash_next.span_capacity : index
  %spans = func.call pure @flash_next_span_workers(%span_capacity) : (index) -> (index)
  %threads = index.constant 32 : index
  %c1 = index.constant 1 : index
  %c0 = index.constant 0 : index
