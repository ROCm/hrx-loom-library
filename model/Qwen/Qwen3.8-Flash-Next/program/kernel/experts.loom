}

kernel.def target(@flash_next_expert_wave32) @shared_gate_up(%neural_enabled: i1) {
  %groups = index.constant 160 : index
  %tokens = config.get @flash_next.token_count : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %groups, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %tokens, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %input_arg: buffer, %gate_weight_arg: buffer, %up_weight_arg: buffer, %output_arg: buffer) {
  %span, %input, %gate_weight, %up_weight, %output = buffer.assume.noalias %span_arg, %input_arg, %gate_weight_arg, %up_weight_arg, %output_arg : buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<y> : index
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %c0 = index.constant 0 : index
    %c4 = index.constant 4 : index
    %stride = index.constant 32 : index
    %width = index.constant 2560 : index
    %origin = index.constant 0 : offset
    %row = index.madd %group, %c4, %wave : index
    %gate_partial = func.call @flash_next_q8_partial(%width, %token, %row, %lane, %stride, %input, %gate_weight) : (index, index, index, index, index, buffer, buffer) -> (f32)
    %up_partial = func.call @flash_next_q8_partial(%width, %token, %row, %lane, %stride, %input, %up_weight) : (index, index, index, index, index, buffer, buffer) -> (f32)
    %gate = kernel.subgroup.reduce<addf> %gate_partial : f32
    %up = kernel.subgroup.reduce<addf> %up_partial : f32
    %leader = index.cmp eq, %lane, %c0 : index
    scf.if %leader {
      %packed = func.call @expert_swiglu(%gate, %up) : (f32, f32) -> (bf16)
      %view = buffer.view %output[%origin] : buffer -> view<[%tokens]x640xbf16>
      view.store %packed, %view[%token, %row] : bf16, view<[%tokens]x640xbf16>
    }
  }
  kernel.return
}

kernel.def target(@flash_next_expert_wave32) @experts_combine(%neural_enabled: i1) {
  %groups = index.constant 5 : index
  %tokens = config.get @flash_next.token_count : index
  %threads = index.constant 64 : index
  %c1 = index.constant 1 : index
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %groups, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %tokens, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %experts_arg: buffer, %weights_arg: buffer, %shared_arg: buffer, %gate_arg: buffer, %output_arg: buffer) {
  %span, %experts, %weights, %shared, %gate, %output = buffer.assume.noalias %span_arg, %experts_arg, %weights_arg, %shared_arg, %gate_arg, %output_arg : buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<y> : index
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %thread = kernel.workitem.id<x> : index
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %c10 = index.constant 10 : index
    %threads = index.constant 64 : index
    %feature = index.madd %group, %threads, %thread : index
    %origin = index.constant 0 : offset
    %experts_view = buffer.view %experts[%origin] : buffer -> view<[%tokens]x10x320x8xbf16>
    %weights_view = buffer.view %weights[%origin] : buffer -> view<[%tokens]x10xf32>
    %shared_view = buffer.view %shared[%origin] : buffer -> view<[%tokens]x320x8xbf16>
    %gate_view = buffer.view %gate[%origin] : buffer -> view<[%tokens]xf32>
    %output_view = buffer.view %output[%origin] : buffer -> view<[%tokens]x320x8xbf16>
    %c0v = vector.constant 0.0 : vector<8xf32>
    %routed = scf.for %slot = [%c0 to %c10 step %c1](%accumulator = %c0v : vector<8xf32>) -> (vector<8xf32>) {
      %stored = vector.load %experts_view[%token, %slot, %feature, %c0] : view<[%tokens]x10x320x8xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %weight = view.load %weights_view[%token, %slot] : view<[%tokens]x10xf32> -> f32
      %weight_vector = vector.splat %weight : vector<8xf32>
      %next = vector.fmaf %values, %weight_vector, %accumulator : vector<8xf32>
      scf.yield %next : vector<8xf32>
    }
    %shared_stored = vector.load %shared_view[%token, %feature, %c0] : view<[%tokens]x320x8xbf16> -> vector<8xbf16>
    %shared_values = vector.extf %shared_stored : vector<8xbf16> to vector<8xf32>
    %gate_value = view.load %gate_view[%token] : view<[%tokens]xf32> -> f32
    %gate_vector = vector.splat %gate_value : vector<8xf32>
    %sum = vector.fmaf %shared_values, %gate_vector, %routed : vector<8xf32>
    %packed = vector.fptrunc %sum : vector<8xf32> to vector<8xbf16>
    vector.store %packed, %output_view[%token, %feature, %c0] : vector<8xbf16>, view<[%tokens]x320x8xbf16>
  }
  kernel.return
}
