} launch(%span_arg: buffer, %input_arg: buffer, %ids_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %q8_weights = scalar.constant false : i1
  func.call @expert_down_body(%q8_weights, %span_arg, %input_arg, %ids_arg, %weight_arg, %output_arg) : (i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

