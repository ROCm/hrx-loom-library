// Predictor vocabulary planning, projection, and sampling from accepted-token
// history. A common prefix and checkpoint control tokens coexist with bounded
// rare-token membership; the plan remains fixed across a recursive proposal
// chain.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

func.decl pure @flash_next_token_workers(%capacity: index, %groups_per_token: index, %units: index) -> (index)

func.decl pure @flash_next_draft_cohorts(%capacity: index) -> (index)

func.decl pure @flash_next_draft_mode_origin(%capacity: index) -> (offset)

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl @flash_next_mtp_span(%epoch: buffer, %span: index) -> (index, index, index, index)

func.decl @flash_next_store_logit(%expanded: i1, %rows: index, %row: index, %id: index, %sum: f32, %output: buffer)

func.decl @flash_next_q8_partial(%width: index, %token: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (f32)

func.decl @flash_next_q8_batch_partial(%width: index, %group_size: index, %batch_size: index, %first: index, %end: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (vector<[%group_size]xf32>)

func.decl @sampling_key(%value: f32, %id: i32) -> (i64)

template.decl @sampling.reduce_key(%key: i64, %minimum: i1) -> (i64)

amdgpu.target<gfx11-generic> @flash_next_draft_wave32 {subgroup_size = 32}

// A retained record contains the hidden/index carry, then request-owned draft
// vocabulary. The latter is a three-word header, one padding word, a bitmap
// for non-prefix/non-control IDs, and 991 live-bounded rare-token slots.
// Headers hold rare count and the latest two miss positions plus one; zero
// denotes no miss. Native checkpoint/fork transfers retain this entire record.
func.def pure inline @flash_next_draft_record(%owner: index) -> (offset) {
  %stride = index.constant 44032 : offset
  %prefix = index.constant 21248 : offset
  %row = index.scale %owner, %stride : index, offset -> offset
  %origin = index.add %row, %prefix : offset
  func.return %origin : offset
}

template.decl @qwen38.draft_vocabulary.update(%mixed: index, %capacity: index, %position: index, %begin: index, %length: index, %record: offset, %ids: buffer, %carry: buffer)

func.decl @qwen38_draft_vocabulary_full(%carry: buffer, %record: offset, %position: index, %anchor: index) -> (i1)

func.decl @qwen38_draft_vocabulary_id(%column: index, %full: i1, %carry: buffer, %record: offset) -> (index)

template.decl @flash_next.draft_update(%position: index, %begin: index, %length: index, %owner: index, %ids: buffer, %carry: buffer)

// Final carry publication has already gathered accepted inputs into plain IDs.
template.def<@flash_next.draft_update> device @flash_next_draft_update(%position: index, %begin: index, %length: index, %owner: index, %ids: buffer, %carry: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %mixed = index.constant 0 : index
  %record = func.call pure @flash_next_draft_record(%owner) : (index) -> (offset)
  template.apply<@qwen38.draft_vocabulary.update>(%mixed, %capacity, %position, %begin, %length, %record, %ids, %carry) : (index, index, index, index, index, offset, buffer, buffer)
  template.return
}

// The plan is immutable for a recursive proposal chain. Cohort flags
// precede token flags. A cohort shares the union of its requested weight
// rows; a full-head peer therefore needs only one shared full weight pass.
kernel.def @flash_next_draft_plan() {
  %c1_index = index.constant 1 : index
  kernel.launch.config workgroups(%c1_index, %c1_index, %c1_index) workgroup_size(%c1_index, %c1_index, %c1_index) : index
} launch(%epoch: buffer, %ids: buffer, %carry: buffer, %plan: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %count_value = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %origin = index.constant 0 : offset
  %row_origin = func.call pure @flash_next_draft_mode_origin(%capacity) : (index) -> (offset)
  %cohort_count = func.call pure @flash_next_draft_cohorts(%capacity) : (index) -> (index)
  %cohorts = buffer.view %plan[%origin] : buffer -> view<[%cohort_count]xi32>
  %modes = buffer.view %plan[%row_origin] : buffer -> view<[%capacity]xi32>
  %tokens = buffer.view %ids[%origin] : buffer -> view<[%capacity]xi32>
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c4_index = index.constant 4 : index
  %c0_i32 = scalar.constant 0 : i32
  %live_cohorts = func.call pure @flash_next_draft_cohorts(%count) : (index) -> (index)
  scf.for %cohort = [%c0_index to %live_cohorts step %c1_index] {
    view.store %c0_i32, %cohorts[%cohort] : i32, view<[%cohort_count]xi32>
  }
  scf.for %span = [%c0_index to %count step %c1_index] {
    %length, %position, %begin, %owner = func.call @flash_next_mtp_span(%epoch, %span) : (buffer, index) -> (index, index, index, index)
    %record = func.call pure @flash_next_draft_record(%owner) : (index) -> (offset)
    %anchor_word = view.load %tokens[%begin] : view<[%capacity]xi32> -> i32
    %anchor_value = index.cast %anchor_word : i32 to index
    %anchor = index.assume %anchor_value [range(%anchor_value, 0, 248076)] : index
    %full = func.call @qwen38_draft_vocabulary_full(%carry, %record, %position, %anchor) : (buffer, offset, index, index) -> (i1)
    %mode = scalar.extui %full : i1 to i32
    %row = index.assume %begin [ge(%begin, 0), lt(%begin, %capacity)] : index
    view.store %mode, %modes[%row] : i32, view<[%capacity]xi32>
    %cohort = index.div %row, %c4_index : index
    %prior_mode = view.load %cohorts[%cohort] : view<[%cohort_count]xi32> -> i32
    %combined = scalar.ori %prior_mode, %mode : i32
    view.store %combined, %cohorts[%cohort] : i32, view<[%cohort_count]xi32>
  }
  kernel.return
}

kernel.def target(@flash_next_draft_wave32) @flash_next_draft_common_head(%live_rows: index) {
  %c1 = index.constant 1 : index
  %units = target.execution.unit.count : index
  %groups_per_unit = index.constant 32 : index
  %groups = index.mul %units, %groups_per_unit : index
  %threads = index.constant 128 : index
  %enabled = index.min %live_rows, %c1 : index
  kernel.launch.config workgroups(%groups, %enabled, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%expanded: i1, %epoch: buffer, %plan: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %count_value = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %c4_index = index.constant 4 : index
  %first_batch = index.constant 0 : index
  %step = index.constant 1 : index
  %batches = func.call pure @flash_next_draft_cohorts(%count) : (index) -> (index)
  scf.for %batch = [%first_batch to %batches step %step] {
    %first = index.mul %batch, %c4_index : index
    %origin = index.constant 0 : offset
    %cohort_count = func.call pure @flash_next_draft_cohorts(%capacity) : (index) -> (index)
    %cohorts = buffer.view %plan[%origin] : buffer -> view<[%cohort_count]xi32>
    %mode = view.load %cohorts[%batch] : view<[%cohort_count]xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    %full = scalar.cmpi ne, %mode, %c0_i32 : i32
    %full_rows = index.constant 248077 : index
    %common_rows = index.constant 98337 : index
    %rows = scf.select %full, %full_rows, %common_rows : index
    %c3_index = index.constant 3 : index
    %padded = index.add %rows, %c3_index : index
    %groups = index.div %padded, %c4_index : index
    %worker = kernel.workgroup.id<x> : index
    %workers = kernel.workgroup.count<x> : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %c0_index = index.constant 0 : index
    %c1_index = index.constant 1 : index
    %prefix = index.constant 98304 : index
    %controls = index.constant 248044 : index
    %width = index.constant 2560 : index
    %stride = index.constant 32 : index
    %leader = index.cmp eq, %lane, %c0_index : index
    scf.for %group = [%worker to %groups step %workers] {
      %column = index.madd %group, %c4_index, %wave : index
      %valid = index.cmp ult, %column, %rows : index
      scf.if %valid {
        %frequent = index.cmp ult, %column, %prefix : index
        %direct = scalar.ori %full, %frequent : i1
        %id_value = scf.if %direct -> (index) {
          scf.yield %column : index
        } else {
          %relative = index.sub %column, %prefix : index
          %control = index.add %controls, %relative : index
          scf.yield %control : index
        }
        %id = index.assume %id_value [range(%id_value, 0, 248076)] : index
        %partial = func.call @flash_next_q8_batch_partial(%width, %c4_index, %c4_index, %first, %count, %id, %lane, %stride, %input, %weight) : (index, index, index, index, index, index, index, index, buffer, buffer) -> (vector<[%c4_index]xf32>)
        %sums = kernel.subgroup.reduce<addf> %partial : vector<[%c4_index]xf32>
        scf.if %leader {
          scf.for %ordinal = [%c0_index to %c4_index step %c1_index] unroll schedule(linear) {
            %token = index.add %first, %ordinal : index
            %live = index.cmp ult, %token, %count : index
            scf.if %live {
              %sum = vector.extract %sums[%ordinal] : vector<[%c4_index]xf32> -> f32
              func.call @flash_next_store_logit(%expanded, %capacity, %token, %id, %sum, %output) : (i1, index, index, index, f32, buffer)
            }
          }
        }
      }
    }
  }
  kernel.return
}

kernel.def target(@flash_next_draft_wave32) @flash_next_draft_rare_head(%live_rows: index) {
  %c1 = index.constant 1 : index
  %groups = index.constant 248 : index
  %threads = index.constant 128 : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%live_rows, %groups, %units) : (index, index, index) -> (index)
  kernel.launch.config workgroups(%groups, %workers, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%expanded: i1, %epoch: buffer, %plan: buffer, %carry: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %count_value = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %first = kernel.workgroup.id<y> : index
  %workers = kernel.workgroup.count<y> : index
  scf.for %token = [%first to %count step %workers] {
    %origin = index.constant 0 : offset
    %c4_index = index.constant 4 : index
    %batch = index.div %token, %c4_index : index
    %cohort_count = func.call pure @flash_next_draft_cohorts(%capacity) : (index) -> (index)
    %cohorts = buffer.view %plan[%origin] : buffer -> view<[%cohort_count]xi32>
    %mode = view.load %cohorts[%batch] : view<[%cohort_count]xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    %subset = scalar.cmpi eq, %mode, %c0_i32 : i32
    scf.if %subset {
      %length, %position, %begin, %owner = func.call @flash_next_mtp_span(%epoch, %token) : (buffer, index) -> (index, index, index, index)
      %record = func.call pure @flash_next_draft_record(%owner) : (index) -> (offset)
      %header = buffer.view %carry[%record] : buffer -> view<3xi32>
      %count_word = view.load %header[0] : view<3xi32> -> i32
      %rare_count = index.cast %count_word : i32 to index
      %group = kernel.workgroup.id<x> : index
      %wave = kernel.subgroup.id : index
      %lane = kernel.subgroup.lane.id : index
      %slot = index.madd %group, %c4_index, %wave : index
      %valid = index.cmp ult, %slot, %rare_count : index
      scf.if %valid {
        %common = index.constant 98337 : index
        %column = index.add %common, %slot : index
        %no = scalar.constant false : i1
        %id = func.call @qwen38_draft_vocabulary_id(%column, %no, %carry, %record) : (index, i1, buffer, offset) -> (index)
        %width = index.constant 2560 : index
        %stride = index.constant 32 : index
        %part = func.call @flash_next_q8_partial(%width, %token, %id, %lane, %stride, %input, %weight) : (index, index, index, index, index, buffer, buffer) -> (f32)
        %sum = kernel.subgroup.reduce<addf> %part : f32
        %c0_index = index.constant 0 : index
        %leader = index.cmp eq, %lane, %c0_index : index
        scf.if %leader {
          func.call @flash_next_store_logit(%expanded, %capacity, %token, %id, %sum, %output) : (i1, index, index, index, f32, buffer)
        }
      }
    }
  }
  kernel.return
}

// Greedy proposal selection uses the same ordered-logit/ID key as target
// sampling. Each output is {token ID, F32 confidence bits}; confidence is the
// selected token probability within this proposal vocabulary. The target still
// samples and verifies against its complete vocabulary.
kernel.def @flash_next_draft_sample(%live_rows: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%live_rows, %c1, %units) : (index, index, index) -> (index)
  kernel.launch.config workgroups(%workers, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch: buffer, %plan: buffer, %carry: buffer, %logits: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %count_value = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %first = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  scf.for %token = [%first to %count step %workers] {
    %length, %position, %begin, %owner = func.call @flash_next_mtp_span(%epoch, %token) : (buffer, index) -> (index, index, index, index)
    %record = func.call pure @flash_next_draft_record(%owner) : (index) -> (offset)
    %header = buffer.view %carry[%record] : buffer -> view<3xi32>
    %rare_word = view.load %header[0] : view<3xi32> -> i32
    %rare = index.cast %rare_word : i32 to index
    %row_origin = func.call pure @flash_next_draft_mode_origin(%capacity) : (index) -> (offset)
    %modes = buffer.view %plan[%row_origin] : buffer -> view<[%capacity]xi32>
    %mode = view.load %modes[%token] : view<[%capacity]xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    %full = scalar.cmpi ne, %mode, %c0_i32 : i32
    %common = index.constant 98337 : index
    %full_rows = index.constant 248077 : index
    %subset_rows = index.add %common, %rare : index
    %columns = scf.select %full, %full_rows, %subset_rows : index
    %origin = index.constant 0 : offset
    %values = buffer.view %logits[%origin] : buffer -> view<[%capacity]x248320xbf16>
    %thread = kernel.workitem.id<x> : index
    %threads = kernel.workgroup.size<x> : index
    %empty = scalar.constant 0 : i64
    %c0_index = index.constant 0 : index
    %c1_index = index.constant 1 : index
    %last = index.sub %columns, %c1_index : index
    %key = scf.for %base = [%c0_index to %columns step %threads](%best = %empty : i64) -> (i64) {
      %position = index.add %base, %thread : index
      %live = index.cmp ult, %position, %columns : index
      %column = index.min %position, %last : index
      %id = func.call @qwen38_draft_vocabulary_id(%column, %full, %carry, %record) : (index, i1, buffer, offset) -> (index)
      %packed_value = view.load %values[%token, %id] : view<[%capacity]x248320xbf16> -> bf16
      %value = scalar.extf %packed_value : bf16 to f32
      %id_word = index.cast %id : index to i32
      %candidate = func.call @sampling_key(%value, %id_word) : (f32, i32) -> (i64)
      %contribution = scf.select %live, %candidate, %empty : i64
      %next = scalar.maxui %best, %contribution : i64
      scf.yield %next : i64
    }
    %maximum = scalar.constant false : i1
    %best = template.apply<@sampling.reduce_key>(%key, %maximum) : (i64, i1) -> (i64)
    %inverse = scalar.trunci %best : i64 to i32
    %cneg1_i32 = scalar.constant -1 : i32
    %selected = scalar.xori %inverse, %cneg1_i32 : i32
    // Confidence controls further drafting; the target still verifies every
    // proposed token using its unchanged weights, logits, and acceptance.
    %selected_value = index.cast %selected : i32 to index
    %selected_id = index.assume %selected_value [range(%selected_value, 0, 248076)] : index
    %packed_peak = view.load %values[%token, %selected_id] : view<[%capacity]x248320xbf16> -> bf16
    %peak = scalar.extf %packed_peak : bf16 to f32
    %empty_mass = scalar.constant 0.0 : f32
    %local_mass = scf.for %base = [%c0_index to %columns step %threads](%mass = %empty_mass : f32) -> (f32) {
      %position = index.add %base, %thread : index
      %live = index.cmp ult, %position, %columns : index
      %column = index.min %position, %last : index
      %id = func.call @qwen38_draft_vocabulary_id(%column, %full, %carry, %record) : (index, i1, buffer, offset) -> (index)
      %packed_value = view.load %values[%token, %id] : view<[%capacity]x248320xbf16> -> bf16
      %value = scalar.extf %packed_value : bf16 to f32
      %difference = scalar.subf %value, %peak : f32
      %exponential = scalar.expf<afn> %difference : f32
      %contribution = scf.select %live, %exponential, %empty_mass : f32
      %next = scalar.addf %mass, %contribution : f32
      scf.yield %next : f32
    }
    %mass = kernel.workgroup.reduce<addf> %local_mass : f32
    %unit_mass = scalar.constant 1.0 : f32
    %probability = scalar.divf %unit_mass, %mass : f32
    %probability_bits = scalar.bitcast %probability : f32 to i32
    %leader = index.cmp eq, %thread, %c0_index : index
    scf.if %leader {
      %predictions = buffer.view %output[%origin] : buffer -> view<[%capacity]x2xi32>
      view.store %selected, %predictions[%token, 0] : i32, view<[%capacity]x2xi32>
      view.store %probability_bits, %predictions[%token, 1] : i32, view<[%capacity]x2xi32>
    }
    // Both reductions reuse workgroup scratch on the next proposal.
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}
