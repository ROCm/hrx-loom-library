// Predictor normalization and embedding/hidden fusion. Ordinary proposals
// read private hidden rows; accepted-target catch-up restores first-row carry
// before consuming target hidden rows.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl pure @flash_next_token_workers(%capacity: index, %groups_per_token: index, %units: index) -> (index)

func.decl @flash_next_q8_batch_dot(%width: index, %group_size: index, %batch_size: index, %first: index, %end: index, %lane: index, %stride: index, %scale_origin: offset, %code_origin: offset, %scale_stride: offset, %code_stride: offset, %input: buffer, %weight: buffer) -> (vector<[%group_size]xf32>)

amdgpu.target<gfx11-generic> @flash_next_mtp_wave32 {subgroup_size = 32}

func.decl @flash_next_token_binding(%mapping: buffer, %token: index) -> (index, index, index, index)

// The predictor normalizes the entire four-stream hidden row together. Its
// embedding has an independent 2560-wide norm. GGUF already folded 1+gamma.
// Both input owners share this arithmetic and reduction; source rows can differ
// from the compact destination rows.
template.decl @flash_next.mtp_normalize_row(%width: index, %tokens: index, %token: index, %source_token: index, %input: buffer, %weight: buffer, %output: buffer)

template.def<@flash_next.mtp_normalize_row> device @flash_next_mtp_normalize_row(%width: index, %tokens: index, %token: index, %source_token: index, %input: buffer, %weight: buffer, %output: buffer) {
  %thread = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %c8 = index.constant 8 : index
  %c0 = index.constant 0 : index
  %stride = index.constant 128 : index
  %packets = index.div %width, %c8 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<[%tokens]x[%packets]x8xbf16>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%packets]x8xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%packets]x8xbf16>
  %initial_sum = scalar.constant 0.0 : f32
  %initial = vector.splatf 0.0 : vector<8xf32>
  %parts = scf.for %packet = [%thread to %packets step %stride](%prior = %initial : vector<8xf32>) -> (vector<8xf32>) {
    %packed = vector.load %inputs[%source_token, %packet, %c0] : view<[%tokens]x[%packets]x8xbf16> -> vector<8xbf16>
    %values = vector.extf %packed : vector<8xbf16> to vector<8xf32>
    %next = vector.fmaf %values, %values, %prior : vector<8xf32>
    scf.yield %next : vector<8xf32>
  }
  %partial = vector.reduce<addf> %parts, %initial_sum : vector<8xf32>, f32
  %sum = kernel.workgroup.reduce<addf> %partial : f32
  %width_word = index.cast %width : index to i32
  %width_float = scalar.uitofp %width_word : i32 to f32
  %mean = scalar.divf %sum, %width_float : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %biased = scalar.addf %mean, %epsilon : f32
  %inverse = scalar.rsqrtf<afn> %biased : f32
  %inverse_vector = vector.splat %inverse : vector<8xf32>
  scf.for %packet = [%thread to %packets step %stride] {
    %packed = vector.load %inputs[%source_token, %packet, %c0] : view<[%tokens]x[%packets]x8xbf16> -> vector<8xbf16>
    %values = vector.extf %packed : vector<8xbf16> to vector<8xf32>
    %gamma = vector.load %weights[%packet, %c0] : view<[%packets]x8xf32> -> vector<8xf32>
    %unit = vector.mulf %values, %inverse_vector : vector<8xf32>
    %scaled = vector.mulf %unit, %gamma : vector<8xf32>
    %rounded = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
    vector.store %rounded, %outputs[%token, %packet, %c0] : vector<8xbf16>, view<[%tokens]x[%packets]x8xbf16>
  }
  template.return
}

kernel.def @flash_next_mtp_normalize(%neural_enabled: i1) {
  %tokens = config.get @flash_next.token_count : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%tokens, %c1, %units) : (index, index, index) -> (index)
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%width_value: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %width = index.assume %width_value [range(%width_value, 2560, 10240), multiple_of(%width_value, 256)] : index
  %tokens = config.get @flash_next.token_count : index
  %worker = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  %count = func.call @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  scf.for %token = [%worker to %count step %workers] {
    template.apply<@flash_next.mtp_normalize_row>(%width, %tokens, %token, %token, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}

// First rows read restored carry; subsequent rows bind the accepted target
// prefix directly, so rejected rows never become predictor input.
kernel.def @flash_next_mtp_normalize_warm() {
  %tokens = config.get @flash_next.token_count : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%tokens, %c1, %units) : (index, index, index) -> (index)
  kernel.launch.config workgroups(%workers, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch: buffer, %mapping: buffer, %origins: buffer, %restored: buffer, %target: buffer, %weight: buffer, %output: buffer) {
  %width = index.constant 10240 : index
  %tokens = config.get @flash_next.token_count : index
  %worker = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  %count = func.call @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  scf.for %token = [%worker to %count step %workers] {
    %origin = index.constant 0 : offset
    // The mapping owns each compact span start, which indexes its original
    // target range independently of resident identity or rejection holes.
    %position, %row, %begin, %first_position = func.call @flash_next_token_binding(%mapping, %token) : (buffer, index) -> (index, index, index, index)
    %first = index.cmp eq, %token, %begin : index
    %source_token = scf.if %first -> (index) {
      scf.yield %begin : index
    } else {
      %relative_value = index.sub %token, %begin : index
      %relative = index.assume %relative_value [range(%relative_value, 1, 32767), lt(%relative_value, %tokens)] : index
      %c1 = index.constant 1 : index
      %prior = index.sub %relative, %c1 : index
      %source_origins = buffer.view %origins[%origin] : buffer -> view<[%tokens]xi32>
      %source_begin_word = view.load %source_origins[%begin] : view<[%tokens]xi32> -> i32
      %source_begin = index.cast %source_begin_word : i32 to index
      %source_value = index.add %source_begin, %prior : index
      %source = index.assume %source_value [range(%source_value, 0, 32767), lt(%source_value, %tokens)] : index
      scf.yield %source : index
    }
    // Restore publishes first rows, including explicit fresh zeros. All other
    // input rows remain in the immutable target plane; no hidden copy is needed.
    %input = scf.select %first, %restored, %target : buffer
    template.apply<@flash_next.mtp_normalize_row>(%width, %tokens, %token, %source_token, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}

// Each subgroup owns one output channel and up to four tokens. Decoded Q8
// blocks serve the entire token panel; hidden blocks also serve all four
// streams. Each row keeps its original block and lane reduction. Serialized
// [embedding | hidden] halves retain separate BF16 rounding before addition.
// Workers stride complete panels without shared storage or synchronization.
kernel.def target(@flash_next_mtp_wave32) @flash_next_mtp_fuse(%neural_enabled: i1) {
  %groups = index.constant 640 : index
  %tokens = config.get @flash_next.token_count : index
  %c4 = index.constant 4 : index
  %panel = index.min %tokens, %c4 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %rounding = index.sub %panel, %c1 : index
  %rounded = index.add %tokens, %rounding : index
  %panels = index.div %rounded, %panel : index
  %logical_workers = index.mul %panels, %groups : index
  %units = target.execution.unit.count : index
  %workers = func.call pure @flash_next_token_workers(%logical_workers, %c1, %units) : (index, index, index) -> (index)
  %c0_index = index.constant 0 : index
  %active_groups = scf.select %neural_enabled, %workers, %c0_index : index
  kernel.launch.config workgroups(%active_groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch_arg: buffer, %embedding_arg: buffer, %hidden_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %epoch, %embedding, %hidden, %weight, %output = buffer.assume.noalias %epoch_arg, %embedding_arg, %hidden_arg, %weight_arg, %output_arg : buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %worker = kernel.workgroup.id<x> : index
  %workers = kernel.workgroup.count<x> : index
  %count = func.call @flash_next_token_count(%epoch, %tokens) : (buffer, index) -> (index)
  %c4 = index.constant 4 : index
  %panel = index.min %tokens, %c4 : index
  %hidden_panel = index.mul %panel, %c4 : index
  %hidden_end = index.mul %count, %c4 : index
  %c1 = index.constant 1 : index
  %groups = index.constant 640 : index
  %rounding = index.sub %panel, %c1 : index
  %rounded = index.add %count, %rounding : index
  %panels = index.div %rounded, %panel : index
  %logical_workers = index.mul %panels, %groups : index
  scf.for %work = [%worker to %logical_workers step %workers] {
    %group = index.rem %work, %groups : index
    %token_panel = index.div %work, %groups : index
    %first = index.mul %token_panel, %panel : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %c0 = index.constant 0 : index
    %c32 = index.constant 32 : index
    %width = index.constant 2560 : index
    %row = index.madd %group, %c4, %wave : index
    %row_bytes = index.constant 5440 : offset
    %half_bytes = index.constant 2720 : offset
    %embedding_origin = index.scale %row, %row_bytes : index, offset -> offset
    %hidden_origin = index.add %embedding_origin, %half_bytes : offset
    %scale_bytes = index.constant 2 : offset
    %block_bytes = index.constant 34 : offset
    %embedding_codes = index.add %embedding_origin, %scale_bytes : offset
    %hidden_codes = index.add %hidden_origin, %scale_bytes : offset
    %hidden_first = index.mul %first, %c4 : index
    %embedding_partial = func.call @flash_next_q8_batch_dot(%width, %panel, %panel, %first, %count, %lane, %c32, %embedding_origin, %embedding_codes, %block_bytes, %block_bytes, %embedding, %weight) : (index, index, index, index, index, index, index, offset, offset, offset, offset, buffer, buffer) -> (vector<[%panel]xf32>)
    %hidden_partial = func.call @flash_next_q8_batch_dot(%width, %hidden_panel, %hidden_panel, %hidden_first, %hidden_end, %lane, %c32, %hidden_origin, %hidden_codes, %block_bytes, %block_bytes, %hidden, %weight) : (index, index, index, index, index, index, index, offset, offset, offset, offset, buffer, buffer) -> (vector<[%hidden_panel]xf32>)
    %embedding_sums = kernel.subgroup.reduce<addf> %embedding_partial : vector<[%panel]xf32>
    %hidden_sums = kernel.subgroup.reduce<addf> %hidden_partial : vector<[%hidden_panel]xf32>
    %origin = index.constant 0 : offset
    %outputs = buffer.view %output[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %leader = index.cmp eq, %lane, %c0 : index
    scf.if %leader {
      scf.for %ordinal = [%c0 to %panel step %c1] unroll schedule(linear) {
        %token = index.add %first, %ordinal : index
        %active = index.cmp ult, %token, %count : index
        scf.if %active {
          %embedding_sum = vector.extract %embedding_sums[%ordinal] : vector<[%panel]xf32> -> f32
          %embedding_packed = scalar.fptrunc %embedding_sum : f32 to bf16
          %embedding_value = scalar.extf %embedding_packed : bf16 to f32
          scf.for %stream = [%c0 to %c4 step %c1] unroll schedule(linear) {
            %hidden_ordinal = index.madd %ordinal, %c4, %stream : index
            %hidden_sum = vector.extract %hidden_sums[%hidden_ordinal] : vector<[%hidden_panel]xf32> -> f32
            %hidden_packed = scalar.fptrunc %hidden_sum : f32 to bf16
            %hidden_value = scalar.extf %hidden_packed : bf16 to f32
            %sum = scalar.addf %embedding_value, %hidden_value : f32
            %packed = scalar.fptrunc %sum : f32 to bf16
            view.store %packed, %outputs[%token, %stream, %row] : bf16, view<[%tokens]x4x2560xbf16>
          }
        }
      }
    }
  }
  kernel.return
}
