template.def<@flash_next.q8_schedule> device @flash_next_q8_128x128_read_ahead(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 128), eq(%tile_columns, 128), eq(%wave_rows, 4), eq(%wave_columns, 2), eq(%pipeline_depth, 2)] {
  template.apply<@flash_next.q8_tile>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
  template.return
}

// Long reductions amortize whole-block Q8 producers across 128-token panels.
// Paired K32 blocks share one K64 stage, halving publication barriers while
// retaining next-stage operand loads in registers. Coefficients and inputs
// round to F16 before F32 accumulation; no global conversion plane is needed.
template.def<@flash_next.q8_schedule> device priority(20) @flash_next_q8_128x128_long_reduction(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [ge(%capacity, 256), ge(%input_width, 2560), ge(%output_width, 2560), eq(%tile_rows, 128), eq(%tile_columns, 128), eq(%wave_rows, 4), eq(%wave_columns, 2), eq(%pipeline_depth, 2)] {
  %use_stage64 = scalar.constant true : i1
  template.apply<@flash_next.q8_tile_stage>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %use_stage64, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer)
  template.return
}
