template.def<@flash_next.q8_schedule> device @flash_next_q8_64x64_waves_2x2(%split_scales: i1, %capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 64), eq(%tile_columns, 64), eq(%wave_rows, 2), eq(%wave_columns, 2), eq(%pipeline_depth, 1)] {
