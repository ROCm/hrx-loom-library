template.def<@flash_next.q8_schedule> device @flash_next_q8_128x128_waves_4x2(%split_scales: i1, %capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 128), eq(%tile_columns, 128), eq(%wave_rows, 4), eq(%wave_columns, 2), eq(%pipeline_depth, 1)] {
  template.apply<@flash_next.q8_tile>(%split_scales, %capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %span, %input, %weight, %output) : (i1, index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
