// Flash-Next owns precision and launch policy. The shared Q8 motifs receive
// explicit geometry and storage facts, while this composition chooses F16
// reconstructed coefficients for wide cohorts and F32 block scaling otherwise.
// Dense entries unpack the model epoch header before contracting a live tile.

template.decl @ggml.q8_0_bf16.contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.decl @ggml.q8_0_f16.contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.decl @ggml.q8_0_f16.contract_k64(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.decl @flash_next.q8_contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.def<@flash_next.q8_contract> device @flash_next_q8_contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %row_bytes: offset, %weight_origin: offset, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>) {
  %threshold = index.constant 4096 : index
  %use_half = index.cmp uge, %capacity, %threshold : index
  %result = scf.if %use_half -> (vector<[%fragment_count]x8xf32>) {
    %tile = template.apply<@ggml.q8_0_f16.contract>(%capacity, %inputs, %outputs, %streams, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %fragment_count, %first, %end, %channel_base, %split_scales, %row_bytes, %weight_origin, %input, %weight) : (index, index, index, index, index, index, index, index, index, index, index, index, index, i1, offset, offset, buffer, buffer) -> (vector<[%fragment_count]x8xf32>)
    scf.yield %tile : vector<[%fragment_count]x8xf32>
  } else {
    %tile = template.apply<@ggml.q8_0_bf16.contract>(%capacity, %inputs, %outputs, %streams, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %fragment_count, %first, %end, %channel_base, %split_scales, %row_bytes, %weight_origin, %input, %weight) : (index, index, index, index, index, index, index, index, index, index, index, index, index, i1, offset, offset, buffer, buffer) -> (vector<[%fragment_count]x8xf32>)
    scf.yield %tile : vector<[%fragment_count]x8xf32>
  }
  template.return %result : vector<[%fragment_count]x8xf32>
}

template.decl @tensor.matrix.store_bf16_wave32(%remaining_rows: index, %outputs: index, %fragment_row: index, %result_column: index, %result: vector<8xf32>, %output_view: view<[%remaining_rows]x[%outputs]xbf16>)

template.decl @flash_next.q8_tile(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

template.decl @flash_next.q8_tile_stage(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %use_stage64: i1, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

// Dense Q8 publication rounds the contracted F32 tile once to BF16. The caller
// launches ceil(outputs/tile_columns) by ceil(capacity/tile_rows) workgroups
// of wave_rows*wave_columns*32 threads. Exact SSA geometry specializes before
// fragment lowering; the immutable epoch header supplies the live row extent.
// Operands and output are disjoint. Empty workgroups perform no memory access.
template.def<@flash_next.q8_tile_stage> device @flash_next_q8_tiled_stage(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %use_stage64: i1, %span_arg: buffer, %input_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %span, %input, %weight, %output = buffer.assume.noalias %span_arg, %input_arg, %weight_arg, %output_arg : buffer, buffer, buffer, buffer
  %inputs = index.assume %input_width [range(%input_width, 32, 10240), multiple_of(%input_width, 32)] : index
  %outputs = index.assume %output_width [range(%output_width, 4, 262144), multiple_of(%output_width, 4)] : index
  %origin = index.constant 0 : offset
  %header = buffer.view %span[%origin] : buffer -> view<3xi32>
  %count_word = view.load %header[0] : view<3xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %end = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %group = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %wave = kernel.subgroup.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %per_wave_rows = index.div %tile_rows, %wave_rows : index
  %per_wave_columns = index.div %tile_columns, %wave_columns : index
  %row_fragments = index.div %per_wave_rows, %c16 : index
  %column_fragments = index.div %per_wave_columns, %c16 : index
  %fragment_count = index.mul %row_fragments, %column_fragments : index
  %first = index.mul %batch, %tile_rows : index
  %active = index.cmp ult, %first, %end : index
  scf.if %active {
    %channel_base = index.mul %group, %tile_columns : index
    %wave_column_group = index.rem %wave, %wave_columns : index
    %wave_row_group = index.div %wave, %wave_columns : index
    %wave_channel = index.mul %wave_column_group, %per_wave_columns : index
    %wave_token = index.mul %wave_row_group, %per_wave_rows : index
    // Keep the workgroup origin in a full-width byte offset. Wave-local row
    // coordinates then remain small even when the complete output exceeds 4 GiB.
    %remaining_rows = index.sub %end, %first : index
    %element_bytes = index.constant 2 : offset
    %output_row_bytes = index.scale %outputs, %element_bytes : index, offset -> offset
    %tile_byte_offset = index.scale %first, %output_row_bytes : index, offset -> offset
    %output_view = buffer.view %output[%tile_byte_offset] : buffer -> view<[%remaining_rows]x[%outputs]xbf16>
    %block_width = index.constant 32 : index
    %block_bytes = index.constant 34 : offset
    %blocks = index.div %inputs, %block_width : index
    %row_bytes = index.scale %blocks, %block_bytes : index, offset -> offset
    %weight_origin = index.constant 0 : offset
    %split_scales = scalar.constant false : i1
    %result_tile = scf.if %use_stage64 -> (vector<[%fragment_count]x8xf32>) {
      %stage_tile = template.apply<@ggml.q8_0_f16.contract_k64>(%capacity, %inputs, %outputs, %c1, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %fragment_count, %first, %end, %channel_base, %split_scales, %row_bytes, %weight_origin, %input, %weight) : (index, index, index, index, index, index, index, index, index, index, index, index, index, i1, offset, offset, buffer, buffer) -> (vector<[%fragment_count]x8xf32>)
      scf.yield %stage_tile : vector<[%fragment_count]x8xf32>
    } else {
      %small_tile = template.apply<@flash_next.q8_contract>(%capacity, %inputs, %outputs, %c1, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %fragment_count, %first, %end, %channel_base, %split_scales, %row_bytes, %weight_origin, %input, %weight) : (index, index, index, index, index, index, index, index, index, index, index, index, index, i1, offset, offset, buffer, buffer) -> (vector<[%fragment_count]x8xf32>)
      scf.yield %small_tile : vector<[%fragment_count]x8xf32>
    }
    scf.for %ordinal = [%c0 to %fragment_count step %c1] unroll schedule(linear) {
      %row_fragment = index.div %ordinal, %column_fragments : index
      %column_fragment = index.rem %ordinal, %column_fragments : index
      %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
      %fragment_column = index.madd %column_fragment, %c16, %wave_channel : index
      %result_column = index.add %channel_base, %fragment_column : index
      %result = vector.extract %result_tile[%ordinal] : vector<[%fragment_count]x8xf32> -> vector<8xf32>
      template.apply<@tensor.matrix.store_bf16_wave32>(%remaining_rows, %outputs, %fragment_row, %result_column, %result, %output_view) : (index, index, index, index, vector<8xf32>, view<[%remaining_rows]x[%outputs]xbf16>)
    }
  }
  template.return
}

template.def<@flash_next.q8_tile> device @flash_next_q8_tiled(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span_arg: buffer, %input_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %threshold = index.constant 4096 : index
  %use_stage64 = index.cmp uge, %capacity, %threshold : index
  template.apply<@flash_next.q8_tile_stage>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %use_stage64, %span_arg, %input_arg, %weight_arg, %output_arg) : (index, index, index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer)
  template.return
}

// Schedule predicates are the public specialization contract. A kernel
// launch class retains these exact values without inspecting the body.
// Geometry and reduction width select the shared contraction and staging body.
template.decl @flash_next.q8_schedule(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

template.def<@flash_next.q8_schedule> device @flash_next_q8_16x64_waves_1x4(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 16), eq(%tile_columns, 64), eq(%wave_rows, 1), eq(%wave_columns, 4), eq(%pipeline_depth, 1)] {
  template.apply<@flash_next.q8_tile>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
  template.return
}

template.def<@flash_next.q8_schedule> device @flash_next_q8_32x64_waves_2x2(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 32), eq(%tile_columns, 64), eq(%wave_rows, 2), eq(%wave_columns, 2), eq(%pipeline_depth, 1)] {
  template.apply<@flash_next.q8_tile>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
  template.return
}

template.def<@flash_next.q8_schedule> device @flash_next_q8_32x32_waves_2x2(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 32), eq(%tile_columns, 32), eq(%wave_rows, 2), eq(%wave_columns, 2), eq(%pipeline_depth, 1)] {
  template.apply<@flash_next.q8_tile>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
  template.return
}

template.def<@flash_next.q8_schedule> device @flash_next_q8_64x64_waves_2x2(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) where [eq(%tile_rows, 64), eq(%tile_columns, 64), eq(%wave_rows, 2), eq(%wave_columns, 2), eq(%pipeline_depth, 1)] {
  template.apply<@flash_next.q8_tile>(%capacity, %input_width, %output_width, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %pipeline_depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
