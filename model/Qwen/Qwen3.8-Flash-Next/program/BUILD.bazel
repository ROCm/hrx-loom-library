        "//kernel/sequence/qwen3_8:mtp_proposal",
        "//model/Qwen/Qwen3.8-Flash-Next/program/dispatch",
        "//model/Qwen/Qwen3.8-Flash-Next/program/kernel:numerics",
        "//motif/format/ggml:iq4_nl",
        "//motif/format/ggml:q4_k",
        "//motif/format/ggml:q5_1",
        "//motif/format/ggml:q5_k",
        "//motif/format/ggml:q8_0",
        "//motif/sequence/qwen3_8:continuation",
