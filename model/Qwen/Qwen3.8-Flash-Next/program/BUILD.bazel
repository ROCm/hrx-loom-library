load("//build_tools/bazel:defs.bzl", "loom_library")

package(default_visibility = ["//model/Qwen/Qwen3.8-Flash-Next:__subpackages__"])

exports_files([
    "attention.loom",
    "config.loom",
    "epoch.loom",
    "ffn.loom",
    "head.loom",
    "identity.loom",
    "last_layer.loom",
    "layer.loom",
    "mtp.loom",
    "ple_residual.loom",
    "prepare.loom",
    "propose.loom",
    "qsa_attention.loom",
    "qsa_residual.loom",
    "speculation.loom",
    "verify.loom",
    "weights.loom",
])

loom_library(
    name = "config",
    srcs = [
        "config.loom",
    ],
)

loom_library(
    name = "identity",
    srcs = [
        "identity.loom",
    ],
)

loom_library(
    name = "prepare",
    srcs = [
        "prepare.loom",
    ],
    data = [
        "weights.loom",
    ],
    deps = ["//program/text/qwen3_8:storage"],
)

