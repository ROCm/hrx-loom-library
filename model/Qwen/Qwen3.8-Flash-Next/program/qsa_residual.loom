// Sparse attention and expert composition for a four-stream residual layer.
// The caller supplies page maps and retained reader/writer origins; the
// command publishes the attention-updated residual before FFN execution.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

command.program.decl @flash_next_hc_attn(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer)

command.program.decl @flash_next_qsa_attention(%neural_enabled: i1, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %output: buffer, %capture: buffer)

kernel.decl @hc_combine(%neural_enabled: i1) launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer)

// QSA advances paged main/index caches and private partial-block history.
// The residual and MoE contracts are shared with the GDN layers.
command.program.def public @flash_next_qsa_residual(%neural_enabled: i1, %layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %residual: buffer, %rows: buffer, %arena: buffer, %output: buffer, %capture: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %hidden_row_bytes = index.constant 5120 : offset
  %injection_row_bytes = index.constant 16 : offset
  %hidden_bytes = index.scale %tokens, %hidden_row_bytes : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_row_bytes : index, offset -> offset
  %mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  command.program.launch @flash_next_hc_attn[%neural_enabled, %layer](%parameters, %span, %residual, %injection, %mixed) : [i1, index](buffer, buffer, buffer, buffer, buffer)
  command.program.launch @flash_next_qsa_attention[%neural_enabled, %layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %span, %mapping, %rows, %mixed, %arena, %projected, %capture) : [i1, index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @hc_combine[%neural_enabled](%span, %residual, %projected, %injection, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
  command.return
}
