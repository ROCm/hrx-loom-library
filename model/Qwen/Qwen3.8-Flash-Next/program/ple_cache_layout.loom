// PLE workspace layout shared by storage preparation and device consumers.
// Residuals, the directory, resident/spill payload, mappings, and byte ranges
// occupy one allocation. Only completed fills can make resident payload valid.
// Mapping words contain the payload slot in bits 0-30 and unique fill ownership
// in bit 31. Resident capacity plus the live spill range fits below bit 31.
func.def public pure @flash_next_ple_cache_layout(%tokens: index) -> (offset, offset, offset, offset, offset, offset) {
  %residual_stride = index.constant 20480 : offset
  %residual_bytes = index.scale %tokens, %residual_stride : index, offset -> offset
  %header_bytes = index.constant 16 : offset
  %capacity, %ways = func.call pure @flash_next_ple_cache_dimensions() : () -> (index, index)
  %tag_bytes = index.constant 8 : offset
  %row_bytes = index.constant 90 : offset
  %directory_bytes = index.scale %capacity, %tag_bytes : index, offset -> offset
  %resident_bytes = index.scale %capacity, %row_bytes : index, offset -> offset
  %spill_stride = index.constant 1440 : offset
  %spill_bytes = index.scale %tokens, %spill_stride : index, offset -> offset
  %payload_bytes = index.add %resident_bytes, %spill_bytes : offset
  %mapping_stride = index.constant 64 : offset
  %mapping_bytes = index.scale %tokens, %mapping_stride : index, offset -> offset
  %descriptor_stride = index.constant 384 : offset
  %descriptor_bytes = index.scale %tokens, %descriptor_stride : index, offset -> offset
  %total, %residual, %header, %directory, %payload, %mapping, %descriptors = buffer.pack [align(256) %residual_bytes, align(256) %header_bytes, align(256) %directory_bytes, align(256) %payload_bytes, align(256) %mapping_bytes, align(256) %descriptor_bytes] : offset
  func.return %total, %header, %directory, %payload, %mapping, %descriptors : offset, offset, offset, offset, offset, offset
}

// Eight ways keep active rows stable while subsequent cohorts replace old rows.
// This bounds retained cache bytes independently of the full checkpoint table.
func.def public pure @flash_next_ple_cache_dimensions() -> (index, index) {
  %sets = index.constant 131072 : index
  %ways = index.constant 8 : index
  %capacity = index.mul %sets, %ways : index
  func.return %capacity, %ways : index, index
}
