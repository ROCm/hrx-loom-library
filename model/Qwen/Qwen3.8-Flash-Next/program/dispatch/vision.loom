// Flash-Next original-projector launch contracts. Geometry specializes the
// shared 1152-wide encoder, while checkpoint matrices retain original BF16
// storage and patch weights retain F32 storage. Residuals, affine terms, and
// accumulation remain F32; no converted checkpoint is required.
//
// K/V and attention expose all sixteen heads in one dispatch each: workgroup
// Z selects a four-head cohort with a disjoint resident K/V bank. The command
// owns these banks through attention completion and reuses them for FFN.
// Every merged patch publishes 2560 F32 language features into separate output.

amdgpu.target<gfx11-generic> @qwen38_vision_gfx11 {subgroup_size = 32}

config.decl @qwen38.vision.image_height : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.decl @qwen38.vision.image_width : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

template.decl @qwen38.vision.patch_embedding(%image_height: index, %image_width: index, %bf16: i1, %weights_f32: i1, %source_offset: offset, %source1_offset: offset, %source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_patch_embedding() {
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c18 = index.constant 18 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch_height = index.div %image_height, %c16 : index
  %patch_width = index.div %image_width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  %c63 = index.constant 63 : index
  %rounded_rows = index.add %rows, %c63 : index
  %row_groups = index.div %rounded_rows, %c64 : index
  kernel.launch.config workgroups(%row_groups, %c18, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%source_offset: offset, %source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer) {
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %bf16 = scalar.constant true : i1
  %weights_f32 = scalar.constant true : i1
  template.apply<@qwen38.vision.patch_embedding>(%image_height, %image_width, %bf16, %weights_f32, %source_offset, %source_offset, %source, %weight0, %weight1, %bias, %output) : (index, index, i1, i1, offset, offset, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

