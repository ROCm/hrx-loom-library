// Flash-Next gdn command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

command.decl @flash_next_capture_inputs(%neural_enabled: i1, %prefix_bytes: offset, %row_bytes: offset) launch(%epoch: buffer, %input: buffer, %capture: buffer)

kernel.decl @gdn_convolve() launch(%span_arg: buffer, %origins_arg: buffer, %layer_origin: offset, %qkv_arg: buffer, %weight_arg: buffer, %history_arg: buffer, %convolved_arg: buffer, %norm_arg: buffer)

kernel.decl @gdn_gate() launch(%span_arg: buffer, %raw_arg: buffer, %z_arg: buffer, %weight_arg: buffer, %output_arg: buffer)

kernel.decl @gdn_recur() launch(%span_arg: buffer, %origins_arg: buffer, %layer_origin: offset, %qkv_arg: buffer, %norm_arg: buffer, %alpha_arg: buffer, %beta_arg: buffer, %a_arg: buffer, %bias_arg: buffer, %state_arg: buffer, %output_arg: buffer)

kernel.decl @gdn_recur_window() launch(%span_arg: buffer, %origins_arg: buffer, %layer_origin: offset, %qkv_arg: buffer, %norm_arg: buffer, %alpha_arg: buffer, %beta_arg: buffer, %a_arg: buffer, %bias_arg: buffer, %state_arg: buffer, %output_arg: buffer)

// Recurrence and gating consume the same rounded convolution publications,
// regardless of whether projection and convolution shared an LDS tile.
command.def public @flash_next_gdn_finish(%layer: index, %state_origin: offset) launch(%parameters: buffer, %epoch: buffer, %rows: buffer, %convolved: buffer, %inverse_norm: buffer, %z: buffer, %alpha: buffer, %beta: buffer, %arena: buffer, %output: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %value_row_bytes = index.constant 12288 : offset
  %value_bytes = index.scale %tokens, %value_row_bytes : index, offset -> offset
  %raw = buffer.alloca<global> align(256) %value_bytes : buffer
  %a = command.parameter %parameters, "blk.{}.ssm_a"[%layer] : view<48xf32>
  %bias = command.parameter %parameters, "blk.{}.ssm_dt.bias"[%layer] : view<48xf32>
  %norm_weight = command.parameter %parameters, "blk.{}.ssm_norm.weight"[%layer] : view<128xf32>
  // Epoch capacity selects cooperative staging or the small wave body,
  // independently of individual span lengths. Replay keeps the small body.
  %window_threshold = index.constant 32 : index
  %use_windows = index.cmp uge, %tokens, %window_threshold : index
  scf.if %use_windows {
    kernel.launch @gdn_recur_window(%epoch, %rows, %state_origin, %convolved, %inverse_norm, %alpha, %beta, %a, %bias, %arena, %raw) : (buffer, buffer, offset, buffer, buffer, buffer, buffer, view<48xf32>, view<48xf32>, buffer, buffer)
  } else {
    kernel.launch @gdn_recur(%epoch, %rows, %state_origin, %convolved, %inverse_norm, %alpha, %beta, %a, %bias, %arena, %raw) : (buffer, buffer, offset, buffer, buffer, buffer, buffer, view<48xf32>, view<48xf32>, buffer, buffer)
  }
  kernel.launch @gdn_gate(%epoch, %raw, %z, %norm_weight, %output) : (buffer, buffer, buffer, view<128xf32>, buffer)
  command.return
}

// A layer stores its F32 recurrence followed by three BF16 convolution rows.
// Rows publish into a private writer selected by the retained-state pool. A
// fresh conversation synthesizes zeros in registers without clearing storage.
command.def public @flash_next_gdn_state(%layer: index, %state_origin: offset) launch(%parameters: buffer, %epoch: buffer, %rows: buffer, %qkv: buffer, %z: buffer, %alpha: buffer, %beta: buffer, %arena: buffer, %output: buffer, %capture: buffer) where [range(%layer, 0, 47)] {
  %neural_enabled = scalar.constant true : i1
  %tokens = config.get @flash_next.token_count : index
  %layer_group_size = index.constant 4 : index
  %prior_qsa = index.div %layer, %layer_group_size : index
  %ordinal = index.sub %layer, %prior_qsa : index
  %transition_bytes = index.constant 20864 : offset
  %prefix = index.scale %ordinal, %transition_bytes : index, offset -> offset
  %qkv_extent = index.constant 20480 : offset
  %gate_extent = index.constant 192 : offset
  %alpha_prefix = index.add %prefix, %qkv_extent : offset
  %beta_prefix = index.add %alpha_prefix, %gate_extent : offset
  command.launch @flash_next_capture_inputs[%neural_enabled, %prefix, %qkv_extent](%epoch, %qkv, %capture) : [i1, offset, offset](buffer, buffer, buffer)
  command.launch @flash_next_capture_inputs[%neural_enabled, %alpha_prefix, %gate_extent](%epoch, %alpha, %capture) : [i1, offset, offset](buffer, buffer, buffer)
  command.launch @flash_next_capture_inputs[%neural_enabled, %beta_prefix, %gate_extent](%epoch, %beta, %capture) : [i1, offset, offset](buffer, buffer, buffer)
  %qkv_row_bytes = index.constant 20480 : offset
  %norm_row_bytes = index.constant 128 : offset
  %state_bytes = index.constant 3145728 : offset
  %history_origin = index.add %state_origin, %state_bytes : offset
  %qkv_bytes = index.scale %tokens, %qkv_row_bytes : index, offset -> offset
  %norm_bytes = index.scale %tokens, %norm_row_bytes : index, offset -> offset
  %convolved = buffer.alloca<global> align(256) %qkv_bytes : buffer
  %inverse_norm = buffer.alloca<global> align(256) %norm_bytes : buffer
  %conv_weight = command.parameter %parameters, "blk.{}.ssm_conv1d.weight"[%layer] : view<10240x4xf32>
  kernel.launch @gdn_convolve(%epoch, %rows, %history_origin, %qkv, %conv_weight, %arena, %convolved, %inverse_norm) : (buffer, buffer, offset, buffer, view<10240x4xf32>, buffer, buffer, buffer)
  command.launch @flash_next_gdn_finish[%layer, %state_origin](%parameters, %epoch, %rows, %convolved, %inverse_norm, %z, %alpha, %beta, %arena, %output) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
