// Flash-Next routing command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @route_project(%neural_enabled: i1) launch(%span_arg: buffer, %input_arg: buffer, %route_weight_arg: buffer, %shared_weight_arg: buffer, %logits_arg: buffer, %gate_arg: buffer)

kernel.decl @route_top10(%neural_enabled: i1) launch(%span_arg: buffer, %logits_arg: buffer, %ids_arg: buffer, %weights_arg: buffer)

command.program.def public @flash_next_route(%neural_enabled: i1, %layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %row_bytes = index.constant 2048 : offset
  %bytes = index.scale %tokens, %row_bytes : index, offset -> offset
  %logits = buffer.alloca<global> align(256) %bytes : buffer
  %route_weight = command.parameter %parameters, "blk.{}.ffn_gate_inp.weight"[%layer] : view<512x2560xf32>
  %shared_weight = command.parameter %parameters, "blk.{}.ffn_gate_inp_shexp.weight"[%layer] : view<2560xf32>
  kernel.launch @route_project[%neural_enabled](%span, %input, %route_weight, %shared_weight, %logits, %shared_gate) : [i1](buffer, buffer, view<512x2560xf32>, view<2560xf32>, buffer, buffer)
  kernel.launch @route_top10[%neural_enabled](%span, %logits, %ids, %weights) : [i1](buffer, buffer, buffer, buffer)
  command.return
}
