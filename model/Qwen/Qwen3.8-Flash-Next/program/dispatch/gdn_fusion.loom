// Flash-Next gdn fusion command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

config.decl @flash_next.span_capacity : %value: index where [range(%value, 1, 2147483647)]

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @gdn_fused_boundary(%active_spans: index) launch(%epoch_arg: buffer, %rows_arg: buffer, %history_origin: offset, %halo_arg: buffer, %weight_arg: buffer, %arena_arg: buffer, %output_arg: buffer, %norm_arg: buffer)

kernel.decl @gdn_fused_projection(%active_rows: index) launch(%epoch_arg: buffer, %input_arg: buffer, %weight_arg: buffer, %conv_arg: buffer, %halo_arg: buffer, %output_arg: buffer, %norm_arg: buffer, %capture_arg: buffer, %capture_origin: offset)

// Each head/session owner resolves its prefix against retained history before
// publishing the next history. The complete raw projection plane stays in LDS;
// six rows per tile/span intersection are sufficient for boundary resolution.
command.def public @flash_next_gdn_fused_convolve(%active_rows: index, %active_spans: index, %history_origin: offset, %capture_origin: offset) launch(%epoch: buffer, %rows: buffer, %input: buffer, %weight: buffer, %conv_weight: buffer, %arena: buffer, %convolved: buffer, %inverse_norm: buffer, %capture: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %spans = config.get @flash_next.span_capacity : index
  %tile = index.constant 128 : index
  %rounding = index.constant 127 : index
  %c1 = index.constant 1 : index
  %padded = index.add %tokens, %rounding : index
  %tiles = index.div %padded, %tile : index
  %slots_with_tail = index.add %tiles, %spans : index
  %slots = index.sub %slots_with_tail, %c1 : index
  %halo_stride = index.constant 122880 : offset
  %halo_bytes = index.scale %slots, %halo_stride : index, offset -> offset
  %halo = buffer.alloca<global> align(256) %halo_bytes : buffer
  kernel.launch @gdn_fused_projection[%active_rows](%epoch, %input, %weight, %conv_weight, %halo, %convolved, %inverse_norm, %capture, %capture_origin) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, offset)
  kernel.launch @gdn_fused_boundary[%active_spans](%epoch, %rows, %history_origin, %halo, %conv_weight, %arena, %convolved, %inverse_norm) : [index](buffer, buffer, offset, buffer, buffer, buffer, buffer, buffer)
  command.return
}
