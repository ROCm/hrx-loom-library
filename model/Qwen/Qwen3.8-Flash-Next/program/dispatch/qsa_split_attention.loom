// Flash-Next qsa split attention command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @qsa_attention_merge(%neural_enabled: i1) launch(%span: buffer, %query_gate: buffer, %partial_buffer: buffer, %output: buffer)

kernel.decl @qsa_attention_partial(%neural_enabled: i1) launch(%key_origin: offset, %value_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %query_gate: buffer, %arena: buffer, %selected_blocks: buffer, %output: buffer)

command.def public @qsa_split_attention(%neural_enabled: i1, %key_origin: offset, %value_origin: offset) launch(%span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %query_gate: buffer, %arena: buffer, %selected_blocks: buffer, %output: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %partial_row_bytes = index.constant 198144 : offset
  %partial_bytes = index.scale %tokens, %partial_row_bytes : index, offset -> offset
  %partials = buffer.alloca<global> align(16) %partial_bytes : buffer
  kernel.launch @qsa_attention_partial[%neural_enabled](%key_origin, %value_origin, %span, %mapping, %rows, %queries, %query_gate, %arena, %selected_blocks, %partials) : [i1](offset, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qsa_attention_merge[%neural_enabled](%span, %query_gate, %partials, %output) : [i1](buffer, buffer, buffer, buffer)
  command.return
}
