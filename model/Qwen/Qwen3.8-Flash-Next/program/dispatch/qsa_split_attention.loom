// Flash-Next qsa split attention command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

kernel.decl @qsa_attention_merge(%query_count: index) launch(%span: buffer, %query_gate: buffer, %partial_buffer: buffer, %output: buffer)

kernel.decl @qsa_attention_partial(%query_count: index) launch(%key_origin: offset, %value_origin: offset, %span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %query_gate: buffer, %arena: buffer, %selected_blocks: buffer, %output: buffer)

command.def public @qsa_split_attention(%query_count: index, %maximum_queries: index, %key_origin: offset, %value_origin: offset) launch(%span: buffer, %mapping: buffer, %rows: buffer, %queries: buffer, %query_gate: buffer, %arena: buffer, %selected_blocks: buffer, %output: buffer) {
  %partial_row_bytes = index.constant 198144 : offset
  %partial_bytes = index.scale %maximum_queries, %partial_row_bytes : index, offset -> offset
  %partials = buffer.alloca<global> align(16) %partial_bytes : buffer
  kernel.launch @qsa_attention_partial[%query_count](%key_origin, %value_origin, %span, %mapping, %rows, %queries, %query_gate, %arena, %selected_blocks, %partials) : [index](offset, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qsa_attention_merge[%query_count](%span, %query_gate, %partials, %output) : [index](buffer, buffer, buffer, buffer)
  command.return
}
