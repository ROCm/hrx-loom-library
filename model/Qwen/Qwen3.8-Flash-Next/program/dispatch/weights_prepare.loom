// In-place parameter permutation. The model policy supplies exact dimensions;
// reflection retains one mutable binding with the original checkpoint extent.
config.decl @flash_next.prepare_inputs : %value: index where [range(%value, 32, 6144), multiple_of(%value, 32)]

config.decl @flash_next.prepare_outputs : %value: index where [range(%value, 4, 10240), multiple_of(%value, 4)]

kernel.decl @flash_next_prepare_q8_channels(%configured_inputs: index, %configured_outputs: index) launch(%input_width: index, %weight: buffer)

command.def public @flash_next_prepare_q8() launch(%weight: buffer) {
  %inputs = config.get @flash_next.prepare_inputs : index
  %outputs = config.get @flash_next.prepare_outputs : index
  kernel.launch @flash_next_prepare_q8_channels[%inputs, %outputs](%inputs, %weight) : [index, index](index, buffer)
  command.return
}
