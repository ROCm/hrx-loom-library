// Flash-Next weights prepare command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

kernel.decl @flash_next_prepare_qkv_channels(%output_width: index) launch(%weight: buffer)

// Loader reflection sees one mutable binding with exactly the original size.
command.program.def public @flash_next_prepare_qkv() launch(%weight: buffer) {
  %outputs = index.constant 10240 : index
  kernel.launch @flash_next_prepare_qkv_channels[%outputs](%weight) : [index](buffer)
  command.return
}
