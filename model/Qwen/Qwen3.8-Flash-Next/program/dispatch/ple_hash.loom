// Flash-Next ple hash command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @flash_next_ple_hash_ids() launch(%history_origin: offset, %span_arg: buffer, %mapping: buffer, %origins: buffer, %tokens_arg: buffer, %history_arg: buffer, %rows_arg: buffer)

command.program.decl @flash_next_ple_lookup() launch(%parameters: buffer, %span: buffer, %row_ids: buffer, %output: buffer)

kernel.decl @flash_next_ple_publish_history() launch(%history_origin: offset, %span: buffer, %origins: buffer, %tokens: buffer, %arena: buffer)

command.program.def public @flash_next_ple_hash(%history_origin: offset) launch(%span: buffer, %mapping: buffer, %origins: buffer, %tokens: buffer, %arena: buffer, %rows: buffer) {
  kernel.launch @flash_next_ple_hash_ids(%history_origin, %span, %mapping, %origins, %tokens, %arena, %rows) : (offset, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_ple_publish_history(%history_origin, %span, %origins, %tokens, %arena) : (offset, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @flash_next_ple_embed(%history_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %origins: buffer, %tokens: buffer, %arena: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %row_bytes = index.constant 64 : offset
  %bytes = index.scale %capacity, %row_bytes : index, offset -> offset
  %rows = buffer.alloca<global> align(64) %bytes : buffer
  command.program.launch @flash_next_ple_hash[%history_origin](%span, %mapping, %origins, %tokens, %arena, %rows) : [offset](buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @flash_next_ple_lookup(%parameters, %span, %rows, %output) : (buffer, buffer, buffer, buffer)
  command.return
}
