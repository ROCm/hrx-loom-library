// Flash-Next embedding command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

kernel.decl @flash_next_embedding_q8_0() launch(%epoch: buffer, %ids: buffer, %weight: buffer, %residual: buffer)

// The checkpoint keeps 80 Q8_0 blocks per vocabulary row. Command reflection
// owns the immutable allocation and the loader supplies its original bytes.
command.def public @flash_next_embed() launch(%parameters: buffer, %span: buffer, %token_ids: buffer, %residual: buffer) {
  %embedding = command.parameter %parameters, "token_embd.weight" : view<675430400xi8>
  kernel.launch @flash_next_embedding_q8_0(%span, %token_ids, %embedding, %residual) : (buffer, buffer, view<675430400xi8>, buffer)
  command.return
}
