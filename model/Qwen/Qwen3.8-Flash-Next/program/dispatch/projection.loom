// Flash-Next projection command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

template.decl @flash_next.project_dense_q8(%neural_enabled: i1, %inputs: index, %outputs: index, %blocks: index, %span: buffer, %input: buffer, %weight: view<[%outputs]x[%blocks]x34xi8>, %output: buffer)

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

command.program.decl @flash_next_gdn_fused_state(%layer: index, %state_origin: offset) launch(%parameters: buffer, %epoch: buffer, %rows: buffer, %input: buffer, %z: buffer, %alpha: buffer, %beta: buffer, %arena: buffer, %output: buffer, %capture: buffer)

command.program.decl @flash_next_gdn_state(%layer: index, %state_origin: offset) launch(%parameters: buffer, %span: buffer, %rows: buffer, %qkv: buffer, %z: buffer, %alpha: buffer, %beta: buffer, %arena: buffer, %output: buffer, %capture: buffer)

kernel.decl @flash_next_project_qkv(%configured_output_width: index) launch(%output_width: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @gdn_project_alpha_beta() launch(%span_arg: buffer, %input_arg: buffer, %alpha_weight_arg: buffer, %beta_weight_arg: buffer, %alpha_arg: buffer, %beta_arg: buffer)

// QKV uses the prepared code/scale planes; other projections keep GGUF order.
// These projections surround the packed state command. Input
// and output have the model's hidden width; state/history advance only through
// the active span. Scratch activation publications remain BF16 except for the
// small per-head alpha/beta vectors and Q/K inverse norms.
command.program.def public @flash_next_gdn_attention(%layer: index, %state_origin: offset) launch(%parameters: buffer, %span: buffer, %input: buffer, %rows: buffer, %arena: buffer, %output: buffer, %capture: buffer) {
  %neural_enabled = scalar.constant true : i1
  %tokens = config.get @flash_next.token_count : index
  %hidden = index.constant 2560 : index
  %conv_width = index.constant 10240 : index
  %value_width = index.constant 6144 : index
  %value_row_bytes = index.constant 12288 : offset
  %scalar_row_bytes = index.constant 192 : offset
  %value_bytes = index.scale %tokens, %value_row_bytes : index, offset -> offset
  %scalar_bytes = index.scale %tokens, %scalar_row_bytes : index, offset -> offset
  %z = buffer.alloca<global> align(256) %value_bytes : buffer
  %alpha = buffer.alloca<global> align(256) %scalar_bytes : buffer
  %beta = buffer.alloca<global> align(256) %scalar_bytes : buffer
  %gated = buffer.alloca<global> align(256) %value_bytes : buffer
  %z_weight = command.parameter %parameters, "blk.{}.attn_gate.weight"[%layer] : view<6144x80x34xi8>
  %alpha_weight = command.parameter %parameters, "blk.{}.ssm_alpha.weight"[%layer] : view<48x2560xf32>
  %beta_weight = command.parameter %parameters, "blk.{}.ssm_beta.weight"[%layer] : view<48x2560xf32>
  %output_weight = command.parameter %parameters, "blk.{}.ssm_out.weight"[%layer] : view<2560x192x34xi8>
  %z_weight_block_size = index.constant 32 : index
  %z_weight_blocks = index.div %hidden, %z_weight_block_size : index
  %z_weight_shaped = view.refine %z_weight : view<6144x80x34xi8> -> view<[%value_width]x[%z_weight_blocks]x34xi8>
  template.apply<@flash_next.project_dense_q8>(%neural_enabled, %hidden, %value_width, %z_weight_blocks, %span, %input, %z_weight_shaped, %z) : (i1, index, index, index, buffer, buffer, view<[%value_width]x[%z_weight_blocks]x34xi8>, buffer)
  kernel.launch @gdn_project_alpha_beta(%span, %input, %alpha_weight, %beta_weight, %alpha, %beta) : (buffer, buffer, view<48x2560xf32>, view<48x2560xf32>, buffer, buffer)
  // Large epochs keep raw QKV in LDS except for compact session/tile halos.
  // Small epochs and sparse speculative replay retain their wave bodies.
  %fused_threshold = index.constant 128 : index
  %use_fusion = index.cmp uge, %tokens, %fused_threshold : index
  scf.if %use_fusion {
    command.program.launch @flash_next_gdn_fused_state[%layer, %state_origin](%parameters, %span, %rows, %input, %z, %alpha, %beta, %arena, %gated, %capture) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  } else {
    %qkv_row_bytes = index.constant 20480 : offset
    %qkv_bytes = index.scale %tokens, %qkv_row_bytes : index, offset -> offset
    %qkv = buffer.alloca<global> align(256) %qkv_bytes : buffer
    %qkv_weight = command.parameter %parameters, "blk.{}.attn_qkv.weight"[%layer] : view<10240x80x34xi8>
    kernel.launch @flash_next_project_qkv[%conv_width](%conv_width, %span, %input, %qkv_weight, %qkv) : [index](index, buffer, buffer, view<10240x80x34xi8>, buffer)
    command.program.launch @flash_next_gdn_state[%layer, %state_origin](%parameters, %span, %rows, %qkv, %z, %alpha, %beta, %arena, %gated, %capture) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  }
  %output_weight_block_size = index.constant 32 : index
  %output_weight_blocks = index.div %value_width, %output_weight_block_size : index
  %output_weight_shaped = view.refine %output_weight : view<2560x192x34xi8> -> view<[%hidden]x[%output_weight_blocks]x34xi8>
  template.apply<@flash_next.project_dense_q8>(%neural_enabled, %value_width, %hidden, %output_weight_blocks, %span, %gated, %output_weight_shaped, %output) : (i1, index, index, index, buffer, buffer, view<[%hidden]x[%output_weight_blocks]x34xi8>, buffer)
  command.return
}
