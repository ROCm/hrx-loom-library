load("//build_tools/bazel:defs.bzl", "loom_library")

package(default_visibility = ["//model/Qwen/Qwen3.8-Flash-Next:__subpackages__"])

exports_files([
    "capture.loom",
    "embedding.loom",
    "experts.loom",
    "gdn.loom",
    "gdn_fusion.loom",
    "hyperconnection.loom",
    "ple_consumer.loom",
    "ple_hash.loom",
    "ple_lookup.loom",
    "projection.loom",
    "qsa_split_attention.loom",
    "routing.loom",
    "vision.loom",
    "weights_prepare.loom",
])

loom_library(
    name = "dispatch",
    srcs = [
        "embedding.loom",
        "experts.loom",
        "gdn.loom",
        "gdn_fusion.loom",
        "hyperconnection.loom",
        "ple_consumer.loom",
        "ple_hash.loom",
        "ple_lookup.loom",
        "projection.loom",
        "qsa_split_attention.loom",
        "routing.loom",
        "weights_prepare.loom",
        "capture.loom",
    ],
    deps = [
        "//model/Qwen/Qwen3.8-Flash-Next/program:config",
        "//model/Qwen/Qwen3.8-Flash-Next/program/kernel:numerics",
    ],
)

loom_library(
    name = "vision",
    srcs = ["vision.loom"],
    deps = [
        "//model/Qwen/Qwen3.8-Flash-Next/program:config",
        "//motif/vision/qwen3_8:attention",
        "//motif/vision/qwen3_8:ffn",
        "//motif/vision/qwen3_8:key_value",
        "//motif/vision/qwen3_8:merger",
        "//motif/vision/qwen3_8:normalization",
        "//motif/vision/qwen3_8:patch",
        "//motif/vision/qwen3_8:resize",
    ],
)
