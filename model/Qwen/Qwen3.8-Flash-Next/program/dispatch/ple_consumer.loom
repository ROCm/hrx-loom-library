// Flash-Next ple consumer command composition.
// The prepared stage supplies capacities and parameter bindings; these
// commands own intermediate buffers and ordered device launches.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

command.program.decl @flash_next_capture_inputs(%prefix_bytes: offset, %row_bytes: offset) launch(%epoch: buffer, %input: buffer, %capture: buffer)

kernel.decl @flash_next_ple_convolve() launch(%history_origin: offset, %origins: buffer, %span_arg: buffer, %gated_arg: buffer, %normalized_arg: buffer, %weight_arg: buffer, %history_arg: buffer, %residual_arg: buffer, %output_arg: buffer)

kernel.decl @flash_next_ple_gate_normalize() launch(%span_arg: buffer, %key_arg: buffer, %value_arg: buffer, %residual_arg: buffer, %key_gamma_arg: buffer, %query_gamma_arg: buffer, %conv_gamma_arg: buffer, %gated_arg: buffer, %normalized_arg: buffer)

command.program.def public @flash_next_ple_consume(%layer: index, %history_origin: offset) launch(%parameters: buffer, %span: buffer, %origins: buffer, %key: buffer, %value: buffer, %residual: buffer, %history: buffer, %output: buffer, %capture: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %row_bytes = index.constant 20480 : offset
  %bytes = index.scale %capacity, %row_bytes : index, offset -> offset
  %gated = buffer.alloca<global> align(256) %bytes : buffer
  %normalized = buffer.alloca<global> align(256) %bytes : buffer
  %key_gamma = command.parameter %parameters, "blk.{}.ple_norm_key.weight"[%layer] : view<4x2560xf32>
  %query_gamma = command.parameter %parameters, "blk.{}.ple_norm_query.weight"[%layer] : view<4x2560xf32>
  %conv_gamma = command.parameter %parameters, "blk.{}.ple_norm_conv.weight"[%layer] : view<4x2560xf32>
  %conv_weight = command.parameter %parameters, "blk.{}.ple_conv1d.weight"[%layer] : view<10240x4xf32>
  kernel.launch @flash_next_ple_gate_normalize(%span, %key, %value, %residual, %key_gamma, %query_gamma, %conv_gamma, %gated, %normalized) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, view<4x2560xf32>, view<4x2560xf32>, buffer, buffer)
  %capture_prefix = index.constant 751104 : offset
  command.program.launch @flash_next_capture_inputs[%capture_prefix, %row_bytes](%span, %normalized, %capture) : [offset, offset](buffer, buffer, buffer)
  kernel.launch @flash_next_ple_convolve(%history_origin, %origins, %span, %gated, %normalized, %conv_weight, %history, %residual, %output) : (offset, buffer, buffer, buffer, buffer, view<10240x4xf32>, buffer, buffer, buffer)
  command.return
}
