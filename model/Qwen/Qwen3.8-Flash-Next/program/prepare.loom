// Cold text-service preparation for the Flash-Next checkpoint. Named
// parameter scopes produce shared source handles, shape-specialized stages,
// and explicit allocation/retained-state records for the shared text owner.

// flash_next_epoch_output_only
global.rodata.def @output_only_root = bytes("666c6173685f6e6578745f65706f63685f6f75747075745f6f6e6c79")

// The shared text owner supplies validated capacities and packed shape pairs.
// This program declares the checkpoint's exact storage and stage catalog;
// it neither discovers filenames nor transforms the original packed tensors.
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)

func.decl @qwen38.packet_capacity(%shapes: buffer, %shape_count: i64, %prefill: i64) -> (i64)

func.decl @qwen38.allocation(%records: buffer, %slot: index, %bytes: i64, %initial_zero_bytes: i64)

func.decl @qwen38.row_view(%records: buffer, %row_count: index, %row: index, %slot: index, %offset: i64, %length: i64)

func.decl @qwen38_packet_bytes(%capacity: index) -> (offset)

func.decl @qwen38.control_create(%packet_capacity: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %packed: i1, %enabled: i1, %dflash: i1) -> (buffer)

func.decl @qwen38.control_resize(%state: buffer, %rows: i64) -> (buffer, i64, i64, i64, i64, i1, i1, i1)

func.decl @qwen38.proposal_level(%count: i32) -> (i32)

func.def public @text_resize_state_v1(%state: buffer, %rows: i64) -> (buffer, buffer, buffer, buffer, buffer, buffer) {
  %grown, %packet_capacity, %context, %pool, %pins, %packed, %enabled, %dflash = func.call @qwen38.control_resize(%state, %rows) : (buffer, i64) -> (buffer, i64, i64, i64, i64, i1, i1, i1)
  %allocations, %views, %target, %draft, %geometry = func.call @qwen38.storage(%packet_capacity, %context, %pool, %rows, %pins, %packed, %enabled, %dflash) : (i64, i64, i64, i64, i64, i1, i1, i1) -> (buffer, buffer, buffer, buffer, buffer)
  func.return %grown, %allocations, %views, %target, %draft, %geometry : buffer, buffer, buffer, buffer, buffer, buffer
}

global.rodata.def @model_scope = bytes("6d6f64656c")

global.rodata.def @draft_scope = bytes("6472616674")

// flash_next_epoch
global.rodata.def @root = bytes("666c6173685f6e6578745f65706f6368")

// flash_next_mtp_propose
