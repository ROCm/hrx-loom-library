// Cold Flash-Next preparation binds checkpoint parameters, declares command
// handles for the execution phases, and sizes retained storage. Image-enabled
// compositions add a second input layout for mixed token/feature records.
config.def @flash_next.image_inputs = false : i1

func.decl @qwen38_feedback_bytes(%capacity: index) -> (offset)

func.decl @qwen38_feedback_bank_bytes(%capacity: index) -> (offset)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @dispatch(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)

func.decl pure @qwen38.padded_tokens(%tokens: i64) -> (i64)

func.decl @qwen38.allocation(%records: buffer, %slot: index, %bytes: i64, %initial_zero_bytes: i64)

func.decl @qwen38.row_view(%records: buffer, %row_count: index, %row: index, %slot: index, %offset: i64, %length: i64)

func.decl @qwen38_packet_bytes(%capacity: index) -> (offset)

func.decl @qwen38.control_create(%packet_capacity: i64, %feedback_capacity: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %packed: i1, %enabled: i1, %dflash: i1, %provider_bytes: offset) -> (buffer)

func.decl readonly @qwen38.control_has_draft(%state: buffer) -> (i1)

func.decl @qwen38.control_context(%state: buffer) -> (i64, offset)

func.decl @qwen38.control_resize(%state: buffer, %rows: i64) -> (buffer, i64, i64, i64, i64, i64, i1, i1, i1)

func.decl @qwen38.speculation_configure(%state: buffer, %ceiling: i32, %capacity: i32)

func.decl @qwen38.speculation_register_width(%state: buffer, %level: index, %width: i32)

func.def public @text_resize_state_v2(%state: buffer, %rows: i64) -> (buffer, buffer, buffer, buffer, buffer, buffer) {
  %grown, %packet_capacity, %feedback_capacity, %context, %pool, %pins, %packed, %enabled, %dflash = func.call @qwen38.control_resize(%state, %rows) : (buffer, i64) -> (buffer, i64, i64, i64, i64, i64, i1, i1, i1)
  %allocations, %views, %target, %draft, %geometry = func.call @qwen38.storage(%packet_capacity, %feedback_capacity, %context, %pool, %rows, %pins, %packed, %enabled, %dflash) : (i64, i64, i64, i64, i64, i64, i1, i1, i1) -> (buffer, buffer, buffer, buffer, buffer)
  func.return %grown, %allocations, %views, %target, %draft, %geometry : buffer, buffer, buffer, buffer, buffer, buffer
}

global.rodata.def @model_scope = bytes("6d6f64656c")

global.rodata.def @draft_scope = bytes("6472616674")

// flash_next_mtp_propose
global.rodata.def @proposal_root = bytes("666c6173685f6e6578745f6d74705f70726f706f7365")

// flash_next_mtp_warm
global.rodata.def @warm_root = bytes("666c6173685f6e6578745f6d74705f7761726d")

// flash_next_continue
global.rodata.def @continue_root = bytes("666c6173685f6e6578745f636f6e74696e7565")

// flash_next.verification_width
global.rodata.def @verification_key = bytes("666c6173685f6e6578742e766572696669636174696f6e5f7769647468")

// flash_next.draft_depth
global.rodata.def @draft_depth_key = bytes("666c6173685f6e6578742e64726166745f6465707468")

// flash_next.token_count
global.rodata.def @tokens_key = bytes("666c6173685f6e6578742e746f6b656e5f636f756e74")

// flash_next.epoch_capacity
global.rodata.def @epoch_capacity_key = bytes("666c6173685f6e6578742e65706f63685f6361706163697479")

// flash_next.span_capacity
global.rodata.def @spans_key = bytes("666c6173685f6e6578742e7370616e5f6361706163697479")

// flash_next.context_capacity
global.rodata.def @context_key = bytes("666c6173685f6e6578742e636f6e746578745f6361706163697479")

// flash_next.pool_capacity
global.rodata.def @pool_key = bytes("666c6173685f6e6578742e706f6f6c5f6361706163697479")

// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")

// <|im_end|>
global.rodata.def @terminal = bytes("3c7c696d5f656e647c3e")

// qwen38.feedback_capacity
global.rodata.def @feedback_capacity_key = bytes("7177656e33382e666565646261636b5f6361706163697479")

// qwen38.packet_capacity
global.rodata.def @packet_capacity_key = bytes("7177656e33382e7061636b65745f6361706163697479")

// runner.qwen38.mixed_inputs
global.rodata.def @mixed_key = bytes("72756e6e65722e7177656e33382e6d697865645f696e70757473")

// Each root selects a contiguous view of the shared parameter bank. Proposal
// keeps target embedding and vocabulary in separate roots; warm selects three
// sidecar subviews for input fusion, attention mixing, and cache append.
func.def @declare_stage(%root: buffer, %tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %draft_source: i32, %sidecar_roots: i32, %target_roots: i32, %verification: i64, %packet_capacity: i64, %mixed: i64) -> (i32) {
  %stage = func.call @stage(%root, %tokens) : (buffer, i64) -> (i32)
  %mixed_key = global.load @mixed_key : buffer
  func.call @config_i64(%stage, %mixed_key, %mixed) : (i32, buffer, i64)
  %packet_key = global.load @packet_capacity_key : buffer
  func.call @config_i64(%stage, %packet_key, %packet_capacity) : (i32, buffer, i64)
  %tokens_key = global.load @tokens_key : buffer
  %spans_key = global.load @spans_key : buffer
  %context_key = global.load @context_key : buffer
  %pool_key = global.load @pool_key : buffer
  func.call @config_i64(%stage, %tokens_key, %tokens) : (i32, buffer, i64)
  func.call @config_i64(%stage, %spans_key, %spans) : (i32, buffer, i64)
  func.call @config_i64(%stage, %context_key, %context) : (i32, buffer, i64)
  func.call @config_i64(%stage, %pool_key, %pool) : (i32, buffer, i64)
  %verification_key = global.load @verification_key : buffer
  func.call @config_i64(%stage, %verification_key, %verification) : (i32, buffer, i64)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %sidecar_value = index.cast %sidecar_roots : i32 to index
  %sidecar_count = index.assume %sidecar_value [range(%sidecar_value, 0, 3)] : index
  %target_value = index.cast %target_roots : i32 to index
  %target_count = index.assume %target_value [range(%target_value, 0, 2)] : index
  %policy = global.load @policy : buffer
  %source = scalar.constant 0 : i32
  scf.for %root = [%c0 to %sidecar_count step %c1] {
    %binding = index.cast %root : index to i32
    func.call @parameter(%stage, %binding, %source, %draft_source, %policy) : (i32, i32, i32, i32, buffer)
  }
  scf.for %root = [%c0 to %target_count step %c1] {
    %ordinal = index.add %sidecar_count, %root : index
    %binding = index.cast %ordinal : index to i32
    func.call @parameter(%stage, %binding, %source, %model_source, %policy) : (i32, i32, i32, i32, buffer)
  }
  func.return %stage : i32
}

// Target and draft cache planes form fixed prefixes. Private state follows
// those planes, so adding residents preserves every existing payload address.
// Fresh kernels synthesize empty state; these arenas need no initial fill.
// One recurrent slot contains 36 GDN states, PLE token/convolution history, and
// twelve QSA incomplete-block tails. KV and index pages share physical page IDs.
func.def @qwen38.storage(%tokens: i64, %feedback_capacity: i64, %context: i64, %pool: i64, %rows_arg: i64, %pins: i64, %packed: i1, %enabled: i1, %dflash: i1) -> (buffer, buffer, buffer, buffer, buffer) {
  %rows = scalar.assume %rows_arg [range(%rows_arg, 1, 2147483647)] : i64
  %packet_capacity = scalar.assume %tokens [range(%tokens, 2, 2147483646)] : i64
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %c11 = index.constant 11 : index
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c0_i32 = scalar.constant 0 : i32
  %block_tokens = scalar.constant 64 : i64
  %word_bytes = scalar.constant 4 : i64
  %origin_stride = scalar.constant 40 : i64
  %map_origin = scalar.muli %rows, %origin_stride : i64
  %recurrent_origin = scalar.constant 256 : i64
  %recurrent_bytes = scalar.constant 115652096 : i64
  %control_bytes = scalar.constant 12 : i64
  %input_bytes = scalar.constant 2048 : i64
  %progress_bytes = scalar.constant 32 : i64
  %progress_extent = scalar.constant 256 : i64
  %input_origin = scalar.addi %recurrent_origin, %recurrent_bytes : i64
  %progress_origin = scalar.addi %input_origin, %input_bytes : i64
  %slot_stride = scalar.addi %progress_origin, %progress_extent : i64
  %has_pins = scalar.cmpi ne, %pins, %c0_i64 : i64
  %owners = scalar.addi %rows, %pins : i64
  %with_writers = scalar.addi %owners, %rows : i64
  %slot_count = scf.select %has_pins, %with_writers, %rows : i64
  %private_bytes = scalar.muli %slot_stride, %slot_count : i64
  %cache_token_bytes = scalar.constant 25344 : i64
  %cache_bytes = scalar.muli %pool, %cache_token_bytes : i64
  %arena_bytes = scalar.addi %private_bytes, %cache_bytes : i64
  %blocks_per_row = scalar.divui %context, %block_tokens : i64
  %map_entries = scalar.muli %blocks_per_row, %rows : i64
  %map_bytes = scalar.muli %map_entries, %word_bytes : i64
  %table_bytes = scalar.addi %map_origin, %map_bytes : i64
  %cache_tokens = index.cast %tokens : i64 to index
  %ple_workspace_bytes, %cache_header, %cache_directory, %cache_payload, %cache_mapping = func.call pure @flash_next_ple_cache_layout(%cache_tokens) : (index) -> (offset, offset, offset, offset, offset)
  %residual_bytes = index.cast %ple_workspace_bytes : offset to i64
  %packet_count = index.cast %packet_capacity : i64 to index
  %packet_extent = func.call @qwen38_packet_bytes(%packet_count) : (index) -> (offset)
  %metadata_bytes = index.cast %packet_extent : offset to i64
  %two_plane_token_bytes = scalar.constant 8 : i64
  %cohort_input_bytes = scalar.muli %tokens, %two_plane_token_bytes : i64
  %output_bytes = scalar.muli %packet_capacity, %word_bytes : i64
  %allocation_bytes = index.constant 264 : offset
  %allocations = buffer.alloca<private> align(8) %allocation_bytes : buffer
  scf.for %slot = [%c0 to %c11 step %c1] {
    func.call @qwen38.allocation(%allocations, %slot, %c0_i64, %c0_i64) : (buffer, index, i64, i64)
  }
  func.call @qwen38.allocation(%allocations, %c0, %residual_bytes, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%allocations, %c1, %arena_bytes, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%allocations, %c2, %metadata_bytes, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%allocations, %c3, %table_bytes, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%allocations, %c4, %cohort_input_bytes, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%allocations, %c5, %output_bytes, %c0_i64) : (buffer, index, i64, i64)
  %carry_record = scalar.constant 44032 : i64
  %carry_stride = scf.select %enabled, %carry_record, %c0_i64 : i64
  %retained_carry_bytes = scalar.muli %owners, %carry_stride : i64
  %tail_stride = scalar.constant 1024 : i64
  %working_stride = scf.select %enabled, %tail_stride, %c0_i64 : i64
  %working_bytes = scalar.muli %rows, %working_stride : i64
  // Working partial blocks share the backed carry allocation, outside the
  // retained record extent. Restore reconstructs them after resident growth.
  %carry_bytes = scalar.addi %retained_carry_bytes, %working_bytes : i64
  %draft_token_bytes = scalar.constant 2116 : i64
  %draft_cache_bytes = scalar.muli %pool, %draft_token_bytes : i64
  func.call @qwen38.allocation(%allocations, %c6, %carry_bytes, %c0_i64) : (buffer, index, i64, i64)
  scf.if %enabled {
    %descriptor_stride = scalar.constant 24 : i64
    %descriptor_header = scalar.constant 12 : i64
    %descriptor_bytes = scalar.muli %packet_capacity, %descriptor_stride : i64
    %committed_bytes = scalar.addi %descriptor_bytes, %descriptor_header : i64
    %feedback_count = index.cast %feedback_capacity : i64 to index
    %feedback_extent = func.call @qwen38_feedback_bytes(%feedback_count) : (index) -> (offset)
    %result_bytes = index.cast %feedback_extent : offset to i64
    func.call @qwen38.allocation(%allocations, %c7, %committed_bytes, %c0_i64) : (buffer, index, i64, i64)
    func.call @qwen38.allocation(%allocations, %c8, %result_bytes, %c0_i64) : (buffer, index, i64, i64)
    func.call @qwen38.allocation(%allocations, %c9, %draft_cache_bytes, %c0_i64) : (buffer, index, i64, i64)
    func.call @qwen38.allocation(%allocations, %c10, %table_bytes, %c0_i64) : (buffer, index, i64, i64)
  }
  %row_count = index.cast %rows : i64 to index
  %view_stride = index.constant 64 : offset
  %view_bytes = index.scale %row_count, %view_stride : index, offset -> offset
  %views = buffer.alloca<private> align(8) %view_bytes : buffer
  %origin_bytes = index.cast %map_origin : i64 to offset
  %target_origins = buffer.alloca<private> align(8) %origin_bytes : buffer
  %draft_origins = buffer.alloca<private> align(8) %origin_bytes : buffer
  buffer.fill %c0_i32, %target_origins[%origin], %origin_bytes : i32
  buffer.fill %c0_i32, %draft_origins[%origin], %origin_bytes : i32
  %target = buffer.view %target_origins[%origin] : buffer -> view<[%row_count]x5xi64>
  %draft = buffer.view %draft_origins[%origin] : buffer -> view<[%row_count]x5xi64>
  scf.for %i = [%c0 to %row_count step %c1] {
    %row = index.cast %i : index to i64
    %relative = scalar.muli %row, %slot_stride : i64
    %base = scalar.addi %cache_bytes, %relative : i64
    %recurrent_base = scalar.addi %base, %recurrent_origin : i64
    %input_base = scalar.addi %base, %input_origin : i64
    %progress_base = scalar.addi %base, %progress_origin : i64
    func.call @qwen38.row_view(%views, %row_count, %i, %c0, %base, %control_bytes) : (buffer, index, index, index, i64, i64)
    func.call @qwen38.row_view(%views, %row_count, %i, %c1, %input_base, %c0_i64) : (buffer, index, index, index, i64, i64)
    func.call @qwen38.row_view(%views, %row_count, %i, %c2, %input_base, %input_bytes) : (buffer, index, index, index, i64, i64)
    func.call @qwen38.row_view(%views, %row_count, %i, %c3, %progress_base, %progress_bytes) : (buffer, index, index, index, i64, i64)
    view.store %recurrent_base, %target[%i, 0] : i64, view<[%row_count]x5xi64>
    view.store %recurrent_base, %target[%i, 1] : i64, view<[%row_count]x5xi64>
    view.store %c0_i64, %target[%i, 2] : i64, view<[%row_count]x5xi64>
    %tail_relative = scalar.muli %row, %tail_stride : i64
    %tail_base = scalar.addi %retained_carry_bytes, %tail_relative : i64
    view.store %tail_base, %draft[%i, 0] : i64, view<[%row_count]x5xi64>
    view.store %tail_base, %draft[%i, 1] : i64, view<[%row_count]x5xi64>
    view.store %c0_i64, %draft[%i, 2] : i64, view<[%row_count]x5xi64>
    %map_stride = scalar.muli %blocks_per_row, %word_bytes : i64
    %map_relative = scalar.muli %row, %map_stride : i64
    %map_base = scalar.addi %map_origin, %map_relative : i64
    view.store %map_base, %target[%i, 4] : i64, view<[%row_count]x5xi64>
    view.store %map_base, %draft[%i, 4] : i64, view<[%row_count]x5xi64>
  }
  // Geometry header: page tokens, map origin, carry stride, feedback split,
  // recurrent origin, slot stride, slot length, and slot count.
  %target_geometry_bytes = index.constant 144 : offset
  %draft_geometry_bytes = index.constant 264 : offset
  %geometry_bytes = scf.select %enabled, %draft_geometry_bytes, %target_geometry_bytes : offset
  %geometry = buffer.alloca<private> align(8) %geometry_bytes : buffer
  %geometry_view = buffer.view %geometry[%origin] : buffer -> view<8xi64>
  %bank_capacity = index.cast %feedback_capacity : i64 to index
  %bank_extent = func.call @qwen38_feedback_bank_bytes(%bank_capacity) : (index) -> (offset)
  %feedback_split = index.cast %bank_extent : offset to i64
  view.store %block_tokens, %geometry_view[0] : i64, view<8xi64>
  view.store %map_origin, %geometry_view[1] : i64, view<8xi64>
  view.store %carry_stride, %geometry_view[2] : i64, view<8xi64>
  view.store %feedback_split, %geometry_view[3] : i64, view<8xi64>
  %absolute_recurrent_origin = scalar.addi %cache_bytes, %recurrent_origin : i64
  view.store %absolute_recurrent_origin, %geometry_view[4] : i64, view<8xi64>
  view.store %slot_stride, %geometry_view[5] : i64, view<8xi64>
  view.store %recurrent_bytes, %geometry_view[6] : i64, view<8xi64>
  view.store %slot_count, %geometry_view[7] : i64, view<8xi64>
  // Regions: allocation, origin, plane count, plane stride, and page bytes.
  %regions_origin = index.constant 64 : offset
  %regions = buffer.view %geometry[%regions_origin] : buffer -> view<2x5xi64>
  // One plane per attention layer holds paired K/V tiles. Copying a page
  // therefore retains both operands through the shared byte-range contract.
  %main_planes = scalar.constant 12 : i64
  %main_token_bytes = scalar.constant 2048 : i64
  %main_plane_bytes = scalar.muli %pool, %main_token_bytes : i64
  %main_page_bytes = scalar.constant 131072 : i64
  view.store %c1_i64, %regions[0, 0] : i64, view<2x5xi64>
  view.store %c0_i64, %regions[0, 1] : i64, view<2x5xi64>
  view.store %main_planes, %regions[0, 2] : i64, view<2x5xi64>
  view.store %main_plane_bytes, %regions[0, 3] : i64, view<2x5xi64>
  view.store %main_page_bytes, %regions[0, 4] : i64, view<2x5xi64>
  %main_bytes = scalar.muli %main_planes, %main_plane_bytes : i64
  %index_planes = scalar.constant 12 : i64
  %index_token_bytes = scalar.constant 64 : i64
  %index_plane_bytes = scalar.muli %pool, %index_token_bytes : i64
  %index_page_bytes = scalar.constant 4096 : i64
  view.store %c1_i64, %regions[1, 0] : i64, view<2x5xi64>
  view.store %main_bytes, %regions[1, 1] : i64, view<2x5xi64>
  view.store %index_planes, %regions[1, 2] : i64, view<2x5xi64>
  view.store %index_plane_bytes, %regions[1, 3] : i64, view<2x5xi64>
  view.store %index_page_bytes, %regions[1, 4] : i64, view<2x5xi64>
  scf.if %enabled {
    %draft_regions = buffer.view %geometry[%target_geometry_bytes] : buffer -> view<3x5xi64>
    %draft_allocation = scalar.constant 9 : i64
    view.store %draft_allocation, %draft_regions[0, 0] : i64, view<3x5xi64>
    view.store %c0_i64, %draft_regions[0, 1] : i64, view<3x5xi64>
    view.store %c1_i64, %draft_regions[0, 2] : i64, view<3x5xi64>
    view.store %main_plane_bytes, %draft_regions[0, 3] : i64, view<3x5xi64>
    view.store %main_page_bytes, %draft_regions[0, 4] : i64, view<3x5xi64>
    view.store %draft_allocation, %draft_regions[1, 0] : i64, view<3x5xi64>
    view.store %main_plane_bytes, %draft_regions[1, 1] : i64, view<3x5xi64>
    view.store %c1_i64, %draft_regions[1, 2] : i64, view<3x5xi64>
    view.store %index_plane_bytes, %draft_regions[1, 3] : i64, view<3x5xi64>
    view.store %index_page_bytes, %draft_regions[1, 4] : i64, view<3x5xi64>
    // Accepted token IDs follow the same physical pages as draft K/V. Native
    // retention copies this plane with each page during forks and restoration.
    %history_origin = scalar.addi %main_plane_bytes, %index_plane_bytes : i64
    %history_plane_bytes = scalar.muli %pool, %word_bytes : i64
    %history_page_bytes = scalar.constant 256 : i64
    view.store %draft_allocation, %draft_regions[2, 0] : i64, view<3x5xi64>
    view.store %history_origin, %draft_regions[2, 1] : i64, view<3x5xi64>
    view.store %c1_i64, %draft_regions[2, 2] : i64, view<3x5xi64>
    view.store %history_plane_bytes, %draft_regions[2, 3] : i64, view<3x5xi64>
    view.store %history_page_bytes, %draft_regions[2, 4] : i64, view<3x5xi64>
  }
  func.return %allocations, %views, %target_origins, %draft_origins, %geometry : buffer, buffer, buffer, buffer, buffer
}

// The 32-byte embedding state is followed by six immutable handles per input
// layout: target, proposal, catch-up, verifier, continuation, and short target.
func.def @phase_handles_origin(%state: buffer, %mixed: i1) -> (offset) {
  %packet_capacity, %provider = func.call @qwen38.control_context(%state) : (buffer) -> (i64, offset)
  %ordinary = index.constant 32 : offset
  %features = index.constant 56 : offset
  %row = scf.select %mixed, %features, %ordinary : offset
  %origin = index.add %provider, %row : offset
  func.return %origin : offset
}

// Speculative installations use one target recording for known and proposed
// spans. The verifier handle is shared by every text cohort after preparation.
template.decl @qwen38.epoch.feedback_bank(%state: buffer, %requested: i32) -> (i1)

template.def<@qwen38.epoch.feedback_bank> @flash_next_feedback_bank(%state: buffer, %requested: i32) -> (i1) {
  %enabled = func.call readonly @qwen38.control_has_draft(%state) : (buffer) -> (i1)
  template.return %enabled : i1
}

template.decl @qwen38.epoch.stages(%state: buffer, %mixed: i1, %token_count: i32, %span_count: i32) -> (i32, i32, i32, i32, i32)

template.def<@qwen38.epoch.stages> @flash_next_phase_stages(%state: buffer, %mixed: i1, %token_count: i32, %span_count: i32) -> (i32, i32, i32, i32, i32) {
  %origin = func.call @phase_handles_origin(%state, %mixed) : (buffer, i1) -> (offset)
  %stages = buffer.view %state[%origin] : buffer -> view<6xi32>
  %general = view.load %stages[0] : view<6xi32> -> i32
  %short = view.load %stages[5] : view<6xi32> -> i32
  %tile = scalar.constant 16 : i32
  %below_tile = scalar.cmpi ult, %token_count, %tile : i32
  %target = scf.select %below_tile, %short, %general : i32
  %proposal = view.load %stages[1] : view<6xi32> -> i32
  %warm = view.load %stages[2] : view<6xi32> -> i32
  %verifier = view.load %stages[3] : view<6xi32> -> i32
  %continuation = view.load %stages[4] : view<6xi32> -> i32
  template.return %target, %proposal, %warm, %verifier, %continuation : i32, i32, i32, i32, i32
}

// Each stage consumes the live prefix of its packet. Preparation keeps the
// command or direct kernel handle for the lifetime of this layout.
func.def @declare_packed_stages(%state: buffer, %mixed_layout: i1, %tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %draft_source: i32, %enabled: i1, %depth: i64, %proposal_capacity: i64, %packet_capacity: i64) {
  %origin = func.call @phase_handles_origin(%state, %mixed_layout) : (buffer, i1) -> (offset)
  %stages = buffer.view %state[%origin] : buffer -> view<6xi32>
  %mixed = scalar.extui %mixed_layout : i1 to i64
  %c0_i32 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %one_root = scalar.constant 1 : i32
  %two_roots = scalar.constant 2 : i32
  %three_roots = scalar.constant 3 : i32
  scf.if %enabled {
    %anchor = scalar.constant 1 : i64
    %verification = scalar.addi %depth, %anchor : i64
    // The first root owns the primary checkpoint's weight layout.
    %verify_root = buffer.constant utf8("flash_next_verify_stream") : buffer
    %verify = func.call @declare_stage(%verify_root, %tokens, %spans, %context, %pool, %model_source, %draft_source, %c0_i32, %two_roots, %verification, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    %proposal_root = global.load @proposal_root : buffer
    %draft_depth_key = global.load @draft_depth_key : buffer
    %epoch_capacity_key = global.load @epoch_capacity_key : buffer
    // The draft packet publishes its live owners after compaction on each
    // round. One proposal recording can serve every admitted cohort.
    %proposal = func.call @declare_stage(%proposal_root, %proposal_capacity, %proposal_capacity, %context, %pool, %model_source, %draft_source, %one_root, %two_roots, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    %neural_limit = scalar.constant 7 : i64
    %neural_depth = scalar.minui %depth, %neural_limit : i64
    func.call @config_i64(%proposal, %draft_depth_key, %neural_depth) : (i32, buffer, i64)
    func.call @config_i64(%proposal, %epoch_capacity_key, %packet_capacity) : (i32, buffer, i64)
    %warm_root = global.load @warm_root : buffer
    %warm = func.call @declare_stage(%warm_root, %tokens, %spans, %context, %pool, %model_source, %draft_source, %three_roots, %one_root, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    %continue_root = global.load @continue_root : buffer
    %continuation = func.call @dispatch(%continue_root, %c0_i64) : (buffer, i64) -> (i32)
    %mixed_key = global.load @mixed_key : buffer
    func.call @config_i64(%continuation, %mixed_key, %mixed) : (i32, buffer, i64)
    %packet_key = global.load @packet_capacity_key : buffer
    func.call @config_i64(%continuation, %packet_key, %packet_capacity) : (i32, buffer, i64)
    %feedback_key = global.load @feedback_capacity_key : buffer
    func.call @config_i64(%continuation, %feedback_key, %spans) : (i32, buffer, i64)
    %context_key = global.load @context_key : buffer
    func.call @config_i64(%continuation, %context_key, %context) : (i32, buffer, i64)
    func.call @config_i64(%continuation, %epoch_capacity_key, %packet_capacity) : (i32, buffer, i64)
    view.store %proposal, %stages[1] : i32, view<6xi32>
    view.store %warm, %stages[2] : i32, view<6xi32>
    view.store %verify, %stages[3] : i32, view<6xi32>
    view.store %continuation, %stages[4] : i32, view<6xi32>
  } else {
    %root = buffer.constant utf8("flash_next_ple_suffix") : buffer
    %target = func.call @declare_stage(%root, %tokens, %spans, %context, %pool, %model_source, %draft_source, %c0_i32, %one_root, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
    view.store %target, %stages[0] : i32, view<6xi32>
    // Ordinary text below a matrix tile uses the dot-product suffix. Both
    // recordings address the same buffers; the live input bound selects one.
    %short = scf.if %mixed_layout -> (i32) {
      scf.yield %target : i32
    } else {
      %tile = scalar.constant 16 : i64
      %all_short = scalar.cmpi ult, %tokens, %tile : i64
      %dot = scf.if %all_short -> (i32) {
        scf.yield %target : i32
      } else {
        %stage = func.call @declare_stage(%root, %tokens, %spans, %context, %pool, %model_source, %draft_source, %c0_i32, %one_root, %c0_i64, %packet_capacity, %mixed) : (buffer, i64, i64, i64, i64, i32, i32, i32, i32, i64, i64, i64) -> (i32)
        scf.yield %stage : i32
      }
      %key = buffer.constant utf8("flash_next.dot_packet") : buffer
      %c1_i64 = scalar.constant 1 : i64
      func.call @config_i64(%dot, %key, %c1_i64) : (i32, buffer, i64)
      scf.yield %dot : i32
    }
    view.store %short, %stages[5] : i32, view<6xi32>
  }
  func.return
}

// Larger text cohorts spend fewer neural predictions per request. Accepted
// history can still supply the full target window in the same recording.
func.def @configure_cohort_widths(%state: buffer, %depth: i64, %proposal_capacity: i64) {
  %c1_i64 = scalar.constant 1 : i64
  %c2_i64 = scalar.constant 2 : i64
  %ceiling = scalar.addi %depth, %c1_i64 : i64
  %ceiling_word = scalar.trunci %ceiling : i64 to i32
  %capacity_word = scalar.trunci %proposal_capacity : i64 to i32
  func.call @qwen38.speculation_configure(%state, %ceiling_word, %capacity_word) : (buffer, i32, i32)
  %shorten_four = scalar.cmpi ugt, %depth, %c2_i64 : i64
  scf.if %shorten_four {
    %four_owners = index.constant 2 : index
    %anchor_and_two = scalar.constant 3 : i32
    func.call @qwen38.speculation_register_width(%state, %four_owners, %anchor_and_two) : (buffer, index, i32)
  }
  %shorten_eight = scalar.cmpi ugt, %depth, %c1_i64 : i64
  scf.if %shorten_eight {
    %eight_owners = index.constant 3 : index
    %anchor_and_one = scalar.constant 2 : i32
    func.call @qwen38.speculation_register_width(%state, %eight_owners, %anchor_and_one) : (buffer, index, i32)
  }
  func.return
}

func.decl @flash_next_ple_prepare(%tokens: i64, %spans: i64, %context: i64, %pool: i64, %model_source: i32, %packet_capacity: i64, %images: i1, %enabled: i1, %state: buffer)

func.decl pure @flash_next_ple_cache_layout(%tokens: index) -> (offset, offset, offset, offset, offset)

func.def public @text_prepare_v2(%prefill: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %draft_depth: i32, %span_budget: i64, %weights: buffer, %options: buffer) -> (i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer) {
  %packet_capacity = func.call pure @qwen38.padded_tokens(%prefill) : (i64) -> (i64)
  %c0_i64 = scalar.constant 0 : i64
  %c0_i32 = scalar.constant 0 : i32
  %c64 = scalar.constant 64 : i64
  %limit = scalar.constant 32768 : i64
  %has_spans = scalar.cmpi ugt, %span_budget, %c0_i64 : i64
  %has_pool = scalar.cmpi ugt, %pool, %c0_i64 : i64
  %maximum_depth = scalar.constant 15 : i32
  %enabled = scalar.cmpi ne, %draft_depth, %c0_i32 : i32
  %valid_depth = scalar.cmpi ule, %draft_depth, %maximum_depth : i32
  %context_tail = scalar.remui %context, %c64 : i64
  %context_whole = scalar.cmpi eq, %context_tail, %c0_i64 : i64
  %small_enough = scalar.cmpi ule, %packet_capacity, %limit : i64
  %packed = scalar.andi %has_spans, %has_pool : i1
  %shaped = scalar.andi %context_whole, %small_enough : i1
  %ordinary = scalar.andi %packed, %valid_depth : i1
  %valid = scalar.andi %ordinary, %shaped : i1
  %condition = scalar.extui %valid : i1 to i32
  %diagnostic = buffer.constant utf8("Flash-Next requires pooled packed epochs, draft depth 0 through 15, at most 32768 tokens per epoch, and context capacity divisible by 64.") : buffer
  func.call @require(%condition, %diagnostic) : (i32, buffer)
  %model_scope = global.load @model_scope : buffer
  %model_source = func.call @source_scope(%model_scope) : (buffer) -> (i32)
  %draft_source = scf.if %enabled -> (i32) {
    %draft_scope = global.load @draft_scope : buffer
    %source = func.call @source_scope(%draft_scope) : (buffer) -> (i32)
    scf.yield %source : i32
  } else {
    scf.yield %c0_i32 : i32
  }
  %depth = scalar.extui %draft_depth : i32 to i64
  %c1_i64 = scalar.constant 1 : i64
  %verification = scalar.addi %depth, %c1_i64 : i64
  %fitting = scalar.divui %prefill, %verification : i64
  %bounded = scalar.minui %fitting, %span_budget : i64
  %proposal_capacity = scalar.maxui %bounded, %c1_i64 : i64
  %false = scalar.constant false : i1
  %provider_bytes = index.constant 80 : offset
  %state = func.call @qwen38.control_create(%packet_capacity, %span_budget, %context, %pool, %rows, %pins, %packed, %enabled, %false, %provider_bytes) : (i64, i64, i64, i64, i64, i64, i1, i1, i1, offset) -> (buffer)
  func.call @declare_packed_stages(%state, %false, %prefill, %span_budget, %context, %pool, %model_source, %draft_source, %enabled, %depth, %proposal_capacity, %packet_capacity) : (buffer, i1, i64, i64, i64, i64, i32, i32, i1, i64, i64, i64)
  %images = config.get @flash_next.image_inputs : i1
  scf.if %images {
    func.call @declare_packed_stages(%state, %images, %prefill, %span_budget, %context, %pool, %model_source, %draft_source, %enabled, %depth, %proposal_capacity, %packet_capacity) : (buffer, i1, i64, i64, i64, i64, i32, i32, i1, i64, i64, i64)
  }
  scf.if %enabled {
    func.call @configure_cohort_widths(%state, %depth, %proposal_capacity) : (buffer, i64, i64)
  }
  func.call @flash_next_ple_prepare(%prefill, %span_budget, %context, %pool, %model_source, %packet_capacity, %images, %enabled, %state) : (i64, i64, i64, i64, i32, i64, i1, i1, buffer)
  %one_stage = scalar.constant 1 : i32
  %shared = scf.select %enabled, %c0_i32, %one_stage : i32
  %terminal = global.load @terminal : buffer
  %allocations, %views, %target_origins, %draft_origins, %geometry = func.call @qwen38.storage(%packet_capacity, %span_budget, %context, %pool, %rows, %pins, %packed, %enabled, %false) : (i64, i64, i64, i64, i64, i64, i1, i1, i1) -> (buffer, buffer, buffer, buffer, buffer)
  func.return %prefill, %shared, %state, %terminal, %allocations, %views, %target_origins, %draft_origins, %geometry : i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer
}
