// flash_next.pool_capacity
global.rodata.def @pool_key = bytes("666c6173685f6e6578742e706f6f6c5f6361706163697479")

// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")

// <|im_end|>
global.rodata.def @terminal = bytes("3c7c696d5f656e647c3e")

// Flash-Next requires pooled packed epochs, draft depth zero through seven, at most 32768 tokens per epoch, and context capacity divisible by 64.
global.rodata.def @limits_error = bytes("466c6173682d4e65787420726571756972657320706f6f6c6564207061636b65642065706f6368732c206472616674206465707468207a65726f207468726f75676820736576656e2c206174206d6f737420333237363820746f6b656e73207065722065706f63682c20616e6420636f6e7465787420636170616369747920646976697369626c652062792036342e")

