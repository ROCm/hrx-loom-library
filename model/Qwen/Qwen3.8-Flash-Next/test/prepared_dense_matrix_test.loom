// The loader's in-place permutation must preserve dense projections in both
// coefficient modes, including partial matrix tiles and inactive output rows.
kernel.decl @flash_next_prepare_q8_channels(%configured_inputs: index, %configured_outputs: index) launch(%input_width: index, %weight: buffer)

func.decl @ggml_q8_0_fixture(%tokens: index, %count: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer)

kernel.def @prepared_dense_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%count: index, %inputs: index, %outputs: index, %epoch: buffer, %input: buffer, %weight: buffer) {
  %origin = index.constant 0 : offset
  %tokens = index.constant 17 : index
  func.call @ggml_q8_0_fixture(%tokens, %count, %inputs, %outputs, %input, %weight) : (index, index, index, index, buffer, buffer)
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = index.cast %count : index to i32
  view.store %word, %header[0] : i32, view<3xi32>
  kernel.return
}

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

amdgpu.target<gfx11-generic> @prepared_dense_wave32 {subgroup_size = 32}

template.decl @flash_next.q8_tile_stage(%split_scales: i1, %capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %use_stage64: i1, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

// One partial tile isolates the raw/prepared producer contract. The two
// capacities exercise F32 block scaling and the serving F16 K64 pipeline.
kernel.def target(@prepared_dense_wave32) @prepared_dense_tile() {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%split_scales: i1, %inputs: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %outputs = index.constant 68 : index
  %tile = index.constant 128 : index
  %wave_rows = index.constant 4 : index
  %wave_columns = index.constant 2 : index
  %depth = index.constant 2 : index
  %threshold = index.constant 4096 : index
  %stage64 = index.cmp uge, %capacity, %threshold : index
  template.apply<@flash_next.q8_tile_stage>(%split_scales, %capacity, %inputs, %outputs, %tile, %tile, %wave_rows, %wave_columns, %depth, %stage64, %epoch, %input, %weight, %output) : (i1, index, index, index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer)
  kernel.return
}

check.case public @prepared_dense_matrix {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %inputs = check.param.choice values([2560, 6144]) name("width") : index
  %count = check.param.choice values([0, 1, 17]) name("active") : index
  %outputs = check.literal value(68) : index
  %seed = check.literal value(7151) : i64
  %epoch = check.generate.fill value(0) : tensor<3xi32>
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<4096x6144xbf16>
  %weight = check.generate.random.uniform seed(%seed) range(-127 to 127) : tensor<68x192x34xi8>
  kernel.launch @prepared_dense_fixture(%count, %inputs, %outputs, %epoch, %input, %weight) : (index, index, index, tensor<3xi32>, tensor<4096x6144xbf16>, tensor<68x192x34xi8>)
  %expected = check.generate.fill value(-17.0) : tensor<4096x68xbf16>
  %output = check.generate.fill value(-17.0) : tensor<4096x68xbf16>
  %raw = check.literal value(false) : i1
  %packed = check.literal value(true) : i1
  kernel.launch @prepared_dense_tile(%raw, %inputs, %epoch, %input, %weight, %expected) : (i1, index, tensor<3xi32>, tensor<4096x6144xbf16>, tensor<68x192x34xi8>, tensor<4096x68xbf16>)
  kernel.launch @flash_next_prepare_q8_channels[%inputs, %outputs](%inputs, %weight) : [index, index](index, tensor<68x192x34xi8>)
  kernel.launch @prepared_dense_tile(%packed, %inputs, %epoch, %input, %weight, %output) : (i1, index, tensor<3xi32>, tensor<4096x6144xbf16>, tensor<68x192x34xi8>, tensor<4096x68xbf16>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<4096x68xbf16>
  check.return
}
