// Model epoch and configured-capacity adapters for the shared Q8_0 oracle.
// Numerical decoding and fixtures belong to the GGML linear test package.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

func.decl @ggml_q8_0_fixture(%tokens: index, %count: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer)

func.decl @ggml_q8_0_reference_dot(%half_coefficients: i1, %tokens: index, %inputs: index, %token: index, %row: index, %input: buffer, %weight: buffer) -> (f64)

func.decl @ggml_q8_0_reference(%half_coefficients: i1, %tokens: index, %count: index, %streams: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.def public @flash_next_q8_fixture(%count: index, %inputs: index, %outputs: index, %epoch: buffer, %input: buffer, %weight: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %count_word = index.cast %count : index to i32
  view.store %count_word, %header[0] : i32, view<3xi32>
  func.call @ggml_q8_0_fixture(%tokens, %count, %inputs, %outputs, %input, %weight) : (index, index, index, index, buffer, buffer)
  func.return
}

func.def public inline @flash_next_q8_reference_dot_arithmetic(%half_coefficients: i1, %inputs: index, %token: index, %row: index, %input: buffer, %weight: buffer) -> (f64) {
  %tokens = config.get @flash_next.token_count : index
  %result = func.call @ggml_q8_0_reference_dot(%half_coefficients, %tokens, %inputs, %token, %row, %input, %weight) : (i1, index, index, index, index, buffer, buffer) -> (f64)
  func.return %result : f64
}

func.def public inline @flash_next_q8_reference_dot(%inputs: index, %token: index, %row: index, %input: buffer, %weight: buffer) -> (f64) {
  %half_coefficients = scalar.constant false : i1
  %result = func.call @flash_next_q8_reference_dot_arithmetic(%half_coefficients, %inputs, %token, %row, %input, %weight) : (i1, index, index, index, buffer, buffer) -> (f64)
  func.return %result : f64
}

func.def public @flash_next_q8_reference(%inputs: index, %outputs: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %count_word = view.load %header[0] : view<3xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, %tokens)] : index
  %streams = index.constant 1 : index
  %half_coefficients = scalar.constant false : i1
  func.call @ggml_q8_0_reference(%half_coefficients, %tokens, %count, %streams, %inputs, %outputs, %input, %weight, %output) : (i1, index, index, index, index, index, buffer, buffer, buffer)
  func.return
}
