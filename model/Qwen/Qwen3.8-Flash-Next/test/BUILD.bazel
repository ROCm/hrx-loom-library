package(default_visibility = ["//visibility:private"])

filegroup(
    name = "q8_reference",
    testonly = True,
    srcs = [
        "q8_reference.loom",
        "//kernel/ggml/linear/test:q8_reference",
    ],
)

loom_test(
    name = "storage",
    srcs = [
        "//model/Qwen/Qwen3.8-Flash-Next/program:prepare.loom",
        "//program/text/qwen3_8/test:storage_test.loom",
    ],
    configs = {"storage_test.dflash": "false"},
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = [
        "//motif/sequence/qwen3_8:packet",
        "//program/text/qwen3_8:storage",
    ],
)

_MODEL_TARGETS = [
    representation + suffix
    for representation in [
        "source",
        "archive",
    ]
    for suffix in [
        "",
        "_mtp",
        "_mtp_continuation",
        "_long_context",
        "_long_context_mtp",
    ]
]

_VISION_MODEL_TARGETS = [
    representation + suffix
    for representation in [
        "source",
        "archive",
    ]
    for suffix in [
        "_vision",
        "_vision_mtp",
    ]
]

AMD_GPU_ACCESS_PROFILE = amd_gpu_execution_profile(
    name = "amd_gpu_access",
    runner_args = ["--sanitizer=access"],
    tags = ["notsan"],
)

[
    filegroup(
        name = representation + "_card",
        srcs = ["//model/Qwen/Qwen3.8-Flash-Next:" + representation],
        output_group = "model_card",
    )
    for representation in _MODEL_TARGETS + _VISION_MODEL_TARGETS
]

_SERVICE_REQUIREMENTS = apply_test_requirements(
    {},
    build_requirements = AMD_GPU_HARDWARE_PROFILE.build_requirements,
    resource_group = AMD_GPU_HARDWARE_PROFILE.resource_group,
    run_requirements = AMD_GPU_HARDWARE_PROFILE.run_requirements,
)

# Full checkpoints stay provisioned outside Bazel. The card, acquisition lock,
# and current providers carry the regression's trusted content identity.
[
    iree_py_test(
        name = "serve_" + representation + ("_native_test" if scenario == "native-context" else "_test"),
        size = "large",
        srcs = [
            "context_check.py",
            "serve_check.py",
            "vision_check.py",
        ],
        args = [
            "--server=$(location @loom_sdk//:loom-serve)",
            "--model=$(location :" + representation + "_card)",
            "--reference=$(location reference.json)",
            "--device=amdgpu://0",
        ] + (["--" + scenario] if scenario != "text" else []),
        data = [
            ":" + representation + "_card",
            "reference.json",
            "@loom_sdk//:loom-serve",
        ],
        main = "serve_check.py",
        resource_group = _SERVICE_REQUIREMENTS["resource_group"],
        tags = ["manual"] + _SERVICE_REQUIREMENTS["tags"],
        target_compatible_with = _SERVICE_REQUIREMENTS["target_compatible_with"],
        deps = [
            "@hrx//loom/src/loom/serve/testing:chat",
            "@hrx//loom/src/loom/serve/testing:http",
            "@hrx//loom/src/loom/serve/testing:model_staging",
        ],
    )
    for representation, scenario in [(name, "text") for name in _MODEL_TARGETS] + [(name, "vision") for name in _VISION_MODEL_TARGETS] + [
        ("source_long_context", "native-context"),
        ("archive_long_context_mtp", "native-context"),
    ]
]

