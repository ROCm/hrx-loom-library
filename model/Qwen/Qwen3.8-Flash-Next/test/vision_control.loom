// Forecast the original BF16 projector through its actual model callback.
// Two codec descriptors begin at nonzero, differently padded byte offsets.
// Their selected geometries are 320x256 (80 features) and 1024x1024 (1024).
// Native header words are version, count, source width/height, oriented
// width/height, orientation, feature count, metadata offset/bytes, pixel
// offset/bytes, channels, and three reserved words; two metadata words carry
// the selected width/height. Unused inter-record bytes remain 0xa5.

func.decl @qwen38_vision_forecast_memory(%state: buffer, %ranges: buffer, %descriptors: buffer) -> (i64, i64, i64)

global.rodata.def @image_descriptors = align(16) bytes("")

func.def @forecast_original_projector() -> (i64, i64, i64) {
  %origin = index.constant 0 : offset
  %range_bytes = index.constant 32 : offset
  %state_bytes = index.constant 1 : offset
  %state = buffer.alloca<private> align(1) %state_bytes : buffer
  %ranges = buffer.alloca<private> align(8) %range_bytes : buffer
  %records = buffer.view %ranges[%origin] : buffer -> view<2x2xi64>
  %first = scalar.constant 16 : i64
  %second = scalar.constant 144 : i64
  %descriptor_bytes = scalar.constant 72 : i64
  view.store %first, %records[0, 0] : i64, view<2x2xi64>
  view.store %descriptor_bytes, %records[0, 1] : i64, view<2x2xi64>
  view.store %second, %records[1, 0] : i64, view<2x2xi64>
  view.store %descriptor_bytes, %records[1, 1] : i64, view<2x2xi64>
  %descriptors = global.load @image_descriptors : buffer
  %private, %retained, %expanded = func.call @qwen38_vision_forecast_memory(%state, %ranges, %descriptors) : (buffer, buffer, buffer) -> (i64, i64, i64)
  func.return %private, %retained, %expanded : i64, i64, i64
}

check.case public @original_projector_admission {
  %private, %retained, %expanded = func.call @forecast_original_projector() : () -> (i64, i64, i64)
  // One 1-GiB parameter allowance, the native upload cap, and the largest
  // image's 73,039,872-byte workspace, including its second residual bank.
  %expected_private = check.literal value(1416528448) : i64
  // 1104 * 2560 * sizeof(F32), with up to four retained cohort peers.
  %expected_retained = check.literal value(45219840) : i64
  %expected_expanded = check.literal value(11304960) : i64
  check.expect.equal actual(%private) expected(%expected_private) : i64
  check.expect.equal actual(%retained) expected(%expected_retained) : i64
  check.expect.equal actual(%expanded) expected(%expected_expanded) : i64
  check.return
}

check.benchmark<@original_projector_admission> @image_descriptor_admission
