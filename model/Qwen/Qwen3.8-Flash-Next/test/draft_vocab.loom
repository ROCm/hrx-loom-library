template.decl @flash_next.draft_update(%position: index, %begin: index, %length: index, %owner: index, %ids: buffer, %carry: buffer)

kernel.decl @flash_next_draft_plan() launch(%epoch: buffer, %ids: buffer, %carry: buffer, %plan: buffer)

kernel.decl @flash_next_draft_sample() launch(%epoch: buffer, %plan: buffer, %carry: buffer, %logits: buffer, %output: buffer)

// Exercise the same publisher used after accepted-prefix catch-up. The
// retained representation must be invariant to accepted-input chunking.
kernel.def @learn() {
  %c1_index = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%c1_index, %c1_index, %c1_index) workgroup_size(%threads, %c1_index, %c1_index) : index
} launch(%position: index, %length: index, %owner: index, %ids: buffer, %carry: buffer) {
  template.apply<@flash_next.draft_update>(%position, %position, %length, %owner, %ids, %carry) : (index, index, index, index, buffer, buffer)
  kernel.return
}

// The history contains every control ID, fills the rare table exactly, then
// revisits learned IDs and an unlearned overflow ID twice. Controls and known
// IDs cannot consume slots or extend the miss window.
kernel.def @history_fixture() {
  %c1_index = index.constant 1 : index
  kernel.launch.config workgroups(%c1_index, %c1_index, %c1_index) workgroup_size(%c1_index, %c1_index, %c1_index) : index
} launch(%ids: buffer, %expected_header: buffer, %expected_plan: buffer) {
  %origin = index.constant 0 : offset
  %tokens = buffer.view %ids[%origin] : buffer -> view<2048xi32>
  %header = buffer.view %expected_header[%origin] : buffer -> view<3xi32>
  %plan = buffer.view %expected_plan[%origin] : buffer -> view<2560xi32>
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %controls = index.constant 33 : index
  %end = index.constant 1024 : index
  %control_base = scalar.constant 248044 : i32
  %rare_base = scalar.constant 100000 : i32
  scf.for %i = [%c0_index to %controls step %c1_index] {
    %word = index.cast %i : index to i32
    %id = scalar.addi %word, %control_base : i32
    view.store %id, %tokens[%i] : i32, view<2048xi32>
  }
  scf.for %i = [%controls to %end step %c1_index] {
    %relative = index.sub %i, %controls : index
    %word = index.cast %relative : index to i32
    %id = scalar.addi %word, %rare_base : i32
    view.store %id, %tokens[%i] : i32, view<2048xi32>
  }
  %overflow = scalar.constant 110000 : i32
  view.store %rare_base, %tokens[1025] : i32, view<2048xi32>
  view.store %overflow, %tokens[1026] : i32, view<2048xi32>
  view.store %overflow, %tokens[1027] : i32, view<2048xi32>
  %count = scalar.constant 991 : i32
  %latest = scalar.constant 1028 : i32
  %prior = scalar.constant 1027 : i32
  view.store %count, %header[0] : i32, view<3xi32>
  view.store %latest, %header[1] : i32, view<3xi32>
  view.store %prior, %header[2] : i32, view<3xi32>
  %c1_i32 = scalar.constant 1 : i32
  %c0_i32 = scalar.constant 0 : i32
  // Three compact rows: recent second miss, quiet known anchor, quiet unknown
  // anchor. Their shared cohort requires the union (full) head.
  %cohorts = index.constant 512 : index
  scf.for %cohort = [%c0_index to %cohorts step %c1_index] {
    view.store %c0_i32, %plan[%cohort] : i32, view<2560xi32>
  }
  view.store %c1_i32, %plan[0] : i32, view<2560xi32>
  view.store %c1_i32, %plan[512] : i32, view<2560xi32>
  view.store %c0_i32, %plan[513] : i32, view<2560xi32>
  view.store %c1_i32, %plan[514] : i32, view<2560xi32>
  kernel.return
}

kernel.def @observe_history() {
  %c1_index = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%c1_index, %c1_index, %c1_index) workgroup_size(%threads, %c1_index, %c1_index) : index
} launch(%carry: buffer, %header: buffer, %table: buffer, %membership: buffer) {
  %origin = index.constant 0 : offset
  %record = index.constant 21248 : offset
  %bitmap_origin = index.constant 21264 : offset
  %table_origin = index.constant 39984 : offset
  %source_header = buffer.view %carry[%record] : buffer -> view<3xi32>
  %source_bitmap = buffer.view %carry[%bitmap_origin] : buffer -> view<4680xi32>
  %source_table = buffer.view %carry[%table_origin] : buffer -> view<991xi32>
  %headers = buffer.view %header[%origin] : buffer -> view<3xi32>
  %tables = buffer.view %table[%origin] : buffer -> view<991xi32>
  %members = buffer.view %membership[%origin] : buffer -> view<149740xi32>
  %thread = kernel.workitem.id<x> : index
  %stride = index.constant 128 : index
  %c3_index = index.constant 3 : index
  %entries = index.constant 991 : index
  %rare_domain = index.constant 149740 : index
  %bits = index.constant 32 : index
  %c1_i32 = scalar.constant 1 : i32
  %header_live = index.cmp ult, %thread, %c3_index : index
  scf.if %header_live {
    %value = view.load %source_header[%thread] : view<3xi32> -> i32
    view.store %value, %headers[%thread] : i32, view<3xi32>
  }
  scf.for %i = [%thread to %entries step %stride] {
    %value = view.load %source_table[%i] : view<991xi32> -> i32
    view.store %value, %tables[%i] : i32, view<991xi32>
  }
  scf.for %i = [%thread to %rare_domain step %stride] {
    %word = index.div %i, %bits : index
    %bit = index.rem %i, %bits : index
    %shift = index.cast %bit : index to i32
    %packed = view.load %source_bitmap[%word] : view<4680xi32> -> i32
    %shifted = scalar.shrui %packed, %shift : i32
    %member = scalar.andi %shifted, %c1_i32 : i32
    view.store %member, %members[%i] : i32, view<149740xi32>
  }
  kernel.return
}

// An interval oracle checks every membership bit, including the partial final
// bitmap word. It does not reconstruct the publisher's bitmap algorithm.
kernel.def @expected_membership() {
  %c1_index = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%c1_index, %c1_index, %c1_index) workgroup_size(%threads, %c1_index, %c1_index) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %members = buffer.view %output[%origin] : buffer -> view<149740xi32>
  %thread = kernel.workitem.id<x> : index
  %stride = index.constant 128 : index
  %domain = index.constant 149740 : index
  %first = index.constant 1696 : index
  %end = index.constant 2687 : index
  scf.for %i = [%thread to %domain step %stride] {
    %after = index.cmp uge, %i, %first : index
    %before = index.cmp ult, %i, %end : index
    %present = scalar.andi %after, %before : i1
    %word = scalar.extui %present : i1 to i32
    view.store %word, %members[%i] : i32, view<149740xi32>
  }
  kernel.return
}

kernel.def @plan_fixture() {
  %c1_index = index.constant 1 : index
  kernel.launch.config workgroups(%c1_index, %c1_index, %c1_index) workgroup_size(%c1_index, %c1_index, %c1_index) : index
} launch(%epoch: buffer, %ids: buffer, %source: buffer, %carry: buffer) {
  %origin = index.constant 0 : offset
  %records = index.constant 12 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%records] : buffer -> view<16x6xi32>
  %tokens = buffer.view %ids[%origin] : buffer -> view<2048xi32>
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c3_index = index.constant 3 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c3_i32 = scalar.constant 3 : i32
  %quiet = scalar.constant 1059 : i32
  %recent = scalar.constant 1058 : i32
  %known = scalar.constant 100000 : i32
  %unknown = scalar.constant 110000 : i32
  view.store %c3_i32, %header[0] : i32, view<3xi32>
  view.store %c3_i32, %header[1] : i32, view<3xi32>
  view.store %c3_i32, %header[2] : i32, view<3xi32>
  scf.for %row = [%c0_index to %c3_index step %c1_index] {
    %word = index.cast %row : index to i32
    view.store %c1_i32, %spans[%row, 0] : i32, view<16x6xi32>
    view.store %quiet, %spans[%row, 1] : i32, view<16x6xi32>
    view.store %word, %spans[%row, 2] : i32, view<16x6xi32>
    view.store %c0_i32, %spans[%row, 3] : i32, view<16x6xi32>
    view.store %c0_i32, %spans[%row, 4] : i32, view<16x6xi32>
    view.store %known, %tokens[%row] : i32, view<2048xi32>
  }
  view.store %recent, %spans[0, 1] : i32, view<16x6xi32>
  view.store %unknown, %tokens[2] : i32, view<2048xi32>
  %c7_i32 = scalar.constant 7 : i32
  %c2_i32 = scalar.constant 2 : i32
  view.store %c7_i32, %spans[1, 3] : i32, view<16x6xi32>
  view.store %c2_i32, %spans[2, 3] : i32, view<16x6xi32>
  // Distinct resident owners hold snapshots of the same accepted history.
  %input = buffer.view %source[%origin] : buffer -> view<16x11008xi32>
  %state = buffer.view %carry[%origin] : buffer -> view<16x11008xi32>
  %words = index.constant 11008 : index
  scf.for %word = [%c0_index to %words step %c1_index] {
    %value = view.load %input[0, %word] : view<16x11008xi32> -> i32
    view.store %value, %state[0, %word] : i32, view<16x11008xi32>
    view.store %value, %state[7, %word] : i32, view<16x11008xi32>
    view.store %value, %state[2, %word] : i32, view<16x11008xi32>
  }
  kernel.return
}

check.case public @retained_membership_and_fallback {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %ids = check.generate.fill value(7) : tensor<2048xi32>
  %whole = check.generate.fill value(-7) : tensor<16x11008xi32>
  %chunks = check.generate.fill value(-7) : tensor<16x11008xi32>
  %expected_header = check.generate.fill value(-7) : tensor<3xi32>
  %header = check.generate.fill value(-7) : tensor<3xi32>
  %expected_table = check.generate.iota offset(100000) step(1) : tensor<991xi32>
  %table = check.generate.fill value(-7) : tensor<991xi32>
  %membership = check.generate.fill value(-7) : tensor<149740xi32>
  %expected_members = check.generate.fill value(-7) : tensor<149740xi32>
  %epoch = check.generate.fill value(-7) : tensor<99xi32>
  %plan_carry = check.generate.fill value(-7) : tensor<16x11008xi32>
  %plan = check.generate.fill value(-7) : tensor<2560xi32>
  %expected_plan = check.generate.fill value(-7) : tensor<2560xi32>
  kernel.launch @history_fixture(%ids, %expected_header, %expected_plan) : (tensor<2048xi32>, tensor<3xi32>, tensor<2560xi32>)
  %zero = check.literal value(0) : index
  %controls = check.literal value(33) : index
  %partial = check.literal value(511) : index
  %middle = check.literal value(544) : index
  %rest = check.literal value(515) : index
  %total = check.literal value(1059) : index
  kernel.launch @learn(%zero, %total, %zero, %ids, %whole) : (index, index, index, tensor<2048xi32>, tensor<16x11008xi32>)
  kernel.launch @learn(%zero, %controls, %zero, %ids, %chunks) : (index, index, index, tensor<2048xi32>, tensor<16x11008xi32>)
  kernel.launch @learn(%controls, %partial, %zero, %ids, %chunks) : (index, index, index, tensor<2048xi32>, tensor<16x11008xi32>)
  kernel.launch @learn(%middle, %rest, %zero, %ids, %chunks) : (index, index, index, tensor<2048xi32>, tensor<16x11008xi32>)
  check.expect.bitwise actual(%whole) expected(%chunks) : tensor<16x11008xi32>
  kernel.launch @observe_history(%whole, %header, %table, %membership) : (tensor<16x11008xi32>, tensor<3xi32>, tensor<991xi32>, tensor<149740xi32>)
  kernel.launch @expected_membership(%expected_members) : (tensor<149740xi32>)
  check.expect.bitwise actual(%header) expected(%expected_header) : tensor<3xi32>
  check.expect.bitwise actual(%table) expected(%expected_table) : tensor<991xi32>
  check.expect.bitwise actual(%membership) expected(%expected_members) : tensor<149740xi32>
  kernel.launch @plan_fixture(%epoch, %ids, %whole, %plan_carry) : (tensor<99xi32>, tensor<2048xi32>, tensor<16x11008xi32>, tensor<16x11008xi32>)
  kernel.launch @flash_next_draft_plan(%epoch, %ids, %plan_carry, %plan) : (tensor<99xi32>, tensor<2048xi32>, tensor<16x11008xi32>, tensor<2560xi32>)
  check.expect.bitwise actual(%plan) expected(%expected_plan) : tensor<2560xi32>
  check.return
}

check.benchmark<@retained_membership_and_fallback> @retained_membership_and_fallback_benchmark
