// Residual publication across repeated worker rows and a partial final row.
// Independent scalar F64 arithmetic uses dyadic inputs whose products and sums
// are exact in F32, allowing bitwise BF16 checks without reproducing the vector
// implementation. Distinct prime periods expose incorrect worker-row strides.

kernel.decl @hc_combine(%enabled: i1) launch(%epoch: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer)

kernel.def @residual_epoch() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%count: index, %epoch: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = index.cast %count : index to i32
  view.store %word, %header[0] : i32, view<3xi32>
  kernel.return
}

kernel.def @residual_reference() {
  %workers = index.constant 128 : index
  %threads = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workers, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = view.load %header[0] : view<3xi32> -> i32
  %count_value = index.cast %word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 513)] : index
  %streams = index.constant 4 : index
  %width = index.constant 2560 : index
  %row_width = index.mul %streams, %width : index
  %end = index.mul %count, %row_width : index
  %worker = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 64 : index
  %first = index.madd %worker, %threads, %thread : index
  %stride = index.constant 8192 : index
  %residuals = buffer.view %residual[%origin] : buffer -> view<514x4x2560xbf16>
  %projections = buffer.view %projected[%origin] : buffer -> view<514x2560xbf16>
  %gates = buffer.view %injection[%origin] : buffer -> view<514x4xf32>
  %values = buffer.view %output[%origin] : buffer -> view<514x4x2560xbf16>
  scf.for %element = [%first to %end step %stride] {
    %row = index.div %element, %row_width : index
    %within = index.rem %element, %row_width : index
    %stream = index.div %within, %width : index
    %feature = index.rem %within, %width : index
    %stored = view.load %residuals[%row, %stream, %feature] : view<514x4x2560xbf16> -> bf16
    %projected_value = view.load %projections[%row, %feature] : view<514x2560xbf16> -> bf16
    %gate_value = view.load %gates[%row, %stream] : view<514x4xf32> -> f32
    %initial = scalar.extf %stored : bf16 to f64
    %projection = scalar.extf %projected_value : bf16 to f64
    %gate = scalar.extf %gate_value : f32 to f64
    %scaled = scalar.mulf %projection, %gate : f64
    %sum = scalar.addf %initial, %scaled : f64
    %packed = scalar.fptrunc %sum : f64 to bf16
    view.store %packed, %values[%row, %stream, %feature] : bf16, view<514x4x2560xbf16>
  }
  kernel.return
}

check.case public @residual_worker_rows {
  %count = check.param.choice values([0, 1, 257, 513]) name("active") : index
  %enabled = check.literal value(true) : i1
  %epoch = check.generate.fill value(0) : tensor<3xi32>
  kernel.launch @residual_epoch(%count, %epoch) : (index, tensor<3xi32>)
  %residual = check.generate.iota offset(-0.25) step(0.0078125) period(67) : tensor<514x4x2560xbf16>
  %projected = check.generate.iota offset(-0.5) step(0.015625) period(53) : tensor<514x2560xbf16>
  %injection = check.generate.iota offset(-0.75) step(0.25) period(7) : tensor<514x4xf32>
  %output = check.generate.fill value(-17.0) : tensor<514x4x2560xbf16>
  %expected = check.generate.fill value(-17.0) : tensor<514x4x2560xbf16>
  kernel.launch @residual_reference(%epoch, %residual, %projected, %injection, %expected) : (tensor<3xi32>, tensor<514x4x2560xbf16>, tensor<514x2560xbf16>, tensor<514x4xf32>, tensor<514x4x2560xbf16>)
  kernel.launch @hc_combine[%enabled](%epoch, %residual, %projected, %injection, %output) : [i1](tensor<3xi32>, tensor<514x4x2560xbf16>, tensor<514x2560xbf16>, tensor<514x4xf32>, tensor<514x4x2560xbf16>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<514x4x2560xbf16>
  check.return
}

check.benchmark<@residual_worker_rows> @residual_rows
