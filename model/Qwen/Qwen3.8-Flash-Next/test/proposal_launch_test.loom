// Proposal commands forward sampled live counts through the real Q8
// projection template. Empty rounds and inactive tails preserve storage, and a
// later write cannot change the sample. Unit weights and inputs sum to 32.

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

template.decl @flash_next.project_dense_q8(%workload_count: index, %inputs: index, %outputs: index, %blocks: index, %span: buffer, %input: buffer, %weight: view<[%outputs]x[%blocks]x34xi8>, %output: buffer)

kernel.def @publish_count() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%value: i32, %control: buffer) {
  %origin = index.constant 0 : offset
  %counts = buffer.view %control[%origin] : buffer -> view<1xi32>
  view.store %value, %counts[0] : i32, view<1xi32>
  kernel.return
}

kernel.def @publish_input_count() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%epoch: buffer, %control: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %counts = buffer.view %control[%origin] : buffer -> view<1xi32>
  %value = view.load %header[0] : view<3xi32> -> i32
  view.store %value, %counts[0] : i32, view<1xi32>
  kernel.return
}

command.def @project(%count: index, %inputs: index, %outputs: index, %blocks: index, %weight: view<[%outputs]x[%blocks]x34xi8>) launch(%epoch: buffer, %input: buffer, %output: buffer) {
  template.apply<@flash_next.project_dense_q8>(%count, %inputs, %outputs, %blocks, %epoch, %input, %weight, %output) : (index, index, index, index, buffer, buffer, view<[%outputs]x[%blocks]x34xi8>, buffer)
  command.return
}

command.def @proposal_rounds() launch(%epoch: buffer, %input: buffer, %weight: buffer, %skipped_first: buffer, %active_first: buffer, %skipped_later: buffer, %active_later: buffer, %ordinary: buffer) {
  %bytes = index.constant 4 : offset
  %control = buffer.alloca<global> align(16) %bytes : buffer
  %origin = index.constant 0 : offset
  %inputs = index.constant 32 : index
  %outputs = index.constant 1024 : index
  %blocks = index.constant 1 : index
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%blocks]x34xi8>
  %counts = buffer.view %control[%origin] : buffer -> view<1xi32>
  %c0 = scalar.constant 0 : i32
  %capacity = config.get @flash_next.token_count : index
  %full = index.cast %capacity : index to i32
  kernel.launch @publish_count(%c0, %control) : (i32, buffer)
  %first_count = view.load %counts[0] : view<1xi32> -> i32
  %first_workload = index.cast %first_count : i32 to index
  kernel.launch @publish_count(%full, %control) : (i32, buffer)
  command.launch @project[%first_workload, %inputs, %outputs, %blocks, %weights](%epoch, %input, %skipped_first) : [index, index, index, index, view<[%outputs]x[%blocks]x34xi8>](buffer, buffer, buffer)
  kernel.launch @publish_input_count(%epoch, %control) : (buffer, buffer)
  %active_count = view.load %counts[0] : view<1xi32> -> i32
  %active_workload = index.cast %active_count : i32 to index
  kernel.launch @publish_count(%full, %control) : (i32, buffer)
  command.launch @project[%active_workload, %inputs, %outputs, %blocks, %weights](%epoch, %input, %active_first) : [index, index, index, index, view<[%outputs]x[%blocks]x34xi8>](buffer, buffer, buffer)
  kernel.launch @publish_count(%c0, %control) : (i32, buffer)
  %skipped_count = view.load %counts[0] : view<1xi32> -> i32
  %skipped_workload = index.cast %skipped_count : i32 to index
  command.launch @project[%skipped_workload, %inputs, %outputs, %blocks, %weights](%epoch, %input, %skipped_later) : [index, index, index, index, view<[%outputs]x[%blocks]x34xi8>](buffer, buffer, buffer)
  kernel.launch @publish_count(%full, %control) : (i32, buffer)
  kernel.launch @publish_count(%full, %epoch) : (i32, buffer)
  %later_count = view.load %counts[0] : view<1xi32> -> i32
  %later_workload = index.cast %later_count : i32 to index
  command.launch @project[%later_workload, %inputs, %outputs, %blocks, %weights](%epoch, %input, %active_later) : [index, index, index, index, view<[%outputs]x[%blocks]x34xi8>](buffer, buffer, buffer)
  command.launch @project[%capacity, %inputs, %outputs, %blocks, %weights](%epoch, %input, %ordinary) : [index, index, index, index, view<[%outputs]x[%blocks]x34xi8>](buffer, buffer, buffer)
  command.return
}

func.def @fixture(%trial: index, %epoch: buffer, %weight: buffer) -> (index) {
  %capacity = config.get @flash_next.token_count : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %live = func.call @live_prefix(%trial, %capacity) : (index, index) -> (index)
  %count = index.cast %live : index to i32
  view.store %count, %header[0] : i32, view<3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %rows = index.constant 1024 : index
  %block_bytes = index.constant 34 : offset
  %scale = scalar.constant 1.0 : f16
  scf.for %row = [%c0 to %rows step %c1] {
    %offset = index.scale %row, %block_bytes : index, offset -> offset
    %header = buffer.view %weight[%offset] : buffer -> view<1xf16>
    view.store %scale, %header[0] : f16, view<1xf16>
  }
  func.return %capacity : index
}

func.def @expected(%epoch: buffer, %input: buffer, %weight: buffer, %skipped_first: buffer, %active_first: buffer, %skipped_later: buffer, %active_later: buffer, %ordinary: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = view.load %header[0] : view<3xi32> -> i32
  %live = index.cast %word : i32 to index
  %first = buffer.view %active_first[%origin] : buffer -> view<[%capacity]x1024xbf16>
  %later = buffer.view %active_later[%origin] : buffer -> view<[%capacity]x1024xbf16>
  %plain = buffer.view %ordinary[%origin] : buffer -> view<[%capacity]x1024xbf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %columns = index.constant 1024 : index
  %result = scalar.constant 32.0 : bf16
  scf.for %row = [%c0 to %capacity step %c1] {
    scf.for %column = [%c0 to %columns step %c1] {
      %active = index.cmp ult, %row, %live : index
      scf.if %active {
        view.store %result, %first[%row, %column] : bf16, view<[%capacity]x1024xbf16>
      }
      view.store %result, %later[%row, %column] : bf16, view<[%capacity]x1024xbf16>
      view.store %result, %plain[%row, %column] : bf16, view<[%capacity]x1024xbf16>
    }
  }
  func.return
}

func.def @live_prefix(%trial: index, %capacity: index) -> (index) {
  %counts = vector.constanti [0, 1, 4, 15, 16, 64] : vector<6xi32>
  %bounded = index.assume %trial [range(%trial, 0, 5)] : index
  %word = vector.extract %counts[%bounded] : vector<6xi32> -> i32
  %value = index.cast %word : i32 to index
  %live = index.min %value, %capacity : index
  func.return %live : index
}

check.scenario public @proposal_predicates {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<3xi32>
    %weight = check.generate.fill value(1) : tensor<1024x1x34xi8>
    %capacity = check.generate<@fixture>(%trial, %epoch, %weight) : (index, tensor<3xi32>, tensor<1024x1x34xi8>) -> (index)
    %input = check.generate.fill value(1.0) : tensor<[%capacity]x32xbf16>
    %skipped_first = check.generate.fill value(7.0) : tensor<[%capacity]x1024xbf16>
    %active_first = check.generate.fill value(7.0) : tensor<[%capacity]x1024xbf16>
    %skipped_later = check.generate.fill value(7.0) : tensor<[%capacity]x1024xbf16>
    %active_later = check.generate.fill value(7.0) : tensor<[%capacity]x1024xbf16>
    %ordinary = check.generate.fill value(7.0) : tensor<[%capacity]x1024xbf16>
    check.compare<@proposal_rounds, @expected>(%epoch, %input, %weight, %skipped_first, %active_first, %skipped_later, %active_later, %ordinary) : (tensor<3xi32>, tensor<[%capacity]x32xbf16>, tensor<1024x1x34xi8>, tensor<[%capacity]x1024xbf16>, tensor<[%capacity]x1024xbf16>, tensor<[%capacity]x1024xbf16>, tensor<[%capacity]x1024xbf16>, tensor<[%capacity]x1024xbf16>) -> () {
      check.expect.bitwise actual(%skipped_first) expected(%skipped_first) : tensor<[%capacity]x1024xbf16>
      check.expect.bitwise actual(%active_first) expected(%active_first) : tensor<[%capacity]x1024xbf16>
      check.expect.bitwise actual(%skipped_later) expected(%skipped_later) : tensor<[%capacity]x1024xbf16>
      check.expect.bitwise actual(%active_later) expected(%active_later) : tensor<[%capacity]x1024xbf16>
      check.expect.bitwise actual(%ordinary) expected(%ordinary) : tensor<[%capacity]x1024xbf16>
    }
  }
  check.return
}

check.benchmark<@proposal_predicates> @proposal_predicates_benchmark
