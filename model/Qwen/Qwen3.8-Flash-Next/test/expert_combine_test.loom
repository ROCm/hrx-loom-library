// Routing weights combine ten selected experts and the shared branch before
// one BF16 publication. The independent oracle accumulates in F64.
kernel.decl @experts_combine(%enabled: i1) launch(%epoch: buffer, %experts: buffer, %weights: buffer, %shared: buffer, %gate: buffer, %output: buffer)

func.def @combine_reference(%epoch: buffer, %experts: buffer, %weights: buffer, %shared: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
  %word = view.load %header[0] : view<1xi32> -> i32
  %count_value = index.cast %word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 7)] : index
  %values = buffer.view %experts[%origin] : buffer -> view<7x10x2560xbf16>
  %coefficients = buffer.view %weights[%origin] : buffer -> view<7x10xf32>
  %shared_values = buffer.view %shared[%origin] : buffer -> view<7x2560xbf16>
  %gates = buffer.view %gate[%origin] : buffer -> view<7xf32>
  %result = buffer.view %output[%origin] : buffer -> view<7x2560xbf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c10 = index.constant 10 : index
  %width = index.constant 2560 : index
  %c0_f64 = scalar.constant 0.0 : f64
  scf.for %token = [%c0 to %count step %c1] {
    %gate_word = view.load %gates[%token] : view<7xf32> -> f32
    %gate_value = scalar.extf %gate_word : f32 to f64
    scf.for %channel = [%c0 to %width step %c1] {
      %routed = scf.for %expert = [%c0 to %c10 step %c1](%sum = %c0_f64 : f64) -> (f64) {
        %value_word = view.load %values[%token, %expert, %channel] : view<7x10x2560xbf16> -> bf16
        %coefficient_word = view.load %coefficients[%token, %expert] : view<7x10xf32> -> f32
        %value = scalar.extf %value_word : bf16 to f64
        %coefficient = scalar.extf %coefficient_word : f32 to f64
        %next = scalar.fmaf %value, %coefficient, %sum : f64
        scf.yield %next : f64
      }
      %shared_word = view.load %shared_values[%token, %channel] : view<7x2560xbf16> -> bf16
      %shared_value = scalar.extf %shared_word : bf16 to f64
      %sum = scalar.fmaf %shared_value, %gate_value, %routed : f64
      %rounded = scalar.fptrunc %sum : f64 to bf16
      view.store %rounded, %result[%token, %channel] : bf16, view<7x2560xbf16>
    }
  }
  func.return
}

func.def @combine_epoch(%trial: index, %epoch: buffer) {
  %counts = vector.constanti [0, 1, 4, 7] : vector<4xi32>
  %count = vector.extract %counts[%trial] : vector<4xi32> -> i32
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
  view.store %count, %header[0] : i32, view<1xi32>
  func.return
}

check.scenario public @expert_output_publication {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.literal value(5731) : i64
    %other_seed = check.literal value(571) : i64
    %epoch = check.generate.fill value(0) : tensor<1xi32>
    check.generate<@combine_epoch>(%trial, %epoch) : (index, tensor<1xi32>) -> ()
    %experts = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<7x10x2560xbf16>
    %weights = check.generate.random.uniform seed(%other_seed) range(0.0 to 1.0) : tensor<7x10xf32>
    %shared = check.generate.random.uniform seed(%other_seed) range(-1.0 to 1.0) : tensor<7x2560xbf16>
    %gate = check.generate.random.uniform seed(%seed) range(0.0 to 1.0) : tensor<7xf32>
    %output = check.generate.fill value(-17.0) : tensor<7x2560xbf16>
    %enabled = check.literal value(true) : i1
    check.compare<@experts_combine, @combine_reference>[%enabled](%epoch, %experts, %weights, %shared, %gate, %output) : [i1](tensor<1xi32>, tensor<7x10x2560xbf16>, tensor<7x10xf32>, tensor<7x2560xbf16>, tensor<7xf32>, tensor<7x2560xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(6.103515625e-05) rtol(0.0078125) nan(different) : tensor<7x2560xbf16>, tensor<7x2560xbf16>
    }
  }
  check.return
}
