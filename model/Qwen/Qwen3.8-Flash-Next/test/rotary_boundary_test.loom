// A packet can finish a four-token pool without containing its first member.
// Sweep packet capacities one through four, with both retained and fresh spans.
// The actual map producer and pooled-key kernel consume different coordinates
// in old state and current media; the independent reference checks the choice.
config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @flash_next_map_tokens(%enabled: i1) launch(%epoch: buffer, %mapping: buffer)

kernel.decl @qsa_prepare_blocks_mixed(%enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer)

func.decl @rotate_unit(%channel: index, %temporal: i32, %height: i32, %width: i32) -> (bf16)

command.program.def @prepare_group() launch(%epoch: buffer, %rows: buffer, %inputs: buffer, %pooled: buffer, %weight: buffer, %arena: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %map_stride = index.constant 16 : offset
  %map_bytes = index.scale %capacity, %map_stride : index, offset -> offset
  %mapping = buffer.alloca<global> align(16) %map_bytes : buffer
  %enabled = scalar.constant true : i1
  %origin = index.constant 0 : offset
  kernel.launch @flash_next_map_tokens[%enabled](%epoch, %mapping) : [i1](buffer, buffer)
  kernel.launch @qsa_prepare_blocks_mixed[%enabled](%capacity, %capacity, %inputs, %inputs, %origin, %origin, %epoch, %mapping, %rows, %pooled, %weight, %arena) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @boundary_fixture(%trial: index, %epoch: buffer, %rows: buffer, %inputs: buffer, %arena: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %group_width = index.constant 4 : index
  %retained = index.cmp eq, %trial, %c0 : index
  %previous = index.sub %group_width, %capacity : index
  %first = scf.select %retained, %previous, %c0 : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<9xi32>
  %count = index.cast %capacity : index to i32
  %position = index.cast %first : index to i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %source = scalar.constant 100 : i32
  %absent = scalar.constant -1 : i32
  view.store %count, %header[0] : i32, view<9xi32>
  view.store %c1_i32, %header[1] : i32, view<9xi32>
  view.store %c0_i32, %header[2] : i32, view<9xi32>
  view.store %count, %header[3] : i32, view<9xi32>
  view.store %position, %header[4] : i32, view<9xi32>
  view.store %c0_i32, %header[5] : i32, view<9xi32>
  view.store %c0_i32, %header[6] : i32, view<9xi32>
  view.store %source, %header[7] : i32, view<9xi32>
  view.store %absent, %header[8] : i32, view<9xi32>
  %directory = buffer.view %rows[%origin] : buffer -> view<6xi64>
  %zero_address = scalar.constant 0 : i64
  %cache = scalar.constant 256 : i64
  %frontier = index.cast %first : index to i64
  %page_map = scalar.constant 40 : i64
  view.store %zero_address, %directory[0] : i64, view<6xi64>
  view.store %zero_address, %directory[1] : i64, view<6xi64>
  view.store %cache, %directory[2] : i64, view<6xi64>
  view.store %frontier, %directory[3] : i64, view<6xi64>
  view.store %page_map, %directory[4] : i64, view<6xi64>
  view.store %zero_address, %directory[5] : i64, view<6xi64>
  %coordinates = buffer.view %arena[%origin] : buffer -> view<4xi32>
  %old_temporal = scalar.constant 17 : i32
  %old_height = scalar.constant 31 : i32
  %old_width = scalar.constant 47 : i32
  view.store %old_temporal, %coordinates[0] : i32, view<4xi32>
  view.store %old_height, %coordinates[1] : i32, view<4xi32>
  view.store %old_width, %coordinates[2] : i32, view<4xi32>
  %records = buffer.view %inputs[%origin] : buffer -> view<[%capacity]x8xi32>
  %temporal = scalar.constant 77 : i32
  %height = scalar.constant 103 : i32
  %width = scalar.constant 149 : i32
  scf.for %record = [%c0 to %capacity step %c1] {
    %delta = index.cast %record : index to i32
    %t = scalar.addi %temporal, %delta : i32
    %h = scalar.addi %height, %delta : i32
    %w = scalar.addi %width, %delta : i32
    view.store %t, %records[%record, 2] : i32, view<[%capacity]x8xi32>
    view.store %h, %records[%record, 3] : i32, view<[%capacity]x8xi32>
    view.store %w, %records[%record, 4] : i32, view<[%capacity]x8xi32>
  }
  func.return
}

func.def @boundary_reference(%epoch: buffer, %rows: buffer, %inputs: buffer, %pooled: buffer, %weight: buffer, %arena: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<9xi32>
  %first = view.load %header[4] : view<9xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %retained = scalar.cmpi ne, %first, %c0_i32 : i32
  %group_width = index.constant 4 : index
  %whole_group = index.cmp eq, %capacity, %group_width : index
  %complete = scalar.ori %retained, %whole_group : i1
  scf.if %complete {
    %old_t = scalar.constant 17 : i32
    %old_h = scalar.constant 31 : i32
    %old_w = scalar.constant 47 : i32
    %current_t = scalar.constant 77 : i32
    %current_h = scalar.constant 103 : i32
    %current_w = scalar.constant 149 : i32
    %t = scf.select %retained, %old_t, %current_t : i32
    %h = scf.select %retained, %old_h, %current_h : i32
    %w = scf.select %retained, %old_w, %current_w : i32
    %cache = index.constant 256 : offset
    %output = buffer.view %arena[%cache] : buffer -> view<128xbf16>
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %width = index.constant 128 : index
    scf.for %channel = [%c0 to %width step %c1] {
      %value = func.call @rotate_unit(%channel, %t, %h, %w) : (index, i32, i32, i32) -> (bf16)
      view.store %value, %output[%channel] : bf16, view<128xbf16>
    }
  }
  func.return
}

func.def @packet_capacity() -> (index) {
  %capacity = config.get @flash_next.token_count : index
  func.return %capacity : index
}

check.scenario public @short_packet_rotary_boundary {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %capacity = check.generate<@packet_capacity>() : () -> (index)
    %epoch = check.generate.fill value(-777) : tensor<9xi32>
    %rows = check.generate.fill value(-777) : tensor<6xi64>
    %inputs = check.generate.fill value(-777) : tensor<[%capacity]x8xi32>
    %pooled = check.generate.fill value(1.0) : tensor<[%capacity]x128xbf16>
    %weight = check.generate.fill value(1.0) : tensor<128xf32>
    %arena = check.generate.fill value(-777) : tensor<128xi32>
    check.generate<@boundary_fixture>(%trial, %epoch, %rows, %inputs, %arena) : (index, tensor<9xi32>, tensor<6xi64>, tensor<[%capacity]x8xi32>, tensor<128xi32>) -> ()
    check.compare<@prepare_group, @boundary_reference>(%epoch, %rows, %inputs, %pooled, %weight, %arena) : (tensor<9xi32>, tensor<6xi64>, tensor<[%capacity]x8xi32>, tensor<[%capacity]x128xbf16>, tensor<128xf32>, tensor<128xi32>) -> () {
      check.expect.bitwise actual(%arena) expected(%arena) : tensor<128xi32>
    }
  }
  check.return
}
