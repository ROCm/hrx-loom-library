// The original packet is larger than both the compact workload and its origins
// allocation. All three representations use the same causal cache addresses.
command.program.def @current_tokens(%mode: index) launch(%control: buffer, %epoch: buffer, %mapping: buffer, %rows: buffer, %inputs: buffer, %origins: buffer, %raw: buffer, %weight: buffer, %queries: buffer, %arena: buffer) {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %enabled = scalar.constant true : i1
  %source_capacity = index.constant 32 : index
  %origin_capacity = index.constant 4 : index
  %heads = index.constant 4 : index
  %width = index.constant 128 : index
  %key_origin = index.constant 0 : offset
  %value_origin = index.constant 131072 : offset
  %plain = index.cmp eq, %mode, %c0 : index
  %remapped = index.cmp eq, %mode, %c2 : index
  scf.if %plain {
    kernel.launch @qsa_prepare_queries[%enabled, %heads](%width, %heads, %width, %epoch, %mapping, %raw, %weight, %queries) : [i1, index](index, index, index, buffer, buffer, buffer, buffer, buffer)
    kernel.launch @qsa_append_kv[%enabled](%key_origin, %value_origin, %epoch, %mapping, %rows, %raw, %raw, %weight, %arena) : [i1](offset, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  } else {
    scf.if %remapped {
      kernel.launch @qsa_prepare_queries_remapped[%enabled, %heads](%source_capacity, %origin_capacity, %inputs, %origins, %width, %heads, %width, %epoch, %mapping, %raw, %weight, %queries) : [i1, index](index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, buffer, buffer)
      kernel.launch @qsa_append_kv_remapped[%enabled](%source_capacity, %origin_capacity, %inputs, %origins, %key_origin, %value_origin, %epoch, %mapping, %rows, %raw, %raw, %weight, %arena) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      kernel.launch @qsa_prepare_queries_mixed[%enabled, %heads](%source_capacity, %origin_capacity, %inputs, %origins, %width, %heads, %width, %epoch, %mapping, %raw, %weight, %queries) : [i1, index](index, index, buffer, buffer, index, index, index, buffer, buffer, buffer, buffer, buffer)
      kernel.launch @qsa_append_kv_mixed[%enabled](%source_capacity, %origin_capacity, %inputs, %origins, %key_origin, %value_origin, %epoch, %mapping, %rows, %raw, %raw, %weight, %arena) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
  }
  command.return
}

func.def @current_fixture(%mode: index, %control: buffer, %epoch: buffer, %mapping: buffer, %rows: buffer, %inputs: buffer, %origins: buffer) {
  %origin = index.constant 0 : offset
  %control_view = buffer.view %control[%origin] : buffer -> view<1xi32>
  %mode_word = index.cast %mode : index to i32
  view.store %mode_word, %control_view[0] : i32, view<1xi32>
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %bindings = buffer.view %mapping[%origin] : buffer -> view<16x4xi32>
  %directory = buffer.view %rows[%origin] : buffer -> view<5xi64>
  %origin_map = buffer.view %origins[%origin] : buffer -> view<4xi32>
  %records = buffer.view %inputs[%origin] : buffer -> view<32x8xi32>
  %page_offset = index.constant 40 : offset
  %pages = buffer.view %rows[%page_offset] : buffer -> view<2xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %source_capacity = index.constant 32 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %source_first = scalar.constant 500 : i32
  %source_second = scalar.constant 1500 : i32
  %first_position = scalar.constant 61 : i32
  %second_position = scalar.constant 64 : i32
  %first_record = scalar.constant 20 : i32
  %last_record = scalar.constant 31 : i32
  %cache_base = scalar.constant 0 : i64
  %page_map = scalar.constant 40 : i64
  view.store %c3_i32, %header[0] : i32, view<3xi32>
  view.store %cache_base, %directory[2] : i64, view<5xi64>
  view.store %page_map, %directory[4] : i64, view<5xi64>
  view.store %c1_i32, %pages[0] : i32, view<2xi32>
  view.store %c0_i32, %pages[1] : i32, view<2xi32>
  view.store %first_record, %origin_map[0] : i32, view<4xi32>
  view.store %last_record, %origin_map[2] : i32, view<4xi32>
  scf.for %token = [%c0 to %c3 step %c1] {
    %word = index.cast %token : index to i32
    %first = index.cmp ult, %token, %c2 : index
    %position0 = scalar.addi %first_position, %word : i32
    %source0 = scalar.addi %source_first, %word : i32
    %position = scf.select %first, %position0, %second_position : i32
    %source = scf.select %first, %source0, %source_second : i32
    %begin = scf.select %first, %c0_i32, %c2_i32 : i32
    view.store %position, %bindings[%token, 0] : i32, view<16x4xi32>
    view.store %c0_i32, %bindings[%token, 1] : i32, view<16x4xi32>
    view.store %begin, %bindings[%token, 2] : i32, view<16x4xi32>
    view.store %source, %bindings[%token, 3] : i32, view<16x4xi32>
  }
  %temporal_base = scalar.constant 80 : i32
  %height_base = scalar.constant 40 : i32
  %width_base = scalar.constant 20 : i32
  %c5_i32 = scalar.constant 5 : i32
  %c7_i32 = scalar.constant 7 : i32
  scf.for %record = [%c0 to %source_capacity step %c1] {
    %word = index.cast %record : index to i32
    %temporal_delta = scalar.muli %word, %c3_i32 : i32
    %height_delta = scalar.muli %word, %c5_i32 : i32
    %width_delta = scalar.muli %word, %c7_i32 : i32
    %t = scalar.addi %temporal_delta, %temporal_base : i32
    %h = scalar.addi %height_delta, %height_base : i32
    %w = scalar.addi %width_delta, %width_base : i32
    view.store %t, %records[%record, 2] : i32, view<32x8xi32>
    view.store %h, %records[%record, 3] : i32, view<32x8xi32>
    view.store %w, %records[%record, 4] : i32, view<32x8xi32>
  }
  func.return
}

func.def @current_reference(%control: buffer, %epoch: buffer, %mapping: buffer, %rows: buffer, %inputs: buffer, %origins: buffer, %raw: buffer, %weight: buffer, %queries: buffer, %arena: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %query_width = index.constant 128 : index
  %key_width = index.constant 256 : index
  %first_record = index.constant 20 : index
  %last_record = index.constant 31 : index
  %first_physical = index.constant 125 : index
  %head_elements = index.constant 1024 : index
  %block_elements = index.constant 2048 : index
  %origin = index.constant 0 : offset
  %control_view = buffer.view %control[%origin] : buffer -> view<1xi32>
  %mode_word = view.load %control_view[0] : view<1xi32> -> i32
  %mode = index.cast %mode_word : i32 to index
  %value_origin = index.constant 131072 : offset
  %query_output = buffer.view %queries[%origin] : buffer -> view<16x4x128xbf16>
  %keys = buffer.view %arena[%origin] : buffer -> view<65536xbf16>
  %values = buffer.view %arena[%value_origin] : buffer -> view<65536xbf16>
  %unit = scalar.constant 1.0 : bf16
  %plain = index.cmp eq, %mode, %c0 : index
  %remapped = index.cmp eq, %mode, %c2 : index
  %linear_first = scalar.constant 500 : i32
  %linear_second = scalar.constant 1500 : i32
  %temporal_base = scalar.constant 80 : i32
  %height_base = scalar.constant 40 : i32
  %width_base = scalar.constant 20 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c5_i32 = scalar.constant 5 : i32
  %c7_i32 = scalar.constant 7 : i32
  scf.for %token = [%c0 to %c3 step %c1] {
    %first = index.cmp ult, %token, %c2 : index
    %mapped_first = index.add %first_record, %token : index
    %mapped = scf.select %first, %mapped_first, %last_record : index
    %record = scf.select %remapped, %mapped, %token : index
    %word = index.cast %record : index to i32
    %token_word = index.cast %token : index to i32
    %linear0 = scalar.addi %linear_first, %token_word : i32
    %linear = scf.select %first, %linear0, %linear_second : i32
    %dt = scalar.muli %word, %c3_i32 : i32
    %dh = scalar.muli %word, %c5_i32 : i32
    %dw = scalar.muli %word, %c7_i32 : i32
    %image_t = scalar.addi %dt, %temporal_base : i32
    %image_h = scalar.addi %dh, %height_base : i32
    %image_w = scalar.addi %dw, %width_base : i32
    %t = scf.select %plain, %linear, %image_t : i32
    %h = scf.select %plain, %linear, %image_h : i32
    %w = scf.select %plain, %linear, %image_w : i32
    scf.for %head = [%c0 to %c4 step %c1] {
      scf.for %channel = [%c0 to %query_width step %c1] {
        %value = func.call @rotate_unit(%channel, %t, %h, %w) : (index, i32, i32, i32) -> (bf16)
        view.store %value, %query_output[%token, %head, %channel] : bf16, view<16x4x128xbf16>
      }
    }
    %physical0 = index.add %first_physical, %token : index
    %physical = scf.select %first, %physical0, %c0 : index
    %block = index.div %physical, %c4 : index
    %member = index.rem %physical, %c4 : index
    scf.for %head = [%c0 to %c2 step %c1] {
      %head_base = index.mul %head, %head_elements : index
      %base = index.madd %block, %block_elements, %head_base : index
      scf.for %channel = [%c0 to %key_width step %c1] {
        %group = index.div %channel, %c16 : index
        %component = index.rem %channel, %c16 : index
        %within_member = index.madd %member, %c16, %component : index
        %within_key = index.madd %group, %c64, %within_member : index
        %key_element = index.add %base, %within_key : index
        %within_value = index.madd %channel, %c4, %member : index
        %value_element = index.add %base, %within_value : index
        %value = func.call @rotate_unit(%channel, %t, %h, %w) : (index, i32, i32, i32) -> (bf16)
        view.store %value, %keys[%key_element] : bf16, view<65536xbf16>
        view.store %unit, %values[%value_element] : bf16, view<65536xbf16>
      }
    }
  }
  func.return
}

check.scenario public @current_rotary_coordinates configure[3](%mode: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %control = check.generate.fill value(-777) : tensor<1xi32>
    %epoch = check.generate.fill value(0) : tensor<3xi32>
    %mapping = check.generate.fill value(-777) : tensor<16x4xi32>
    %rows = check.generate.fill value(-777) : tensor<6xi64>
    %inputs = check.generate.fill value(-777) : tensor<32x8xi32>
    %origins = check.generate.fill value(-777) : tensor<4xi32>
    %raw = check.generate.fill value(1.0) : tensor<16x512xbf16>
    %weight = check.generate.fill value(1.0) : tensor<256xf32>
    %queries = check.generate.fill value(-17.0) : tensor<16x4x128xbf16>
    %arena = check.generate.fill value(-17.0) : tensor<131072xbf16>
    check.generate<@current_fixture>(%mode, %control, %epoch, %mapping, %rows, %inputs, %origins) : (index, tensor<1xi32>, tensor<3xi32>, tensor<16x4xi32>, tensor<6xi64>, tensor<32x8xi32>, tensor<4xi32>) -> ()
    check.compare<@current_tokens, @current_reference>[%mode](%control, %epoch, %mapping, %rows, %inputs, %origins, %raw, %weight, %queries, %arena) : [index](tensor<1xi32>, tensor<3xi32>, tensor<16x4xi32>, tensor<6xi64>, tensor<32x8xi32>, tensor<4xi32>, tensor<16x512xbf16>, tensor<256xf32>, tensor<16x4x128xbf16>, tensor<131072xbf16>) -> () {
      check.expect.bitwise actual(%queries) expected(%queries) : tensor<16x4x128xbf16>
      check.expect.bitwise actual(%arena) expected(%arena) : tensor<131072xbf16>
    }
  }
  check.return
}
