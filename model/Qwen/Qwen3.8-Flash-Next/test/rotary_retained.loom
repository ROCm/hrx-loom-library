// Every layer must see the same old group coordinate. Two retained forks
// consume an accepted image prefix with source holes, then ordinary text.
// The second epoch reads its writer, so publishing the shared coordinate from
// any layer before the last would corrupt the remaining layers' pooled keys.

kernel.decl @flash_next_mtp_compact() launch(%accepted: buffer, %compact: buffer, %origins: buffer)

kernel.decl @flash_next_map_tokens(%enabled: i1) launch(%epoch: buffer, %mapping: buffer)

kernel.decl @qsa_pool_blocks(%enabled: i1) launch(%tail_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %raw: buffer, %arena: buffer, %pooled: buffer)

kernel.decl @qsa_prepare_blocks(%enabled: i1) launch(%coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer)

kernel.decl @qsa_prepare_blocks_remapped(%enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %inputs: buffer, %origins: buffer, %coordinate_origin: offset, %index_origin: offset, %epoch: buffer, %mapping: buffer, %rows: buffer, %pooled: buffer, %weight: buffer, %arena: buffer)

kernel.decl @qsa_publish_tail(%enabled: i1) launch(%tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_tail_commit() launch(%tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_coordinates_remapped(%enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_coordinates_text(%enabled: i1) launch(%source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

kernel.decl @qsa_publish_coordinates_commit() launch(%source_capacity: index, %origin_capacity: index, %coordinate_origin: offset, %inputs: buffer, %origins: buffer, %tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

// This is the production order without the learned projection preceding it.
// Constant raw vectors make normalization exact in BF16; varying coordinates
// still exercise every frequency pair and all three image axes.
command.program.def @layers(%media: i1) launch(%epoch: buffer, %mapping: buffer, %rows: buffer, %raw: buffer, %weight: buffer, %inputs: buffer, %origins: buffer, %arena: buffer, %pooled: buffer) {
  %enabled = scalar.constant true : i1
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 12 : index
  %last = index.constant 11 : index
  %capacity = index.constant 16 : index
  %coordinate = index.constant 9216 : offset
  %tail_stride = index.constant 768 : offset
  %cache_stride = index.constant 8192 : offset
  scf.for %layer = [%c0 to %count step %c1] unroll {
    %tail = index.scale %layer, %tail_stride : index, offset -> offset
    %cache = index.scale %layer, %cache_stride : index, offset -> offset
    kernel.launch @qsa_pool_blocks[%enabled](%tail, %epoch, %mapping, %rows, %raw, %arena, %pooled) : [i1](offset, buffer, buffer, buffer, buffer, buffer, buffer)
    scf.if %media {
      kernel.launch @qsa_prepare_blocks_remapped[%enabled](%capacity, %capacity, %inputs, %origins, %coordinate, %cache, %epoch, %mapping, %rows, %pooled, %weight, %arena) : [i1](index, index, buffer, buffer, offset, offset, buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      kernel.launch @qsa_prepare_blocks[%enabled](%coordinate, %cache, %epoch, %mapping, %rows, %pooled, %weight, %arena) : [i1](offset, offset, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    %final = index.cmp eq, %layer, %last : index
    scf.if %final {
      scf.if %media {
        kernel.launch @qsa_publish_coordinates_remapped[%enabled](%capacity, %capacity, %coordinate, %inputs, %origins, %tail, %epoch, %rows, %raw, %arena) : [i1](index, index, offset, buffer, buffer, offset, buffer, buffer, buffer, buffer)
      } else {
        kernel.launch @qsa_publish_coordinates_text[%enabled](%capacity, %capacity, %coordinate, %inputs, %origins, %tail, %epoch, %rows, %raw, %arena) : [i1](index, index, offset, buffer, buffer, offset, buffer, buffer, buffer, buffer)
      }
    } else {
      kernel.launch @qsa_publish_tail[%enabled](%tail, %epoch, %rows, %raw, %arena) : [i1](offset, buffer, buffer, buffer, buffer)
    }
  }
  command.return
}

command.program.def @advance() launch(%accepted: buffer, %replay: buffer, %text: buffer, %empty: buffer, %rows: buffer, %raw: buffer, %weight: buffer, %inputs: buffer, %arena: buffer) {
  %epoch_bytes = index.constant 84 : offset
  %map_bytes = index.constant 256 : offset
  %origin_bytes = index.constant 64 : offset
  %raw_bytes = index.constant 4096 : offset
  %compact = buffer.alloca<global> align(16) %epoch_bytes : buffer
  %mapping = buffer.alloca<global> align(16) %map_bytes : buffer
  %origins = buffer.alloca<global> align(16) %origin_bytes : buffer
  %pooled = buffer.alloca<global> align(16) %raw_bytes : buffer
  %yes = scalar.constant true : i1
  %no = scalar.constant false : i1
  kernel.launch @flash_next_mtp_compact(%accepted, %compact, %origins) : (buffer, buffer, buffer)
  kernel.launch @flash_next_map_tokens[%yes](%compact, %mapping) : [i1](buffer, buffer)
  command.program.launch @layers[%yes](%compact, %mapping, %rows, %raw, %weight, %inputs, %origins, %arena, %pooled) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  // Accepted replay has original packed starts and no token map. Re-publish
  // the same accepted prefix from that ownership boundary before continuing.
  // Replay descriptors are live; only the accepted compactor sees empty slots.
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 12 : index
  %last = index.constant 11 : index
  %capacity = index.constant 16 : index
  %coordinate = index.constant 9216 : offset
  %stride = index.constant 768 : offset
  scf.for %layer = [%c0 to %count step %c1] unroll {
    %tail = index.scale %layer, %stride : index, offset -> offset
    %final = index.cmp eq, %layer, %last : index
    scf.if %final {
      kernel.launch @qsa_publish_coordinates_commit(%capacity, %capacity, %coordinate, %inputs, %replay, %tail, %replay, %rows, %raw, %arena) : (index, index, offset, buffer, buffer, offset, buffer, buffer, buffer, buffer)
    } else {
      kernel.launch @qsa_publish_tail_commit(%tail, %replay, %rows, %raw, %arena) : (offset, buffer, buffer, buffer, buffer)
    }
  }
  kernel.launch @flash_next_map_tokens[%yes](%text, %mapping) : [i1](buffer, buffer)
  command.program.launch @layers[%no](%text, %mapping, %rows, %raw, %weight, %inputs, %origins, %arena, %pooled) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_map_tokens[%yes](%empty, %mapping) : [i1](buffer, buffer)
  command.program.launch @layers[%no](%empty, %mapping, %rows, %raw, %weight, %inputs, %origins, %arena, %pooled) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @descriptor(%epoch: buffer, %slot_arg: index, %length: i32, %position: i32, %begin: i32, %owner: i32, %source: i32) {
  %slot = index.assume %slot_arg [range(%slot_arg, 0, 2)] : index
  %header = index.constant 12 : offset
  %records = buffer.view %epoch[%header] : buffer -> view<3x6xi32>
  %absent = scalar.constant -1 : i32
  view.store %length, %records[%slot, 0] : i32, view<3x6xi32>
  view.store %position, %records[%slot, 1] : i32, view<3x6xi32>
  view.store %begin, %records[%slot, 2] : i32, view<3x6xi32>
  view.store %owner, %records[%slot, 3] : i32, view<3x6xi32>
  view.store %source, %records[%slot, 4] : i32, view<3x6xi32>
  view.store %absent, %records[%slot, 5] : i32, view<3x6xi32>
  func.return
}

