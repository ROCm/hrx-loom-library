func.decl @rotate_unit(%channel: index, %temporal: i32, %height: i32, %width: i32) -> (bf16)

func.def @expected(%accepted: buffer, %replay: buffer, %text: buffer, %empty: buffer, %rows: buffer, %raw: buffer, %weight: buffer, %inputs: buffer, %arena: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c12 = index.constant 12 : index
  %c128 = index.constant 128 : index
  %c384 = index.constant 384 : index
  %endpoint_bytes = index.constant 9472 : offset
  %coordinate_offset = index.constant 9216 : offset
  %tail_stride = index.constant 768 : offset
  %cache_start = index.constant 28416 : offset
  %cache_stride = index.constant 98304 : offset
  %layer_stride = index.constant 8192 : offset
  %block31 = index.constant 7936 : offset
  %old_t = scalar.constant 17 : i32
  %old_h = scalar.constant 31 : i32
  %old_w = scalar.constant 47 : i32
  %image_t = scalar.constant 107 : i32
  %image_h = scalar.constant 85 : i32
  %image_w = scalar.constant 83 : i32
  %text_position = scalar.constant 1001 : i32
  %padding = scalar.constant 0 : i32
  %unit = scalar.constant 1.0 : bf16
  scf.for %owner = [%c0 to %c2 step %c1] {
    %first = index.cmp eq, %owner, %c0 : index
    %slot = index.add %owner, %c1 : index
    %endpoint = index.scale %slot, %endpoint_bytes : index, offset -> offset
    %coordinate = index.add %endpoint, %coordinate_offset : offset
    %record = buffer.view %arena[%coordinate] : buffer -> view<4xi32>
    %t = scf.select %first, %text_position, %image_t : i32
    %h = scf.select %first, %text_position, %image_h : i32
    %w = scf.select %first, %text_position, %image_w : i32
    view.store %t, %record[0] : i32, view<4xi32>
    view.store %h, %record[1] : i32, view<4xi32>
    view.store %w, %record[2] : i32, view<4xi32>
    view.store %padding, %record[3] : i32, view<4xi32>
    %tail_elements = scf.select %first, %c384, %c128 : index
    %cache_relative = index.scale %owner, %cache_stride : index, offset -> offset
    %cache_base = index.add %cache_start, %cache_relative : offset
    scf.for %layer = [%c0 to %c12 step %c1] {
      %tail_relative = index.scale %layer, %tail_stride : index, offset -> offset
      %tail_origin = index.add %endpoint, %tail_relative : offset
      %tail = buffer.view %arena[%tail_origin] : buffer -> view<384xbf16>
      scf.for %element = [%c0 to %tail_elements step %c1] {
        view.store %unit, %tail[%element] : bf16, view<384xbf16>
      }
      %layer_relative = index.scale %layer, %layer_stride : index, offset -> offset
      %layer_base = index.add %cache_base, %layer_relative : offset
      %old_key_origin = index.add %layer_base, %block31 : offset
      %old_key = buffer.view %arena[%old_key_origin] : buffer -> view<128xbf16>
      %image_key = buffer.view %arena[%layer_base] : buffer -> view<128xbf16>
      scf.for %channel = [%c0 to %c128 step %c1] {
        %old = func.call @rotate_unit(%channel, %old_t, %old_h, %old_w) : (index, i32, i32, i32) -> (bf16)
        view.store %old, %old_key[%channel] : bf16, view<128xbf16>
        scf.if %first {
        } else {
          %image = func.call @rotate_unit(%channel, %image_t, %image_h, %image_w) : (index, i32, i32, i32) -> (bf16)
          view.store %image, %image_key[%channel] : bf16, view<128xbf16>
        }
      }
    }
  }
  func.return
}

check.scenario public @retained_rotary_coordinates {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %accepted = check.generate.fill value(-777) : tensor<21xi32>
    %replay = check.generate.fill value(-777) : tensor<21xi32>
    %text = check.generate.fill value(-777) : tensor<21xi32>
    %empty = check.generate.fill value(-777) : tensor<21xi32>
    %rows = check.generate.fill value(-777) : tensor<12xi64>
    %raw = check.generate.fill value(1.0) : tensor<16x128xbf16>
    %weight = check.generate.fill value(1.0) : tensor<128xf32>
    %inputs = check.generate.fill value(-777) : tensor<16x8xi32>
    %arena = check.generate.fill value(-777) : tensor<56256xi32>
    check.generate<@fixture>(%accepted, %replay, %text, %empty, %rows, %inputs, %arena) : (tensor<21xi32>, tensor<21xi32>, tensor<21xi32>, tensor<21xi32>, tensor<12xi64>, tensor<16x8xi32>, tensor<56256xi32>) -> ()
    check.compare<@advance, @expected>(%accepted, %replay, %text, %empty, %rows, %raw, %weight, %inputs, %arena) : (tensor<21xi32>, tensor<21xi32>, tensor<21xi32>, tensor<21xi32>, tensor<12xi64>, tensor<16x128xbf16>, tensor<128xf32>, tensor<16x8xi32>, tensor<56256xi32>) -> () {
      check.expect.bitwise actual(%arena) expected(%arena) : tensor<56256xi32>
    }
  }
  check.return
}

