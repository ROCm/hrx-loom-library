  check.expect.bitwise actual(%results) expected(%expected_results) : tensor<128x10xi32>
  kernel.launch @gdn_convolve_commit(%replay, %rows, %history_origin, %qkv_capture, %weight, %actual, %convolved, %norm) : (tensor<771xi32>, tensor<95xi64>, offset, tensor<72x10240xbf16>, tensor<10240x4xf32>, tensor<20x848128xf32>, tensor<72x10240xbf16>, tensor<72x32xf32>)
  kernel.launch @gdn_recur_commit(%replay, %rows, %state_origin, %convolved, %norm, %alpha_capture, %beta_capture, %a, %bias, %actual, %replay_output) : (tensor<771xi32>, tensor<95xi64>, offset, tensor<72x10240xbf16>, tensor<72x32xf32>, tensor<72x48xf32>, tensor<72x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<20x848128xf32>, tensor<72x6144xbf16>)
  kernel.launch @flash_next_commit_ple_history(%ple_origin, %replay, %rows, %ple_capture, %actual) : (offset, tensor<771xi32>, tensor<95xi64>, tensor<72x10240xbf16>, tensor<20x848128xf32>)
  kernel.launch @flash_next_ple_publish_history_commit(%ids_origin, %replay, %rows, %ids_capture, %actual) : (offset, tensor<771xi32>, tensor<95xi64>, tensor<72xi32>, tensor<20x848128xf32>)
  kernel.launch @qsa_publish_tail_commit(%qsa_origin, %replay, %rows, %raw_keys_capture, %actual) : (offset, tensor<771xi32>, tensor<95xi64>, tensor<72x128xbf16>, tensor<20x848128xf32>)

  // Direct execution of the selected prefixes never sees rejected inputs.
  // Compare the entire retained arena, including anchor and padding bytes.
  kernel.launch @gdn_convolve_commit(%reference, %rows, %history_origin, %qkv, %weight, %expected, %convolved, %norm) : (tensor<771xi32>, tensor<95xi64>, offset, tensor<72x10240xbf16>, tensor<10240x4xf32>, tensor<20x848128xf32>, tensor<72x10240xbf16>, tensor<72x32xf32>)
  kernel.launch @gdn_recur_commit(%reference, %rows, %state_origin, %convolved, %norm, %alpha, %beta, %a, %bias, %expected, %replay_output) : (tensor<771xi32>, tensor<95xi64>, offset, tensor<72x10240xbf16>, tensor<72x32xf32>, tensor<72x48xf32>, tensor<72x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<20x848128xf32>, tensor<72x6144xbf16>)
  kernel.launch @reference_ple_convolve(%ple_origin, %rows, %reference, %gated, %ple, %weight, %expected, %residual, %ple_output) : (offset, tensor<95xi64>, tensor<771xi32>, tensor<72x10240xbf16>, tensor<72x10240xbf16>, tensor<10240x4xf32>, tensor<20x848128xf32>, tensor<72x10240xbf16>, tensor<72x10240xbf16>)
  kernel.launch @flash_next_ple_publish_history_commit(%ids_origin, %reference, %rows, %ids, %expected) : (offset, tensor<771xi32>, tensor<95xi64>, tensor<72xi32>, tensor<20x848128xf32>)
