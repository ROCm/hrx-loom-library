// Final-layer selection compacts ragged query tails without confusing packed
// token positions, retained identities, source coordinates, or output indices.
// The oracle constructs the compact image from fixture arithmetic, independently
// of the kernel's descriptor reads and capacity helpers.
kernel.decl @flash_next_finish_plan() launch(%epoch: buffer, %compact: buffer, %origins: buffer)

func.def @fixture(%count_value: index, %epoch: buffer, %expected: buffer, %expected_origins: buffer) {
  %count = index.assume %count_value [range(%count_value, 0, 129)] : index
  %origin = index.constant 0 : offset
  %header_bytes = index.constant 12 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %descriptors = buffer.view %epoch[%header_bytes] : buffer -> view<129x6xi32>
  %expected_header = buffer.view %expected[%origin] : buffer -> view<3xi32>
  %output = buffer.view %expected[%header_bytes] : buffer -> view<129x6xi32>
  %indices = buffer.view %expected_origins[%origin] : buffer -> view<512xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c10 = index.constant 10 : index
  %position_base = index.constant 1000 : index
  %source_base = index.constant 50000 : index
  %resident_base = scalar.constant 1000000 : i32
  %absent = scalar.constant -1 : i32
  %packed, %retained, %outputs = scf.for %span = [%c0 to %count step %c1](%begin = %c0 : index, %cursor = %c0 : index, %selected = %c0 : index) -> (index, index, index) {
    %remainder = index.rem %span, %c5 : index
    %length = index.add %remainder, %c1 : index
    %position = index.madd %span, %c10, %position_base : index
    %source = index.madd %span, %c10, %source_base : index
    %ordinal = index.cast %span : index to i32
    %resident = scalar.addi %resident_base, %ordinal : i32
    %kind = index.rem %span, %c3 : index
    %needed = index.cmp ne, %kind, %c1 : index
    %selection_word = index.cast %selected : index to i32
    %selection = scf.select %needed, %selection_word, %absent : i32
    %length_word = index.cast %length : index to i32
    %begin_word = index.cast %begin : index to i32
    %position_word = index.cast %position : index to i32
    %source_word = index.cast %source : index to i32
    view.store %length_word, %descriptors[%span, 0] : i32, view<129x6xi32>
    view.store %position_word, %descriptors[%span, 1] : i32, view<129x6xi32>
    view.store %begin_word, %descriptors[%span, 2] : i32, view<129x6xi32>
    view.store %resident, %descriptors[%span, 3] : i32, view<129x6xi32>
    view.store %source_word, %descriptors[%span, 4] : i32, view<129x6xi32>
    view.store %selection, %descriptors[%span, 5] : i32, view<129x6xi32>
    %next_cursor, %next_selected = scf.if %needed -> (index, index) {
      %preceding = index.sub %length, %c1 : index
      %tail_remainder = index.rem %preceding, %c4 : index
      %tail = index.add %tail_remainder, %c1 : index
      %skipped = index.sub %length, %tail : index
      %tail_position = index.add %position, %skipped : index
      %tail_source = index.add %source, %skipped : index
      %tail_begin = index.add %begin, %skipped : index
      %slot = index.assume %selected [range(%selected, 0, 128)] : index
      %tail_word = index.cast %tail : index to i32
      %cursor_word = index.cast %cursor : index to i32
      %tail_position_word = index.cast %tail_position : index to i32
      %tail_source_word = index.cast %tail_source : index to i32
      view.store %tail_word, %output[%slot, 0] : i32, view<129x6xi32>
      view.store %tail_position_word, %output[%slot, 1] : i32, view<129x6xi32>
      view.store %cursor_word, %output[%slot, 2] : i32, view<129x6xi32>
      view.store %resident, %output[%slot, 3] : i32, view<129x6xi32>
      view.store %tail_source_word, %output[%slot, 4] : i32, view<129x6xi32>
      view.store %selection, %output[%slot, 5] : i32, view<129x6xi32>
      scf.for %i = [%c0 to %tail step %c1] {
        %destination_value = index.add %cursor, %i : index
        %destination = index.assume %destination_value [range(%destination_value, 0, 511)] : index
        %original = index.add %tail_begin, %i : index
        %word = index.cast %original : index to i32
        view.store %word, %indices[%destination] : i32, view<512xi32>
      }
      %next_cursor = index.add %cursor, %tail : index
      %next_selected = index.add %selected, %c1 : index
      scf.yield %next_cursor, %next_selected : index, index
    } else {
      scf.yield %cursor, %selected : index, index
    }
    %next_begin = index.add %begin, %length : index
    scf.yield %next_begin, %next_cursor, %next_selected : index, index, index
  }
  %packed_word = index.cast %packed : index to i32
  %count_word = index.cast %count : index to i32
  %output_word = index.cast %outputs : index to i32
  %retained_word = index.cast %retained : index to i32
  view.store %packed_word, %header[0] : i32, view<3xi32>
  view.store %count_word, %header[1] : i32, view<3xi32>
  view.store %output_word, %header[2] : i32, view<3xi32>
  view.store %retained_word, %expected_header[0] : i32, view<3xi32>
  view.store %output_word, %expected_header[1] : i32, view<3xi32>
  view.store %output_word, %expected_header[2] : i32, view<3xi32>
  func.return
}

func.def @reference(%epoch: buffer, %compact: buffer, %origins: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %count_word = view.load %header[1] : view<3xi32> -> i32
  %count = index.cast %count_word : i32 to index
  func.call @fixture(%count, %epoch, %compact, %origins) : (index, buffer, buffer, buffer)
  func.return
}

func.def @inputs(%trial: index, %epoch: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c17 = index.constant 17 : index
  %c65 = index.constant 65 : index
  %c129 = index.constant 129 : index
  %empty = index.cmp eq, %trial, %c0 : index
  %small = index.cmp eq, %trial, %c1 : index
  %medium = index.cmp eq, %trial, %c2 : index
  %large_count = scf.select %medium, %c65, %c129 : index
  %live_count = scf.select %small, %c17, %large_count : index
  %count = scf.select %empty, %c0, %live_count : index
  %descriptor_bytes = index.constant 3108 : offset
  %index_bytes = index.constant 2048 : offset
  %expected = buffer.alloca<private> align(4) %descriptor_bytes : buffer
  %expected_origins = buffer.alloca<private> align(4) %index_bytes : buffer
  func.call @fixture(%count, %epoch, %expected, %expected_origins) : (index, buffer, buffer, buffer)
  func.return
}

check.scenario public @wide_ragged_finish {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(-99) : tensor<777xi32>
    check.generate<@inputs>(%trial, %epoch) : (index, tensor<777xi32>) -> ()
    %compact = check.generate.fill value(-99) : tensor<777xi32>
    %origins = check.generate.fill value(-99) : tensor<512xi32>
    check.compare<@flash_next_finish_plan, @reference>(%epoch, %compact, %origins) : (tensor<777xi32>, tensor<777xi32>, tensor<512xi32>) -> () {
      check.expect.equal actual(%compact) expected(%compact) : tensor<777xi32>
      check.expect.equal actual(%origins) expected(%origins) : tensor<512xi32>
    }
  }
  check.return
}

check.benchmark<@wide_ragged_finish> @wide_ragged_finish_plan
