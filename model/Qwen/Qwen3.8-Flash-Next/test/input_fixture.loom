// Build either input carrier from an independent ordinary-ID fixture. Media
// metadata deliberately differs from the ID; histories must retain only IDs.
config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

kernel.def @input_packet_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%capacity: index, %ids: buffer, %packet: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %origin = index.constant 0 : offset
  %mixed = config.get @runner.qwen38.mixed_inputs : index
  %media = index.cmp ne, %mixed, %c0 : index
  %stride = scf.select %media, %c8, %c1 : index
  %source = buffer.view %ids[%origin] : buffer -> view<[%capacity]xi32>
  %records = buffer.view %packet[%origin] : buffer -> view<[%capacity]x[%stride]xi32>
  %none = scalar.constant 0 : i32
  scf.for %token = [%c0 to %capacity step %c1] {
    %id = view.load %source[%token] : view<[%capacity]xi32> -> i32
    view.store %id, %records[%token, 0] : i32, view<[%capacity]x[%stride]xi32>
    scf.if %media {
      view.store %none, %records[%token, 1] : i32, view<[%capacity]x[%stride]xi32>
    }
  }
  kernel.return
}
