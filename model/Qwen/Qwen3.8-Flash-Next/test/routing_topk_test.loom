kernel.decl @route_top10(%enabled: i1) launch(%epoch: buffer, %logits: buffer, %ids: buffer, %weights: buffer)

// Permuted ramps exercise unique ranks, ties across waves, and an all-equal row.
func.def @route_fixture(%trial: index, %epoch: buffer, %logits: buffer) {
  %counts = vector.constanti [0, 1, 7] : vector<3xi32>
  %count = vector.extract %counts[%trial] : vector<3xi32> -> i32
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
  %values = buffer.view %logits[%origin] : buffer -> view<7x512xf32>
  view.store %count, %header[0] : i32, view<1xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c7 = index.constant 7 : index
  %c13 = index.constant 13 : index
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %c512 = index.constant 512 : index
  %scale = scalar.constant 0.03125 : f32
  scf.for %token = [%c0 to %c7 step %c1] {
    %pattern = index.rem %token, %c3 : index
    %unique = index.cmp eq, %pattern, %c0 : index
    %tied = index.cmp eq, %pattern, %c1 : index
    %tie_period = scf.select %tied, %c32, %c1 : index
    %period = scf.select %unique, %c512, %tie_period : index
    %phase = index.mul %token, %c13 : index
    scf.for %expert = [%c0 to %c512 step %c1] {
      %permuted = index.madd %expert, %c17, %phase : index
      %rank = index.rem %permuted, %period : index
      %word = index.cast %rank : index to i32
      %value = scalar.sitofp %word : i32 to f32
      %score = scalar.mulf %value, %scale : f32
      view.store %score, %values[%token, %expert] : f32, view<7x512xf32>
    }
  }
  func.return
}

// Invert the fixture's permutation analytically. This oracle neither selects
// maxima nor shares the kernel's collective or register-publication scheme.
func.def @route_reference(%epoch: buffer, %logits: buffer, %ids: buffer, %weights: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<1xi32>
  %word = view.load %header[0] : view<1xi32> -> i32
  %count_value = index.cast %word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 7)] : index
  %ids_view = buffer.view %ids[%origin] : buffer -> view<7x10xi32>
  %weights_view = buffer.view %weights[%origin] : buffer -> view<7x10xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c10 = index.constant 10 : index
  %c13 = index.constant 13 : index
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %c241 = index.constant 241 : index
  %c511 = index.constant 511 : index
  %c512 = index.constant 512 : index
  %c543 = index.constant 543 : index
  %c0_f64 = scalar.constant 0.0 : f64
  %scale = scalar.constant -0.03125 : f64
  scf.for %token = [%c0 to %count step %c1] {
    %pattern = index.rem %token, %c3 : index
    %unique = index.cmp eq, %pattern, %c0 : index
    %tied = index.cmp eq, %pattern, %c1 : index
    %phase = index.mul %token, %c13 : index
    %tie_rank = index.sub %c543, %phase : index
    %tie_permuted = index.mul %tie_rank, %c17 : index
    %tie_first = index.rem %tie_permuted, %c32 : index
    %sum = scf.for %selection = [%c0 to %c10 step %c1](%total = %c0_f64 : f64) -> (f64) {
      %selection_word = index.cast %selection : index to i32
      %selection_value = scalar.sitofp %selection_word : i32 to f64
      %ramp = scalar.mulf %selection_value, %scale : f64
      %score = scf.select %unique, %ramp, %c0_f64 : f64
      %term = scalar.expf %score : f64
      %next = scalar.addf %total, %term : f64
      scf.yield %next : f64
    }
    scf.for %selection = [%c0 to %c10 step %c1] {
      %descending = index.sub %c511, %selection : index
      %positive = index.add %descending, %c512 : index
      %shifted = index.sub %positive, %phase : index
      %inverse = index.mul %shifted, %c241 : index
      %unique_id = index.rem %inverse, %c512 : index
      %tied_id = index.madd %selection, %c32, %tie_first : index
      %other_id = scf.select %tied, %tied_id, %selection : index
      %selected = scf.select %unique, %unique_id, %other_id : index
      %selected_word = index.cast %selected : index to i32
      view.store %selected_word, %ids_view[%token, %selection] : i32, view<7x10xi32>
      %selection_word = index.cast %selection : index to i32
      %selection_value = scalar.sitofp %selection_word : i32 to f64
      %ramp = scalar.mulf %selection_value, %scale : f64
      %score = scf.select %unique, %ramp, %c0_f64 : f64
      %term = scalar.expf %score : f64
      %probability = scalar.divf %term, %sum : f64
      %rounded = scalar.fptrunc %probability : f64 to f32
      view.store %rounded, %weights_view[%token, %selection] : f32, view<7x10xf32>
    }
  }
  func.return
}

check.scenario public @routing_rank_publication {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<1xi32>
    %logits = check.generate.fill value(0.0) : tensor<7x512xf32>
    check.generate<@route_fixture>(%trial, %epoch, %logits) : (index, tensor<1xi32>, tensor<7x512xf32>) -> ()
    %ids = check.generate.fill value(-17) : tensor<7x10xi32>
    %weights = check.generate.fill value(-17.0) : tensor<7x10xf32>
    %enabled = check.literal value(true) : i1
    check.compare<@route_top10, @route_reference>[%enabled](%epoch, %logits, %ids, %weights) : [i1](tensor<1xi32>, tensor<7x512xf32>, tensor<7x10xi32>, tensor<7x10xf32>) -> () {
      check.expect.equal actual(%ids) expected(%ids) : tensor<7x10xi32>
      check.expect.approximate actual(%weights) expected(%weights) atol(1.9999999999999999e-06) rtol(1.9999999999999999e-06) nan(different) : tensor<7x10xf32>, tensor<7x10xf32>
    }
  }
  check.return
}
