// A live prefix longer than the gfx11 worker grid forces shared-storage reuse.
// Zero Q/K make attention uniform. V repeats [0, 1, 2, 3] plus a KV-head bias,
// so an independent closed-form average checks each causal/sparse prefix.
// The final partial cohort must preserve the three inactive output rows.

func.decl pure @qsa_cohort_capacity() -> (index)

kernel.decl @qsa_merge_cohorts(%enabled: i1) launch(%epoch: buffer, %selected: buffer, %cohorts: buffer)

kernel.decl @qsa_cohort_attention(%enabled: i1) launch(%key_origin: offset, %value_origin: offset, %rows: buffer, %queries: buffer, %gates: buffer, %arena: buffer, %cohorts: buffer, %output: buffer)

func.def @fixture(%epoch: buffer, %rows: buffer, %arena: buffer, %selected: buffer) {
  %origin = index.constant 0 : offset
  %map_origin = index.constant 40 : offset
  %value_origin = index.constant 2048 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<9xi32>
  %live = scalar.constant 3077 : i32
  %one = scalar.constant 1 : i32
  view.store %live, %header[0] : i32, view<9xi32>
  view.store %one, %header[1] : i32, view<9xi32>
  view.store %live, %header[3] : i32, view<9xi32>
  %entries = buffer.view %rows[%origin] : buffer -> view<1x5xi64>
  %map_word = scalar.constant 40 : i64
  view.store %map_word, %entries[0, 4] : i64, view<1x5xi64>
  %map = buffer.view %rows[%map_origin] : buffer -> view<49xi32>
  %values = buffer.view %arena[%value_origin] : buffer -> view<3210240xbf16>
  %ids = buffer.view %selected[%origin] : buffer -> view<3080x512xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %pages = index.constant 49 : index
  %blocks = index.constant 784 : index
  %block_elements = index.constant 4096 : index
  %head_elements = index.constant 2048 : index
  %value_elements = index.constant 1024 : index
  %tokens = index.constant 3080 : index
  %budget = index.constant 512 : index
  scf.for %page = [%c0 to %pages step %c1] {
    %word = index.cast %page : index to i32
    view.store %word, %map[%page] : i32, view<49xi32>
  }
  %first = vector.constantf [0.0, 1.0, 2.0, 3.0, 0.0, 1.0, 2.0, 3.0, 0.0, 1.0, 2.0, 3.0, 0.0, 1.0, 2.0, 3.0] : vector<16xbf16>
  %second = vector.constantf [8.0, 9.0, 10.0, 11.0, 8.0, 9.0, 10.0, 11.0, 8.0, 9.0, 10.0, 11.0, 8.0, 9.0, 10.0, 11.0] : vector<16xbf16>
  scf.for %block = [%c0 to %blocks step %c1] {
    %base = index.mul %block, %block_elements : index
    %other = index.add %base, %head_elements : index
    scf.for %position = [%c0 to %value_elements step %c16] {
      %a = index.add %base, %position : index
      %b = index.add %other, %position : index
      vector.store %first, %values[%a] : vector<16xbf16>, view<3210240xbf16>
      vector.store %second, %values[%b] : vector<16xbf16>, view<3210240xbf16>
    }
  }
  %word_one = scalar.constant 1 : i32
  scf.for %token = [%c0 to %tokens step %c1] {
    scf.for %slot = [%c0 to %budget step %c16] {
      %first_word = index.cast %slot : index to i32
      %packet = vector.iota %first_word step %word_one : vector<16xi32>
      vector.store %packet, %ids[%token, %slot] : vector<16xi32>, view<3080x512xi32>
    }
  }
  func.return
}

command.def @attention() launch(%epoch: buffer, %rows: buffer, %zeros: buffer, %arena: buffer, %selected: buffer, %output: buffer) {
  %enabled = scalar.constant true : i1
  %groups = func.call pure @qsa_cohort_capacity() : () -> (index)
  %stride = index.constant 8224 : offset
  %bytes = index.scale %groups, %stride : index, offset -> offset
  %cohorts = buffer.alloca<global> align(16) %bytes : buffer
  %key_origin = index.constant 0 : offset
  %value_origin = index.constant 2048 : offset
  kernel.launch @qsa_merge_cohorts[%enabled](%epoch, %selected, %cohorts) : [i1](buffer, buffer, buffer)
  kernel.launch @qsa_cohort_attention[%enabled](%key_origin, %value_origin, %rows, %zeros, %zeros, %arena, %cohorts, %output) : [i1](offset, offset, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @reference(%epoch: buffer, %rows: buffer, %zeros: buffer, %arena: buffer, %selected: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %result = buffer.view %output[%origin] : buffer -> view<3080x24x256xbf16>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c12 = index.constant 12 : index
  %live = index.constant 3077 : index
  %heads = index.constant 24 : index
  %budget = index.constant 512 : index
  %c0_f64 = scalar.constant 0.0 : f64
  %c1_f64 = scalar.constant 1.0 : f64
  %c2_f64 = scalar.constant 2.0 : f64
  %c6_f64 = scalar.constant 6.0 : f64
  %c8_f64 = scalar.constant 8.0 : f64
  %half = scalar.constant 0.5 : f32
  scf.for %token = [%c0 to %live step %c1] {
    %visible = index.add %token, %c1 : index
    %complete = index.div %visible, %c4 : index
    %count = index.min %complete, %budget : index
    %tail = index.rem %visible, %c4 : index
    %whole = index.mul %count, %c4 : index
    %length = index.add %whole, %tail : index
    %count_word = index.cast %count : index to i32
    %tail_word = index.cast %tail : index to i32
    %length_word = index.cast %length : index to i32
    %count_float = scalar.uitofp %count_word : i32 to f64
    %tail_float = scalar.uitofp %tail_word : i32 to f64
    %length_float = scalar.uitofp %length_word : i32 to f64
    %previous = scalar.subf %tail_float, %c1_f64 : f64
    %product = scalar.mulf %tail_float, %previous : f64
    %tail_sum = scalar.divf %product, %c2_f64 : f64
    %whole_sum = scalar.mulf %count_float, %c6_f64 : f64
    %sum = scalar.addf %whole_sum, %tail_sum : f64
    %mean = scalar.divf %sum, %length_float : f64
    scf.for %head = [%c0 to %heads step %c1] {
      %first = index.cmp ult, %head, %c12 : index
      %bias = scf.select %first, %c0_f64, %c8_f64 : f64
      %value = scalar.addf %mean, %bias : f64
      %attended = scalar.fptrunc %value : f64 to bf16
      %wide = scalar.extf %attended : bf16 to f32
      %gated = scalar.mulf %wide, %half : f32
      %packed = scalar.fptrunc %gated : f32 to bf16
      %packet = vector.splat %packed : vector<256xbf16>
      vector.store %packet, %result[%token, %head, %c0] : vector<256xbf16>, view<3080x24x256xbf16>
    }
  }
  func.return
}

check.scenario public @attention_worker_reuse {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(0) : tensor<9xi32>
    %rows = check.generate.fill value(0) : tensor<236xi8>
    %zeros = check.generate.fill value(0.0) : tensor<3080x24x512xbf16>
    %arena = check.generate.fill value(0) : tensor<6422528xi8>
    %selected = check.generate.fill value(0) : tensor<3080x512xi32>
    %output = check.generate.fill value(-17.0) : tensor<3080x24x256xbf16>
    check.generate<@fixture>(%epoch, %rows, %arena, %selected) : (tensor<9xi32>, tensor<236xi8>, tensor<6422528xi8>, tensor<3080x512xi32>) -> ()
    check.compare<@attention, @reference>(%epoch, %rows, %zeros, %arena, %selected, %output) : (tensor<9xi32>, tensor<236xi8>, tensor<3080x24x512xbf16>, tensor<6422528xi8>, tensor<3080x512xi32>, tensor<3080x24x256xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(6.103515625e-05) rtol(0.0078125) nan(different) : tensor<3080x24x256xbf16>, tensor<3080x24x256xbf16>
    }
  }
  check.return
}

check.benchmark<@attention_worker_reuse> @attention_worker_reuse_benchmark
