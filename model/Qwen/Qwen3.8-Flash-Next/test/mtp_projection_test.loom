config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

func.decl @projection_fixture(%weight: buffer)

func.decl @fusion_reference(%epoch: buffer, %embedding: buffer, %hidden: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_mtp_embedding_matrix(%neural_enabled: i1) launch(%epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_mtp_hidden_matrix(%neural_enabled: i1) launch(%epoch: buffer, %input: buffer, %weight: buffer, %embedding: buffer, %output: buffer)

kernel.decl @flash_next_mtp_fuse(%neural_enabled: i1) launch(%epoch: buffer, %embedding: buffer, %hidden: buffer, %weight: buffer, %output: buffer)

command.def @projection() launch(%epoch: buffer, %embedding: buffer, %hidden: buffer, %weight: buffer, %output: buffer) {
  %neural_enabled = scalar.constant true : i1
  %capacity = config.get @flash_next.token_count : index
  %threshold = index.constant 128 : index
  %matrix = index.cmp uge, %capacity, %threshold : index
  scf.if %matrix {
    %stride = index.constant 5120 : offset
    %bytes = index.scale %capacity, %stride : index, offset -> offset
    %projected_embedding = buffer.alloca<global> align(256) %bytes : buffer
    kernel.launch @flash_next_mtp_embedding_matrix[%neural_enabled](%epoch, %embedding, %weight, %projected_embedding) : [i1](buffer, buffer, buffer, buffer)
    kernel.launch @flash_next_mtp_hidden_matrix[%neural_enabled](%epoch, %hidden, %weight, %projected_embedding, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
  } else {
    kernel.launch @flash_next_mtp_fuse[%neural_enabled](%epoch, %embedding, %hidden, %weight, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}

// One specialization exercises empty, single-row, small, aligned, and ragged
// cohorts. The same oracle also covers the small wave path in mtp.loom.
func.def @projection_geometry(%trial: index) -> (index, index) {
  %capacity = config.get @flash_next.token_count : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %tile = index.constant 128 : index
  %ragged = index.sub %capacity, %c2 : index
  %small = index.min %capacity, %c4 : index
  %aligned = index.min %capacity, %tile : index
  %empty_trial = index.cmp eq, %trial, %c0 : index
  %single_trial = index.cmp eq, %trial, %c1 : index
  %small_trial = index.cmp eq, %trial, %c2 : index
  %aligned_trial = index.cmp eq, %trial, %c3 : index
  %large = scf.select %aligned_trial, %aligned, %ragged : index
  %nontrivial = scf.select %small_trial, %small, %large : index
  %nonempty = scf.select %single_trial, %c1, %nontrivial : index
  %count = scf.select %empty_trial, %c0, %nonempty : index
  func.return %capacity, %count : index, index
}

func.def @projection_epoch(%count: index, %epoch: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %word = index.cast %count : index to i32
  view.store %word, %header[0] : i32, view<3xi32>
  func.return
}

check.scenario public @predictor_projection {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[5](%trial: index, %entropy: check.entropy) {
    %capacity, %count = check.generate<@projection_geometry>(%trial) : (index) -> (index, index)
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %epoch = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@projection_epoch>(%count, %epoch) : (index, tensor<3xi32>) -> ()
    %embedding = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<[%capacity]x2560xbf16>
    %hidden = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<[%capacity]x10240xbf16>
    %weight = check.generate.fill value(0) : tensor<13926400xi8>
    check.generate<@projection_fixture>(%weight) : (tensor<13926400xi8>) -> ()
    %output = check.generate.fill value(-17.0) : tensor<[%capacity]x4x2560xbf16>
    check.compare<@projection, @fusion_reference>(%epoch, %embedding, %hidden, %weight, %output) : (tensor<3xi32>, tensor<[%capacity]x2560xbf16>, tensor<[%capacity]x10240xbf16>, tensor<13926400xi8>, tensor<[%capacity]x4x2560xbf16>) -> () {
      // Native grouped dots can move an exact BF16 midpoint by an F32 ULP.
      // One BF16 step bounds the final publication. The absolute term covers
      // cancellation between the two independently rounded projections;
      // their smaller magnitude is bounded by the 37/64 embedding factor.
      check.expect.approximate actual(%output) expected(%output) atol(0.0078125) rtol(0.0078125) nan(different) : tensor<[%capacity]x4x2560xbf16>, tensor<[%capacity]x4x2560xbf16>
      check.expect.bitwise actual(%embedding) expected(%embedding) : tensor<[%capacity]x2560xbf16>
      check.expect.bitwise actual(%hidden) expected(%hidden) : tensor<[%capacity]x10240xbf16>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<13926400xi8>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<3xi32>
    }
  }
  check.return
}

check.benchmark<@predictor_projection> @predictor_projection_benchmark

// The first hidden coefficient is 37 * F16(0.01). Reconstructing it in
// F16 gives 0.3701171875. Against input 0.5 this rounds to BF16
// 0.185546875; applying the scale after the dot instead gives 0.1845703125.
func.def @hidden_rounding_weight(%weight: buffer) {
  %hidden_half = index.constant 2720 : offset
  %first_code = index.constant 2722 : offset
  %scale = buffer.view %weight[%hidden_half] : buffer -> view<1xf16>
  %code = buffer.view %weight[%first_code] : buffer -> view<1xi8>
  %scale_value = scalar.constant 0.01 : f16
  %code_value = scalar.constant 37 : i8
  view.store %scale_value, %scale[0] : f16, view<1xf16>
  view.store %code_value, %code[0] : i8, view<1xi8>
  func.return
}

func.def @hidden_rounding_reference(%epoch: buffer, %hidden: buffer, %weight: buffer, %embedding: buffer, %expected: buffer) {
  %origin = index.constant 0 : offset
  %outputs = buffer.view %expected[%origin] : buffer -> view<4x2560xbf16>
  %value = scalar.constant 0.185546875 : bf16
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  scf.for %stream = [%zero to %four step %one] {
    view.store %value, %outputs[%stream, 0] : bf16, view<4x2560xbf16>
  }
  func.return
}

check.scenario public @hidden_matrix_coefficient_rounding {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %single = check.literal value(1) : index
    %capacity, %count = check.generate<@projection_geometry>(%single) : (index) -> (index, index)
    %epoch = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@projection_epoch>(%count, %epoch) : (index, tensor<3xi32>) -> ()
    %weight = check.generate.fill value(0) : tensor<13926400xi8>
    %embedding = check.generate.fill value(0.0) : tensor<[%capacity]x2560xbf16>
    %hidden = check.generate.fill value(0.5) : tensor<[%capacity]x10240xbf16>
    %actual = check.generate.fill value(0.0) : tensor<[%capacity]x4x2560xbf16>
    check.generate<@hidden_rounding_weight>(%weight) : (tensor<13926400xi8>) -> ()
    %enabled = check.literal value(true) : i1
    check.compare<@flash_next_mtp_hidden_matrix, @hidden_rounding_reference>[%enabled](%epoch, %hidden, %weight, %embedding, %actual) : [i1](tensor<3xi32>, tensor<[%capacity]x10240xbf16>, tensor<13926400xi8>, tensor<[%capacity]x2560xbf16>, tensor<[%capacity]x4x2560xbf16>) -> () {
      check.expect.bitwise actual(%actual) expected(%actual) : tensor<[%capacity]x4x2560xbf16>
    }
  }
  check.return
}
