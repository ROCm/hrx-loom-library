// Cold preparation for the versioned text service. Named model and optional
// draft parameter scopes supply shared source handles; execution capacities
// select stages, allocation records, and retained-state layouts. The
// qwen38.draft_kind specialization chooses checkpoint MTP or DFlash2 without
// interpreting a filename.

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)

config.decl @qwen38.draft_kind : %value: i32 where [range(%value, 0, 1)]

global.rodata.def @model_scope = bytes("6d6f64656c")

global.rodata.def @draft_scope = bytes("6472616674")

// qwen38_prefill
global.rodata.def @prefill_root = bytes("7177656e33385f70726566696c6c")

// qwen38_text_decode_greedy
global.rodata.def @decode_root = bytes("7177656e33385f746578745f6465636f64655f677265656479")

// qwen38_epoch
global.rodata.def @epoch_root = bytes("7177656e33385f65706f6368")

// qwen38_mtp_propose
global.rodata.def @proposal_root = bytes("7177656e33385f6d74705f70726f706f7365")

// qwen38_mtp_warm
global.rodata.def @warm_root = bytes("7177656e33385f6d74705f7761726d")

// qwen38_verify
global.rodata.def @verify_root = bytes("7177656e33385f766572696679")

// qwen38_continue
global.rodata.def @continue_root = bytes("7177656e33385f636f6e74696e7565")

// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")

// <|im_end|>
global.rodata.def @terminal = bytes("3c7c696d5f656e647c3e")

// Empty path component.
global.rodata.def @empty = bytes("")

// Qwen token packets support at most 512 tokens per epoch.
global.rodata.def @token_capacity_error = bytes("5177656e20746f6b656e207061636b65747320737570706f7274206174206d6f73742035313220746f6b656e73207065722065706f6368")

// qwen38_dflash_propose
global.rodata.def @dflash_proposal_root = bytes("7177656e33385f64666c6173685f70726f706f7365")

// qwen38_dflash_warm
global.rodata.def @dflash_warm_root = bytes("7177656e33385f64666c6173685f7761726d")

// dflash_weights.loom
global.rodata.def @dflash_policy = bytes("64666c6173685f776569676874732e6c6f6f6d")

// runner.qwen38.capture_features
global.rodata.def @capture_key = bytes("72756e6e65722e7177656e33382e636170747572655f6665617475726573")

// runner.qwen38.verification_width
global.rodata.def @width_key = bytes("72756e6e65722e7177656e33382e766572696669636174696f6e5f7769647468")

// DFlash2 requires the complete seven-token proposal.
global.rodata.def @options_error = bytes("44466c617368322072657175697265732064726166745f646570746820736576656e")

func.def @check_options(%valid: i1) {
  %condition = scalar.extui %valid : i1 to i32
  %error = global.load @options_error : buffer
  func.call @require(%condition, %error) : (i32, buffer)
  func.return
}

// runner.qwen38.prefill_token_count
global.rodata.def @prefill_key = bytes("72756e6e65722e7177656e33382e70726566696c6c5f746f6b656e5f636f756e74")

// runner.qwen38.span_capacity
global.rodata.def @span_key = bytes("72756e6e65722e7177656e33382e7370616e5f6361706163697479")

// qwen38.attention.cache_capacity
global.rodata.def @context_key = bytes("7177656e33382e617474656e74696f6e2e63616368655f6361706163697479")

// qwen38.attention.pool_capacity
global.rodata.def @pool_key = bytes("7177656e33382e617474656e74696f6e2e706f6f6c5f6361706163697479")

// runner.qwen38.mixed_inputs
global.rodata.def @mixed_key = bytes("72756e6e65722e7177656e33382e6d697865645f696e70757473")

func.def @declare_stage(%root: buffer, %tokens: i64, %spans: i64, %context: i64, %pool: i64, %roots: i32, %mixed: i64, %model_source: i32) -> (i32) {
  %stage = func.call @stage(%root, %tokens) : (buffer, i64) -> (i32)
  %mixed_key = global.load @mixed_key : buffer
  func.call @config_i64(%stage, %mixed_key, %mixed) : (i32, buffer, i64)
  %prefill_key = global.load @prefill_key : buffer
  func.call @config_i64(%stage, %prefill_key, %tokens) : (i32, buffer, i64)
  %span_key = global.load @span_key : buffer
  func.call @config_i64(%stage, %span_key, %spans) : (i32, buffer, i64)
  %context_key = global.load @context_key : buffer
  func.call @config_i64(%stage, %context_key, %context) : (i32, buffer, i64)
  %pool_key = global.load @pool_key : buffer
  func.call @config_i64(%stage, %pool_key, %pool) : (i32, buffer, i64)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_roots = scalar.assume %roots [range(%roots, 0, 7)] : i32
  %root_count = index.cast %bounded_roots : i32 to index
  %source = scalar.constant 0 : i32
  %empty = global.load @empty : buffer
  %policy = global.load @policy : buffer
  scf.for %i = [%c0 to %root_count step %c1] {
    %binding = index.cast %i : index to i32
    func.call @parameter(%stage, %binding, %source, %model_source, %policy) : (i32, i32, i32, i32, buffer)
  }
  func.return %stage : i32
}

// Cold allocation records contain {bytes, alignment, initial_zero_bytes}.
// The materializer owns the allocations and their completion frontiers;
// model geometry and initialization extents belong to this source program.
func.def @allocation(%records: buffer, %slot: index, %bytes: i64, %clear: i64) {
  %origin = index.constant 0 : offset
  %bounded_slot = index.assume %slot [range(%slot, 0, 10)] : index
  %view = buffer.view %records[%origin] : buffer -> view<11x3xi64>
  %alignment = scalar.constant 256 : i64
  view.store %bytes, %view[%bounded_slot, 0] : i64, view<11x3xi64>
  view.store %alignment, %view[%bounded_slot, 1] : i64, view<11x3xi64>
  view.store %clear, %view[%bounded_slot, 2] : i64, view<11x3xi64>
  func.return
}

// Private arena views are {byte_offset, byte_length}, in control/attention/
// input/progress order. Recurrent slots have an independent geometry record.
func.def @row_view(%records: buffer, %row_count: index, %row: index, %slot: index, %offset: i64, %length: i64) {
  %origin = index.constant 0 : offset
  %bounded_row = index.assume %row [range(%row, 0, 15), lt(%row, %row_count)] : index
  %bounded_slot = index.assume %slot [range(%slot, 0, 3)] : index
  %view = buffer.view %records[%origin] : buffer -> view<[%row_count]x4x2xi64>
  view.store %offset, %view[%bounded_row, %bounded_slot, 0] : i64, view<[%row_count]x4x2xi64>
  view.store %length, %view[%bounded_row, %bounded_slot, 1] : i64, view<[%row_count]x4x2xi64>
  func.return
}

func.def @storage(%context: i64, %pool: i64, %rows: i64, %pins: i64, %packed: i1, %enabled: i1, %dflash: i1) -> (buffer, buffer, buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %zero64 = scalar.constant 0 : i64
  %word_bytes = scalar.constant 4 : i64
  %c63 = scalar.constant 63 : i64
  %block_tokens = scalar.constant 64 : i64
  %map_origin = scalar.constant 2048 : i64
  %origin_bytes = scalar.constant 512 : i64
  %target_token_bytes = scalar.constant 65536 : i64
  %mtp_token_bytes = scalar.constant 4096 : i64
  %dflash_token_bytes = scalar.constant 20480 : i64
  %draft_token_bytes = scf.select %dflash, %dflash_token_bytes, %mtp_token_bytes : i64
  %false = scalar.constant false : i1
  %no_dflash = scalar.cmpi eq, %dflash, %false : i1
  %mtp = scalar.andi %enabled, %no_dflash : i1
  %hidden_stride = scalar.constant 20480 : i64
  %carry_stride = scf.select %mtp, %hidden_stride, %zero64 : i64
  %target_residual_bytes = scalar.constant 10485760 : i64
  %feature_residual_bytes = scalar.constant 62914560 : i64
  %residual_bytes = scf.select %dflash, %feature_residual_bytes, %target_residual_bytes : i64
  %control_bytes = scalar.constant 12 : i64
  %gdn_bytes = scalar.constant 156893184 : i64
  %gdn_offset = scalar.constant 256 : i64
  %attention_offset = scalar.addi %gdn_offset, %gdn_bytes : i64
  %token_bytes = scalar.constant 2048 : i64
  %cohort_token_bytes = scalar.constant 4096 : i64
  %progress_bytes = scalar.constant 32 : i64
  %progress_extent = scalar.constant 256 : i64
  %metadata_bytes = scalar.constant 6128 : i64
  %committed_bytes = scalar.constant 1548 : i64
  %output_bytes = scalar.constant 64 : i64
  %result_bytes = scalar.constant 1344 : i64
  %pooled = scalar.cmpi ne, %pool, %zero64 : i64
  %dense_attention_bytes = scalar.muli %context, %target_token_bytes : i64
  %attention_bytes = scf.select %pooled, %zero64, %dense_attention_bytes : i64
  %tokens_offset = scalar.addi %attention_offset, %attention_bytes : i64
  %progress_offset = scalar.addi %tokens_offset, %token_bytes : i64
  %row_stride = scalar.addi %progress_offset, %progress_extent : i64
  %pinned = scalar.cmpi ne, %pins, %zero64 : i64
  %owners = scalar.addi %rows, %pins : i64
  %fork_slots = scalar.addi %owners, %rows : i64
  %state_slots = scf.select %pinned, %fork_slots, %rows : i64
  %row_bytes = scalar.muli %row_stride, %state_slots : i64
  %pool_bytes = scalar.muli %pool, %target_token_bytes : i64
  %arena_bytes = scalar.addi %row_bytes, %pool_bytes : i64
  %padded_context = scalar.addi %context, %c63 : i64
  %blocks_per_row = scalar.divui %padded_context, %block_tokens : i64
  %map_entries = scalar.muli %blocks_per_row, %rows : i64
  %map_bytes = scalar.muli %map_entries, %word_bytes : i64
  %pooled_table_bytes = scalar.addi %map_origin, %map_bytes : i64
  %table_bytes = scf.select %pooled, %pooled_table_bytes, %origin_bytes : i64
  %carry_bytes = scalar.muli %carry_stride, %owners : i64
  %draft_row_bytes = scalar.muli %context, %draft_token_bytes : i64
  %dense_draft_bytes = scalar.muli %rows, %draft_row_bytes : i64
  %pooled_draft_bytes = scalar.muli %pool, %draft_token_bytes : i64
  %draft_bytes = scf.select %pooled, %pooled_draft_bytes, %dense_draft_bytes : i64
  %allocation_bytes = index.constant 264 : offset
  %allocations = buffer.alloca<private> align(8) %allocation_bytes : buffer
  func.call @allocation(%allocations, %c0, %residual_bytes, %residual_bytes) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c1, %arena_bytes, %row_bytes) : (buffer, index, i64, i64)
  %packed_metadata = scf.select %packed, %metadata_bytes, %zero64 : i64
  %packed_table = scf.select %packed, %table_bytes, %zero64 : i64
  %packed_tokens = scf.select %packed, %cohort_token_bytes, %zero64 : i64
  %packed_outputs = scf.select %packed, %output_bytes, %zero64 : i64
  func.call @allocation(%allocations, %c2, %packed_metadata, %zero64) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c3, %packed_table, %zero64) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c4, %packed_tokens, %zero64) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c5, %packed_outputs, %zero64) : (buffer, index, i64, i64)
  %mtp_carry = scf.select %mtp, %carry_bytes, %zero64 : i64
  %draft_committed = scf.select %enabled, %committed_bytes, %zero64 : i64
  %draft_results = scf.select %enabled, %result_bytes, %zero64 : i64
  %draft_cache = scf.select %enabled, %draft_bytes, %zero64 : i64
  %draft_table = scf.select %enabled, %table_bytes, %zero64 : i64
  func.call @allocation(%allocations, %c6, %mtp_carry, %mtp_carry) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c7, %draft_committed, %zero64) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c8, %draft_results, %zero64) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c9, %draft_cache, %zero64) : (buffer, index, i64, i64)
  func.call @allocation(%allocations, %c10, %draft_table, %zero64) : (buffer, index, i64, i64)
  %bounded_rows = scalar.assume %rows [range(%rows, 1, 16)] : i64
  %row_count = index.cast %bounded_rows : i64 to index
  %view_stride = index.constant 64 : offset
  %view_bytes = index.scale %row_count, %view_stride : index, offset -> offset
  %views = buffer.alloca<private> align(8) %view_bytes : buffer
  %table_payload_bytes = index.constant 512 : offset
  %target_origins = buffer.alloca<private> align(8) %table_payload_bytes : buffer
  %draft_origins = buffer.alloca<private> align(8) %table_payload_bytes : buffer
  %target = buffer.view %target_origins[%origin] : buffer -> view<16x4xi64>
  %draft = buffer.view %draft_origins[%origin] : buffer -> view<16x4xi64>
  %origin_capacity = index.constant 16 : index
  scf.for %i = [%c0 to %origin_capacity step %c1] {
    view.store %zero64, %target[%i, 0] : i64, view<16x4xi64>
    view.store %zero64, %target[%i, 1] : i64, view<16x4xi64>
    view.store %zero64, %target[%i, 2] : i64, view<16x4xi64>
    view.store %zero64, %target[%i, 3] : i64, view<16x4xi64>
    view.store %zero64, %draft[%i, 0] : i64, view<16x4xi64>
    view.store %zero64, %draft[%i, 1] : i64, view<16x4xi64>
    view.store %zero64, %draft[%i, 2] : i64, view<16x4xi64>
    view.store %zero64, %draft[%i, 3] : i64, view<16x4xi64>
  }
  scf.for %i = [%c0 to %row_count step %c1] {
    %row = index.cast %i : index to i64
    %base = scalar.muli %row, %row_stride : i64
    %gdn_base = scalar.addi %base, %gdn_offset : i64
    %attention_base = scalar.addi %base, %attention_offset : i64
    %tokens_base = scalar.addi %base, %tokens_offset : i64
    %progress_base = scalar.addi %base, %progress_offset : i64
    func.call @row_view(%views, %row_count, %i, %c0, %base, %control_bytes) : (buffer, index, index, index, i64, i64)
    func.call @row_view(%views, %row_count, %i, %c1, %attention_base, %attention_bytes) : (buffer, index, index, index, i64, i64)
    func.call @row_view(%views, %row_count, %i, %c2, %tokens_base, %token_bytes) : (buffer, index, index, index, i64, i64)
    func.call @row_view(%views, %row_count, %i, %c3, %progress_base, %progress_bytes) : (buffer, index, index, index, i64, i64)
    %kv_base = scf.select %pooled, %row_bytes, %attention_base : i64
    view.store %gdn_base, %target[%i, 0] : i64, view<16x4xi64>
    view.store %gdn_base, %target[%i, 1] : i64, view<16x4xi64>
    view.store %kv_base, %target[%i, 2] : i64, view<16x4xi64>
    %dense_draft_base = scalar.muli %row, %draft_row_bytes : i64
    %draft_base = scf.select %pooled, %zero64, %dense_draft_base : i64
    view.store %draft_base, %draft[%i, 2] : i64, view<16x4xi64>
  }
  // Cache regions are {allocation, origin, plane_count, plane_stride,
  // block_bytes}. Model geometry stays here; physical slabs may cut across
  // logical block boundaries and are chosen by the live allocator.
  %header_bytes = index.constant 64 : offset
  %target_geometry_bytes = index.constant 104 : offset
  %draft_geometry_bytes = index.constant 144 : offset
  %pooled_geometry_bytes = scf.select %enabled, %draft_geometry_bytes, %target_geometry_bytes : offset
  %geometry_bytes = scf.select %pooled, %pooled_geometry_bytes, %header_bytes : offset
  %geometry = buffer.alloca<private> align(8) %geometry_bytes : buffer
  %geometry_view = buffer.view %geometry[%origin] : buffer -> view<8xi64>
  view.store %block_tokens, %geometry_view[0] : i64, view<8xi64>
  view.store %map_origin, %geometry_view[1] : i64, view<8xi64>
  view.store %carry_stride, %geometry_view[2] : i64, view<8xi64>
  %feedback_split = scalar.constant 640 : i64
  view.store %feedback_split, %geometry_view[3] : i64, view<8xi64>
  view.store %gdn_offset, %geometry_view[4] : i64, view<8xi64>
  view.store %row_stride, %geometry_view[5] : i64, view<8xi64>
  view.store %gdn_bytes, %geometry_view[6] : i64, view<8xi64>
  view.store %state_slots, %geometry_view[7] : i64, view<8xi64>
  scf.if %pooled {
    %regions = buffer.view %geometry[%header_bytes] : buffer -> view<5xi64>
    %one64 = scalar.constant 1 : i64
    %nine64 = scalar.constant 9 : i64
    %target_planes = scalar.constant 32 : i64
    %mtp_planes = scalar.constant 2 : i64
    %dflash_planes = scalar.constant 10 : i64
    %draft_planes = scf.select %dflash, %dflash_planes, %mtp_planes : i64
    %plane_token_bytes = scalar.constant 2048 : i64
    %plane_stride = scalar.muli %pool, %plane_token_bytes : i64
    %block_bytes = scalar.constant 131072 : i64
    view.store %one64, %regions[0] : i64, view<5xi64>
    view.store %row_bytes, %regions[1] : i64, view<5xi64>
    view.store %target_planes, %regions[2] : i64, view<5xi64>
    view.store %plane_stride, %regions[3] : i64, view<5xi64>
    view.store %block_bytes, %regions[4] : i64, view<5xi64>
    scf.if %enabled {
      %draft_regions = buffer.view %geometry[%target_geometry_bytes] : buffer -> view<5xi64>
      view.store %nine64, %draft_regions[0] : i64, view<5xi64>
      view.store %zero64, %draft_regions[1] : i64, view<5xi64>
      view.store %draft_planes, %draft_regions[2] : i64, view<5xi64>
      view.store %plane_stride, %draft_regions[3] : i64, view<5xi64>
      view.store %block_bytes, %draft_regions[4] : i64, view<5xi64>
    }
  }
  func.return %allocations, %views, %target_origins, %draft_origins, %geometry : buffer, buffer, buffer, buffer, buffer
}

// Ordinary and mixed input catalogs differ only in their input specialization.
// Their immutable parameter domains remain identical and are shared by the
// materializer; mixed records never create a second checkpoint allocation.
func.def @declare_packed_stages(%shapes: buffer, %shape_count: i64, %context: i64, %pool: i64, %rows: i64, %model_source: i32, %draft_source: i32, %enabled: i1, %dflash: i1, %width: i64, %mixed: i64) -> (i32, i32, i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %three32 = scalar.constant 3 : i32
  %seven32 = scalar.constant 7 : i32
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %capacity = scalar.constant 512 : i64
  %bounded = scalar.assume %shape_count [range(%shape_count, 0, 2147483647)] : i64
  %count = index.cast %bounded : i64 to index
  %view = buffer.view %shapes[%origin] : buffer -> view<[%count]x2xi64>
  %capacity_error = global.load @token_capacity_error : buffer
  %epoch_root = global.load @epoch_root : buffer
  %maximum, %target_first = scf.for %i = [%c0 to %count step %c1](%previous = %zero64 : i64, %first_stage = %zero32 : i32) -> (i64, i32) {
    %tokens = view.load %view[%i, 0] : view<[%count]x2xi64> -> i64
    %spans = view.load %view[%i, 1] : view<[%count]x2xi64> -> i64
    %fits = scalar.cmpi ule, %tokens, %capacity : i64
    %fits32 = scalar.extui %fits : i1 to i32
    func.call @require(%fits32, %capacity_error) : (i32, buffer)
    // Packed projection arguments describe the shared activation workspace;
    // the epoch shape independently bounds the dispatched token grid.
    %target = func.call @declare_stage(%epoch_root, %tokens, %spans, %context, %pool, %one32, %mixed, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
    scf.if %dflash {
      %capture_key = global.load @capture_key : buffer
      func.call @config_i64(%target, %capture_key, %one64) : (i32, buffer, i64)
    }
    %larger = scalar.cmpi ugt, %tokens, %previous : i64
    %next = scf.select %larger, %tokens, %previous : i64
    %first_shape = index.cmp eq, %i, %c0 : index
    %first = scf.select %first_shape, %target, %first_stage : i32
    scf.yield %next, %first : i64, i32
  }
  %proposal_stage = scf.if %enabled -> (i32) {
    %mtp_proposal_root = global.load @proposal_root : buffer
    %dflash_proposal_root = global.load @dflash_proposal_root : buffer
    %mtp_warm_root = global.load @warm_root : buffer
    %dflash_warm_root = global.load @dflash_warm_root : buffer
    %proposal_root = scf.select %dflash, %dflash_proposal_root, %mtp_proposal_root : buffer
    %warm_root = scf.select %dflash, %dflash_warm_root, %mtp_warm_root : buffer
    %verify_root = global.load @verify_root : buffer
    %proposal_tokens = scalar.constant 32 : i64
    %two32 = scalar.constant 2 : i32
    %five32 = scalar.constant 5 : i32
    %proposal_roots = scf.select %dflash, %two32, %five32 : i32
    %warm_roots = scf.select %dflash, %zero32, %seven32 : i32
    %empty = global.load @empty : buffer
    %dflash_policy = global.load @dflash_policy : buffer
    %proposal = func.call @declare_stage(%proposal_root, %proposal_tokens, %rows, %context, %pool, %proposal_roots, %mixed, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
    %width_key = global.load @width_key : buffer
    func.call @config_i64(%proposal, %width_key, %width) : (i32, buffer, i64)
    scf.if %dflash {
      func.call @parameter(%proposal, %two32, %zero32, %draft_source, %dflash_policy) : (i32, i32, i32, i32, buffer)
      func.call @parameter(%proposal, %three32, %zero32, %draft_source, %dflash_policy) : (i32, i32, i32, i32, buffer)
    }
    scf.for %i = [%c0 to %count step %c1] {
      %tokens = view.load %view[%i, 0] : view<[%count]x2xi64> -> i64
      %spans = view.load %view[%i, 1] : view<[%count]x2xi64> -> i64
      %warm = func.call @declare_stage(%warm_root, %tokens, %spans, %context, %pool, %warm_roots, %mixed, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
      scf.if %dflash {
        func.call @parameter(%warm, %zero32, %zero32, %draft_source, %dflash_policy) : (i32, i32, i32, i32, buffer)
        func.call @parameter(%warm, %one32, %zero32, %draft_source, %dflash_policy) : (i32, i32, i32, i32, buffer)
      }
    }
    scf.for %i = [%c0 to %count step %c1] {
      %tokens = view.load %view[%i, 0] : view<[%count]x2xi64> -> i64
      %spans = view.load %view[%i, 1] : view<[%count]x2xi64> -> i64
      %verify = func.call @declare_stage(%verify_root, %tokens, %spans, %context, %pool, %one32, %mixed, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
      func.call @config_i64(%verify, %width_key, %width) : (i32, buffer, i64)
      scf.if %dflash {
        %capture_key = global.load @capture_key : buffer
        func.call @config_i64(%verify, %capture_key, %one64) : (i32, buffer, i64)
      }
    }
    %continue_root = global.load @continue_root : buffer
    %continuation = func.call @declare_stage(%continue_root, %one64, %rows, %context, %pool, %zero32, %mixed, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
    scf.yield %proposal : i32
  } else {
    scf.yield %zero32 : i32
  }
  func.return %target_first, %proposal_stage, %maximum : i32, i32, i64
}

// The caller supplies validated native payload capacities. Shape pairs are
// little-endian i64 {tokens, spans}; no C struct layout crosses this boundary.
// Commands, specialization and their shared checkpoint identity are source
// policy. Returned state is interpreted only by control.loom.
func.def public @text_prepare_v1(%prefill: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %draft_depth: i32, %shapes: buffer, %shape_count: i64, %weights: buffer, %options: buffer) -> (i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %seven32 = scalar.constant 7 : i32
  %model_scope = global.load @model_scope : buffer
  %model_source = func.call @source_scope(%model_scope) : (buffer) -> (i32)
  %draft_kind = config.get @qwen38.draft_kind : i32
  %dflash = scalar.cmpi eq, %draft_kind, %one32 : i32
  %checkpoint_draft = scalar.cmpi eq, %draft_kind, %zero32 : i32
  %draft_source = scf.if %dflash -> (i32) {
    %draft_scope = global.load @draft_scope : buffer
    %source = func.call @source_scope(%draft_scope) : (buffer) -> (i32)
    scf.yield %source : i32
  } else {
    scf.yield %zero32 : i32
  }
  %dflash_depth = scalar.cmpi eq, %draft_depth, %seven32 : i32
  %right_options = scalar.ori %checkpoint_draft, %dflash_depth : i1
  func.call @check_options(%right_options) : (i1)
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %depth64 = scalar.extui %draft_depth : i32 to i64
  %width = scalar.addi %depth64, %one64 : i64
  %capacity = scalar.constant 512 : i64
  %prefill_fits = scalar.cmpi ule, %prefill, %capacity : i64
  %prefill_fits32 = scalar.extui %prefill_fits : i1 to i32
  %capacity_error = global.load @token_capacity_error : buffer
  func.call @require(%prefill_fits32, %capacity_error) : (i32, buffer)
  %prefill_root = global.load @prefill_root : buffer
  %decode_root = global.load @decode_root : buffer
  %prefill_stage = func.call @declare_stage(%prefill_root, %prefill, %rows, %context, %pool, %one32, %zero64, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
  %decode_stage = func.call @declare_stage(%decode_root, %prefill, %rows, %context, %pool, %one32, %zero64, %model_source) : (buffer, i64, i64, i64, i64, i32, i64, i32) -> (i32)
  %enabled = scalar.cmpi ne, %draft_depth, %zero32 : i32
  %target_first, %proposal_stage, %maximum = func.call @declare_packed_stages(%shapes, %shape_count, %context, %pool, %rows, %model_source, %draft_source, %enabled, %dflash, %width, %zero64) : (buffer, i64, i64, i64, i64, i32, i32, i1, i1, i64, i64) -> (i32, i32, i64)
  %mixed_target_first, %mixed_proposal_stage, %mixed_maximum = func.call @declare_packed_stages(%shapes, %shape_count, %context, %pool, %rows, %model_source, %draft_source, %enabled, %dflash, %width, %one64) : (buffer, i64, i64, i64, i64, i32, i32, i1, i1, i64, i64) -> (i32, i32, i64)
  %pooled = scalar.cmpi ne, %pool, %zero64 : i64
  %uses_packed = scalar.ori %pooled, %enabled : i1
  %smaller = scalar.cmpi ult, %maximum, %prefill : i64
  %packed_capacity = scf.select %smaller, %maximum, %prefill : i64
  %effective_prefill = scf.select %uses_packed, %packed_capacity, %prefill : i64
  %two64 = scalar.constant 2 : i64
  %shared64 = scalar.addi %shape_count, %two64 : i64
  %shared = scalar.trunci %shared64 : i64 to i32
  %resident_count = index.cast %rows : i64 to index
  %policy_stride = index.constant 24 : offset
  %policy_bytes = index.scale %resident_count, %policy_stride : index, offset -> offset
  %control_overhead = index.constant 592 : offset
  %state_bytes = index.add %control_overhead, %policy_bytes : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  buffer.fill %zero32, %state[%origin], %state_bytes : i32
  %state_view = buffer.view %state[%origin] : buffer -> view<8xi32>
  %count32 = scalar.trunci %shape_count : i64 to i32
  view.store %prefill_stage, %state_view[0] : i32, view<8xi32>
  view.store %decode_stage, %state_view[1] : i32, view<8xi32>
  view.store %count32, %state_view[2] : i32, view<8xi32>
  view.store %proposal_stage, %state_view[3] : i32, view<8xi32>
  %dflash32 = scalar.extui %dflash : i1 to i32
  view.store %dflash32, %state_view[4] : i32, view<8xi32>
  view.store %target_first, %state_view[5] : i32, view<8xi32>
  view.store %mixed_target_first, %state_view[6] : i32, view<8xi32>
  view.store %mixed_proposal_stage, %state_view[7] : i32, view<8xi32>
  %terminal = global.load @terminal : buffer
  %packed = scalar.cmpi ne, %shape_count, %zero64 : i64
  %allocations, %views, %target_origins, %draft_origins, %geometry = func.call @storage(%context, %pool, %rows, %pins, %packed, %enabled, %dflash) : (i64, i64, i64, i64, i1, i1, i1) -> (buffer, buffer, buffer, buffer, buffer)
  func.return %effective_prefill, %shared, %state, %terminal, %allocations, %views, %target_origins, %draft_origins, %geometry : i64, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer
}
