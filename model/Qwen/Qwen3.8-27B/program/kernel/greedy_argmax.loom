// Finite-logit greedy selection with the lowest token ID winning ties.
// Single-row and two-stage tiled reductions retain logits and intermediate
// winners on the device. The tiled publication includes row stride and
// prepared vocabulary capacity explicitly. Workgroup collectives select their
// subgroup decomposition from the inherited execution target.

template.decl @qwen38.greedy_argmax_f32.reduce(%output_capacity: index, %token_count0: index, %output_size: index, %partial_logits: buffer, %partial_token_ids: buffer, %token_ids: buffer)

template.decl @qwen38.greedy_argmax_f32.row(%row_count0: index, %row0: index, %output_size0: index, %workitem0: index, %logits: buffer, %token_ids: buffer)

template.decl @qwen38.greedy_argmax_f32.partial(%token_count: index, %logit_stride: index, %output_size: index, %excluded_id: i32, %logits: buffer, %partial_logits: buffer, %partial_token_ids: buffer)

// Prepared vocabulary capacity supplied by the model composition.
config.decl @qwen38.greedy_argmax.output_capacity : %value: index where [range(%value, 256, 262144)]

// Selects one row. Single-row decode and batched target verification share
// this exact reduction so tie-breaking cannot drift between generation modes.
template.def<@qwen38.greedy_argmax_f32.row> device @qwen38_greedy_argmax_f32_row(%row_count0: index, %row0: index, %output_size0: index, %workitem0: index, %logits: buffer, %token_ids: buffer) {
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 512)] : index
  %row = index.assume %row0 [lt(%row0, %row_count)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 256, 262144)] : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255), lt(%workitem0, %output_size)] : index
  %c0 = index.constant 0 : index
  %workgroup_size = index.constant 256 : index
  %largest_i32 = scalar.constant 2147483647 : i32
  %c0_offset = index.constant 0 : offset
  %logits_noalias, %token_ids_noalias = buffer.assume.noalias %logits, %token_ids : buffer, buffer
  %logits_view = buffer.view %logits_noalias[%c0_offset] : buffer -> view<[%row_count]x[%output_size]xf32>
  %token_ids_view = buffer.view %token_ids_noalias[%c0_offset] : buffer -> view<[%row_count]xi32>
  %initial_logit = view.load %logits_view[%row, %workitem] : view<[%row_count]x[%output_size]xf32> -> f32
  %initial_id = index.cast %workitem : index to i32
  %scan_begin = index.add %workitem, %workgroup_size : index
  %local_logit, %local_id = scf.for %candidate = [%scan_begin to %output_size step %workgroup_size](%best_logit = %initial_logit : f32, %best_id = %initial_id : i32) -> (f32, i32) {
    %candidate_logit = view.load %logits_view[%row, %candidate] : view<[%row_count]x[%output_size]xf32> -> f32
    %candidate_id = index.cast %candidate : index to i32
    %is_greater = scalar.cmpf ogt, %candidate_logit, %best_logit : f32
    %is_equal = scalar.cmpf oeq, %candidate_logit, %best_logit : f32
    %is_lower_id = scalar.cmpi slt, %candidate_id, %best_id : i32
    %is_lower_tie = scalar.andi %is_equal, %is_lower_id : i1
    %is_better = scalar.ori %is_greater, %is_lower_tie : i1
    %next_logit = scf.select %is_better, %candidate_logit, %best_logit : f32
    %next_id = scf.select %is_better, %candidate_id, %best_id : i32
    scf.yield %next_logit, %next_id : f32, i32
  }
  %winning_logit = kernel.workgroup.reduce<maxnumf> %local_logit : f32
  %owns_winning_logit = scalar.cmpf oeq, %local_logit, %winning_logit : f32
  %candidate_winning_id = scf.select %owns_winning_logit, %local_id, %largest_i32 : i32
  %winning_id = kernel.workgroup.reduce<minsi> %candidate_winning_id : i32
  %publishes_token = index.cmp eq, %workitem, %c0 : index
  scf.if %publishes_token {
    view.store %winning_id, %token_ids_view[%row] : i32, view<[%row_count]xi32>
  }
  template.return
}

kernel.def export("qwen38_greedy_argmax_f32") @qwen38_greedy_argmax_f32(%output_size: index) {
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%output_size: index, %logits: buffer, %token_id: buffer) {
  %output_capacity = config.get @qwen38.greedy_argmax.output_capacity : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 256, 262144), le(%output_size, %output_capacity)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %workitem = kernel.workitem.id<x> : index
  template.apply<@qwen38.greedy_argmax_f32.row>(%c1, %c0, %bounded_output_size, %workitem, %logits, %token_id) : (index, index, index, index, buffer, buffer)
  kernel.return
}

kernel.def export("qwen38_greedy_argmax_rows_f32") @qwen38_greedy_argmax_rows_f32(%token_count0: index, %output_size: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count0: index, %output_size: index, %logits: buffer, %token_ids: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %output_capacity = config.get @qwen38.greedy_argmax.output_capacity : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 256, 262144), le(%output_size, %output_capacity)] : index
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [lt(%row0, %token_count)] : index
  %workitem = kernel.workitem.id<x> : index
  template.apply<@qwen38.greedy_argmax_f32.row>(%token_count, %row, %bounded_output_size, %workitem, %logits, %token_ids) : (index, index, index, index, buffer, buffer)
  kernel.return
}

// First stage of the parallel vocabulary reduction. Each workgroup owns one
// contiguous 4096-logit tile and publishes its greatest logit and lowest tied
// token ID. Rows remain independent in the workgroup Y dimension.
kernel.def export("qwen38_greedy_argmax_partial_rows_f32") @qwen38_greedy_argmax_partial_rows_f32(%token_count0: index, %logit_stride: index, %output_size: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %c4095 = index.constant 4095 : index
  %c4096 = index.constant 4096 : index
  %padded_output_size = index.add %output_size, %c4095 : index
  %partial_count = index.div %padded_output_size, %c4096 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%partial_count, %token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count0: index, %logit_stride: index, %output_size: index, %logits: buffer, %partial_logits: buffer, %partial_token_ids: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %output_capacity = config.get @qwen38.greedy_argmax.output_capacity : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 256, 262144), le(%output_size, %output_capacity)] : index
  %none = scalar.constant -1 : i32
  template.apply<@qwen38.greedy_argmax_f32.partial>(%token_count, %logit_stride, %bounded_output_size, %none, %logits, %partial_logits, %partial_token_ids) : (index, index, index, i32, buffer, buffer, buffer)
  kernel.return
}

// Each workgroup owns a disjoint vocabulary tile. Exclusion happens before
// the first reduction, so the next legal winner remains available to sampling.
// Physical row stride may exceed the logical vocabulary; padding never competes.
template.def<@qwen38.greedy_argmax_f32.partial> device @qwen38_greedy_argmax_f32_partial(%token_count0: index, %logit_stride0: index, %output_size: index, %excluded_id: i32, %logits: buffer, %partial_logits: buffer, %partial_token_ids: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %logit_stride = index.assume %logit_stride0 [range(%logit_stride0, 256, 262144)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 256, 262144), le(%output_size, %logit_stride)] : index
  %c0 = index.constant 0 : index
  %c4095 = index.constant 4095 : index
  %c4096 = index.constant 4096 : index
  %workgroup_size = index.constant 256 : index
  %largest_i32 = scalar.constant 2147483647 : i32
  %negative_large = scalar.constant -3.4028234663852886e+38 : f32
  %c0_offset = index.constant 0 : offset
  %row0 = kernel.workgroup.id<y> : index
  %row = index.assume %row0 [lt(%row0, %token_count)] : index
  %partial0 = kernel.workgroup.id<x> : index
  %padded_output_size = index.add %bounded_output_size, %c4095 : index
  %partial_count = index.div %padded_output_size, %c4096 : index
  %partial = index.assume %partial0 [lt(%partial0, %partial_count)] : index
  %workitem = kernel.workitem.id<x> : index
  %tile_begin = index.mul %partial, %c4096 : index
  %tile_end0 = index.add %tile_begin, %c4096 : index
  %tile_end = index.min %tile_end0, %bounded_output_size : index
  %candidate0 = index.add %tile_begin, %workitem : index
  %has_initial = index.cmp ult, %candidate0, %tile_end : index
  %initial_logit, %initial_id = scf.if %has_initial -> (f32, i32) {
    %initial_candidate = index.assume %candidate0 [lt(%candidate0, %bounded_output_size), lt(%candidate0, %logit_stride)] : index
    %logits_view = buffer.view %logits[%c0_offset] : buffer -> view<[%token_count]x[%logit_stride]xf32>
    %value = view.load %logits_view[%row, %initial_candidate] : view<[%token_count]x[%logit_stride]xf32> -> f32
    %id = index.cast %initial_candidate : index to i32
    %permitted = scalar.cmpi ne, %id, %excluded_id : i32
    %eligible_value = scf.select %permitted, %value, %negative_large : f32
    %eligible_id = scf.select %permitted, %id, %largest_i32 : i32
    scf.yield %eligible_value, %eligible_id : f32, i32
  } else {
    scf.yield %negative_large, %largest_i32 : f32, i32
  }
  %scan_begin = index.add %candidate0, %workgroup_size : index
  %local_logit, %local_id = scf.for %candidate = [%scan_begin to %tile_end step %workgroup_size](%best_logit = %initial_logit : f32, %best_id = %initial_id : i32) -> (f32, i32) {
    %bounded_candidate = index.assume %candidate [lt(%candidate, %bounded_output_size), lt(%candidate, %logit_stride)] : index
    %logits_view = buffer.view %logits[%c0_offset] : buffer -> view<[%token_count]x[%logit_stride]xf32>
    %value = view.load %logits_view[%row, %bounded_candidate] : view<[%token_count]x[%logit_stride]xf32> -> f32
    %id = index.cast %bounded_candidate : index to i32
    %permitted = scalar.cmpi ne, %id, %excluded_id : i32
    %candidate_logit = scf.select %permitted, %value, %negative_large : f32
    %candidate_id = scf.select %permitted, %id, %largest_i32 : i32
    %is_greater = scalar.cmpf ogt, %candidate_logit, %best_logit : f32
    %is_equal = scalar.cmpf oeq, %candidate_logit, %best_logit : f32
    %is_lower_id = scalar.cmpi slt, %candidate_id, %best_id : i32
    %is_lower_tie = scalar.andi %is_equal, %is_lower_id : i1
    %is_better = scalar.ori %is_greater, %is_lower_tie : i1
    %next_logit = scf.select %is_better, %candidate_logit, %best_logit : f32
    %next_id = scf.select %is_better, %candidate_id, %best_id : i32
    scf.yield %next_logit, %next_id : f32, i32
  }
  %winning_logit = kernel.workgroup.reduce<maxnumf> %local_logit : f32
  %owns_winning_logit = scalar.cmpf oeq, %local_logit, %winning_logit : f32
  %candidate_winning_id = scf.select %owns_winning_logit, %local_id, %largest_i32 : i32
  %winning_id = kernel.workgroup.reduce<minsi> %candidate_winning_id : i32
  %publishes_partial = index.cmp eq, %workitem, %c0 : index
  scf.if %publishes_partial {
    %partial_logits_view = buffer.view %partial_logits[%c0_offset] : buffer -> view<[%token_count]x[%partial_count]xf32>
    %partial_token_ids_view = buffer.view %partial_token_ids[%c0_offset] : buffer -> view<[%token_count]x[%partial_count]xi32>
    view.store %winning_logit, %partial_logits_view[%row, %partial] : f32, view<[%token_count]x[%partial_count]xf32>
    view.store %winning_id, %partial_token_ids_view[%row, %partial] : i32, view<[%token_count]x[%partial_count]xi32>
  }
  template.return
}

// Reduces the tile winners produced by qwen38_greedy_argmax_partial_rows_f32.
kernel.def export("qwen38_greedy_argmax_reduce_rows_f32") @qwen38_greedy_argmax_reduce_rows_f32(%token_count0: index, %output_size: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count0: index, %output_size: index, %partial_logits: buffer, %partial_token_ids: buffer, %token_ids: buffer) {
  %output_capacity = config.get @qwen38.greedy_argmax.output_capacity : index
  template.apply<@qwen38.greedy_argmax_f32.reduce>(%output_capacity, %token_count0, %output_size, %partial_logits, %partial_token_ids, %token_ids) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

template.def<@qwen38.greedy_argmax_f32.reduce> device @qwen38_greedy_argmax_f32_reduce(%output_capacity: index, %token_count0: index, %output_size: index, %partial_logits: buffer, %partial_token_ids: buffer, %token_ids: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 256, 262144), le(%output_size, %output_capacity)] : index
  %c0 = index.constant 0 : index
  %c4095 = index.constant 4095 : index
  %c4096 = index.constant 4096 : index
  %largest_i32 = scalar.constant 2147483647 : i32
  %negative_large = scalar.constant -3.4028234663852886e+38 : f32
  %c0_offset = index.constant 0 : offset
  %padded_output_size = index.add %bounded_output_size, %c4095 : index
  %partial_count = index.div %padded_output_size, %c4096 : index
  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [lt(%row0, %token_count)] : index
  %workitem = kernel.workitem.id<x> : index
  %has_initial = index.cmp ult, %workitem, %partial_count : index
  %initial_logit, %initial_id = scf.if %has_initial -> (f32, i32) {
    %partial_logits_view = buffer.view %partial_logits[%c0_offset] : buffer -> view<[%token_count]x[%partial_count]xf32>
    %partial_token_ids_view = buffer.view %partial_token_ids[%c0_offset] : buffer -> view<[%token_count]x[%partial_count]xi32>
    %logit = view.load %partial_logits_view[%row, %workitem] : view<[%token_count]x[%partial_count]xf32> -> f32
    %id = view.load %partial_token_ids_view[%row, %workitem] : view<[%token_count]x[%partial_count]xi32> -> i32
    scf.yield %logit, %id : f32, i32
  } else {
    scf.yield %negative_large, %largest_i32 : f32, i32
  }
  %winning_logit = kernel.workgroup.reduce<maxnumf> %initial_logit : f32
  %owns_winning_logit = scalar.cmpf oeq, %initial_logit, %winning_logit : f32
  %candidate_winning_id = scf.select %owns_winning_logit, %initial_id, %largest_i32 : i32
  %winning_id = kernel.workgroup.reduce<minsi> %candidate_winning_id : i32
  %publishes_token = index.cmp eq, %workitem, %c0 : index
  scf.if %publishes_token {
    %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<[%token_count]xi32>
    view.store %winning_id, %token_ids_view[%row] : i32, view<[%token_count]xi32>
  }
  template.return
}
