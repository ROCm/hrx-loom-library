// Dense Qwen3.8 merger launch and output-ownership contract.
// Shared projection retains original F16 operands and emits 5120-wide F32
// features. The command owner preserves postnormalized input before allowing
// the output range to replace the previous transformer residual.

amdgpu.target<gfx11-generic> @qwen38_vision_gfx11 {subgroup_size = 32}

func.decl pure @qwen38_vision_rows() -> (index)

template.decl @qwen38.vision.merger_up(%rows_value: index, %bf16: i1, %input: buffer, %weight: buffer, %bias: buffer, %activation: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_merger_up() {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %patch_rows = func.call pure @qwen38_vision_rows() : () -> (index)
  %merge_rows = index.constant 4 : index
  %rows0 = index.div %patch_rows, %merge_rows : index
  %rows = index.assume %rows0 [range(%rows0, 1, 16384)] : index
  %rounded_rows = index.add %rows, %c63 : index
  %row_tiles = index.div %rounded_rows, %c64 : index
  %c36 = index.constant 36 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %c36, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %activation: buffer) {
  %patch_rows = func.call pure @qwen38_vision_rows() : () -> (index)
  %merge_rows = index.constant 4 : index
  %rows = index.div %patch_rows, %merge_rows : index
  %bf16 = scalar.constant false : i1
  template.apply<@qwen38.vision.merger_up>(%rows, %bf16, %input, %weight, %bias, %activation) : (index, i1, buffer, buffer, buffer, buffer)
  kernel.return
}

template.decl @qwen38.vision.merger_down(%rows_value: index, %bf16: i1, %output_columns: index, %activation: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_merger_down() {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %patch_rows = func.call pure @qwen38_vision_rows() : () -> (index)
  %merge_rows = index.constant 4 : index
  %rows0 = index.div %patch_rows, %merge_rows : index
  %rows = index.assume %rows0 [range(%rows0, 1, 16384)] : index
  %rounded_rows = index.add %rows, %c63 : index
  %row_tiles = index.div %rounded_rows, %c64 : index
  %c40 = index.constant 40 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %c40, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%activation: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %patch_rows = func.call pure @qwen38_vision_rows() : () -> (index)
  %merge_rows = index.constant 4 : index
  %rows = index.div %patch_rows, %merge_rows : index
  %bf16 = scalar.constant false : i1
  %output_columns = index.constant 5120 : index
  template.apply<@qwen38.vision.merger_down>(%rows, %bf16, %output_columns, %activation, %weight, %bias, %output) : (index, i1, index, buffer, buffer, buffer, buffer)
  kernel.return
}
