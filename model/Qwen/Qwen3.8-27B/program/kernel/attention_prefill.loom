// Causal Q/K preparation and KV publication for target prefill. Control
// carries active count and causal/cache position; source M-RoPE coordinates
// are independent, so compressed image coordinates do not alter causal
// ownership. The learned layer binds the normalization weights and cache
// views.

func.decl @qwen38_input_position(%mixed: index, %inputs: buffer, %input: index, %lane: index, %linear_position: i32) -> (i32)

template.decl @qwen38.attention.rope_text_value(%position: i32, %lane0: index, %normalized_head: buffer) -> (f32)

template.decl @qwen38.attention.query_prepare(%head: index, %token0: index, %lane: index, %control: buffer, %epsilon: f32, %query_gate_projection: buffer, %norm_weight: buffer, %query: buffer, %gate: buffer, %source_position_base: i32, %control_origin: offset, %token_begin: index, %mixed_inputs: index, %input_tokens: buffer)

func.decl @qwen38_kv_position(%logical_capacity: index, %map: buffer, %map_origin: offset, %position: index, %pool_capacity: index) -> (index)

template.decl @qwen38.attention.kv_prepare(%logical_capacity: index, %head: index, %token0: index, %lane: index, %control: buffer, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %norm_weight: buffer, %key_cache: buffer, %value_cache: buffer, %source_position_base: i32, %control_origin: offset, %token_begin: index, %key_origin: offset, %value_origin: offset, %map: buffer, %map_origin: offset, %pool_capacity: index, %mixed_inputs: index, %input_tokens: buffer)

// Qwen3.8-27B causal full-attention prefill primitives.
//
// The issue-time control buffer contains the active token count followed by
// the first causal/cache position. Preparation receives the independent
// M-RoPE source position explicitly, so compressed media coordinates never
// change cache placement or masking.
config.decl @qwen38.attention.cache_capacity : %value: index where [range(%value, 1, 262144)]

// Normalizes and rotates every query head while extracting its colocated
// sigmoid gate. One workgroup owns one complete token/head pair.
template.def<@qwen38.attention.query_prepare> device @qwen38_attention_query_prepare(%head: index, %token0: index, %lane: index, %control: buffer, %epsilon: f32, %query_gate_projection: buffer, %norm_weight: buffer, %query: buffer, %gate: buffer, %source_position_base: i32, %control_origin: offset, %token_begin: index, %mixed_inputs: index, %input_tokens: buffer) {
  %c0 = index.constant 0 : index
  %c0_offset = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %control_view = buffer.view %control[%control_origin] : buffer -> view<2xi32>
  %token_count_i32 = view.load %control_view[%c0] : view<2xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %token_active = index.cmp ult, %token0, %token_count : index
  scf.if %token_active {
    %token = index.assume %token0 [lt(%token0, %token_count)] : index
    %position_base0 = index.cast %source_position_base : i32 to index
    %position_base = index.assume %position_base0 [range(%position_base0, 0, 262143)] : index
    %position = index.add %position_base, %token : index
    %linear_position = index.cast %position : index to i32
    %input = index.add %token_begin, %token : index
    %position_i32 = func.call @qwen38_input_position(%mixed_inputs, %input_tokens, %input, %lane, %linear_position) : (index, buffer, index, index, i32) -> (i32)
    %projection_row_bytes = index.constant 49152 : offset
    %activation_row_bytes = index.constant 24576 : offset
    %projection_origin = index.scale %token_begin, %projection_row_bytes : index, offset -> offset
    %activation_origin = index.scale %token_begin, %activation_row_bytes : index, offset -> offset
    %projection_view = buffer.view %query_gate_projection[%projection_origin] : buffer -> view<[%token_count]x12288xf32>
    %weight_view = buffer.view %norm_weight[%c0_offset] : buffer -> view<256xf32>
    %query_view = buffer.view %query[%activation_origin] : buffer -> view<[%token_count]x6144xf32>
    %gate_view = buffer.view %gate[%activation_origin] : buffer -> view<[%token_count]x6144xf32>
    %head_projection_base = index.mul %head, %c512 : index
    %query_index = index.add %head_projection_base, %lane : index
    %gate_head_base = index.add %head_projection_base, %c256 : index
    %gate_index = index.add %gate_head_base, %lane : index
    %output_head_base = index.mul %head, %c256 : index
    %output_index = index.add %output_head_base, %lane : index
    %raw_query = view.load %projection_view[%token, %query_index] : view<[%token_count]x12288xf32> -> f32
    %raw_gate = view.load %projection_view[%token, %gate_index] : view<[%token_count]x12288xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %raw_query, %raw_query : f32
    %sum = kernel.workgroup.reduce<addf> %square : f32
    %head_size_f32 = scalar.constant 256.0 : f32
    %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %head_size_f32 : f32
    %biased_mean = scalar.addf<nnan|ninf|nsz> %mean, %epsilon : f32
    %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
    %weight = view.load %weight_view[%lane] : view<256xf32> -> f32
    %normalized0 = scalar.mulf<nnan|ninf|nsz> %raw_query, %inverse_rms : f32
    %normalized = scalar.mulf<nnan|ninf|nsz> %normalized0, %weight : f32
    %scratch_bytes = index.constant 1024 : offset
    %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
    %scratch_view = buffer.view %scratch[%c0_offset] : buffer -> view<256xf32>
    view.store %normalized, %scratch_view[%lane] : f32, view<256xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %rotated = template.apply<@qwen38.attention.rope_text_value>(%position_i32, %lane, %scratch) : (i32, index, buffer) -> (f32)
    %gate_value = scalar.logisticf<afn> %raw_gate : f32
    view.store %rotated, %query_view[%token, %output_index] : f32, view<[%token_count]x6144xf32>
    view.store %gate_value, %gate_view[%token, %output_index] : f32, view<[%token_count]x6144xf32>
  }
  template.return
}

kernel.def export("qwen38_attention_query_prepare_prefill") @qwen38_attention_query_prepare_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %head_count = index.constant 24 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%head_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%control: buffer, %epsilon: f32, %query_gate_projection: buffer, %norm_weight: buffer, %query: buffer, %gate: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 23)] : index
  %token = kernel.workgroup.id<y> : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %origin = index.constant 0 : offset
  %token_begin = index.constant 0 : index
  %control_view = buffer.view %control[%origin] : buffer -> view<2xi32>
  %position_index = index.constant 1 : index
  %source_position = view.load %control_view[%position_index] : view<2xi32> -> i32
  template.apply<@qwen38.attention.query_prepare>(%head, %token, %lane, %control, %epsilon, %query_gate_projection, %norm_weight, %query, %gate, %source_position, %origin, %token_begin, %token_begin, %control) : (index, index, index, buffer, f32, buffer, buffer, buffer, buffer, i32, offset, index, index, buffer)
  kernel.return
}

// Normalizes and rotates every key head, then publishes K and V directly into
// the persistent token-major cache at the matching absolute positions.
// Logical extent bounds positions and page maps independently of pool size;
// concrete wrappers supply both capacities as specialization operands.
template.def<@qwen38.attention.kv_prepare> device @qwen38_attention_kv_prepare(%logical_capacity: index, %head: index, %token0: index, %lane: index, %control: buffer, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %norm_weight: buffer, %key_cache: buffer, %value_cache: buffer, %source_position_base: i32, %control_origin: offset, %token_begin: index, %key_origin: offset, %value_origin: offset, %map: buffer, %map_origin: offset, %pool_capacity: index, %mixed_inputs: index, %input_tokens: buffer) {
  %c0_2 = index.constant 0 : index
  %paged = index.cmp ne, %pool_capacity, %c0_2 : index
  %physical_capacity = scf.select %paged, %pool_capacity, %logical_capacity : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_offset = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %control_view = buffer.view %control[%control_origin] : buffer -> view<2xi32>
  %token_count_i32 = view.load %control_view[%c0] : view<2xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %token_active = index.cmp ult, %token0, %token_count : index
  scf.if %token_active {
    %token = index.assume %token0 [lt(%token0, %token_count)] : index
    %position_base_i32 = view.load %control_view[%c1] : view<2xi32> -> i32
    %position_base0 = index.cast %position_base_i32 : i32 to index
    %position_base = index.assume %position_base0 [range(%position_base0, 0, 262143)] : index
    %position0 = index.add %position_base, %token : index
    %position = index.assume %position0 [lt(%position0, %logical_capacity)] : index
    %source_base0 = index.cast %source_position_base : i32 to index
    %source_base = index.assume %source_base0 [range(%source_base0, 0, 262143)] : index
    %source_position = index.add %source_base, %token : index
    %linear_position = index.cast %source_position : index to i32
    %input = index.add %token_begin, %token : index
    %source_position_i32 = func.call @qwen38_input_position(%mixed_inputs, %input_tokens, %input, %lane, %linear_position) : (index, buffer, index, index, i32) -> (i32)
    %projection_row_bytes = index.constant 4096 : offset
    %projection_origin = index.scale %token_begin, %projection_row_bytes : index, offset -> offset
    %key_projection_view = buffer.view %key_projection[%projection_origin] : buffer -> view<[%token_count]x1024xf32>
    %value_projection_view = buffer.view %value_projection[%projection_origin] : buffer -> view<[%token_count]x1024xf32>
    %weight_view = buffer.view %norm_weight[%c0_offset] : buffer -> view<256xf32>
    %key_cache_view = buffer.view %key_cache[%key_origin] : buffer -> view<[%physical_capacity]x1024xf16>
    %value_cache_view = buffer.view %value_cache[%value_origin] : buffer -> view<[%physical_capacity]x1024xf16>
    %head_base = index.mul %head, %c256 : index
    %projection_index = index.add %head_base, %lane : index
    %raw_key = view.load %key_projection_view[%token, %projection_index] : view<[%token_count]x1024xf32> -> f32
    %raw_value = view.load %value_projection_view[%token, %projection_index] : view<[%token_count]x1024xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %raw_key, %raw_key : f32
    %sum = kernel.workgroup.reduce<addf> %square : f32
    %head_size_f32 = scalar.constant 256.0 : f32
    %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %head_size_f32 : f32
    %biased_mean = scalar.addf<nnan|ninf|nsz> %mean, %epsilon : f32
    %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
    %weight = view.load %weight_view[%lane] : view<256xf32> -> f32
    %normalized0 = scalar.mulf<nnan|ninf|nsz> %raw_key, %inverse_rms : f32
    %normalized = scalar.mulf<nnan|ninf|nsz> %normalized0, %weight : f32
    %scratch_bytes = index.constant 1024 : offset
    %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
    %scratch_view = buffer.view %scratch[%c0_offset] : buffer -> view<256xf32>
    view.store %normalized, %scratch_view[%lane] : f32, view<256xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %rotated = template.apply<@qwen38.attention.rope_text_value>(%source_position_i32, %lane, %scratch) : (i32, index, buffer) -> (f32)
    %physical_position = func.call @qwen38_kv_position(%logical_capacity, %map, %map_origin, %position, %pool_capacity) : (index, buffer, offset, index, index) -> (index)
    %cache_index = index.add %head_base, %lane : index
    %key_f16 = scalar.fptrunc %rotated : f32 to f16
    %value_f16 = scalar.fptrunc %raw_value : f32 to f16
    view.store %key_f16, %key_cache_view[%physical_position, %cache_index] : f16, view<[%physical_capacity]x1024xf16>
    view.store %value_f16, %value_cache_view[%physical_position, %cache_index] : f16, view<[%physical_capacity]x1024xf16>
  }
  template.return
}

kernel.def export("qwen38_attention_kv_prepare_prefill") @qwen38_attention_kv_prepare_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %head_count = index.constant 4 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%head_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%control: buffer, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %norm_weight: buffer, %key_cache: buffer, %value_cache: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 3)] : index
  %token = kernel.workgroup.id<y> : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %origin = index.constant 0 : offset
  %token_begin = index.constant 0 : index
  %logical_capacity = config.get @qwen38.attention.cache_capacity : index
  %control_view = buffer.view %control[%origin] : buffer -> view<2xi32>
  %position_index = index.constant 1 : index
  %source_position = view.load %control_view[%position_index] : view<2xi32> -> i32
  template.apply<@qwen38.attention.kv_prepare>(%logical_capacity, %head, %token, %lane, %control, %epsilon, %key_projection, %value_projection, %norm_weight, %key_cache, %value_cache, %source_position, %origin, %token_begin, %origin, %origin, %control, %origin, %token_begin, %token_begin, %control) : (index, index, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, i32, offset, index, offset, offset, buffer, offset, index, index, buffer)
  kernel.return
}
