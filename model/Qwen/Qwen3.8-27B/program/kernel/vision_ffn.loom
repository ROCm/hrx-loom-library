// Dense Qwen3.8 vision FFN launch and specialization contract.
// The model supplies exact image height/width and original F16 weights. Patch
// count and matrix precision are compilation facts passed explicitly to the
// shared vision motif. Buffers retain the original up/down ABI:
// F32 residual and affine terms, eight statistics bytes per patch, and a
// 4304-wide F16 activation. Down publishes into the existing residual.

amdgpu.target<gfx11-generic> @qwen38_vision_gfx11 {subgroup_size = 32}

func.decl pure @qwen38_vision_rows() -> (index)

template.decl @qwen38.vision.ffn_up(%rows_value: index, %bf16: i1, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %up_weight: buffer, %up_bias: buffer, %activation: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_ffn_up() {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %rows0 = func.call pure @qwen38_vision_rows() : () -> (index)
  %rows = index.assume %rows0 [range(%rows0, 4, 65536), multiple_of(%rows0, 4)] : index
  %rounded_rows = index.add %rows, %c63 : index
  %row_tiles = index.div %rounded_rows, %c64 : index
  %c23 = index.constant 23 : index
  %c384 = index.constant 384 : index
  kernel.launch.config workgroups(%row_tiles, %c23, %c1) workgroup_size(%c384, %c1, %c1) : index
} launch(%residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %up_weight: buffer, %up_bias: buffer, %activation: buffer) {
  %rows = func.call pure @qwen38_vision_rows() : () -> (index)
  %bf16 = scalar.constant false : i1
  template.apply<@qwen38.vision.ffn_up>(%rows, %bf16, %residual, %statistics, %layernorm_weight, %layernorm_bias, %up_weight, %up_bias, %activation) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

template.decl @qwen38.vision.ffn_down(%rows_value: index, %bf16: i1, %activation: buffer, %down_weight: buffer, %down_bias: buffer, %residual: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_ffn_down() {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %rows0 = func.call pure @qwen38_vision_rows() : () -> (index)
  %rows = index.assume %rows0 [range(%rows0, 4, 65536), multiple_of(%rows0, 4)] : index
  %rounded_rows = index.add %rows, %c63 : index
  %row_tiles = index.div %rounded_rows, %c64 : index
  %c9 = index.constant 9 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %c9, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%activation: buffer, %down_weight: buffer, %down_bias: buffer, %residual: buffer) {
  %rows = func.call pure @qwen38_vision_rows() : () -> (index)
  %bf16 = scalar.constant false : i1
  template.apply<@qwen38.vision.ffn_down>(%rows, %bf16, %activation, %down_weight, %down_bias, %residual) : (index, i1, buffer, buffer, buffer, buffer)
  kernel.return
}
