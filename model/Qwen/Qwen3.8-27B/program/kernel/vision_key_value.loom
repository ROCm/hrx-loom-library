// Dense Qwen3.8 vision K/V launch and cohort-bank contract.
// The model supplies exact image dimensions, original F16 weights, and a
// four-head cohort 0..3. The shared motif receives geometry and precision as
// compilation facts, while the head cohort remains a launch argument. Each
// image/frame pair owns K [patches,288] and transposed V [288,patches]. Later
// head cohorts reuse those banks after attention consumes them. Other buffers
// retain the shared motif's F32 residual, statistics, and affine-term contracts.

amdgpu.target<gfx11-generic> @qwen38_vision_gfx11 {subgroup_size = 32}

config.decl @qwen38.vision.image_height : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.decl @qwen38.vision.image_width : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.decl @qwen38.vision.group_count : %value: index where [range(%value, 1, 16384)]

template.decl @qwen38.vision.key_value(%patch_height_value: index, %patch_width_value: index, %bf16: i1, %first_row: index, %cohort: index, %output_offset: offset, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %qkv_weight: buffer, %qkv_bias: buffer, %key: buffer, %value: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_key_value_cohort(%cohort: index) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c384 = index.constant 384 : index
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch_height = index.div %image_height, %c16 : index
  %patch_width = index.div %image_width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  %padded_rows = index.add %rows, %c31 : index
  %row_tiles = index.div %padded_rows, %c32 : index
  %groups = config.get @qwen38.vision.group_count : index
  kernel.launch.config workgroups(%row_tiles, %c2, %groups) workgroup_size(%c384, %c1, %c1) : index
} launch(%cohort: index, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %qkv_weight: buffer, %qkv_bias: buffer, %key: buffer, %value: buffer) where [range(%cohort, 0, 3)] {
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch = index.constant 16 : index
  %height = index.div %image_height, %patch : index
  %width = index.div %image_width, %patch : index
  %bf16 = scalar.constant false : i1
  %group = kernel.workgroup.id<z> : index
  %rows = index.mul %height, %width : index
  %first_row = index.mul %group, %rows : index
  %cohort_stride = index.constant 576 : offset
  %output_offset = index.scale %first_row, %cohort_stride : index, offset -> offset
  template.apply<@qwen38.vision.key_value>(%height, %width, %bf16, %first_row, %cohort, %output_offset, %residual, %statistics, %layernorm_weight, %layernorm_bias, %qkv_weight, %qkv_bias, %key, %value) : (index, index, i1, index, index, offset, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}
