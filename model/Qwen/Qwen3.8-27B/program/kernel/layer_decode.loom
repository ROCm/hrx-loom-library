// Row normalization, activation, and residual primitives for decode. The
// residual ABI is row-major F32 with model width 5120; quantized contractions
// and stateful attention/GDN operations have separate owners. Callers provide
// the normalization weights and epsilon.

template.decl @normalization.rms_row_f32(%width: index, %threads: index, %input_origin: offset, %output_origin: offset, %output_f16: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

template.decl @normalization.rms_row_f32.values(%width: index, %threads: index, %packet_count: index, %input_origin: offset, %epsilon: f32, %input: buffer, %weight: buffer) -> (vector<[%packet_count]x4xf32>)

template.decl @ggml.quantize_q8_1_x4.group_values(%publish_output: i1, %group_count: index, %cohort_count: index, %cohort: index, %group: index, %lane: index, %input_values: vector<4xf32>, %output: buffer)

template.decl @qwen38.rmsnorm_f32.row(%input_row_count: index, %input_row: index, %output_origin: offset, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

// Elementwise and normalization primitives shared by Qwen3.8 decode layers.
// Quantized projections and attention/GDN state transitions remain in their
// own files so command programs can select and compose them independently.
// Normalizes one row from a row-major 5120-wide input. Decode provides its
// single row while prefill selects the final active row from its full slab.
template.def<@qwen38.rmsnorm_f32.row> device @qwen38_rmsnorm_f32_row(%input_row_count: index, %input_row: index, %output_origin: offset, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %width = index.constant 5120 : index
  %threads = index.constant 256 : index
  %row_bytes = index.constant 20480 : offset
  %row = index.assume %input_row [ge(%input_row, 0), lt(%input_row, %input_row_count)] : index
  %input_origin = index.scale %row, %row_bytes : index, offset -> offset
  %output_f16 = scalar.constant 0 : i1
  template.apply<@normalization.rms_row_f32>(%width, %threads, %input_origin, %output_origin, %output_f16, %epsilon, %input, %weight, %output) : (index, index, offset, offset, i1, f32, buffer, buffer, buffer)
  template.return
}

// Computes one 5120-wide F32 RMSNorm row. Decode, prefill, and speculative
// verification share the same retained-packet reduction and output arithmetic.
kernel.def export("qwen38_rmsnorm_f32_decode") @qwen38_rmsnorm_f32_decode() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %origin = index.constant 0 : offset
  template.apply<@qwen38.rmsnorm_f32.row>(%c1, %c0, %origin, %epsilon, %input, %weight, %output) : (index, index, offset, f32, buffer, buffer, buffer)
  kernel.return
}

// Normalizes one decode row and publishes both its ordinary F32 boundary and
// canonical GGML Q8_1 x4 representation from the retained result packets.
// Each adjacent 32-lane cohort owns one complete 128-value physical Q8 group;
// five packets across eight cohorts cover the 5120-value row without another
// global-memory read or dispatch.
kernel.def export("qwen38_rmsnorm_q8_1_x4_f32_decode") @qwen38_rmsnorm_q8_1_x4_f32_decode() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%epsilon: f32, %input: buffer, %weight: buffer, %output_f32: buffer, %output_q8: buffer) {
  %width = index.constant 5120 : index
  %threads = index.constant 256 : index
  %packet_count = index.constant 5 : index
  %cohort_count = index.constant 8 : index
  %group_count = index.constant 40 : index
  %lanes_per_cohort = index.constant 32 : index
  %elements_per_vector = index.constant 4 : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %publish_output = scalar.constant 1 : i1
  %lane = kernel.workitem.id<x> : index
  %cohort0 = index.div %lane, %lanes_per_cohort : index
  %cohort = index.assume %cohort0 [range(%cohort0, 0, 7)] : index
  %cohort_lane0 = index.rem %lane, %lanes_per_cohort : index
  %cohort_lane = index.assume %cohort_lane0 [range(%cohort_lane0, 0, 31)] : index
  %input_noalias, %weight_noalias, %output_f32_noalias, %output_q8_noalias = buffer.assume.noalias %input, %weight, %output_f32, %output_q8 : buffer, buffer, buffer, buffer
  %results = template.apply<@normalization.rms_row_f32.values>(%width, %threads, %packet_count, %origin, %epsilon, %input_noalias, %weight_noalias) : (index, index, index, offset, f32, buffer, buffer) -> (vector<[%packet_count]x4xf32>)
  %output_view = buffer.view %output_f32_noalias[%origin] : buffer -> view<5120xf32>
  scf.for %packet = [%begin to %packet_count step %step] unroll {
    %ordinal = index.madd %packet, %threads, %lane : index
    %element = index.mul %ordinal, %elements_per_vector : index
    %values = vector.extract %results[%packet] : vector<[%packet_count]x4xf32> -> vector<4xf32>
    vector.store %values, %output_view[%element] : vector<4xf32>, view<5120xf32>
    %group = index.madd %packet, %cohort_count, %cohort : index
    template.apply<@ggml.quantize_q8_1_x4.group_values>(%publish_output, %group_count, %cohort_count, %cohort, %group, %cohort_lane, %values, %output_q8_noalias) : (i1, index, index, index, index, index, vector<4xf32>, buffer)
  }
  kernel.return
}

// Selects the final active prefill row from control[0] without baking a
// prompt-specific residual offset into the reusable command buffer.
kernel.def export("qwen38_rmsnorm_f32_prefill_last") @qwen38_rmsnorm_f32_prefill_last() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%control: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_offset = index.constant 0 : offset
  %c512 = index.constant 512 : index
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<2xi32>
  %token_count_i32 = view.load %control_view[%c0] : view<2xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %last_token0 = index.sub %token_count, %c1 : index
  %last_token = index.assume %last_token0 [range(%last_token0, 0, 511)] : index
  template.apply<@qwen38.rmsnorm_f32.row>(%c512, %last_token, %c0_offset, %epsilon, %input, %weight, %output) : (index, index, offset, f32, buffer, buffer, buffer)
  kernel.return
}

// Adds one projection result into its residual stream. Four adjacent F32
// elements travel together so the common 5120-wide boundary launches only
// five workgroups.
kernel.def export("qwen38_residual_add_f32_decode") @qwen38_residual_add_f32_decode() {
  %c1 = index.constant 1 : index
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %c4 = index.constant 4 : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %workgroup_base = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %workgroup_base, %lane : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), multiple_of(%element0, 4)] : index
  %lhs_view = buffer.view %lhs[%c0_offset] : buffer -> view<5120xf32>
  %rhs_view = buffer.view %rhs[%c0_offset] : buffer -> view<5120xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<5120xf32>
  %lhs_values = vector.load %lhs_view[%element] : view<5120xf32> -> vector<4xf32>
  %rhs_values = vector.load %rhs_view[%element] : view<5120xf32> -> vector<4xf32>
  %result = vector.addf<nnan|ninf|nsz> %lhs_values, %rhs_values : vector<4xf32>
  vector.store %result, %output_view[%element] : vector<4xf32>, view<5120xf32>
  kernel.return
}

// Applies SwiGLU to paired gate and up projections. This ordinary F32 boundary
// is the correctness baseline; a later schedule may fuse Q8 publication when
// the command-program trace proves that extra materialization is significant.
kernel.def export("qwen38_swiglu_f32_decode") @qwen38_swiglu_f32_decode() {
  %c1 = index.constant 1 : index
  %workgroup_count = index.constant 68 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%gate: buffer, %up: buffer, %output: buffer) {
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %workgroup_base = index.mul %workgroup, %workgroup_size : index
  %element0 = index.add %workgroup_base, %lane : index
  %element = index.assume %element0 [range(%element0, 0, 17407)] : index
  %gate_view = buffer.view %gate[%c0_offset] : buffer -> view<17408xf32>
  %up_view = buffer.view %up[%c0_offset] : buffer -> view<17408xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<17408xf32>
  %gate_value = view.load %gate_view[%element] : view<17408xf32> -> f32
  %up_value = view.load %up_view[%element] : view<17408xf32> -> f32
  %activated_gate = scalar.siluf<afn> %gate_value : f32
  %result = scalar.mulf<nnan|ninf|nsz> %activated_gate, %up_value : f32
  view.store %result, %output_view[%element] : f32, view<17408xf32>
  kernel.return
}
