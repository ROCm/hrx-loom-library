// Causal Gated DeltaNet convolution, transition capture, and output gating.
// Workgroups retain convolution history across each token span. Read-only
// forms support verification without publishing speculative history; the
// recurrent state update has its own storage and traversal contract.

template.decl @qwen38.gdn_conv_prepare_prefill.body(%publish_history: i1, %head: index, %thread: index, %token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer, %control_origin: offset, %token_begin: index, %history_origin: offset, %next_history_origin: offset)

template.decl @qwen38.gdn_conv_prepare_prefill.parallel_body(%publish_history: i1, %head: index, %token: index, %thread: index, %token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %next_conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer)

template.decl @qwen38.gdn_norm_gate_prefill.body(%output_is_f16: i1, %head0: index, %token0: index, %lane0: index, %token_count: index, %rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer)

// Advances one depthwise-convolution channel by one token. History values are
// explicit SSA state so the batched kernel does not round-trip them through
// global memory between tokens.
func.def inline @qwen38_gdn_conv_step(%current: f32, %history0: f32, %history1: f32, %history2: f32, %weight0: f32, %weight1: f32, %weight2: f32, %weight3: f32) -> (f32, f32, f32, f32) {
  %product0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %history0, %weight0 : f32
  %product1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %history1, %weight1 : f32
  %product2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %history2, %weight2 : f32
  %product3 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %current, %weight3 : f32
  %sum01 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %product0, %product1 : f32
  %sum23 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %product2, %product3 : f32
  %convolved = scalar.addf<reassoc|nnan|ninf|nsz|contract> %sum01, %sum23 : f32
  %activated = scalar.siluf<afn> %convolved : f32
  func.return %activated, %history1, %history2, %current : f32, f32, f32, f32
}

// One workgroup owns one Q/K head and its three matching V heads. Every lane
// carries the histories for its physical channels through the token loop;
// only Q/K norm reductions rendezvous the workgroup at each causal step. The
// two exported wrappers specialize whether the final histories are published,
// keeping speculative verification and committed execution on one source body.
// Read and write origins may match or name disjoint slots of the same slab.
// Each destination is exclusive for the whole cohort, including all readers
// of an immutable source. The final store publishes directly from registers.
template.def<@qwen38.gdn_conv_prepare_prefill.body> device @qwen38_gdn_conv_prepare_prefill_body(%publish_history: i1, %head: index, %thread: index, %token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer, %control_origin: offset, %token_begin: index, %history_origin: offset, %next_history_origin: offset) {
  %token_count_index = index.constant 0 : index
  %token_count_view = buffer.view %token_count_data[%control_origin] : buffer -> view<1xi32>
  %token_count_i32 = view.load %token_count_view[%token_count_index] : view<1xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %bounded_token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c384 = index.constant 384 : index
  %q_channel_count = index.constant 2048 : index
  %v_channel_base = index.constant 4096 : index
  %values_per_key_head = index.constant 384 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c0_offset = index.constant 0 : offset

  %qkv_row_bytes = index.constant 40960 : offset
  %norm_row_bytes = index.constant 128 : offset
  %qkv_origin = index.scale %token_begin, %qkv_row_bytes : index, offset -> offset
  %norm_origin = index.scale %token_begin, %norm_row_bytes : index, offset -> offset
  %input_view = buffer.view %qkv_input[%qkv_origin] : buffer -> view<[%bounded_token_count]x10240xf32>
  %weight_view = buffer.view %conv_weight[%c0_offset] : buffer -> view<40960xf32>
  %history_view = buffer.view %conv_history[%history_origin] : buffer -> view<30720xf32>
  %output_view = buffer.view %qkv_silu[%qkv_origin] : buffer -> view<[%bounded_token_count]x10240xf32>
  %inverse_norm_view = buffer.view %qk_inverse_norm[%norm_origin] : buffer -> view<[%bounded_token_count]x32xf32>

  %head_channel_base = index.mul %head, %c128 : index
  %is_q_lane = index.cmp ult, %thread, %c128 : index
  %q_or_k_channel = scf.if %is_q_lane -> (index) {
    %q_channel0 = index.add %head_channel_base, %thread : index
    %q_channel = index.assume %q_channel0 [range(%q_channel0, 0, 2047)] : index
    scf.yield %q_channel : index
  } else {
    %k_lane = index.sub %thread, %c128 : index
    %k_head_channel = index.add %head_channel_base, %k_lane : index
    %k_channel0 = index.add %q_channel_count, %k_head_channel : index
    %k_channel = index.assume %k_channel0 [range(%k_channel0, 2048, 4095)] : index
    scf.yield %k_channel : index
  }
  %value_head_channel_base = index.mul %head, %values_per_key_head : index
  %value0_channel_add = index.add %value_head_channel_base, %thread : index
  %value0_channel0 = index.add %v_channel_base, %value0_channel_add : index
  %value0_channel = index.assume %value0_channel0 [range(%value0_channel0, 4096, 10239)] : index
  %value_thread1 = index.add %thread, %c256 : index
  %has_value1 = index.cmp ult, %value_thread1, %c384 : index
  %value1_channel_add = index.add %value_head_channel_base, %value_thread1 : index
  %value1_channel0 = index.add %v_channel_base, %value1_channel_add : index
  %safe_value1_channel = scf.select %has_value1, %value1_channel0, %c0 : index

  %qk_history_base = index.mul %q_or_k_channel, %c3 : index
  %qk_history1_index = index.add %qk_history_base, %c1 : index
  %qk_history2_index = index.add %qk_history_base, %c2 : index
  %v0_history_base = index.mul %value0_channel, %c3 : index
  %v0_history1_index = index.add %v0_history_base, %c1 : index
  %v0_history2_index = index.add %v0_history_base, %c2 : index
  %v1_history_base = index.mul %safe_value1_channel, %c3 : index
  %v1_history1_index = index.add %v1_history_base, %c1 : index
  %v1_history2_index = index.add %v1_history_base, %c2 : index
  %qk_history0 = view.load %history_view[%qk_history_base] : view<30720xf32> -> f32
  %qk_history1 = view.load %history_view[%qk_history1_index] : view<30720xf32> -> f32
  %qk_history2 = view.load %history_view[%qk_history2_index] : view<30720xf32> -> f32
  %v0_history0 = view.load %history_view[%v0_history_base] : view<30720xf32> -> f32
  %v0_history1 = view.load %history_view[%v0_history1_index] : view<30720xf32> -> f32
  %v0_history2 = view.load %history_view[%v0_history2_index] : view<30720xf32> -> f32
  %v1_history0 = view.load %history_view[%v1_history_base] : view<30720xf32> -> f32
  %v1_history1 = view.load %history_view[%v1_history1_index] : view<30720xf32> -> f32
  %v1_history2 = view.load %history_view[%v1_history2_index] : view<30720xf32> -> f32

  %qk_weight_base = index.mul %q_or_k_channel, %c4 : index
  %qk_weight1_index = index.add %qk_weight_base, %c1 : index
  %qk_weight2_index = index.add %qk_weight_base, %c2 : index
  %qk_weight3_index = index.add %qk_weight_base, %c3 : index
  %v0_weight_base = index.mul %value0_channel, %c4 : index
  %v0_weight1_index = index.add %v0_weight_base, %c1 : index
  %v0_weight2_index = index.add %v0_weight_base, %c2 : index
  %v0_weight3_index = index.add %v0_weight_base, %c3 : index
  %v1_weight_base = index.mul %safe_value1_channel, %c4 : index
  %v1_weight1_index = index.add %v1_weight_base, %c1 : index
  %v1_weight2_index = index.add %v1_weight_base, %c2 : index
  %v1_weight3_index = index.add %v1_weight_base, %c3 : index
  %qk_weight0 = view.load %weight_view[%qk_weight_base] : view<40960xf32> -> f32
  %qk_weight1 = view.load %weight_view[%qk_weight1_index] : view<40960xf32> -> f32
  %qk_weight2 = view.load %weight_view[%qk_weight2_index] : view<40960xf32> -> f32
  %qk_weight3 = view.load %weight_view[%qk_weight3_index] : view<40960xf32> -> f32
  %v0_weight0 = view.load %weight_view[%v0_weight_base] : view<40960xf32> -> f32
  %v0_weight1 = view.load %weight_view[%v0_weight1_index] : view<40960xf32> -> f32
  %v0_weight2 = view.load %weight_view[%v0_weight2_index] : view<40960xf32> -> f32
  %v0_weight3 = view.load %weight_view[%v0_weight3_index] : view<40960xf32> -> f32
  %v1_weight0 = view.load %weight_view[%v1_weight_base] : view<40960xf32> -> f32
  %v1_weight1 = view.load %weight_view[%v1_weight1_index] : view<40960xf32> -> f32
  %v1_weight2 = view.load %weight_view[%v1_weight2_index] : view<40960xf32> -> f32
  %v1_weight3 = view.load %weight_view[%v1_weight3_index] : view<40960xf32> -> f32

  %final_qk_history0, %final_qk_history1, %final_qk_history2, %final_v0_history0, %final_v0_history1, %final_v0_history2, %final_v1_history0, %final_v1_history1, %final_v1_history2 = scf.for %token = [%c0 to %bounded_token_count step %c1](%old_qk_history0 = %qk_history0 : f32, %old_qk_history1 = %qk_history1 : f32, %old_qk_history2 = %qk_history2 : f32, %old_v0_history0 = %v0_history0 : f32, %old_v0_history1 = %v0_history1 : f32, %old_v0_history2 = %v0_history2 : f32, %old_v1_history0 = %v1_history0 : f32, %old_v1_history1 = %v1_history1 : f32, %old_v1_history2 = %v1_history2 : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32) {
    %qk_current = view.load %input_view[%token, %q_or_k_channel] : view<[%bounded_token_count]x10240xf32> -> f32
    %qk_value, %next_qk_history0, %next_qk_history1, %next_qk_history2 = func.call @qwen38_gdn_conv_step(%qk_current, %old_qk_history0, %old_qk_history1, %old_qk_history2, %qk_weight0, %qk_weight1, %qk_weight2, %qk_weight3) : (f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32)
    view.store %qk_value, %output_view[%token, %q_or_k_channel] : f32, view<[%bounded_token_count]x10240xf32>
    %qk_square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %qk_value, %qk_value : f32
    %q_square = scf.select %is_q_lane, %qk_square, %c0_f32 : f32
    %k_square = scf.select %is_q_lane, %c0_f32, %qk_square : f32

    %v0_current = view.load %input_view[%token, %value0_channel] : view<[%bounded_token_count]x10240xf32> -> f32
    %v0_value, %next_v0_history0, %next_v0_history1, %next_v0_history2 = func.call @qwen38_gdn_conv_step(%v0_current, %old_v0_history0, %old_v0_history1, %old_v0_history2, %v0_weight0, %v0_weight1, %v0_weight2, %v0_weight3) : (f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32)
    view.store %v0_value, %output_view[%token, %value0_channel] : f32, view<[%bounded_token_count]x10240xf32>

    %v1_current = view.load %input_view[%token, %safe_value1_channel] : view<[%bounded_token_count]x10240xf32> -> f32
    %v1_value, %next_v1_history0, %next_v1_history1, %next_v1_history2 = func.call @qwen38_gdn_conv_step(%v1_current, %old_v1_history0, %old_v1_history1, %old_v1_history2, %v1_weight0, %v1_weight1, %v1_weight2, %v1_weight3) : (f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32)
    scf.if %has_value1 {
      view.store %v1_value, %output_view[%token, %value1_channel0] : f32, view<[%bounded_token_count]x10240xf32>
    }

    %q_sum = kernel.workgroup.reduce<addf> %q_square : f32
    %k_sum = kernel.workgroup.reduce<addf> %k_square : f32
    %is_leader = index.cmp eq, %thread, %c0 : index
    scf.if %is_leader {
      %q_length = scalar.sqrtf<nnan|ninf|nsz|afn> %q_sum : f32
      %k_length = scalar.sqrtf<nnan|ninf|nsz|afn> %k_sum : f32
      %safe_q_length = scalar.maxnumf %q_length, %l2_epsilon : f32
      %safe_k_length = scalar.maxnumf %k_length, %l2_epsilon : f32
      %q_inverse = scalar.divf<nnan|ninf|nsz|arcp> %c1_f32, %safe_q_length : f32
      %k_inverse = scalar.divf<nnan|ninf|nsz|arcp> %c1_f32, %safe_k_length : f32
      %norm_base = index.mul %head, %c2 : index
      %k_norm_index = index.add %norm_base, %c1 : index
      view.store %q_inverse, %inverse_norm_view[%token, %norm_base] : f32, view<[%bounded_token_count]x32xf32>
      view.store %k_inverse, %inverse_norm_view[%token, %k_norm_index] : f32, view<[%bounded_token_count]x32xf32>
    }
    scf.yield %next_qk_history0, %next_qk_history1, %next_qk_history2, %next_v0_history0, %next_v0_history1, %next_v0_history2, %next_v1_history0, %next_v1_history1, %next_v1_history2 : f32, f32, f32, f32, f32, f32, f32, f32, f32
  }

  scf.if %publish_history {
    %next_history_view = buffer.view %conv_history[%next_history_origin] : buffer -> view<30720xf32>
    view.store %final_qk_history0, %next_history_view[%qk_history_base] : f32, view<30720xf32>
    view.store %final_qk_history1, %next_history_view[%qk_history1_index] : f32, view<30720xf32>
    view.store %final_qk_history2, %next_history_view[%qk_history2_index] : f32, view<30720xf32>
    view.store %final_v0_history0, %next_history_view[%v0_history_base] : f32, view<30720xf32>
    view.store %final_v0_history1, %next_history_view[%v0_history1_index] : f32, view<30720xf32>
    view.store %final_v0_history2, %next_history_view[%v0_history2_index] : f32, view<30720xf32>
    scf.if %has_value1 {
      view.store %final_v1_history0, %next_history_view[%v1_history_base] : f32, view<30720xf32>
      view.store %final_v1_history1, %next_history_view[%v1_history1_index] : f32, view<30720xf32>
      view.store %final_v1_history2, %next_history_view[%v1_history2_index] : f32, view<30720xf32>
    }
  }
  template.return
}

kernel.def export("qwen38_gdn_conv_prepare_prefill") @qwen38_gdn_conv_prepare_prefill(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %key_head_count = index.constant 16 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%key_head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 15)] : index
  %thread0 = kernel.workitem.id<x> : index
  %thread = index.assume %thread0 [range(%thread0, 0, 255)] : index
  %publish_history = scalar.constant true : i1
  %origin = index.constant 0 : offset
  %token_begin = index.constant 0 : index
  template.apply<@qwen38.gdn_conv_prepare_prefill.body>(%publish_history, %head, %thread, %token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %conv_history, %qkv_silu, %qk_inverse_norm, %origin, %token_begin, %origin, %origin) : (i1, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
  kernel.return
}

kernel.def export("qwen38_gdn_conv_prepare_prefill_read_only") @qwen38_gdn_conv_prepare_prefill_read_only(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %key_head_count = index.constant 16 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%key_head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 15)] : index
  %thread0 = kernel.workitem.id<x> : index
  %thread = index.assume %thread0 [range(%thread0, 0, 255)] : index
  %publish_history = scalar.constant false : i1
  %origin = index.constant 0 : offset
  %token_begin = index.constant 0 : index
  template.apply<@qwen38.gdn_conv_prepare_prefill.body>(%publish_history, %head, %thread, %token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %conv_history, %qkv_silu, %qk_inverse_norm, %origin, %token_begin, %origin, %origin) : (i1, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
  kernel.return
}

// Evaluates one channel of the depth-four causal convolution at an arbitrary
// token. Inputs before the active span come from persistent history; all other
// taps read the immutable QKV projection. Returning the last three raw values
// lets the final token publish exactly the same history as the serial kernel.
func.def inline @qwen38_gdn_conv_channel_at_token(%token0: index, %channel: index, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer) -> (f32, f32, f32, f32) {
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %input_view = buffer.view %qkv_input[%c0_offset] : buffer -> view<512x10240xf32>
  %weight_view = buffer.view %conv_weight[%c0_offset] : buffer -> view<40960xf32>
  %history_view = buffer.view %conv_history[%c0_offset] : buffer -> view<30720xf32>

  %history_base = index.mul %channel, %c3 : index
  %history1_index = index.add %history_base, %c1 : index
  %history2_index = index.add %history_base, %c2 : index
  %history0 = view.load %history_view[%history_base] : view<30720xf32> -> f32
  %history1 = view.load %history_view[%history1_index] : view<30720xf32> -> f32
  %history2 = view.load %history_view[%history2_index] : view<30720xf32> -> f32

  %weight_base = index.mul %channel, %c4 : index
  %weight1_index = index.add %weight_base, %c1 : index
  %weight2_index = index.add %weight_base, %c2 : index
  %weight3_index = index.add %weight_base, %c3 : index
  %weight0 = view.load %weight_view[%weight_base] : view<40960xf32> -> f32
  %weight1 = view.load %weight_view[%weight1_index] : view<40960xf32> -> f32
  %weight2 = view.load %weight_view[%weight2_index] : view<40960xf32> -> f32
  %weight3 = view.load %weight_view[%weight3_index] : view<40960xf32> -> f32

  %is_token0 = index.cmp eq, %token, %c0 : index
  %tap0, %tap1, %tap2, %tap3 = scf.if %is_token0 -> (f32, f32, f32, f32) {
    %input0 = view.load %input_view[%c0, %channel] : view<512x10240xf32> -> f32
    scf.yield %history0, %history1, %history2, %input0 : f32, f32, f32, f32
  } else {
    %is_token1 = index.cmp eq, %token, %c1 : index
    %token1_tap0, %token1_tap1, %token1_tap2, %token1_tap3 = scf.if %is_token1 -> (f32, f32, f32, f32) {
      %input0 = view.load %input_view[%c0, %channel] : view<512x10240xf32> -> f32
      %input1 = view.load %input_view[%c1, %channel] : view<512x10240xf32> -> f32
      scf.yield %history1, %history2, %input0, %input1 : f32, f32, f32, f32
    } else {
      %is_token2 = index.cmp eq, %token, %c2 : index
      %later_tap0, %later_tap1, %later_tap2, %later_tap3 = scf.if %is_token2 -> (f32, f32, f32, f32) {
        %input0 = view.load %input_view[%c0, %channel] : view<512x10240xf32> -> f32
        %input1 = view.load %input_view[%c1, %channel] : view<512x10240xf32> -> f32
        %input2 = view.load %input_view[%c2, %channel] : view<512x10240xf32> -> f32
        scf.yield %history2, %input0, %input1, %input2 : f32, f32, f32, f32
      } else {
        %source0_raw = index.sub %token, %c3 : index
        %source1_raw = index.sub %token, %c2 : index
        %source2_raw = index.sub %token, %c1 : index
        %source0 = index.assume %source0_raw [range(%source0_raw, 0, 508)] : index
        %source1 = index.assume %source1_raw [range(%source1_raw, 1, 509)] : index
        %source2 = index.assume %source2_raw [range(%source2_raw, 2, 510)] : index
        %input0 = view.load %input_view[%source0, %channel] : view<512x10240xf32> -> f32
        %input1 = view.load %input_view[%source1, %channel] : view<512x10240xf32> -> f32
        %input2 = view.load %input_view[%source2, %channel] : view<512x10240xf32> -> f32
        %input3 = view.load %input_view[%token, %channel] : view<512x10240xf32> -> f32
        scf.yield %input0, %input1, %input2, %input3 : f32, f32, f32, f32
      }
      scf.yield %later_tap0, %later_tap1, %later_tap2, %later_tap3 : f32, f32, f32, f32
    }
    scf.yield %token1_tap0, %token1_tap1, %token1_tap2, %token1_tap3 : f32, f32, f32, f32
  }
  %activated, %next_history0, %next_history1, %next_history2 = func.call @qwen38_gdn_conv_step(%tap3, %tap0, %tap1, %tap2, %weight0, %weight1, %weight2, %weight3) : (f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32)
  func.return %activated, %next_history0, %next_history1, %next_history2 : f32, f32, f32, f32
}

// Captures immutable convolution input before token workgroups can publish
// their next history. The command schedule orders this copy before convolution.
kernel.def export("qwen38_gdn_snapshot_history") @qwen38_gdn_snapshot_history() {
  %groups = index.constant 30 : index
  %threads = index.constant 256 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%history: buffer, %snapshot: buffer) {
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 256 : index
  %width = index.constant 4 : index
  %origin = index.constant 0 : offset
  %group_base = index.mul %group, %threads : index
  %vector_index = index.add %group_base, %thread : index
  %element0 = index.mul %vector_index, %width : index
  %element = index.assume %element0 [range(%element0, 0, 30716), multiple_of(%element0, 4)] : index
  %source = buffer.view %history[%origin] : buffer -> view<30720xf32>
  %target = buffer.view %snapshot[%origin] : buffer -> view<30720xf32>
  %values = vector.load %source[%element] : view<30720xf32> -> vector<4xf32>
  vector.store %values, %target[%element] : vector<4xf32>, view<30720xf32>
  kernel.return
}

// One workgroup owns one token and one Q/K head. Every active workgroup reads
// an immutable snapshot; only the final token publishes persistent history.
template.def<@qwen38.gdn_conv_prepare_prefill.parallel_body> device @qwen38_gdn_conv_prepare_prefill_parallel_body(%publish_history: i1, %head: index, %token: index, %thread: index, %token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %next_conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer) {
  %token_count_offset = index.constant 0 : offset
  %token_count_index = index.constant 0 : index
  %token_count_view = buffer.view %token_count_data[%token_count_offset] : buffer -> view<1xi32>
  %token_count_i32 = view.load %token_count_view[%token_count_index] : view<1xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %bounded_token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %token_active = index.cmp ult, %token, %bounded_token_count : index
  scf.if %token_active {
    %active_token = index.assume %token [range(%token, 0, 511), lt(%token, %bounded_token_count)] : index
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %c2 = index.constant 2 : index
    %c3 = index.constant 3 : index
    %c128 = index.constant 128 : index
    %c256 = index.constant 256 : index
    %c384 = index.constant 384 : index
    %q_channel_count = index.constant 2048 : index
    %v_channel_base = index.constant 4096 : index
    %values_per_key_head = index.constant 384 : index
    %c0_f32 = scalar.constant 0.0 : f32
    %c1_f32 = scalar.constant 1.0 : f32
    %c0_offset = index.constant 0 : offset
    %output_view = buffer.view %qkv_silu[%c0_offset] : buffer -> view<512x10240xf32>
    %inverse_norm_view = buffer.view %qk_inverse_norm[%c0_offset] : buffer -> view<512x32xf32>
    %history_view = buffer.view %next_conv_history[%c0_offset] : buffer -> view<30720xf32>

    %head_channel_base = index.mul %head, %c128 : index
    %is_q_lane = index.cmp ult, %thread, %c128 : index
    %q_or_k_channel = scf.if %is_q_lane -> (index) {
      %q_channel0 = index.add %head_channel_base, %thread : index
      %q_channel = index.assume %q_channel0 [range(%q_channel0, 0, 2047)] : index
      scf.yield %q_channel : index
    } else {
      %k_lane = index.sub %thread, %c128 : index
      %k_head_channel = index.add %head_channel_base, %k_lane : index
      %k_channel0 = index.add %q_channel_count, %k_head_channel : index
      %k_channel = index.assume %k_channel0 [range(%k_channel0, 2048, 4095)] : index
      scf.yield %k_channel : index
    }
    %value_head_channel_base = index.mul %head, %values_per_key_head : index
    %value0_channel_add = index.add %value_head_channel_base, %thread : index
    %value0_channel0 = index.add %v_channel_base, %value0_channel_add : index
    %value0_channel = index.assume %value0_channel0 [range(%value0_channel0, 4096, 10239)] : index
    %value_thread1 = index.add %thread, %c256 : index
    %has_value1 = index.cmp ult, %value_thread1, %c384 : index
    %value1_channel_add = index.add %value_head_channel_base, %value_thread1 : index
    %value1_channel0 = index.add %v_channel_base, %value1_channel_add : index

    %qk_value, %next_qk_history0, %next_qk_history1, %next_qk_history2 = func.call @qwen38_gdn_conv_channel_at_token(%active_token, %q_or_k_channel, %qkv_input, %conv_weight, %conv_history) : (index, index, buffer, buffer, buffer) -> (f32, f32, f32, f32)
    view.store %qk_value, %output_view[%active_token, %q_or_k_channel] : f32, view<512x10240xf32>
    %qk_square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %qk_value, %qk_value : f32
    %q_square = scf.select %is_q_lane, %qk_square, %c0_f32 : f32
    %k_square = scf.select %is_q_lane, %c0_f32, %qk_square : f32

    %v0_value, %next_v0_history0, %next_v0_history1, %next_v0_history2 = func.call @qwen38_gdn_conv_channel_at_token(%active_token, %value0_channel, %qkv_input, %conv_weight, %conv_history) : (index, index, buffer, buffer, buffer) -> (f32, f32, f32, f32)
    view.store %v0_value, %output_view[%active_token, %value0_channel] : f32, view<512x10240xf32>

    %next_v1_history0, %next_v1_history1, %next_v1_history2 = scf.if %has_value1 -> (f32, f32, f32) {
      %value1_channel = index.assume %value1_channel0 [range(%value1_channel0, 4352, 10239)] : index
      %v1_value, %v1_history0, %v1_history1, %v1_history2 = func.call @qwen38_gdn_conv_channel_at_token(%active_token, %value1_channel, %qkv_input, %conv_weight, %conv_history) : (index, index, buffer, buffer, buffer) -> (f32, f32, f32, f32)
      view.store %v1_value, %output_view[%active_token, %value1_channel] : f32, view<512x10240xf32>
      scf.yield %v1_history0, %v1_history1, %v1_history2 : f32, f32, f32
    } else {
      scf.yield %c0_f32, %c0_f32, %c0_f32 : f32, f32, f32
    }

    %q_sum = kernel.workgroup.reduce<addf> %q_square : f32
    %k_sum = kernel.workgroup.reduce<addf> %k_square : f32
    %is_leader = index.cmp eq, %thread, %c0 : index
    scf.if %is_leader {
      %q_length = scalar.sqrtf<nnan|ninf|nsz|afn> %q_sum : f32
      %k_length = scalar.sqrtf<nnan|ninf|nsz|afn> %k_sum : f32
      %safe_q_length = scalar.maxnumf %q_length, %l2_epsilon : f32
      %safe_k_length = scalar.maxnumf %k_length, %l2_epsilon : f32
      %q_inverse = scalar.divf<nnan|ninf|nsz|arcp> %c1_f32, %safe_q_length : f32
      %k_inverse = scalar.divf<nnan|ninf|nsz|arcp> %c1_f32, %safe_k_length : f32
      %norm_base = index.mul %head, %c2 : index
      %k_norm_index = index.add %norm_base, %c1 : index
      view.store %q_inverse, %inverse_norm_view[%active_token, %norm_base] : f32, view<512x32xf32>
      view.store %k_inverse, %inverse_norm_view[%active_token, %k_norm_index] : f32, view<512x32xf32>
    }

    %last_token = index.sub %bounded_token_count, %c1 : index
    %is_final_token = index.cmp eq, %active_token, %last_token : index
    %publish_final_history = scalar.andi %publish_history, %is_final_token : i1
    scf.if %publish_final_history {
      %qk_history_base = index.mul %q_or_k_channel, %c3 : index
      %qk_history1_index = index.add %qk_history_base, %c1 : index
      %qk_history2_index = index.add %qk_history_base, %c2 : index
      view.store %next_qk_history0, %history_view[%qk_history_base] : f32, view<30720xf32>
      view.store %next_qk_history1, %history_view[%qk_history1_index] : f32, view<30720xf32>
      view.store %next_qk_history2, %history_view[%qk_history2_index] : f32, view<30720xf32>
      %v0_history_base = index.mul %value0_channel, %c3 : index
      %v0_history1_index = index.add %v0_history_base, %c1 : index
      %v0_history2_index = index.add %v0_history_base, %c2 : index
      view.store %next_v0_history0, %history_view[%v0_history_base] : f32, view<30720xf32>
      view.store %next_v0_history1, %history_view[%v0_history1_index] : f32, view<30720xf32>
      view.store %next_v0_history2, %history_view[%v0_history2_index] : f32, view<30720xf32>
      scf.if %has_value1 {
        %value1_channel = index.assume %value1_channel0 [range(%value1_channel0, 4352, 10239)] : index
        %v1_history_base = index.mul %value1_channel, %c3 : index
        %v1_history1_index = index.add %v1_history_base, %c1 : index
        %v1_history2_index = index.add %v1_history_base, %c2 : index
        view.store %next_v1_history0, %history_view[%v1_history_base] : f32, view<30720xf32>
        view.store %next_v1_history1, %history_view[%v1_history1_index] : f32, view<30720xf32>
        view.store %next_v1_history2, %history_view[%v1_history2_index] : f32, view<30720xf32>
      }
    }
  }
  template.return
}

kernel.def export("qwen38_gdn_conv_prepare_prefill_parallel") @qwen38_gdn_conv_prepare_prefill_parallel(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %key_head_count = index.constant 16 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%key_head_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %prior_history: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 15)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %thread0 = kernel.workitem.id<x> : index
  %thread = index.assume %thread0 [range(%thread0, 0, 255)] : index
  %publish_history = scalar.constant true : i1
  template.apply<@qwen38.gdn_conv_prepare_prefill.parallel_body>(%publish_history, %head, %token, %thread, %token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %prior_history, %conv_history, %qkv_silu, %qk_inverse_norm) : (i1, index, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("qwen38_gdn_conv_prepare_prefill_parallel_read_only") @qwen38_gdn_conv_prepare_prefill_parallel_read_only(%token_count: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %unit = index.constant 1 : index
  %key_head_count = index.constant 16 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%key_head_count, %bounded_token_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 15)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %thread0 = kernel.workitem.id<x> : index
  %thread = index.assume %thread0 [range(%thread0, 0, 255)] : index
  %publish_history = scalar.constant false : i1
  template.apply<@qwen38.gdn_conv_prepare_prefill.parallel_body>(%publish_history, %head, %token, %thread, %token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %conv_history, %conv_history, %qkv_silu, %qk_inverse_norm) : (i1, index, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// Retains the four-row transition inputs needed to commit an accepted MTP
// prefix without replaying the dense target model. One layer record contains
// QKV followed by alpha and beta, all in their native row-major F32 layouts.
kernel.def export("qwen38_gdn_capture_transition_depth4") @qwen38_gdn_capture_transition_depth4() {
  %workgroup_count = index.constant 41 : index
  %workgroup_size = index.constant 256 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%qkv: buffer, %alpha: buffer, %beta: buffer, %transition: buffer) {
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 40)] : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %c4 = index.constant 4 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c96 = index.constant 96 : index
  %c256 = index.constant 256 : index
  %alpha_element_base = index.constant 40960 : index
  %beta_element_base = index.constant 41152 : index
  %c0_offset = index.constant 0 : offset
  %qkv_view = buffer.view %qkv[%c0_offset] : buffer -> view<40960xf32>
  %alpha_view = buffer.view %alpha[%c0_offset] : buffer -> view<192xf32>
  %beta_view = buffer.view %beta[%c0_offset] : buffer -> view<192xf32>
  %transition_view = buffer.view %transition[%c0_offset] : buffer -> view<41344xf32>

  %is_qkv_workgroup = index.cmp ult, %workgroup, %c40 : index
  scf.if %is_qkv_workgroup {
    %packet_base = index.mul %workgroup, %c256 : index
    %packet = index.add %packet_base, %workitem : index
    %element0 = index.mul %packet, %c4 : index
    %element = index.assume %element0 [range(%element0, 0, 40956), multiple_of(%element0, 4)] : index
    %values = vector.load %qkv_view[%element] : view<40960xf32> -> vector<4xf32>
    vector.store %values, %transition_view[%element] : vector<4xf32>, view<41344xf32>
  } else {
    %is_gate_packet = index.cmp ult, %workitem, %c96 : index
    scf.if %is_gate_packet {
      %is_alpha = index.cmp ult, %workitem, %c48 : index
      %gate_packet = scf.if %is_alpha -> (index) {
        scf.yield %workitem : index
      } else {
        %beta_packet = index.sub %workitem, %c48 : index
        scf.yield %beta_packet : index
      }
      %gate_element = index.mul %gate_packet, %c4 : index
      %values = scf.if %is_alpha -> (vector<4xf32>) {
        %alpha_values = vector.load %alpha_view[%gate_element] : view<192xf32> -> vector<4xf32>
        scf.yield %alpha_values : vector<4xf32>
      } else {
        %beta_values = vector.load %beta_view[%gate_element] : view<192xf32> -> vector<4xf32>
        scf.yield %beta_values : vector<4xf32>
      }
      %gate_base = scf.select %is_alpha, %alpha_element_base, %beta_element_base : index
      %target_element0 = index.add %gate_base, %gate_element : index
      %target_element = index.assume %target_element0 [range(%target_element0, 40960, 41340), multiple_of(%target_element0, 4)] : index
      vector.store %values, %transition_view[%target_element] : vector<4xf32>, view<41344xf32>
    }
  }
  kernel.return
}

// Applies the per-head output normalization and z gate after the causal
// recurrence has published its complete output matrix. The F16 specialization
// rounds the F32 result once at its producer so all downstream WMMA tiles
// consume the same operands without repeatedly loading and truncating F32.
template.def<@qwen38.gdn_norm_gate_prefill.body> device @qwen38_gdn_norm_gate_prefill_body(%output_is_f16: i1, %head0: index, %token0: index, %lane0: index, %token_count: index, %rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %head = index.assume %head0 [range(%head0, 0, 47)] : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 127)] : index
  %c128 = index.constant 128 : index
  %c128_f32 = scalar.constant 128.0 : f32
  %c0_offset = index.constant 0 : offset
  %raw_view = buffer.view %raw_output[%c0_offset] : buffer -> view<[%bounded_token_count]x6144xf32>
  %weight_view = buffer.view %norm_weight[%c0_offset] : buffer -> view<128xf32>
  %z_view = buffer.view %z[%c0_offset] : buffer -> view<[%bounded_token_count]x6144xf32>
  %output_f32_view = buffer.view %output[%c0_offset] : buffer -> view<[%bounded_token_count]x6144xf32>
  %output_f16_view = buffer.view %output[%c0_offset] : buffer -> view<[%bounded_token_count]x6144xf16>
  %head_base = index.mul %head, %c128 : index
  %channel = index.add %head_base, %lane : index
  %value = view.load %raw_view[%token, %channel] : view<[%bounded_token_count]x6144xf32> -> f32
  %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
  %sum = kernel.workgroup.reduce<addf> %square : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %c128_f32 : f32
  %biased_mean = scalar.addf %mean, %rms_epsilon : f32
  %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
  %weight = view.load %weight_view[%lane] : view<128xf32> -> f32
  %normalized0 = scalar.mulf<nnan|ninf|nsz> %value, %inverse_rms : f32
  %normalized = scalar.mulf<nnan|ninf|nsz> %normalized0, %weight : f32
  %z_value = view.load %z_view[%token, %channel] : view<[%bounded_token_count]x6144xf32> -> f32
  %gate = scalar.siluf<afn> %z_value : f32
  %result = scalar.mulf<nnan|ninf|nsz> %normalized, %gate : f32
  scf.if %output_is_f16 {
    %result_f16 = scalar.fptrunc %result : f32 to f16
    view.store %result_f16, %output_f16_view[%token, %channel] : f16, view<[%bounded_token_count]x6144xf16>
  } else {
    view.store %result, %output_f32_view[%token, %channel] : f32, view<[%bounded_token_count]x6144xf32>
  }
  template.return
}

// The workload is the saved live prefix; storage capacity remains independent.
// Workers must not read the capacity tail that this epoch did not produce.
// Four queued rows per head and execution unit hide short-task latency; at most
// 128 rows (6,144 groups across all heads) are queued before workers stride.
kernel.def export("qwen38_gdn_norm_gate_prefill") @qwen38_gdn_norm_gate_prefill(%live_rows: index) {
  %rows = index.assume %live_rows [range(%live_rows, 0, 512)] : index
  %unit = index.constant 1 : index
  %value_head_count = index.constant 48 : index
  %workgroup_size = index.constant 128 : index
  %units = target.execution.unit.count : index
  %queued_unit_limit = index.constant 32 : index
  %rows_per_unit = index.constant 4 : index
  %queued_units = index.min %units, %queued_unit_limit : index
  %row_budget = index.mul %queued_units, %rows_per_unit : index
  %row_workers = index.min %rows, %row_budget : index
  kernel.launch.config workgroups(%value_head_count, %row_workers, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_capacity: index, %control: buffer, %rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer) {
  %head = kernel.workgroup.id<x> : index
  %first_token = kernel.workgroup.id<y> : index
  %row_step = kernel.workgroup.count<y> : index
  %origin = index.constant 0 : offset
  %counts = buffer.view %control[%origin] : buffer -> view<1xi32>
  %count_word = view.load %counts[0] : view<1xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %token_count = index.assume %count_value [ge(%count_value, 0), le(%count_value, %token_capacity)] : index
  %lane = kernel.workitem.id<x> : index
  %output_is_f16 = scalar.constant false : i1
  scf.for %token = [%first_token to %token_count step %row_step] {
    template.apply<@qwen38.gdn_norm_gate_prefill.body>(%output_is_f16, %head, %token, %lane, %token_capacity, %rms_epsilon, %raw_output, %norm_weight, %z, %output) : (i1, index, index, index, index, f32, buffer, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def export("qwen38_gdn_norm_gate_f16_prefill") @qwen38_gdn_norm_gate_f16_prefill(%live_rows: index) {
  %rows = index.assume %live_rows [range(%live_rows, 0, 512)] : index
  %unit = index.constant 1 : index
  %value_head_count = index.constant 48 : index
  %workgroup_size = index.constant 128 : index
  %units = target.execution.unit.count : index
  %queued_unit_limit = index.constant 32 : index
  %rows_per_unit = index.constant 4 : index
  %queued_units = index.min %units, %queued_unit_limit : index
  %row_budget = index.mul %queued_units, %rows_per_unit : index
  %row_workers = index.min %rows, %row_budget : index
  kernel.launch.config workgroups(%value_head_count, %row_workers, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_capacity: index, %control: buffer, %rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer) {
  %head = kernel.workgroup.id<x> : index
  %first_token = kernel.workgroup.id<y> : index
  %row_step = kernel.workgroup.count<y> : index
  %origin = index.constant 0 : offset
  %counts = buffer.view %control[%origin] : buffer -> view<1xi32>
  %count_word = view.load %counts[0] : view<1xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %token_count = index.assume %count_value [ge(%count_value, 0), le(%count_value, %token_capacity)] : index
  %lane = kernel.workitem.id<x> : index
  %output_is_f16 = scalar.constant true : i1
  scf.for %token = [%first_token to %token_count step %row_step] {
    template.apply<@qwen38.gdn_norm_gate_prefill.body>(%output_is_f16, %head, %token, %lane, %token_capacity, %rms_epsilon, %raw_output, %norm_weight, %z, %output) : (i1, index, index, index, index, f32, buffer, buffer, buffer, buffer)
  }
  kernel.return
}
