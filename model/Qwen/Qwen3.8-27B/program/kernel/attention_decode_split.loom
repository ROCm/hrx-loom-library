  %final_max, %final_sum, %final_output0, %final_output1, %final_output2, %final_output3 = scf.for %key_origin = [%split_begin to %split_end step %c64](%current_max = %negative_f32x4 : vector<4xf32>, %current_sum = %c0_f32x4 : vector<4xf32>, %current_output0 = %output_zero0 : vector<[%output_elements]xf32>, %current_output1 = %output_zero1 : vector<[%output_elements]xf32>, %current_output2 = %output_zero2 : vector<[%output_elements]xf32>, %current_output3 = %output_zero3 : vector<[%output_elements]xf32>) -> (vector<4xf32>, vector<4xf32>, vector<[%output_elements]xf32>, vector<[%output_elements]xf32>, vector<[%output_elements]xf32>, vector<[%output_elements]xf32>) {
    %remaining = index.sub %split_end, %key_origin : index
