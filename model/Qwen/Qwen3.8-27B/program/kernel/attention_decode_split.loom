    %score_init_values = vector.splatf 0.0 : vector<[%matrix_elements]xf32>
    %score_init = vector.fragment<init> %score_init_values shape [%m, %n] : vector<[%matrix_elements]xf32>
    %score_fragment = scf.for %head_tile = [%c0 to %c256 step %c16](%score_accumulator = %score_init : vector<[%matrix_elements]xf32>) -> (vector<[%matrix_elements]xf32>) unroll schedule(recurrence) {
      %key_fragment = vector.fragment.load<lhs> %key_value_stage_view[%subgroup_score_row, %head_tile] shape [%m, %k] : view<64x264xf16> -> vector<[%operand_elements]xf16>
      %query_fragment = vector.fragment.load<rhs> %query_transposed_view[%head_tile, %c0] shape [%k, %n] : view<256x16xf16, %query_transposed_layout> -> vector<[%operand_elements]xf16>
      %next_score_accumulator = vector.mma %key_fragment, %query_fragment, %score_accumulator : vector<[%operand_elements]xf16>, vector<[%operand_elements]xf16>, vector<[%matrix_elements]xf32>
