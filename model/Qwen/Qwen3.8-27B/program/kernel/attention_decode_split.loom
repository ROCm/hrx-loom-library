    %scaled_output3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output3, %fragment_scale : vector<[%output_elements]xf32>
    %next_output0 = template.apply<@tensor.matrix.f16_16x16.accumulate_f32>(%output_elements, %c64, %c64, %probability_transposed_layout, %probability_stage, %c64, %key_value_columns, %key_value_stage, %c0_offset, %c0, %product_column0, %scaled_output0) : (index, index, index, encoding<layout>, buffer, index, index, buffer, offset, index, index, vector<[%output_elements]xf32>) -> (vector<[%output_elements]xf32>)
    %next_output1 = template.apply<@tensor.matrix.f16_16x16.accumulate_f32>(%output_elements, %c64, %c64, %probability_transposed_layout, %probability_stage, %c64, %key_value_columns, %key_value_stage, %c0_offset, %c0, %product_column1, %scaled_output1) : (index, index, index, encoding<layout>, buffer, index, index, buffer, offset, index, index, vector<[%output_elements]xf32>) -> (vector<[%output_elements]xf32>)
    %next_output2 = template.apply<@tensor.matrix.f16_16x16.accumulate_f32>(%output_elements, %c64, %c64, %probability_transposed_layout, %probability_stage, %c64, %key_value_columns, %key_value_stage, %c0_offset, %c0, %product_column2, %scaled_output2) : (index, index, index, encoding<layout>, buffer, index, index, buffer, offset, index, index, vector<[%output_elements]xf32>) -> (vector<[%output_elements]xf32>)
    %next_output3 = template.apply<@tensor.matrix.f16_16x16.accumulate_f32>(%output_elements, %c64, %c64, %probability_transposed_layout, %probability_stage, %c64, %key_value_columns, %key_value_stage, %c0_offset, %c0, %product_column3, %scaled_output3) : (index, index, index, encoding<layout>, buffer, index, index, buffer, offset, index, index, vector<[%output_elements]xf32>) -> (vector<[%output_elements]xf32>)
    // All V fragment reads complete before the next tile replaces K/V LDS.
