    %column_offset0 = index.constant 0 : index
    %product_column0 = index.add %subgroup_product_channel, %column_offset0 : index
    %scaled_output0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output0, %fragment_scale : vector<[%output_elements]xf32>
    %column_offset1 = index.constant 64 : index
    %product_column1 = index.add %subgroup_product_channel, %column_offset1 : index
    %scaled_output1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_output1, %fragment_scale : vector<[%output_elements]xf32>
    %column_offset2 = index.constant 128 : index
