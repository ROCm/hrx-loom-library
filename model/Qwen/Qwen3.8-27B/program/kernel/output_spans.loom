// Gather and normalize selected packed output rows. The epoch producer
// supplies row correspondence directly; no inverse span search is needed.
// Padded head rows are cleared so projection cohorts cannot consume
// activations from an earlier epoch.

config.decl @qwen38.packet_capacity : %value: index where [range(%value, 2, 2147483646), multiple_of(%value, 2)]

func.decl @qwen38_packet_selection_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_policy_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_identity_origin(%capacity: index) -> (offset)

template.decl @qwen38.rmsnorm_f32.row(%input_row_count: index, %input_row: index, %output_origin: offset, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

// The epoch producer records selected packed rows while constructing spans.
// Consumers need no inverse search through the span table. Every padded head
// row is zeroed here, so projection cohorts never read stale activations when
// output cardinality changes or a chunk requests no output.
kernel.def export("qwen38_output_normalize_spans") @qwen38_output_normalize_spans(%output_capacity: index) {
  %outputs = index.assume %output_capacity [range(%output_capacity, 1, 2147483647)] : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%outputs, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %packet_capacity = config.get @qwen38.packet_capacity : index
  %ordinal_value = kernel.workgroup.id<x> : index
  %ordinal = index.assume %ordinal_value [ge(%ordinal_value, 0), lt(%ordinal_value, %packet_capacity)] : index
  %zero_origin = index.constant 0 : offset
  %selection_origin = func.call @qwen38_packet_selection_origin(%packet_capacity) : (index) -> (offset)
  %row_bytes = index.constant 20480 : offset
  %output_origin = index.scale %ordinal, %row_bytes : index, offset -> offset
  %metadata = buffer.assume.memory_space<constant> %epoch : buffer
  %header = buffer.view %metadata[%zero_origin] : buffer -> view<3xi32>
  %count_word = view.load %header[2] : view<3xi32> -> i32
  %count = index.cast %count_word : i32 to index
  %active = index.cmp ult, %ordinal, %count : index
  scf.if %active {
    %selection = buffer.view %metadata[%selection_origin] : buffer -> view<[%packet_capacity]xi32>
    %row_word = view.load %selection[%ordinal] : view<[%packet_capacity]xi32> -> i32
    %row_value = index.cast %row_word : i32 to index
    %row = index.assume %row_value [range(%row_value, 0, 511)] : index
    %capacity = index.constant 512 : index
    template.apply<@qwen38.rmsnorm_f32.row>(%capacity, %row, %output_origin, %epsilon, %input, %weight, %output) : (index, index, offset, f32, buffer, buffer, buffer)
  } else {
    %lane = kernel.workitem.id<x> : index
    %threads = index.constant 256 : index
    %hidden = index.constant 5120 : index
    %c0_0 = scalar.constant 0.0 : f32
    %row = buffer.view %output[%output_origin] : buffer -> view<5120xf32>
    scf.for %element = [%lane to %hidden step %threads] {
      view.store %c0_0, %row[%element] : f32, view<5120xf32>
    }
  }
  kernel.return
}
