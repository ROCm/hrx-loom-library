// Dense Qwen3.8 learned-position and normalization launch contracts.
// Image geometry specializes shared F32 algorithms; each 256-thread workgroup
// owns one patch row in the trained 2x2 merge order. Position addition updates
// the retained residual in place. Final normalization writes a distinct output.

amdgpu.target<gfx11-generic> @qwen38_vision_gfx11 {subgroup_size = 32}

config.decl @qwen38.vision.image_height : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.decl @qwen38.vision.image_width : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

template.decl @qwen38.vision.statistics(%rows_value: index, %residual: buffer, %statistics: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_statistics() {
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch_height = index.div %image_height, %c16 : index
  %patch_width = index.div %image_width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%residual: buffer, %statistics: buffer) {
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch = index.constant 16 : index
  %height = index.div %image_height, %patch : index
  %width = index.div %image_width, %patch : index
  %rows = index.mul %height, %width : index
  template.apply<@qwen38.vision.statistics>(%rows, %residual, %statistics) : (index, buffer, buffer)
  kernel.return
}

template.decl @qwen38.vision.position_statistics(%image_height: index, %image_width: index, %position_table: buffer, %residual: buffer, %statistics: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_position_layernorm_statistics() {
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch_height = index.div %image_height, %c16 : index
  %patch_width = index.div %image_width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%position_table: buffer, %residual: buffer, %statistics: buffer) {
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  template.apply<@qwen38.vision.position_statistics>(%image_height, %image_width, %position_table, %residual, %statistics) : (index, index, buffer, buffer, buffer)
  kernel.return
}

template.decl @qwen38.vision.layernorm_apply(%rows_value: index, %residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.def target(@qwen38_vision_gfx11) @qwen38_vision_layernorm_apply() {
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch_height = index.div %image_height, %c16 : index
  %patch_width = index.div %image_width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %area = index.mul %image_height, %image_width : index
  %patch_area = index.constant 256 : index
  %rows = index.div %area, %patch_area : index
  template.apply<@qwen38.vision.layernorm_apply>(%rows, %residual, %statistics, %weight, %bias, %output) : (index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}
