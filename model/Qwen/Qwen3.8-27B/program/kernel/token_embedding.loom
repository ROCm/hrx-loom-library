// Q5_K embedding gather and mixed text/image input assembly. Token IDs stay
// device-resident, and selected immutable GGUF rows expand into the model's
// F32 residual representation. Tagged feature inputs use explicit physical
// feature rows instead of interpreting image data as token IDs.
// The control header's first i32 is the live token count, independent of the
// dispatch bucket. Inactive rows are zero and never read input records.

func.decl @qwen38_input_token(%mixed: index, %capacity: index, %inputs: buffer, %input: index) -> (i32)

func.decl @ggml_q5_k_load_chunk16(%weight: buffer, %row_byte_base: offset, %q5_block: index, %q5_group: index, %q5_half: index) -> (vector<16xi8>, f32, f32)

template.decl @qwen38.token_embedding_q5k_f32.row(%token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer)

// Exact Qwen3.8 Q5_K token embedding gather.
//
// Token IDs remain device resident across generation steps. Each workgroup
// gathers one immutable GGUF embedding row and expands it directly to the F32
// residual ABI consumed by the base-model command programs.
// Expands one selected embedding row at an explicit output byte offset. The
// prefill and decode wrappers differ only in how they select that row.
template.def<@qwen38.token_embedding_q5k_f32.row> device @qwen38_token_embedding_q5k_f32_row(%token_id_i32: i32, %output_byte_offset: offset, %weight: buffer, %output: buffer) {
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %c2 = index.constant 2 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %chunk_count = index.constant 320 : index
  %row_bytes = index.constant 3520 : offset
  %weight_noalias, %output_noalias = buffer.assume.noalias %weight, %output : buffer, buffer
  %output_view = buffer.view %output_noalias[%output_byte_offset] : buffer -> view<5120xf32>
  %token_id0 = index.cast %token_id_i32 : i32 to index
  %token_id = index.assume %token_id0 [range(%token_id0, 0, 248319)] : index
  %row_byte_base = index.scale %token_id, %row_bytes : index, offset -> offset
  scf.for %chunk = [%workitem to %chunk_count step %c256] {
    %q5_block = index.div %chunk, %c16 : index
    %block_chunk = index.rem %chunk, %c16 : index
    %q5_group0 = index.div %block_chunk, %c2 : index
    %q5_group = index.assume %q5_group0 [range(%q5_group0, 0, 7)] : index
    %q5_half0 = index.rem %block_chunk, %c2 : index
    %q5_half = index.assume %q5_half0 [range(%q5_half0, 0, 1)] : index
    %quantized, %d_scale, %dmin_scale = func.call @ggml_q5_k_load_chunk16(%weight_noalias, %row_byte_base, %q5_block, %q5_group, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
    %codes = vector.uitofp %quantized : vector<16xi8> to vector<16xf32>
    %d_scale_vector = vector.splat %d_scale : vector<16xf32>
    %dmin_scale_vector = vector.splat %dmin_scale : vector<16xf32>
    %scaled = vector.mulf %codes, %d_scale_vector : vector<16xf32>
    %values = vector.subf %scaled, %dmin_scale_vector : vector<16xf32>
    %element_base = index.mul %chunk, %c16 : index
    vector.store %values, %output_view[%element_base] : vector<16xf32>, view<5120xf32>
  }
  template.return
}

kernel.def export("qwen38_input_embedding_f32") @qwen38_input_embedding_f32(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%mixed_inputs: index, %control: buffer, %token_ids: buffer, %weight: buffer, %output: buffer) {
  %capacity = index.constant 512 : index
  %token0 = kernel.workgroup.id<x> : index
  %token = index.assume %token0 [range(%token0, 0, 511)] : index
  %c0_offset = index.constant 0 : offset
  %output_row_bytes = index.constant 20480 : offset
  %c0 = index.constant 0 : index
  %output_byte_offset = index.scale %token, %output_row_bytes : index, offset -> offset
  %metadata = buffer.assume.memory_space<constant> %control : buffer
  %header = buffer.view %metadata[%c0_offset] : buffer -> view<3xi32>
  %live_word = view.load %header[0] : view<3xi32> -> i32
  %live_count = index.cast %live_word : i32 to index
  %active = index.cmp ult, %token, %live_count : index
  scf.if %active {
    %no_feature = scalar.constant 0 : i32
    %is_mixed = index.cmp ne, %mixed_inputs, %c0 : index
    %feature_offset = scf.if %is_mixed -> (i32) {
      %records = buffer.view %token_ids[%c0_offset] : buffer -> view<512x8xi32>
      %offset = view.load %records[%token, 1] : view<512x8xi32> -> i32
      scf.yield %offset : i32
    } else {
      scf.yield %no_feature : i32
    }
    %feature = scalar.cmpi ne, %feature_offset, %no_feature : i32
    scf.if %feature {
      %source_offset = index.cast %feature_offset : i32 to offset
      %source = buffer.view %token_ids[%source_offset] : buffer -> view<5120xf32>
      %target = buffer.view %output[%output_byte_offset] : buffer -> view<5120xf32>
      %workitem = kernel.workitem.id<x> : index
      %c4 = index.constant 4 : index
      %stride = index.constant 1024 : index
      %width = index.constant 5120 : index
      %first = index.mul %workitem, %c4 : index
      scf.for %channel = [%first to %width step %stride] {
        %value = vector.load %source[%channel] : view<5120xf32> -> vector<4xf32>
        vector.store %value, %target[%channel] : vector<4xf32>, view<5120xf32>
      }
    } else {
      %token_id = func.call @qwen38_input_token(%mixed_inputs, %capacity, %token_ids, %token) : (index, index, buffer, index) -> (i32)
      template.apply<@qwen38.token_embedding_q5k_f32.row>(%token_id, %output_byte_offset, %weight, %output) : (i32, offset, buffer, buffer)
    }
  } else {
    %target = buffer.view %output[%output_byte_offset] : buffer -> view<5120xf32>
    %workitem = kernel.workitem.id<x> : index
    %c4 = index.constant 4 : index
    %stride = index.constant 1024 : index
    %width = index.constant 5120 : index
    %first = index.mul %workitem, %c4 : index
    %zero = vector.constant 0.0 : vector<4xf32>
    scf.for %channel = [%first to %width step %stride] {
      vector.store %zero, %target[%channel] : vector<4xf32>, view<5120xf32>
    }
  }
  kernel.return
}

kernel.def export("qwen38_token_embedding_q5k_f32_decode") @qwen38_token_embedding_q5k_f32_decode() {
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_id: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c0_offset = index.constant 0 : offset
  %token_id_view = buffer.view %token_id[%c0_offset] : buffer -> view<1xi32>
  %token_id_i32 = view.load %token_id_view[%c0] : view<1xi32> -> i32
  template.apply<@qwen38.token_embedding_q5k_f32.row>(%token_id_i32, %c0_offset, %weight, %output) : (i32, offset, buffer, buffer)
  kernel.return
}
