// Device-controlled live-prefix wrapper over the shared Q6_K/Q8_1 panel body.
// K, N, and the positive workgroup budget are workload values. The first I32
// control word is the live row count; row_begin names this eight-row cohort.
// Wholly inactive cohorts leave output untouched. A partially live cohort
// retains all eight rows, and downstream consumers use the same live prefix.

template.decl @ggml.q6k.q8_1_x4.panels.body(%rows: index, %panels: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.def @qwen38_output_projection_q6k_m8_prefix(%inputs: index, %output_size: index, %workgroup_budget: index) {
  %outputs = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %budget = index.assume %workgroup_budget [range(%workgroup_budget, 1, 2147483647)] : index
  %tile_width = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_outputs = index.add %outputs, %padding : index
  %tiles = index.div %padded_outputs, %tile_width : index
  %groups = index.min %tiles, %budget : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%row_begin: index, %inputs: index, %outputs: index, %control: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.assume.memory_space<constant> %control : buffer
  %header = buffer.view %metadata[%origin] : buffer -> view<1xi32>
  %count_word = view.load %header[0] : view<1xi32> -> i32
  %count = index.cast %count_word : i32 to index
  %active = index.cmp ult, %row_begin, %count : index
  scf.if %active {
    %rows = index.constant 8 : index
    %panels = index.constant 2 : index
    template.apply<@ggml.q6k.q8_1_x4.panels.body>(%rows, %panels, %inputs, %outputs, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}
