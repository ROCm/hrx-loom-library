// Model output normalization, Q6_K vocabulary projection, and token
// selection. Logits and intermediate winners remain device-local; selected-
// row forms compact only requested outputs. Target sampling and draft
// candidate selection share the projection ABI without changing checkpoint
// ownership.

target.decl @qwen38_execution

func.decl pure @qwen38_output_workgroup_budget() -> (index)

kernel.decl @ggml_quantize_q8_1_x4_f32_bounded(%token_count: index, %input_size: index, %workgroup_budget: index) launch(%token_count_argument: index, %input_size_argument: index, %input: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_panels_m1(%input_size: index, %output_size: index, %workgroup_budget: index) launch(%input_size_argument: index, %output_size_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_panels_m2(%input_size: index, %output_size: index, %workgroup_budget: index) launch(%input_size_argument: index, %output_size_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_panels_m3(%input_size: index, %output_size: index, %workgroup_budget: index) launch(%input_size_argument: index, %output_size_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_panels_m4(%input_size: index, %output_size: index, %workgroup_budget: index) launch(%input_size_argument: index, %output_size_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_panels_m8(%input_size: index, %output_size: index, %workgroup_budget: index) launch(%input_size_argument: index, %output_size_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_panels_m32(%input_size: index, %output_size: index, %workgroup_budget: index) launch(%input_size_argument: index, %output_size_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_decode() launch(%epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_prefill(%token_count: index) launch(%token_count_argument: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_prefill_last() launch(%control: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

command.decl @qwen38_dispatch_greedy_argmax_partial_rows_f32(%dispatch_token_count: index, %dispatch_logit_stride: index, %dispatch_output_size: index, %token_count_argument: index, %logit_stride_argument: index, %output_size_argument: index) launch(%logits: buffer, %partial_logits: buffer, %partial_token_ids: buffer)

command.decl @qwen38_dispatch_greedy_argmax_reduce_rows_f32(%dispatch_token_count: index, %dispatch_output_size: index, %token_count_argument: index, %output_size_argument: index) launch(%partial_logits: buffer, %partial_token_ids: buffer, %token_ids: buffer)

kernel.decl @qwen38_sample_rows(%rows: index) launch(%rows_argument: index, %first: index, %epoch: buffer, %logits: buffer, %partial_logits: buffer, %partial_ids: buffer, %outputs: buffer)

kernel.decl @qwen38_sampling_partial_rows(%rows: index, %workgroup_budget: index) launch(%rows_argument: index, %first: index, %epoch: buffer, %logits: buffer, %partial_logits: buffer, %partial_ids: buffer)

// Quantize the normalized batch once, including when several vocabulary
// contractions reuse the same score storage.
command.def target(@qwen38_execution) @qwen38_pack_head_input(%rows: index, %input_origin: offset, %budget: index) launch(%normalized: buffer, %packed: buffer) {
  %width = index.constant 5120 : index
  %input = buffer.view %normalized[%input_origin] : buffer -> view<[%rows]x5120xf32>
  kernel.launch @ggml_quantize_q8_1_x4_f32_bounded[%rows, %width, %budget](%rows, %width, %input, %packed) : [index, index, index](index, index, view<[%rows]x5120xf32>, buffer)
  command.return
}

// Each contraction publishes whole F32 scores. The caller supplies either
// its dense result or a reusable window for selection.
command.def target(@qwen38_execution) @qwen38_project_packed_head(%token_count: index, %input_base: offset, %output_base: offset, %workgroup_budget: index) launch(%parameters: buffer, %normalized_q8: buffer, %logits: buffer) {
  %hidden_size = index.constant 5120 : index
  %vocabulary_size = index.constant 248320 : index
  %output_weight = command.parameter %parameters, "output.weight" : view<1042944000xi8>
  %hidden_q8_row_bytes = index.constant 5760 : offset
  %logits_row_bytes = index.constant 993280 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %wide_groups = index.div %token_count, %c32 : index
  scf.for %group = [%c0 to %wide_groups step %c1] unroll {
    %row = index.mul %group, %c32 : index
    %input_delta = index.scale %row, %hidden_q8_row_bytes : index, offset -> offset
    %input_origin = index.add %input_base, %input_delta : offset
    %score_delta = index.scale %row, %logits_row_bytes : index, offset -> offset
    %logits_origin = index.add %output_base, %score_delta : offset
    %input_group = buffer.view %normalized_q8[%input_origin] : buffer -> view<32x5760xi8>
    %logits_group = buffer.view %logits[%logits_origin] : buffer -> view<32x248320xf32>
    kernel.launch @ggml_linear_q6k_q8_1_x4_panels_m32[%hidden_size, %vocabulary_size, %workgroup_budget](%hidden_size, %vocabulary_size, %input_group, %output_weight, %logits_group) : [index, index, index](index, index, view<32x5760xi8>, view<1042944000xi8>, view<32x248320xf32>)
  }
  %wide_rows = index.mul %wide_groups, %c32 : index
  %first_group = index.div %wide_rows, %c8 : index
  %groups = index.div %token_count, %c8 : index
  scf.for %group = [%first_group to %groups step %c1] unroll {
    %row = index.mul %group, %c8 : index
    %input_delta = index.scale %row, %hidden_q8_row_bytes : index, offset -> offset
    %input_origin = index.add %input_base, %input_delta : offset
    %score_delta = index.scale %row, %logits_row_bytes : index, offset -> offset
    %logits_origin = index.add %output_base, %score_delta : offset
    %input_group = buffer.view %normalized_q8[%input_origin] : buffer -> view<8x5760xi8>
    %logits_group = buffer.view %logits[%logits_origin] : buffer -> view<8x248320xf32>
    kernel.launch @ggml_linear_q6k_q8_1_x4_panels_m8[%hidden_size, %vocabulary_size, %workgroup_budget](%hidden_size, %vocabulary_size, %input_group, %output_weight, %logits_group) : [index, index, index](index, index, view<8x5760xi8>, view<1042944000xi8>, view<8x248320xf32>)
  }
  %tail_begin = index.mul %groups, %c8 : index
  scf.for %row = [%tail_begin to %token_count step %c4] unroll {
    %remaining = index.sub %token_count, %row : index
    %count = index.min %remaining, %c4 : index
    %input_delta = index.scale %row, %hidden_q8_row_bytes : index, offset -> offset
    %input_origin = index.add %input_base, %input_delta : offset
    %score_delta = index.scale %row, %logits_row_bytes : index, offset -> offset
    %logits_origin = index.add %output_base, %score_delta : offset
    %input_group = buffer.view %normalized_q8[%input_origin] : buffer -> view<[%count]x5760xi8>
    %logits_group = buffer.view %logits[%logits_origin] : buffer -> view<[%count]x248320xf32>
    scf.switch %count {
      case 1 {
        kernel.launch @ggml_linear_q6k_q8_1_x4_panels_m1[%hidden_size, %vocabulary_size, %workgroup_budget](%hidden_size, %vocabulary_size, %input_group, %output_weight, %logits_group) : [index, index, index](index, index, view<[%count]x5760xi8>, view<1042944000xi8>, view<[%count]x248320xf32>)
      }
      case 2 {
        kernel.launch @ggml_linear_q6k_q8_1_x4_panels_m2[%hidden_size, %vocabulary_size, %workgroup_budget](%hidden_size, %vocabulary_size, %input_group, %output_weight, %logits_group) : [index, index, index](index, index, view<[%count]x5760xi8>, view<1042944000xi8>, view<[%count]x248320xf32>)
      }
      case 3 {
        kernel.launch @ggml_linear_q6k_q8_1_x4_panels_m3[%hidden_size, %vocabulary_size, %workgroup_budget](%hidden_size, %vocabulary_size, %input_group, %output_weight, %logits_group) : [index, index, index](index, index, view<[%count]x5760xi8>, view<1042944000xi8>, view<[%count]x248320xf32>)
      }
      default {
        kernel.launch @ggml_linear_q6k_q8_1_x4_panels_m4[%hidden_size, %vocabulary_size, %workgroup_budget](%hidden_size, %vocabulary_size, %input_group, %output_weight, %logits_group) : [index, index, index](index, index, view<[%count]x5760xi8>, view<1042944000xi8>, view<[%count]x248320xf32>)
      }
    }
  }
  command.return
}

// Explicit logits requests publish every row at the caller's offset.
command.def public target(@qwen38_execution) @qwen38_output_projection_logits(%token_count: index, %normalized_origin: offset, %output_origin: offset) launch(%parameters: buffer, %normalized: buffer, %logits: buffer) where [range(%token_count, 1, 512)] {
  %budget = func.call pure @qwen38_output_workgroup_budget() : () -> (index)
  %stride = index.constant 5760 : offset
  %length = index.scale %token_count, %stride : index, offset -> offset
  %packed = buffer.alloca<global> align(256) %length : buffer
  %packed_origin = index.constant 0 : offset
  command.launch @qwen38_pack_head_input[%token_count, %normalized_origin, %budget](%normalized, %packed) : [index, offset, index](buffer, buffer)
  command.launch @qwen38_project_packed_head[%token_count, %packed_origin, %output_origin, %budget](%parameters, %packed, %logits) : [index, offset, offset, index](buffer, buffer, buffer)
  command.return
}

// The widest projection shares a weight panel across 32 hidden rows. Finish
// selection for those rows before reusing their score and winner buffers.
// Packet identities remain relative to the complete epoch.
command.def target(@qwen38_execution) @qwen38_select_projection(%rows: index, %normalized_origin: offset, %output_origin: offset, %request_policy: i1) launch(%parameters: buffer, %normalized: buffer, %epoch: buffer, %token_ids: buffer) {
  %budget = func.call pure @qwen38_output_workgroup_budget() : () -> (index)
  %cohort = index.constant 32 : index
  %one = index.constant 1 : index
  %several_rows = index.cmp ugt, %rows, %one : index
  %sampled_windows = scalar.andi %request_policy, %several_rows : i1
  %live = scf.if %sampled_windows -> (index) {
    %header_origin = index.constant 0 : offset
    %header = buffer.view %epoch[%header_origin] : buffer -> view<3xi32>
    %count_word = view.load %header[2] : view<3xi32> -> i32
    %selected = index.cast %count_word : i32 to index
    scf.yield %selected : index
  } else {
    scf.yield %rows : index
  }
  %window = index.min %rows, %cohort : index
  %input_stride = index.constant 5760 : offset
  %score_stride = index.constant 993280 : offset
  %winner_stride = index.constant 244 : offset
  %id_stride = index.constant 4 : offset
  %input_bytes = index.scale %rows, %input_stride : index, offset -> offset
  %score_bytes = index.scale %window, %score_stride : index, offset -> offset
  %winner_bytes = index.scale %window, %winner_stride : index, offset -> offset
  %packed = buffer.alloca<global> align(256) %input_bytes : buffer
  %scores = buffer.alloca<global> align(256) %score_bytes : buffer
  %partial_scores = buffer.alloca<global> align(256) %winner_bytes : buffer
  %partial_ids = buffer.alloca<global> align(256) %winner_bytes : buffer
  command.launch @qwen38_pack_head_input[%rows, %normalized_origin, %budget](%normalized, %packed) : [index, offset, index](buffer, buffer)
  %c0 = index.constant 0 : index
  scf.for %first = [%c0 to %rows step %cohort] unroll {
    %remaining = index.sub %rows, %first : index
    %count = index.min %remaining, %cohort : index
    %input_offset = index.scale %first, %input_stride : index, offset -> offset
    %origin = index.constant 0 : offset
    %id_offset = index.scale %first, %id_stride : index, offset -> offset
    %id_origin = index.add %output_origin, %id_offset : offset
    %ids = buffer.view %token_ids[%id_origin] : buffer -> view<[%count]xi32>
    // A solitary selected row uses the scalar-row contraction. A wider
    // cohort shares each fetched weight across rows in the existing panel.
    %second = index.add %first, %one : index
    %wide = index.cmp ugt, %live, %second : index
    %wide_budget = scf.select %wide, %budget, %c0 : index
    %window_budget = scf.select %sampled_windows, %wide_budget, %budget : index
    command.launch @qwen38_project_packed_head[%count, %input_offset, %origin, %window_budget](%parameters, %packed, %scores) : [index, offset, offset, index](buffer, buffer, buffer)
    scf.if %sampled_windows {
      %single = index.cmp eq, %live, %second : index
      %single_budget = scf.select %single, %budget, %c0 : index
      command.launch @qwen38_project_packed_head[%one, %input_offset, %origin, %single_budget](%parameters, %packed, %scores) : [index, offset, offset, index](buffer, buffer, buffer)
    }
    scf.if %request_policy {
      kernel.launch @qwen38_sampling_partial_rows[%count, %budget](%count, %first, %epoch, %scores, %partial_scores, %partial_ids) : [index, index](index, index, buffer, buffer, buffer, buffer)
      kernel.launch @qwen38_sample_rows[%count](%count, %first, %epoch, %scores, %partial_scores, %partial_ids, %ids) : [index](index, index, buffer, buffer, buffer, buffer, view<[%count]xi32>)
    } else {
      %stride = index.constant 248320 : index
      %vocabulary = index.constant 248077 : index
      command.launch @qwen38_dispatch_greedy_argmax_partial_rows_f32[%count, %stride, %vocabulary, %count, %stride, %vocabulary](%scores, %partial_scores, %partial_ids) : [index, index, index, index, index, index](buffer, buffer, buffer)
      command.launch @qwen38_dispatch_greedy_argmax_reduce_rows_f32[%count, %vocabulary, %count, %vocabulary](%partial_scores, %partial_ids, %ids) : [index, index, index, index](buffer, buffer, view<[%count]xi32>)
    }
  }
  command.return
}

command.def public target(@qwen38_execution) @qwen38_output_projection_greedy(%token_count: index, %normalized_origin: offset, %output_origin: offset) launch(%parameters: buffer, %normalized: buffer, %token_id: buffer) where [range(%token_count, 1, 512)] {
  %request_policy = scalar.constant false : i1
  %epoch = buffer.null : buffer
  command.launch @qwen38_select_projection[%token_count, %normalized_origin, %output_origin, %request_policy](%parameters, %normalized, %epoch, %token_id) : [index, offset, offset, i1](buffer, buffer, buffer, buffer)
  command.return
}

command.def public target(@qwen38_execution) @qwen38_output_projection_sampled(%token_count: index) launch(%parameters: buffer, %epoch: buffer, %normalized: buffer, %token_ids: buffer) where [range(%token_count, 1, 2147483647)] {
  %request_policy = scalar.constant true : i1
  %origin = index.constant 0 : offset
  command.launch @qwen38_select_projection[%token_count, %origin, %origin, %request_policy](%parameters, %normalized, %epoch, %token_ids) : [index, offset, offset, i1](buffer, buffer, buffer, buffer)
  command.return
}

// Normalizes the one-row decode residual before the shared projection.
command.def target(@qwen38_execution) @qwen38_output_head(%residual_offset: offset) launch(%parameters: buffer, %residual: buffer, %normalized: buffer, %token_id: buffer) {
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %norm_weight = command.parameter %parameters, "output_norm.weight" : view<5120xf32>
  %residual_row = buffer.view %residual[%residual_offset] : buffer -> view<5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %residual_row, %norm_weight, %normalized) : (f32, view<5120xf32>, view<5120xf32>, buffer)
  %c1 = index.constant 1 : index
  %origin = index.constant 0 : offset
  command.launch @qwen38_output_projection_greedy[%c1, %origin, %origin](%parameters, %normalized, %token_id) : [index, offset, offset](buffer, buffer, buffer)
  command.return
}

// Publishes the normalized hidden row alongside the greedy token. Both output
// bindings are issue-time resources and may change on every execution.
command.def public target(@qwen38_execution) @qwen38_output_head_greedy_with_hidden(%residual_offset: offset) launch(%parameters: buffer, %residual: buffer, %normalized: buffer, %token_id: buffer) {
  command.launch @qwen38_output_head[%residual_offset](%parameters, %residual, %normalized, %token_id) : [offset](buffer, buffer, buffer, buffer)
  command.return
}

// Selects the final active prefill row from device control before using the
// same normalized-hidden and vocabulary projection path as decode.
command.def public target(@qwen38_execution) @qwen38_output_head_prefill_greedy_with_hidden() launch(%parameters: buffer, %residual: buffer, %control: buffer, %normalized: buffer, %token_id: buffer) {
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %norm_weight = command.parameter %parameters, "output_norm.weight" : view<5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_prefill_last(%control, %epsilon, %residual, %norm_weight, %normalized) : (buffer, f32, buffer, view<5120xf32>, buffer)
  %c1 = index.constant 1 : index
  %origin = index.constant 0 : offset
  command.launch @qwen38_output_projection_greedy[%c1, %origin, %origin](%parameters, %normalized, %token_id) : [index, offset, offset](buffer, buffer, buffer)
  command.return
}

// Normalizes and projects the complete depth-four verification span. One
// projection workgroup retains each vocabulary row while evaluating all four
// activations, so the immutable Q6_K output weight is decoded only once.
// Vocabulary logits remain transient; only token IDs and normalized hidden
// rows are visible outside the command program.
command.def public target(@qwen38_execution) @qwen38_output_head_rows_greedy_depth4() launch(%parameters: buffer, %residual: buffer, %normalized: buffer, %token_ids: buffer) {
  %token_count = index.constant 4 : index
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %norm_weight = command.parameter %parameters, "output_norm.weight" : view<5120xf32>

  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_count, %epsilon, %residual, %norm_weight, %normalized) : [index](index, f32, buffer, view<5120xf32>, buffer)
  %origin = index.constant 0 : offset
  command.launch @qwen38_output_projection_greedy[%token_count, %origin, %origin](%parameters, %normalized, %token_ids) : [index, offset, offset](buffer, buffer, buffer)
  command.return
}
