// Device continuation of the current packed text epoch. The shared sequence
// kernel receives the model context limit, mixed-input policy, token packet,
// and accepted results explicitly. It updates the continuation packet in
// place without a host round trip.

target.decl @qwen38_execution

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

config.decl @qwen38.attention.cache_capacity : %value: index where [range(%value, 1, 262144)]

config.decl @qwen38.packet_capacity : %value: index where [range(%value, 2, 2147483646), multiple_of(%value, 2)]

kernel.decl @qwen38_continue_dispatch() launch(%mixed_inputs: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

command.def public target(@qwen38_execution) @qwen38_continue() launch(%epoch: buffer, %tokens: buffer, %results: buffer) {
  %context = config.get @qwen38.attention.cache_capacity : index
  %capacity = config.get @qwen38.packet_capacity : index
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  kernel.launch @qwen38_continue_dispatch(%mixed_inputs, %context, %capacity, %epoch, %tokens, %results) : (index, index, index, buffer, buffer, buffer)
  command.return
}
