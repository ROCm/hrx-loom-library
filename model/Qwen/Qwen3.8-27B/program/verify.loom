// Target-authoritative verification of mixed known and speculative spans.
// Known work publishes recurrent state during traversal; speculative work
// captures transitions until acceptance. Attention entries beyond the
// accepted frontier remain unreachable, and acceptance selects the recurrent
// replay extent.

target.decl @qwen38_execution

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

config.decl @runner.qwen38.prefill_token_count : %value: index where [range(%value, 1, 512)]

config.decl @runner.qwen38.span_capacity : %value: index where [range(%value, 1, 2147483647)]

config.decl @qwen38.packet_capacity : %value: index where [range(%value, 2, 2147483646), multiple_of(%value, 2)]

config.def @runner.qwen38.verification_width = 4 : index

config.decl @runner.qwen38.capture_features : index

command.program.decl @qwen38_text_prefill_body_impl(%token_count: index, %schedule_token_count: index, %verification_depth: index, %span_capacity: index, %capture_features: index, %mixed_inputs: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %transition_capture: buffer, %rows: buffer, %input_tokens: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%verification_depth, 0, 8), range(%span_capacity, 0, 2147483647), range(%capture_features, 0, 1), range(%mixed_inputs, 0, 1)]

command.program.decl @qwen38_output_projection_sampled(%token_count: index) launch(%parameters: buffer, %epoch: buffer, %normalized: buffer, %token_ids: buffer) where [range(%token_count, 1, 2147483647)]

command.program.decl @qwen38_gdn_commit(%span_capacity: index, %token_capacity: index) launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer) where [range(%span_capacity, 1, 2147483647), range(%token_capacity, 1, 2147483647)]

kernel.decl @qwen38_input_embedding_f32(%token_count: index) launch(%mixed_inputs: index, %token_ids: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_output_normalize_spans(%output_capacity: index) launch(%epoch: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_accept_spans() launch(%mixed_inputs: index, %width: index, %token_capacity: index, %packet_capacity: index, %epoch: buffer, %inputs: buffer, %predictions: buffer, %committed: buffer, %replay: buffer, %results: buffer)

// Mixed known and speculative spans share the ordinary target token shape.
// GDN publishes known spans and captures speculative transitions. Attention
// may write beyond the accepted frontier; those entries remain unreachable.
// Device acceptance produces both the compact recurrent replay and the exact
// committed target-hidden/token pairing consumed by the following draft warm.
command.program.def public target(@qwen38_execution) @qwen38_verify() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %committed: buffer, %results: buffer) {
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  %spans = config.get @runner.qwen38.span_capacity : index
  %packet_capacity = config.get @qwen38.packet_capacity : index
  %capture_value = config.get @runner.qwen38.capture_features : index
  %capture_features = index.assume %capture_value [range(%capture_value, 0, 1)] : index
  %width_value = config.get @runner.qwen38.verification_width : index
  %width = index.assume %width_value [range(%width_value, 1, 8)] : index
  %span_outputs = index.mul %spans, %width : index
  %outputs = index.min %span_outputs, %tokens : index
  %hidden_row_bytes = index.constant 20480 : offset
  %output_row_bytes = index.constant 4 : offset
  %capture_token_bytes = index.constant 1984512 : offset
  %capture_bytes = index.scale %tokens, %capture_token_bytes : index, offset -> offset
  %replay_header = index.constant 12 : offset
  %descriptor_stride = index.constant 24 : offset
  %descriptor_bytes = index.scale %packet_capacity, %descriptor_stride : index, offset -> offset
  %replay_bytes = index.add %replay_header, %descriptor_bytes : offset
  %hidden_bytes = index.scale %outputs, %hidden_row_bytes : index, offset -> offset
  %output_bytes = index.scale %outputs, %output_row_bytes : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %predictions = buffer.alloca<global> align(256) %output_bytes : buffer
  %capture = buffer.alloca<global> align(256) %capture_bytes : buffer
  %replay = buffer.alloca<global> align(256) %replay_bytes : buffer
  %embedding = command.parameter %parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_input_embedding_f32[%tokens](%mixed_inputs, %input_tokens, %embedding, %residual) : [index](index, buffer, view<874086400xi8>, buffer)
  command.program.launch @qwen38_text_prefill_body_impl[%tokens, %tokens, %width, %spans, %capture_features, %mixed_inputs](%parameters, %residual, %epoch, %state, %state, %capture, %rows, %input_tokens) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %norm_weight = command.parameter %parameters, "output_norm.weight" : view<5120xf32>
  kernel.launch @qwen38_output_normalize_spans[%outputs](%epoch, %epsilon, %residual, %norm_weight, %normalized) : [index](buffer, f32, buffer, view<5120xf32>, buffer)
  %origin = index.constant 0 : offset
  command.program.launch @qwen38_output_projection_sampled[%outputs](%parameters, %epoch, %normalized, %predictions) : [index](buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_accept_spans(%mixed_inputs, %width, %tokens, %packet_capacity, %epoch, %input_tokens, %predictions, %committed, %replay, %results) : (index, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @qwen38_gdn_commit[%spans, %tokens](%parameters, %capture, %replay, %rows, %state) : [index, index](buffer, buffer, buffer, buffer, buffer)
  command.return
}
