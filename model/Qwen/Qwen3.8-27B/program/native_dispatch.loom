template.def<@qwen38.prefill.q6_panel_rows> target(@qwen38_dispatch_rdna) @qwen38_prefill_q6_panel_rows_rdna(%add_residual: i1) -> (index) {
  %residual_rows = index.constant 16 : index
  %plain_rows = index.constant 32 : index
  %rows = scf.select %add_residual, %residual_rows, %plain_rows : index
