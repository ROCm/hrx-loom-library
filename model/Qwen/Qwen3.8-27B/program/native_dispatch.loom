// The four-row target cohort keeps its separate channel distribution. This
// command serves the other cohort widths and selects the new bank at eight.
command.def public target(@qwen38_execution) @qwen38_dispatch_linear_q6k_f32_cohort(%rows: index, %inputs: index, %outputs: index) launch(%input: buffer, %weight: buffer, %output: buffer) {
  %c8 = index.constant 8 : index
  %eight = index.cmp eq, %rows, %c8 : index
  %supported = template.apply<@qwen38.linear.small_panel>(%rows) : (index) -> (i1)
  %small_panel = scalar.andi %eight, %supported : i1
  scf.if %small_panel {
    kernel.launch @qwen38_linear_q6k_f32_small_panel[%rows, %inputs, %outputs](%rows, %inputs, %outputs, %input, %weight, %output) : [index, index, index](index, index, index, buffer, buffer, buffer)
  } else {
    kernel.launch @qwen38_linear_q6k_f32_cohort[%inputs, %outputs](%inputs, %outputs, %input, %weight, %output) : [index, index](index, index, buffer, buffer, buffer)
  }
  command.return
}

