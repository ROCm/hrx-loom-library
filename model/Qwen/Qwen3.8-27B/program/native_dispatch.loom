template.decl @qwen38.prefill.integer_ffn(%tokens: index) -> (i1)

// The default keeps the requested FFN path. Higher-priority providers may
// select a shared packed activation panel for wide epochs.
template.def<@qwen38.prefill.integer_ffn> priority(-1) @qwen38_prefill_integer_ffn_default(%tokens: index) -> (i1) {
  %enabled = scalar.constant false : i1
  template.return %enabled : i1
}

// Wide CDNA epochs amortize one Q8 activation panel across both FFN weights.
// Smaller cohorts retain their existing floating-point or integer recipes.
template.def<@qwen38.prefill.integer_ffn> target(@qwen38_dispatch_cdna) @qwen38_prefill_integer_ffn_cdna(%tokens: index) -> (i1) {
  %wide = index.constant 512 : index
  %enabled = index.cmp uge, %tokens, %wide : index
  template.return %enabled : i1
}

// Preserve the requested recipe unless a tuned provider selects a smaller
// panel. The recipe is independent of the target's subgroup width.
template.def<@qwen38.prefill.projection_schedule> priority(-1) @qwen38_prefill_projection_schedule_default(%tokens: index) -> (index) {
  template.return %tokens : index
}

// Dispatch capacity and the native panel recipe are independent: several
// CDNA token tiles can share the current layer's packed weights in cache.
template.def<@qwen38.prefill.projection_schedule> target(@qwen38_dispatch_cdna) @qwen38_prefill_projection_schedule_cdna(%tokens: index) -> (index) {
  %tile = index.constant 64 : index
  %wide = index.cmp ugt, %tokens, %tile : index
  %schedule = scf.select %wide, %tile, %tokens : index
  template.return %schedule : index
}

