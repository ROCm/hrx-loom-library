  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %four = index.cmp eq, %rows, %c4 : index
  %eight = index.cmp eq, %rows, %c8 : index
  %enabled = scalar.ori %four, %eight : i1
  template.return %enabled : i1
}

