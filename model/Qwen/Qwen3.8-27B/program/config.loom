// Fixed specialization bounds for this model's command and kernel leaves.
// Run-dependent token, span and cache bounds are supplied at materialization.
// Shared motifs receive explicit operands from those leaves.
config.def @qwen38.attention.decode_split_count = 10 : index

config.def @qwen38.ffn.input_size = 5120 : index

config.def @qwen38.ffn.output_size = 17408 : index

config.def @qwen38.greedy_argmax.output_capacity = 248320 : index

config.def @qwen38.vision.image_height = 256 : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.def @qwen38.vision.image_width = 256 : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

// Native matrix layouts are selected by this model composition.
amdgpu.target<gfx11-generic> @tensor_matrix_rdna3

amdgpu.target<gfx9-4-generic> @tensor_matrix_cdna3

config.def @qwen38.vision.group_count = 1 : %value: index where [range(%value, 1, 16384)]

config.def @qwen38.vision.plane_count = 1 : %value: index where [range(%value, 1, 2)]

// Request admission bounds the combined patch extent before specialization.
func.def public pure inline @qwen38_vision_rows() -> (index) {
  %height = config.get @qwen38.vision.image_height : index
  %width = config.get @qwen38.vision.image_width : index
  %groups = config.get @qwen38.vision.group_count : index
  %area = index.mul %height, %width : index
  %patch_area = index.constant 256 : index
  %pair_rows = index.div %area, %patch_area : index
  %total = index.mul %groups, %pair_rows : index
  %rows = index.assume %total [range(%total, 4, 65536), multiple_of(%total, 4)] : index
  func.return %rows : index
}
