// Shared projection schedules preserve every GGUF bit and round operands to
// F16. The independent byte decoder and F64 dot product establish the oracle.

func.decl @q5_projection_headers(%inputs: index, %outputs: index, %weight: buffer)

kernel.decl @qwen38_linear_q5k_f16_mfma(%dispatch_tokens: index, %dispatch_inputs: index, %dispatch_outputs: index) launch(%token_count_data: buffer, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_q5k_f16_mfma_channel8(%dispatch_tokens: index, %dispatch_inputs: index, %dispatch_outputs: index) launch(%token_count_data: buffer, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

check.scenario public @q5_projection_mfma_check {
  check.requires<hal.amdgpu.target> {target = "gfx9-4-generic"}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %tokens = check.literal value(17) : index
    %token_count_data = check.generate.fill value(17) : tensor<1xi32>
    %inputs = check.literal value(512) : index
    %outputs = check.literal value(72) : index
    %seed0 = check.entropy.read %entropy[0] : check.entropy -> i64
    %seed1 = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed0) range(-1.0 to 1.0) : tensor<17x512xf32>
    %weight = check.generate.random.uniform seed(%seed1) range(-128 to 127) : tensor<72x2x176xi8>
    check.generate<@q5_projection_headers>(%inputs, %outputs, %weight) : (index, index, tensor<72x2x176xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<17x72xf32>
    check.compare<@qwen38_linear_q5k_f16_mfma, @q5_projection_canonical_expected>[%tokens, %inputs, %outputs](%token_count_data, %inputs, %outputs, %input, %weight, %output) : [index, index, index](tensor<1xi32>, index, index, tensor<17x512xf32>, tensor<72x2x176xi8>, tensor<17x72xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00050000000000000001) rtol(3.0000000000000001e-05) nan(different) : tensor<17x72xf32>, tensor<17x72xf32>
    }
  }
  check.return
}

