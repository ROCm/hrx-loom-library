// Covers the GDN alpha projection's 48-channel tail and requires bit-identical
// output from the generic and 32-token schedules.
// Packed bytes 0x01 give scale=1; the four lower groups have minimum=1
// and the four upper groups have minimum=0. Each block has 128 low-bit
// ones and 32 high-bit sixteens. With d=dmin=2^-10 and inputs 1/4,
// twenty blocks sum to 20*(128+32*16-128)/1024/4 = 2.5.
check.case public @qwen38_linear_q5k_f16_wmma_c64t32_f32acc_alpha_32_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %token_count = check.literal value(32) : index
  %input_size = check.literal value(5120) : index
  %output_size = check.literal value(48) : index
  %token_count_data = check.generate.fill value(32) : tensor<1xi32>
  %input = check.generate.fill value(0.25) : tensor<32x5120xf32>
  %weight = check.generate.fill value(1) : tensor<48x20x176xi8>
  kernel.launch @qwen38_q5_exact_headers[%output_size](%weight) : [index](tensor<48x20x176xi8>)
  %expected = check.generate.fill value(2.5) : tensor<32x48xf32>
  %generic = check.generate.fill value(0.0) : tensor<32x48xf32>
  %actual = check.generate.fill value(0.0) : tensor<32x48xf32>
  kernel.launch @qwen38_linear_q5k_f16_wmma[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %generic) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf32>, tensor<48x20x176xi8>, tensor<32x48xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c64t32_f32acc[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf32>, tensor<48x20x176xi8>, tensor<32x48xf32>)
  check.expect.close actual(%generic) expected(%expected) atol(0.000244140625) rtol(0.0) nan(same) : tensor<32x48xf32>
  check.expect.close actual(%actual) expected(%expected) atol(0.000244140625) rtol(0.0) nan(same) : tensor<32x48xf32>
  check.return
}

