kernel.decl @qwen38_linear_q5k_f16_wmma(%tokens: index, %inputs: index, %outputs: index) launch(%control: buffer, %inputs_argument: index, %outputs_argument: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_q5k_f16_wmma_c64t32_f32acc(%tokens: index, %inputs: index, %outputs: index) launch(%control: buffer, %inputs_argument: index, %outputs_argument: index, %input: buffer, %weight: buffer, %output: buffer)

// Both schedules decode the same Q5_K rows, but their F32 recurrences differ:
// generic rounds a fresh 256-product block before adding it; narrow retains
// the accumulator across blocks. The layout check uses exact operands so
// the numerical comparison retains sensitivity to integer layout mistakes.
// With both scales 2^-10, decoded F16 values are integer multiples of 2^-10
// with numerator at most 1953. Inputs are -1, 0, or 1, and every mathematical
// partial sum has numerator at most 5120*1953 < 2^24. Native matrix arithmetic
// may differ in low bits from ordered scalar FMA. The accepted discrepancy is
// 2^-12, one quarter of the smallest nonzero mathematical result difference.
kernel.def @qwen38_q5_exact_headers(%channels: index) {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%channels, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%weight: buffer) {
  %channel = kernel.workgroup.id<x> : index
  %block = kernel.workitem.id<x> : index
  %blocks = index.constant 20 : index
  %valid = index.cmp ult, %block, %blocks : index
  scf.if %valid {
    %row_bytes = index.constant 3520 : offset
    %block_bytes = index.constant 176 : offset
    %row_origin = index.scale %channel, %row_bytes : index, offset -> offset
    %block_origin = index.scale %block, %block_bytes : index, offset -> offset
    %origin = index.add %row_origin, %block_origin : offset
    %header = buffer.view %weight[%origin] : buffer -> view<2xf16>
    %scale = scalar.constant 0.0009765625 : f16
    view.store %scale, %header[0] : f16, view<2xf16>
    view.store %scale, %header[1] : f16, view<2xf16>
  }
  kernel.return
}

// Distinct rows and packed codes cover production widths and every tail class.
check.case public @qwen38_narrow_q5_block_staging {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(32) : index
  %inputs = check.literal value(5120) : index
  %outputs = check.param.choice values([48, 64, 80, 96, 112, 128, 6144, 10240, 17408]) name("channels") : index
  %control = check.generate.fill value(32) : tensor<1xi32>
  %seed = check.param.seed base(98412) count(2) : i64
  %input = check.generate.iota offset(-1.0) step(1.0) period(3) : tensor<32x5120xf32>
  %weight = check.generate.random.uniform seed(%seed) range(0 to 31) : tensor<[%outputs]x20x176xi8>
  kernel.launch @qwen38_q5_exact_headers[%outputs](%weight) : [index](tensor<[%outputs]x20x176xi8>)
  %expected = check.generate.fill value(-17.0) : tensor<32x[%outputs]xf32>
  %actual = check.generate.fill value(17.0) : tensor<32x[%outputs]xf32>
  kernel.launch @qwen38_linear_q5k_f16_wmma[%tokens, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %expected) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf32>, tensor<[%outputs]x20x176xi8>, tensor<32x[%outputs]xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c64t32_f32acc[%tokens, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf32>, tensor<[%outputs]x20x176xi8>, tensor<32x[%outputs]xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.000244140625) rtol(0.0) nan(same) : tensor<32x[%outputs]xf32>
  check.return
}

// Command programs use a zero workload to disable an otherwise prepared path.
