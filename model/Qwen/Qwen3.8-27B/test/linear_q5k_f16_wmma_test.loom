// Numerical checks for linear q5k f16 wmma.
// Production kernels come from the model library; independent reference
// kernels and fixture data belong only to this test root.
kernel.decl @ggml_q5k_f32_reference(%input_capacity: index) launch(%input_size: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_q5k_fix_differential_headers() launch(%weight: buffer)

kernel.decl @ggml_linear_q5k_q8_1_x4(%token_capacity: index, %input_capacity: index, %output_capacity: index) launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)

check.case public @qwen38_linear_q5k_f16_wmma_differential_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %token_count_data = check.generate.fill value(1) : tensor<1xi32>
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<256xf32>
  %weight = check.generate.fill value(1) : tensor<65x176xi8>
  %expected = check.generate.fill value(0.0) : tensor<65xf32>
  %actual = check.generate.fill value(0.0) : tensor<65xf32>
  kernel.launch @ggml_q5k_fix_differential_headers(%weight) : (tensor<65x176xi8>)
  kernel.launch @ggml_q5k_f32_reference[%input_size](%input_size, %input, %weight, %expected) : [index](index, tensor<256xf32>, tensor<65x176xi8>, tensor<65xf32>)
  kernel.launch @qwen38_linear_q5k_f16_c64t64[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<256xf32>, tensor<65x176xi8>, tensor<65xf32>)
  check.expect.approximate actual(%actual) expected(%expected) atol(0.5) rtol(0.02) nan(same) : tensor<65xf32>, tensor<65xf32>
  check.return
}

