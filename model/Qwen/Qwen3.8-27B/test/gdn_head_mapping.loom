func.decl @qwen38_gdn_key_head_for_value_head(%value_head: index) -> (index)

// Locks the model's tiled Q/K-to-V head mapping independently of the recurrent
// schedules that consume it.
kernel.def @qwen38_gdn_key_head_mapping_witness() {
  %unit = index.constant 1 : index
  %value_head_count = index.constant 48 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%value_head_count, %unit, %unit) : index
} launch(%output: buffer) {
  %value_head0 = kernel.workitem.id<x> : index
  %value_head = index.assume %value_head0 [range(%value_head0, 0, 47)] : index
  %key_head = func.call @qwen38_gdn_key_head_for_value_head(%value_head) : (index) -> (index)
  %key_head_i32 = index.cast %key_head : index to i32
  %c0_offset = index.constant 0 : offset
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<48xi32>
  view.store %key_head_i32, %output_view[%value_head] : i32, view<48xi32>
  kernel.return
}

// Numerical checks for gdn common.
// Production kernels come from the model library; independent reference
// kernels and fixture data belong only to this test root.
check.case public @qwen38_gdn_key_head_mapping_case {
  %actual = check.generate.fill value(-1) : tensor<48xi32>
  %expected = check.generate.iota offset(0) step(1) period(16) : tensor<48xi32>
  kernel.launch @qwen38_gdn_key_head_mapping_witness(%actual) : (tensor<48xi32>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<48xi32>
  check.return
}

check.benchmark<@qwen38_gdn_key_head_mapping_case> @qwen38_gdn_key_head_mapping_case_workload
