kernel.decl @qwen38_sample_rows(%rows: index) launch(%rows_argument: index, %epoch: buffer, %logits: buffer, %partial_logits: buffer, %partial_ids: buffer, %outputs: buffer)

kernel.decl @qwen38_sampling_partial_rows(%rows: index) launch(%rows_argument: index, %epoch: buffer, %logits: buffer, %partial_logits: buffer, %partial_ids: buffer)

template.decl @random.philox4x32(%counter0: i32, %counter1: i32, %counter2: i32, %counter3: i32, %seed0: i32, %seed1: i32) -> (i32, i32, i32, i32)

// Nonadjacent owners share a random stream; a third owner is greedy. The
// padded identity is deliberately invalid and must never be dereferenced.
func.def @sampling_packet(%seed: i64, %epoch: buffer) {
  %origin = index.constant 0 : offset
  %identity_origin = index.constant 12832 : offset
  %policy_origin = index.constant 9760 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %identities = buffer.view %epoch[%identity_origin] : buffer -> view<128x2xi32>
  %policies = buffer.view %epoch[%policy_origin] : buffer -> view<16x6xi32>
  %floats = buffer.view %epoch[%policy_origin] : buffer -> view<16x6xf32>
  %seeds = buffer.view %epoch[%policy_origin] : buffer -> view<16x3xi64>
  %c3 = scalar.constant 3 : i32
  %zero32 = scalar.constant 0 : i32
  %c2 = scalar.constant 2 : i32
  %c7 = scalar.constant 7 : i32
  %c15 = scalar.constant 15 : i32
  %position = scalar.constant 117 : i32
  %c0_0 = scalar.constant 0.0 : f32
  %temperature = scalar.constant 0.69999999999999996 : f32
  %c1_0 = scalar.constant 1.0 : f32
  %c20 = scalar.constant 20 : i32
  view.store %c3, %header[2] : i32, view<3xi32>
  view.store %c2, %identities[0, 0] : i32, view<128x2xi32>
  view.store %c7, %identities[1, 0] : i32, view<128x2xi32>
  view.store %c15, %identities[2, 0] : i32, view<128x2xi32>
  view.store %position, %identities[0, 1] : i32, view<128x2xi32>
  view.store %position, %identities[1, 1] : i32, view<128x2xi32>
  view.store %position, %identities[2, 1] : i32, view<128x2xi32>
  view.store %temperature, %floats[2, 0] : f32, view<16x6xf32>
  view.store %temperature, %floats[7, 0] : f32, view<16x6xf32>
  view.store %c0_0, %floats[15, 0] : f32, view<16x6xf32>
  view.store %c1_0, %floats[2, 1] : f32, view<16x6xf32>
  view.store %c1_0, %floats[7, 1] : f32, view<16x6xf32>
  view.store %c20, %policies[2, 2] : i32, view<16x6xi32>
  view.store %c20, %policies[7, 2] : i32, view<16x6xi32>
  view.store %zero32, %policies[2, 3] : i32, view<16x6xi32>
  view.store %zero32, %policies[7, 3] : i32, view<16x6xi32>
  view.store %zero32, %policies[15, 3] : i32, view<16x6xi32>
  view.store %seed, %seeds[2, 2] : i64, view<16x3xi64>
  view.store %seed, %seeds[7, 2] : i64, view<16x3xi64>
  func.return
}

// Tied logits give an analytic top-k support: exactly IDs [0,20). The
// Gumbel score is monotone in the uniform variate, so the reference selects
// that variate directly without calling the sampler or evaluating logarithms.
// Philox's known-answer contract is checked by the shared random provider.
func.def @sampling_rows_reference(%rows: index, %epoch: buffer, %logits: buffer, %partial_logits: buffer, %partial_ids: buffer, %outputs: buffer) {
  %origin = index.constant 0 : offset
  %seed_origin = index.constant 9824 : offset
  %seeds = buffer.view %epoch[%seed_origin] : buffer -> view<1xi64>
  %seed = view.load %seeds[0] : view<1xi64> -> i64
  %position = scalar.constant 117 : i32
  %shift32 = scalar.constant 32 : i64
  %seed_high = scalar.shrui %seed, %shift32 : i64
  %key0 = scalar.trunci %seed : i64 to i32
  %key1 = scalar.trunci %seed_high : i64 to i32
  %shift8 = scalar.constant 8 : i32
  %midpoint = scalar.constant 0.5 : f32
  %unit_scale = scalar.constant 5.9604644775390625e-08 : f32
  %upper = scalar.constant 0.99999994039535522 : f32
  %negative = scalar.constant -inf : f32
  %zero32 = scalar.constant 0 : i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c20 = index.constant 20 : index
  %score, %winner = scf.for %i = [%c0 to %c20 step %c1](%best = %negative : f32, %id = %zero32 : i32) -> (f32, i32) {
    %token = index.cast %i : index to i32
    %word, %unused1, %unused2, %unused3 = template.apply<@random.philox4x32>(%token, %position, %zero32, %zero32, %key0, %key1) : (i32, i32, i32, i32, i32, i32) -> (i32, i32, i32, i32)
    %mantissa = scalar.shrui %word, %shift8 : i32
    %number = scalar.uitofp %mantissa : i32 to f32
    %offset = scalar.addf %number, %midpoint : f32
    %unit = scalar.mulf %offset, %unit_scale : f32
    %score = scalar.minnumf %unit, %upper : f32
    %better = scalar.cmpf ogt, %score, %best : f32
    %next_score = scf.select %better, %score, %best : f32
    %next_id = scf.select %better, %token, %id : i32
    scf.yield %next_score, %next_id : f32, i32
  }
  %result = buffer.view %outputs[%origin] : buffer -> view<4xi32>
  view.store %winner, %result[0] : i32, view<4xi32>
  view.store %winner, %result[1] : i32, view<4xi32>
  view.store %zero32, %result[2] : i32, view<4xi32>
  func.return
}

check.scenario public @sampling_rows {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %rows = check.literal value(4) : index
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %epoch = check.generate.fill value(-1) : tensor<3594xi32>
    check.generate<@sampling_packet>(%seed, %epoch) : (i64, tensor<3594xi32>) -> ()
    %logits = check.generate.fill value(1.0) : tensor<4x248320xf32>
    %partial_logits = check.generate.fill value(1.0) : tensor<4x61xf32>
    %partial_ids = check.generate.iota offset(0) step(4096) period(61) : tensor<4x61xi32>
    %outputs = check.generate.fill value(-99) : tensor<4xi32>
    check.compare<@qwen38_sample_rows, @sampling_rows_reference>[%rows](%rows, %epoch, %logits, %partial_logits, %partial_ids, %outputs) : [index](index, tensor<3594xi32>, tensor<4x248320xf32>, tensor<4x61xf32>, tensor<4x61xi32>, tensor<4xi32>) -> () {
      check.expect.equal actual(%outputs) expected(%outputs) : tensor<4xi32>
    }
  }
  check.return
}

// Repeated and nonadjacent owners model speculative rows. Their highest logit
// is the tool opener; a disabled row must retain the next winner in the SAME
// partial tile as well as outranking the best value from another tile.
kernel.def @tool_permission_packet() {
  %c1_2 = index.constant 1 : index
  kernel.launch.config workgroups(%c1_2, %c1_2, %c1_2) workgroup_size(%c1_2, %c1_2, %c1_2) : index
} launch(%epoch: buffer, %logits: buffer, %expected: buffer) {
  %origin = index.constant 0 : offset
  %policy_origin = index.constant 9760 : offset
  %identity_origin = index.constant 12832 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %policies = buffer.view %epoch[%policy_origin] : buffer -> view<16x6xi32>
  %floats = buffer.view %epoch[%policy_origin] : buffer -> view<16x6xf32>
  %identities = buffer.view %epoch[%identity_origin] : buffer -> view<128x2xi32>
  %values = buffer.view %logits[%origin] : buffer -> view<8x248320xf32>
  %outputs = buffer.view %expected[%origin] : buffer -> view<8xi32>
  %c6_2 = scalar.constant 6 : i32
  view.store %c6_2, %header[2] : i32, view<3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %c0_2 = scalar.constant 0 : i32
  %c1_2 = scalar.constant 1 : i32
  %disabled = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c5 = scalar.constant 5 : i32
  %c15 = scalar.constant 15 : i32
  %c0_0 = scalar.constant 0.0 : f32
  %c1_0 = scalar.constant 1.0 : f32
  %half = scalar.constant 0.5 : f32
  %temperature = scalar.constant 0.69999999999999996 : f32
  %high = scalar.constant 100.0 : f32
  %padding = scalar.constant 1000.0 : f32
  %next = scalar.constant 10.0 : f32
  %other = scalar.constant -100.0 : f32
  %opener = scalar.constant 248058 : i32
  %allowed = scalar.constant 248059 : i32
  scf.for %row = [%c0 to %c6 step %c1] {
    %row_word = index.cast %row : index to i32
    %repeated = scalar.cmpi eq, %row_word, %c5 : i32
    %ordinary_owner = scalar.subi %c15, %row_word : i32
    %owner_word = scf.select %repeated, %c15, %ordinary_owner : i32
    %owner_value = index.cast %owner_word : i32 to index
    %owner = index.assume %owner_value [range(%owner_value, 0, 15)] : index
    %forbidden = scalar.cmpi ne, %owner_word, %c15 : i32
    %flags = scf.select %forbidden, %disabled, %c0_2 : i32
    %sampled = scalar.cmpi uge, %row_word, %disabled : i32
    %row_temperature = scf.select %sampled, %temperature, %c0_0 : f32
    %single = scalar.cmpi eq, %row_word, %disabled : i32
    %nucleus = scalar.cmpi eq, %row_word, %c3 : i32
    %top_k = scf.select %single, %c1_2, %c0_2 : i32
    %top_p = scf.select %nucleus, %half, %c1_0 : f32
    view.store %owner_word, %identities[%row, 0] : i32, view<128x2xi32>
    view.store %row_word, %identities[%row, 1] : i32, view<128x2xi32>
    view.store %row_temperature, %floats[%owner, 0] : f32, view<16x6xf32>
    view.store %top_p, %floats[%owner, 1] : f32, view<16x6xf32>
    view.store %top_k, %policies[%owner, 2] : i32, view<16x6xi32>
    view.store %flags, %policies[%owner, 3] : i32, view<16x6xi32>
    view.store %high, %values[%row, 248058] : f32, view<8x248320xf32>
    view.store %padding, %values[%row, 248077] : f32, view<8x248320xf32>
    view.store %next, %values[%row, 248059] : f32, view<8x248320xf32>
    view.store %other, %values[%row, 42] : f32, view<8x248320xf32>
    %winner = scf.select %forbidden, %allowed, %opener : i32
    view.store %winner, %outputs[%row] : i32, view<8xi32>
  }
  kernel.return
}

check.case public @sampling_tool_permissions {
  %rows = check.literal value(8) : index
  %epoch = check.generate.fill value(-1) : tensor<3594xi32>
  %logits = check.generate.fill value(-1000.0) : tensor<8x248320xf32>
  %expected = check.generate.fill value(-99) : tensor<8xi32>
  kernel.launch @tool_permission_packet(%epoch, %logits, %expected) : (tensor<3594xi32>, tensor<8x248320xf32>, tensor<8xi32>)
  %partials = check.generate.fill value(-99.0) : tensor<8x61xf32>
  %partial_ids = check.generate.fill value(-99) : tensor<8x61xi32>
  %outputs = check.generate.fill value(-99) : tensor<8xi32>
  kernel.launch @qwen38_sampling_partial_rows[%rows](%rows, %epoch, %logits, %partials, %partial_ids) : [index](index, tensor<3594xi32>, tensor<8x248320xf32>, tensor<8x61xf32>, tensor<8x61xi32>)
  kernel.launch @qwen38_sample_rows[%rows](%rows, %epoch, %logits, %partials, %partial_ids, %outputs) : [index](index, tensor<3594xi32>, tensor<8x248320xf32>, tensor<8x61xf32>, tensor<8x61xi32>, tensor<8xi32>)
  check.expect.equal actual(%outputs) expected(%expected) : tensor<8xi32>
  check.return
}

check.benchmark<@sampling_rows> @sampling_rows_workload

check.benchmark<@sampling_tool_permissions> @sampling_tool_permissions_workload
