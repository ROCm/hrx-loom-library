// Equal maxima in separate tiles must resolve to the lower token ID. The tail
// also exercises inactive workitems in the final partial workgroup.
check.case public @qwen38_greedy_argmax_cross_tile_tie_case {
  %token_count = check.literal value(1) : index
  %output_size = check.literal value(8201) : index
  %logits = check.generate.iota offset(0.0) step(1.0) period(4096) : tensor<8201xf32>
  %token_id = check.generate.fill value(-1) : tensor<1xi32>
  %parallel_token_id = check.generate.fill value(-1) : tensor<1xi32>
  %partial_logits = check.generate.fill value(0.0) : tensor<3xf32>
  %partial_token_ids = check.generate.fill value(-1) : tensor<3xi32>
  %expected = check.generate.fill value(4095) : tensor<1xi32>
  kernel.launch @qwen38_greedy_argmax_f32[%output_size](%output_size, %logits, %token_id) : [index](index, tensor<8201xf32>, tensor<1xi32>)
  kernel.launch @qwen38_greedy_argmax_partial_rows_f32[%token_count, %output_size, %output_size](%token_count, %output_size, %output_size, %logits, %partial_logits, %partial_token_ids) : [index, index, index](index, index, index, tensor<8201xf32>, tensor<3xf32>, tensor<3xi32>)
  kernel.launch @qwen38_greedy_argmax_reduce_rows_f32[%token_count, %output_size](%token_count, %output_size, %partial_logits, %partial_token_ids, %parallel_token_id) : [index, index](index, index, tensor<3xf32>, tensor<3xi32>, tensor<1xi32>)
  check.expect.equal actual(%token_id) expected(%expected) : tensor<1xi32>
  check.expect.equal actual(%parallel_token_id) expected(%expected) : tensor<1xi32>
  check.return
}

