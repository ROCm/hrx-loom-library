kernel.decl @qwen38_greedy_argmax_rows_f32(%dispatch_token_count0: index, %dispatch_output_size: index) launch(%token_count0: index, %output_size: index, %logits: buffer, %token_ids: buffer)

// Numerical checks for greedy argmax.
// Production kernels come from the model library; independent reference
// kernels and fixture data belong only to this test root.
check.case public @qwen38_greedy_argmax_nontrivial_winner_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %output_size = check.literal value(1009) : index
  %logits = check.generate.iota offset(0.0) step(1.0) period(1009) : tensor<1009xf32>
  %token_id = check.generate.fill value(-1) : tensor<1xi32>
  %expected = check.generate.fill value(1008) : tensor<1xi32>
  kernel.launch @qwen38_greedy_argmax_f32[%output_size](%output_size, %logits, %token_id) : [index](index, tensor<1009xf32>, tensor<1xi32>)
  check.expect.equal actual(%token_id) expected(%expected) : tensor<1xi32>
  check.return
}

// A fully tied row must select token zero rather than an execution-order-
// dependent workitem or subgroup.
check.case public @qwen38_greedy_argmax_equal_logit_tie_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %output_size = check.literal value(1009) : index
  %logits = check.generate.fill value(7.0) : tensor<1009xf32>
  %token_id = check.generate.fill value(-1) : tensor<1xi32>
  %expected = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @qwen38_greedy_argmax_f32[%output_size](%output_size, %logits, %token_id) : [index](index, tensor<1009xf32>, tensor<1xi32>)
  check.expect.equal actual(%token_id) expected(%expected) : tensor<1xi32>
  check.return
}

check.case public @qwen38_greedy_argmax_rows_nontrivial_winner_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %token_count = check.literal value(3) : index
  %output_size = check.literal value(1009) : index
  %logits = check.generate.iota offset(0.0) step(1.0) period(1009) : tensor<3x1009xf32>
  %token_ids = check.generate.fill value(-1) : tensor<3xi32>
  %expected = check.generate.fill value(1008) : tensor<3xi32>
  kernel.launch @qwen38_greedy_argmax_rows_f32[%token_count, %output_size](%token_count, %output_size, %logits, %token_ids) : [index, index](index, index, tensor<3x1009xf32>, tensor<3xi32>)
  check.expect.equal actual(%token_ids) expected(%expected) : tensor<3xi32>
  check.return
}

// Equal maxima in separate tiles must resolve to the lower token ID. The tail
// also exercises inactive workitems in the final partial workgroup.
check.case public @qwen38_greedy_argmax_cross_tile_tie_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %token_count = check.literal value(1) : index
  %output_size = check.literal value(8201) : index
  %logits = check.generate.iota offset(0.0) step(1.0) period(4096) : tensor<8201xf32>
  %token_id = check.generate.fill value(-1) : tensor<1xi32>
  %parallel_token_id = check.generate.fill value(-1) : tensor<1xi32>
  %partial_logits = check.generate.fill value(0.0) : tensor<3xf32>
  %partial_token_ids = check.generate.fill value(-1) : tensor<3xi32>
  %expected = check.generate.fill value(4095) : tensor<1xi32>
  kernel.launch @qwen38_greedy_argmax_f32[%output_size](%output_size, %logits, %token_id) : [index](index, tensor<8201xf32>, tensor<1xi32>)
  kernel.launch @qwen38_greedy_argmax_partial_rows_f32[%token_count, %output_size, %output_size](%token_count, %output_size, %output_size, %logits, %partial_logits, %partial_token_ids) : [index, index, index](index, index, index, tensor<8201xf32>, tensor<3xf32>, tensor<3xi32>)
  kernel.launch @qwen38_greedy_argmax_reduce_rows_f32[%token_count, %output_size](%token_count, %output_size, %partial_logits, %partial_token_ids, %parallel_token_id) : [index, index](index, index, tensor<3xf32>, tensor<3xi32>, tensor<1xi32>)
  check.expect.equal actual(%token_id) expected(%expected) : tensor<1xi32>
  check.expect.equal actual(%parallel_token_id) expected(%expected) : tensor<1xi32>
  check.return
}

