command.decl @qwen38_dispatch_greedy_argmax_partial_rows_f32(%dispatch_rows: index, %dispatch_stride: index, %dispatch_outputs: index, %rows: index, %stride: index, %outputs: index) launch(%logits: buffer, %partial_logits: buffer, %partial_ids: buffer)

command.decl @qwen38_dispatch_greedy_argmax_reduce_rows_f32(%dispatch_rows: index, %dispatch_outputs: index, %rows: index, %outputs: index) launch(%partial_logits: buffer, %partial_ids: buffer, %token_ids: buffer)

target.decl @qwen38_execution

// This is the two-stage sequence used by the model's output head, with logits
// supplied by the fixture instead of a full vocabulary projection.
command.def target(@qwen38_execution) @greedy_commands(%rows: index, %stride: index, %outputs: index) launch(%logits: buffer, %partial_logits: buffer, %partial_ids: buffer, %token_ids: buffer) {
  command.launch @qwen38_dispatch_greedy_argmax_partial_rows_f32[%rows, %stride, %outputs, %rows, %stride, %outputs](%logits, %partial_logits, %partial_ids) : [index, index, index, index, index, index](buffer, buffer, buffer)
  command.launch @qwen38_dispatch_greedy_argmax_reduce_rows_f32[%rows, %outputs, %rows, %outputs](%partial_logits, %partial_ids, %token_ids) : [index, index, index, index](buffer, buffer, buffer)
  command.return
}

// Each row places equal maxima across a subgroup, tile, or tail boundary.
// Padding is larger than every valid logit and must never compete.
func.def @greedy_ties_and_padding(%logits: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %rows = index.constant 3 : index
  %outputs = index.constant 8201 : index
  %stride = index.constant 8224 : index
  %winner = scalar.constant 1.0 : f32
  %padding = scalar.constant 1000.0 : f32
  %values = buffer.view %logits[%origin] : buffer -> view<3x8224xf32>
  view.store %winner, %values[0, 31] : f32, view<3x8224xf32>
  view.store %winner, %values[0, 64] : f32, view<3x8224xf32>
  view.store %winner, %values[1, 4095] : f32, view<3x8224xf32>
  view.store %winner, %values[1, 4096] : f32, view<3x8224xf32>
  view.store %winner, %values[2, 8192] : f32, view<3x8224xf32>
  view.store %winner, %values[2, 8200] : f32, view<3x8224xf32>
  scf.for %row = [%begin to %rows step %unit] {
    scf.for %column = [%outputs to %stride step %unit] {
      view.store %padding, %values[%row, %column] : f32, view<3x8224xf32>
    }
  }
  func.return
}

// A serial increasing-ID scan takes only strictly greater values. Ties retain
// the first index without using the device's workgroup reduction algorithm.
func.def @greedy_scan(%logits: view<3x8224xf32>, %row: index, %begin: index, %end: index) -> (f32, i32) where [range(%row, 0, 2), range(%begin, 0, 8200), range(%end, 1, 8201), lt(%begin, %end)] {
  %unit = index.constant 1 : index
  %initial = view.load %logits[%row, %begin] : view<3x8224xf32> -> f32
  %initial_id = index.cast %begin : index to i32
  %next = index.add %begin, %unit : index
  %value, %id = scf.for %column = [%next to %end step %unit](%best = %initial : f32, %best_id = %initial_id : i32) -> (f32, i32) {
    %candidate = view.load %logits[%row, %column] : view<3x8224xf32> -> f32
    %candidate_id = index.cast %column : index to i32
    %greater = scalar.cmpf ogt, %candidate, %best : f32
    %next_value = scf.select %greater, %candidate, %best : f32
    %next_id = scf.select %greater, %candidate_id, %best_id : i32
    scf.yield %next_value, %next_id : f32, i32
  }
  func.return %value, %id : f32, i32
}

func.def @greedy_commands_reference(%logits: buffer, %partial_logits: buffer, %partial_ids: buffer, %token_ids: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %rows = index.constant 3 : index
  %outputs = index.constant 8201 : index
  %partitions = index.constant 3 : index
  %tile = index.constant 4096 : index
  %input = buffer.view %logits[%origin] : buffer -> view<3x8224xf32>
  %values = buffer.view %partial_logits[%origin] : buffer -> view<3x3xf32>
  %ids = buffer.view %partial_ids[%origin] : buffer -> view<3x3xi32>
  %results = buffer.view %token_ids[%origin] : buffer -> view<3xi32>
  scf.for %row = [%begin to %rows step %unit] {
    scf.for %partition = [%begin to %partitions step %unit] {
      %start = index.mul %partition, %tile : index
      %limit = index.add %start, %tile : index
      %end = index.min %limit, %outputs : index
      %value, %id = func.call @greedy_scan(%input, %row, %start, %end) : (view<3x8224xf32>, index, index, index) -> (f32, i32)
      view.store %value, %values[%row, %partition] : f32, view<3x3xf32>
      view.store %id, %ids[%row, %partition] : i32, view<3x3xi32>
    }
    // The final oracle scans the original logits independently of partials.
    %value, %id = func.call @greedy_scan(%input, %row, %begin, %outputs) : (view<3x8224xf32>, index, index, index) -> (f32, i32)
    view.store %id, %results[%row] : i32, view<3xi32>
  }
  func.return
}

check.scenario public @greedy_command_ties_and_tail {
  %rows = check.literal value(3) : index
  %stride = check.literal value(8224) : index
  %outputs = check.literal value(8201) : index
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %logits = check.generate.random.uniform seed(%seed) range(-32.0 to -1.0) : tensor<3x8224xf32>
    check.generate<@greedy_ties_and_padding>(%logits) : (tensor<3x8224xf32>) -> ()
    %value_storage = check.generate.fill value(-99.0) : tensor<17xf32>
    %id_storage = check.generate.fill value(-99) : tensor<17xi32>
    %token_storage = check.generate.fill value(-99) : tensor<11xi32>
    %partial_logits = check.tensor.view %value_storage offset(16) : tensor<17xf32> -> tensor<3x3xf32>
    %partial_ids = check.tensor.view %id_storage offset(16) : tensor<17xi32> -> tensor<3x3xi32>
    %token_ids = check.tensor.view %token_storage offset(16) : tensor<11xi32> -> tensor<3xi32>
    check.compare<@greedy_commands, @greedy_commands_reference>[%rows, %stride, %outputs](%logits, %partial_logits, %partial_ids, %token_ids) : [index, index, index](tensor<3x8224xf32>, tensor<3x3xf32>, tensor<3x3xi32>, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<17xf32>
      check.expect.bitwise actual(%id_storage) expected(%id_storage) : tensor<17xi32>
      check.expect.bitwise actual(%token_storage) expected(%token_storage) : tensor<11xi32>
      check.expect.bitwise actual(%logits) expected(%logits) : tensor<3x8224xf32>
    }
  }
  check.return
}

check.benchmark<@greedy_command_ties_and_tail> @greedy_command_ties_and_tail_benchmark

