config.decl @qwen38.attention.pool_capacity : %value: index where [range(%value, 0, 4194304)]

kernel.decl @qwen38_attention_spans_split_mfma_partial(%dispatch_tokens: index, %dispatch_spans: index) launch(%tokens: index, %epoch: buffer, %rows: buffer, %layer: offset, %query: buffer, %state: buffer, %partials: buffer)

kernel.decl @qwen38_attention_spans_split_partial(%dispatch_tokens: index, %dispatch_spans: index) launch(%tokens: index, %epoch: buffer, %rows: buffer, %layer: offset, %query: buffer, %state: buffer, %partials: buffer)

kernel.decl @qwen38_attention_spans_split_reduce(%dispatch_tokens: index, %dispatch_spans: index) launch(%tokens: index, %epoch: buffer, %gate: buffer, %partials: buffer, %output: buffer)

// The fixture owns the byte layout independently of the production accessors.
// Trials cover shared pages, separate planes, odd pairs, page crossings, all
// eight verifier inputs, empty partitions, multi-tile partitions, and wholly
// inactive spans.
func.def @split_attention_fixture(%trial: index, %epoch: buffer, %rows: buffer) {
  %origin = index.constant 0 : offset
  %span_origin = index.constant 12 : offset
  %map_origin = index.constant 240 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%span_origin] : buffer -> view<4x6xi32>
  %records = buffer.view %rows[%origin] : buffer -> view<6x5xi64>
  %pages = buffer.view %rows[%map_origin] : buffer -> view<6x10xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c7 = index.constant 7 : index
  %c10 = index.constant 10 : index
  %c12 = index.constant 12 : index
  %absent = scalar.constant -1 : i32
  %c0_2 = scalar.constant 0 : i32
  %c1_2 = scalar.constant 1 : i32
  %c2_2 = scalar.constant 2 : i32
  %c3_2 = scalar.constant 3 : i32
  %c5_2 = scalar.constant 5 : i32
  %c8 = scalar.constant 8 : i32
  %c61 = scalar.constant 61 : i32
  %c59 = scalar.constant 59 : i32
  %c120 = scalar.constant 120 : i32
  %c127 = scalar.constant 127 : i32
  %c639 = scalar.constant 639 : i32
  %guard = scalar.constant 256 : i64
  %separate_origin = scalar.constant 8389120 : i64
  %shared = index.cmp eq, %trial, %c0 : index
  %eight_inputs = index.cmp eq, %trial, %c2 : index
  %long_history = index.cmp eq, %trial, %c4 : index
  %single = scalar.ori %eight_inputs, %long_history : i1
  %empty = index.cmp eq, %trial, %c3 : index
  %row_five_origin = scf.select %shared, %guard, %separate_origin : i64
  view.store %guard, %records[2, 2] : i64, view<6x5xi64>
  view.store %row_five_origin, %records[5, 2] : i64, view<6x5xi64>
  %row_two_map = scalar.constant 320 : i64
  %row_five_map = scalar.constant 440 : i64
  view.store %row_two_map, %records[2, 4] : i64, view<6x5xi64>
  view.store %row_five_map, %records[5, 4] : i64, view<6x5xi64>
  scf.for %block = [%c0 to %c10 step %c1] {
    %first_value = index.madd %block, %c5, %c3 : index
    %second_value = index.madd %block, %c7, %c3 : index
    %first = index.rem %first_value, %c12 : index
    %second = index.rem %second_value, %c12 : index
    %first_word = index.cast %first : index to i32
    %second_word = index.cast %second : index to i32
    view.store %first_word, %pages[2, %block] : i32, view<6x10xi32>
    view.store %second_word, %pages[5, %block] : i32, view<6x10xi32>
  }
  %span_count = scf.select %single, %c1_2, %c2_2 : i32
  %active_spans = scf.select %empty, %c0_2, %span_count : i32
  view.store %c8, %header[0] : i32, view<3xi32>
  view.store %active_spans, %header[1] : i32, view<3xi32>
  view.store %c0_2, %header[2] : i32, view<3xi32>
  %active = index.cmp ne, %trial, %c3 : index
  scf.if %active {
    %first_count = scf.select %shared, %c3_2, %c1_2 : i32
    %count = scf.select %eight_inputs, %c8, %first_count : i32
    %first_position = scf.select %shared, %c61, %c0_2 : i32
    %short_position = scf.select %eight_inputs, %c120, %first_position : i32
    %position = scf.select %long_history, %c639, %short_position : i32
    %begin = scf.select %shared, %c1_2, %c0_2 : i32
    %owner = scf.select %shared, %c2_2, %c5_2 : i32
    view.store %count, %spans[0, 0] : i32, view<4x6xi32>
    view.store %position, %spans[0, 1] : i32, view<4x6xi32>
    view.store %begin, %spans[0, 2] : i32, view<4x6xi32>
    view.store %owner, %spans[0, 3] : i32, view<4x6xi32>
    view.store %c0_2, %spans[0, 4] : i32, view<4x6xi32>
    view.store %absent, %spans[0, 5] : i32, view<4x6xi32>
    %has_second = index.cmp ult, %trial, %c2 : index
    scf.if %has_second {
      %count = scf.select %shared, %c1_2, %c5_2 : i32
      %position = scf.select %shared, %c127, %c59 : i32
      %begin = scf.select %shared, %c5_2, %c2_2 : i32
      %owner = scf.select %shared, %c5_2, %c2_2 : i32
      view.store %count, %spans[1, 0] : i32, view<4x6xi32>
      view.store %position, %spans[1, 1] : i32, view<4x6xi32>
      view.store %begin, %spans[1, 2] : i32, view<4x6xi32>
      view.store %owner, %spans[1, 3] : i32, view<4x6xi32>
      view.store %c0_2, %spans[1, 4] : i32, view<4x6xi32>
      view.store %absent, %spans[1, 5] : i32, view<4x6xi32>
    }
  }
  func.return
}

func.def inline @split_attention_reference_position(%paged: i1, %rows: buffer, %owner: index, %position: index) -> (index) {
  %physical = scf.if %paged -> (index) {
    %origin = index.constant 240 : offset
    %pages = buffer.view %rows[%origin] : buffer -> view<6x10xi32>
    %block_size = index.constant 64 : index
    %block = index.div %position, %block_size : index
    %within = index.rem %position, %block_size : index
    %page_word = view.load %pages[%owner, %block] : view<6x10xi32> -> i32
    %page_value = index.cast %page_word : i32 to index
    %page = index.assume %page_value [range(%page_value, 0, 11)] : index
    %index = index.madd %page, %block_size, %within : index
    scf.yield %index : index
  } else {
    scf.yield %position : index
  }
  func.return %physical : index
}

// VM dot products, softmax sums, and P*V accumulate in F64; exp uses the VM's
// F32 elementary-math recipe. This uses neither the production map/attention
// helpers nor its F16 operand rounding, and emits the public partial layout.
func.def @split_attention_partial_reference(%tokens: index, %epoch: buffer, %rows: buffer, %layer: offset, %query: buffer, %state: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %span_origin = index.constant 12 : offset
  %token_bytes = index.constant 2048 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %split_count = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c64 = index.constant 64 : index
  %heads = index.constant 24 : index
  %channels = index.constant 256 : index
  %logical_capacity = index.constant 640 : index
  %pool_capacity = config.get @qwen38.attention.pool_capacity : index
  %paged = index.cmp ne, %pool_capacity, %c0 : index
  %capacity = scf.select %paged, %pool_capacity, %logical_capacity : index
  %plane_bytes = index.scale %capacity, %token_bytes : index, offset -> offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%span_origin] : buffer -> view<4x6xi32>
  %records = buffer.view %rows[%origin] : buffer -> view<6x5xi64>
  %queries = buffer.view %query[%origin] : buffer -> view<9x24x256xf32>
  %partials = buffer.view %output[%origin] : buffer -> view<9x4x5x6x258xf32>
  %score_bytes = index.constant 5120 : offset
  %scores = buffer.alloca<private> align(16) %score_bytes : buffer
  %scratch = buffer.view %scores[%origin] : buffer -> view<640xf64>
  %c0_0 = scalar.constant 0.0 : f64
  %scale = scalar.constant 0.0625 : f64
  %negative = scalar.constant -1e+30 : f64
  %count_word = view.load %header[1] : view<3xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 4)] : index
  scf.for %span = [%c0 to %count step %c1] {
    %length_word = view.load %spans[%span, 0] : view<4x6xi32> -> i32
    %position_word = view.load %spans[%span, 1] : view<4x6xi32> -> i32
    %begin_word = view.load %spans[%span, 2] : view<4x6xi32> -> i32
    %owner_word = view.load %spans[%span, 3] : view<4x6xi32> -> i32
    %length_value = index.cast %length_word : i32 to index
    %length = index.assume %length_value [range(%length_value, 1, 8)] : index
    %position_value = index.cast %position_word : i32 to index
    %position = index.assume %position_value [range(%position_value, 0, 639)] : index
    %begin_value = index.cast %begin_word : i32 to index
    %begin = index.assume %begin_value [range(%begin_value, 0, 7)] : index
    %owner_value = index.cast %owner_word : i32 to index
    %owner = index.assume %owner_value [range(%owner_value, 0, 5)] : index
    %base_value = view.load %records[%owner, 2] : view<6x5xi64> -> i64
    %base_word = scalar.assume %base_value [range(%base_value, 256, 8389120)] : i64
    %base = index.cast %base_word : i64 to offset
    %key_origin = index.add %base, %layer : offset
    %value_origin = index.add %key_origin, %plane_bytes : offset
    %keys = buffer.view %state[%key_origin] : buffer -> view<[%capacity]x4x256xf16>
    %values = buffer.view %state[%value_origin] : buffer -> view<[%capacity]x4x256xf16>
    scf.for %local = [%c0 to %length step %c1] {
      %token_value = index.add %begin, %local : index
      %token = index.assume %token_value [range(%token_value, 0, 7)] : index
      %last = index.add %position, %local : index
      %history_value = index.add %last, %c1 : index
      %history = index.assume %history_value [range(%history_value, 1, 640)] : index
      %pair = index.div %local, %c2 : index
      %next_pair = index.add %pair, %c1 : index
      %pair_end = index.mul %next_pair, %c2 : index
      %group_end = index.min %pair_end, %length : index
      %group_history = index.add %position, %group_end : index
      %c63 = index.constant 63 : index
      %rounded_history = index.add %group_history, %c63 : index
      %tile_count = index.div %rounded_history, %c64 : index
      %split_padding = index.sub %split_count, %c1 : index
      %rounded_tiles = index.add %tile_count, %split_padding : index
      %tiles_per_split = index.div %rounded_tiles, %split_count : index
      %split_size = index.mul %tiles_per_split, %c64 : index
      scf.for %split = [%c0 to %split_count step %c1] {
        %split_begin = index.mul %split, %split_size : index
        %split_end = index.add %split_begin, %split_size : index
        %key_begin = index.min %split_begin, %history : index
        %key_end = index.min %split_end, %history : index
        scf.for %head = [%c0 to %heads step %c1] {
          %key_head = index.div %head, %c6 : index
          %group_head = index.rem %head, %c6 : index
          %maximum = scf.for %key = [%key_begin to %key_end step %c1](%previous = %negative : f64) -> (f64) {
            %physical_value = func.call @split_attention_reference_position(%paged, %rows, %owner, %key) : (i1, buffer, index, index) -> (index)
            %physical = index.assume %physical_value [range(%physical_value, 0, 767), lt(%physical_value, %capacity)] : index
            %dot = scf.for %channel = [%c0 to %channels step %c1](%sum = %c0_0 : f64) -> (f64) {
              %q32 = view.load %queries[%token, %head, %channel] : view<9x24x256xf32> -> f32
              %k16 = view.load %keys[%physical, %key_head, %channel] : view<[%capacity]x4x256xf16> -> f16
              %q64 = scalar.extf %q32 : f32 to f64
              %k64 = scalar.extf %k16 : f16 to f64
              %product = scalar.mulf %q64, %k64 : f64
              %next = scalar.addf %sum, %product : f64
              scf.yield %next : f64
            }
            %score = scalar.mulf %dot, %scale : f64
            view.store %score, %scratch[%key] : f64, view<640xf64>
            %next = scalar.maxnumf %previous, %score : f64
            scf.yield %next : f64
          }
          %denominator = scf.for %key = [%key_begin to %key_end step %c1](%sum = %c0_0 : f64) -> (f64) {
            %score = view.load %scratch[%key] : view<640xf64> -> f64
            %delta = scalar.subf %score, %maximum : f64
            %delta32 = scalar.fptrunc %delta : f64 to f32
            %probability32 = scalar.expf<afn> %delta32 : f32
            %probability = scalar.extf %probability32 : f32 to f64
            view.store %probability, %scratch[%key] : f64, view<640xf64>
            %next = scalar.addf %sum, %probability : f64
            scf.yield %next : f64
          }
          %maximum32 = scalar.fptrunc %maximum : f64 to f32
          %denominator32 = scalar.fptrunc %denominator : f64 to f32
          view.store %maximum32, %partials[%token, %key_head, %split, %group_head, 256] : f32, view<9x4x5x6x258xf32>
          view.store %denominator32, %partials[%token, %key_head, %split, %group_head, 257] : f32, view<9x4x5x6x258xf32>
          scf.for %channel = [%c0 to %channels step %c1] {
            %numerator = scf.for %key = [%key_begin to %key_end step %c1](%sum = %c0_0 : f64) -> (f64) {
              %physical_value = func.call @split_attention_reference_position(%paged, %rows, %owner, %key) : (i1, buffer, index, index) -> (index)
              %physical = index.assume %physical_value [range(%physical_value, 0, 767), lt(%physical_value, %capacity)] : index
              %probability = view.load %scratch[%key] : view<640xf64> -> f64
              %v16 = view.load %values[%physical, %key_head, %channel] : view<[%capacity]x4x256xf16> -> f16
              %v64 = scalar.extf %v16 : f16 to f64
              %product = scalar.mulf %probability, %v64 : f64
              %next = scalar.addf %sum, %product : f64
              scf.yield %next : f64
            }
            %stored = scalar.fptrunc %numerator : f64 to f32
            view.store %stored, %partials[%token, %key_head, %split, %group_head, %channel] : f32, view<9x4x5x6x258xf32>
          }
        }
      }
    }
  }
  func.return
}

// Independently evaluate the partial-state contract. Taking exp(max)
// directly is safe for these bounded inputs and avoids duplicating the device's
// maximum-subtraction merge algorithm.
func.def @split_attention_reduce_reference(%tokens: index, %epoch: buffer, %gate: buffer, %partials: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %span_origin = index.constant 12 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%span_origin] : buffer -> view<4x6xi32>
  %input = buffer.view %partials[%origin] : buffer -> view<9x4x5x6x258xf32>
  %gates = buffer.view %gate[%origin] : buffer -> view<9x24x256xf32>
  %result = buffer.view %output[%origin] : buffer -> view<9x24x256xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %heads = index.constant 24 : index
  %channels = index.constant 256 : index
  %c0_0 = scalar.constant 0.0 : f64
  %count_word = view.load %header[1] : view<3xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 4)] : index
  scf.for %span = [%c0 to %count step %c1] {
    %length_word = view.load %spans[%span, 0] : view<4x6xi32> -> i32
    %begin_word = view.load %spans[%span, 2] : view<4x6xi32> -> i32
    %length_value = index.cast %length_word : i32 to index
    %length = index.assume %length_value [range(%length_value, 1, 8)] : index
    %begin_value = index.cast %begin_word : i32 to index
    %begin = index.assume %begin_value [range(%begin_value, 0, 7)] : index
    scf.for %local = [%c0 to %length step %c1] {
      %token_value = index.add %begin, %local : index
      %token = index.assume %token_value [range(%token_value, 0, 7)] : index
      scf.for %head = [%c0 to %heads step %c1] {
        %key_head = index.div %head, %c6 : index
        %group_head = index.rem %head, %c6 : index
        scf.for %channel = [%c0 to %channels step %c1] {
          %numerator, %denominator = scf.for %split = [%c0 to %c5 step %c1](%sum = %c0_0 : f64, %weight = %c0_0 : f64) -> (f64, f64) {
            %partial = view.load %input[%token, %key_head, %split, %group_head, %channel] : view<9x4x5x6x258xf32> -> f32
            %maximum = view.load %input[%token, %key_head, %split, %group_head, 256] : view<9x4x5x6x258xf32> -> f32
            %total = view.load %input[%token, %key_head, %split, %group_head, 257] : view<9x4x5x6x258xf32> -> f32
            %total64 = scalar.extf %total : f32 to f64
            %scale32 = scalar.expf<afn> %maximum : f32
            %scale = scalar.extf %scale32 : f32 to f64
            %partial64 = scalar.extf %partial : f32 to f64
            %weighted = scalar.mulf %partial64, %scale : f64
            %next = scalar.addf %sum, %weighted : f64
            %weighted_total = scalar.mulf %total64, %scale : f64
            %next_weight = scalar.addf %weight, %weighted_total : f64
            scf.yield %next, %next_weight : f64, f64
          }
          %normalized = scalar.divf %numerator, %denominator : f64
          %gate32 = view.load %gates[%token, %head, %channel] : view<9x24x256xf32> -> f32
          %gate64 = scalar.extf %gate32 : f32 to f64
          %gated = scalar.mulf %normalized, %gate64 : f64
          %stored = scalar.fptrunc %gated : f64 to f32
          view.store %stored, %result[%token, %head, %channel] : f32, view<9x24x256xf32>
        }
      }
    }
  }
  func.return
}

check.scenario public @pooled_split_partial {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[5](%trial: index, %entropy: check.entropy) {
    %seed0 = check.literal value(1729) : i64
    %seed1 = check.literal value(2026) : i64
    %tokens = check.literal value(8) : index
    %spans = check.literal value(4) : index
    %layer = check.literal value(1048576) : offset
    %epoch = check.generate.fill value(-99) : tensor<27xi32>
    %rows = check.generate.fill value(-1) : tensor<120xi32>
    check.generate<@split_attention_fixture>(%trial, %epoch, %rows) : (index, tensor<27xi32>, tensor<120xi32>) -> ()
    %query = check.generate.random.uniform seed(%seed0) range(-1.5 to 1.5) : tensor<9x24x256xf32>
    %state = check.generate.random.uniform seed(%seed1) range(-1.0 to 1.0) : tensor<6291840xf16>
    %partials = check.generate.fill value(-99.0) : tensor<9x4x5x6x258xf32>
    %guard = check.tensor.view %partials offset(990720) : tensor<9x4x5x6x258xf32> -> tensor<4x5x6x258xf32>
    check.compare<@qwen38_attention_spans_split_partial, @split_attention_partial_reference>[%tokens, %spans](%tokens, %epoch, %rows, %layer, %query, %state, %partials) : [index, index](index, tensor<27xi32>, tensor<120xi32>, offset, tensor<9x24x256xf32>, tensor<6291840xf16>, tensor<9x4x5x6x258xf32>) -> () {
      check.expect.close actual(%partials) expected(%partials) atol(0.01) rtol(0.01) nan(different) : tensor<9x4x5x6x258xf32>
      check.expect.bitwise actual(%guard) expected(%guard) : tensor<4x5x6x258xf32>
    }
  }
  check.return
}

check.scenario public @pooled_split_partial_mfma {
  check.requires<hal.amdgpu.target> {target = "gfx9-4-generic"}
  check.trial[5](%trial: index, %entropy: check.entropy) {
    %seed0 = check.literal value(1729) : i64
    %seed1 = check.literal value(2026) : i64
    %tokens = check.literal value(8) : index
    %spans = check.literal value(4) : index
    %layer = check.literal value(1048576) : offset
    %epoch = check.generate.fill value(-99) : tensor<27xi32>
    %rows = check.generate.fill value(-1) : tensor<120xi32>
    check.generate<@split_attention_fixture>(%trial, %epoch, %rows) : (index, tensor<27xi32>, tensor<120xi32>) -> ()
    %query = check.generate.random.uniform seed(%seed0) range(-1.5 to 1.5) : tensor<9x24x256xf32>
    %state = check.generate.random.uniform seed(%seed1) range(-1.0 to 1.0) : tensor<6291840xf16>
    %partials = check.generate.fill value(-99.0) : tensor<9x4x5x6x258xf32>
    %guard = check.tensor.view %partials offset(990720) : tensor<9x4x5x6x258xf32> -> tensor<4x5x6x258xf32>
    check.compare<@qwen38_attention_spans_split_mfma_partial, @split_attention_partial_reference>[%tokens, %spans](%tokens, %epoch, %rows, %layer, %query, %state, %partials) : [index, index](index, tensor<27xi32>, tensor<120xi32>, offset, tensor<9x24x256xf32>, tensor<6291840xf16>, tensor<9x4x5x6x258xf32>) -> () {
      check.expect.close actual(%partials) expected(%partials) atol(0.01) rtol(0.01) nan(different) : tensor<9x4x5x6x258xf32>
      check.expect.bitwise actual(%guard) expected(%guard) : tensor<4x5x6x258xf32>
    }
  }
  check.return
}

check.scenario public @pooled_split_reduce {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[5](%trial: index, %entropy: check.entropy) {
    %seed0 = check.literal value(1729) : i64
    %seed1 = check.literal value(2026) : i64
    %seed2 = check.literal value(1019) : i64
    %tokens = check.literal value(8) : index
    %spans = check.literal value(4) : index
    %layer = check.literal value(1048576) : offset
    %epoch = check.generate.fill value(-99) : tensor<27xi32>
    %rows = check.generate.fill value(-1) : tensor<120xi32>
    check.generate<@split_attention_fixture>(%trial, %epoch, %rows) : (index, tensor<27xi32>, tensor<120xi32>) -> ()
    %query = check.generate.random.uniform seed(%seed0) range(-1.5 to 1.5) : tensor<9x24x256xf32>
    %state = check.generate.random.uniform seed(%seed1) range(-1.0 to 1.0) : tensor<6291840xf16>
    %gate = check.generate.random.uniform seed(%seed2) range(0.10000000000000001 to 0.94999999999999996) : tensor<9x24x256xf32>
    %partials = check.generate.fill value(-99.0) : tensor<9x4x5x6x258xf32>
    %output = check.generate.fill value(9.125) : tensor<9x24x256xf32>
    %guard = check.tensor.view %output offset(196608) : tensor<9x24x256xf32> -> tensor<24x256xf32>
    check.generate<@split_attention_partial_reference>(%tokens, %epoch, %rows, %layer, %query, %state, %partials) : (index, tensor<27xi32>, tensor<120xi32>, offset, tensor<9x24x256xf32>, tensor<6291840xf16>, tensor<9x4x5x6x258xf32>) -> ()
    check.compare<@qwen38_attention_spans_split_reduce, @split_attention_reduce_reference>[%tokens, %spans](%tokens, %epoch, %gate, %partials, %output) : [index, index](index, tensor<27xi32>, tensor<9x24x256xf32>, tensor<9x4x5x6x258xf32>, tensor<9x24x256xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.0000000000000001e-05) rtol(0.0001) nan(different) : tensor<9x24x256xf32>
      check.expect.bitwise actual(%guard) expected(%guard) : tensor<24x256xf32>
    }
  }
  check.return
}

