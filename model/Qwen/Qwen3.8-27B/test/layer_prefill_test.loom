kernel.decl @qwen38_residual_add_f32_prefill(%dispatch_token_count: index) launch(%token_count: index, %lhs: buffer, %rhs: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f16_prefill(%dispatch_token_count: index) launch(%token_count: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_prefill(%dispatch_token_count: index) launch(%token_count: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_swiglu_f32_prefill(%dispatch_token_count: index) launch(%token_count: index, %gate: buffer, %up: buffer, %output: buffer)

// Numerical checks for layer prefill.
// Production kernels come from the model library; independent reference
// kernels and fixture data belong only to this test root.
check.case public @qwen38_layer_prefill_known_case {
  %token_count = check.literal value(3) : index
  %epsilon = check.literal value(9.9999999999999995e-07) : f32
  %norm_input = check.generate.fill value(2.0) : tensor<3x5120xf32>
  %norm_weight = check.generate.fill value(0.5) : tensor<5120xf32>
  %normalized = check.generate.fill value(0.0) : tensor<3x5120xf32>
  %expected_normalized = check.generate.fill value(0.49999993999999998) : tensor<3x5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_count, %epsilon, %norm_input, %norm_weight, %normalized) : [index](index, f32, tensor<3x5120xf32>, tensor<5120xf32>, tensor<3x5120xf32>)
  check.expect.approximate actual(%normalized) expected(%expected_normalized) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<3x5120xf32>, tensor<3x5120xf32>
  %normalized_f16 = check.generate.fill value(0.0) : tensor<3x5120xf16>
  %expected_normalized_f16 = check.generate.fill value(0.5) : tensor<3x5120xf16>
  kernel.launch @qwen38_rmsnorm_f16_prefill[%token_count](%token_count, %epsilon, %norm_input, %norm_weight, %normalized_f16) : [index](index, f32, tensor<3x5120xf32>, tensor<5120xf32>, tensor<3x5120xf16>)
  check.expect.approximate actual(%normalized_f16) expected(%expected_normalized_f16) atol(0.0) rtol(0.0) nan(same) : tensor<3x5120xf16>, tensor<3x5120xf16>

  %lhs = check.generate.fill value(0.125) : tensor<3x5120xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<3x5120xf32>
  %sum = check.generate.fill value(0.0) : tensor<3x5120xf32>
  %expected_sum = check.generate.fill value(0.0625) : tensor<3x5120xf32>
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_count, %lhs, %rhs, %sum) : [index](index, tensor<3x5120xf32>, tensor<3x5120xf32>, tensor<3x5120xf32>)
  check.expect.approximate actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<3x5120xf32>, tensor<3x5120xf32>

  %gate = check.generate.fill value(0.25) : tensor<3x17408xf32>
  %up = check.generate.fill value(0.5) : tensor<3x17408xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<3x17408xf32>
  %expected_swiglu = check.generate.fill value(0.070272356271743774) : tensor<3x17408xf32>
  kernel.launch @qwen38_swiglu_f32_prefill[%token_count](%token_count, %gate, %up, %swiglu) : [index](index, tensor<3x17408xf32>, tensor<3x17408xf32>, tensor<3x17408xf32>)
  check.expect.approximate actual(%swiglu) expected(%expected_swiglu) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<3x17408xf32>, tensor<3x17408xf32>
  check.return
}

check.benchmark<@qwen38_layer_prefill_known_case> @qwen38_layer_prefill
