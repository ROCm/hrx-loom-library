// Materializes the sampled token count for the dynamic-buffer benchmark ABI.
kernel.def @qwen38_gdn_prefill_store_token_count() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%token_count: index, %token_count_data: buffer) {
  %c0_2 = index.constant 0 : offset
  %c0_3 = index.constant 0 : index
  %token_count_i32 = index.cast %token_count : index to i32
  %token_count_view = buffer.view %token_count_data[%c0_2] : buffer -> view<1xi32>
  view.store %token_count_i32, %token_count_view[%c0_3] : i32, view<1xi32>
  kernel.return
}

kernel.decl @qwen38_gdn_capture_transition_depth4() launch(%qkv: buffer, %alpha: buffer, %beta: buffer, %transition: buffer)

kernel.decl @qwen38_gdn_conv_prepare_prefill(%token_count: index) launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer)

kernel.decl @qwen38_gdn_conv_prepare_prefill_parallel(%token_count: index) launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %prior_history: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer)

kernel.decl @qwen38_gdn_conv_prepare_prefill_parallel_read_only(%token_count: index) launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer)

kernel.decl @qwen38_gdn_conv_prepare_prefill_read_only(%token_count: index) launch(%token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer)

kernel.decl @qwen38_gdn_norm_gate_f16_prefill(%dispatch_token_count: index) launch(%token_count: index, %rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer)

kernel.decl @qwen38_gdn_norm_gate_prefill(%dispatch_token_count: index) launch(%token_count: index, %rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer)

kernel.decl @qwen38_gdn_recurrent_prefill_x4(%token_count: index) launch(%token_count_data: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer, %alpha: buffer, %beta: buffer, %ssm_a: buffer, %dt_bias: buffer, %state: buffer, %raw_output: buffer)

kernel.decl @qwen38_gdn_recurrent_prefill_x4_read_only(%token_count: index) launch(%token_count_data: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer, %alpha: buffer, %beta: buffer, %ssm_a: buffer, %dt_bias: buffer, %state: buffer, %raw_output: buffer)

kernel.decl @qwen38_gdn_snapshot_history() launch(%history: buffer, %snapshot: buffer)

// Numerical checks for gdn prefill.
// Production kernels come from the model library; independent reference
// kernels and fixture data belong only to this test root.
check.case public @qwen38_gdn_norm_gate_f16_known_case {
  %token_count = check.literal value(1) : index
  %epsilon = check.literal value(9.9999999999999995e-07) : f32
  %raw_output = check.generate.fill value(0.5) : tensor<1x6144xf32>
  %norm_weight = check.generate.fill value(1.0) : tensor<128xf32>
  %z = check.generate.fill value(0.25) : tensor<1x6144xf32>
  %output = check.generate.fill value(0.0) : tensor<1x6144xf16>
  %expected = check.generate.fill value(0.1405029296875) : tensor<1x6144xf16>
  kernel.launch @qwen38_gdn_norm_gate_f16_prefill[%token_count](%token_count, %epsilon, %raw_output, %norm_weight, %z, %output) : [index](index, f32, tensor<1x6144xf32>, tensor<128xf32>, tensor<1x6144xf32>, tensor<1x6144xf16>)
  check.expect.approximate actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x6144xf16>, tensor<1x6144xf16>
  check.return
}

check.case public @qwen38_gdn_capture_transition_depth4_case {
  %qkv = check.generate.iota offset(-20480.0) step(1.0) : tensor<40960xf32>
  %alpha = check.generate.iota offset(-96.0) step(1.0) : tensor<192xf32>
  %beta = check.generate.iota offset(96.0) step(-1.0) : tensor<192xf32>
  %transition = check.generate.fill value(0.0) : tensor<41344xf32>
  kernel.launch @qwen38_gdn_capture_transition_depth4(%qkv, %alpha, %beta, %transition) : (tensor<40960xf32>, tensor<192xf32>, tensor<192xf32>, tensor<41344xf32>)
  %actual_qkv = check.tensor.view %transition offset(0) : tensor<41344xf32> -> tensor<40960xf32>
  %actual_alpha = check.tensor.view %transition offset(163840) : tensor<41344xf32> -> tensor<192xf32>
  %actual_beta = check.tensor.view %transition offset(164608) : tensor<41344xf32> -> tensor<192xf32>
  check.expect.equal actual(%actual_qkv) expected(%qkv) : tensor<40960xf32>
  check.expect.equal actual(%actual_alpha) expected(%alpha) : tensor<192xf32>
  check.expect.equal actual(%actual_beta) expected(%beta) : tensor<192xf32>
  check.return
}

// Proves that speculative verification produces the same causal outputs as
// committed execution while preserving both persistent GDN state components.
check.case public @qwen38_gdn_read_only_state_case {
  %token_count = check.literal value(4) : index
  %token_count_data = check.generate.fill value(4) : tensor<1xi32>
  %l2_epsilon = check.literal value(9.9999999999999995e-07) : f32
  %qkv_input = check.generate.iota offset(-0.5) step(2.4414062500000001e-05) period(4096) : tensor<4x10240xf32>
  %conv_weight = check.generate.iota offset(-0.25) step(2.4414062500000001e-05) period(2048) : tensor<40960xf32>
  %initial_history = check.generate.fill value(-0.0625) : tensor<30720xf32>
  %committed_history = check.generate.fill value(-0.0625) : tensor<30720xf32>
  %read_only_history = check.generate.fill value(-0.0625) : tensor<30720xf32>
  %committed_qkv = check.generate.fill value(0.0) : tensor<4x10240xf32>
  %read_only_qkv = check.generate.fill value(0.0) : tensor<4x10240xf32>
  %committed_inverse_norm = check.generate.fill value(0.0) : tensor<4x32xf32>
  %read_only_inverse_norm = check.generate.fill value(0.0) : tensor<4x32xf32>
  kernel.launch @qwen38_gdn_conv_prepare_prefill[%token_count](%token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %committed_history, %committed_qkv, %committed_inverse_norm) : [index](tensor<1xi32>, f32, tensor<4x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<4x10240xf32>, tensor<4x32xf32>)
  kernel.launch @qwen38_gdn_conv_prepare_prefill_read_only[%token_count](%token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %read_only_history, %read_only_qkv, %read_only_inverse_norm) : [index](tensor<1xi32>, f32, tensor<4x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<4x10240xf32>, tensor<4x32xf32>)
  check.expect.equal actual(%read_only_qkv) expected(%committed_qkv) : tensor<4x10240xf32>
  check.expect.equal actual(%read_only_inverse_norm) expected(%committed_inverse_norm) : tensor<4x32xf32>
  check.expect.equal actual(%read_only_history) expected(%initial_history) : tensor<30720xf32>

  %parallel_qkv = check.generate.fill value(0.0) : tensor<4x10240xf32>
  %parallel_inverse_norm = check.generate.fill value(0.0) : tensor<4x32xf32>
  kernel.launch @qwen38_gdn_conv_prepare_prefill_parallel_read_only[%token_count](%token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %read_only_history, %parallel_qkv, %parallel_inverse_norm) : [index](tensor<1xi32>, f32, tensor<4x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<4x10240xf32>, tensor<4x32xf32>)
  check.expect.equal actual(%parallel_qkv) expected(%committed_qkv) : tensor<4x10240xf32>
  check.expect.equal actual(%parallel_inverse_norm) expected(%committed_inverse_norm) : tensor<4x32xf32>
  check.expect.equal actual(%read_only_history) expected(%initial_history) : tensor<30720xf32>

  %alpha = check.generate.iota offset(-0.25) step(0.0026041666666666665) : tensor<4x48xf32>
  %beta = check.generate.iota offset(0.25) step(-0.0013020833333333333) : tensor<4x48xf32>
  %ssm_a = check.generate.fill value(-0.5) : tensor<48xf32>
  %dt_bias = check.generate.fill value(0.0625) : tensor<48xf32>
  %initial_state = check.generate.fill value(0.03125) : tensor<786432xf32>
  %committed_state = check.generate.fill value(0.03125) : tensor<786432xf32>
  %read_only_state = check.generate.fill value(0.03125) : tensor<786432xf32>
  %committed_output = check.generate.fill value(0.0) : tensor<4x6144xf32>
  %read_only_output = check.generate.fill value(0.0) : tensor<4x6144xf32>
  kernel.launch @qwen38_gdn_recurrent_prefill_x4[%token_count](%token_count_data, %committed_qkv, %committed_inverse_norm, %alpha, %beta, %ssm_a, %dt_bias, %committed_state, %committed_output) : [index](tensor<1xi32>, tensor<4x10240xf32>, tensor<4x32xf32>, tensor<4x48xf32>, tensor<4x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<4x6144xf32>)
  kernel.launch @qwen38_gdn_recurrent_prefill_x4_read_only[%token_count](%token_count_data, %read_only_qkv, %read_only_inverse_norm, %alpha, %beta, %ssm_a, %dt_bias, %read_only_state, %read_only_output) : [index](tensor<1xi32>, tensor<4x10240xf32>, tensor<4x32xf32>, tensor<4x48xf32>, tensor<4x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<4x6144xf32>)
  check.expect.equal actual(%read_only_output) expected(%committed_output) : tensor<4x6144xf32>
  check.expect.equal actual(%read_only_state) expected(%initial_state) : tensor<786432xf32>
  check.return
}

// Proves that token-parallel convolution preserves the serial kernel's
// complete output, Q/K normalization, and committed causal history. A full
// launch over tight storage makes inactive-row accesses observable to ASAN.
check.case public @qwen38_gdn_conv_parallel_differential_case {
  %token_count = check.param.choice values([1, 2, 3, 4, 5, 32, 128, 511, 512]) name("token_count") : index
  %token_count_data = check.generate.fill value(0) : tensor<1xi32>
  %l2_epsilon = check.literal value(9.9999999999999995e-07) : f32
  %qkv_input = check.generate.iota offset(-0.5) step(2.4414062500000001e-05) period(4096) : tensor<[%token_count]x10240xf32>
  %conv_weight = check.generate.iota offset(-0.25) step(2.4414062500000001e-05) period(2048) : tensor<40960xf32>
  %serial_history = check.generate.iota offset(-0.0625) step(3.0517578125000002e-06) period(1024) : tensor<30720xf32>
  %prior_history = check.generate.fill value(0.0) : tensor<30720xf32>
  %parallel_history = check.generate.iota offset(-0.0625) step(3.0517578125000002e-06) period(1024) : tensor<30720xf32>
  %serial_qkv = check.generate.fill value(9.125) : tensor<[%token_count]x10240xf32>
  %parallel_qkv = check.generate.fill value(9.125) : tensor<[%token_count]x10240xf32>
  %serial_inverse_norm = check.generate.fill value(9.125) : tensor<[%token_count]x32xf32>
  %parallel_inverse_norm = check.generate.fill value(9.125) : tensor<[%token_count]x32xf32>
  kernel.launch @qwen38_gdn_prefill_store_token_count(%token_count, %token_count_data) : (index, tensor<1xi32>)
  kernel.launch @qwen38_gdn_snapshot_history(%parallel_history, %prior_history) : (tensor<30720xf32>, tensor<30720xf32>)
  kernel.launch @qwen38_gdn_conv_prepare_prefill[%token_count](%token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %serial_history, %serial_qkv, %serial_inverse_norm) : [index](tensor<1xi32>, f32, tensor<[%token_count]x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<[%token_count]x10240xf32>, tensor<[%token_count]x32xf32>)
  %launch_capacity = check.literal value(512) : index
  kernel.launch @qwen38_gdn_conv_prepare_prefill_parallel[%launch_capacity](%token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %prior_history, %parallel_history, %parallel_qkv, %parallel_inverse_norm) : [index](tensor<1xi32>, f32, tensor<[%token_count]x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<30720xf32>, tensor<[%token_count]x10240xf32>, tensor<[%token_count]x32xf32>)
  check.expect.equal actual(%parallel_qkv) expected(%serial_qkv) : tensor<[%token_count]x10240xf32>
  check.expect.equal actual(%parallel_inverse_norm) expected(%serial_inverse_norm) : tensor<[%token_count]x32xf32>
  check.expect.equal actual(%parallel_history) expected(%serial_history) : tensor<30720xf32>
  check.return
}

check.case public @qwen38_gdn_prefill_benchmark_case {
  %token_count = check.param.choice values([1, 4, 32, 128, 512]) name("token_count") : index
  %token_count_data = check.generate.fill value(0) : tensor<1xi32>
  %l2_epsilon = check.literal value(9.9999999999999995e-07) : f32
  %rms_epsilon = check.literal value(9.9999999999999995e-07) : f32
  %qkv_input = check.generate.fill value(0.125) : tensor<[%token_count]x10240xf32>
  %conv_weight = check.generate.fill value(0.25) : tensor<40960xf32>
  %conv_history = check.generate.fill value(-0.0625) : tensor<30720xf32>
  %qkv_silu = check.generate.fill value(0.0) : tensor<[%token_count]x10240xf32>
  %qk_inverse_norm = check.generate.fill value(0.0) : tensor<[%token_count]x32xf32>
  %alpha = check.generate.fill value(0.125) : tensor<[%token_count]x48xf32>
  %beta = check.generate.fill value(-0.25) : tensor<[%token_count]x48xf32>
  %ssm_a = check.generate.fill value(-0.5) : tensor<48xf32>
  %dt_bias = check.generate.fill value(0.0625) : tensor<48xf32>
  %state = check.generate.fill value(0.03125) : tensor<786432xf32>
  %raw_output = check.generate.fill value(0.0) : tensor<[%token_count]x6144xf32>
  %norm_weight = check.generate.fill value(1.0) : tensor<128xf32>
  %z = check.generate.fill value(0.25) : tensor<[%token_count]x6144xf32>
  %output = check.generate.fill value(0.0) : tensor<[%token_count]x6144xf32>
  kernel.launch @qwen38_gdn_prefill_store_token_count(%token_count, %token_count_data) : (index, tensor<1xi32>)
  kernel.launch @qwen38_gdn_conv_prepare_prefill[%token_count](%token_count_data, %l2_epsilon, %qkv_input, %conv_weight, %conv_history, %qkv_silu, %qk_inverse_norm) : [index](tensor<1xi32>, f32, tensor<[%token_count]x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<[%token_count]x10240xf32>, tensor<[%token_count]x32xf32>)
  kernel.launch @qwen38_gdn_recurrent_prefill_x4[%token_count](%token_count_data, %qkv_silu, %qk_inverse_norm, %alpha, %beta, %ssm_a, %dt_bias, %state, %raw_output) : [index](tensor<1xi32>, tensor<[%token_count]x10240xf32>, tensor<[%token_count]x32xf32>, tensor<[%token_count]x48xf32>, tensor<[%token_count]x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<[%token_count]x6144xf32>)
  kernel.launch @qwen38_gdn_norm_gate_prefill[%token_count](%token_count, %rms_epsilon, %raw_output, %norm_weight, %z, %output) : [index](index, f32, tensor<[%token_count]x6144xf32>, tensor<128xf32>, tensor<[%token_count]x6144xf32>, tensor<[%token_count]x6144xf32>)
  check.return
}

check.benchmark<@qwen38_gdn_prefill_benchmark_case> @qwen38_gdn_prefill_1 {token_count = 1}

check.benchmark<@qwen38_gdn_norm_gate_f16_known_case> @qwen38_gdn_norm_gate_f16_known

check.benchmark<@qwen38_gdn_prefill_benchmark_case> @qwen38_gdn_prefill_32 {token_count = 32}

check.benchmark<@qwen38_gdn_prefill_benchmark_case> @qwen38_gdn_prefill_128 {token_count = 128}

check.benchmark<@qwen38_gdn_prefill_benchmark_case> @qwen38_gdn_prefill_512 {token_count = 512}

check.benchmark<@qwen38_gdn_capture_transition_depth4_case> @qwen38_gdn_capture_transition_depth4_case_workload

check.benchmark<@qwen38_gdn_read_only_state_case> @qwen38_gdn_read_only_state_case_workload

check.benchmark<@qwen38_gdn_conv_parallel_differential_case> @qwen38_gdn_conv_parallel_differential_case_workload
