// Split projections use the ordinary decoded-F16 numerical contract. The VM
// oracle decodes GGUF independently and accumulates the products in F64.

func.decl @signed_projection_headers(%format: index, %inputs: index, %outputs: index, %weight: buffer)

func.decl @matrix_projection_expected_range(%format: index, %control: buffer, %inputs: index, %outputs: index, %weight_channels: index, %begin: index, %end: index, %output_origin: offset, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_split_reduce(%dispatch_partitions: index, %dispatch_tokens: index, %dispatch_outputs: index) launch(%partitions: index, %count: buffer, %outputs: index, %partials: buffer, %output: buffer)

kernel.decl @qwen38_linear_q6k_f16_c64t64_split(%dispatch_partitions: index, %dispatch_tokens: index, %dispatch_inputs: index, %dispatch_outputs: index) launch(%partitions: index, %count: buffer, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %partials: buffer)

command.def public @split_q6_projection(%partitions: index, %tokens: index, %inputs: index, %outputs: index) launch(%count: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %element_bytes = index.constant 4 : offset
  %plane_elements = index.mul %tokens, %outputs : index
  %partial_elements = index.mul %partitions, %plane_elements : index
  %partial_bytes = index.scale %partial_elements, %element_bytes : index, offset -> offset
  %partials = buffer.alloca<global> align(256) %partial_bytes : buffer
  kernel.launch @qwen38_linear_q6k_f16_c64t64_split[%partitions, %tokens, %inputs, %outputs](%partitions, %count, %inputs, %outputs, %input, %weight, %partials) : [index, index, index, index](index, buffer, index, index, buffer, buffer, buffer)
  kernel.launch @qwen38_linear_split_reduce[%partitions, %tokens, %outputs](%partitions, %count, %outputs, %partials, %output) : [index, index, index](index, buffer, index, buffer, buffer)
  command.return
}

func.def @split_q6_expected(%count: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %inputs = index.constant 1792 : index
  %outputs = index.constant 65 : index
  %format = index.constant 6 : index
  %channels = index.constant 1 : index
  %begin = index.constant 0 : index
  %origin = index.constant 0 : offset
  func.call @matrix_projection_expected_range(%format, %count, %inputs, %outputs, %channels, %begin, %inputs, %origin, %input, %weight, %output) : (index, buffer, index, index, index, index, index, offset, buffer, buffer, buffer)
  func.return
}

check.scenario public @split_q6_projection_check {
  %format = check.literal value(6) : index
  %partitions = check.literal value(8) : index
  %tokens = check.literal value(4) : index
  %inputs = check.literal value(1792) : index
  %outputs = check.literal value(65) : index
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %count = check.generate.fill value(3) : tensor<1xi32>
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-1.0 to 1.0) : tensor<4x1792xf32>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-128 to 127) : tensor<65x7x210xi8>
    check.generate<@signed_projection_headers>(%format, %inputs, %outputs, %weight) : (index, index, index, tensor<65x7x210xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<4x65xf32>
    check.compare<@split_q6_projection, @split_q6_expected>[%partitions, %tokens, %inputs, %outputs](%count, %input, %weight, %output) : [index, index, index, index](tensor<1xi32>, tensor<4x1792xf32>, tensor<65x7x210xi8>, tensor<4x65xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00050000000000000001) rtol(3.0000000000000001e-05) nan(different) : tensor<4x65xf32>, tensor<4x65xf32>
    }
  }
  check.return
}

check.benchmark<@split_q6_projection_check> @split_q6_projection_check_workload
