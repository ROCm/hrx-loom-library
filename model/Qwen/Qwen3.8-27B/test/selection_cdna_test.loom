  %output = check.generate.fill value(0.0) : tensor<5120xf32>
  %expected = check.generate.fill value(0.49999993999999998) : tensor<5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %input, %weight, %output) : (f32, tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>)
  check.expect.approximate actual(%output) expected(%expected) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<5120xf32>, tensor<5120xf32>
  check.return
}

