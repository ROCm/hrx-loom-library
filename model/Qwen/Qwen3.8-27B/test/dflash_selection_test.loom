// Composition owns the canonical token mapping, while the shared selector owns
// ordering and reductions. Full and compact heads must choose the same IDs even
// when rare-token insertion order differs from token order. Compact spans use
// owners two and zero; inactive rows and an empty cohort preserve output guards.

target.decl @qwen38_execution

kernel.decl @qwen38_dflash_topk_partial(%rows: index) launch(%rows_argument: index, %first: index, %total: index, %draft: buffer, %control: buffer, %carry: buffer, %logits: buffer, %table: buffer, %scores: buffer, %ids: buffer)

kernel.decl @qwen38_dflash_topk_merge(%rows: index) launch(%rows_argument: index, %control: buffer, %partial_scores: buffer, %partial_ids: buffer, %scores: buffer, %ids: buffer)

func.def @dflash_topk_fixture(%configuration: index, %draft: buffer, %control: buffer, %carry: buffer, %logits: buffer, %table: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %header = buffer.view %control[%origin] : buffer -> view<4xi32>
  %spans = buffer.view %draft[%descriptor_origin] : buffer -> view<3x6xi32>
  %history = buffer.view %carry[%origin] : buffer -> view<3x5696xi32>
  %dense = buffer.view %logits[%origin] : buffer -> view<3x248320xf32>
  %prefix = buffer.view %logits[%origin] : buffer -> view<3x98304xf32>
  %extra = buffer.view %table[%origin] : buffer -> view<3x1024xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %mode = index.rem %configuration, %c2 : index
  %full = index.cmp ne, %mode, %c0 : index
  %empty = index.cmp uge, %configuration, %c2 : index
  %live = scf.select %empty, %c0, %c2 : index
  %live_word = index.cast %live : index to i32
  %mode_word = index.cast %mode : index to i32
  view.store %live_word, %header[0] : i32, view<4xi32>
  view.store %live_word, %header[1] : i32, view<4xi32>
  view.store %live_word, %header[2] : i32, view<4xi32>
  view.store %mode_word, %header[3] : i32, view<4xi32>
  %rare_count = scalar.constant 2 : i32
  %rare_base = index.constant 100000 : index
  %rare_distance = index.constant 5 : index
  %poison = scalar.constant 1000.0 : f32
  scf.for %row = [%c0 to %c2 step %c1] {
    %row_twice = index.mul %row, %c2 : index
    %owner = index.sub %c2, %row_twice : index
    %owner_word = index.cast %owner : index to i32
    view.store %owner_word, %spans[%row, 3] : i32, view<3x6xi32>
    %rare_low = index.add %rare_base, %row : index
    %rare_high = index.add %rare_low, %rare_distance : index
    %low_word = index.cast %rare_low : index to i32
    %high_word = index.cast %rare_high : index to i32
    view.store %rare_count, %history[%owner, 0] : i32, view<3x5696xi32>
    view.store %high_word, %history[%owner, 4684] : i32, view<3x5696xi32>
    view.store %low_word, %history[%owner, 4685] : i32, view<3x5696xi32>
    %row_word = index.cast %row : index to i32
    %row_score = scalar.sitofp %row_word : i32 to f32
    %base_score = scalar.constant 3.0 : f32
    %high = scalar.addf %base_score, %row_score : f32
    scf.if %full {
      view.store %high, %dense[%row, 42] : f32, view<3x248320xf32>
      view.store %high, %dense[%row, 90000] : f32, view<3x248320xf32>
      view.store %high, %dense[%row, %rare_low] : f32, view<3x248320xf32>
      view.store %high, %dense[%row, %rare_high] : f32, view<3x248320xf32>
      view.store %high, %dense[%row, 248044] : f32, view<3x248320xf32>
      view.store %poison, %dense[%row, 248077] : f32, view<3x248320xf32>
    } else {
      view.store %high, %prefix[%row, 42] : f32, view<3x98304xf32>
      view.store %high, %prefix[%row, 90000] : f32, view<3x98304xf32>
    }
    view.store %high, %extra[%row, 0] : f32, view<3x1024xf32>
    view.store %high, %extra[%row, 33] : f32, view<3x1024xf32>
    view.store %high, %extra[%row, 34] : f32, view<3x1024xf32>
    view.store %poison, %extra[%row, 35] : f32, view<3x1024xf32>
  }
  func.return
}

func.def @dflash_topk_reference(%draft: buffer, %control: buffer, %carry: buffer, %logits: buffer, %table: buffer, %scores: buffer, %ids: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %control[%origin] : buffer -> view<4xi32>
  %live_word = view.load %header[0] : view<4xi32> -> i32
  %live_value = index.cast %live_word : i32 to index
  %live = index.assume %live_value [range(%live_value, 0, 3)] : index
  %values = buffer.view %scores[%origin] : buffer -> view<3x16xf32>
  %tokens = buffer.view %ids[%origin] : buffer -> view<3x16xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c5 = index.constant 5 : index
  %c16 = index.constant 16 : index
  %first = scalar.constant 42 : i32
  %second = scalar.constant 90000 : i32
  %rare_base = scalar.constant 100000 : i32
  %rare_distance = scalar.constant 5 : i32
  %control_id = scalar.constant 248044 : i32
  %base = scalar.constant 3.0 : f32
  %background = scalar.constant -10.0 : f32
  scf.for %row = [%c0 to %live step %c1] {
    %row_word = index.cast %row : index to i32
    %row_score = scalar.sitofp %row_word : i32 to f32
    %high = scalar.addf %base, %row_score : f32
    %rare_low = scalar.addi %rare_base, %row_word : i32
    %rare_high = scalar.addi %rare_low, %rare_distance : i32
    view.store %first, %tokens[%row, 0] : i32, view<3x16xi32>
    view.store %second, %tokens[%row, 1] : i32, view<3x16xi32>
    view.store %rare_low, %tokens[%row, 2] : i32, view<3x16xi32>
    view.store %rare_high, %tokens[%row, 3] : i32, view<3x16xi32>
    view.store %control_id, %tokens[%row, 4] : i32, view<3x16xi32>
    scf.for %rank = [%c0 to %c5 step %c1] {
      view.store %high, %values[%row, %rank] : f32, view<3x16xf32>
    }
    scf.for %rank = [%c5 to %c16 step %c1] {
      %relative = index.sub %rank, %c5 : index
      %id = index.cast %relative : index to i32
      view.store %id, %tokens[%row, %rank] : i32, view<3x16xi32>
      view.store %background, %values[%row, %rank] : f32, view<3x16xf32>
    }
  }
  func.return
}

command.def target(@qwen38_execution) @dflash_topk(%configuration: index) launch(%draft: buffer, %control: buffer, %carry: buffer, %logits: buffer, %table: buffer, %scores: buffer, %ids: buffer) {
  %rows = index.constant 3 : index
  %partial_stride = index.constant 3904 : offset
  %partial_bytes = index.scale %rows, %partial_stride : index, offset -> offset
  %partial_scores = buffer.alloca<global> align(256) %partial_bytes : buffer
  %partial_ids = buffer.alloca<global> align(256) %partial_bytes : buffer
  // Split inside the live prefix. Both windows contribute to one ranked
  // result, including the retained tokens from each row's global owner.
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %mode = index.rem %configuration, %two : index
  %full = index.cmp ne, %mode, %zero : index
  %full_stride = index.constant 993280 : offset
  %prefix_stride = index.constant 393216 : offset
  %next = scf.select %full, %full_stride, %prefix_stride : offset
  %tail = buffer.view %logits[%next] : buffer -> view<2x248320xf32>
  kernel.launch @qwen38_dflash_topk_partial[%one](%one, %zero, %rows, %draft, %control, %carry, %logits, %table, %partial_scores, %partial_ids) : [index](index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_dflash_topk_partial[%two](%two, %one, %rows, %draft, %control, %carry, %tail, %table, %partial_scores, %partial_ids) : [index](index, index, index, buffer, buffer, buffer, view<2x248320xf32>, buffer, buffer, buffer)
  kernel.launch @qwen38_dflash_topk_merge[%rows](%rows, %control, %partial_scores, %partial_ids, %scores, %ids) : [index](index, buffer, buffer, buffer, buffer, buffer)
  command.return
}

check.scenario public @dflash_topk_canonical_ids configure[4](%configuration: index, %configuration_entropy: check.entropy) {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %draft = check.generate.fill value(-99) : tensor<21xi32>
    %control = check.generate.fill value(-99) : tensor<4xi32>
    %carry = check.generate.fill value(0) : tensor<3x5696xi32>
    %logits = check.generate.fill value(-10.0) : tensor<3x248320xf32>
    %table = check.generate.fill value(-10.0) : tensor<3x1024xf32>
    check.generate<@dflash_topk_fixture>(%configuration, %draft, %control, %carry, %logits, %table) : (index, tensor<21xi32>, tensor<4xi32>, tensor<3x5696xi32>, tensor<3x248320xf32>, tensor<3x1024xf32>) -> ()
    %scores = check.generate.fill value(-99.0) : tensor<3x16xf32>
    %ids = check.generate.fill value(-99) : tensor<3x16xi32>
    check.compare<@dflash_topk, @dflash_topk_reference>[%configuration](%draft, %control, %carry, %logits, %table, %scores, %ids) : [index](tensor<21xi32>, tensor<4xi32>, tensor<3x5696xi32>, tensor<3x248320xf32>, tensor<3x1024xf32>, tensor<3x16xf32>, tensor<3x16xi32>) -> () {
      check.expect.bitwise actual(%scores) expected(%scores) : tensor<3x16xf32>
      check.expect.bitwise actual(%ids) expected(%ids) : tensor<3x16xi32>
      check.expect.bitwise actual(%carry) expected(%carry) : tensor<3x5696xi32>
    }
  }
  check.return
}

check.benchmark<@dflash_topk_canonical_ids> @dflash_topk_canonical_ids_benchmark
