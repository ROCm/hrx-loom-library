// Exercises the exact four-row verifier ABI. Each row reuses the one-row
// arithmetic schedule while concurrent launches write disjoint partial and
// output slices.
check.case public @qwen38_attention_decode_split_m4_differential_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %token_count = check.literal value(4) : index
  %token_ordinal0 = check.literal value(0) : index
  %token_ordinal1 = check.literal value(1) : index
  %token_ordinal2 = check.literal value(2) : index
  %token_ordinal3 = check.literal value(3) : index
  %control_position_index = check.literal value(1) : index
  %control = check.generate.iota offset(4) step(5) : tensor<2xi32>
  %query = check.generate.iota offset(-0.5) step(0.000244140625) period(4096) : tensor<4x6144xf32>
  %gate = check.generate.iota offset(0.125) step(0.0001220703125) period(2048) : tensor<4x6144xf32>
  %key_cache = check.generate.iota offset(-0.5) step(0.0001220703125) period(8192) : tensor<13312xf16>
  %value_cache = check.generate.iota offset(0.25) step(-6.103515625e-05) period(8192) : tensor<13312xf16>
  %partials = check.generate.fill value(0.0) : tensor<247680xf32>
  %expected = check.generate.fill value(0.0) : tensor<4x6144xf32>
  %actual = check.generate.fill value(0.0) : tensor<4x6144xf32>
  kernel.launch @qwen38_attention_prefill_reference[%token_count](%control, %query, %gate, %key_cache, %value_cache, %expected) : [index](tensor<2xi32>, tensor<4x6144xf32>, tensor<4x6144xf32>, tensor<13312xf16>, tensor<13312xf16>, tensor<4x6144xf32>)
  kernel.launch.concurrent {
    kernel.launch @qwen38_attention_decode_split_wmma_partial(%token_count, %token_ordinal0, %control_position_index, %control, %query, %key_cache, %value_cache, %partials) : (index, index, index, tensor<2xi32>, tensor<4x6144xf32>, tensor<13312xf16>, tensor<13312xf16>, tensor<247680xf32>)
    kernel.launch @qwen38_attention_decode_split_wmma_partial(%token_count, %token_ordinal1, %control_position_index, %control, %query, %key_cache, %value_cache, %partials) : (index, index, index, tensor<2xi32>, tensor<4x6144xf32>, tensor<13312xf16>, tensor<13312xf16>, tensor<247680xf32>)
    kernel.launch @qwen38_attention_decode_split_wmma_partial(%token_count, %token_ordinal2, %control_position_index, %control, %query, %key_cache, %value_cache, %partials) : (index, index, index, tensor<2xi32>, tensor<4x6144xf32>, tensor<13312xf16>, tensor<13312xf16>, tensor<247680xf32>)
    kernel.launch @qwen38_attention_decode_split_wmma_partial(%token_count, %token_ordinal3, %control_position_index, %control, %query, %key_cache, %value_cache, %partials) : (index, index, index, tensor<2xi32>, tensor<4x6144xf32>, tensor<13312xf16>, tensor<13312xf16>, tensor<247680xf32>)
  }
  kernel.launch.concurrent {
    kernel.launch @qwen38_attention_decode_split_reduce(%token_count, %token_ordinal0, %gate, %partials, %actual) : (index, index, tensor<4x6144xf32>, tensor<247680xf32>, tensor<4x6144xf32>)
    kernel.launch @qwen38_attention_decode_split_reduce(%token_count, %token_ordinal1, %gate, %partials, %actual) : (index, index, tensor<4x6144xf32>, tensor<247680xf32>, tensor<4x6144xf32>)
    kernel.launch @qwen38_attention_decode_split_reduce(%token_count, %token_ordinal2, %gate, %partials, %actual) : (index, index, tensor<4x6144xf32>, tensor<247680xf32>, tensor<4x6144xf32>)
    kernel.launch @qwen38_attention_decode_split_reduce(%token_count, %token_ordinal3, %gate, %partials, %actual) : (index, index, tensor<4x6144xf32>, tensor<247680xf32>, tensor<4x6144xf32>)
  }
  check.expect.approximate actual(%actual) expected(%expected) atol(0.002) rtol(0.002) nan(same) : tensor<4x6144xf32>, tensor<4x6144xf32>
  check.return
}

