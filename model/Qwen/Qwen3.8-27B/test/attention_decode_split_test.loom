  %query = check.generate.iota offset(-0.5) step(0.000244140625) period(4096) : tensor<6144xf32>
  %gate = check.generate.iota offset(0.125) step(0.0001220703125) period(2048) : tensor<6144xf32>
  %key_cache = check.generate.iota offset(-0.5) step(0.0001220703125) period(8192) : tensor<10240xf16>
  %value_cache = check.generate.iota offset(0.25) step(-6.103515625e-05) period(8192) : tensor<10240xf16>
  %partials = check.generate.fill value(0.0) : tensor<61920xf32>
  %wmma_partials = check.generate.fill value(0.0) : tensor<61920xf32>
  %expected = check.generate.fill value(0.0) : tensor<6144xf32>
  %actual = check.generate.fill value(0.0) : tensor<6144xf32>
  %wmma_actual = check.generate.fill value(0.0) : tensor<6144xf32>
  kernel.launch @qwen38_attention_decode(%control, %query, %gate, %key_cache, %value_cache, %expected) : (tensor<2xi32>, tensor<6144xf32>, tensor<6144xf32>, tensor<10240xf16>, tensor<10240xf16>, tensor<6144xf32>)
  kernel.launch @qwen38_attention_decode_split_partial(%control, %query, %key_cache, %value_cache, %partials) : (tensor<2xi32>, tensor<6144xf32>, tensor<10240xf16>, tensor<10240xf16>, tensor<61920xf32>)
  kernel.launch @qwen38_attention_decode_split_reduce(%token_count, %token_ordinal, %gate, %partials, %actual) : (index, index, tensor<6144xf32>, tensor<61920xf32>, tensor<6144xf32>)
  kernel.launch @qwen38_attention_decode_split_wmma_partial(%token_count, %token_ordinal, %control_position_index, %control, %query, %key_cache, %value_cache, %wmma_partials) : (index, index, index, tensor<2xi32>, tensor<6144xf32>, tensor<10240xf16>, tensor<10240xf16>, tensor<61920xf32>)
  kernel.launch @qwen38_attention_decode_split_reduce(%token_count, %token_ordinal, %gate, %wmma_partials, %wmma_actual) : (index, index, tensor<6144xf32>, tensor<61920xf32>, tensor<6144xf32>)
  check.expect.approximate actual(%actual) expected(%expected) atol(1.0000000000000001e-05) rtol(0.0001) nan(same) : tensor<6144xf32>, tensor<6144xf32>
