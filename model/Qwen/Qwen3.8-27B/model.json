  "services": {
    "chat": {
      "kind": "text",
      "version": 1,
      "options": [
        "sampling"
      ],
      "interface": {
        "input": [
          "text messages",
          "tool definitions",
          "tool results"
        ],
        "output": [
          "content",
          "reasoning_content",
          "tool calls"
        ],
        "drafting": "Target-only, checkpoint MTP, or DFlash2 within the text service."
      },
      "constraints": {
        "mtp_draft_depth": {
          "minimum": 1,
          "maximum": 7
        },
        "dflash2_draft_depth": 7,
        "continuation_epochs": [
          1,
          2
        ],
        "sampling": {
          "top_p": "(0, 1]",
          "top_k": "nonnegative signed 32-bit integer",
          "seed": "signed 64-bit integer",
          "temperature": "zero for greedy, otherwise positive normal F32"
        },
        "text_targets": [
          "AMDGPU RDNA",
          "AMDGPU CDNA"
        ]
      }
    },
    "vision-chat": {
      "kind": "text",
      "version": 1,
      "options": [
        "sampling"
      ],
      "interface": {
        "input": [
          "text messages",
          "tool definitions",
          "tool results"
        ],
        "output": [
          "content",
          "reasoning_content",
          "tool calls"
        ],
        "drafting": "Target-only, checkpoint MTP, or DFlash2 within the text service."
      },
      "constraints": {
        "mtp_draft_depth": {
          "minimum": 1,
          "maximum": 7
        },
        "dflash2_draft_depth": 7,
        "continuation_epochs": [
          1,
          2
        ],
        "sampling": {
          "top_p": "(0, 1]",
          "top_k": "nonnegative signed 32-bit integer",
          "seed": "signed 64-bit integer",
          "temperature": "zero for greedy, otherwise positive normal F32"
        },
        "text_targets": [
          "AMDGPU RDNA",
          "AMDGPU CDNA"
        ]
      },
      "components": {
        "image": {
          "version": 1,
          "interface": {
            "input": "RGB or RGBA images interleaved with text",
            "output": "Language-model feature rows",
            "activation": "On demand; feature lifetime is independent of projector weight residency."
          },
          "constraints": {
            "targets": [
              "AMDGPU RDNA"
            ],
            "images_per_conversation": 4,
            "maximum_width": 4096,
            "maximum_height": 4096,
            "maximum_compressed_bytes": 67108864,
            "maximum_aspect_ratio": 200,
            "processing_alignment": 32,
            "max_image_tokens": {
              "minimum": 128,
              "maximum": 16384,
              "default": 1024
            },
            "context": "Image tokens and text must fit the text-service context capacity."
          }
        }
      }
    }
  },
