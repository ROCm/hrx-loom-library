load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/Qwen/Qwen3.8-27B/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_TEXT_INPUTS = [
    "//model/Qwen/Qwen3.8-27B/program:prepare",
    "//program/text/qwen3_8:chat",
    "//model/Qwen/Qwen3.8-27B/program:identity",
]

_INPUTS = {
    "text": _TEXT_INPUTS,
    "vision": _TEXT_INPUTS + [
        "//model/Qwen/Qwen3.8-27B/program:vision_prepare",
        "//model/Qwen/Qwen3.8-27B/program:vision_control",
    ],
}

# These roots supply service exports and stages selected by preparation.
# Their kernel, template, and motif dependencies belong to the providers.
_LIBRARIES = [
    "//model/Qwen/Qwen3.8-27B/program:commands",
    "//program/text/qwen3_8:epoch",
    "//model/Qwen/Qwen3.8-27B/program:vision_pixels",
    "//model/Qwen/Qwen3.8-27B/program:vision_stages",
]

[
    loom_model(
        name = representation + suffix,
        card = "model.json",
        encoding = "preserve",
        form = "module" if representation == "archive" else "sources",
        inputs = _INPUTS[family],
        libraries = _LIBRARIES,
        lockfile = "model.json.lock",
        model_name = "qwen3.8-27b",
        preset = preset,
        programs = family + "-" + representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
    ]
    for suffix, preset, family in [
        ("", "chat", "text"),
        ("_vision", "vision", "vision"),
        ("_target_only", "target-only", "text"),
        ("_dflash2", "dflash2", "text"),
        ("_cdna_text", "cdna-text", "text"),
    ]
]
