// Fuse twelve retained encoder taps into one BF16 feature vector per token.
// Layerwise blocks consume [token,12,2560], a learned reduction changes that
// layout, and refiners advance [token,2560] features. Inputs, masks, and
// checkpoint domains remain immutable while workspace follows each stage.
config.decl @krea2.dit_int8 : %value: index where [range(%value, 0, 1)]

template.decl @projection.adapter_layer_mix_12_bf16(%rows: index, %width: index, %rank: index, %row: index, %channel: index, %weight_is_bf16: i1, %input: buffer, %weight: buffer, %a: buffer, %b: buffer, %count: index, %offset_layout: encoding<layout>, %strength_layout: encoding<layout>, %offsets: view<[%count]xi64, %offset_layout>, %strengths: view<[%count]xf32, %strength_layout>) -> (bf16)

config.decl @krea2.text_tokens : %value: index where [range(%value, 16, 65536), multiple_of(%value, 16)]

amdgpu.target<gfx11-generic> @fusion_projector_wave32 {subgroup_size = 32}

template.decl @projection.layer_mix_12_bf16(%rows: index, %width: index, %rank: index, %row: index, %channel: index, %adapted: i1, %weight_is_bf16: i1, %input: buffer, %weight: buffer, %down: buffer, %up: buffer, %selection: buffer) -> (bf16)

template.decl @krea2.text_fusion(%rows: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %mask: buffer, %selection: buffer, %output: buffer)

command.program.decl @krea2.fusion_layerwise_block(%layer: index, %adapted: i1) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %selection: buffer, %output: buffer)

command.program.decl @krea2.fusion_refiner_block(%layer: index, %adapted: i1) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %mask: buffer, %selection: buffer, %output: buffer)

kernel.def target(@fusion_projector_wave32) @fusion_projector() {
  %rows = config.get @krea2.text_tokens : index
  %columns = index.constant 10 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %columns, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %storage = config.get @krea2.dit_int8 : index
  %zero_storage = index.constant 0 : index
  %weight_is_bf16 = index.cmp ne, %storage, %zero_storage : index
  %rows = config.get @krea2.text_tokens : index
  %width = index.constant 2560 : index
  %rank = index.constant 32 : index
  %threads = index.constant 256 : index
  %row = kernel.workgroup.id<x> : index
  %group = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %channel = index.madd %group, %threads, %lane : index
  %adapted = scalar.constant false : i1
  %result = template.apply<@projection.layer_mix_12_bf16>(%rows, %width, %rank, %row, %channel, %adapted, %weight_is_bf16, %input, %weight, %weight, %weight, %weight) : (index, index, index, index, index, i1, i1, buffer, buffer, buffer, buffer, buffer) -> (bf16)
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
  view.store %result, %output_view[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
  kernel.return
}

kernel.def target(@fusion_projector_wave32) @fusion_projector_adapted() {
  %rows = config.get @krea2.text_tokens : index
  %columns = index.constant 10 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %columns, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %down: buffer, %up: buffer, %selection: buffer, %output: buffer) {
  %storage = config.get @krea2.dit_int8 : index
  %zero_storage = index.constant 0 : index
  %weight_is_bf16 = index.cmp ne, %storage, %zero_storage : index
  %rows = config.get @krea2.text_tokens : index
  %width = index.constant 2560 : index
  %rank = index.constant 32 : index
  %threads = index.constant 256 : index
  %row = kernel.workgroup.id<x> : index
  %group = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %channel = index.madd %group, %threads, %lane : index
  %selection_origin = index.constant 0 : offset
  %selection_header = buffer.view %selection[%selection_origin] : buffer -> view<1xi32>
  %selection_count32 = view.load %selection_header[0] : view<1xi32> -> i32
  %selection_count_nonnegative = scalar.assume %selection_count32 [range(%selection_count32, 0, 2147483647)] : i32
  %count = index.cast %selection_count_nonnegative : i32 to index
  %offset_begin = index.constant 16 : offset
  %offset_layout = encoding.layout.strided [2] : encoding<layout>
  %offsets = buffer.view %selection[%offset_begin] : buffer -> view<[%count]xi64, %offset_layout>
  %strength_begin = index.constant 24 : offset
  %strength_layout = encoding.layout.strided [4] : encoding<layout>
  %strengths = buffer.view %selection[%strength_begin] : buffer -> view<[%count]xf32, %strength_layout>
  %result = template.apply<@projection.adapter_layer_mix_12_bf16>(%rows, %width, %rank, %row, %channel, %weight_is_bf16, %input, %weight, %down, %up, %count, %offset_layout, %strength_layout, %offsets, %strengths) : (index, index, index, index, index, i1, buffer, buffer, buffer, buffer, index, encoding<layout>, encoding<layout>, view<[%count]xi64, %offset_layout>, view<[%count]xf32, %strength_layout>) -> (bf16)
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
  view.store %result, %output_view[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
  kernel.return
}

command.program.def public @krea2.fusion_projector(%adapted: i1) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  %storage = config.get @krea2.dit_int8 : index
  %storage_zero = index.constant 0 : index
  %storage_bf16 = index.cmp ne, %storage, %storage_zero : index
  %bf16_bytes = index.constant 2 : index
  %f32_bytes = index.constant 4 : index
  %storage_bytes = scf.select %storage_bf16, %bf16_bytes, %f32_bytes : index
  %weight = command.parameter %parameters, "txtfusion.projector.weight" : view<1x12x[%storage_bytes]xi8>
  scf.if %adapted {
    %down = command.parameter %adapter, "transformer.text_fusion.projector.lora_A.weight" : view<32x12xbf16>
    %up = command.parameter %adapter, "transformer.text_fusion.projector.lora_B.weight" : view<1x32xbf16>
    %down_base = command.parameter.base %down : view<32x12xbf16> -> buffer
    %up_base = command.parameter.base %up : view<1x32xbf16> -> buffer
    kernel.launch @fusion_projector_adapted(%input, %weight, %down_base, %up_base, %selection, %output) : (buffer, view<1x12x[%storage_bytes]xi8>, buffer, buffer, buffer, buffer)
  } else {
    kernel.launch @fusion_projector(%input, %weight, %output) : (buffer, view<1x12x[%storage_bytes]xi8>, buffer)
  }
  command.return
}

// Only the first layerwise output needs retained tap-sized storage. Later
// blocks advance source-owned features in place after all original reads.
// The layer reduction changes layout and writes distinct output storage.
template.def<@krea2.text_fusion> @krea2_text_fusion(%rows: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %mask: buffer, %selection: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %tap_stride = index.constant 61440 : offset
  %tap_bytes = index.scale %rows, %tap_stride : index, offset -> offset
  %features = buffer.alloca<global> align(256) %tap_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_block[%c0, %adapted](%parameters, %adapter, %input, %selection, %features) : [index, i1](buffer, buffer, buffer, buffer, buffer)
  command.program.launch @krea2.fusion_layerwise_block[%c1, %adapted](%parameters, %adapter, %features, %selection, %features) : [index, i1](buffer, buffer, buffer, buffer, buffer)
  command.program.launch @krea2.fusion_projector[%adapted](%parameters, %adapter, %features, %selection, %output) : [i1](buffer, buffer, buffer, buffer, buffer)
  scf.for %layer = [%c0 to %c2 step %c1] unroll {
    command.program.launch @krea2.fusion_refiner_block[%layer, %adapted](%parameters, %adapter, %output, %mask, %selection, %output) : [index, i1](buffer, buffer, buffer, buffer, buffer, buffer)
  }
  template.return
}

// Taps are [token,12,2560] BF16 and output features are [token,2560] BF16.
// Mask contains one byte per token. Inputs and both weight domains are immutable.
command.program.def public @text_fusion() launch(%parameters: buffer, %input: buffer, %mask: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %adapted = scalar.constant false : i1
  template.apply<@krea2.text_fusion>(%rows, %adapted, %parameters, %parameters, %input, %mask, %input, %output) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @text_fusion_adapted() launch(%parameters: buffer, %adapter: buffer, %input: buffer, %mask: buffer, %selection: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %adapted = scalar.constant true : i1
  template.apply<@krea2.text_fusion>(%rows, %adapted, %parameters, %adapter, %input, %mask, %selection, %output) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
