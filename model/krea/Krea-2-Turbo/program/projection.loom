// Project packed image latents into a selected suffix of hidden-state rows.
// Concrete leaves bind the checkpoint's contraction dimensions and storage
// format. The caller retains the latent and owns the combined-state output;
// adapter factors are a separate immutable parameter domain.

config.decl @krea2.dit_int8 : %value: index where [range(%value, 0, 1)]

template.decl @krea2.adapter_up(%rows: index, %outputs: index, %layout: encoding<layout>, %low: buffer, %factors: buffer, %selection: buffer, %base: buffer, %output: buffer)

template.decl @krea2.adapter_down(%rows: index, %inputs: index, %input: buffer, %factors: buffer, %selection: buffer, %output: buffer)

template.decl @krea2.adapter_scratch(%rows: index) -> (buffer)

config.decl @krea2.image_tokens : %value: index where [range(%value, 16, 65536), multiple_of(%value, 16)]

amdgpu.target<gfx11-generic> @tensor_projection_rdna3

amdgpu.target<gfx11-generic> @projection_wave32 {subgroup_size = 32}

template.decl @projection.linear_storage_bf16(%rows: index, %inputs: index, %outputs: index, %weight_is_bf16: i1, %row_origin: index, %output_origin: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)

template.decl @projection.store_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)

template.decl @projection.bias_storage_bf16(%outputs: index, %output_origin: index, %weight_is_bf16: i1, %result: vector<8xf32>, %bias: buffer) -> (vector<8xf32>)

template.decl @krea2.image_input(%rows: index, %first_row: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %selection: buffer, %output: buffer)

// Each wrapper fixes shape facts before applying the reusable arithmetic.
// No shape scalars remain in the device launch ABI.
kernel.def target(@projection_wave32) @krea_image_projection() {
  %rows = config.get @krea2.image_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 384 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %storage = config.get @krea2.dit_int8 : index
  %zero_storage = index.constant 0 : index
  %weight_is_bf16 = index.cmp ne, %storage, %zero_storage : index
  %rows = config.get @krea2.image_tokens : index
  %inputs = index.constant 64 : index
  %outputs = index.constant 6144 : index
  %projection_tile = index.constant 16 : index
  %row_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %row_origin = index.mul %row_tile, %projection_tile : index
  %output_origin = index.mul %output_tile, %projection_tile : index
  %result = template.apply<@projection.linear_storage_bf16>(%rows, %inputs, %outputs, %weight_is_bf16, %row_origin, %output_origin, %input, %weight) : (index, index, index, i1, index, index, buffer, buffer) -> (vector<8xf32>)
  %biased = template.apply<@projection.bias_storage_bf16>(%outputs, %output_origin, %weight_is_bf16, %result, %bias) : (index, index, i1, vector<8xf32>, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %output_layout, %biased, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

// The image projection writes directly into a selected hidden-state suffix.
// Original checkpoint names and LoRA factors belong to separate roots.
command.def public @krea2.image_projection(%first_row: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %storage = config.get @krea2.dit_int8 : index
  %storage_zero = index.constant 0 : index
  %storage_bf16 = index.cmp ne, %storage, %storage_zero : index
  %bf16_bytes = index.constant 2 : index
  %f32_bytes = index.constant 4 : index
  %storage_bytes = scf.select %storage_bf16, %bf16_bytes, %f32_bytes : index
  %rows = config.get @krea2.image_tokens : index
  %row_bytes = index.constant 12288 : offset
  %output_offset = index.scale %first_row, %row_bytes : index, offset -> offset
  %output_view = buffer.view %output[%output_offset] : buffer -> view<[%rows]x6144xbf16>
  %weight = command.parameter %parameters, "first.weight" : view<6144x64x[%storage_bytes]xi8>
  %bias = command.parameter %parameters, "first.bias" : view<6144x[%storage_bytes]xi8>
  kernel.launch @krea_image_projection(%input, %weight, %bias, %output_view) : (buffer, view<6144x64x[%storage_bytes]xi8>, view<6144x[%storage_bytes]xi8>, view<[%rows]x6144xbf16>)
  command.return
}

command.def public @krea2.image_adapter_down() launch(%adapter: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.img_in.lora_A.weight" : view<32x64xbf16>
  %weight_base = command.parameter.base %weight : view<32x64xbf16> -> buffer
  kernel.launch @krea_image_adapter_down(%input, %weight_base, %selection, %output) : (buffer, buffer, buffer, buffer)
  command.return
}

command.def public @krea2.image_adapter_add(%first_row: index) launch(%adapter: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %row_bytes = index.constant 12288 : offset
  %output_offset = index.scale %first_row, %row_bytes : index, offset -> offset
  %output_view = buffer.view %output[%output_offset] : buffer -> view<[%rows]x6144xbf16>
  %weight = command.parameter %adapter, "transformer.img_in.lora_B.weight" : view<6144x32xbf16>
  %weight_base = command.parameter.base %weight : view<6144x32xbf16> -> buffer
  kernel.launch @krea_image_adapter_add(%input, %weight_base, %selection, %output_view, %output_view) : (buffer, buffer, buffer, view<[%rows]x6144xbf16>, view<[%rows]x6144xbf16>)
  command.return
}

template.def<@krea2.image_input> @krea2_image_input(%rows: index, %first_row: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  scf.if %adapted {
    %low = template.apply<@krea2.adapter_scratch>(%rows) : (index) -> (buffer)
    command.concurrent {
      command.launch @krea2.image_projection[%first_row](%parameters, %input, %output) : [index](buffer, buffer, buffer)
      command.launch @krea2.image_adapter_down(%adapter, %input, %selection, %low) : (buffer, buffer, buffer, buffer)
    }
    command.launch @krea2.image_adapter_add[%first_row](%adapter, %low, %selection, %output) : [index](buffer, buffer, buffer, buffer)
  } else {
    command.launch @krea2.image_projection[%first_row](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  }
  template.return
}

command.def public @image_projection() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %first_row = index.constant 0 : index
  command.launch @krea2.image_projection[%first_row](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  command.return
}

// Apply only the adapter to an existing base projection, without mutating
// base parameters or materializing a full-width delta.
command.def public @image_projection_adapter() launch(%parameters: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %first_row = index.constant 0 : index
  %low = template.apply<@krea2.adapter_scratch>(%rows) : (index) -> (buffer)
  command.launch @krea2.image_adapter_down(%parameters, %input, %selection, %low) : (buffer, buffer, buffer, buffer)
  command.launch @krea2.image_adapter_add[%first_row](%parameters, %low, %selection, %output) : [index](buffer, buffer, buffer, buffer)
  command.return
}

command.def public @image_projection_adapted() launch(%parameters: buffer, %adapter: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %first_row = index.constant 0 : index
  %adapted = scalar.constant true : i1
  template.apply<@krea2.image_input>(%rows, %first_row, %adapted, %parameters, %adapter, %input, %selection, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer)
  command.return
}

kernel.def target(@projection_wave32) @krea_image_adapter_add() {
  %rows = config.get @krea2.image_tokens : index
  %columns = index.constant 48 : index
  %row_padding = index.constant 63 : index
  %row_tile = index.constant 64 : index
  %padded_rows = index.add %rows, %row_padding : index
  %groups = index.div %padded_rows, %row_tile : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%columns, %groups, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%low: buffer, %factors: buffer, %selection: buffer, %base: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %adapter_outputs = index.constant 6144 : index
  %adapter_layout = encoding.layout.dense : encoding<layout>
  template.apply<@krea2.adapter_up>(%rows, %adapter_outputs, %adapter_layout, %low, %factors, %selection, %base, %output) : (index, index, encoding<layout>, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@projection_wave32) @krea_image_adapter_down() {
  %rows = config.get @krea2.image_tokens : index
  %launch_tile = index.constant 16 : index
  %groups = index.div %rows, %launch_tile : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %factors: buffer, %selection: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %adapter_inputs = index.constant 64 : index
  template.apply<@krea2.adapter_down>(%rows, %adapter_inputs, %input, %factors, %selection, %output) : (index, index, buffer, buffer, buffer, buffer)
  kernel.return
}
