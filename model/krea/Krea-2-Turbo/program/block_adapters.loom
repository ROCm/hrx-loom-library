// Transformer projection adapters over the original shared factor banks.
// Base and down contractions overlap; up contractions combine all selected
// contributions before one base update. Only rank activations use workspace.

template.decl @krea2.adapter_up(%rows: index, %outputs: index, %layout: encoding<layout>, %low: buffer, %factors: buffer, %selection: buffer, %base: buffer, %output: buffer)

template.decl @krea2.adapter_down(%rows: index, %inputs: index, %input: buffer, %factors: buffer, %selection: buffer, %output: buffer)

template.decl @krea2.adapter_scratch(%rows: index) -> (buffer)

config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), multiple_of(%value, 16)]

amdgpu.target<gfx11-generic> @block_adapter_wave32 {subgroup_size = 32}

command.program.decl @krea2.block_query(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_key(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_value(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_gate(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_attention_output(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_feed_forward_gate(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_feed_forward_up(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

command.program.decl @krea2.block_feed_forward_down(%layer: index) launch(%parameters: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %output: buffer)

// Factor commands expose independent numerical boundaries. The adapted
// commands overlap base and A contractions, then add B(Ax) in place without
// materializing a full-width delta. Base and adapter parameters never alias.
command.program.def public @krea2.block_query_adapter_down(%layer: index) launch(%adapter: buffer, %input: buffer, %selection: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.transformer_blocks.{}.attn.to_q.lora_A.weight"[%layer] : view<32x6144xbf16>
  %weight_base = command.parameter.base %weight : view<32x6144xbf16> -> buffer
  kernel.launch @block_adapter_linear_6144_32(%input, %weight_base, %selection, %output) : (buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.block_query_adapter_add(%layer: index) launch(%adapter: buffer, %input: buffer, %selection: buffer, %base: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.transformer_blocks.{}.attn.to_q.lora_B.weight"[%layer] : view<6144x32xbf16>
  %weight_base = command.parameter.base %weight : view<6144x32xbf16> -> buffer
  kernel.launch @block_adapter_add_6144(%input, %weight_base, %selection, %base, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.block_query_adapted(%layer: index) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %quantized: buffer, %input_scales: buffer, %selection: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %low = template.apply<@krea2.adapter_scratch>(%rows) : (index) -> (buffer)
  command.concurrent {
    command.program.launch @krea2.block_query[%layer](%parameters, %input, %quantized, %input_scales, %output) : [index](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @krea2.block_query_adapter_down[%layer](%adapter, %input, %selection, %low) : [index](buffer, buffer, buffer, buffer)
  }
  command.program.launch @krea2.block_query_adapter_add[%layer](%adapter, %low, %selection, %output, %output) : [index](buffer, buffer, buffer, buffer, buffer)
  command.return
}

