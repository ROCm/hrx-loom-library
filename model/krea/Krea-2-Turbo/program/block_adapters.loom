  %rows = config.get @krea2.block_tokens : index
  %adapter_outputs = index.constant 1536 : index
  %adapter_layout = encoding.layout.strided [1, %rows] : encoding<layout>
  template.apply<@krea2.adapter_up>(%rows, %adapter_outputs, %adapter_layout, %low, %factors, %selection, %base, %output) : (index, index, encoding<layout>, buffer, buffer, buffer, buffer, buffer)
