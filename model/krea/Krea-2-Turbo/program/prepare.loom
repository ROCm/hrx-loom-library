  // request transport bounds inputs and allocates only the actual payload.
  %capacity = scalar.constant 9223372036854775807 : i64
  %tokenizer = global.load @tokenizer : buffer
  %identifier = global.load @identifier : buffer
  %state_header_bytes = index.constant 96 : offset
  %registry_bytes = buffer.length %registry
  %state_bytes = index.add %state_header_bytes, %registry_bytes : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %state_view = buffer.view %state[%origin] : buffer -> view<12xi64>
  %small_flag = scalar.extui %retain_small : i1 to i64
  %maximum_stage64 = scalar.extui %maximum_stage : i32 to i64
  %small_stage64 = scalar.extui %small_stage : i32 to i64
  view.store %arena, %state_view[0] : i64, view<12xi64>
  view.store %height, %state_view[1] : i64, view<12xi64>
  view.store %width, %state_view[2] : i64, view<12xi64>
  view.store %workspace, %state_view[3] : i64, view<12xi64>
  view.store %int8_flag, %state_view[4] : i64, view<12xi64>
  view.store %text, %state_view[5] : i64, view<12xi64>
  view.store %small_flag, %state_view[6] : i64, view<12xi64>
  view.store %maximum_stage64, %state_view[7] : i64, view<12xi64>
  view.store %small_stage64, %state_view[8] : i64, view<12xi64>
  %encoder64 = scalar.extui %encoder : i32 to i64
  %dit64 = scalar.extui %dit : i32 to i64
  %vae64 = scalar.extui %vae : i32 to i64
  view.store %encoder64, %state_view[9] : i64, view<12xi64>
  view.store %dit64, %state_view[10] : i64, view<12xi64>
  view.store %vae64, %state_view[11] : i64, view<12xi64>
  buffer.copy %registry[%origin], %state[%state_header_bytes], %registry_bytes
  %batch_units = scalar.constant 2 : i64
  func.return %batch_units, %capacity, %tokenizer, %identifier, %state : i64, i64, buffer, buffer, buffer
}

// krea2.bind_adapter_banks
global.rodata.def @krea2.adapter_binding = bytes("6b726561322e62696e645f616461707465725f62616e6b73")
