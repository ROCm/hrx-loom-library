  %view = buffer.view %output[%origin] : buffer -> view<5xi32>
  %stride_word = index.cast %stride : index to i32
  %count_word = index.cast %count : index to i32
  view.store %stride_word, %view[0] : i32, view<5xi32>
  view.store %count_word, %view[1] : i32, view<5xi32>
  scf.for %ordinal = [%c0 to %count step %c1] {
    %start, %begin, %end = template.apply<@krea2.vae_tile_axis_interval>(%extent, %tile, %stride, %ordinal) : (index, index, index, index) -> (index, index, index)
    %position = index.madd %ordinal, %c3, %c2 : index
    %begin_position = index.add %position, %c1 : index
    %end_position = index.add %position, %c2 : index
    %start_word = index.cast %start : index to i32
    %begin_word = index.cast %begin : index to i32
    %end_word = index.cast %end : index to i32
    view.store %start_word, %view[%position] : i32, view<5xi32>
    view.store %begin_word, %view[%begin_position] : i32, view<5xi32>
    view.store %end_word, %view[%end_position] : i32, view<5xi32>
  }
  kernel.return
}

func.def @axis_1024_1024_reference(%output: buffer) {
  %expected = global.load @axis_1024_1024_expected : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 20 : offset
  buffer.copy %expected[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @axis_1024_1024 {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-77) : tensor<37xi32>
    %output = check.tensor.view %storage offset(64) : tensor<37xi32> -> tensor<5xi32>
    check.compare<@axis_1024_1024_apply, @axis_1024_1024_reference>(%output) : (tensor<5xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<37xi32>
    }
  }
  check.return
}

check.benchmark<@axis_1024_1024> @axis_1024_1024_benchmark
