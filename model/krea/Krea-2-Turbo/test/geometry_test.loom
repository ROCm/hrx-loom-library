// Image admission and VAE workspace policy at their public request boundaries.

func.decl @krea2.image_geometry_valid(%height: i64, %width: i64, %text: i64) -> (i1)

func.decl @krea2.vae_workspace_tile(%height: i64, %width: i64, %limit: i64) -> (i64, i64)

check.case public @minimum_square {
  %height = check.literal value(64) : i64
  %width = check.literal value(64) : i64
  %text = check.literal value(16) : i64
  %actual = func.call @krea2.image_geometry_valid(%height, %width, %text) : (i64, i64, i64) -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

