// The source-selected callback changes only bank addresses. Two real cohort
// members retain their own counts, strengths, repeated banks, unused slots,
// and following token/noise bytes. Native offsets need not match declaration
// order, and the shared arena may place a bank beyond four GiB.

func.decl @krea2.bind_adapter_banks(%state: buffer, %payload: buffer, %offsets: buffer)

// Two members, maximum three selections. Member 0 selects declarations
// [0, 1, 2] with strengths [0.3, 0.7, -0.5]; member 1 selects [3, 4]
// with strengths [-0.25, 0.75]. The last 24 bytes stand for the input packets.
global.rodata.def @initial = align(8) bytes("")

// Declarations 0 and 2 share a bank; 1 and 4 share another.
global.rodata.def @offsets = align(8) bytes("00100000010000000000000000000000001000000100000000200000020000000000000000000000")

global.rodata.def @expected = align(8) bytes("")

func.def @bind_observation() -> (i32, i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 168 : offset
  %state_bytes = index.constant 96 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %source = global.load @initial : buffer
  %original_offsets = global.load @offsets : buffer
  %offset_bytes = buffer.length %original_offsets
  %offsets = buffer.alloca<private> align(8) %offset_bytes : buffer
  buffer.copy %original_offsets[%origin], %offsets[%origin], %offset_bytes
  %expected = global.load @expected : buffer
  %payload = buffer.alloca<private> align(8) %bytes : buffer
  buffer.copy %source[%origin], %payload[%origin], %bytes
  func.call @krea2.bind_adapter_banks(%state, %payload, %offsets) : (buffer, buffer, buffer)
  %difference = buffer.compare %payload[%origin], %expected[%origin], %bytes
  %offset_difference = buffer.compare %offsets[%origin], %original_offsets[%origin], %offset_bytes
  func.return %difference, %offset_difference : i32, i32
}

check.case public @ordered_bank_binding {
  %difference, %offset_difference = func.call @bind_observation() : () -> (i32, i32)
  %expected = check.literal value(0) : i32
  check.expect.equal actual(%difference) expected(%expected) : i32
  check.expect.equal actual(%offset_difference) expected(%expected) : i32
  check.return
}
