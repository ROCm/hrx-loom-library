load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
    "LICENSE.krea-2.pdf",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    card_url = "https://raw.githubusercontent.com/ROCm/hrx-loom-library/main/model/krea/Krea-2-Turbo/model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_PROGRAM_NAMES = [
    "adapter",
    "adapter_pack",
    "adapter_selection",
    "block",
    "block_adapters",
    "block_attention",
    "block_int8",
    "block_pointwise",
    "block_projections",
    "block_rotary",
    "config",
    "control",
    "denoise",
    "encoder_attention",
    "encoder_block",
    "encoder_normalization",
    "encoder_projections",
    "generate",
    "geometry",
    "head",
    "prepare",
    "projection",
    "request",
    "sample",
    "stack",
    "text_encoder",
    "text_fusion",
    "text_fusion_blocks",
    "text_fusion_kernels",
    "text_projection",
    "time",
    "transformer",
    "vae",
    "vae_attention",
    "vae_decoder",
    "vae_residual",
    "vae_tiles",
    "vae_upsample",
    "velocity",
]

_MOTIFS = {
    "//motif/tensor:adapter": "library/motif/tensor/adapter",
    "//motif/tensor:random": "library/motif/tensor/random",
    "//motif/tensor:linear": "library/motif/tensor/linear",
    "//motif/tensor:linear_tiled": "library/motif/tensor/linear_tiled",
    "//motif/tensor:linear_temporal": "library/motif/tensor/linear_temporal",
    "//motif/tensor:quantization": "library/motif/tensor/quantization",
    "//motif/tensor:linear_i8": "library/motif/tensor/linear_i8",
    "//motif/tensor:rmsnorm": "library/motif/tensor/rmsnorm",
    "//motif/tensor:modulation": "library/motif/tensor/modulation",
    "//motif/tensor:rotary": "library/motif/tensor/rotary",
    "//motif/tensor:attention_expanded": "library/motif/tensor/attention_expanded",
    "//motif/tensor:attention_shared": "library/motif/tensor/attention_shared",
    "//motif/tensor:attention_shared_k32": "library/motif/tensor/attention_shared_k32",
    "//motif/tensor:pointwise": "library/motif/tensor/pointwise",
    "//motif/tensor:time": "library/motif/tensor/time",
    "//motif/tensor:diffusion": "library/motif/tensor/diffusion",
    "//motif/tensor:image_unpack": "library/motif/tensor/image_unpack",
    "//motif/tensor:convolution": "library/motif/tensor/convolution",
    "//motif/tensor:convolution_matrix": "library/motif/tensor/convolution_matrix",
    "//motif/tensor:channel_norm": "library/motif/tensor/channel_norm",
    "//motif/tensor:image_attention_matrix": "library/motif/tensor/image_attention_matrix",
    "//motif/tensor:segmented_attention": "library/motif/tensor/segmented_attention",
    "//motif/tensor:layer_mix": "library/motif/tensor/layer_mix",
    "//motif/tensor:embedding": "library/motif/tensor/embedding",
}

[
    loom_model(
        name = representation + suffix,
        card = "model.json",
        data = {
            ":LICENSE.krea-2.pdf": "LICENSE.krea-2.pdf",
            "//model/krea/Krea-2-Turbo/program:weights.loom": "program/weights.loom",
            "//model/krea/Krea-2-Turbo/program:adapter_weights.loom": "program/adapter_weights.loom",
        },
        encoding = "preserve",
        files = {
            "//model/krea/Krea-2-Turbo/program:" + name + (".loom" if representation == "source" or (representation == "mixed" and name in [
                "prepare",
                "control",
            ]) else ""): "program/" + name + (".loom" if representation == "source" or (representation == "mixed" and name in [
                "prepare",
                "control",
            ]) else ".loombc")
            for name in _PROGRAM_NAMES
        } | {
            label + (".loom" if representation == "source" else ""): path + (".loom" if representation == "source" else ".loombc")
            for label, path in _MOTIFS.items()
        },
        lockfile = "model.json.lock",
        model_name = "krea2-turbo",
        preset = preset,
        programs = representation,
        visibility = ["//visibility:public"],
    )
    for representation in [
        "source",
        "archive",
        "mixed",
    ]
    for suffix, preset in [
        ("", "image"),
        ("_int8", "image-int8"),
        ("_bounded_workspace", "image-bounded-workspace"),
        ("_lifecycle", "lifecycle"),
    ]
]
