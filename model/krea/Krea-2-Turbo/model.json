  "services": {
    "image": {
      "kind": "image",
      "version": 1,
      "options": [
        "workspace_limit_bytes",
        "adapter_capacity_bytes",
        "adapters"
      ],
      "interface": {
        "input": "text prompt",
        "output": "RGB image",
        "denoising_steps": 8
      },
      "constraints": {
        "width": {
          "minimum": 16,
          "maximum": 8192,
          "multiple_of": 16
        },
        "height": {
          "minimum": 16,
          "maximum": 8192,
          "multiple_of": 16
        },
        "text_tokens": {
          "minimum": 16,
          "maximum": 65536,
          "multiple_of": 16
        },
        "image_patches": {
          "expression": "(height / 16) * (width / 16)",
          "minimum": 16,
          "multiple_of": 16
        },
        "combined_sequence": {
          "expression": "image_patches + text_tokens",
          "maximum": 65536
        },
        "workspace_limit_bytes": {
          "minimum": 1,
          "description": "Exact overlapping VAE tiles when required; preparation rejects a shape that cannot meet the bound."
        }
      }
    }
  },
  "variants": {
    "bf16": {
      "description": "Original BF16 DiT, text encoder, and VAE.",
      "services": {
        "image": {
          "programs": [
            "source",
            "archive"
          ],
          "config": {
            "krea2.dit_int8": 0
          },
          "parameters": {
            "dit": {
              "files": [
                {
                  "path": "parameter/dit.safetensors",
                  "origin": "@checkpoint/turbo.safetensors",
                  "format": "safetensors"
                }
              ]
            },
            "text_encoder": {
              "files": [
                {
                  "path": "parameter/text-encoder.safetensors",
                  "origin": "@checkpoint/text_encoder/model.safetensors",
                  "format": "safetensors"
                }
              ]
            },
            "vae": {
              "files": [
                {
                  "path": "parameter/vae.safetensors",
                  "origin": "@checkpoint/vae/diffusion_pytorch_model.safetensors",
                  "format": "safetensors"
                }
              ]
            }
          },
          "tokenizers": {
            "text": {
              "path": "tokenizer.json",
              "origin": "@checkpoint/tokenizer/tokenizer.json",
              "format": "huggingface-json"
            }
          }
        }
      }
    },
    "int8-convrot": {
      "description": "Signed I8 DiT projections with F32 scales and Hadamard-256 rotation; original text encoder and VAE.",
      "services": {
        "image": {
          "programs": [
