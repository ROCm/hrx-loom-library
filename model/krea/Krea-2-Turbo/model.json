          "parameters": {
            "dit": {
              "files": [
                {
                  "path": "parameter/dit-int8-convrot.safetensors",
                  "origin": "@convrot/diffusion_models/krea2_turbo_int8_convrot.safetensors",
                  "format": "safetensors"
                }
              ]
            },
            "text_encoder": {
              "files": [
                {
                  "path": "parameter/text-encoder.safetensors",
                  "origin": "@checkpoint/text_encoder/model.safetensors",
                  "format": "safetensors"
                }
              ]
            },
            "vae": {
              "files": [
                {
                  "path": "parameter/vae.safetensors",
                  "origin": "@checkpoint/vae/diffusion_pytorch_model.safetensors",
                  "format": "safetensors"
