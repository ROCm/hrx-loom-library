load("//build_tools/bazel:defs.bzl", "loom_library")

package(default_visibility = ["//model/moonshine-ai/moonshine-streaming-tiny:__subpackages__"])

exports_files([
    "control.loom",
    "convolution.loom",
    "decoder.loom",
    "decoder_attention.loom",
    "decoder_state.loom",
    "encoder.loom",
    "encoder_attention.loom",
    "encoder_state.loom",
    "frontend.loom",
    "initialize.loom",
    "normalization.loom",
    "pointwise.loom",
    "prepare.loom",
    "projection.loom",
    "reset.loom",
    "weights.loom",
])

loom_library(
    name = "control",
    srcs = ["control.loom"],
)

loom_library(
    name = "convolution",
    srcs = ["convolution.loom"],
)

loom_library(
    name = "decoder",
    srcs = ["decoder.loom"],
    deps = [
        ":decoder_attention",
        ":decoder_state",
        ":normalization",
        ":pointwise",
        ":projection",
    ],
)

loom_library(
    name = "decoder_attention",
    srcs = ["decoder_attention.loom"],
)

loom_library(
    name = "decoder_state",
    srcs = ["decoder_state.loom"],
)

loom_library(
    name = "encoder",
    srcs = ["encoder.loom"],
    deps = [
        ":convolution",
        ":encoder_attention",
        ":encoder_state",
        ":frontend",
        ":normalization",
        ":pointwise",
        ":projection",
    ],
)

loom_library(
    name = "encoder_attention",
    srcs = ["encoder_attention.loom"],
)

loom_library(
    name = "encoder_state",
    srcs = ["encoder_state.loom"],
)

loom_library(
    name = "frontend",
    srcs = ["frontend.loom"],
)

loom_library(
    name = "initialize",
    srcs = ["initialize.loom"],
)

loom_library(
    name = "normalization",
    srcs = ["normalization.loom"],
)

loom_library(
    name = "pointwise",
    srcs = ["pointwise.loom"],
)

loom_library(
    name = "prepare",
    srcs = ["prepare.loom"],
)

loom_library(
    name = "projection",
    srcs = ["projection.loom"],
)

loom_library(
    name = "reset",
    srcs = ["reset.loom"],
    deps = [
        ":initialize",
    ],
)

loom_library(
    name = "weights",
    srcs = ["weights.loom"],
)
