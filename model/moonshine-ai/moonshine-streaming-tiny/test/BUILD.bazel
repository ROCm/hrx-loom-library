load("@hrx//build_tools/bazel:python.bzl", "iree_py_binary")
load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "numerics",
    srcs = ["numerics.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    deps = [
        "//model/moonshine-ai/moonshine-streaming-tiny/program:frontend",
        "//model/moonshine-ai/moonshine-streaming-tiny/program:projection",
    ],
)

loom_test(
    name = "state",
    srcs = ["state.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    deps = ["//model/moonshine-ai/moonshine-streaming-tiny/program:encoder_state"],
)

iree_py_binary(
    name = "transcription_check",
    testonly = True,
    srcs = ["transcription_check.py"],
    args = [
        "--server=$(location @hrx//loom/src/loom/tools/loom-serve)",
        "--audio=$(location short.pcm)",
        "--reference=$(location reference.json)",
    ],
    data = [
        "reference.json",
        "short.pcm",
        "@hrx//loom/src/loom/tools/loom-serve",
    ],
    main = "transcription_check.py",
    deps = ["@hrx//loom/src/loom/serve/testing:http"],
)
