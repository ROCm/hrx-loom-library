load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")
load("@hrx//build_tools/bazel:requirements.bzl", "apply_test_requirements")
load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "numerics",
    srcs = ["numerics.loom"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    deps = [
        "//model/moonshine-ai/moonshine-streaming-tiny/program:frontend",
        "//model/moonshine-ai/moonshine-streaming-tiny/program:projection",
    ],
)

loom_test(
    name = "state",
    srcs = ["state.loom"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    deps = ["//model/moonshine-ai/moonshine-streaming-tiny/program:encoder_state"],
)

[
    filegroup(
        name = representation + "_card",
        srcs = ["//model/moonshine-ai/moonshine-streaming-tiny:" + representation],
        output_group = "model_card",
    )
    for representation in [
        "source",
        "archive",
        "mixed",
    ]
]

# Provisioned assets stay outside runfiles; the model target carries their lock.
_TRANSCRIPTION_REQUIREMENTS = apply_test_requirements(
    {},
    build_requirements = AMD_GPU_HARDWARE_PROFILE.build_requirements,
    resource_group = AMD_GPU_HARDWARE_PROFILE.resource_group,
    run_requirements = AMD_GPU_HARDWARE_PROFILE.run_requirements,
)

[
    iree_py_test(
        name = "transcription_" + representation + "_test",
        size = "medium",
        srcs = ["transcription_check.py"],
        args = [
            "--server=$(location @hrx//loom/src/loom/tools/loom-serve)",
            "--model=$(location :" + representation + "_card)",
            "--audio=$(location short.pcm)",
            "--reference=$(location reference.json)",
        ] + AMD_GPU_HARDWARE_PROFILE.runner_args,
        data = [
            ":" + representation + "_card",
            "reference.json",
            "short.pcm",
            "@hrx//loom/src/loom/tools/loom-serve",
        ],
        main = "transcription_check.py",
        resource_group = _TRANSCRIPTION_REQUIREMENTS["resource_group"],
        tags = ["manual"] + _TRANSCRIPTION_REQUIREMENTS["tags"],
        target_compatible_with = _TRANSCRIPTION_REQUIREMENTS["target_compatible_with"],
        deps = [
            "@hrx//loom/src/loom/serve/testing:http",
            "@hrx//loom/src/loom/serve/testing:model_staging",
        ],
    )
    for representation in [
        "source",
        "archive",
        "mixed",
    ]
]
