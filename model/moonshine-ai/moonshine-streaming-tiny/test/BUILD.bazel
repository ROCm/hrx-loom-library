load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_HARDWARE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")
load(":transcription_test.bzl", "transcription_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "numerics",
    srcs = ["numerics.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    deps = [
        "//model/moonshine-ai/moonshine-streaming-tiny/program:frontend",
        "//model/moonshine-ai/moonshine-streaming-tiny/program:projection",
    ],
)

loom_test(
    name = "state",
    srcs = ["state.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    deps = ["//model/moonshine-ai/moonshine-streaming-tiny/program:encoder_state"],
)

[
    transcription_test(
        name = encoding + "_transcription_test",
        deployment = "//model/moonshine-ai/moonshine-streaming-tiny:" + encoding,
    )
    for encoding in [
        "source",
        "archive",
        "mixed",
    ]
]
