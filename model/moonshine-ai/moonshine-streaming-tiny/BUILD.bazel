load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files(["model.json"])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    visibility = ["//visibility:public"],
)

genrule(
    name = "rotary",
    srcs = ["model.json"],
    outs = ["asset/rotary.safetensors"],
    cmd = "$(execpath @hrx//loom/py/loom/model:inline_file) --card=$(location model.json) --configuration=streaming --file=asset/rotary.safetensors --output=$@",
    tools = ["@hrx//loom/py/loom/model:inline_file"],
)

_PROGRAM_NAMES = [
    "control",
    "convolution",
    "decoder",
    "decoder_attention",
    "decoder_state",
    "encoder",
    "encoder_attention",
    "encoder_state",
    "frontend",
    "initialize",
    "normalization",
    "pointwise",
    "prepare",
    "projection",
    "reset",
]

_ASSETS = {
    ":rotary": "asset/rotary.safetensors",
    "//model/moonshine-ai/moonshine-streaming-tiny/program:weights.loom": "program/weights.loom",
    "@moonshine_checkpoint//file": "asset/model.safetensors",
    "@moonshine_tokenizer//file": "asset/text-vocabulary.data",
}

loom_model(
    name = "source",
    assets = _ASSETS,
    card = "model.json",
    configuration = "streaming",
    encoding = "preserve",
    files = {
        "//model/moonshine-ai/moonshine-streaming-tiny/program:" + name + ".loom": "program/" + name + ".loom"
        for name in _PROGRAM_NAMES
    },
    model_name = "moonshine-streaming-tiny",
    programs = "source",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

loom_model(
    name = "archive",
    assets = _ASSETS,
    card = "model.json",
    configuration = "streaming",
    encoding = "bc",
    files = {
        "//model/moonshine-ai/moonshine-streaming-tiny/program:" + name: "program/" + name + ".loombc"
        for name in _PROGRAM_NAMES
    },
    model_name = "moonshine-streaming-tiny",
    programs = "archive",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

loom_model(
    name = "mixed",
    assets = _ASSETS,
    card = "model.json",
    configuration = "streaming",
    encoding = "preserve",
    files = {
        "//model/moonshine-ai/moonshine-streaming-tiny/program:" + name + (".loom" if name in [
            "prepare",
            "control",
        ] else ""): "program/" + name + (".loom" if name in [
            "prepare",
            "control",
        ] else ".loombc")
        for name in _PROGRAM_NAMES
    },
    model_name = "moonshine-streaming-tiny",
    programs = "mixed",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
