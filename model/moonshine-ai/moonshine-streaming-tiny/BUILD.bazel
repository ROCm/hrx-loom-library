load("//build_tools/bazel:defs.bzl", "loom_model", "loom_model_documentation")

package(default_visibility = ["//visibility:private"])

exports_files([
    "model.json",
    "model.json.lock",
    "serve.json",
])

loom_model_documentation(
    name = "reference",
    card = "model.json",
    overview = "OVERVIEW.md",
    visibility = ["//visibility:public"],
)

_PROGRAM_NAMES = [
    "control",
    "convolution",
    "decoder",
    "decoder_attention",
    "decoder_state",
    "encoder",
    "encoder_attention",
    "encoder_state",
    "frontend",
    "initialize",
    "normalization",
    "pointwise",
    "prepare",
    "projection",
    "reset",
]

_DATA = {
    "//model/moonshine-ai/moonshine-streaming-tiny/program:weights.loom": "program/weights.loom",
}

loom_model(
    name = "source",
    card = "model.json",
    configuration = "streaming",
    data = _DATA,
    encoding = "preserve",
    files = {
        "//model/moonshine-ai/moonshine-streaming-tiny/program:" + name + ".loom": "program/" + name + ".loom"
        for name in _PROGRAM_NAMES
    },
    model_name = "moonshine-streaming-tiny",
    programs = "source",
    visibility = ["//visibility:public"],
)

loom_model(
    name = "archive",
    card = "model.json",
    configuration = "streaming",
    data = _DATA,
    encoding = "bc",
    files = {
        "//model/moonshine-ai/moonshine-streaming-tiny/program:" + name: "program/" + name + ".loombc"
        for name in _PROGRAM_NAMES
    },
    model_name = "moonshine-streaming-tiny",
    programs = "archive",
    visibility = ["//visibility:public"],
)

loom_model(
    name = "mixed",
    card = "model.json",
    configuration = "streaming",
    data = _DATA,
    encoding = "preserve",
    files = {
        "//model/moonshine-ai/moonshine-streaming-tiny/program:" + name + (".loom" if name in [
            "prepare",
            "control",
        ] else ""): "program/" + name + (".loom" if name in [
            "prepare",
            "control",
        ] else ".loombc")
        for name in _PROGRAM_NAMES
    },
    model_name = "moonshine-streaming-tiny",
    programs = "mixed",
    visibility = ["//visibility:public"],
)
