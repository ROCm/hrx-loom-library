// Exact Q8_1 x4 bytes from scalar block arithmetic, independently of the GPU
// lane layout. The directed inputs distinguish ties-away quantization, F32
// scale/sum formation, and nearest-even F16 metadata, including underflow and
// overflow. Whole-storage checks cover nonzero origins, guards, and immutable
// inputs. Multi-row inputs expose physical group and metadata ordering.
kernel.decl @ggml_quantize_q8_1_x4_f32(%tokens: index, %width: index) launch(%tokens_argument: index, %width_argument: index, %input: buffer, %output: buffer)

template.decl @case_shape(%configuration: index) -> (index, index)

template.def<@case_shape> @case_shape_values(%configuration: index) -> (index, index) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c9 = index.constant 9 : index
  %c128 = index.constant 128 : index
  %c384 = index.constant 384 : index
  %multi_row = index.cmp eq, %configuration, %c9 : index
  %all_codes = index.cmp eq, %configuration, %c2 : index
  %wide = scalar.ori %multi_row, %all_codes : i1
  %rows = scf.select %multi_row, %c3, %c1 : index
  %width = scf.select %wide, %c384, %c128 : index
  template.return %rows, %width : index, index
}

template.decl @storage_extents(%configuration: index) -> (index, index, index, offset)

template.def<@storage_extents> @storage_extents_values(%ordinal: index) -> (index, index, index, offset) {
  // Scenario configurations are exactly the ten authored input families.
  %configuration = index.assume %ordinal [ge(%ordinal, 0), lt(%ordinal, 10)] : index
  %rows, %width = template.apply<@case_shape>(%configuration) : (index) -> (index, index)
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %count = index.mul %rows, %width : index
  %groups = index.div %count, %c128 : index
  %packed_length = index.mul %groups, %c144 : index
  %input_count = index.add %count, %c8 : index
  %output_count = index.add %packed_length, %c32 : index
  %remainder = index.rem %configuration, %c3 : index
  %origin_words = index.add %remainder, %c1 : index
  %origin_bytes = index.mul %origin_words, %c4 : index
  %origin = index.cast %origin_bytes : index to offset
  template.return %count, %input_count, %output_count, %origin : index, index, index, offset
}

func.def @case_extents(%configuration: index) -> (index, index, index, offset) {
  %count, %input_count, %output_count, %origin = template.apply<@storage_extents>(%configuration) : (index) -> (index, index, index, offset)
  func.return %count, %input_count, %output_count, %origin : index, index, index, offset
}

// Rotated signed codes make each logical block distinguishable without a
// stored input table. Both extrema remain present to fix its scale.
func.def @rotated_code(%lane: index, %rotation: index) -> (f64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c17 = scalar.constant 17 : i32
  %c127 = scalar.constant 127.0 : f64
  %negative = scalar.constant -127.0 : f64
  %shifted = index.add %lane, %rotation : index
  %position = index.rem %shifted, %c32 : index
  %word = index.cast %position : index to i32
  %code = scalar.subi %word, %c17 : i32
  %value = scalar.sitofp %code : i32 to f64
  %first = index.cmp eq, %position, %c0 : index
  %second = index.cmp eq, %position, %c1 : index
  %signed = scf.select %second, %negative, %value : f64
  %result = scf.select %first, %c127, %signed : f64
  func.return %result : f64
}

func.def @input_value(%configuration: index, %element: index) -> (f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c9 = index.constant 9 : index
  %c26 = index.constant 26 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %block = index.div %element, %c32 : index
  %lane = index.rem %element, %c32 : index
  %c0_f64 = scalar.constant 0.0 : f64
  %c1_f64 = scalar.constant 1.0 : f64
  %c127_f64 = scalar.constant 127.0 : f64
  %negative_peak = scalar.constant -127.0 : f64
  %value = scf.switch %configuration -> (f64) {
    case 0 {
      %parity = index.rem %lane, %c2 : index
      %odd = index.cmp ne, %parity, %c0 : index
      %negative = scalar.constant -0.0 : f64
      %value = scf.select %odd, %negative, %c0_f64 : f64
      scf.yield %value : f64
    }
    case 1 {
      %half = scalar.constant 0.5 : f64
      %small = index.cmp uge, %block, %c2 : index
      %magnitude = scf.select %small, %half, %c1_f64 : f64
      %parity = index.rem %block, %c2 : index
      %odd = index.cmp ne, %parity, %c0 : index
      %negated = scalar.negf %magnitude : f64
      %value = scf.select %odd, %negated, %magnitude : f64
      scf.yield %value : f64
    }
    case 2 {
      %c255 = index.constant 255 : index
      %position = index.madd %block, %c31, %lane : index
      %available = index.cmp ult, %position, %c255 : index
      %word = index.cast %position : index to i32
      %c127_i32 = scalar.constant 127 : i32
      %code = scalar.subi %word, %c127_i32 : i32
      %converted = scalar.sitofp %code : i32 to f64
      %code_value = scf.select %available, %converted, %c0_f64 : f64
      %last = index.cmp eq, %lane, %c31 : index
      %with_peak = scf.select %last, %c127_f64, %code_value : f64
      %active = index.cmp ult, %block, %c9 : index
      %value = scf.select %active, %with_peak, %c0_f64 : f64
      scf.yield %value : f64
    }
    case 3 {
      %not_first = index.cmp ne, %lane, %c0 : index
      %value = scf.if %not_first -> (f64) {
        %second = index.cmp eq, %lane, %c1 : index
        %value = scf.if %second -> (f64) {
          scf.yield %negative_peak : f64
        } else {
          %active = index.cmp ult, %lane, %c26 : index
          %value = scf.if %active -> (f64) {
            %relative = index.sub %lane, %c2 : index
            %midpoint_index = index.div %relative, %c6 : index
            %within = index.rem %relative, %c6 : index
            %neighbor = index.rem %within, %c3 : index
            %half = scalar.constant 0.5 : f32
            %three_halves = scalar.constant 1.5 : f32
            %five_halves = scalar.constant 2.5 : f32
            %large_half = scalar.constant 63.5 : f32
            %midpoints = vector.from_elements %half, %three_halves, %five_halves, %large_half : vector<4xf32>
            %midpoint = vector.extract %midpoints[%midpoint_index] : vector<4xf32> -> f32
            %bits = scalar.bitcast %midpoint : f32 to i32
            %neighbor_word = index.cast %neighbor : index to i32
            %c1_i32 = scalar.constant 1 : i32
            %delta = scalar.subi %neighbor_word, %c1_i32 : i32
            %adjacent_bits = scalar.addi %bits, %delta : i32
            %adjacent = scalar.bitcast %adjacent_bits : i32 to f32
            %wide = scalar.extf %adjacent : f32 to f64
            %negated = scalar.negf %wide : f64
            %negative = index.cmp uge, %within, %c3 : index
            %value = scf.select %negative, %negated, %wide : f64
            scf.yield %value : f64
          } else {
            scf.yield %c0_f64 : f64
          }
          scf.yield %value : f64
        }
        scf.yield %value : f64
      } else {
        scf.yield %c127_f64 : f64
      }
      %small = scalar.constant 0.00390625 : f64
      %large = scalar.constant 256.0 : f64
      %c2_f64 = scalar.constant 2.0 : f64
      %scales = vector.from_elements %c1_f64, %small, %large, %c2_f64 : vector<4xf64>
      %scale = vector.extract %scales[%block] : vector<4xf64> -> f64
      %scaled = scalar.mulf %value, %scale : f64
      scf.yield %scaled : f64
    }
    case 4 {
      %c1_f32 = scalar.constant 1.0 : f32
      %c3_f32 = scalar.constant 3.0 : f32
      %fraction = scalar.constant 0.69999999999999996 : f32
      %c17_f32 = scalar.constant 17.0 : f32
      %peaks = vector.from_elements %c1_f32, %c3_f32, %fraction, %c17_f32 : vector<4xf32>
      %peak = vector.extract %peaks[%block] : vector<4xf32> -> f32
      %wide_peak = scalar.extf %peak : f32 to f64
      %c11 = index.constant 11 : index
      %c37 = index.constant 37 : index
      %c251 = index.constant 251 : index
      %c125 = scalar.constant 125 : i32
      %phase = index.mul %block, %c11 : index
      %sequence = index.madd %lane, %c37, %phase : index
      %reduced = index.rem %sequence, %c251 : index
      %word = index.cast %reduced : index to i32
      %centered = scalar.subi %word, %c125 : i32
      %coefficient = scalar.sitofp %centered : i32 to f64
      %product = scalar.mulf %wide_peak, %coefficient : f64
      %fractional = scalar.divf %product, %c127_f64 : f64
      %peak_lane = index.mul %block, %c9 : index
      %at_peak = index.cmp eq, %lane, %peak_lane : index
      %parity = index.rem %block, %c2 : index
      %positive = index.cmp ne, %parity, %c0 : index
      %negated = scalar.negf %wide_peak : f64
      %signed_peak = scf.select %positive, %wide_peak, %negated : f64
      %value = scf.select %at_peak, %signed_peak, %fractional : f64
      scf.yield %value : f64
    }
    case 5 {
      %c17 = index.constant 17 : index
      %below_half = scalar.constant 0.48999999999999999 : f64
      %above_half = scalar.constant 1.51 : f64
      %lower = index.cmp ult, %lane, %c17 : index
      %fraction = scf.select %lower, %below_half, %above_half : f64
      %parity = index.rem %block, %c2 : index
      %negative = index.cmp ne, %parity, %c0 : index
      %negated = scalar.negf %fraction : f64
      %signed = scf.select %negative, %negated, %fraction : f64
      %first = index.cmp eq, %lane, %c0 : index
      %second = index.cmp eq, %lane, %c1 : index
      %with_negative = scf.select %second, %negative_peak, %signed : f64
      %with_peaks = scf.select %first, %c127_f64, %with_negative : f64
      %quarter = scalar.constant 0.25 : f64
      %five_quarters = scalar.constant 1.25 : f64
      %small = scalar.constant 0.00390625 : f64
      %scales = vector.from_elements %c1_f64, %quarter, %five_quarters, %small : vector<4xf64>
      %scale = vector.extract %scales[%block] : vector<4xf64> -> f64
      %value = scalar.mulf %with_peaks, %scale : f64
      scf.yield %value : f64
    }
    case 6 {
      %tie_even = scalar.constant 1.00048828125 : f64
      %tie_odd = scalar.constant 1.00146484375 : f64
      %below_normal = scalar.constant 6.1005353927612305e-05 : f64
      %above_normal = scalar.constant 6.1064958572387695e-05 : f64
      %scales = vector.from_elements %tie_even, %tie_odd, %below_normal, %above_normal : vector<4xf64>
      %scale = vector.extract %scales[%block] : vector<4xf64> -> f64
      %rotation = index.mul %block, %c7 : index
      %code = func.call @rotated_code(%lane, %rotation) : (index, index) -> (f64)
      %value = scalar.mulf %code, %scale : f64
      scf.yield %value : f64
    }
    case 7 {
      %minimum = scalar.constant 5.9604644775390625e-08 : f64
      %half_minimum = scalar.constant 2.9802322387695312e-08 : f64
      %three_halves = scalar.constant 8.9406967163085938e-08 : f64
      %normal_f32 = scalar.constant 9.5367431640625e-07 : f64
      %scales = vector.from_elements %minimum, %half_minimum, %three_halves, %normal_f32 : vector<4xf64>
      %scale = vector.extract %scales[%block] : vector<4xf64> -> f64
      %rotation = index.mul %block, %c7 : index
      %code = func.call @rotated_code(%lane, %rotation) : (index, index) -> (f64)
      %value = scalar.mulf %code, %scale : f64
      scf.yield %value : f64
    }
    case 8 {
      %maximum = scalar.constant 65504.0 : f64
      %tie_infinity = scalar.constant 65520.0 : f64
      %overflow = scalar.constant 65536.0 : f64
      %half_range = scalar.constant 32768.0 : f64
      %scales = vector.from_elements %maximum, %tie_infinity, %overflow, %half_range : vector<4xf64>
      %scale = vector.extract %scales[%block] : vector<4xf64> -> f64
      %rotation = index.mul %block, %c7 : index
      %code = func.call @rotated_code(%lane, %rotation) : (index, index) -> (f64)
      %value = scalar.mulf %code, %scale : f64
      scf.yield %value : f64
    }
    default {
      %rotation = index.rem %block, %c32 : index
      %code = func.call @rotated_code(%lane, %rotation) : (index, index) -> (f64)
      %phase = index.rem %block, %c7 : index
      %word = index.cast %phase : index to i32
      %phase_value = scalar.sitofp %word : i32 to f64
      %eighth = scalar.constant 0.125 : f64
      %delta = scalar.mulf %phase_value, %eighth : f64
      %shifted = scalar.addf %code, %delta : f64
      %power = index.rem %block, %c9 : index
      %power_word = index.cast %power : index to i64
      %bias = scalar.constant 1019 : i64
      %exponent_shift = scalar.constant 52 : i64
      %exponent = scalar.addi %power_word, %bias : i64
      %bits = scalar.shli %exponent, %exponent_shift : i64
      %scale = scalar.bitcast %bits : i64 to f64
      %value = scalar.mulf %shifted, %scale : f64
      scf.yield %value : f64
    }
  }
  %rounded = scalar.fptrunc %value : f64 to f32
  func.return %rounded : f32
}

func.def @initialize_q8_case(%configuration: index, %input: buffer, %output: buffer) {
  %count, %input_count, %output_count, %origin = func.call @case_extents(%configuration) : (index) -> (index, index, index, offset)
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %configuration_word = index.cast %configuration : index to i32
  %header = buffer.view %output[%base] : buffer -> view<1xi32>
  view.store %configuration_word, %header[0] : i32, view<1xi32>
  %input_view = buffer.view %input[%origin] : buffer -> view<[%count]xf32>
  scf.for %element = [%c0 to %count step %c1] {
    %value = func.call @input_value(%configuration, %element) : (index, index) -> (f32)
    view.store %value, %input_view[%element] : f32, view<[%count]xf32>
  }
  func.return
}

// Round finite binary32 metadata to binary16 using integer guard/remainder
// bits. This keeps metadata conversion independent of the production cast.
func.def @half_bits(%value: f32) -> (i16) {
  %bits = scalar.bitcast %value : f32 to i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c16 = scalar.constant 16 : i32
  %c23 = scalar.constant 23 : i32
  %c102 = scalar.constant 102 : i32
  %c113 = scalar.constant 113 : i32
  %c143 = scalar.constant 143 : i32
  %sign_mask = scalar.constant 32768 : i32
  %exponent_mask = scalar.constant 255 : i32
  %fraction_mask = scalar.constant 8388607 : i32
  %sign_shifted = scalar.shrui %bits, %c16 : i32
  %sign = scalar.andi %sign_shifted, %sign_mask : i32
  %exponent_shifted = scalar.shrui %bits, %c23 : i32
  %exponent = scalar.andi %exponent_shifted, %exponent_mask : i32
  %fraction = scalar.andi %bits, %fraction_mask : i32
  %overflow = scalar.cmpi uge, %exponent, %c143 : i32
  %magnitude = scf.if %overflow -> (i32) {
    %infinity = scalar.constant 31744 : i32
    scf.yield %infinity : i32
  } else {
    %underflow = scalar.cmpi ult, %exponent, %c102 : i32
    %magnitude = scf.if %underflow -> (i32) {
      scf.yield %c0 : i32
    } else {
      %subnormal = scalar.cmpi ult, %exponent, %c113 : i32
      %integer, %remainder, %halfway = scf.if %subnormal -> (i32, i32, i32) {
        %implicit = scalar.constant 8388608 : i32
        %c126 = scalar.constant 126 : i32
        %significand = scalar.ori %fraction, %implicit : i32
        %shift = scalar.subi %c126, %exponent : i32
        %integer = scalar.shrui %significand, %shift : i32
        %unit = scalar.shli %c1, %shift : i32
        %mask = scalar.subi %unit, %c1 : i32
        %remainder = scalar.andi %significand, %mask : i32
        %halfway = scalar.shrui %unit, %c1 : i32
        scf.yield %integer, %remainder, %halfway : i32, i32, i32
      } else {
        %c10 = scalar.constant 10 : i32
        %c13 = scalar.constant 13 : i32
        %c112 = scalar.constant 112 : i32
        %mask = scalar.constant 8191 : i32
        %halfway = scalar.constant 4096 : i32
        %half_exponent = scalar.subi %exponent, %c112 : i32
        %biased = scalar.shli %half_exponent, %c10 : i32
        %half_fraction = scalar.shrui %fraction, %c13 : i32
        %integer = scalar.ori %biased, %half_fraction : i32
        %remainder = scalar.andi %fraction, %mask : i32
        scf.yield %integer, %remainder, %halfway : i32, i32, i32
      }
      %above = scalar.cmpi ugt, %remainder, %halfway : i32
      %tie = scalar.cmpi eq, %remainder, %halfway : i32
      %parity = scalar.andi %integer, %c1 : i32
      %odd = scalar.cmpi ne, %parity, %c0 : i32
      %odd_tie = scalar.andi %tie, %odd : i1
      %increment = scalar.ori %above, %odd_tie : i1
      %adjustment = scf.select %increment, %c1, %c0 : i32
      %rounded = scalar.addi %integer, %adjustment : i32
      scf.yield %rounded : i32
    }
    scf.yield %magnitude : i32
  }
  %encoded = scalar.ori %sign, %magnitude : i32
  %half = scalar.trunci %encoded : i32 to i16
  func.return %half : i16
}

func.def @round_away(%value: f32) -> (i32) {
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %negative_step = scalar.constant -1 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %half = scalar.constant 0.5 : f32
  %integer = scalar.fptosi %value : f32 to i32
  %whole = scalar.sitofp %integer : i32 to f32
  %fraction = scalar.subf %value, %whole : f32
  %distance = scalar.absf %fraction : f32
  %increment = scalar.cmpf oge, %distance, %half : f32
  %negative = scalar.cmpf olt, %value, %c0_f32 : f32
  %direction = scf.select %negative, %negative_step, %c1_i32 : i32
  %adjustment = scf.select %increment, %direction, %c0_i32 : i32
  %rounded = scalar.addi %integer, %adjustment : i32
  func.return %rounded : i32
}

func.def @reference(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c72 = index.constant 72 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c0_i32 = scalar.constant 0 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c127_f32 = scalar.constant 127.0 : f32
  %header = buffer.view %output[%base] : buffer -> view<1xi32>
  %configuration_word = view.load %header[0] : view<1xi32> -> i32
  %configuration = index.cast %configuration_word : i32 to index
  %count, %input_count, %output_count, %origin = func.call @case_extents(%configuration) : (index) -> (index, index, index, offset)
  %group_count = index.div %count, %c128 : index
  %packed_count = index.mul %group_count, %c144 : index
  %half_count = index.mul %group_count, %c72 : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%group_count]x4x32xf32>
  %metadata = buffer.view %output[%origin] : buffer -> view<[%half_count]xi16>
  %payload = buffer.view %output[%origin] : buffer -> view<[%packed_count]xi8>
  scf.for %group = [%c0 to %group_count step %c1] {
    scf.for %block = [%c0 to %c4 step %c1] {
      %maximum = scf.for %lane = [%c0 to %c32 step %c1](%peak = %c0_f32 : f32) -> (f32) {
        %value = view.load %input_view[%group, %block, %lane] : view<[%group_count]x4x32xf32> -> f32
        %magnitude = scalar.absf %value : f32
        %larger = scalar.cmpf ogt, %magnitude, %peak : f32
        %next = scf.select %larger, %magnitude, %peak : f32
        scf.yield %next : f32
      }
      %scale = scalar.divf %maximum, %c127_f32 : f32
      %nonzero = scalar.cmpf one, %scale, %c0_f32 : f32
      %inverse = scf.if %nonzero -> (f32) {
        %reciprocal = scalar.divf %c1_f32, %scale : f32
        scf.yield %reciprocal : f32
      } else {
        scf.yield %c0_f32 : f32
      }
      %group_payload = index.madd %group, %c144, %c16 : index
      %block_payload = index.madd %block, %c32, %group_payload : index
      %code_sum = scf.for %lane = [%c0 to %c32 step %c1](%sum = %c0_i32 : i32) -> (i32) {
        %value = view.load %input_view[%group, %block, %lane] : view<[%group_count]x4x32xf32> -> f32
        %scaled = scalar.mulf %value, %inverse : f32
        %code = func.call @round_away(%scaled) : (f32) -> (i32)
        %byte = scalar.trunci %code : i32 to i8
        %destination = index.add %block_payload, %lane : index
        view.store %byte, %payload[%destination] : i8, view<[%packed_count]xi8>
        %next = scalar.addi %sum, %code : i32
        scf.yield %next : i32
      }
      %sum_float = scalar.sitofp %code_sum : i32 to f32
      %sum_value = scalar.mulf %sum_float, %scale : f32
      %scale_bits = func.call @half_bits(%scale) : (f32) -> (i16)
      %sum_bits = func.call @half_bits(%sum_value) : (f32) -> (i16)
      %group_metadata = index.mul %group, %c72 : index
      %scale_position = index.madd %block, %c2, %group_metadata : index
      %sum_position = index.add %scale_position, %c1 : index
      view.store %scale_bits, %metadata[%scale_position] : i16, view<[%half_count]xi16>
      view.store %sum_bits, %metadata[%sum_position] : i16, view<[%half_count]xi16>
    }
  }
  func.return
}

command.program.def @quantize(%configuration: index) launch(%input_storage: buffer, %output_storage: buffer) {
  %rows, %width = template.apply<@case_shape>(%configuration) : (index) -> (index, index)
  %count, %input_count, %output_count, %origin = template.apply<@storage_extents>(%configuration) : (index) -> (index, index, index, offset)
  %c32 = index.constant 32 : index
  %packed_count = index.sub %output_count, %c32 : index
  %input = buffer.view %input_storage[%origin] : buffer -> view<[%rows]x[%width]xf32>
  %output = buffer.view %output_storage[%origin] : buffer -> view<[%packed_count]xi8>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%rows, %width](%rows, %width, %input, %output) : [index, index](index, index, view<[%rows]x[%width]xf32>, view<[%packed_count]xi8>)
  command.return
}

check.scenario public @packed_blocks configure[10](%configuration: index, %configuration_entropy: check.entropy) {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count, %input_count, %output_count, %origin = check.generate<@case_extents>(%configuration) : (index) -> (index, index, index, offset)
    %input_storage = check.generate.fill value(123.25) : tensor<[%input_count]xf32>
    %output_storage = check.generate.fill value(-99) : tensor<[%output_count]xi8>
    check.generate<@initialize_q8_case>(%configuration, %input_storage, %output_storage) : (index, tensor<[%input_count]xf32>, tensor<[%output_count]xi8>) -> ()
    check.compare<@quantize, @reference>[%configuration](%input_storage, %output_storage) : [index](tensor<[%input_count]xf32>, tensor<[%output_count]xi8>) -> () {
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<[%output_count]xi8>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<[%input_count]xf32>
    }
  }
  check.return
}

check.benchmark<@packed_blocks> @packed_blocks_quantize
