load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")
load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE", "AMD_GPU_TSAN_PROFILE", "amd_gpu_execution_profile")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

iree_py_test(
    name = "oracle_test",
    srcs = ["generate_q8_1_oracle.py"],
    args = [
        "--check",
        "--output=$(rootpath q8_1.loom)",
    ],
    data = ["q8_1.loom"],
    main = "generate_q8_1_oracle.py",
)

loom_test(
    name = "q8_1",
    srcs = ["q8_1.loom"],
    execution_profiles = [
        AMD_GPU_HARDWARE_PROFILE,
        AMD_GPU_TSAN_PROFILE,
        amd_gpu_execution_profile(
            name = "amd_gpu_access",
            runner_args = ["--sanitizer=access"],
            tags = ["notsan"],
        ),
    ],
    deps = ["//kernel/ggml/quantize:q8_1_x4_f32"],
)
