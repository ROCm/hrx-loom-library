// The nonzero case validates positive and negative metadata and payload bits.
// The sampled case covers token counts 1, 4, 8, 17, 32, 63, 128, 129, and 512
// at width 2048. Declared benchmarks name decode, small-batch, and prefill
// workloads.
kernel.decl @ggml_quantize_q8_1_x4_f32(%configured_token_count: index, %configured_input_size: index) launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer)

check.case public @ggml_quantize_q8_1_x4_f32_nonzero_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(128) : index
  %positive_input = check.generate.fill value(1.0) : tensor<128xf32>
  %negative_input = check.generate.fill value(-1.0) : tensor<128xf32>
  %positive_packed = check.generate.fill value(0) : tensor<36xi32>
  %negative_packed = check.generate.fill value(0) : tensor<36xi32>
  %positive_metadata = check.tensor.view %positive_packed offset(0) : tensor<36xi32> -> tensor<4xi32>
  %negative_metadata = check.tensor.view %negative_packed offset(0) : tensor<36xi32> -> tensor<4xi32>
  %positive_words = check.tensor.view %positive_packed offset(16) : tensor<36xi32> -> tensor<32xi32>
  %negative_words = check.tensor.view %negative_packed offset(16) : tensor<36xi32> -> tensor<32xi32>
  // Metadata words pack little-endian F16 pairs: positive (d = 0x2008,
  // s = 0x5000) and negative (d = 0x2008, s = 0xd000).
  %expected_positive_metadata = check.generate.fill value(1342185480) : tensor<4xi32>
  %expected_negative_metadata = check.generate.fill value(-805298168) : tensor<4xi32>
  // Payload words pack four +127 (0x7f) or -127 (0x81) I8 values.
  %expected_positive_words = check.generate.fill value(2139062143) : tensor<32xi32>
  %expected_negative_words = check.generate.fill value(-2122219135) : tensor<32xi32>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %positive_input, %positive_packed) : [index, index](index, index, tensor<128xf32>, tensor<36xi32>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %negative_input, %negative_packed) : [index, index](index, index, tensor<128xf32>, tensor<36xi32>)
  check.expect.equal actual(%positive_metadata) expected(%expected_positive_metadata) : tensor<4xi32>
  check.expect.equal actual(%negative_metadata) expected(%expected_negative_metadata) : tensor<4xi32>
  check.expect.equal actual(%positive_words) expected(%expected_positive_words) : tensor<32xi32>
  check.expect.equal actual(%negative_words) expected(%expected_negative_words) : tensor<32xi32>
  check.return
}

check.case public @ggml_quantize_q8_1_x4_f32_benchmark_case {
  %token_count = check.param.choice values([1, 4, 8, 17, 32, 63, 128, 129, 512]) name("token_count") : index
  %input_size = check.literal value(2048) : index
  %input = check.generate.fill value(0.0) : tensor<[%token_count]x2048xf32>
  %packed = check.generate.fill value(1) : tensor<[%token_count]x2304xi8>
  %expected = check.generate.fill value(0) : tensor<[%token_count]x2304xi8>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %packed) : [index, index](index, index, tensor<[%token_count]x2048xf32>, tensor<[%token_count]x2304xi8>)
  check.expect.equal actual(%packed) expected(%expected) : tensor<[%token_count]x2304xi8>
  check.return
}

check.benchmark<@ggml_quantize_q8_1_x4_f32_nonzero_case> @ggml_quantize_q8_1_x4_f32_small

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_decode {token_count = 1}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_small_batch_8 {token_count = 8}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_prefill_32 {token_count = 32}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_prefill_128 {token_count = 128}

check.benchmark<@ggml_quantize_q8_1_x4_f32_benchmark_case> @ggml_quantize_q8_1_x4_f32_prefill_512 {token_count = 512}
