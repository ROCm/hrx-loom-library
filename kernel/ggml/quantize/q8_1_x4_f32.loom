// GGML-compatible contiguous F32 to Q8_1 x4 activation quantization.
//
// Reference snapshot: llama.cpp commit
// 030ebb558a5820b444a8f836ed5cdd46c9b4bd7a.
//
//   https://github.com/ggml-org/llama.cpp/blob/030ebb558a5820b444a8f836ed5cdd46c9b4bd7a/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
//
// Physical representation and group template:
//   motif/format/ggml/q8_1_x4.loom
//
// Configuration ABI:
//   (token_count: index, input_size: index)
// Launch ABI:
//   (token_count: index, input_size: index, input: buffer, output: buffer)
//
// The input is a contiguous [token_count, input_size] F32 tensor. Token count
// is in [1, 2048]. Input size is in [128, 32768] and divisible by 128. The
// output requires token_count * input_size / 128 * 144 bytes. Each workgroup
// has 32 workitems and produces one complete 144-byte physical group.
// Launch configuration follows the workload exactly, so one command program
// can use multiple shapes without a package-global capacity binding.
//

template.decl @ggml.quantize_q8_1_x4.group_body(%publish_output: i1, %group_count: index, %group: index, %input: buffer, %output: buffer)

kernel.def export("ggml_quantize_q8_1_x4_f32") @ggml_quantize_q8_1_x4_f32(%token_count0: index, %input_size0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 128, 32768), multiple_of(%input_size0, 128)] : index
  %elements_per_group = index.constant 128 : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  %element_count = index.mul %token_count, %input_size : index
  %group_count0 = index.div %element_count, %elements_per_group : index
  %group_count = index.assume %group_count0 [range(%group_count0, 1, 524288)] : index
  kernel.launch.config workgroups(%group_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), multiple_of(%input_size, 128)] : index
  %elements_per_group = index.constant 128 : index
  %element_count = index.mul %bounded_token_count, %bounded_input_size : index
  %group_count0 = index.div %element_count, %elements_per_group : index
  %group_count = index.assume %group_count0 [range(%group_count0, 1, 524288)] : index
  %group0 = kernel.workgroup.id<x> : index
  %group = index.assume %group0 [lt(%group0, %group_count)] : index
  %publish_output = scalar.constant true : i1
  template.apply<@ggml.quantize_q8_1_x4.group_body>(%publish_output, %group_count, %group, %input, %output) : (i1, index, index, buffer, buffer)
  kernel.return
}

// The bounded entry adds a positive workgroup budget to the configuration ABI.
// The launch ABI and packed bytes are identical. Each group processes multiple
// physical records, synchronizing shared scratch before beginning the next one.
kernel.def export("ggml_quantize_q8_1_x4_f32_bounded") @ggml_quantize_q8_1_x4_f32_bounded(%token_count0: index, %input_size0: index, %workgroup_budget: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 128, 32768), multiple_of(%input_size0, 128)] : index
  %budget = index.assume %workgroup_budget [range(%workgroup_budget, 1, 2147483647)] : index
  %elements_per_group = index.constant 128 : index
  %element_count = index.mul %token_count, %input_size : index
  %record_count = index.div %element_count, %elements_per_group : index
  %groups = index.min %record_count, %budget : index
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%token_count0: index, %input_size0: index, %input: buffer, %output: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 2048)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 128, 32768), multiple_of(%input_size0, 128)] : index
  %elements_per_group = index.constant 128 : index
  %element_count = index.mul %token_count, %input_size : index
  %record_count = index.div %element_count, %elements_per_group : index
  %group = kernel.workgroup.id<x> : index
  %groups = kernel.workgroup.count<x> : index
  %publish_output = scalar.constant true : i1
  scf.for %record = [%group to %record_count step %groups] {
    template.apply<@ggml.quantize_q8_1_x4.group_body>(%publish_output, %record_count, %record, %input, %output) : (i1, index, index, buffer, buffer)
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}
