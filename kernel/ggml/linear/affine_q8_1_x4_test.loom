// Independent packed-byte affine projection references and workloads.
//
// Small randomized cases decode scalar bytes and accumulate each 32-value
// affine group in F64 on the CPU. They exercise every public launch form,
// signed activations, signed/zero coefficients, odd block counts, channel
// tails, distinct token rows, and complete eight-channel weight groups.
// Large workloads use a constant nonzero construction with an exact result.
// References never call production format readers or contraction motifs.

kernel.decl @ggml_linear_q4k_q8_1_x4(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q5k_q8_1_x4(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q5k_q8_1_x4_channel8(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q5k_q8_1_x4_m4(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q5k_q8_1_x4_m4_channel8(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.decl @initialize_affine(%uniform: i1, %fifth_bit: i1, %token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer)

func.decl @q4_channels1_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

