check.scenario public @q4_random {
  check.requires<hal.amdgpu.target> {targets = ["gfx11-generic", "gfx9-4-generic"]}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %uniform = check.literal value(false) : i1
    %fifth_bit = check.literal value(false) : i1
    %tokens = check.literal value(1) : index
    %inputs = check.literal value(256) : index
    %outputs = check.literal value(65) : index
    %input = check.generate.random.uniform seed(%input_seed) range(-16 to 15) : tensor<288xi8>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-128 to 127) : tensor<9360xi8>
    check.generate<@initialize_affine>(%uniform, %fifth_bit, %tokens, %inputs, %outputs, %input, %weight) : (i1, i1, index, index, index, tensor<288xi8>, tensor<9360xi8>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<73xf32>
    %output = check.tensor.view %storage offset(16) : tensor<73xf32> -> tensor<1x65xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<73xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(276) : tensor<73xf32> -> tensor<4xf32>
    check.compare<@ggml_linear_q4k_q8_1_x4, @q4_channels1_reference>[%tokens, %inputs, %outputs](%tokens, %inputs, %outputs, %input, %weight, %output) : [index, index, index](index, index, index, tensor<288xi8>, tensor<9360xi8>, tensor<1x65xf32>) -> () {
      check.expect.close actual(%storage) expected(%storage) atol(0.0001) rtol(1.9999999999999999e-06) nan(different) : tensor<73xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<288xi8>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<9360xi8>
    }
  }
  check.return
}

