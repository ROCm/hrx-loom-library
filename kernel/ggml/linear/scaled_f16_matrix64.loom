// Launch adapters for subgroup-32 64x64 GGML matrix projections.
//
// Configuration carries the row and output extents used to form a
// two-dimensional grid. Launch arguments repeat the complete dimensions and
// provide row-scaled F16 activations, their [scale, inverse] pairs, raw GGML
// weight rows, and F32 output storage. Every workgroup owns one 64x64 output
// tile and uses 256 threads. Numerical work and target requirements live in
// the shared motif.

template.decl @ggml.linear.scaled_f16_matrix64.q4k.store(%rows_arg: index, %k_arg: index, %n_arg: index, %x: buffer, %scales: buffer, %w: buffer, %y: buffer)

template.decl @ggml.linear.scaled_f16_matrix64.q4k.swiglu(%rows_arg: index, %k_arg: index, %n_arg: index, %x: buffer, %scales: buffer, %w: buffer, %w2: buffer, %y: buffer)

template.decl @ggml.linear.scaled_f16_matrix64.q5k.store(%rows_arg: index, %k_arg: index, %n_arg: index, %x: buffer, %scales: buffer, %w: buffer, %y: buffer)

template.decl @ggml.linear.scaled_f16_matrix64.q6k.store(%rows_arg: index, %k_arg: index, %n_arg: index, %x: buffer, %scales: buffer, %w: buffer, %y: buffer)

kernel.def export("ggml_linear_q4k_scaled_f16_matrix64") @ggml_linear_q4k_scaled_f16_matrix64(%rows: index, %n: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %row_tiles = index.div %rows, %c64 : index
  %out_tiles = index.div %n, %c64 : index
  kernel.launch.config workgroups(%out_tiles, %row_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows_arg: index, %k_arg: index, %n_arg: index, %x: buffer, %scales: buffer, %w: buffer, %y: buffer) {
  template.apply<@ggml.linear.scaled_f16_matrix64.q4k.store>(%rows_arg, %k_arg, %n_arg, %x, %scales, %w, %y) : (index, index, index, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("ggml_linear_q4k_scaled_f16_matrix64_swiglu") @ggml_linear_q4k_scaled_f16_matrix64_swiglu(%rows: index, %n: index) {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %row_tiles = index.div %rows, %c64 : index
  %out_tiles = index.div %n, %c64 : index
  kernel.launch.config workgroups(%out_tiles, %row_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows_arg: index, %k_arg: index, %n_arg: index, %x: buffer, %scales: buffer, %w: buffer, %w2: buffer, %y: buffer) {
  template.apply<@ggml.linear.scaled_f16_matrix64.q4k.swiglu>(%rows_arg, %k_arg, %n_arg, %x, %scales, %w, %w2, %y) : (index, index, index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

