// GGML Q8_0-by-Q8_1 x4 linear projection launch.
//
// Configuration is (live_rows, K, N); launch arguments are
// (row_capacity, K, N, activations, weights, output). The caller supplies
// 1 <= live_rows <= row_capacity <= 2048, K in 128..32768 divisible by
// 128, and N in 1..262144. Buffers are disjoint: row_capacity*K/128*144
// activation bytes, N*K/32*34 raw weight bytes, row_capacity*N F32 outputs.
// Only live_rows outputs are written. One subgroup owns each output channel,
// with 256-thread groups and target-selected 32- or 64-lane subgroups.
// The reusable schedule and format readers own contraction and byte layout.

template.decl @ggml.q8_0.q8_1_x4.body(%row_capacity: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer)

kernel.def export("ggml_linear_q8_0_q8_1_x4") @ggml_linear_q8_0_q8_1_x4(%live_rows: index, %input_size: index, %output_size: index) {
  %bounded_live_rows = index.assume %live_rows [range(%live_rows, 1, 2048)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %subgroup_size = target.subgroup.size : index
  %subgroups_per_workgroup = index.div %workgroup_size, %subgroup_size : index
  %tile_tail = index.sub %subgroups_per_workgroup, %c1 : index
  %padded_output_size = index.add %bounded_output_size, %tile_tail : index
  %output_tiles = index.div %padded_output_size, %subgroups_per_workgroup : index
  kernel.launch.config workgroups(%output_tiles, %bounded_live_rows, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%row_capacity: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
  template.apply<@ggml.q8_0.q8_1_x4.body>(%row_capacity, %input_size, %output_size, %q8_input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}
