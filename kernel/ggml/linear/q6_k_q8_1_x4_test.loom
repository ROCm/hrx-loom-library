// Q6_K q8 workloads; test/reference.loom owns the independent
// scalar-byte F64 oracle and nonzero analytical construction.

kernel.decl @ggml_linear_q6k_q8_1_x4(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4_m4(%configured_tokens: index, %configured_inputs: index, %configured_outputs: index) launch(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.decl @initialize_q6(%uniform: i1, %quantized: i1, %tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer)

func.decl @q6_q8_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.decl @q6_uniform_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

check.scenario public @q6_q8_single_block_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(false) : i1
    %quantized = check.literal value(true) : i1
    %tokens = check.literal value(1) : index
    %inputs = check.literal value(256) : index
    %outputs = check.literal value(1) : index
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-128 to 127) : tensor<288xi8>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-128 to 127) : tensor<210xi8>
    check.generate<@initialize_q6>(%uniform, %quantized, %tokens, %inputs, %outputs, %input, %weight) : (i1, i1, index, index, index, tensor<288xi8>, tensor<210xi8>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<9xf32>
    %output = check.tensor.view %storage offset(16) : tensor<9xf32> -> tensor<1x1xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<9xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(20) : tensor<9xf32> -> tensor<4xf32>
    check.compare<@ggml_linear_q6k_q8_1_x4, @q6_q8_reference>[%tokens, %inputs, %outputs](%tokens, %inputs, %outputs, %input, %weight, %output) : [index, index, index](index, index, index, tensor<288xi8>, tensor<210xi8>, tensor<1x1xf32>) -> () {
      check.expect.close actual(%storage) expected(%storage) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : tensor<9xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<288xi8>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<210xi8>
    }
  }
  check.return
}

check.benchmark<@q6_q8_single_block_case> @q6_q8_single_block

