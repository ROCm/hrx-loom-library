      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%inactive) expected(%inactive) : tensor<45xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<3488xi8>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<3676xi8>
    }
  }
  check.return
}

