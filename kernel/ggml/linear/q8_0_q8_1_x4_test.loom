check.scenario public @q8_0_value_projection_case {
  check.requires<hal.amdgpu.target> {targets = ["gfx11-generic", "gfx9-4-generic"]}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(true) : i1
    %live_rows = check.literal value(1) : index
    %row_capacity = check.literal value(1) : index
    %inputs = check.literal value(5120) : index
    %outputs = check.literal value(1024) : index
    %input_storage = check.generate.fill value(1) : tensor<5792xi8>
    %weight_storage = check.generate.fill value(-3) : tensor<5570564xi8>
    %input = check.tensor.view %input_storage offset(16) : tensor<5792xi8> -> tensor<5760xi8>
    %weight = check.tensor.view %weight_storage offset(2) : tensor<5570564xi8> -> tensor<5570560xi8>
    check.generate<@initialize_q8_0>(%uniform, %row_capacity, %inputs, %outputs, %input, %weight) : (i1, index, index, index, tensor<5760xi8>, tensor<5570560xi8>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<1032xf32>
    %output = check.tensor.view %storage offset(16) : tensor<1032xf32> -> tensor<1x1024xf32>
