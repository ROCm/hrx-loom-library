load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

# Shared independent oracles belong exclusively to test-owned modules.
filegroup(
    name = "reference",
    testonly = True,
    srcs = ["reference.loom"],
    visibility = ["//kernel/ggml/linear:__pkg__"],
)

loom_test(
    name = "q5_matrix",
    srcs = [
        "q5_matrix_test.loom",
        "reference.loom",
    ],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    deps = ["//motif/linear/ggml:q5_k_q8_1_x4_matrix_cdna"],
)

loom_test(
    name = "cohort",
    srcs = [
        "cohort_test.loom",
        "reference.loom",
    ],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    variants = {
        "eight": {"configs": {"cohort.rows": "8"}},
        "four": {"configs": {"cohort.rows": "4"}},
        "single": {"configs": {"cohort.rows": "1"}},
        "three": {"configs": {"cohort.rows": "3"}},
    },
    deps = [
        "//motif/linear/ggml:q5_k_q8_1_x4_cohort",
        "//motif/linear/ggml:q6_k_f32_cohort",
        "//motif/linear/ggml:q6_k_q8_1_x4_cohort",
    ],
)

filegroup(
    name = "q8_reference",
    testonly = True,
    srcs = ["q8_reference.loom"],
    visibility = ["//visibility:public"],
)

loom_test(
    name = "q8_matrix",
    srcs = [
        "q8_matrix_test.loom",
        ":q8_reference",
    ],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE],
    variants = {
        name: {"configs": {
            "q8_test.tile_rows": str(rows),
            "q8_test.tile_columns": str(columns),
            "q8_test.wave_rows": str(wave_rows),
            "q8_test.wave_columns": str(wave_columns),
            "q8_test.pipeline_depth": str(depth),
            "q8_test.stage_k": str(stage),
            "q8_test.streams": str(streams),
        }}
        for name, rows, columns, wave_rows, wave_columns, depth, stage, streams in [
            ("16x64_waves_1x4", 16, 64, 1, 4, 1, 0, 1),
            ("32x64_waves_2x2", 32, 64, 2, 2, 1, 0, 1),
            ("32x32_waves_2x2", 32, 32, 2, 2, 1, 0, 1),
            ("64x64_waves_2x2", 64, 64, 2, 2, 1, 0, 1),
            ("64x64_waves_4x2", 64, 64, 4, 2, 1, 0, 1),
            ("128x128_waves_4x2", 128, 128, 4, 2, 1, 0, 1),
            ("128x128_waves_4x2_read_ahead", 128, 128, 4, 2, 2, 0, 1),
            ("half_stage32", 128, 128, 4, 2, 2, 32, 1),
            ("half_stage64", 128, 128, 4, 2, 2, 64, 1),
            ("streams_four_stage_0", 128, 128, 4, 2, 2, 0, 4),
            ("streams_four_stage_32", 128, 128, 4, 2, 2, 32, 4),
            ("streams_four_stage_64", 128, 128, 4, 2, 2, 64, 4),
        ]
    },
    deps = [
        "//motif/linear/ggml:q8_0_bf16_matrix",
        "//motif/tensor:matrix_publication",
    ],
)
