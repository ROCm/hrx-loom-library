// Independent scalar references for GGML packed linear projections.
//
// Q4_K/Q5_K decode byte fields in logical groups with I64 signed products
// and F64 affine scaling, or explicit F32 rounding for serial matrix sums.
// Q6_K decodes logical elements and accumulates in F64 before one F32 rounding.
// Input constructors supply signed payloads,
// finite signed/zero block factors, and consistent Q8_1 sum headers.
// Uniform constructors have nonzero analytical results for larger workloads.
//
// All functions are private to the test root that merges this source. The
// source is shared by fixed-row kernel checks and cohort specialization
// checks; it has no production-format or contraction dependencies.

func.def @initialize_affine(%uniform: i1, %fifth_bit: i1, %token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %q8_blocks_per_group = index.constant 4 : index
  %groups_per_weight_block = index.constant 8 : index
  %metadata_bytes = index.constant 12 : index
  %group_values = index.constant 32 : index
  %weight_values = index.constant 256 : index
  %q8_group_values = index.constant 128 : index
  %q4_bytes = index.constant 144 : offset
  %q5_bytes = index.constant 176 : offset
  %q8_group_bytes = index.constant 144 : offset
  %header_bytes = index.constant 4 : offset
  %payload_add = index.constant 16 : offset
  %word_bytes = index.constant 4 : offset
  %block_bytes = scf.select %fifth_bit, %q5_bytes, %q4_bytes : offset
  %blocks_per_row = index.div %input_size, %weight_values : index
  %weight_blocks = index.mul %output_size, %blocks_per_row : index
  %zero_integer = scalar.constant 0 : i32
  %unit_coefficient = scalar.constant 1 : i8
  %paired_nibbles = scalar.constant 17 : i8
  %high_bits = scalar.constant -1 : i8
  %scale_unit = scalar.constant 0.0078125 : f32
  %minimum_unit = scalar.constant 0.00390625 : f32
  %center = scalar.constant 3.0 : f32
  %coefficient_period = index.constant 7 : index
  %uniform_scale = scalar.constant 0.125 : f32
  %uniform_minimum = scalar.constant 0.03125 : f32
  scf.for %block = [%begin to %weight_blocks step %unit] {
    %origin = index.scale %block, %block_bytes : index, offset -> offset
    %header = buffer.view %weight[%origin] : buffer -> view<2xf16>
    %ordinal = index.rem %block, %coefficient_period : index
    %integer = index.cast %ordinal : index to i32
    %floating = scalar.uitofp %integer : i32 to f32
    %centered = scalar.subf %floating, %center : f32
    %random_scale = scalar.mulf %centered, %scale_unit : f32
    %random_minimum = scalar.mulf %centered, %minimum_unit : f32
    %scale = scf.select %uniform, %uniform_scale, %random_scale : f32
    %minimum = scf.select %uniform, %uniform_minimum, %random_minimum : f32
    %scale_half = scalar.fptrunc %scale : f32 to f16
    %minimum_half = scalar.fptrunc %minimum : f32 to f16
    view.store %scale_half, %header[0] : f16, view<2xf16>
    view.store %minimum_half, %header[1] : f16, view<2xf16>
    scf.if %uniform {
      %metadata_origin = index.add %origin, %header_bytes : offset
      %metadata = buffer.view %weight[%metadata_origin] : buffer -> view<12xi8>
      scf.for %index = [%begin to %groups_per_weight_block step %unit] {
        view.store %unit_coefficient, %metadata[%index] : i8, view<12xi8>
      }
      scf.for %index = [%groups_per_weight_block to %metadata_bytes step %unit] {
        view.store %paired_nibbles, %metadata[%index] : i8, view<12xi8>
      }
      scf.if %fifth_bit {
        %high_origin = index.add %origin, %payload_add : offset
        %high = buffer.view %weight[%high_origin] : buffer -> view<32xi8>
        scf.for %index = [%begin to %group_values step %unit] {
          view.store %high_bits, %high[%index] : i8, view<32xi8>
        }
      }
    }
  }
  %q8_groups = index.div %input_size, %q8_group_values : index
  %q8_row_bytes = index.scale %q8_groups, %q8_group_bytes : index, offset -> offset
  %q8_blocks = index.div %input_size, %group_values : index
  %activation_unit = scalar.constant 0.03125 : f32
  %uniform_activation_scale = scalar.constant 0.5 : f32
  scf.for %row = [%begin to %token_count step %unit] {
    %row_origin = index.scale %row, %q8_row_bytes : index, offset -> offset
    scf.for %block = [%begin to %q8_blocks step %unit] {
      %group = index.div %block, %q8_blocks_per_group : index
      %within = index.rem %block, %q8_blocks_per_group : index
      %group_add = index.scale %group, %q8_group_bytes : index, offset -> offset
      %group_origin = index.add %row_origin, %group_add : offset
      %header_add = index.scale %within, %word_bytes : index, offset -> offset
      %header_origin = index.add %group_origin, %header_add : offset
      %payload_origin = index.add %group_origin, %payload_add : offset
      %codes = buffer.view %input[%payload_origin] : buffer -> view<4x32xi8>
      %header = buffer.view %input[%header_origin] : buffer -> view<2xf16>
      %ordinal0 = index.add %block, %row : index
      %ordinal = index.rem %ordinal0, %coefficient_period : index
      %integer = index.cast %ordinal : index to i32
      %floating = scalar.uitofp %integer : i32 to f32
      %centered = scalar.subf %floating, %center : f32
      %random_scale = scalar.mulf %centered, %activation_unit : f32
      %scale = scf.select %uniform, %uniform_activation_scale, %random_scale : f32
      %sum = scf.for %element = [%begin to %group_values step %unit](%running = %zero_integer : i32) -> (i32) {
        %byte = view.load %codes[%within, %element] : view<4x32xi8> -> i8
        %value = scalar.extsi %byte : i8 to i32
        %next = scalar.addi %running, %value : i32
        scf.yield %next : i32
      }
      %sum_float = scalar.sitofp %sum : i32 to f32
      %scaled_sum = scalar.mulf %scale, %sum_float : f32
      %scale_half = scalar.fptrunc %scale : f32 to f16
      %sum_half = scalar.fptrunc %scaled_sum : f32 to f16
      view.store %scale_half, %header[0] : f16, view<2xf16>
      view.store %sum_half, %header[1] : f16, view<2xf16>
    }
  }
  func.return
}

// F16 block coefficients multiplied by six-bit metadata are exact in F32.
// Serial matrix accumulation rounds each product, affine correction, and sum;
// subgroup reductions instead compare against the F64 mathematical result.
func.def @affine_accumulation_reference(%serial_f32: i1, %fifth_bit: i1, %weight_channels: index, %token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %groups_per_page = index.constant 2 : index
  %q8_blocks_per_group = index.constant 4 : index
  %groups_per_weight_block = index.constant 8 : index
  %group_values = index.constant 32 : index
  %weight_values = index.constant 256 : index
  %q8_group_values = index.constant 128 : index
  %origin = index.constant 0 : offset
  %q4_bytes = index.constant 144 : offset
  %q5_bytes = index.constant 176 : offset
  %q8_group_bytes = index.constant 144 : offset
  %header_add = index.constant 4 : offset
  %q4_payload_add = index.constant 16 : offset
  %q5_payload_add = index.constant 48 : offset
  %word_bytes = index.constant 4 : offset
  %mask4 = scalar.constant 15 : i32
  %mask6 = scalar.constant 63 : i32
  %mask1 = scalar.constant 1 : i32
  %shift4 = scalar.constant 4 : i32
  %shift6 = scalar.constant 6 : i32
  %zero_integer = scalar.constant 0 : i64
  %sum_identity = scalar.constant 0.0 : f64
  %block_bytes = scf.select %fifth_bit, %q5_bytes, %q4_bytes : offset
  %payload_add = scf.select %fifth_bit, %q5_payload_add, %q4_payload_add : offset
  %blocks = index.div %input_size, %weight_values : index
  %groups = index.div %input_size, %group_values : index
  %q8_groups = index.div %input_size, %q8_group_values : index
  %q8_row_bytes = index.scale %q8_groups, %q8_group_bytes : index, offset -> offset
  %results = buffer.view %output[%origin] : buffer -> view<[%token_count]x[%output_size]xf32>
  scf.for %row = [%begin to %token_count step %unit] {
    %input_origin = index.scale %row, %q8_row_bytes : index, offset -> offset
    scf.for %channel = [%begin to %output_size step %unit] {
      %channel_group = index.div %channel, %weight_channels : index
      %within_channel = index.rem %channel, %weight_channels : index
      %group_block_base = index.mul %channel_group, %blocks : index
      %sum = scf.for %group = [%begin to %groups step %unit](%running = %sum_identity : f64) -> (f64) {
        %block = index.div %group, %groups_per_weight_block : index
        %within = index.rem %group, %groups_per_weight_block : index
        %group_block = index.add %group_block_base, %block : index
        %physical_block = index.madd %group_block, %weight_channels, %within_channel : index
        %weight_origin = index.scale %physical_block, %block_bytes : index, offset -> offset
        %metadata_origin = index.add %weight_origin, %header_add : offset
        %payload_origin = index.add %weight_origin, %payload_add : offset
        %high_origin = index.add %weight_origin, %q4_payload_add : offset
        %header = buffer.view %weight[%weight_origin] : buffer -> view<2xf16>
        %metadata = buffer.view %weight[%metadata_origin] : buffer -> view<12xi8>
        %payload = buffer.view %weight[%payload_origin] : buffer -> view<128xi8>
        %high = buffer.view %weight[%high_origin] : buffer -> view<32xi8>
        %scale_half = view.load %header[0] : view<2xf16> -> f16
        %minimum_half = view.load %header[1] : view<2xf16> -> f16
        %scale = scalar.extf %scale_half : f16 to f64
        %minimum = scalar.extf %minimum_half : f16 to f64
        %direct = index.cmp ult, %within, %q8_blocks_per_group : index
        %scale_code, %minimum_code = scf.if %direct -> (i32, i32) {
          %minimum_index = index.add %within, %q8_blocks_per_group : index
          %scale_byte = view.load %metadata[%within] : view<12xi8> -> i8
          %minimum_byte = view.load %metadata[%minimum_index] : view<12xi8> -> i8
          %scale_integer = scalar.extui %scale_byte : i8 to i32
          %minimum_integer = scalar.extui %minimum_byte : i8 to i32
          %scale_code = scalar.andi %scale_integer, %mask6 : i32
          %minimum_code = scalar.andi %minimum_integer, %mask6 : i32
          scf.yield %scale_code, %minimum_code : i32, i32
        } else {
          %low_index = index.add %within, %q8_blocks_per_group : index
          %scale_high_index = index.sub %within, %q8_blocks_per_group : index
          %packed_byte = view.load %metadata[%low_index] : view<12xi8> -> i8
          %scale_high_byte = view.load %metadata[%scale_high_index] : view<12xi8> -> i8
          %minimum_high_byte = view.load %metadata[%within] : view<12xi8> -> i8
          %packed = scalar.extui %packed_byte : i8 to i32
          %scale_upper = scalar.extui %scale_high_byte : i8 to i32
          %minimum_upper = scalar.extui %minimum_high_byte : i8 to i32
          %scale_low = scalar.andi %packed, %mask4 : i32
          %minimum_low = scalar.shrui %packed, %shift4 : i32
          %scale_bits = scalar.shrui %scale_upper, %shift6 : i32
          %minimum_bits = scalar.shrui %minimum_upper, %shift6 : i32
          %scale_high = scalar.shli %scale_bits, %shift4 : i32
          %minimum_high = scalar.shli %minimum_bits, %shift4 : i32
          %scale_code = scalar.ori %scale_low, %scale_high : i32
          %minimum_code = scalar.ori %minimum_low, %minimum_high : i32
          scf.yield %scale_code, %minimum_code : i32, i32
        }
        %activation_group = index.div %group, %q8_blocks_per_group : index
        %activation_within = index.rem %group, %q8_blocks_per_group : index
        %activation_group_add = index.scale %activation_group, %q8_group_bytes : index, offset -> offset
        %activation_origin = index.add %input_origin, %activation_group_add : offset
        %activation_header_add = index.scale %activation_within, %word_bytes : index, offset -> offset
        %activation_header_origin = index.add %activation_origin, %activation_header_add : offset
        %activation_payload_origin = index.add %activation_origin, %q4_payload_add : offset
        %activation_header = buffer.view %input[%activation_header_origin] : buffer -> view<2xf16>
        %activation_payload = buffer.view %input[%activation_payload_origin] : buffer -> view<4x32xi8>
        %activation_scale_half = view.load %activation_header[0] : view<2xf16> -> f16
        %activation_sum_half = view.load %activation_header[1] : view<2xf16> -> f16
        %activation_scale = scalar.extf %activation_scale_half : f16 to f64
        %activation_sum = scalar.extf %activation_sum_half : f16 to f64
        %page = index.div %within, %groups_per_page : index
        %nibble = index.rem %within, %groups_per_page : index
        %nibble_integer = index.cast %nibble : index to i32
        %nibble_shift = scalar.muli %nibble_integer, %shift4 : i32
        %high_shift = index.cast %within : index to i32
        %dot = scf.for %element = [%begin to %group_values step %unit](%dot_sum = %zero_integer : i64) -> (i64) {
          %code_index = index.madd %page, %group_values, %element : index
          %code_byte = view.load %payload[%code_index] : view<128xi8> -> i8
          %code_integer = scalar.extui %code_byte : i8 to i32
          %shifted = scalar.shrui %code_integer, %nibble_shift : i32
          %low = scalar.andi %shifted, %mask4 : i32
          %code = scf.if %fifth_bit -> (i32) {
            %high_byte = view.load %high[%element] : view<32xi8> -> i8
            %high_integer = scalar.extui %high_byte : i8 to i32
            %selected = scalar.shrui %high_integer, %high_shift : i32
            %bit = scalar.andi %selected, %mask1 : i32
            %high_code = scalar.shli %bit, %shift4 : i32
            %combined = scalar.ori %low, %high_code : i32
            scf.yield %combined : i32
          } else {
            scf.yield %low : i32
          }
          %activation_byte = view.load %activation_payload[%activation_within, %element] : view<4x32xi8> -> i8
          %activation_integer = scalar.extsi %activation_byte : i8 to i64
          %weight_integer = scalar.extui %code : i32 to i64
          %product = scalar.muli %weight_integer, %activation_integer : i64
          %next = scalar.addi %dot_sum, %product : i64
          scf.yield %next : i64
        }
        %dot_float = scalar.sitofp %dot : i64 to f64
        %scale_float = scalar.uitofp %scale_code : i32 to f64
        %minimum_float = scalar.uitofp %minimum_code : i32 to f64
        %weight_scale = scalar.mulf %scale, %scale_float : f64
        %weight_minimum = scalar.mulf %minimum, %minimum_float : f64
        %next = scf.if %serial_f32 -> (f64) {
          %dot_single = scalar.sitofp %dot : i64 to f32
          %scale_single = scalar.fptrunc %weight_scale : f64 to f32
          %minimum_single = scalar.fptrunc %weight_minimum : f64 to f32
          %activation_scale_single = scalar.fptrunc %activation_scale : f64 to f32
          %activation_sum_single = scalar.fptrunc %activation_sum : f64 to f32
          %running_single = scalar.fptrunc %running : f64 to f32
          %combined_scale = scalar.mulf %scale_single, %activation_scale_single : f32
          %scaled_dot = scalar.mulf %combined_scale, %dot_single : f32
          %correction = scalar.mulf %minimum_single, %activation_sum_single : f32
          %contribution = scalar.subf %scaled_dot, %correction : f32
          %sum = scalar.addf %running_single, %contribution : f32
          %extended = scalar.extf %sum : f32 to f64
          scf.yield %extended : f64
        } else {
          %combined_scale = scalar.mulf %weight_scale, %activation_scale : f64
          %scaled_dot = scalar.mulf %combined_scale, %dot_float : f64
          %correction = scalar.mulf %weight_minimum, %activation_sum : f64
          %contribution = scalar.subf %scaled_dot, %correction : f64
          %sum = scalar.addf %running, %contribution : f64
          scf.yield %sum : f64
        }
        scf.yield %next : f64
      }
      %rounded = scalar.fptrunc %sum : f64 to f32
      view.store %rounded, %results[%row, %channel] : f32, view<[%token_count]x[%output_size]xf32>
    }
  }
  func.return
}

func.def @affine_reference(%fifth_bit: i1, %weight_channels: index, %token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %serial_f32 = scalar.constant false : i1
  func.call @affine_accumulation_reference(%serial_f32, %fifth_bit, %weight_channels, %token_count, %input_size, %output_size, %input, %weight, %output) : (i1, i1, index, index, index, index, buffer, buffer, buffer)
  func.return
}

func.def @affine_serial_f32_reference(%fifth_bit: i1, %weight_channels: index, %token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %serial_f32 = scalar.constant true : i1
  func.call @affine_accumulation_reference(%serial_f32, %fifth_bit, %weight_channels, %token_count, %input_size, %output_size, %input, %weight, %output) : (i1, i1, index, index, index, index, buffer, buffer, buffer)
  func.return
}

func.def @q4_channels1_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %fifth_bit = scalar.constant false : i1
  %channels = index.constant 1 : index
  func.call @affine_reference(%fifth_bit, %channels, %tokens, %inputs, %outputs, %input, %weight, %output) : (i1, index, index, index, index, buffer, buffer, buffer)
  func.return
}

func.def @q5_channels1_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %fifth_bit = scalar.constant true : i1
  %channels = index.constant 1 : index
  func.call @affine_reference(%fifth_bit, %channels, %tokens, %inputs, %outputs, %input, %weight, %output) : (i1, index, index, index, index, buffer, buffer, buffer)
  func.return
}

func.def @q5_channels8_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %fifth_bit = scalar.constant true : i1
  %channels = index.constant 8 : index
  func.call @affine_reference(%fifth_bit, %channels, %tokens, %inputs, %outputs, %input, %weight, %output) : (i1, index, index, index, index, buffer, buffer, buffer)
  func.return
}

// Each activation is 0.5; Q4 weights are 1 * 0.125 - 0.03125.
func.def @q4_uniform_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %coefficient = scalar.constant 0.046875 : f32
  %integer = index.cast %inputs : index to i32
  %floating = scalar.uitofp %integer : i32 to f32
  %expected = scalar.mulf %floating, %coefficient : f32
  %destination = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%outputs]xf32>
  scf.for %row = [%begin to %tokens step %unit] {
    scf.for %channel = [%begin to %outputs step %unit] {
      view.store %expected, %destination[%row, %channel] : f32, view<[%tokens]x[%outputs]xf32>
    }
  }
  func.return
}

// Q5 adds the high bit: each weight is 17 * 0.125 - 0.03125.
func.def @q5_uniform_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %coefficient = scalar.constant 1.046875 : f32
  %integer = index.cast %inputs : index to i32
  %floating = scalar.uitofp %integer : i32 to f32
  %expected = scalar.mulf %floating, %coefficient : f32
  %destination = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%outputs]xf32>
  scf.for %row = [%begin to %tokens step %unit] {
    scf.for %channel = [%begin to %outputs step %unit] {
      view.store %expected, %destination[%row, %channel] : f32, view<[%tokens]x[%outputs]xf32>
    }
  }
  func.return
}

func.def @initialize_q6(%uniform: i1, %quantized: i1, %tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %groups_per_record = index.constant 4 : index
  %scale_count = index.constant 16 : index
  %group_values = index.constant 32 : index
  %high_count = index.constant 64 : index
  %record_values = index.constant 128 : index
  %block_values = index.constant 256 : index
  %block_bytes = index.constant 210 : offset
  %high_add = index.constant 128 : offset
  %scale_add = index.constant 192 : offset
  %factor_add = index.constant 208 : offset
  %period = index.constant 7 : index
  %center = scalar.constant 3.0 : f32
  %factor_unit = scalar.constant 0.0009765625 : f32
  %uniform_factor = scalar.constant 0.125 : f32
  %uniform_scale = scalar.constant 3 : i8
  %uniform_high = scalar.constant -86 : i8
  %blocks_per_row = index.div %inputs, %block_values : index
  %blocks = index.mul %outputs, %blocks_per_row : index
  scf.for %block = [%begin to %blocks step %unit] {
    %origin = index.scale %block, %block_bytes : index, offset -> offset
    %factor_origin = index.add %origin, %factor_add : offset
    %factor_view = buffer.view %weight[%factor_origin] : buffer -> view<1xf16>
    %ordinal = index.rem %block, %period : index
    %integer = index.cast %ordinal : index to i32
    %floating = scalar.uitofp %integer : i32 to f32
    %centered = scalar.subf %floating, %center : f32
    %random_factor = scalar.mulf %centered, %factor_unit : f32
    %factor = scf.select %uniform, %uniform_factor, %random_factor : f32
    %half_factor = scalar.fptrunc %factor : f32 to f16
    view.store %half_factor, %factor_view[0] : f16, view<1xf16>
    scf.if %uniform {
      %high_origin = index.add %origin, %high_add : offset
      %scale_origin = index.add %origin, %scale_add : offset
      %high = buffer.view %weight[%high_origin] : buffer -> view<64xi8>
      %scales = buffer.view %weight[%scale_origin] : buffer -> view<16xi8>
      scf.for %element = [%begin to %high_count step %unit] {
        view.store %uniform_high, %high[%element] : i8, view<64xi8>
      }
      scf.for %element = [%begin to %scale_count step %unit] {
        view.store %uniform_scale, %scales[%element] : i8, view<16xi8>
      }
    }
  }
  scf.if %quantized {
    %record_bytes = index.constant 144 : offset
    %header_bytes = index.constant 4 : offset
    %payload_add = index.constant 16 : offset
    %zero_integer = scalar.constant 0 : i32
    %scale_unit = scalar.constant 0.00390625 : f32
    %uniform_activation_scale = scalar.constant 0.5 : f32
    %records = index.div %inputs, %record_values : index
    %row_bytes = index.scale %records, %record_bytes : index, offset -> offset
    %groups = index.div %inputs, %group_values : index
    scf.for %row = [%begin to %tokens step %unit] {
      %row_origin = index.scale %row, %row_bytes : index, offset -> offset
      scf.for %group = [%begin to %groups step %unit] {
        %record = index.div %group, %groups_per_record : index
        %within = index.rem %group, %groups_per_record : index
        %record_add = index.scale %record, %record_bytes : index, offset -> offset
        %record_origin = index.add %row_origin, %record_add : offset
        %header_add = index.scale %within, %header_bytes : index, offset -> offset
        %header_origin = index.add %record_origin, %header_add : offset
        %payload_origin = index.add %record_origin, %payload_add : offset
        %codes = buffer.view %input[%payload_origin] : buffer -> view<4x32xi8>
        %header = buffer.view %input[%header_origin] : buffer -> view<2xf16>
        %ordinal0 = index.add %group, %row : index
        %ordinal = index.rem %ordinal0, %period : index
        %integer = index.cast %ordinal : index to i32
        %floating = scalar.uitofp %integer : i32 to f32
        %centered = scalar.subf %floating, %center : f32
        %random_scale = scalar.mulf %centered, %scale_unit : f32
        %scale = scf.select %uniform, %uniform_activation_scale, %random_scale : f32
        %sum = scf.for %element = [%begin to %group_values step %unit](%running = %zero_integer : i32) -> (i32) {
          %byte = view.load %codes[%within, %element] : view<4x32xi8> -> i8
          %value = scalar.extsi %byte : i8 to i32
          %next = scalar.addi %running, %value : i32
          scf.yield %next : i32
        }
        %sum_float = scalar.sitofp %sum : i32 to f32
        %scaled_sum = scalar.mulf %scale, %sum_float : f32
        %scale_half = scalar.fptrunc %scale : f32 to f16
        %sum_half = scalar.fptrunc %scaled_sum : f32 to f16
        view.store %scale_half, %header[0] : f16, view<2xf16>
        view.store %sum_half, %header[1] : f16, view<2xf16>
      }
    }
  }
  func.return
}

func.def @q6_reference(%quantized: i1, %tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %nibbles = index.constant 2 : index
  %groups_per_record = index.constant 4 : index
  %scale_values = index.constant 16 : index
  %group_values = index.constant 32 : index
  %low_half_bytes = index.constant 64 : index
  %half_values = index.constant 128 : index
  %block_values = index.constant 256 : index
  %origin = index.constant 0 : offset
  %block_bytes = index.constant 210 : offset
  %high_add = index.constant 128 : offset
  %scale_add = index.constant 192 : offset
  %factor_add = index.constant 208 : offset
  %record_bytes = index.constant 144 : offset
  %header_bytes = index.constant 4 : offset
  %payload_add = index.constant 16 : offset
  %mask4 = scalar.constant 15 : i32
  %mask2 = scalar.constant 3 : i32
  %shift4 = scalar.constant 4 : i32
  %shift2 = scalar.constant 2 : i32
  %bias = scalar.constant 32 : i32
  %sum_identity = scalar.constant 0.0 : f64
  %blocks = index.div %inputs, %block_values : index
  %records = index.div %inputs, %half_values : index
  %input_row_bytes = index.scale %records, %record_bytes : index, offset -> offset
  %results = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%outputs]xf32>
  scf.for %row = [%begin to %tokens step %unit] {
    %input_origin = index.scale %row, %input_row_bytes : index, offset -> offset
    scf.for %channel = [%begin to %outputs step %unit] {
      %weight_block_base = index.mul %channel, %blocks : index
      %sum = scf.for %element = [%begin to %inputs step %unit](%running = %sum_identity : f64) -> (f64) {
        %block = index.div %element, %block_values : index
        %within = index.rem %element, %block_values : index
        %physical_block = index.add %weight_block_base, %block : index
        %weight_origin = index.scale %physical_block, %block_bytes : index, offset -> offset
        %high_origin = index.add %weight_origin, %high_add : offset
        %scale_origin = index.add %weight_origin, %scale_add : offset
        %factor_origin = index.add %weight_origin, %factor_add : offset
        %low = buffer.view %weight[%weight_origin] : buffer -> view<128xi8>
        %high = buffer.view %weight[%high_origin] : buffer -> view<64xi8>
        %scales = buffer.view %weight[%scale_origin] : buffer -> view<16xi8>
        %factor_view = buffer.view %weight[%factor_origin] : buffer -> view<1xf16>
        %half = index.div %within, %half_values : index
        %in_half = index.rem %within, %half_values : index
        %quadrant = index.div %in_half, %group_values : index
        %position = index.rem %within, %group_values : index
        %side = index.rem %quadrant, %nibbles : index
        %nibble = index.div %quadrant, %nibbles : index
        %low_half = index.mul %half, %low_half_bytes : index
        %low_side = index.madd %side, %group_values, %low_half : index
        %low_index = index.add %low_side, %position : index
        %high_index = index.madd %half, %group_values, %position : index
        %scale_index = index.div %within, %scale_values : index
        %low_byte = view.load %low[%low_index] : view<128xi8> -> i8
        %high_byte = view.load %high[%high_index] : view<64xi8> -> i8
        %scale_byte = view.load %scales[%scale_index] : view<16xi8> -> i8
        %factor_half = view.load %factor_view[0] : view<1xf16> -> f16
        %low_integer = scalar.extui %low_byte : i8 to i32
        %high_integer = scalar.extui %high_byte : i8 to i32
        %nibble_integer = index.cast %nibble : index to i32
        %quadrant_integer = index.cast %quadrant : index to i32
        %low_shift = scalar.muli %nibble_integer, %shift4 : i32
        %high_shift = scalar.muli %quadrant_integer, %shift2 : i32
        %shifted_low = scalar.shrui %low_integer, %low_shift : i32
        %shifted_high = scalar.shrui %high_integer, %high_shift : i32
        %low_bits = scalar.andi %shifted_low, %mask4 : i32
        %high_bits = scalar.andi %shifted_high, %mask2 : i32
        %positioned_high = scalar.shli %high_bits, %shift4 : i32
        %biased_code = scalar.ori %low_bits, %positioned_high : i32
        %code = scalar.subi %biased_code, %bias : i32
        %code_float = scalar.sitofp %code : i32 to f64
        %scale_float = scalar.sitofp %scale_byte : i8 to f64
        %factor = scalar.extf %factor_half : f16 to f64
        %weight_scaled = scalar.mulf %code_float, %scale_float : f64
        %weight_value = scalar.mulf %weight_scaled, %factor : f64
        %activation = scf.if %quantized -> (f64) {
          %group = index.div %element, %group_values : index
          %record = index.div %group, %groups_per_record : index
          %within_record = index.rem %group, %groups_per_record : index
          %record_add = index.scale %record, %record_bytes : index, offset -> offset
          %record_origin = index.add %input_origin, %record_add : offset
          %header_add = index.scale %within_record, %header_bytes : index, offset -> offset
          %header_origin = index.add %record_origin, %header_add : offset
          %payload_origin = index.add %record_origin, %payload_add : offset
          %header = buffer.view %input[%header_origin] : buffer -> view<2xf16>
          %payload = buffer.view %input[%payload_origin] : buffer -> view<4x32xi8>
          %scale_half = view.load %header[0] : view<2xf16> -> f16
          %byte = view.load %payload[%within_record, %position] : view<4x32xi8> -> i8
          %scale = scalar.extf %scale_half : f16 to f64
          %code = scalar.sitofp %byte : i8 to f64
          %value = scalar.mulf %scale, %code : f64
          scf.yield %value : f64
        } else {
          %values = buffer.view %input[%origin] : buffer -> view<[%tokens]x[%inputs]xf32>
          %single = view.load %values[%row, %element] : view<[%tokens]x[%inputs]xf32> -> f32
          %value = scalar.extf %single : f32 to f64
          scf.yield %value : f64
        }
        %product = scalar.mulf %weight_value, %activation : f64
        %next = scalar.addf %running, %product : f64
        scf.yield %next : f64
      }
      %rounded = scalar.fptrunc %sum : f64 to f32
      view.store %rounded, %results[%row, %channel] : f32, view<[%tokens]x[%outputs]xf32>
    }
  }
  func.return
}

func.def @q6_f32_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %quantized = scalar.constant false : i1
  func.call @q6_reference(%quantized, %tokens, %inputs, %outputs, %input, %weight, %output) : (i1, index, index, index, buffer, buffer, buffer)
  func.return
}

func.def @q6_q8_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %quantized = scalar.constant true : i1
  func.call @q6_reference(%quantized, %tokens, %inputs, %outputs, %input, %weight, %output) : (i1, index, index, index, buffer, buffer, buffer)
  func.return
}

// Each weight is (33 - 32) * 3 * 0.125 and each activation is 0.5.
func.def @q6_uniform_reference(%tokens: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %coefficient = scalar.constant 0.1875 : f32
  %integer = index.cast %inputs : index to i32
  %floating = scalar.uitofp %integer : i32 to f32
  %expected = scalar.mulf %floating, %coefficient : f32
  %destination = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%outputs]xf32>
  scf.for %row = [%begin to %tokens step %unit] {
    scf.for %channel = [%begin to %outputs step %unit] {
      view.store %expected, %destination[%row, %channel] : f32, view<[%tokens]x[%outputs]xf32>
    }
  }
  func.return
}
