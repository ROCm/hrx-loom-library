// Independent Q5_K/F16 scalar-byte dot product shared by matrix tests.
// Input is F16, coefficients round once to F16, and accumulation is F64.
// No production decoder, matrix fragment, or target schedule is used.

// Read each field by its original byte position. This deliberately shares no
// word carriers or bit-unpacking helper with the numerical implementation.
func.def inline @q5_f16_reference_dot(%rows: index, %inputs: index, %outputs: index, %channels: index, %row: index, %channel: index, %input: buffer, %weight: buffer) -> (f64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %group_width = index.constant 32 : index
  %block_width = index.constant 256 : index
  %block_bytes = index.constant 176 : offset
  %scales_add = index.constant 4 : offset
  %high_add = index.constant 16 : offset
  %low_add = index.constant 48 : offset
  %high_bit_mask = scalar.constant 1 : i32
  %nibble_shift = scalar.constant 4 : i32
  %scale_high_shift = scalar.constant 6 : i32
  %low_mask = scalar.constant 15 : i32
  %scale_mask = scalar.constant 63 : i32
  %blocks = index.div %inputs, %block_width : index
  %channel_group = index.div %channel, %channels : index
  %within_group = index.rem %channel, %channels : index
  %group_block = index.mul %channel_group, %blocks : index
  %activations = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xf16>
  %initial = scalar.constant 0.0 : f64
  %result = scf.for %column = [%c0 to %inputs step %c1](%sum = %initial : f64) -> (f64) {
    %block = index.div %column, %block_width : index
    %within_block = index.rem %column, %block_width : index
    %group = index.div %within_block, %group_width : index
    %element = index.rem %within_block, %group_width : index
    %block_group = index.add %group_block, %block : index
    %record = index.madd %block_group, %channels, %within_group : index
    %position = index.scale %record, %block_bytes : index, offset -> offset
    %scale_origin = index.add %position, %scales_add : offset
    %high_origin = index.add %position, %high_add : offset
    %low_origin = index.add %position, %low_add : offset
    %header = buffer.view %weight[%position] : buffer -> view<2xf16>
    %scales = buffer.view %weight[%scale_origin] : buffer -> view<12xi8>
    %high_bytes = buffer.view %weight[%high_origin] : buffer -> view<32xi8>
    %low_bytes = buffer.view %weight[%low_origin] : buffer -> view<128xi8>
    %d_half = view.load %header[0] : view<2xf16> -> f16
    %m_half = view.load %header[1] : view<2xf16> -> f16
    %d = scalar.extf %d_half : f16 to f64
    %minimum = scalar.extf %m_half : f16 to f64
    %lower_group = index.cmp ult, %group, %c4 : index
    %scale_code, %minimum_code = scf.if %lower_group -> (i32, i32) {
      %minimum_index = index.add %group, %c4 : index
      %scale_byte = view.load %scales[%group] : view<12xi8> -> i8
      %minimum_byte = view.load %scales[%minimum_index] : view<12xi8> -> i8
      %scale_word = scalar.extui %scale_byte : i8 to i32
      %minimum_word = scalar.extui %minimum_byte : i8 to i32
      %scale = scalar.andi %scale_word, %scale_mask : i32
      %value = scalar.andi %minimum_word, %scale_mask : i32
      scf.yield %scale, %value : i32, i32
    } else {
      %packed_index = index.add %group, %c4 : index
      %upper_index = index.sub %group, %c4 : index
      %packed_byte = view.load %scales[%packed_index] : view<12xi8> -> i8
      %upper_byte = view.load %scales[%upper_index] : view<12xi8> -> i8
      %minimum_byte = view.load %scales[%group] : view<12xi8> -> i8
      %packed = scalar.extui %packed_byte : i8 to i32
      %upper = scalar.extui %upper_byte : i8 to i32
      %minimum_word = scalar.extui %minimum_byte : i8 to i32
      %scale_low = scalar.andi %packed, %low_mask : i32
      %minimum_low = scalar.shrui %packed, %nibble_shift : i32
      %scale_top = scalar.shrui %upper, %scale_high_shift : i32
      %minimum_top = scalar.shrui %minimum_word, %scale_high_shift : i32
      %scale_high = scalar.shli %scale_top, %nibble_shift : i32
      %minimum_high = scalar.shli %minimum_top, %nibble_shift : i32
      %scale = scalar.ori %scale_low, %scale_high : i32
      %value = scalar.ori %minimum_low, %minimum_high : i32
      scf.yield %scale, %value : i32, i32
    }
    %page = index.div %group, %c2 : index
    %nibble = index.rem %group, %c2 : index
    %low_index = index.madd %page, %group_width, %element : index
    %low_byte = view.load %low_bytes[%low_index] : view<128xi8> -> i8
    %high_byte = view.load %high_bytes[%element] : view<32xi8> -> i8
    %low_word = scalar.extui %low_byte : i8 to i32
    %high_word = scalar.extui %high_byte : i8 to i32
    %shift_index = index.mul %nibble, %c4 : index
    %shift = index.cast %shift_index : index to i32
    %high_shift = index.cast %group : index to i32
    %shifted_low = scalar.shrui %low_word, %shift : i32
    %shifted_high = scalar.shrui %high_word, %high_shift : i32
    %low_code = scalar.andi %shifted_low, %low_mask : i32
    %high_bit = scalar.andi %shifted_high, %high_bit_mask : i32
    %high_code = scalar.shli %high_bit, %nibble_shift : i32
    %code = scalar.ori %low_code, %high_code : i32
    %code_float = scalar.uitofp %code : i32 to f64
    %scale_float = scalar.uitofp %scale_code : i32 to f64
    %minimum_float = scalar.uitofp %minimum_code : i32 to f64
    %scale = scalar.mulf %d, %scale_float : f64
    %bias = scalar.mulf %minimum, %minimum_float : f64
    %scaled = scalar.mulf %scale, %code_float : f64
    %coefficient = scalar.subf %scaled, %bias : f64
    %rounded = scalar.fptrunc %coefficient : f64 to f16
    %weight_value = scalar.extf %rounded : f16 to f64
    %activation_half = view.load %activations[%row, %column] : view<[%rows]x[%inputs]xf16> -> f16
    %activation = scalar.extf %activation_half : f16 to f64
    %product = scalar.mulf %weight_value, %activation : f64
    %next = scalar.addf %sum, %product : f64
    scf.yield %next : f64
  }
  func.return %result : f64
}
