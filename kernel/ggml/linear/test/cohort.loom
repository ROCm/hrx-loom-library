kernel.def target(@cohort_wave64) @cohort_q6_f32_wave64(%configured_inputs: index, %configured_outputs: index) {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  %channels = index.constant 2 : index
  %padding = index.constant 1 : index
  %padded = index.add %configured_outputs, %padding : index
  %groups = index.div %padded, %channels : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @cohort.rows : index
  func.call @ggml_linear_q6k_f32_cohort(%rows, %inputs, %outputs, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

