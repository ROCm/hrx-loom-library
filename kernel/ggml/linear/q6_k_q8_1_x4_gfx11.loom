// Q6_K projection of Q8_1 x4 activation rows to contiguous F32 output.
//
// Configuration ABI: (token_count, input_size, output_size), all index.
// Launch ABI: the same dimensions followed by (activations, weights, output).
// Buffers are disjoint. Weights occupy N*K/256*210 bytes in raw row order;
// activations occupy M*K/128*144 bytes; output occupies M*N*4 bytes.
// K is 256..17408 and divisible by 256; N is 1..262144. Single accepts
// M=1..2048; m4 requires exactly four rows. Grids follow workload values.
// One gfx11 wave64 subgroup advances across four weight blocks at a time.
// Reusable contraction and reduction code lives in motif/linear/ggml.
// These implementations join the same export families as the generic
// Q8 kernels; the linked target context selects their wave64 specialization.

amdgpu.target<gfx11-generic> @ggml_q6k_q8_gfx11_wave64 {subgroup_size = 64}

template.decl @ggml.q6k.q8_1_x4.block4.single.body(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)

template.decl @ggml.q6k.q8_1_x4.block4.four.body(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.def target(@ggml_q6k_q8_gfx11_wave64) export("ggml_linear_q6k_q8_1_x4") @ggml_linear_q6k_q8_1_x4_wave64_block4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %c1 = index.constant 1 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%bounded_output_size, %bounded_token_count, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  template.apply<@ggml.q6k.q8_1_x4.block4.single.body>(%token_count, %input_size, %output_size, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@ggml_q6k_q8_gfx11_wave64) export("ggml_linear_q6k_q8_1_x4_m4") @ggml_linear_q6k_q8_1_x4_m4_wave64_block4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 4, 4)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %c1 = index.constant 1 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%bounded_output_size, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  template.apply<@ggml.q6k.q8_1_x4.block4.four.body>(%token_count, %input_size, %output_size, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}
