// Q6_K projection of F32 activation rows to contiguous F32 output.
//
// Configuration ABI: (token_count, input_size, output_size), all index.
// Launch ABI: the same dimensions followed by (activations, weights, output).
// Buffers are disjoint. Weights occupy N*K/256*210 bytes in raw row order;
// activations occupy M*K*4 bytes; output occupies M*N*4 bytes.
// K is 256..17408 and divisible by 256; N is 1..262144. Single accepts
// M=1..4; m4 requires exactly four rows. Grids follow workload values.
// One subgroup computes two output channels, sharing its activation loads.
// Reusable contraction and reduction code lives in motif/linear/ggml.
// The caller selects a 32- or 64-lane target context.

template.decl @ggml.q6k.f32.single.body(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)

template.decl @ggml.q6k.f32.four.body(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.def export("ggml_linear_q6k_f32_decode") @ggml_linear_q6k_f32_decode(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 4)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %subgroup_size = target.subgroup.size : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %padded_output_size = index.add %bounded_output_size, %c1 : index
  %output_tiles = index.div %padded_output_size, %c2 : index
  kernel.launch.config workgroups(%output_tiles, %bounded_token_count, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  template.apply<@ggml.q6k.f32.single.body>(%token_count, %input_size, %output_size, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("ggml_linear_q6k_f32_decode_m4") @ggml_linear_q6k_f32_decode_m4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 4, 4)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %subgroup_size = target.subgroup.size : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %padded_output_size = index.add %bounded_output_size, %c1 : index
  %output_tiles = index.div %padded_output_size, %c2 : index
  kernel.launch.config workgroups(%output_tiles, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  template.apply<@ggml.q6k.f32.four.body>(%token_count, %input_size, %output_size, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}
