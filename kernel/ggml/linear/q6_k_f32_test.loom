    %tokens = check.literal value(1) : index
    %inputs = check.literal value(17408) : index
    %outputs = check.literal value(65) : index
    %input = check.generate.fill value(0.5) : tensor<1x17408xf32>
    %weight = check.generate.fill value(17) : tensor<928200xi8>
    check.generate<@initialize_q6>(%uniform, %quantized, %tokens, %inputs, %outputs, %input, %weight) : (i1, i1, index, index, index, tensor<1x17408xf32>, tensor<928200xi8>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<73xf32>
    %output = check.tensor.view %storage offset(16) : tensor<73xf32> -> tensor<1x65xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<73xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(276) : tensor<73xf32> -> tensor<4xf32>
    check.compare<@ggml_linear_q6k_f32_decode, @q6_uniform_reference>[%tokens, %inputs, %outputs](%tokens, %inputs, %outputs, %input, %weight, %output) : [index, index, index](index, index, index, tensor<1x17408xf32>, tensor<928200xi8>, tensor<1x65xf32>) -> () {
      check.expect.close actual(%storage) expected(%storage) atol(0.0) rtol(0.0) nan(different) : tensor<73xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1x17408xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<928200xi8>
    }
  }
  check.return
}

