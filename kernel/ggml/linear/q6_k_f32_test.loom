    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-1.0 to 1.0) : tensor<3x768xf32>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-128 to 127) : tensor<5670xi8>
    check.generate<@initialize_q6>(%uniform, %quantized, %tokens, %inputs, %outputs, %input, %weight) : (i1, i1, index, index, index, tensor<3x768xf32>, tensor<5670xi8>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<35xf32>
    %output = check.tensor.view %storage offset(16) : tensor<35xf32> -> tensor<3x9xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<35xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(124) : tensor<35xf32> -> tensor<4xf32>
    check.compare<@ggml_linear_q6k_f32_decode, @q6_f32_reference>[%tokens, %inputs, %outputs](%tokens, %inputs, %outputs, %input, %weight, %output) : [index, index, index](index, index, index, tensor<3x768xf32>, tensor<5670xi8>, tensor<3x9xf32>) -> () {
      check.expect.close actual(%storage) expected(%storage) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : tensor<35xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<3x768xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<5670xi8>
    }
  }
  check.return
}

