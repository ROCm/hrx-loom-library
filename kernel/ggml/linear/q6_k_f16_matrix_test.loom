// F16 matrix projections against the shared independent byte/F64 oracle.
// Random payloads cover signed six-bit codes and group scales; finite signed
// block factors prevent arbitrary header NaNs. The oracle rounds coefficients
// to F16, then accumulates in F64 before F32 publication. A bounded absolute
// plus relative allowance covers native matrix association on these fixtures.
// The maximum-K fixture uses exactly represented dyadic products so
// it checks every reduction step without a length-dependent rounding budget.
// Both publication modes check the complete guarded arena and immutable inputs.
// Small scenarios exercise empty capacity/live prefixes, tile tails, a partial
// channel group, maximum K, and repeated tiles within one bounded worker.

config.decl @q6_matrix_test.residual : %value: index where [range(%value, 0, 1)]

kernel.decl @ggml_linear_q6k_f16_matrix(%capacity: index, %inputs: index, %outputs: index, %budget: index) launch(%count: buffer, %launch_capacity: index, %launch_inputs: index, %launch_outputs: index, %launch_budget: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_f16_matrix_residual(%capacity: index, %inputs: index, %outputs: index, %budget: index) launch(%count: buffer, %launch_capacity: index, %launch_inputs: index, %launch_outputs: index, %launch_budget: index, %input: buffer, %weight: buffer, %output: buffer)

func.decl @initialize_q6(%uniform: i1, %quantized: i1, %rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer)

func.decl @q6_f16_reference(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.def pure @geometry(%configuration: index) -> (index, index, index, index, index, index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c17 = index.constant 17 : index
  %tail = index.constant 257 : index
  %extent = index.constant 512 : index
  %block_values = index.constant 256 : index
  %odd_k = index.constant 768 : index
  %maximum_k = index.constant 32768 : index
  %channel_group_tail = index.constant 2049 : index
  %maximum_budget = index.constant 10000 : index
  %block_bytes = index.constant 210 : index
  %guards = index.constant 8 : index
  %empty = index.cmp eq, %configuration, %c0 : index
  %inactive = index.cmp eq, %configuration, %c1 : index
  %single = index.cmp eq, %configuration, %c2 : index
  %partial = index.cmp eq, %configuration, %c3 : index
  %row_boundary = index.cmp eq, %configuration, %c4 : index
  %group_boundary = index.cmp eq, %configuration, %c5 : index
  %long_k = index.cmp eq, %configuration, %c6 : index
  %boundary_rows = scf.select %row_boundary, %tail, %c1 : index
  %partial_rows = scf.select %partial, %c17, %boundary_rows : index
  %no_rows = scalar.ori %empty, %inactive : i1
  %rows = scf.select %no_rows, %c0, %partial_rows : index
  %capacity = scf.select %empty, %c0, %extent : index
  %ordinary_k = scf.select %partial, %odd_k, %block_values : index
  %inputs = scf.select %long_k, %maximum_k, %ordinary_k : index
  %partial_channels = scf.select %partial, %tail, %c1 : index
  %outputs = scf.select %group_boundary, %channel_group_tail, %partial_channels : index
  %direct = scalar.ori %single, %partial : i1
  %budget = scf.select %direct, %maximum_budget, %c1 : index
  %blocks = index.div %inputs, %block_values : index
  %records = index.mul %outputs, %blocks : index
  %weight_bytes = index.mul %records, %block_bytes : index
  %elements = index.mul %capacity, %outputs : index
  %storage_count = index.add %elements, %guards : index
  func.return %rows, %capacity, %inputs, %outputs, %budget, %weight_bytes, %storage_count : index, index, index, index, index, index, index
}

func.def @set_shape(%rows: index, %inputs: index, %outputs: index, %shape: buffer) {
  %origin = index.constant 0 : offset
  %rows_word = index.cast %rows : index to i32
  %inputs_word = index.cast %inputs : index to i32
  %outputs_word = index.cast %outputs : index to i32
  %view = buffer.view %shape[%origin] : buffer -> view<3xi32>
  view.store %rows_word, %view[0] : i32, view<3xi32>
  view.store %inputs_word, %view[1] : i32, view<3xi32>
  view.store %outputs_word, %view[2] : i32, view<3xi32>
  func.return
}

// The long reduction keeps random low codes, but its common dyadic factors
// make every partial sum exact in F32. Shorter cases retain random signed
// coefficients and exercise F16 coefficient rounding against the F64 oracle.
func.def @initialize_matrix_fixture(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer) {
  %maximum_k = index.constant 32768 : index
  %uniform = index.cmp eq, %inputs, %maximum_k : index
  %quantized = scalar.constant false : i1
  func.call @initialize_q6(%uniform, %quantized, %rows, %inputs, %outputs, %input, %weight) : (i1, i1, index, index, index, buffer, buffer)
  scf.if %uniform {
    %origin = index.constant 0 : offset
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %half = scalar.constant 0.5 : f16
    %values = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xf16>
    scf.for %row = [%c0 to %rows step %c1] {
      scf.for %column = [%c0 to %inputs step %c1] {
        view.store %half, %values[%row, %column] : f16, view<[%rows]x[%inputs]xf16>
      }
    }
  }
  func.return
}

command.def @project(%configuration: index) launch(%count: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %rows, %capacity, %inputs, %outputs, %budget, %weight_bytes, %storage_count = func.call pure @geometry(%configuration) : (index) -> (index, index, index, index, index, index, index)
  %c0 = index.constant 0 : index
  %mode = config.get @q6_matrix_test.residual : index
  %residual = index.cmp ne, %mode, %c0 : index
  scf.if %residual {
    kernel.launch @ggml_linear_q6k_f16_matrix_residual[%capacity, %inputs, %outputs, %budget](%count, %capacity, %inputs, %outputs, %budget, %input, %weight, %output) : [index, index, index, index](buffer, index, index, index, index, buffer, buffer, buffer)
  } else {
    kernel.launch @ggml_linear_q6k_f16_matrix[%capacity, %inputs, %outputs, %budget](%count, %capacity, %inputs, %outputs, %budget, %input, %weight, %output) : [index, index, index, index](buffer, index, index, index, index, buffer, buffer, buffer)
  }
  command.return
}

func.def @reference(%count: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %counts = buffer.view %count[%origin] : buffer -> view<3xi32>
  %rows_word = view.load %counts[0] : view<3xi32> -> i32
  %inputs_word = view.load %counts[1] : view<3xi32> -> i32
  %outputs_word = view.load %counts[2] : view<3xi32> -> i32
  %rows = index.cast %rows_word : i32 to index
  %inputs = index.cast %inputs_word : i32 to index
  %outputs = index.cast %outputs_word : i32 to index
  func.call @q6_f16_reference(%rows, %inputs, %outputs, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  %mode = config.get @q6_matrix_test.residual : index
  %residual = index.cmp ne, %mode, %c0 : index
  scf.if %residual {
    %results = buffer.view %output[%origin] : buffer -> view<[%rows]x[%outputs]xf32>
    %initial = scalar.constant -99.0 : f32
    scf.for %row = [%c0 to %rows step %c1] {
      scf.for %channel = [%c0 to %outputs step %c1] {
        %value = view.load %results[%row, %channel] : view<[%rows]x[%outputs]xf32> -> f32
        %sum = scalar.addf %value, %initial : f32
        view.store %sum, %results[%row, %channel] : f32, view<[%rows]x[%outputs]xf32>
      }
    }
  }
  func.return
}

check.scenario public @q6_f16_matrices configure[7](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %rows, %capacity, %inputs, %outputs, %budget, %weight_bytes, %storage_count = check.generate<@geometry>(%configuration) : (index) -> (index, index, index, index, index, index, index)
    %count = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@set_shape>(%rows, %inputs, %outputs, %count) : (index, index, index, tensor<3xi32>) -> ()
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-1.0 to 1.0) : tensor<[%rows]x[%inputs]xf16>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-128 to 127) : tensor<[%weight_bytes]xi8>
    check.generate<@initialize_matrix_fixture>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, tensor<[%rows]x[%inputs]xf16>, tensor<[%weight_bytes]xi8>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<[%storage_count]xf32>
    %output = check.tensor.view %storage offset(16) : tensor<[%storage_count]xf32> -> tensor<[%capacity]x[%outputs]xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<[%storage_count]xf32> -> tensor<4xf32>
    check.compare<@project, @reference>[%configuration](%count, %input, %weight, %output) : [index](tensor<3xi32>, tensor<[%rows]x[%inputs]xf16>, tensor<[%weight_bytes]xi8>, tensor<[%capacity]x[%outputs]xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : tensor<[%storage_count]xf32>, tensor<[%storage_count]xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xf32>
      check.expect.bitwise actual(%count) expected(%count) : tensor<3xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%rows]x[%inputs]xf16>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<[%weight_bytes]xi8>
    }
  }
  check.return
}

check.benchmark<@q6_f16_matrices> @q6_f16_matrix_shapes
