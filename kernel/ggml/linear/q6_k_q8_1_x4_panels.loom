// Q6_K projection with caller-owned workgroup population and row/panel reuse.
//
// Each entry fixes its accumulator bank: M1/M2/M3/M4 retain four output
// panels, M8 retains two, and M32 retains one. All use the same contraction.
// Configuration ABI: (K, N, workgroup_budget), all index. Launch ABI:
// (K, N, activations, weights, output). K is 256..32768, divisible by 256;
// N is 1..262144. Buffers are disjoint and contain M*K/128*144 Q8_1 x4
// activation bytes, N*K/256*210 raw Q6_K bytes, and M*N contiguous F32
// results. The motif owns decoding, accumulation, and channel tails.
//
// The positive workgroup budget describes the caller's admitted execution
// scope. The launch clamps it to useful output tiles; each group visits more
// tiles as N grows. A group contains 256 workitems and eight logical 32-lane
// clusters. Subgroup width comes from the execution context. These entries
// do not infer device capacity or freeze the matrix dimensions.

template.decl @ggml.q6k.q8_1_x4.panels.body(%rows: index, %panels: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.def pure inline @ggml_q6k_q8_1_x4_panel_groups(%panels: index, %outputs: index, %workgroup_budget: index) -> (index) {
  %bounded_outputs = index.assume %outputs [range(%outputs, 1, 262144)] : index
  %budget = index.assume %workgroup_budget [range(%workgroup_budget, 1, 2147483647)] : index
  %c1 = index.constant 1 : index
  %clusters = index.constant 8 : index
  %tile_width = index.mul %panels, %clusters : index
  %padding = index.sub %tile_width, %c1 : index
  %padded_outputs = index.add %bounded_outputs, %padding : index
  %tiles = index.div %padded_outputs, %tile_width : index
  %groups = index.min %tiles, %budget : index
  func.return %groups : index
}

kernel.def export("ggml_linear_q6k_q8_1_x4_panels_m1") @ggml_linear_q6k_q8_1_x4_panels_m1(%inputs: index, %outputs: index, %workgroup_budget: index) {
  %panels = index.constant 4 : index
  %groups = func.call pure @ggml_q6k_q8_1_x4_panel_groups(%panels, %outputs, %workgroup_budget) : (index, index, index) -> (index)
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 1 : index
  %panels = index.constant 4 : index
  template.apply<@ggml.q6k.q8_1_x4.panels.body>(%rows, %panels, %inputs, %outputs, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

