// Paired Q5/F16 contraction against an independent scalar-byte F64 oracle.
// Random payloads exercise every scale/minimum and fifth-bit position; finite
// dyadic headers keep products bounded. The oracle rounds reconstructed weights
// to F16, accumulates in F64, and evaluates SwiGLU without matrix fragments or
// production decoders. One F16 relative rounding unit plus a subnormal unit
// covers matrix association and the hardware SiLU approximation. The complete
// arena is checked, with exact prefix guards. Small scenarios cover raw/channel-eight
// layouts, K256/K768/maximum-K, both tile tails, and bounded worker reuse.

kernel.decl @ggml_linear_q5k_f16_pair(%capacity: index, %inputs: index, %outputs: index, %weight_channels: index, %budget: index) launch(%count: buffer, %launch_capacity: index, %launch_inputs: index, %launch_outputs: index, %launch_channels: index, %launch_budget: index, %input: buffer, %gate: buffer, %up: buffer, %output: buffer)

config.decl @q5_pair_test.channels : %value: index where [range(%value, 1, 8)]

func.def pure @geometry(%trial: index) -> (index, index, index, index, index, index, index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c17 = index.constant 17 : index
  %row_tail = index.constant 257 : index
  %row_capacity = index.constant 512 : index
  %block = index.constant 256 : index
  %odd_k = index.constant 768 : index
  %maximum_k = index.constant 32768 : index
  %channel_tail = index.constant 129 : index
  %group_tail = index.constant 4097 : index
  %block_bytes = index.constant 176 : index
  %guards = index.constant 16 : index
  %channels = config.get @q5_pair_test.channels : index
  %empty = index.cmp eq, %trial, %c0 : index
  %inactive = index.cmp eq, %trial, %c1 : index
  %one_row = index.cmp eq, %trial, %c2 : index
  %partial = index.cmp eq, %trial, %c3 : index
  %row_boundary = index.cmp eq, %trial, %c4 : index
  %channel_group = index.cmp eq, %trial, %c5 : index
  %long_k = index.cmp eq, %trial, %c6 : index
  %boundary_rows = scf.select %row_boundary, %row_tail, %c1 : index
  %partial_rows = scf.select %partial, %c17, %boundary_rows : index
  %no_rows = scalar.ori %empty, %inactive : i1
  %rows = scf.select %no_rows, %c0, %partial_rows : index
  %capacity = scf.select %empty, %c0, %row_capacity : index
  %ordinary_k = scf.select %partial, %odd_k, %block : index
  %inputs = scf.select %long_k, %maximum_k, %ordinary_k : index
  %partial_columns = scf.select %partial, %channel_tail, %c1 : index
  %columns = scf.select %channel_group, %group_tail, %partial_columns : index
  %padding = index.sub %channels, %c1 : index
  %padded_columns = index.add %columns, %padding : index
  %groups = index.div %padded_columns, %channels : index
  %outputs = index.mul %groups, %channels : index
  %budget = scf.select %one_row, %c2, %c1 : index
  %blocks = index.div %inputs, %block : index
  %records = index.mul %outputs, %blocks : index
  %weight_bytes = index.mul %records, %block_bytes : index
  %elements = index.mul %capacity, %outputs : index
  %storage_count = index.add %elements, %guards : index
  func.return %rows, %capacity, %inputs, %outputs, %budget, %weight_bytes, %storage_count, %channels : index, index, index, index, index, index, index, index
}

func.def @initialize_q5_fixture(%rows: index, %inputs: index, %outputs: index, %codes: buffer, %input: buffer, %gate: buffer, %up: buffer, %count: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %block_values = index.constant 256 : index
  %block_bytes = index.constant 176 : offset
  %scale = scalar.constant 0.0009765625 : f16
  %minimum = scalar.constant 0.00048828125 : f16
  %unit = scalar.constant 0.0078125 : f32
  %row_word = index.cast %rows : index to i32
  %counts = buffer.view %count[%origin] : buffer -> view<1xi32>
  view.store %row_word, %counts[0] : i32, view<1xi32>
  %blocks = index.div %inputs, %block_values : index
  %records = index.mul %outputs, %blocks : index
  scf.for %record = [%c0 to %records step %c1] {
    %position = index.scale %record, %block_bytes : index, offset -> offset
    %gate_header = buffer.view %gate[%position] : buffer -> view<2xf16>
    %up_header = buffer.view %up[%position] : buffer -> view<2xf16>
    view.store %scale, %gate_header[0] : f16, view<2xf16>
    view.store %minimum, %gate_header[1] : f16, view<2xf16>
    view.store %minimum, %up_header[0] : f16, view<2xf16>
    view.store %scale, %up_header[1] : f16, view<2xf16>
  }
  %source = buffer.view %codes[%origin] : buffer -> view<[%rows]x[%inputs]xi8>
  %destination = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xf16>
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %column = [%c0 to %inputs step %c1] {
      %code = view.load %source[%row, %column] : view<[%rows]x[%inputs]xi8> -> i8
      %value = scalar.sitofp %code : i8 to f32
      %scaled = scalar.mulf %value, %unit : f32
      %half = scalar.fptrunc %scaled : f32 to f16
      view.store %half, %destination[%row, %column] : f16, view<[%rows]x[%inputs]xf16>
    }
  }
  func.return
}

// Read each field by its original byte position. This deliberately shares no
// word carriers or bit-unpacking helper with the numerical implementation.
func.def inline @reference_dot(%rows: index, %inputs: index, %outputs: index, %channels: index, %row: index, %channel: index, %input: buffer, %weight: buffer) -> (f64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %group_width = index.constant 32 : index
  %block_width = index.constant 256 : index
  %block_bytes = index.constant 176 : offset
  %scales_add = index.constant 4 : offset
  %high_add = index.constant 16 : offset
  %low_add = index.constant 48 : offset
  %high_bit_mask = scalar.constant 1 : i32
  %nibble_shift = scalar.constant 4 : i32
  %scale_high_shift = scalar.constant 6 : i32
  %low_mask = scalar.constant 15 : i32
  %scale_mask = scalar.constant 63 : i32
  %blocks = index.div %inputs, %block_width : index
  %channel_group = index.div %channel, %channels : index
  %within_group = index.rem %channel, %channels : index
  %group_block = index.mul %channel_group, %blocks : index
  %activations = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xf16>
  %initial = scalar.constant 0.0 : f64
  %result = scf.for %column = [%c0 to %inputs step %c1](%sum = %initial : f64) -> (f64) {
    %block = index.div %column, %block_width : index
    %within_block = index.rem %column, %block_width : index
    %group = index.div %within_block, %group_width : index
    %element = index.rem %within_block, %group_width : index
    %block_group = index.add %group_block, %block : index
    %record = index.madd %block_group, %channels, %within_group : index
    %position = index.scale %record, %block_bytes : index, offset -> offset
    %scale_origin = index.add %position, %scales_add : offset
    %high_origin = index.add %position, %high_add : offset
    %low_origin = index.add %position, %low_add : offset
    %header = buffer.view %weight[%position] : buffer -> view<2xf16>
    %scales = buffer.view %weight[%scale_origin] : buffer -> view<12xi8>
    %high_bytes = buffer.view %weight[%high_origin] : buffer -> view<32xi8>
    %low_bytes = buffer.view %weight[%low_origin] : buffer -> view<128xi8>
    %d_half = view.load %header[0] : view<2xf16> -> f16
    %m_half = view.load %header[1] : view<2xf16> -> f16
    %d = scalar.extf %d_half : f16 to f64
    %minimum = scalar.extf %m_half : f16 to f64
    %lower_group = index.cmp ult, %group, %c4 : index
    %scale_code, %minimum_code = scf.if %lower_group -> (i32, i32) {
      %minimum_index = index.add %group, %c4 : index
      %scale_byte = view.load %scales[%group] : view<12xi8> -> i8
      %minimum_byte = view.load %scales[%minimum_index] : view<12xi8> -> i8
      %scale_word = scalar.extui %scale_byte : i8 to i32
      %minimum_word = scalar.extui %minimum_byte : i8 to i32
      %scale = scalar.andi %scale_word, %scale_mask : i32
      %value = scalar.andi %minimum_word, %scale_mask : i32
      scf.yield %scale, %value : i32, i32
    } else {
      %packed_index = index.add %group, %c4 : index
      %upper_index = index.sub %group, %c4 : index
      %packed_byte = view.load %scales[%packed_index] : view<12xi8> -> i8
      %upper_byte = view.load %scales[%upper_index] : view<12xi8> -> i8
      %minimum_byte = view.load %scales[%group] : view<12xi8> -> i8
      %packed = scalar.extui %packed_byte : i8 to i32
      %upper = scalar.extui %upper_byte : i8 to i32
      %minimum_word = scalar.extui %minimum_byte : i8 to i32
      %scale_low = scalar.andi %packed, %low_mask : i32
      %minimum_low = scalar.shrui %packed, %nibble_shift : i32
      %scale_top = scalar.shrui %upper, %scale_high_shift : i32
      %minimum_top = scalar.shrui %minimum_word, %scale_high_shift : i32
      %scale_high = scalar.shli %scale_top, %nibble_shift : i32
      %minimum_high = scalar.shli %minimum_top, %nibble_shift : i32
      %scale = scalar.ori %scale_low, %scale_high : i32
      %value = scalar.ori %minimum_low, %minimum_high : i32
      scf.yield %scale, %value : i32, i32
    }
    %page = index.div %group, %c2 : index
    %nibble = index.rem %group, %c2 : index
    %low_index = index.madd %page, %group_width, %element : index
    %low_byte = view.load %low_bytes[%low_index] : view<128xi8> -> i8
    %high_byte = view.load %high_bytes[%element] : view<32xi8> -> i8
    %low_word = scalar.extui %low_byte : i8 to i32
    %high_word = scalar.extui %high_byte : i8 to i32
    %shift_index = index.mul %nibble, %c4 : index
    %shift = index.cast %shift_index : index to i32
    %high_shift = index.cast %group : index to i32
    %shifted_low = scalar.shrui %low_word, %shift : i32
    %shifted_high = scalar.shrui %high_word, %high_shift : i32
    %low_code = scalar.andi %shifted_low, %low_mask : i32
    %high_bit = scalar.andi %shifted_high, %high_bit_mask : i32
    %high_code = scalar.shli %high_bit, %nibble_shift : i32
    %code = scalar.ori %low_code, %high_code : i32
    %code_float = scalar.uitofp %code : i32 to f64
    %scale_float = scalar.uitofp %scale_code : i32 to f64
    %minimum_float = scalar.uitofp %minimum_code : i32 to f64
    %scale = scalar.mulf %d, %scale_float : f64
    %bias = scalar.mulf %minimum, %minimum_float : f64
    %scaled = scalar.mulf %scale, %code_float : f64
    %coefficient = scalar.subf %scaled, %bias : f64
    %rounded = scalar.fptrunc %coefficient : f64 to f16
    %weight_value = scalar.extf %rounded : f16 to f64
    %activation_half = view.load %activations[%row, %column] : view<[%rows]x[%inputs]xf16> -> f16
    %activation = scalar.extf %activation_half : f16 to f64
    %product = scalar.mulf %weight_value, %activation : f64
    %next = scalar.addf %sum, %product : f64
    scf.yield %next : f64
  }
  func.return %result : f64
}

func.def @reference(%count: buffer, %capacity: index, %inputs: index, %outputs: index, %channels: index, %budget: index, %input: buffer, %gate: buffer, %up: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %unit = scalar.constant 1.0 : f64
  %counts = buffer.view %count[%origin] : buffer -> view<1xi32>
  %word = view.load %counts[0] : view<1xi32> -> i32
  %rows = index.cast %word : i32 to index
  %results = buffer.view %output[%origin] : buffer -> view<[%rows]x[%outputs]xf16>
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %channel = [%c0 to %outputs step %c1] {
      %gate_value = func.call @reference_dot(%rows, %inputs, %outputs, %channels, %row, %channel, %input, %gate) : (index, index, index, index, index, index, buffer, buffer) -> (f64)
      %up_value = func.call @reference_dot(%rows, %inputs, %outputs, %channels, %row, %channel, %input, %up) : (index, index, index, index, index, index, buffer, buffer) -> (f64)
      %negative = scalar.negf %gate_value : f64
      %exponential = scalar.expf %negative : f64
      %denominator = scalar.addf %unit, %exponential : f64
      %activated = scalar.divf %gate_value, %denominator : f64
      %combined = scalar.mulf %activated, %up_value : f64
      %value = scalar.fptrunc %combined : f64 to f16
      view.store %value, %results[%row, %channel] : f16, view<[%rows]x[%outputs]xf16>
    }
  }
  func.return
}

check.scenario public @paired_projection configure[7](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %rows, %capacity, %inputs, %outputs, %budget, %weight_bytes, %storage_count, %channels = check.generate<@geometry>(%configuration) : (index) -> (index, index, index, index, index, index, index, index)
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %gate_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %up_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %codes = check.generate.random.uniform seed(%input_seed) range(-8 to 8) : tensor<[%rows]x[%inputs]xi8>
    %input = check.generate.fill value(0.0) : tensor<[%rows]x[%inputs]xf16>
    %gate = check.generate.random.uniform seed(%gate_seed) range(-128 to 127) : tensor<[%weight_bytes]xi8>
    %up = check.generate.random.uniform seed(%up_seed) range(-128 to 127) : tensor<[%weight_bytes]xi8>
    %count = check.generate.fill value(0) : tensor<1xi32>
    check.generate<@initialize_q5_fixture>(%rows, %inputs, %outputs, %codes, %input, %gate, %up, %count) : (index, index, index, tensor<[%rows]x[%inputs]xi8>, tensor<[%rows]x[%inputs]xf16>, tensor<[%weight_bytes]xi8>, tensor<[%weight_bytes]xi8>, tensor<1xi32>) -> ()
    %storage = check.generate.fill value(-99.0) : tensor<[%storage_count]xf16>
    %output = check.tensor.view %storage offset(16) : tensor<[%storage_count]xf16> -> tensor<[%capacity]x[%outputs]xf16>
    %prefix = check.tensor.view %storage offset(0) : tensor<[%storage_count]xf16> -> tensor<8xf16>
    check.compare<@ggml_linear_q5k_f16_pair, @reference>[%capacity, %inputs, %outputs, %channels, %budget](%count, %capacity, %inputs, %outputs, %channels, %budget, %input, %gate, %up, %output) : [index, index, index, index, index](tensor<1xi32>, index, index, index, index, index, tensor<[%rows]x[%inputs]xf16>, tensor<[%weight_bytes]xi8>, tensor<[%weight_bytes]xi8>, tensor<[%capacity]x[%outputs]xf16>) -> () {
      check.expect.approximate actual(%storage) expected(%storage) atol(5.9604644775390625e-08) rtol(0.001) nan(different) : tensor<[%storage_count]xf16>, tensor<[%storage_count]xf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<8xf16>
      check.expect.bitwise actual(%count) expected(%count) : tensor<1xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%rows]x[%inputs]xf16>
      check.expect.bitwise actual(%gate) expected(%gate) : tensor<[%weight_bytes]xi8>
      check.expect.bitwise actual(%up) expected(%up) : tensor<[%weight_bytes]xi8>
    }
  }
  check.return
}

check.benchmark<@paired_projection> @paired_projection_shapes
