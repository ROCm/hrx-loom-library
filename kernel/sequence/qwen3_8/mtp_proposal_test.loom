  %round4 = check.literal value(4) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round4](%mixed_inputs, %round4, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, index, tensor<[%draft_capacity]x7xi32>, tensor<[%draft_capacity]x2xi32>, tensor<[%draft_capacity]xi32>, tensor<[%draft_capacity]xi32>, tensor<[%target_capacity]x8xi32>)
  %round5 = check.literal value(5) : index
