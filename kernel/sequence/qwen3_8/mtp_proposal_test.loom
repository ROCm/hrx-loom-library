  kernel.launch @proposal_fixture(%mixed_inputs, %draft_capacity, %target_capacity, %span_count, %round, %step_count, %mask, %epoch, %expected_draft, %expected_origins, %expected_anchors, %expected_inputs, %expected_target) : (index, index, index, index, index, index, i32, tensor<[%target_capacity]x29xi32>, tensor<[%draft_capacity]x7xi32>, tensor<[%draft_capacity]x2xi32>, tensor<[%draft_capacity]xi32>, tensor<[%draft_capacity]xi32>, tensor<[%target_capacity]x8xi32>)
  kernel.launch @qwen38_mtp_proposal_prepare(%mixed_inputs, %target_capacity, %draft_capacity, %epoch, %target, %draft, %origins, %inputs) : (index, index, index, tensor<[%target_capacity]x29xi32>, tensor<[%target_capacity]x8xi32>, tensor<[%draft_capacity]x7xi32>, tensor<[%draft_capacity]x2xi32>, tensor<[%draft_capacity]xi32>)
  %round0 = check.literal value(0) : index
