// Independent storage geometry for both sequence-control test roots.
// Iota inputs distinguish ID words from every preserved media field.

func.def @sequence_input_words(%mixed: index, %capacity: index) -> (index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %ordinary = index.cmp eq, %mixed, %c0 : index
  %stride = scf.select %ordinary, %c1, %c8 : index
  %words = index.mul %capacity, %stride : index
  func.return %words : index
}
