// Independent sequence-control fixtures and complete observable output checks.

func.decl @sequence_input_words(%mixed: index, %capacity: index) -> (index)

func.decl @qwen38_packet_options_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_eos_origin(%capacity: index) -> (offset)

kernel.decl @qwen38_accept_spans() launch(%mixed_inputs: index, %width: index, %token_capacity: index, %packet_capacity: index, %epoch: buffer, %inputs: buffer, %predictions: buffer, %committed: buffer, %replay: buffer, %results: buffer)

// Permuted resident rows include an intermediate prompt, a one-token
// known span, and verifiers. Trials move mismatch/EOS positions
// and vary output credit, including truncation before a matching proposal.
func.def @accept_fixture(%mixed_inputs: index, %token_capacity: index, %width_value: index, %span_count_value: index, %trial_value: index, %packet_capacity: index, %epoch: buffer, %predictions: buffer) {
  %width = index.assume %width_value [range(%width_value, 1, 8)] : index
  %span_count = index.assume %span_count_value [range(%span_count_value, 0, %packet_capacity)] : index
  %trial = index.assume %trial_value [range(%trial_value, 0, 7), lt(%trial_value, %width)] : index
  %input_words = func.call @sequence_input_words(%mixed_inputs, %token_capacity) : (index, index) -> (index)
  %stride = index.div %input_words, %token_capacity : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %options_origin = func.call @qwen38_packet_options_origin(%packet_capacity) : (index) -> (offset)
  %eos_origin = func.call @qwen38_packet_eos_origin(%packet_capacity) : (index) -> (offset)
  %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %control = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %descriptors = buffer.view %epoch[%descriptor_origin] : buffer -> view<[%packet_capacity]x6xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<[%packet_capacity]x2xi32>
  %selected = buffer.view %predictions[%origin] : buffer -> view<[%packet_capacity]xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %small_capacity = index.constant 512 : index
  %selected_capacity = index.mul %span_count, %width : index
  %large = index.cmp ugt, %token_capacity, %small_capacity : index
  %long_prompt = index.sub %token_capacity, %selected_capacity : index
  %hidden_length = scf.select %large, %long_prompt, %c3 : index
  %last_row = index.constant 1048576 : index
  %source_base = index.constant 23 : index
  %c100 = index.constant 100 : index
  %input_base = index.constant 1000 : index
  %wrong = index.constant 7777 : index
  %eos = scalar.constant 42 : i32
  %none = scalar.constant -1 : i32
  %span_word = index.cast %span_count : index to i32
  view.store %span_word, %control[1] : i32, view<3xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  %total, %selection_count = scf.for %span = [%c0 to %span_count step %c1](%begin = %c0 : index, %selection = %c0 : index) -> (index, index) {
    %hidden = index.cmp eq, %span, %c2 : index
    %known = index.cmp eq, %span, %c6 : index
    %ordinary = scalar.ori %hidden, %known : i1
    %true = scalar.constant true : i1
    %speculative = scalar.xori %ordinary, %true : i1
    %visible_count = scf.select %known, %c1, %width : index
    %count = scf.select %hidden, %hidden_length, %visible_count : index
    %output_count = scf.select %hidden, %c0, %visible_count : index
    %row = index.sub %last_row, %span : index
    %position = index.add %c100, %span : index
    %count_word = index.cast %count : index to i32
    %begin_word = index.cast %begin : index to i32
    %position_word = index.cast %position : index to i32
    %source_position = index.add %source_base, %span : index
    %source_word = index.cast %source_position : index to i32
    %row_word = index.cast %row : index to i32
    %selected_word = index.cast %selection : index to i32
    %selection_word = scf.select %hidden, %none, %selected_word : i32
    %flag = scalar.extui %speculative : i1 to i32
    %limited = index.cmp eq, %span, %c7 : index
    %trial_limit = index.add %trial, %c1 : index
    %credit = scf.select %limited, %trial_limit, %width : index
    %credit_word = index.cast %credit : index to i32
    view.store %count_word, %descriptors[%span, 0] : i32, view<[%packet_capacity]x6xi32>
    view.store %position_word, %descriptors[%span, 1] : i32, view<[%packet_capacity]x6xi32>
    view.store %begin_word, %descriptors[%span, 2] : i32, view<[%packet_capacity]x6xi32>
    view.store %row_word, %descriptors[%span, 3] : i32, view<[%packet_capacity]x6xi32>
    view.store %source_word, %descriptors[%span, 4] : i32, view<[%packet_capacity]x6xi32>
    view.store %selection_word, %descriptors[%span, 5] : i32, view<[%packet_capacity]x6xi32>
    view.store %flag, %options[%span, 0] : i32, view<[%packet_capacity]x2xi32>
    view.store %credit_word, %options[%span, 1] : i32, view<[%packet_capacity]x2xi32>
    %phase = index.add %span, %trial : index
    %mismatch = index.rem %phase, %width : index
    %eos_span = index.cmp eq, %span, %c5 : index
    scf.for %token = [%c0 to %output_count step %c1] {
      %packed = index.add %begin, %token : index
      %following = index.add %packed, %c1 : index
      %input_word = index.mul %following, %stride : index
      %matching = index.add %input_base, %input_word : index
      %replacement = index.add %wrong, %token : index
      %wrong_position = index.cmp eq, %token, %mismatch : index
      %value = scf.select %wrong_position, %replacement, %matching : index
      %word = index.cast %value : index to i32
      %eos_position = index.cmp eq, %token, %trial : index
      %stops = scalar.andi %eos_span, %eos_position : i1
      %prediction = scf.select %stops, %eos, %word : i32
      %slot_value = index.add %selection, %token : index
      %slot = index.assume %slot_value [ge(%slot_value, 0), lt(%slot_value, %packet_capacity)] : index
      view.store %prediction, %selected[%slot] : i32, view<[%packet_capacity]xi32>
    }
    %next_begin = index.add %begin, %count : index
    %next_selection = index.add %selection, %output_count : index
    scf.yield %next_begin, %next_selection : index, index
  }
  %total_word = index.cast %total : index to i32
  %selection_word = index.cast %selection_count : index to i32
  view.store %total_word, %control[0] : i32, view<3xi32>
  view.store %selection_word, %control[2] : i32, view<3xi32>
  func.return
}

// Independent oracle takes the minimum frontier of all mismatches, EOS and
// credit before copying any outputs. The kernel instead walks a live prefix.
func.def @accept_oracle(%mixed_inputs: index, %width_value: index, %token_capacity: index, %packet_capacity: index, %epoch: buffer, %inputs: buffer, %predictions: buffer, %committed: buffer, %replay: buffer, %results: buffer) {
  %width = index.assume %width_value [range(%width_value, 1, 8)] : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %options_origin = func.call @qwen38_packet_options_origin(%packet_capacity) : (index) -> (offset)
  %eos_origin = func.call @qwen38_packet_eos_origin(%packet_capacity) : (index) -> (offset)
  %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %control = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %descriptors = buffer.view %epoch[%descriptor_origin] : buffer -> view<[%packet_capacity]x6xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<[%packet_capacity]x2xi32>
  %input_words = func.call @sequence_input_words(%mixed_inputs, %token_capacity) : (index, index) -> (index)
  %stride = index.div %input_words, %token_capacity : index
  %tokens = buffer.view %inputs[%origin] : buffer -> view<[%input_words]xi32>
  %selected = buffer.view %predictions[%origin] : buffer -> view<[%packet_capacity]xi32>
  %accepted_header = buffer.view %committed[%origin] : buffer -> view<3xi32>
  %accepted = buffer.view %committed[%descriptor_origin] : buffer -> view<[%packet_capacity]x6xi32>
  %replay_header = buffer.view %replay[%origin] : buffer -> view<3xi32>
  %replayed = buffer.view %replay[%descriptor_origin] : buffer -> view<[%packet_capacity]x6xi32>
  %records = buffer.view %results[%origin] : buffer -> view<[%packet_capacity]x10xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %capacity = index.constant 8 : index
  %draft_count = index.sub %width, %c1 : index
  %c0_2 = scalar.constant 0 : i32
  %c1_2 = scalar.constant 1 : i32
  %eos = view.load %terminal[0] : view<1xi32> -> i32
  %total = view.load %control[0] : view<3xi32> -> i32
  %span_word = view.load %control[1] : view<3xi32> -> i32
  %span_value = index.cast %span_word : i32 to index
  %span_count = index.assume %span_value [range(%span_value, 0, %packet_capacity)] : index
  view.store %total, %accepted_header[0] : i32, view<3xi32>
  view.store %span_word, %accepted_header[1] : i32, view<3xi32>
  view.store %c0_2, %accepted_header[2] : i32, view<3xi32>
  %replay_count = scf.for %span = [%c0 to %span_count step %c1](%replay_index = %c0 : index) -> (index) {
    %flag = view.load %options[%span, 0] : view<[%packet_capacity]x2xi32> -> i32
    %speculative = scalar.cmpi ne, %flag, %c0_2 : i32
    %count_word = view.load %descriptors[%span, 0] : view<[%packet_capacity]x6xi32> -> i32
    %begin_word = view.load %descriptors[%span, 2] : view<[%packet_capacity]x6xi32> -> i32
    %source_position = view.load %descriptors[%span, 4] : view<[%packet_capacity]x6xi32> -> i32
    %selection_word = view.load %descriptors[%span, 5] : view<[%packet_capacity]x6xi32> -> i32
    %absent = scalar.constant -1 : i32
    %begin = index.cast %begin_word : i32 to index
    %selection = index.cast %selection_word : i32 to index
    %has_output = scalar.cmpi sge, %selection_word, %c0_2 : i32
    %consumed, %emitted = scf.if %speculative -> (i32, i32) {
      %credit_word = view.load %options[%span, 1] : view<[%packet_capacity]x2xi32> -> i32
      %credit = index.cast %credit_word : i32 to index
      %limited = index.cmp ult, %credit, %width : index
      %initial = scf.select %limited, %credit, %width : index
      %frontier = scf.for %token = [%c0 to %width step %c1](%limit = %initial : index) -> (index) {
        %slot_value = index.add %selection, %token : index
        %slot = index.assume %slot_value [ge(%slot_value, 0), lt(%slot_value, %packet_capacity)] : index
        %prediction = view.load %selected[%slot] : view<[%packet_capacity]xi32> -> i32
        %is_eos = scalar.cmpi eq, %prediction, %eos : i32
        %has_candidate = index.cmp ult, %token, %draft_count : index
        %mismatch = scf.if %has_candidate -> (i1) {
          %relative = index.add %token, %c1 : index
          %candidate_value = index.add %begin, %relative : index
          %candidate_index = index.assume %candidate_value [ge(%candidate_value, 0), lt(%candidate_value, %token_capacity)] : index
          %word_value = index.mul %candidate_index, %stride : index
          %word_index = index.assume %word_value [ge(%word_value, 0), lt(%word_value, %input_words)] : index
          %candidate = view.load %tokens[%word_index] : view<[%input_words]xi32> -> i32
          %different = scalar.cmpi ne, %candidate, %prediction : i32
          scf.yield %different : i1
        } else {
          %false = scalar.constant false : i1
          scf.yield %false : i1
        }
        %stop = scalar.ori %is_eos, %mismatch : i1
        %end = index.add %token, %c1 : index
        %earlier = index.cmp ult, %end, %limit : index
        %truncate = scalar.andi %stop, %earlier : i1
        %next = scf.select %truncate, %end, %limit : index
        scf.yield %next : index
      }
      %word = index.cast %frontier : index to i32
      scf.yield %word, %word : i32, i32
    } else {
      %emitted = scf.select %has_output, %c1_2, %c0_2 : i32
      scf.yield %count_word, %emitted : i32, i32
    }
    view.store %consumed, %records[%span, 0] : i32, view<[%packet_capacity]x10xi32>
    view.store %emitted, %records[%span, 1] : i32, view<[%packet_capacity]x10xi32>
    %output_count = index.cast %emitted : i32 to index
    scf.for %token = [%c0 to %capacity step %c1] {
      %valid = index.cmp ult, %token, %output_count : index
      %value = scf.if %valid -> (i32) {
        %slot_value = index.add %selection, %token : index
        %slot = index.assume %slot_value [ge(%slot_value, 0), lt(%slot_value, %packet_capacity)] : index
        %prediction = view.load %selected[%slot] : view<[%packet_capacity]xi32> -> i32
        scf.yield %prediction : i32
      } else {
        scf.yield %c0_2 : i32
      }
      %field = index.add %token, %c2 : index
      view.store %value, %records[%span, %field] : i32, view<[%packet_capacity]x10xi32>
    }
    scf.for %field = [%c0 to %c4 step %c1] {
      %input_word = view.load %descriptors[%span, %field] : view<[%packet_capacity]x6xi32> -> i32
      %is_count = index.cmp eq, %field, %c0 : index
      %word = scf.select %is_count, %consumed, %input_word : i32
      view.store %word, %accepted[%span, %field] : i32, view<[%packet_capacity]x6xi32>
    }
    view.store %source_position, %accepted[%span, 4] : i32, view<[%packet_capacity]x6xi32>
    view.store %absent, %accepted[%span, 5] : i32, view<[%packet_capacity]x6xi32>
    %next_replay = scf.if %speculative -> (index) {
      %replay_slot = index.assume %replay_index [ge(%replay_index, 0), lt(%replay_index, %packet_capacity)] : index
      scf.for %field = [%c0 to %c4 step %c1] {
        %accepted_word = view.load %accepted[%span, %field] : view<[%packet_capacity]x6xi32> -> i32
        view.store %accepted_word, %replayed[%replay_slot, %field] : i32, view<[%packet_capacity]x6xi32>
      }
      view.store %source_position, %replayed[%replay_slot, 4] : i32, view<[%packet_capacity]x6xi32>
      view.store %absent, %replayed[%replay_slot, 5] : i32, view<[%packet_capacity]x6xi32>
      %next = index.add %replay_slot, %c1 : index
      scf.yield %next : index
    } else {
      scf.yield %replay_index : index
    }
    scf.yield %next_replay : index
  }
  %replay_word = index.cast %replay_count : index to i32
  view.store %total, %replay_header[0] : i32, view<3xi32>
  view.store %replay_word, %replay_header[1] : i32, view<3xi32>
  view.store %c0_2, %replay_header[2] : i32, view<3xi32>
  func.return
}

// Every supported width and live span count, with all possible stopping
// positions, both layouts, and compact or nearly full prompt allocations.
func.def @accept_parameters(%trial: index) -> (index, index, index, index, index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %row_period = index.constant 128 : index
  %capacity_period = index.constant 1024 : index
  %layout_period = index.constant 2048 : index
  %mixed = index.div %trial, %layout_period : index
  %row_trial = index.div %trial, %c8 : index
  %span_index = index.rem %row_trial, %c16 : index
  %span_count = index.add %span_index, %c1 : index
  %width_trial = index.div %trial, %row_period : index
  %width_index = index.rem %width_trial, %c8 : index
  %width = index.add %width_index, %c1 : index
  %capacity_trial = index.div %trial, %capacity_period : index
  %capacity_index = index.rem %capacity_trial, %c2 : index
  %small = index.cmp eq, %capacity_index, %c0 : index
  %small_capacity = index.constant 512 : index
  %large_capacity = index.constant 16384 : index
  %token_capacity = scf.select %small, %small_capacity, %large_capacity : index
  %position = index.rem %trial, %width : index
  %input_words = func.call @sequence_input_words(%mixed, %token_capacity) : (index, index) -> (index)
  func.return %mixed, %width, %span_count, %position, %token_capacity, %input_words : index, index, index, index, index, index
}

check.scenario public @accept_frontiers {
  check.trial[4096](%trial: index, %entropy: check.entropy) {
    %mixed_inputs, %width, %span_count, %position, %token_capacity, %input_words = check.generate<@accept_parameters>(%trial) : (index) -> (index, index, index, index, index, index)
    %packet_capacity = check.literal value(128) : index
    %epoch = check.generate.fill value(-99) : tensor<[%packet_capacity]x29xi32>
    %inputs = check.generate.iota offset(1000) step(1) : tensor<[%input_words]xi32>
    %predictions = check.generate.fill value(-99) : tensor<[%packet_capacity]xi32>
    %committed = check.generate.fill value(-99) : tensor<[%packet_capacity]x7xi32>
    %replay = check.generate.fill value(-99) : tensor<[%packet_capacity]x7xi32>
    %results = check.generate.fill value(-99) : tensor<[%packet_capacity]x10xi32>
    check.generate<@accept_fixture>(%mixed_inputs, %token_capacity, %width, %span_count, %position, %packet_capacity, %epoch, %predictions) : (index, index, index, index, index, index, tensor<[%packet_capacity]x29xi32>, tensor<[%packet_capacity]xi32>) -> ()
    check.compare<@qwen38_accept_spans, @accept_oracle>(%mixed_inputs, %width, %token_capacity, %packet_capacity, %epoch, %inputs, %predictions, %committed, %replay, %results) : (index, index, index, index, tensor<[%packet_capacity]x29xi32>, tensor<[%input_words]xi32>, tensor<[%packet_capacity]xi32>, tensor<[%packet_capacity]x7xi32>, tensor<[%packet_capacity]x7xi32>, tensor<[%packet_capacity]x10xi32>) -> () {
      check.expect.bitwise actual(%results) expected(%results) : tensor<[%packet_capacity]x10xi32>
      check.expect.bitwise actual(%committed) expected(%committed) : tensor<[%packet_capacity]x7xi32>
      check.expect.bitwise actual(%replay) expected(%replay) : tensor<[%packet_capacity]x7xi32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<[%packet_capacity]x29xi32>
      check.expect.bitwise actual(%inputs) expected(%inputs) : tensor<[%input_words]xi32>
      check.expect.bitwise actual(%predictions) expected(%predictions) : tensor<[%packet_capacity]xi32>
    }
  }
  check.return
}

check.benchmark<@accept_frontiers> @accept_frontiers_benchmark

check.scenario public @accept_empty_epoch {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %width = check.literal value(1) : index
    %span_count = check.literal value(0) : index
    %position = check.literal value(0) : index
    %token_capacity = check.literal value(1) : index
    %input_words = check.generate<@sequence_input_words>(%trial, %token_capacity) : (index, index) -> (index)
    %packet_capacity = check.literal value(128) : index
    %epoch = check.generate.fill value(-99) : tensor<[%packet_capacity]x29xi32>
    %inputs = check.generate.iota offset(1000) step(1) : tensor<[%input_words]xi32>
    %predictions = check.generate.fill value(-99) : tensor<[%packet_capacity]xi32>
    %committed = check.generate.fill value(-99) : tensor<[%packet_capacity]x7xi32>
    %replay = check.generate.fill value(-99) : tensor<[%packet_capacity]x7xi32>
    %results = check.generate.fill value(-99) : tensor<[%packet_capacity]x10xi32>
    check.generate<@accept_fixture>(%trial, %token_capacity, %width, %span_count, %position, %packet_capacity, %epoch, %predictions) : (index, index, index, index, index, index, tensor<[%packet_capacity]x29xi32>, tensor<[%packet_capacity]xi32>) -> ()
    check.compare<@qwen38_accept_spans, @accept_oracle>(%trial, %width, %token_capacity, %packet_capacity, %epoch, %inputs, %predictions, %committed, %replay, %results) : (index, index, index, index, tensor<[%packet_capacity]x29xi32>, tensor<[%input_words]xi32>, tensor<[%packet_capacity]xi32>, tensor<[%packet_capacity]x7xi32>, tensor<[%packet_capacity]x7xi32>, tensor<[%packet_capacity]x10xi32>) -> () {
      check.expect.bitwise actual(%results) expected(%results) : tensor<[%packet_capacity]x10xi32>
      check.expect.bitwise actual(%committed) expected(%committed) : tensor<[%packet_capacity]x7xi32>
      check.expect.bitwise actual(%replay) expected(%replay) : tensor<[%packet_capacity]x7xi32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<[%packet_capacity]x29xi32>
      check.expect.bitwise actual(%inputs) expected(%inputs) : tensor<[%input_words]xi32>
      check.expect.bitwise actual(%predictions) expected(%predictions) : tensor<[%packet_capacity]xi32>
    }
  }
  check.return
}

check.benchmark<@accept_empty_epoch> @accept_empty_epoch_benchmark

func.def @accept_wide_span_count(%trial: index) -> (index) {
  %count = index.constant 17 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %last = index.cmp eq, %trial, %c4 : index
  %wide = index.constant 1025 : index
  %base = scf.for %i = [%c0 to %trial step %c1](%value = %count : index) -> (index) {
    %double = index.mul %value, %c2 : index
    %next = index.sub %double, %c1 : index
    scf.yield %next : index
  }
  %value = scf.select %last, %wide, %base : index
  func.return %value : index
}

check.scenario public @accept_wide_epoch {
  check.trial[5](%case: index, %entropy: check.entropy) {
    %trial = check.literal value(0) : index
    %width = check.literal value(1) : index
    %span_count = check.generate<@accept_wide_span_count>(%case) : (index) -> (index)
    %position = check.literal value(0) : index
    %token_capacity = check.literal value(16384) : index
    %input_words = check.generate<@sequence_input_words>(%trial, %token_capacity) : (index, index) -> (index)
    %packet_capacity = check.literal value(2048) : index
    %epoch = check.generate.fill value(-99) : tensor<[%packet_capacity]x29xi32>
    %inputs = check.generate.iota offset(1000) step(1) : tensor<[%input_words]xi32>
    %predictions = check.generate.fill value(-99) : tensor<[%packet_capacity]xi32>
    %committed = check.generate.fill value(-99) : tensor<[%packet_capacity]x7xi32>
    %replay = check.generate.fill value(-99) : tensor<[%packet_capacity]x7xi32>
    %results = check.generate.fill value(-99) : tensor<[%packet_capacity]x10xi32>
    check.generate<@accept_fixture>(%trial, %token_capacity, %width, %span_count, %position, %packet_capacity, %epoch, %predictions) : (index, index, index, index, index, index, tensor<[%packet_capacity]x29xi32>, tensor<[%packet_capacity]xi32>) -> ()
    check.compare<@qwen38_accept_spans, @accept_oracle>(%trial, %width, %token_capacity, %packet_capacity, %epoch, %inputs, %predictions, %committed, %replay, %results) : (index, index, index, index, tensor<[%packet_capacity]x29xi32>, tensor<[%input_words]xi32>, tensor<[%packet_capacity]xi32>, tensor<[%packet_capacity]x7xi32>, tensor<[%packet_capacity]x7xi32>, tensor<[%packet_capacity]x10xi32>) -> () {
      check.expect.bitwise actual(%results) expected(%results) : tensor<[%packet_capacity]x10xi32>
      check.expect.bitwise actual(%committed) expected(%committed) : tensor<[%packet_capacity]x7xi32>
      check.expect.bitwise actual(%replay) expected(%replay) : tensor<[%packet_capacity]x7xi32>
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<[%packet_capacity]x29xi32>
      check.expect.bitwise actual(%inputs) expected(%inputs) : tensor<[%input_words]xi32>
      check.expect.bitwise actual(%predictions) expected(%predictions) : tensor<[%packet_capacity]xi32>
    }
  }
  check.return
}

check.benchmark<@accept_wide_epoch> @accept_wide_epoch_benchmark
