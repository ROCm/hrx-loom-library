// Independent sequence-control fixtures and complete observable output checks.

func.decl @qwen38_packet_selection_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_options_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_eos_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_bank_bytes(%capacity: index) -> (offset)

func.decl @qwen38_packet_indices_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_identity_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_shape_origin(%capacity: index) -> (offset)

kernel.decl @qwen38_continue_dispatch() launch(%mixed_inputs: index, %context: index, %capacity: index, %feedback_capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

// The first continuation overwrites the second first-span record before that
// span's speculative continuation runs. Both banks cross 512 tokens while
// only two requests need feedback. The accepted frontier must survive.
kernel.def @media_continuation_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%epoch: buffer, %tokens: buffer, %results: buffer, %expected: buffer) {
  %capacity = index.constant 520 : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %plan_origin = func.call @qwen38_packet_bank_bytes(%capacity) : (index) -> (offset)
  %plan_descriptors = index.add %plan_origin, %descriptor_origin : offset
  %options_origin = func.call @qwen38_packet_options_origin(%capacity) : (index) -> (offset)
  %plan_options = index.add %plan_origin, %options_origin : offset
  %indices_origin = func.call @qwen38_packet_indices_origin(%capacity) : (index) -> (offset)
  %shape_origin = func.call @qwen38_packet_shape_origin(%capacity) : (index) -> (offset)
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<2x6xi32>
  %plan = buffer.view %epoch[%plan_origin] : buffer -> view<3xi32>
  %planned = buffer.view %epoch[%plan_descriptors] : buffer -> view<2x6xi32>
  %credits = buffer.view %epoch[%plan_options] : buffer -> view<2x2xi32>
  %indices = buffer.view %epoch[%indices_origin] : buffer -> view<2xi32>
  %shape = buffer.view %epoch[%shape_origin] : buffer -> view<2xi32>
  %records = buffer.view %tokens[%origin] : buffer -> view<1034x8xi32>
  %result_origin = index.constant 120 : offset
  %prior = buffer.view %results[%result_origin] : buffer -> view<2x10xi32>
  %output = buffer.view %expected[%origin] : buffer -> view<520x8xi32>
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %first_length = scalar.constant 512 : i32
  %first_records = scalar.constant 514 : i32
  %known_records = scalar.constant 516 : i32
  %c10_i32 = scalar.constant 10 : i32
  %next_records = scalar.constant 520 : i32
  %first_frontier = scalar.constant 512 : i32
  %c71_i32 = scalar.constant 71 : i32
  %prediction = scalar.constant 42 : i32
  view.store %first_records, %header[0] : i32, view<3xi32>
  view.store %c2_i32, %header[1] : i32, view<3xi32>
  view.store %first_length, %spans[0, 0] : i32, view<2x6xi32>
  view.store %c2_i32, %spans[1, 0] : i32, view<2x6xi32>
  view.store %first_length, %spans[1, 2] : i32, view<2x6xi32>
  view.store %first_length, %prior[0, 0] : i32, view<2x10xi32>
  view.store %c2_i32, %prior[1, 0] : i32, view<2x10xi32>
  %packed_counts = scalar.constant 131074 : i32
  view.store %packed_counts, %prior[1, 1] : i32, view<2x10xi32>
  view.store %prediction, %prior[1, 3] : i32, view<2x10xi32>
  view.store %first_frontier, %records[511, 5] : i32, view<1034x8xi32>
  view.store %c71_i32, %records[513, 5] : i32, view<1034x8xi32>
  view.store %first_records, %shape[0] : i32, view<2xi32>
  view.store %next_records, %shape[1] : i32, view<2xi32>
  view.store %next_records, %plan[0] : i32, view<3xi32>
  view.store %c2_i32, %plan[1] : i32, view<3xi32>
  view.store %known_records, %planned[0, 0] : i32, view<2x6xi32>
  view.store %c4_i32, %planned[1, 0] : i32, view<2x6xi32>
  view.store %c1_i32, %planned[1, 3] : i32, view<2x6xi32>
  view.store %c0_i32, %planned[1, 4] : i32, view<2x6xi32>
  view.store %c1_i32, %credits[1, 0] : i32, view<2x2xi32>
  view.store %c10_i32, %credits[1, 1] : i32, view<2x2xi32>
  view.store %c1_i32, %indices[1] : i32, view<2xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %queue_begin = index.constant 514 : index
  %known = index.constant 516 : index
  scf.for %i = [%c0 to %known step %c1] {
    %queued = index.add %i, %queue_begin : index
    %relative = index.cast %i : index to i32
    %position = scalar.addi %first_frontier, %relative : i32
    %following = scalar.addi %position, %c1_i32 : i32
    view.store %position, %records[%queued, 2] : i32, view<1034x8xi32>
    view.store %position, %records[%queued, 3] : i32, view<1034x8xi32>
    view.store %position, %records[%queued, 4] : i32, view<1034x8xi32>
    view.store %following, %records[%queued, 5] : i32, view<1034x8xi32>
    view.store %position, %output[%i, 2] : i32, view<520x8xi32>
    view.store %position, %output[%i, 3] : i32, view<520x8xi32>
    view.store %position, %output[%i, 4] : i32, view<520x8xi32>
    view.store %following, %output[%i, 5] : i32, view<520x8xi32>
  }
  scf.for %i = [%known to %capacity step %c1] {
    %relative_index = index.sub %i, %known : index
    %relative = index.cast %relative_index : index to i32
    %position = scalar.addi %c71_i32, %relative : i32
    %following = scalar.addi %position, %c1_i32 : i32
    view.store %position, %output[%i, 2] : i32, view<520x8xi32>
    view.store %position, %output[%i, 3] : i32, view<520x8xi32>
    view.store %position, %output[%i, 4] : i32, view<520x8xi32>
    view.store %following, %output[%i, 5] : i32, view<520x8xi32>
  }
  view.store %prediction, %output[%known, 0] : i32, view<520x8xi32>
  kernel.return
}

check.case public @media_continuation_retains_accepted_source_frontiers {
  %epoch = check.generate.fill value(0) : tensor<14570xi32>
  %tokens = check.generate.fill value(0) : tensor<1034x8xi32>
  %results = check.generate.fill value(0) : tensor<102xi32>
  %expected = check.generate.fill value(0) : tensor<520x8xi32>
  kernel.launch @media_continuation_fixture(%epoch, %tokens, %results, %expected) : (tensor<14570xi32>, tensor<1034x8xi32>, tensor<102xi32>, tensor<520x8xi32>)
  %mixed_inputs = check.literal value(1) : index
  %context = check.literal value(2048) : index
  %capacity = check.literal value(520) : index
  %feedback_capacity = check.literal value(2) : index
  kernel.launch @qwen38_continue_dispatch(%mixed_inputs, %context, %capacity, %feedback_capacity, %epoch, %tokens, %results) : (index, index, index, index, tensor<14570xi32>, tensor<1034x8xi32>, tensor<102xi32>)
  %active = check.tensor.view %tokens offset(0) : tensor<1034x8xi32> -> tensor<520x8xi32>
  check.expect.bitwise actual(%active) expected(%expected) : tensor<520x8xi32>
  check.return
}

check.benchmark<@media_continuation_retains_accepted_source_frontiers> @media_continuation_frontiers
