// An empty cohort must finalize at its actual ceiling. Later rounds retain
// prefixes stopped by earlier advances; round zero has no generated owners.
// The reference constructs packed coordinates and payloads from original span
// identities; it never calls the compactor or copies overlapping source data.

kernel.decl @qwen38_mtp_proposal_advance_confident(%round: index) launch(%mixed_inputs: index, %round_value: index, %maximum_proposals: index, %minimum_probability: f32, %target_capacity: index, %draft_capacity: index, %draft: buffer, %origins: buffer, %predictions: buffer, %draft_tokens: buffer, %target_tokens: buffer, %results: buffer, %epoch: buffer)

func.decl @qwen38_packet_options_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_selection_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_identity_origin(%capacity: index) -> (offset)

func.def pure @finalize_shape(%round: index, %trial: index) -> (index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c7 = index.constant 7 : index
  %mixed = index.rem %trial, %c2 : index
  %minimum = index.add %round, %c1 : index
  %phase = index.div %trial, %c2 : index
  %requested = index.add %minimum, %phase : index
  %depth = index.min %requested, %c7 : index
  func.return %mixed, %depth : index, index
}

func.def @finalize_fixture(%mixed_value: index, %depth_value: index, %round_value: index, %finished: i1, %epoch: buffer, %tokens: buffer, %results: buffer) {
  %mixed = index.assume %mixed_value [range(%mixed_value, 0, 1)] : index
  %depth = index.assume %depth_value [range(%depth_value, 1, 7)] : index
  %round = index.assume %round_value [range(%round_value, 0, 6)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %capacity = index.constant 32 : index
  %origin = index.constant 0 : offset
  %descriptor = index.constant 12 : offset
  %options_origin = func.call @qwen38_packet_options_origin(%capacity) : (index) -> (offset)
  %selection_origin = func.call @qwen38_packet_selection_origin(%capacity) : (index) -> (offset)
  %identity_origin = func.call @qwen38_packet_identity_origin(%capacity) : (index) -> (offset)
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor] : buffer -> view<32x6xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<32x2xi32>
  %selected = buffer.view %epoch[%selection_origin] : buffer -> view<32xi32>
  %identities = buffer.view %epoch[%identity_origin] : buffer -> view<32x2xi32>
  %is_mixed = index.cmp ne, %mixed, %c0 : index
  %stride = scf.select %is_mixed, %c8, %c1 : index
  %inputs = buffer.view %tokens[%origin] : buffer -> view<32x[%stride]xi32>
  %width = index.add %depth, %c1 : index
  %next = index.add %round, %c1 : index
  %final = index.cmp eq, %next, %depth : index
  %packed = scalar.andi %finished, %final : i1
  %started = index.cmp ne, %round, %c0 : index
  %span_count = scf.select %started, %c2, %c0 : index
  %count_word = index.cast %span_count : index to i32
  %generated_word = scalar.constant 2 : i32
  view.store %count_word, %header[1] : i32, view<3xi32>
  %first_length = index.min %c2, %next : index
  scf.for %span = [%c0 to %span_count step %c1] {
    %short_length = index.add %span, %c2 : index
    %kept = index.min %short_length, %next : index
    %original = index.mul %span, %width : index
    %packed_begin = index.mul %span, %first_length : index
    %begin = scf.select %packed, %packed_begin, %original : index
    %begin_word = index.cast %begin : index to i32
    %kept_word = index.cast %kept : index to i32
    view.store %kept_word, %spans[%span, 0] : i32, view<32x6xi32>
    view.store %begin_word, %spans[%span, 2] : i32, view<32x6xi32>
    view.store %begin_word, %spans[%span, 5] : i32, view<32x6xi32>
    view.store %generated_word, %options[%span, 0] : i32, view<32x2xi32>
    %selection_count = scf.select %packed, %kept, %width : index
    scf.for %relative = [%c0 to %selection_count step %c1] {
      %source = index.add %original, %relative : index
      %slot = index.add %begin, %relative : index
      %source_word = index.cast %source : index to i32
      %slot_word = index.cast %slot : index to i32
      view.store %slot_word, %selected[%slot] : i32, view<32xi32>
      view.store %source_word, %identities[%slot, 0] : i32, view<32x2xi32>
      view.store %source_word, %identities[%slot, 1] : i32, view<32x2xi32>
      scf.if %packed {
        %base = index.mul %source, %stride : index
        scf.for %word = [%c0 to %stride step %c1] {
          %value = index.add %base, %word : index
          %value_word = index.cast %value : index to i32
          view.store %value_word, %inputs[%slot, %word] : i32, view<32x[%stride]xi32>
        }
      }
    }
  }
  %c3 = index.constant 3 : index
  %second_length = index.min %c3, %next : index
  %kept_total = index.add %first_length, %second_length : index
  %end = scf.select %started, %kept_total, %c0 : index
  %reserved = index.mul %span_count, %width : index
  %extent = scf.select %packed, %end, %reserved : index
  %extent_word = index.cast %extent : index to i32
  view.store %extent_word, %header[0] : i32, view<3xi32>
  view.store %extent_word, %header[2] : i32, view<3xi32>
  scf.if %finished {
    %feedback = buffer.view %results[%origin] : buffer -> view<30xi32>
    %count = index.cast %next : index to i32
    %offset = index.constant 9 : index
    %slot = index.add %offset, %round : index
    %c0_i32 = scalar.constant 0 : i32
    %c4_i32 = scalar.constant 4 : i32
    view.store %count, %feedback[8] : i32, view<30xi32>
    view.store %c0_i32, %feedback[%slot] : i32, view<30xi32>
    view.store %c4_i32, %feedback[29] : i32, view<30xi32>
  }
  func.return
}

func.def @finalize_reference(%mixed: index, %round: index, %depth: index, %minimum_probability: f32, %target_capacity: index, %draft_capacity: index, %draft: buffer, %origins: buffer, %predictions: buffer, %ids: buffer, %tokens: buffer, %results: buffer, %epoch: buffer) {
  %yes = scalar.constant true : i1
  func.call @finalize_fixture(%mixed, %depth, %round, %yes, %epoch, %tokens, %results) : (index, index, index, i1, buffer, buffer, buffer)
  func.return
}

check.scenario public @finalize_stopped_cohort configure[7](%round: index, %configuration_entropy: check.entropy) {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %mixed, %depth = check.generate<@finalize_shape>(%round, %trial) : (index, index) -> (index, index)
    %capacity = check.literal value(32) : index
    %c4 = check.literal value(4) : index
    %minimum_probability = check.literal value(0.84999999999999998) : f32
    %epoch = check.generate.fill value(-99) : tensor<934xi32>
    %tokens = check.generate.iota offset(0) step(1) : tensor<32x8xi32>
    %results = check.generate.fill value(-99) : tensor<30xi32>
    %draft = check.generate.fill value(0) : tensor<27xi32>
    %origins = check.generate.fill value(-99) : tensor<4x3xi32>
    %predictions = check.generate.fill value(-99) : tensor<4x2xi32>
    %ids = check.generate.fill value(-99) : tensor<4xi32>
    %no = check.literal value(false) : i1
    check.generate<@finalize_fixture>(%mixed, %depth, %round, %no, %epoch, %tokens, %results) : (index, index, index, i1, tensor<934xi32>, tensor<32x8xi32>, tensor<30xi32>) -> ()
    check.compare<@qwen38_mtp_proposal_advance_confident, @finalize_reference>[%round](%mixed, %round, %depth, %minimum_probability, %capacity, %c4, %draft, %origins, %predictions, %ids, %tokens, %results, %epoch) : [index](index, index, index, f32, index, index, tensor<27xi32>, tensor<4x3xi32>, tensor<4x2xi32>, tensor<4xi32>, tensor<32x8xi32>, tensor<30xi32>, tensor<934xi32>) -> () {
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<934xi32>
      check.expect.bitwise actual(%tokens) expected(%tokens) : tensor<32x8xi32>
      check.expect.bitwise actual(%results) expected(%results) : tensor<30xi32>
      check.expect.bitwise actual(%draft) expected(%draft) : tensor<27xi32>
      check.expect.bitwise actual(%origins) expected(%origins) : tensor<4x3xi32>
      check.expect.bitwise actual(%predictions) expected(%predictions) : tensor<4x2xi32>
      check.expect.bitwise actual(%ids) expected(%ids) : tensor<4xi32>
    }
  }
  check.return
}

check.benchmark<@finalize_stopped_cohort> @finalize_check
