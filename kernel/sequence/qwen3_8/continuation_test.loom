// Independent sequence-control fixtures and complete observable output checks.

func.decl @qwen38_packet_selection_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_options_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_eos_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_bank_bytes(%capacity: index) -> (offset)

func.decl @qwen38_packet_indices_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_identity_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_shape_origin(%capacity: index) -> (offset)

kernel.decl @qwen38_continue_dispatch() launch(%mixed_inputs: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

// A completed ordinary span advances causal and source coordinates from
// different bases. Nearly a whole queued plane is compacted into the active bank,
// and its output selection is rewritten relative to the new packed epoch.
kernel.def @continuation_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%capacity_value: index, %epoch: buffer, %tokens: buffer, %results: buffer, %expected_epoch: buffer, %expected_tokens: buffer, %expected_results: buffer) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 8, 32768)] : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %selection_origin = func.call @qwen38_packet_selection_origin(%capacity) : (index) -> (offset)
  %options_origin = func.call @qwen38_packet_options_origin(%capacity) : (index) -> (offset)
  %eos_origin = func.call @qwen38_packet_eos_origin(%capacity) : (index) -> (offset)
  %plan_origin = func.call @qwen38_packet_bank_bytes(%capacity) : (index) -> (offset)
  %plan_descriptors = index.add %plan_origin, %descriptor_origin : offset
  %plan_options = index.add %plan_origin, %options_origin : offset
  %indices_origin = func.call @qwen38_packet_indices_origin(%capacity) : (index) -> (offset)
  %identity_origin = func.call @qwen38_packet_identity_origin(%capacity) : (index) -> (offset)
  %word_bytes = index.constant 4 : offset
  %queued_origin = index.scale %capacity, %word_bytes : index, offset -> offset
  %result_stride = index.constant 40 : offset
  %next_origin = index.scale %capacity, %result_stride : index, offset -> offset
  %tags_origin = index.add %next_origin, %next_origin : offset
  %fixture_stride = index.constant 120 : offset
  %epoch_bytes = index.scale %capacity, %fixture_stride : index, offset -> offset
  %token_bytes = index.add %queued_origin, %queued_origin : offset
  %feedback_stride = index.constant 84 : offset
  %result_bytes = index.scale %capacity, %feedback_stride : index, offset -> offset
  %plan = buffer.view %epoch[%plan_origin] : buffer -> view<3xi32>
  %planned = buffer.view %epoch[%plan_descriptors] : buffer -> view<[%capacity]x6xi32>
  %credits = buffer.view %epoch[%plan_options] : buffer -> view<[%capacity]x2xi32>
  %indices = buffer.view %epoch[%indices_origin] : buffer -> view<[%capacity]xi32>
  %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %queued = buffer.view %tokens[%queued_origin] : buffer -> view<[%capacity]xi32>
  %prior = buffer.view %results[%origin] : buffer -> view<[%capacity]x10xi32>
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c5_index = index.constant 5 : index
  %length = index.sub %capacity, %c5_index : index
  %length_word = index.cast %length : index to i32
  %c5_i32 = scalar.constant 5 : i32
  %c7_i32 = scalar.constant 7 : i32
  %source = scalar.constant 23 : i32
  %selection = scalar.constant 4 : i32
  %causal_position = scalar.constant 100 : i32
  %eos = scalar.constant 42 : i32
  view.store %c1_i32, %plan[1] : i32, view<3xi32>
  view.store %length_word, %planned[0, 0] : i32, view<[%capacity]x6xi32>
  view.store %causal_position, %planned[0, 1] : i32, view<[%capacity]x6xi32>
  view.store %c5_i32, %planned[0, 2] : i32, view<[%capacity]x6xi32>
  view.store %c7_i32, %planned[0, 3] : i32, view<[%capacity]x6xi32>
  view.store %source, %planned[0, 4] : i32, view<[%capacity]x6xi32>
  view.store %selection, %planned[0, 5] : i32, view<[%capacity]x6xi32>
  view.store %c0_i32, %credits[0, 0] : i32, view<[%capacity]x2xi32>
  view.store %c5_i32, %credits[0, 1] : i32, view<[%capacity]x2xi32>
  view.store %c0_i32, %indices[0] : i32, view<[%capacity]xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  view.store %c2_i32, %prior[0, 0] : i32, view<[%capacity]x10xi32>
  view.store %c1_i32, %prior[0, 1] : i32, view<[%capacity]x10xi32>
  %first_token = scalar.constant 900 : i32
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  scf.for %token = [%c0_index to %length step %c1_index] {
    %word = index.cast %token : index to i32
    %value = scalar.addi %first_token, %word : i32
    %source = index.add %token, %c5_index : index
    view.store %value, %queued[%source] : i32, view<[%capacity]xi32>
  }
  buffer.copy %epoch[%origin], %expected_epoch[%origin], %epoch_bytes
  buffer.copy %tokens[%origin], %expected_tokens[%origin], %token_bytes
  buffer.copy %results[%origin], %expected_results[%origin], %result_bytes

  %header = buffer.view %expected_epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %expected_epoch[%descriptor_origin] : buffer -> view<[%capacity]x6xi32>
  %selections = buffer.view %expected_epoch[%selection_origin] : buffer -> view<[%capacity]xi32>
  %options = buffer.view %expected_epoch[%options_origin] : buffer -> view<[%capacity]x2xi32>
  %identities = buffer.view %expected_epoch[%identity_origin] : buffer -> view<[%capacity]x2xi32>
  %active_tokens = buffer.view %expected_tokens[%origin] : buffer -> view<[%capacity]xi32>
  %record_words = index.constant 10 : index
  %result_words = index.mul %capacity, %record_words : index
  %next = buffer.view %expected_results[%next_origin] : buffer -> view<[%result_words]xi32>
  %tags = buffer.view %expected_results[%tags_origin] : buffer -> view<[%capacity]xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c160 = index.constant 160 : index
  %c0_v4xi32 = vector.splati 0 : vector<4xi32>
  %none = scalar.constant -1 : i32
  scf.for %i = [%c0 to %capacity step %c1] {
    view.store %c0_i32, %active_tokens[%i] : i32, view<[%capacity]xi32>
  }
  scf.for %i = [%c0 to %result_words step %c1] {
    view.store %c0_i32, %next[%i] : i32, view<[%result_words]xi32>
  }
  scf.for %i = [%c0 to %capacity step %c1] {
    view.store %none, %tags[%i] : i32, view<[%capacity]xi32>
  }
  %advanced = scalar.constant 102 : i32
  %advanced_source = scalar.constant 25 : i32
  %remaining = scalar.constant 4 : i32
  %target_position = scalar.addi %advanced, %length_word : i32
  %last_token = scalar.subi %length_word, %c1_i32 : i32
  view.store %length_word, %header[0] : i32, view<3xi32>
  view.store %c1_i32, %header[1] : i32, view<3xi32>
  view.store %c1_i32, %header[2] : i32, view<3xi32>
  view.store %length_word, %spans[0, 0] : i32, view<[%capacity]x6xi32>
  view.store %advanced, %spans[0, 1] : i32, view<[%capacity]x6xi32>
  view.store %c0_i32, %spans[0, 2] : i32, view<[%capacity]x6xi32>
  view.store %c7_i32, %spans[0, 3] : i32, view<[%capacity]x6xi32>
  view.store %advanced_source, %spans[0, 4] : i32, view<[%capacity]x6xi32>
  view.store %c0_i32, %spans[0, 5] : i32, view<[%capacity]x6xi32>
  view.store %last_token, %selections[0] : i32, view<[%capacity]xi32>
  view.store %c0_i32, %options[0, 0] : i32, view<[%capacity]x2xi32>
  view.store %remaining, %options[0, 1] : i32, view<[%capacity]x2xi32>
  view.store %c0_i32, %identities[0, 0] : i32, view<[%capacity]x2xi32>
  view.store %target_position, %identities[0, 1] : i32, view<[%capacity]x2xi32>
  scf.for %token = [%c0 to %length step %c1] {
    %word = index.cast %token : index to i32
    %value = scalar.addi %first_token, %word : i32
    view.store %value, %active_tokens[%token] : i32, view<[%capacity]xi32>
  }
  view.store %c0_i32, %tags[0] : i32, view<[%capacity]xi32>
  kernel.return
}

check.case public @ordinary_continuation_preserves_source_position {
  %mixed_inputs = check.literal value(0) : index
  %context = check.literal value(65536) : index
  %capacity = check.param.choice values([8, 514, 16384]) name("plane_capacity") : index
  %epoch = check.generate.fill value(-99) : tensor<[%capacity]x30xi32>
  %tokens = check.generate.fill value(-99) : tensor<2x[%capacity]xi32>
  %results = check.generate.fill value(-99) : tensor<[%capacity]x21xi32>
  %expected_epoch = check.generate.fill value(-99) : tensor<[%capacity]x30xi32>
  %expected_tokens = check.generate.fill value(-99) : tensor<2x[%capacity]xi32>
  %expected_results = check.generate.fill value(-99) : tensor<[%capacity]x21xi32>
  kernel.launch @continuation_fixture(%capacity, %epoch, %tokens, %results, %expected_epoch, %expected_tokens, %expected_results) : (index, tensor<[%capacity]x30xi32>, tensor<2x[%capacity]xi32>, tensor<[%capacity]x21xi32>, tensor<[%capacity]x30xi32>, tensor<2x[%capacity]xi32>, tensor<[%capacity]x21xi32>)
  kernel.launch @qwen38_continue_dispatch(%mixed_inputs, %context, %capacity, %epoch, %tokens, %results) : (index, index, index, tensor<[%capacity]x30xi32>, tensor<2x[%capacity]xi32>, tensor<[%capacity]x21xi32>)
  check.expect.bitwise actual(%epoch) expected(%expected_epoch) : tensor<[%capacity]x30xi32>
  check.expect.bitwise actual(%tokens) expected(%expected_tokens) : tensor<2x[%capacity]xi32>
  check.expect.bitwise actual(%results) expected(%expected_results) : tensor<[%capacity]x21xi32>
  check.return
}

// A two-token first result advances position 62 to 64. The second plan uses
// first-result slot five, independently of its packed slot and resident row.
// Only two or more remaining outputs can repay another full-width proposal.
// Each case supplies literal liveness, including exact and one-short context
// frontiers, independently of the implementation's admission predicate.
kernel.def @speculative_continuation_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%width: index, %remaining: index, %terminal_value: i32, %expected_live: i1, %epoch: buffer, %results: buffer, %expected_header: buffer, %expected_inputs: buffer, %expected_tags: buffer) {
  %capacity = index.constant 512 : index
  %origin = index.constant 0 : offset
  %plan_origin = func.call @qwen38_packet_bank_bytes(%capacity) : (index) -> (offset)
  %descriptor_origin = index.constant 12 : offset
  %span_origin = index.add %plan_origin, %descriptor_origin : offset
  %first_options = func.call @qwen38_packet_options_origin(%capacity) : (index) -> (offset)
  %options_origin = index.add %plan_origin, %first_options : offset
  %indices_origin = func.call @qwen38_packet_indices_origin(%capacity) : (index) -> (offset)
  %eos_origin = func.call @qwen38_packet_eos_origin(%capacity) : (index) -> (offset)
  %plan = buffer.view %epoch[%plan_origin] : buffer -> view<3xi32>
  %span = buffer.view %epoch[%span_origin] : buffer -> view<6xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<2xi32>
  %indices = buffer.view %epoch[%indices_origin] : buffer -> view<1xi32>
  %eos = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %first = buffer.view %results[%origin] : buffer -> view<[%capacity]x10xi32>
  %header = buffer.view %expected_header[%origin] : buffer -> view<3xi32>
  %inputs = buffer.view %expected_inputs[%origin] : buffer -> view<512xi32>
  %tags = buffer.view %expected_tags[%origin] : buffer -> view<[%capacity]xi32>
  %c0_i32 = scalar.constant 0 : i32
  %terminal = scalar.cmpi ne, %terminal_value, %c0_i32 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %row = scalar.constant 3 : i32
  %tag = scalar.constant 5 : i32
  %position = scalar.constant 62 : i32
  %token = scalar.constant 42 : i32
  %stop = scalar.constant 99 : i32
  %width_word = index.cast %width : index to i32
  %remaining_word = index.cast %remaining : index to i32
  %credit = scalar.addi %remaining_word, %c2_i32 : i32
  %prediction = scf.select %terminal, %stop, %token : i32
  view.store %width_word, %plan[0] : i32, view<3xi32>
  view.store %c1_i32, %plan[1] : i32, view<3xi32>
  view.store %width_word, %plan[2] : i32, view<3xi32>
  view.store %width_word, %span[0] : i32, view<6xi32>
  view.store %position, %span[1] : i32, view<6xi32>
  view.store %c0_i32, %span[2] : i32, view<6xi32>
  view.store %row, %span[3] : i32, view<6xi32>
  view.store %c0_i32, %span[4] : i32, view<6xi32>
  view.store %c1_i32, %options[0] : i32, view<2xi32>
  view.store %credit, %options[1] : i32, view<2xi32>
  view.store %tag, %indices[0] : i32, view<1xi32>
  view.store %stop, %eos[0] : i32, view<1xi32>
  view.store %c2_i32, %first[5, 0] : i32, view<[%capacity]x10xi32>
  view.store %c2_i32, %first[5, 1] : i32, view<[%capacity]x10xi32>
  view.store %prediction, %first[5, 3] : i32, view<[%capacity]x10xi32>
  scf.if %expected_live {
    view.store %width_word, %header[0] : i32, view<3xi32>
    view.store %c1_i32, %header[1] : i32, view<3xi32>
    view.store %width_word, %header[2] : i32, view<3xi32>
    view.store %token, %inputs[0] : i32, view<512xi32>
    view.store %tag, %tags[0] : i32, view<[%capacity]xi32>
  }
  kernel.return
}

check.case public @continuation_exact_fit_width_2 {
  %mixed_inputs = check.literal value(0) : index
  %width = check.literal value(2) : index
  %remaining = check.literal value(2) : index
  %terminal = check.literal value(0) : i32
  %context = check.literal value(66) : index
  %expected_live = check.literal value(true) : i1
  %epoch = check.generate.fill value(0) : tensor<14346xi32>
  %tokens = check.generate.fill value(-17) : tensor<1024xi32>
  %results = check.generate.fill value(0) : tensor<10752xi32>
  %expected_header = check.generate.fill value(0) : tensor<3xi32>
  %expected_inputs = check.generate.fill value(0) : tensor<512xi32>
  %expected_tags = check.generate.fill value(-1) : tensor<512xi32>
  kernel.launch @speculative_continuation_fixture(%width, %remaining, %terminal, %expected_live, %epoch, %results, %expected_header, %expected_inputs, %expected_tags) : (index, index, i32, i1, tensor<14346xi32>, tensor<10752xi32>, tensor<3xi32>, tensor<512xi32>, tensor<512xi32>)
  %capacity = check.literal value(512) : index
  kernel.launch @qwen38_continue_dispatch(%mixed_inputs, %context, %capacity, %epoch, %tokens, %results) : (index, index, index, tensor<14346xi32>, tensor<1024xi32>, tensor<10752xi32>)
  %header = check.tensor.view %epoch offset(0) : tensor<14346xi32> -> tensor<3xi32>
  %inputs = check.tensor.view %tokens offset(0) : tensor<1024xi32> -> tensor<512xi32>
  %tags = check.tensor.view %results offset(40960) : tensor<10752xi32> -> tensor<512xi32>
  check.expect.bitwise actual(%header) expected(%expected_header) : tensor<3xi32>
  check.expect.bitwise actual(%inputs) expected(%expected_inputs) : tensor<512xi32>
  check.expect.bitwise actual(%tags) expected(%expected_tags) : tensor<512xi32>
  check.return
}

