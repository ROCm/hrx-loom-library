// Qwen3.8 queued continuation launch. mixed_inputs is 0 for ordinary IDs
// or 1 for media records; context is the admitted causal extent and capacity
// is the allocation's ordinary plane capacity. The continuation motif owns
// the validated epoch, token-plane, result, and in-place compaction contract.

func.decl @qwen38_continue_spans(%mixed_inputs: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

kernel.def export("qwen38_continue_dispatch") @qwen38_continue_dispatch() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%mixed_inputs_value: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer) {
  %mixed_inputs = index.assume %mixed_inputs_value [range(%mixed_inputs_value, 0, 1)] : index
  func.call @qwen38_continue_spans(%mixed_inputs, %context, %capacity, %epoch, %tokens, %results) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}
