// Exact Qwen3.5 GDN projection routing and GGML integer-dot arithmetic.
// Group zero exercises nonzero Q4_K/Q5_K minima. Three Q8_1 groups form a
// large/cancel/small pattern whose bitwise result requires the prescribed
// 16/8/4/2/1 row-reduction tree. The 32-value-head shape covers V/Z channels
// both inside and outside the fixed Q/K extent and the alpha/beta boundary.

kernel.decl @qwen35_gdn_projection_decode(%configured_input_size: index, %configured_value_heads: index) launch(%input_size: index, %value_heads: index, %q8_input: buffer, %qkv_weight: buffer, %z_weight: buffer, %alpha_weight: buffer, %beta_weight: buffer, %qkv_output: buffer, %z_output: buffer, %alpha_output: buffer, %beta_output: buffer)

func.def @projection_test_code(%row: index, %bias: i32) -> (i8) {
  %modulus = index.constant 7 : index
  %remainder = index.rem %row, %modulus : index
  %remainder_i32 = index.cast %remainder : index to i32
  %code_i32 = scalar.addi %remainder_i32, %bias : i32
  %code = scalar.trunci %code_i32 : i32 to i8
  func.return %code : i8
}

// Initializes group zero of every Q4_K or Q5_K row. Both formats share the
// leading (d, dmin, packed scales) header and the group-zero low-nibble plane.
// dmin=1/2 and minimum=2 make every logical weight (code - 1).
func.def @initialize_affine_weights(%row_count: index, %row_bytes: offset, %payload_displacement: offset, %bias: i32, %weight: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %metadata_displacement = index.constant 4 : offset
  %c1_f32 = scalar.constant 1.0 : f32
  %one_half_float = scalar.constant 0.5 : f32
  %one_half = scalar.fptrunc %c1_f32 : f32 to f16
  %minimum_half = scalar.fptrunc %one_half_float : f32 to f16
  %scale_code = scalar.constant 1 : i8
  %minimum_code = scalar.constant 2 : i8
  scf.for %row = [%begin to %row_count step %step] {
    %row_origin = index.scale %row, %row_bytes : index, offset -> offset
    %metadata_origin = index.add %row_origin, %metadata_displacement : offset
    %payload_origin = index.add %row_origin, %payload_displacement : offset
    %header = buffer.view %weight[%row_origin] : buffer -> view<2xf16>
    view.store %one_half, %header[0] : f16, view<2xf16>
    view.store %minimum_half, %header[1] : f16, view<2xf16>
    %metadata = buffer.view %weight[%metadata_origin] : buffer -> view<12xi8>
    view.store %scale_code, %metadata[0] : i8, view<12xi8>
    view.store %minimum_code, %metadata[4] : i8, view<12xi8>
    %code = func.call @projection_test_code(%row, %bias) : (index, i32) -> (i8)
    %codes = vector.splat %code : vector<32xi8>
    %payload = buffer.view %weight[%payload_origin] : buffer -> view<32xi8>
    vector.store %codes, %payload[0] : vector<32xi8>, view<32xi8>
  }
  func.return
}

func.def @initialize_q8_weights(%row_count: index, %row_bytes: offset, %bias: i32, %weight: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %block_count = index.constant 32 : index
  %block_bytes = index.constant 34 : offset
  %payload_displacement = index.constant 2 : offset
  %c1_f32 = scalar.constant 1.0 : f32
  %one_half = scalar.fptrunc %c1_f32 : f32 to f16
  scf.for %row = [%begin to %row_count step %step] {
    %row_origin = index.scale %row, %row_bytes : index, offset -> offset
    %code = func.call @projection_test_code(%row, %bias) : (index, i32) -> (i8)
    %codes = vector.splat %code : vector<32xi8>
    scf.for %block = [%begin to %block_count step %step] {
      %block_add = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %block_add : offset
      %payload_origin = index.add %block_origin, %payload_displacement : offset
      %scale = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
      view.store %one_half, %scale[0] : f16, view<1xf16>
      %payload = buffer.view %weight[%payload_origin] : buffer -> view<32xi8>
      vector.store %codes, %payload[0] : vector<32xi8>, view<32xi8>
    }
  }
  func.return
}

func.def @initialize_projection(%q8_input: buffer, %qkv_weight: buffer, %z_weight: buffer, %alpha_weight: buffer, %beta_weight: buffer) {
  %origin = index.constant 0 : offset
  %metadata_origin = index.constant 1024 : offset
  %group0 = index.constant 0 : index
  %group2 = index.constant 2 : index
  %group3 = index.constant 3 : index
  %group18 = index.constant 18 : index
  %qkv_rows = index.constant 8192 : index
  %value_rows = index.constant 4096 : index
  %scalar_rows = index.constant 32 : index
  %q5_row_bytes = index.constant 704 : offset
  %q4_row_bytes = index.constant 576 : offset
  %q8_row_bytes = index.constant 1088 : offset
  %q4_payload = index.constant 16 : offset
  %q5_payload = index.constant 48 : offset
  %qkv_bias = scalar.constant 1 : i32
  %z_bias = scalar.constant 3 : i32
  %alpha_bias = scalar.constant 4 : i32
  %beta_bias = scalar.constant 5 : i32
  %packed_ones = vector.splati 16843009 : vector<8xi32>
  %packed_positive = vector.splati 2139062143 : vector<8xi32>
  %packed_negative = vector.splati -2122219135 : vector<8xi32>
  %payload = buffer.view %q8_input[%origin] : buffer -> view<32x8xi32>
  vector.store %packed_ones, %payload[%group0, 0] : vector<8xi32>, view<32x8xi32>
  vector.store %packed_positive, %payload[%group2, 0] : vector<8xi32>, view<32x8xi32>
  vector.store %packed_positive, %payload[%group3, 0] : vector<8xi32>, view<32x8xi32>
  vector.store %packed_negative, %payload[%group18, 0] : vector<8xi32>, view<32x8xi32>
  %metadata = buffer.view %q8_input[%metadata_origin] : buffer -> view<32x2xf32>
  %base_metadata = vector.constantf [1.0, 32.0] : vector<2xf32>
  %large_positive_metadata = vector.constantf [32768.0, 4064.0] : vector<2xf32>
  %small_metadata = vector.constantf [6.103515625e-05, 4064.0] : vector<2xf32>
  %large_negative_metadata = vector.constantf [32768.0, -4064.0] : vector<2xf32>
  vector.store %base_metadata, %metadata[%group0, 0] : vector<2xf32>, view<32x2xf32>
  vector.store %large_positive_metadata, %metadata[%group2, 0] : vector<2xf32>, view<32x2xf32>
  vector.store %small_metadata, %metadata[%group3, 0] : vector<2xf32>, view<32x2xf32>
  vector.store %large_negative_metadata, %metadata[%group18, 0] : vector<2xf32>, view<32x2xf32>
  func.call @initialize_affine_weights(%qkv_rows, %q5_row_bytes, %q5_payload, %qkv_bias, %qkv_weight) : (index, offset, offset, i32, buffer)
  func.call @initialize_affine_weights(%value_rows, %q4_row_bytes, %q4_payload, %z_bias, %z_weight) : (index, offset, offset, i32, buffer)
  func.call @initialize_q8_weights(%scalar_rows, %q8_row_bytes, %alpha_bias, %alpha_weight) : (index, offset, i32, buffer)
  func.call @initialize_q8_weights(%scalar_rows, %q8_row_bytes, %beta_bias, %beta_weight) : (index, offset, i32, buffer)
  func.return
}

func.def @reference_affine_rows(%row_count: index, %bias: i32, %output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %minimum = scalar.constant 1 : i32
  %code_count = scalar.constant 32 : i32
  %output_view = buffer.view %output[%origin] : buffer -> view<[%row_count]xf32>
  scf.for %row = [%begin to %row_count step %step] {
    %code = func.call @projection_test_code(%row, %bias) : (index, i32) -> (i8)
    %code_i32 = scalar.extui %code : i8 to i32
    %centered_code = scalar.subi %code_i32, %minimum : i32
    %dot_i32 = scalar.muli %centered_code, %code_count : i32
    %dot = scalar.sitofp %dot_i32 : i32 to f32
    view.store %dot, %output_view[%row] : f32, view<[%row_count]xf32>
  }
  func.return
}

// Mirrors one complete Q8_0/Q8_1 group contribution without using the device
// template. This keeps the integer dot and F32 materialization boundaries
// visible in the reference.
func.def @reference_q8_group(%weight_code: i32, %activation_code: i32, %activation_scale: f32) -> (f32) {
  %code_count = scalar.constant 32 : i32
  %c1_f32 = scalar.constant 1.0 : f32
  %c0_f32 = scalar.constant 0.0 : f32
  %product = scalar.muli %weight_code, %activation_code : i32
  %integer_dot = scalar.muli %product, %code_count : i32
  %activation_sum = scalar.muli %activation_code, %code_count : i32
  %floating_dot = scalar.sitofp %integer_dot : i32 to f32
  %floating_sum = scalar.sitofp %activation_sum : i32 to f32
  %scaled_dot = scalar.mulf %floating_dot, %c1_f32 : f32
  %minimum_correction = scalar.mulf %floating_sum, %c0_f32 : f32
  %centered = scalar.subf %scaled_dot, %minimum_correction : f32
  %contribution = scalar.mulf %centered, %activation_scale : f32
  func.return %contribution : f32
}

func.def @reference_q8_rows(%row_count: index, %bias: i32, %output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %base_code = scalar.constant 1 : i32
  %positive_code = scalar.constant 127 : i32
  %negative_code = scalar.constant -127 : i32
  %base_scale = scalar.constant 1.0 : f32
  %large_scale = scalar.constant 32768.0 : f32
  %small_scale = scalar.constant 6.103515625e-05 : f32
  %output_view = buffer.view %output[%origin] : buffer -> view<[%row_count]xf32>
  scf.for %row = [%begin to %row_count step %step] {
    %code = func.call @projection_test_code(%row, %bias) : (index, i32) -> (i8)
    %weight_code = scalar.extui %code : i8 to i32
    %base = func.call @reference_q8_group(%weight_code, %base_code, %base_scale) : (i32, i32, f32) -> (f32)
    %large = func.call @reference_q8_group(%weight_code, %positive_code, %large_scale) : (i32, i32, f32) -> (f32)
    %negative_large = func.call @reference_q8_group(%weight_code, %negative_code, %large_scale) : (i32, i32, f32) -> (f32)
    %small = func.call @reference_q8_group(%weight_code, %positive_code, %small_scale) : (i32, i32, f32) -> (f32)
    %cancelled = scalar.addf %large, %negative_large : f32
    %base_and_cancelled = scalar.addf %base, %cancelled : f32
    %result = scalar.addf %base_and_cancelled, %small : f32
    view.store %result, %output_view[%row] : f32, view<[%row_count]xf32>
  }
  func.return
}

command.def @project() launch(%q8_input: buffer, %qkv_weight: buffer, %z_weight: buffer, %alpha_weight: buffer, %beta_weight: buffer, %qkv_output: buffer, %z_output: buffer, %alpha_output: buffer, %beta_output: buffer) {
  %input_size = index.constant 1024 : index
  %value_heads = index.constant 32 : index
  kernel.launch @qwen35_gdn_projection_decode[%input_size, %value_heads](%input_size, %value_heads, %q8_input, %qkv_weight, %z_weight, %alpha_weight, %beta_weight, %qkv_output, %z_output, %alpha_output, %beta_output) : [index, index](index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @reference(%q8_input: buffer, %qkv_weight: buffer, %z_weight: buffer, %alpha_weight: buffer, %beta_weight: buffer, %qkv_output: buffer, %z_output: buffer, %alpha_output: buffer, %beta_output: buffer) {
  %qkv_rows = index.constant 8192 : index
  %value_rows = index.constant 4096 : index
  %scalar_rows = index.constant 32 : index
  %qkv_bias = scalar.constant 1 : i32
  %z_bias = scalar.constant 3 : i32
  %alpha_bias = scalar.constant 4 : i32
  %beta_bias = scalar.constant 5 : i32
  func.call @reference_affine_rows(%qkv_rows, %qkv_bias, %qkv_output) : (index, i32, buffer)
  func.call @reference_affine_rows(%value_rows, %z_bias, %z_output) : (index, i32, buffer)
  func.call @reference_q8_rows(%scalar_rows, %alpha_bias, %alpha_output) : (index, i32, buffer)
  func.call @reference_q8_rows(%scalar_rows, %beta_bias, %beta_output) : (index, i32, buffer)
  func.return
}

check.scenario public @projection_routing {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %q8_input = check.generate.fill value(0) : tensor<320xi32>
    %qkv_weight = check.generate.fill value(0) : tensor<5767168xi8>
    %z_weight = check.generate.fill value(0) : tensor<2359296xi8>
    %alpha_weight = check.generate.fill value(0) : tensor<34816xi8>
    %beta_weight = check.generate.fill value(0) : tensor<34816xi8>
    check.generate<@initialize_projection>(%q8_input, %qkv_weight, %z_weight, %alpha_weight, %beta_weight) : (tensor<320xi32>, tensor<5767168xi8>, tensor<2359296xi8>, tensor<34816xi8>, tensor<34816xi8>) -> ()
    %qkv_output = check.generate.fill value(-99.0) : tensor<8192xf32>
    %z_output = check.generate.fill value(-99.0) : tensor<4096xf32>
    %alpha_output = check.generate.fill value(-99.0) : tensor<32xf32>
    %beta_output = check.generate.fill value(-99.0) : tensor<32xf32>
    check.compare<@project, @reference>(%q8_input, %qkv_weight, %z_weight, %alpha_weight, %beta_weight, %qkv_output, %z_output, %alpha_output, %beta_output) : (tensor<320xi32>, tensor<5767168xi8>, tensor<2359296xi8>, tensor<34816xi8>, tensor<34816xi8>, tensor<8192xf32>, tensor<4096xf32>, tensor<32xf32>, tensor<32xf32>) -> () {
      check.expect.bitwise actual(%qkv_output) expected(%qkv_output) : tensor<8192xf32>
      check.expect.bitwise actual(%z_output) expected(%z_output) : tensor<4096xf32>
      check.expect.bitwise actual(%alpha_output) expected(%alpha_output) : tensor<32xf32>
      check.expect.bitwise actual(%beta_output) expected(%beta_output) : tensor<32xf32>
      check.expect.bitwise actual(%q8_input) expected(%q8_input) : tensor<320xi32>
      check.expect.bitwise actual(%qkv_weight) expected(%qkv_weight) : tensor<5767168xi8>
      check.expect.bitwise actual(%z_weight) expected(%z_weight) : tensor<2359296xi8>
      check.expect.bitwise actual(%alpha_weight) expected(%alpha_weight) : tensor<34816xi8>
      check.expect.bitwise actual(%beta_weight) expected(%beta_weight) : tensor<34816xi8>
    }
  }
  check.return
}

check.benchmark<@projection_routing> @qwen35_gdn_projection_family
