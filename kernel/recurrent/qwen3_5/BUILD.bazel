load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE")
load("@hrx//loom/target/spirv:execution_profiles.bzl", "SPIRV_VULKAN_HARDWARE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_kernel_library", "loom_test")

package(default_visibility = ["//visibility:public"])

loom_kernel_library(
    name = "gdn_decode",
    srcs = ["gdn_decode.loom"],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx9-4-generic",
    ],
)

loom_kernel_library(
    name = "gdn_projection",
    srcs = ["gdn_projection.loom"],
    targets = [
        "@hrx//loom/target/amdgpu:gfx11-generic",
        "@hrx//loom/target/amdgpu:gfx9-4-generic",
    ],
    deps = [
        "//motif/format/ggml:q4_k",
        "//motif/format/ggml:q5_k",
        "//motif/format/ggml:q8_0",
        "//motif/format/ggml:q8_1_planar",
        "//motif/linear/ggml:affine_dot",
    ],
)

loom_test(
    name = "gdn_decode_checks",
    srcs = ["gdn_decode_test.loom"],
    execution_profiles = [
        AMD_GPU_HARDWARE_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    deps = [":gdn_decode"],
)

loom_test(
    name = "gdn_projection_checks",
    srcs = ["gdn_projection_test.loom"],
    execution_profiles = [
        AMD_GPU_HARDWARE_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    deps = [":gdn_projection"],
)
