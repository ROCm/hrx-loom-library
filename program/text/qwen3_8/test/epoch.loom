// Complete ordinary token planes and semantic feedback publication.
// Unsubmitted capacity remains unchanged; the source returns live upload ranges.

func.decl @text_encode_epoch_v1(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64)

// A nearly full first epoch and a short second epoch share one contiguous host
// input stream. The expected device image uses two independent tensor rows,
// including untouched sentinel padding between each epoch and the next plane.
func.def @encoding_fixture(%capacity_value: index, %plan: buffer, %inputs: buffer, %expected: buffer) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 8, 32768)] : index
  %origin = index.constant 0 : offset
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %input = buffer.view %inputs[%origin] : buffer -> view<[%capacity]xi32>
  %output = buffer.view %expected[%origin] : buffer -> view<2x[%capacity]xi32>
  %padding = scalar.constant -99 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %first_length = index.sub %capacity, %c5 : index
  %first_word = index.cast %first_length : index to i32
  %causal = scalar.constant 100 : i32
  %source = scalar.constant 23 : i32
  %row = scalar.constant 7 : i32
  view.store %first_word, %requests[0, 0] : i32, view<32x9xi32>
  view.store %causal, %requests[0, 1] : i32, view<32x9xi32>
  view.store %source, %requests[0, 2] : i32, view<32x9xi32>
  view.store %row, %requests[0, 3] : i32, view<32x9xi32>
  view.store %first_word, %requests[0, 5] : i32, view<32x9xi32>
  view.store %c3_i32, %requests[1, 0] : i32, view<32x9xi32>
  view.store %causal, %requests[1, 1] : i32, view<32x9xi32>
  view.store %source, %requests[1, 2] : i32, view<32x9xi32>
  view.store %row, %requests[1, 3] : i32, view<32x9xi32>
  view.store %first_word, %requests[1, 4] : i32, view<32x9xi32>
  view.store %c3_i32, %requests[1, 5] : i32, view<32x9xi32>
  view.store %c1_i32, %requests[1, 6] : i32, view<32x9xi32>
  %first_base = scalar.constant 1000 : i32
  %next_base = scalar.constant 9000 : i32
  scf.for %token = [%c0 to %capacity step %c1] {
    %word = index.cast %token : index to i32
    %first_id = scalar.addi %first_base, %word : i32
    view.store %first_id, %input[%token] : i32, view<[%capacity]xi32>
    %first_live = index.cmp ult, %token, %first_length : index
    %first = scf.select %first_live, %first_id, %padding : i32
    view.store %first, %output[0, %token] : i32, view<2x[%capacity]xi32>
    %next_id = scalar.addi %next_base, %word : i32
    %next_live = index.cmp ult, %token, %c3 : index
    %next = scf.select %next_live, %next_id, %padding : i32
    view.store %next, %output[1, %token] : i32, view<2x[%capacity]xi32>
  }
  scf.for %token = [%c0 to %c3 step %c1] {
    %destination = index.add %first_length, %token : index
    %word = index.cast %token : index to i32
    %id = scalar.addi %next_base, %word : i32
    view.store %id, %input[%destination] : i32, view<[%capacity]xi32>
  }
  func.return
}

// Upload records are source binding/offset, target binding/offset, and length.
// Construct the complete expected table from the packet's affine byte layout,
// independently of the production geometry helpers.
func.def @expected_transfer(%storage: buffer, %slot_value: index, %binding: i64, %begin: i64, %length: i64) {
  %slot = index.assume %slot_value [range(%slot_value, 0, 13)] : index
  %origin = index.constant 0 : offset
  %records = buffer.view %storage[%origin] : buffer -> view<14x5xi64>
  view.store %binding, %records[%slot, 0] : i64, view<14x5xi64>
  view.store %begin, %records[%slot, 1] : i64, view<14x5xi64>
  view.store %binding, %records[%slot, 2] : i64, view<14x5xi64>
  view.store %begin, %records[%slot, 3] : i64, view<14x5xi64>
  view.store %length, %records[%slot, 4] : i64, view<14x5xi64>
  func.return
}

func.def @transfers_match(%storage: buffer, %begin: i64, %length: i64, %capacity: index) -> (i1) {
  %origin = index.constant 0 : offset
  %table_origin = index.constant 416 : offset
  %bytes = index.constant 560 : offset
  %expected = buffer.alloca<private> align(8) %bytes : buffer
  %capacity_word = index.cast %capacity : index to i64
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c4_i64 = scalar.constant 4 : i64
  %c5_i64 = scalar.constant 5 : i64
  %c8_i64 = scalar.constant 8 : i64
  %c12_i64 = scalar.constant 12 : i64
  %c16_i64 = scalar.constant 16 : i64
  %c24_i64 = scalar.constant 24 : i64
  %c28_i64 = scalar.constant 28 : i64
  %c32_i64 = scalar.constant 32 : i64
  %c36_i64 = scalar.constant 36 : i64
  %c60_i64 = scalar.constant 60 : i64
  %c64_i64 = scalar.constant 64 : i64
  %c72_i64 = scalar.constant 72 : i64
  %c76_i64 = scalar.constant 76 : i64
  %c100_i64 = scalar.constant 100 : i64
  %c112_i64 = scalar.constant 112 : i64
  %first_tokens = scalar.subi %capacity_word, %c5_i64 : i64
  %first_bytes = scalar.muli %first_tokens, %c4_i64 : i64
  %slot0 = index.constant 0 : index
  func.call @expected_transfer(%expected, %slot0, %c0_i64, %c0_i64, %c36_i64) : (buffer, index, i64, i64, i64)
  %slot1 = index.constant 1 : index
  %scaled1 = scalar.muli %capacity_word, %c24_i64 : i64
  %offset1 = scalar.addi %scaled1, %c12_i64 : i64
  func.call @expected_transfer(%expected, %slot1, %c0_i64, %offset1, %c0_i64) : (buffer, index, i64, i64, i64)
  %slot2 = index.constant 2 : index
  %scaled2 = scalar.muli %capacity_word, %c28_i64 : i64
  %offset2 = scalar.addi %scaled2, %c12_i64 : i64
  func.call @expected_transfer(%expected, %slot2, %c0_i64, %offset2, %c8_i64) : (buffer, index, i64, i64, i64)
  %slot3 = index.constant 3 : index
  %scaled3 = scalar.muli %capacity_word, %c36_i64 : i64
  %offset3 = scalar.addi %scaled3, %c12_i64 : i64
  func.call @expected_transfer(%expected, %slot3, %c0_i64, %offset3, %c4_i64) : (buffer, index, i64, i64, i64)
  %slot4 = index.constant 4 : index
  %scaled4 = scalar.muli %capacity_word, %c36_i64 : i64
  %offset4 = scalar.addi %scaled4, %c16_i64 : i64
  func.call @expected_transfer(%expected, %slot4, %c0_i64, %offset4, %c36_i64) : (buffer, index, i64, i64, i64)
  %slot5 = index.constant 5 : index
  %scaled5 = scalar.muli %capacity_word, %c60_i64 : i64
  %offset5 = scalar.addi %scaled5, %c28_i64 : i64
  func.call @expected_transfer(%expected, %slot5, %c0_i64, %offset5, %c4_i64) : (buffer, index, i64, i64, i64)
  %slot6 = index.constant 6 : index
  %scaled6 = scalar.muli %capacity_word, %c64_i64 : i64
  %offset6 = scalar.addi %scaled6, %c28_i64 : i64
  func.call @expected_transfer(%expected, %slot6, %c0_i64, %offset6, %c8_i64) : (buffer, index, i64, i64, i64)
  %slot7 = index.constant 7 : index
  %scaled7 = scalar.muli %capacity_word, %c72_i64 : i64
  %offset7 = scalar.addi %scaled7, %c28_i64 : i64
  func.call @expected_transfer(%expected, %slot7, %c0_i64, %offset7, %c4_i64) : (buffer, index, i64, i64, i64)
  %slot8 = index.constant 8 : index
  %scaled8 = scalar.muli %capacity_word, %c72_i64 : i64
  %offset8 = scalar.addi %scaled8, %c32_i64 : i64
  func.call @expected_transfer(%expected, %slot8, %c0_i64, %offset8, %c4_i64) : (buffer, index, i64, i64, i64)
  %slot9 = index.constant 9 : index
  %scaled9 = scalar.muli %capacity_word, %c76_i64 : i64
  %offset9 = scalar.addi %scaled9, %c32_i64 : i64
  func.call @expected_transfer(%expected, %slot9, %c0_i64, %offset9, %c24_i64) : (buffer, index, i64, i64, i64)
  %slot10 = index.constant 10 : index
  %scaled10 = scalar.muli %capacity_word, %c100_i64 : i64
  %offset10 = scalar.addi %scaled10, %c32_i64 : i64
  func.call @expected_transfer(%expected, %slot10, %c0_i64, %offset10, %c0_i64) : (buffer, index, i64, i64, i64)
  %slot11 = index.constant 11 : index
  %scaled11 = scalar.muli %capacity_word, %c112_i64 : i64
  %offset11 = scalar.addi %scaled11, %c32_i64 : i64
  func.call @expected_transfer(%expected, %slot11, %c0_i64, %offset11, %c0_i64) : (buffer, index, i64, i64, i64)
  %slot12 = index.constant 12 : index
  func.call @expected_transfer(%expected, %slot12, %c1_i64, %c0_i64, %first_bytes) : (buffer, index, i64, i64, i64)
  %slot13 = index.constant 13 : index
  %scaled13 = scalar.muli %capacity_word, %c4_i64 : i64
  func.call @expected_transfer(%expected, %slot13, %c1_i64, %scaled13, %c12_i64) : (buffer, index, i64, i64, i64)
  %order = buffer.compare %storage[%table_origin], %expected[%origin], %bytes
  %equal = scalar.constant 0 : i32
  %same_table = scalar.cmpi eq, %order, %equal : i32
  %expected_begin = scalar.constant 416 : i64
  %expected_length = scalar.constant 560 : i64
  %same_begin = scalar.cmpi eq, %begin, %expected_begin : i64
  %same_length = scalar.cmpi eq, %length, %expected_length : i64
  %same_range = scalar.andi %same_begin, %same_length : i1
  %valid = scalar.andi %same_table, %same_range : i1
  func.return %valid : i1
}

// Exercise the real VM entry point and compare both complete planes with the
// independently constructed image. The output buffer begins with a sentinel.
func.def @encode_token_planes(%capacity: index) -> (i1, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %policy_bytes = index.constant 976 : offset
  %plan_bytes = index.constant 1152 : offset
  %metadata_base = index.constant 40 : offset
  %metadata_stride = index.constant 112 : offset
  %metadata_tail = index.scale %capacity, %metadata_stride : index, offset -> offset
  %metadata_bytes = index.add %metadata_base, %metadata_tail : offset
  %word_bytes = index.constant 4 : offset
  %input_bytes = index.scale %capacity, %word_bytes : index, offset -> offset
  %token_bytes = index.add %input_bytes, %input_bytes : offset
  %policy = buffer.alloca<private> align(8) %policy_bytes : buffer
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %inputs = buffer.alloca<private> align(4) %input_bytes : buffer
  %metadata = buffer.alloca<private> align(4) %metadata_bytes : buffer
  %tokens = buffer.alloca<private> align(4) %token_bytes : buffer
  %expected = buffer.alloca<private> align(4) %token_bytes : buffer
  %c0_i32 = scalar.constant 0 : i32
  %sentinel = scalar.constant -99 : i32
  buffer.fill %c0_i32, %policy[%origin], %policy_bytes : i32
  buffer.fill %c0_i32, %plan[%origin], %plan_bytes : i32
  buffer.fill %sentinel, %metadata[%origin], %metadata_bytes : i32
  buffer.fill %sentinel, %tokens[%origin], %token_bytes : i32
  func.call @encoding_fixture(%capacity, %plan, %inputs, %expected) : (index, buffer, buffer, buffer)
  %c1_i32 = scalar.constant 1 : i32
  %eos = scalar.constant 42 : i32
  %capacity_word = index.cast %capacity : index to i32
  %c2_i32 = scalar.constant 2 : i32
  %input_count = scalar.subi %capacity_word, %c2_i32 : i32
  %outputs, %transfers, %transfer_begin, %transfer_length = func.call @text_encode_epoch_v1(%policy, %plan, %inputs, %inputs, %c1_i32, %c1_i32, %input_count, %c0_i32, %c0_i32, %c0_i32, %c0_i32, %eos, %metadata, %tokens) : (buffer, buffer, buffer, buffer, i32, i32, i32, i32, i32, i32, i32, i32, buffer, buffer) -> (i32, buffer, i64, i64)
  %no_outputs = scalar.cmpi eq, %outputs, %c0_i32 : i32
  %valid_transfers = func.call @transfers_match(%transfers, %transfer_begin, %transfer_length, %capacity) : (buffer, i64, i64, index) -> (i1)
  %valid = scalar.andi %no_outputs, %valid_transfers : i1
  %actual_view = buffer.view %tokens[%origin] : buffer -> view<2x[%capacity]xi32>
  %expected_view = buffer.view %expected[%origin] : buffer -> view<2x[%capacity]xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %planes_correct = scf.for %plane = [%c0 to %c2 step %c1](%planes_equal = %valid : i1) -> (i1) {
    %equal = scf.for %token = [%c0 to %capacity step %c1](%tokens_equal = %planes_equal : i1) -> (i1) {
      %actual = view.load %actual_view[%plane, %token] : view<2x[%capacity]xi32> -> i32
      %expected = view.load %expected_view[%plane, %token] : view<2x[%capacity]xi32> -> i32
      %same = scalar.cmpi eq, %actual, %expected : i32
      %equal = scalar.andi %tokens_equal, %same : i1
      scf.yield %equal : i1
    }
    scf.yield %equal : i1
  }
  %first_origin = index.constant 12 : offset
  %next_base = index.constant 28 : offset
  %bank_stride = index.constant 36 : offset
  %bank_tail = index.scale %capacity, %bank_stride : index, offset -> offset
  %next_origin = index.add %next_base, %bank_tail : offset
  %first_descriptor = buffer.view %metadata[%first_origin] : buffer -> view<6xi32>
  %next_descriptor = buffer.view %metadata[%next_origin] : buffer -> view<6xi32>
  %causal = view.load %first_descriptor[1] : view<6xi32> -> i32
  %row = view.load %first_descriptor[3] : view<6xi32> -> i32
  %first_source = view.load %first_descriptor[4] : view<6xi32> -> i32
  %next_source = view.load %next_descriptor[4] : view<6xi32> -> i32
  %first_selection = view.load %first_descriptor[5] : view<6xi32> -> i32
  %next_selection = view.load %next_descriptor[5] : view<6xi32> -> i32
  %absent = scalar.constant -1 : i32
  %first_unselected = scalar.cmpi eq, %first_selection, %absent : i32
  %next_selected = scalar.cmpi eq, %next_selection, %c0_i32 : i32
  %valid_selection = scalar.andi %first_unselected, %next_selected : i1
  %correct = scalar.andi %planes_correct, %valid_selection : i1
  func.return %correct, %causal, %row, %first_source, %next_source : i1, i32, i32, i32, i32
}

check.case public @queued_epoch_token_planes {
  %capacity = check.param.choice values([8, 514, 16384]) : index
  %expected = check.literal value(true) : i1
  %actual, %causal, %row, %first_source, %next_source = func.call @encode_token_planes(%capacity) : (index) -> (i1, i32, i32, i32, i32)
  %expected_causal = check.literal value(100) : i32
  %expected_row = check.literal value(7) : i32
  // Selection has its own word; both plans retain the original source position
  // before device-side advancement.
  %expected_first_source = check.literal value(23) : i32
  %expected_next_source = check.literal value(23) : i32
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.expect.equal actual(%causal) expected(%expected_causal) : i32
  check.expect.equal actual(%row) expected(%expected_row) : i32
  check.expect.equal actual(%first_source) expected(%expected_first_source) : i32
  check.expect.equal actual(%next_source) expected(%expected_next_source) : i32
  check.return
}

func.decl @text_publish_epoch_v1(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %continuation_flags: buffer, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer)

// Two requests have causal positions 100/200 and source positions 23/71.
// Ordinary feedback selects only the second request. Verified feedback accepts
// three speculative tokens for the first request and two known tokens for the
// second. Continuation record zero then contributes to request one, exercising
// tag-based ownership independently of the record order.
func.def @publish_fixture(%verified: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %plan_bytes = index.constant 1152 : offset
  %ordinary_bytes = index.constant 64 : offset
  %result_bytes = index.constant 704 : offset
  %progress_bytes = index.constant 1344 : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %ordinary = buffer.alloca<private> align(4) %ordinary_bytes : buffer
  %first_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %next_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %progress = buffer.alloca<private> align(4) %progress_bytes : buffer
  %flag_bytes = index.constant 8 : offset
  %continuation_flags = buffer.alloca<private> align(4) %flag_bytes : buffer
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %absent = scalar.constant -1 : i32
  %continuations = buffer.view %continuation_flags[%origin] : buffer -> view<2xi32>
  view.store %c0_i32, %continuations[0] : i32, view<2xi32>
  view.store %c1_i32, %continuations[1] : i32, view<2xi32>
  buffer.fill %c0_i32, %plan[%origin], %plan_bytes : i32
  buffer.fill %c0_i32, %ordinary[%origin], %ordinary_bytes : i32
  buffer.fill %c0_i32, %first_results[%origin], %result_bytes : i32
  buffer.fill %c0_i32, %next_results[%origin], %result_bytes : i32
  buffer.fill %absent, %progress[%origin], %progress_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %tokens = buffer.view %ordinary[%origin] : buffer -> view<16xi32>
  %first = buffer.view %first_results[%origin] : buffer -> view<16x10xi32>
  %next = buffer.view %next_results[%origin] : buffer -> view<16x10xi32>
  %tags_origin = index.constant 640 : offset
  buffer.fill %absent, %next_results[%tags_origin], %ordinary_bytes : i32
  %tags = buffer.view %next_results[%tags_origin] : buffer -> view<16xi32>
  %source0 = scalar.constant 23 : i32
  %source1 = scalar.constant 71 : i32
  %token42 = scalar.constant 42 : i32
  %token100 = scalar.constant 100 : i32
  %token101 = scalar.constant 101 : i32
  %token102 = scalar.constant 102 : i32
  %token200 = scalar.constant 200 : i32
  %token201 = scalar.constant 201 : i32
  %token202 = scalar.constant 202 : i32
  view.store %c3_i32, %requests[0, 0] : i32, view<32x9xi32>
  view.store %token100, %requests[0, 1] : i32, view<32x9xi32>
  view.store %source0, %requests[0, 2] : i32, view<32x9xi32>
  %verifies = scalar.cmpi ne, %verified, %c0_i32 : i32
  %credit = scf.select %verifies, %c3_i32, %c0_i32 : i32
  %second_length = scf.select %verifies, %c2_i32, %c1_i32 : i32
  view.store %verified, %requests[0, 6] : i32, view<32x9xi32>
  view.store %credit, %requests[0, 7] : i32, view<32x9xi32>
  view.store %second_length, %requests[1, 0] : i32, view<32x9xi32>
  view.store %token200, %requests[1, 1] : i32, view<32x9xi32>
  view.store %source1, %requests[1, 2] : i32, view<32x9xi32>
  view.store %c1_i32, %requests[1, 6] : i32, view<32x9xi32>
  view.store %token42, %tokens[0] : i32, view<16xi32>
  view.store %c3_i32, %first[0, 0] : i32, view<16x10xi32>
  view.store %c3_i32, %first[0, 1] : i32, view<16x10xi32>
  view.store %token100, %first[0, 2] : i32, view<16x10xi32>
  view.store %token101, %first[0, 3] : i32, view<16x10xi32>
  view.store %token102, %first[0, 4] : i32, view<16x10xi32>
  view.store %c2_i32, %first[1, 0] : i32, view<16x10xi32>
  view.store %c1_i32, %first[1, 1] : i32, view<16x10xi32>
  view.store %token200, %first[1, 2] : i32, view<16x10xi32>
  view.store %c2_i32, %next[0, 0] : i32, view<16x10xi32>
  view.store %c2_i32, %next[0, 1] : i32, view<16x10xi32>
  view.store %token201, %next[0, 2] : i32, view<16x10xi32>
  view.store %token202, %next[0, 3] : i32, view<16x10xi32>
  view.store %c1_i32, %tags[0] : i32, view<16xi32>
  func.call @text_publish_epoch_v1(%plan, %ordinary, %c2_i32, %c0_i32, %c0_i32, %verified, %verified, %continuation_flags, %ordinary, %first_results, %next_results, %progress) : (buffer, buffer, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer, buffer)
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %consumed = view.load %published[1, 0] : view<16x21xi32> -> i32
  %known = view.load %published[1, 1] : view<16x21xi32> -> i32
  %outputs = view.load %published[1, 2] : view<16x21xi32> -> i32
  %verifications = view.load %published[1, 3] : view<16x21xi32> -> i32
  %source = view.load %published[1, 4] : view<16x21xi32> -> i32
  %token0 = view.load %published[1, 5] : view<16x21xi32> -> i32
  %token1 = view.load %published[1, 6] : view<16x21xi32> -> i32
  %token2 = view.load %published[1, 7] : view<16x21xi32> -> i32
  %first_source = view.load %published[0, 4] : view<16x21xi32> -> i32
  %first_token2 = view.load %published[0, 7] : view<16x21xi32> -> i32
  func.return %consumed, %known, %outputs, %verifications, %source, %token0, %token1, %token2, %first_source, %first_token2 : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
}

check.case public @ordinary_progress {
  %ordinary = check.literal value(0) : i32
  %consumed, %known, %outputs, %verifications, %source, %token0, %token1, %token2, %first_source, %first_token2 = func.call @publish_fixture(%ordinary) : (i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)
  %c0_i32 = check.literal value(0) : i32
  %c1_i32 = check.literal value(1) : i32
  %source26 = check.literal value(26) : i32
  %source72 = check.literal value(72) : i32
  %token42 = check.literal value(42) : i32
  check.expect.equal actual(%consumed) expected(%c1_i32) : i32
  check.expect.equal actual(%known) expected(%c1_i32) : i32
  check.expect.equal actual(%outputs) expected(%c1_i32) : i32
  check.expect.equal actual(%verifications) expected(%c0_i32) : i32
  check.expect.equal actual(%source) expected(%source72) : i32
  check.expect.equal actual(%token0) expected(%token42) : i32
  check.expect.equal actual(%token1) expected(%c0_i32) : i32
  check.expect.equal actual(%token2) expected(%c0_i32) : i32
  check.expect.equal actual(%first_source) expected(%source26) : i32
  check.expect.equal actual(%first_token2) expected(%c0_i32) : i32
  check.return
}

check.case public @verified_continuation_progress {
  %verified = check.literal value(1) : i32
  %consumed, %known, %outputs, %verifications, %source, %token0, %token1, %token2, %first_source, %first_token2 = func.call @publish_fixture(%verified) : (i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)
  %c1_i32 = check.literal value(1) : i32
  %c2_i32 = check.literal value(2) : i32
  %c3_i32 = check.literal value(3) : i32
  %c4_i32 = check.literal value(4) : i32
  %source26 = check.literal value(26) : i32
  %source75 = check.literal value(75) : i32
  %token102 = check.literal value(102) : i32
  %token200 = check.literal value(200) : i32
  %token201 = check.literal value(201) : i32
  %token202 = check.literal value(202) : i32
  check.expect.equal actual(%consumed) expected(%c4_i32) : i32
  check.expect.equal actual(%known) expected(%c2_i32) : i32
  check.expect.equal actual(%outputs) expected(%c3_i32) : i32
  check.expect.equal actual(%verifications) expected(%c1_i32) : i32
  check.expect.equal actual(%source) expected(%source75) : i32
  check.expect.equal actual(%token0) expected(%token200) : i32
  check.expect.equal actual(%token1) expected(%token201) : i32
  check.expect.equal actual(%token2) expected(%token202) : i32
  check.expect.equal actual(%first_source) expected(%source26) : i32
  check.expect.equal actual(%first_token2) expected(%token102) : i32
  check.return
}

check.benchmark<@queued_epoch_token_planes> @queued_epoch_token_planes_policy

check.benchmark<@ordinary_progress> @ordinary_progress_policy

check.benchmark<@verified_continuation_progress> @verified_continuation_progress_policy

// Feedback compacts participants into reverse order. The allocation has spare
// records, so the tag plane begins at capacity, not at the live span count.
// Flags alternate by first-cohort ordinal beyond the width of an integer mask.
func.def @wide_publication(%count: index) -> (i32) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %capacity = index.add %count, %c3 : index
  %plan_stride = index.constant 36 : offset
  %result_stride = index.constant 40 : offset
  %tagged_stride = index.constant 44 : offset
  %progress_stride = index.constant 84 : offset
  %word_bytes = index.constant 4 : offset
  %plan_bytes = index.scale %count, %plan_stride : index, offset -> offset
  %result_bytes = index.scale %capacity, %result_stride : index, offset -> offset
  %tagged_bytes = index.scale %capacity, %tagged_stride : index, offset -> offset
  %progress_bytes = index.scale %count, %progress_stride : index, offset -> offset
  %flag_bytes = index.scale %count, %word_bytes : index, offset -> offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %first_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %next_results = buffer.alloca<private> align(4) %tagged_bytes : buffer
  %flags = buffer.alloca<private> align(4) %flag_bytes : buffer
  %progress = buffer.alloca<private> align(4) %progress_bytes : buffer
  %expected = buffer.alloca<private> align(4) %progress_bytes : buffer
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %none = scalar.constant -1 : i32
  buffer.fill %c0_i32, %plan[%origin], %plan_bytes : i32
  buffer.fill %c0_i32, %first_results[%origin], %result_bytes : i32
  buffer.fill %none, %next_results[%origin], %tagged_bytes : i32
  buffer.fill %none, %progress[%origin], %progress_bytes : i32
  buffer.fill %c0_i32, %expected[%origin], %progress_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<[%count]x9xi32>
  %first = buffer.view %first_results[%origin] : buffer -> view<[%capacity]x10xi32>
  %next = buffer.view %next_results[%origin] : buffer -> view<[%capacity]x10xi32>
  %tags = buffer.view %next_results[%result_bytes] : buffer -> view<[%capacity]xi32>
  %continuations = buffer.view %flags[%origin] : buffer -> view<[%count]xi32>
  %oracle = buffer.view %expected[%origin] : buffer -> view<[%count]x21xi32>
  %last = index.sub %count, %c1 : index
  %source_base = scalar.constant 100 : i32
  %first_base = scalar.constant 1000 : i32
  %next_base = scalar.constant 2000 : i32
  %identity_base = scalar.constant 1000000 : i32
  scf.for %i = [%c0 to %count step %c1] {
    %ordinal = index.cast %i : index to i32
    %identity = scalar.addi %ordinal, %identity_base : i32
    %source = scalar.addi %ordinal, %source_base : i32
    %first_token = scalar.addi %ordinal, %first_base : i32
    %next_token = scalar.addi %ordinal, %next_base : i32
    %flag = scalar.andi %ordinal, %c1_i32 : i32
    view.store %c1_i32, %requests[%i, 0] : i32, view<[%count]x9xi32>
    view.store %source, %requests[%i, 2] : i32, view<[%count]x9xi32>
    view.store %identity, %requests[%i, 3] : i32, view<[%count]x9xi32>
    view.store %ordinal, %requests[%i, 8] : i32, view<[%count]x9xi32>
    view.store %c1_i32, %first[%i, 0] : i32, view<[%capacity]x10xi32>
    view.store %c1_i32, %first[%i, 1] : i32, view<[%capacity]x10xi32>
    view.store %first_token, %first[%i, 2] : i32, view<[%capacity]x10xi32>
    %compacted = index.sub %last, %i : index
    view.store %c2_i32, %next[%compacted, 0] : i32, view<[%capacity]x10xi32>
    view.store %c1_i32, %next[%compacted, 1] : i32, view<[%capacity]x10xi32>
    view.store %next_token, %next[%compacted, 2] : i32, view<[%capacity]x10xi32>
    view.store %ordinal, %tags[%compacted] : i32, view<[%capacity]xi32>
    view.store %flag, %continuations[%i] : i32, view<[%count]xi32>
    %speculative = scalar.cmpi ne, %flag, %c0_i32 : i32
    %known = scf.select %speculative, %c1_i32, %c3_i32 : i32
    %frontier = scalar.addi %source, %c3_i32 : i32
    view.store %c3_i32, %oracle[%i, 0] : i32, view<[%count]x21xi32>
    view.store %known, %oracle[%i, 1] : i32, view<[%count]x21xi32>
    view.store %c2_i32, %oracle[%i, 2] : i32, view<[%count]x21xi32>
    view.store %flag, %oracle[%i, 3] : i32, view<[%count]x21xi32>
    view.store %frontier, %oracle[%i, 4] : i32, view<[%count]x21xi32>
    view.store %first_token, %oracle[%i, 5] : i32, view<[%count]x21xi32>
    view.store %next_token, %oracle[%i, 6] : i32, view<[%count]x21xi32>
  }
  %count_word = index.cast %count : index to i32
  func.call @text_publish_epoch_v1(%plan, %plan, %count_word, %c0_i32, %c0_i32, %c1_i32, %c1_i32, %flags, %flags, %first_results, %next_results, %progress) : (buffer, buffer, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer, buffer)
  %difference = buffer.compare %progress[%origin], %expected[%origin], %progress_bytes
  func.return %difference : i32
}

check.case public @wide_compacted_feedback {
  %count = check.param.choice values([1, 17, 65, 129]) : index
  %difference = func.call @wide_publication(%count) : (index) -> (i32)
  %equal = check.literal value(0) : i32
  check.expect.equal actual(%difference) expected(%equal) : i32
  check.return
}

check.benchmark<@wide_compacted_feedback> @wide_compacted_feedback_policy
