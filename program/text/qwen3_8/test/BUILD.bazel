load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("@loom_sdk//:config.bzl", "SOURCE_INTEGRATION_COMPATIBLE_WITH")
load("//build_tools/bazel:defs.bzl", "loom_module", "loom_test")

package(default_visibility = ["//visibility:private"])

exports_files(["storage.loom"])

loom_test(
    name = "storage_records",
    srcs = ["storage_records.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:storage"],
)

loom_test(
    name = "packet_capacity",
    srcs = ["packet_capacity.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:storage"],
)

loom_test(
    name = "chat",
    srcs = ["chat.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:chat"],
)

loom_test(
    name = "epoch",
    srcs = ["epoch.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = [
        "//program/text/qwen3_8:epoch",
        "//program/text/qwen3_8:storage",
    ],
)

loom_test(
    name = "media",
    srcs = ["media.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = [
        "//motif/sequence/qwen3_8:continuation",
        "//program/text/qwen3_8:epoch",
        "//program/text/qwen3_8:storage",
    ],
)

loom_test(
    name = "state",
    srcs = ["state.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:epoch"],
)

loom_test(
    name = "policy",
    srcs = ["policy.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = [
        "//motif/sequence/qwen3_8:continuation",
        "//program/text/qwen3_8:chat",
        "//program/text/qwen3_8:epoch",
        "//program/text/qwen3_8:storage",
    ],
