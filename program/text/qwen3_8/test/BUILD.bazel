load("@hrx//build_tools/bazel:python.bzl", "iree_py_test")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_module", "loom_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "chat",
    srcs = ["chat.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:chat"],
)

loom_test(
    name = "epoch",
    srcs = ["epoch.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:epoch"],
)

loom_test(
    name = "media",
    srcs = ["media.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:epoch"],
)

loom_test(
    name = "state",
    srcs = ["state.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:epoch"],
)

loom_test(
    name = "vision_geometry",
    srcs = ["vision_geometry.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//program/text/qwen3_8:vision_geometry"],
)

loom_module(
    name = "request_control",
    srcs = [
        "chat.loom",
        "//program/text/qwen3_8:chat",
    ],
    include_input_exports = True,
    libraries = ["//program/text/qwen3_8:vision_geometry"],
    mode = "link",
    output_format = "bc",
    strip_check = True,
)

iree_py_test(
    name = "request_test",
    srcs = ["request_test.py"],
    args = [
        "$(rootpath @hrx//loom/src/loom/serve/testing:text_request_check)",
        "$(rootpath model.json)",
    ],
    data = [
        ":request_control",
        "model.json",
        "@hrx//loom/src/loom/serve/testing:text_request_check",
    ],
    main = "request_test.py",
)
