loom_module(
    name = "request_control",
    srcs = [
        "chat_test.loom",
        "//program/text/qwen3_8:chat",
    ],
    include_input_exports = True,
    libraries = [
        "//program/text/qwen3_8:chat_history",
        "//program/text/qwen3_8:vision_geometry",
    ],
    mode = "link",
    output_format = "bc",
    strip_check = True,
    target_compatible_with = SOURCE_INTEGRATION_COMPATIBLE_WITH,
)

iree_py_test(
    name = "request_test",
    srcs = ["request_test.py"],
    args = [
        "$(rootpath @hrx//loom/src/loom/serve/testing:text_request_check)",
        "$(rootpath model.json)",
    ],
    data = [
        "model.json",
        ":request_control",
        "@hrx//loom/src/loom/serve/testing:text_request_check",
    ],
    main = "request_test.py",
    # This checker links serving internals, which are not installed SDK tools.
    # Ordinary source-mode tests cover it; SDK mode uses the public Loom checks
    # above and the models' HTTP service checks without rebuilding HRX internals.
    tags = ["source-integration"],
    target_compatible_with = SOURCE_INTEGRATION_COMPATIBLE_WITH,
)

loom_test(
