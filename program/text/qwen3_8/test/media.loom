// Mixed image packets retain within-image coordinates across every split of
// an ordinary/image/ordinary stream. The independent coordinate oracle uses
// explicit maxima, not the encoder's compressed-prefix formula. Publication
// consumes known feedback and must preserve the same source frontier.

func.decl @qwen38_continue_spans(%mixed_inputs: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

func.decl @text_encode_epoch_v1(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64)

func.decl @text_publish_epoch_v1(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative_mask: i32, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer)

// Exercise every split through an ordinary/image/ordinary stream with padded
// first/continuation packet banks. The coordinate oracle tracks the maximum
// coordinate directly, independently of the production prefix formula.
func.def @mixed_split_observation(%split: i32, %grid_width: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %plan_bytes = index.constant 1152 : offset
  %state_bytes = index.constant 976 : offset
  %input_bytes = index.constant 264 : offset
  %metadata_bytes = index.constant 6128 : offset
  %token_bytes = index.constant 2368 : offset
  %media_bytes = index.constant 1800 : offset
  %result_bytes = index.constant 1344 : offset
  %progress_bytes = index.constant 1344 : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %inputs = buffer.alloca<private> align(4) %input_bytes : buffer
  %metadata = buffer.alloca<private> align(4) %metadata_bytes : buffer
  %tokens = buffer.alloca<private> align(4) %token_bytes : buffer
  %media_plan = buffer.alloca<private> align(4) %media_bytes : buffer
  %first_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %next_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %progress = buffer.alloca<private> align(4) %progress_bytes : buffer
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c5_i32 = scalar.constant 5 : i32
  %c16_i32 = scalar.constant 16 : i32
  %c64_i32 = scalar.constant 64 : i32
  %total = scalar.constant 66 : i32
  %id = scalar.constant 900 : i32
  %none = scalar.constant -1 : i32
  buffer.fill %c0_i32, %plan[%origin], %plan_bytes : i32
  buffer.fill %c0_i32, %state[%origin], %state_bytes : i32
  buffer.fill %c0_i32, %metadata[%origin], %metadata_bytes : i32
  buffer.fill %c0_i32, %media_plan[%origin], %media_bytes : i32
  buffer.fill %id, %inputs[%origin], %input_bytes : i32
  buffer.fill %c0_i32, %first_results[%origin], %result_bytes : i32
  buffer.fill %c0_i32, %next_results[%origin], %result_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %remaining = scalar.subi %total, %split : i32
  view.store %split, %requests[0, 0] : i32, view<32x9xi32>
  view.store %split, %requests[0, 5] : i32, view<32x9xi32>
  view.store %remaining, %requests[16, 0] : i32, view<32x9xi32>
  view.store %split, %requests[16, 4] : i32, view<32x9xi32>
  view.store %remaining, %requests[16, 5] : i32, view<32x9xi32>
  %first_capacity = scalar.addi %split, %c3_i32 : i32
  %next_capacity = scalar.addi %remaining, %c5_i32 : i32
  %first_media = scalar.subi %split, %c1_i32 : i32
  %next_media = scalar.subi %c64_i32, %first_media : i32
  %media = buffer.view %media_plan[%origin] : buffer -> view<64x7xi32>
  %image_metadata_offset = index.constant 1792 : offset
  %image_metadata_word = scalar.constant 1792 : i32
  %image_metadata_length = scalar.constant 8 : i32
  %image_metadata = buffer.view %media_plan[%image_metadata_offset] : buffer -> view<2xi32>
  %merged_patch = scalar.constant 32 : i32
  %grid_height = scalar.divui %c64_i32, %grid_width : i32
  %image_width = scalar.muli %grid_width, %merged_patch : i32
  %image_height = scalar.muli %grid_height, %merged_patch : i32
  view.store %image_width, %image_metadata[0] : i32, view<2xi32>
  view.store %image_height, %image_metadata[1] : i32, view<2xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c66 = index.constant 66 : index
  %features_origin = scalar.constant 2368 : i32
  %feature_bytes = scalar.constant 20480 : i32
  scf.for %i = [%c0 to %c64 step %c1] {
    %row = index.cast %i : index to i32
    %input = scalar.addi %row, %c1_i32 : i32
    %primary = scalar.cmpi ult, %input, %split : i32
    %owner = scf.select %primary, %c0_i32, %c16_i32 : i32
    %next_offset = scalar.subi %input, %split : i32
    %offset = scf.select %primary, %input, %next_offset : i32
    %feature_begin = scalar.muli %row, %feature_bytes : i32
    %feature_offset = scalar.addi %features_origin, %feature_begin : i32
    view.store %owner, %media[%i, 0] : i32, view<64x7xi32>
    view.store %offset, %media[%i, 1] : i32, view<64x7xi32>
    view.store %feature_offset, %media[%i, 2] : i32, view<64x7xi32>
    view.store %feature_bytes, %media[%i, 3] : i32, view<64x7xi32>
    view.store %image_metadata_word, %media[%i, 4] : i32, view<64x7xi32>
    view.store %image_metadata_length, %media[%i, 5] : i32, view<64x7xi32>
    view.store %row, %media[%i, 6] : i32, view<64x7xi32>
  }
  %outputs, %transfers, %transfer_begin, %transfer_length = func.call @text_encode_epoch_v1(%state, %plan, %inputs, %media_plan, %c1_i32, %c1_i32, %total, %first_media, %next_media, %first_capacity, %next_capacity, %none, %metadata, %tokens) : (buffer, buffer, buffer, buffer, i32, i32, i32, i32, i32, i32, i32, i32, buffer, buffer) -> (i32, buffer, i64, i64)
  %records = buffer.view %tokens[%origin] : buffer -> view<74x8xi32>
  %failures, %expected_source = scf.for %i = [%c0 to %c66 step %c1](%failures = %c0_i32 : i32, %prior_frontier = %c0_i32 : i32) -> (i32, i32) {
    %input = index.cast %i : index to i32
    %primary = scalar.cmpi ult, %input, %split : i32
    %queued_index = scalar.addi %input, %c3_i32 : i32
    %record_word = scf.select %primary, %input, %queued_index : i32
    %record_value = index.cast %record_word : i32 to index
    %record = index.assume %record_value [range(%record_value, 0, 73)] : index
    %after_start = scalar.cmpi ugt, %input, %c0_i32 : i32
    %before_end = scalar.cmpi ule, %input, %c64_i32 : i32
    %image = scalar.andi %after_start, %before_end : i1
    %feature_offset, %temporal, %height, %width, %frontier = scf.if %image -> (i32, i32, i32, i32, i32) {
      %row = scalar.subi %input, %c1_i32 : i32
      %offset = scalar.muli %row, %feature_bytes : i32
      %feature_offset = scalar.addi %features_origin, %offset : i32
      %y = scalar.divui %row, %grid_width : i32
      %x = scalar.remui %row, %grid_width : i32
      %height = scalar.addi %c1_i32, %y : i32
      %width = scalar.addi %c1_i32, %x : i32
      %maximum = scalar.maxui %height, %width : i32
      %following = scalar.addi %maximum, %c1_i32 : i32
      %frontier = scalar.maxui %prior_frontier, %following : i32
      scf.yield %feature_offset, %c1_i32, %height, %width, %frontier : i32, i32, i32, i32, i32
    } else {
      %frontier = scalar.addi %prior_frontier, %c1_i32 : i32
      scf.yield %c0_i32, %prior_frontier, %prior_frontier, %prior_frontier, %frontier : i32, i32, i32, i32, i32
    }
    %actual_id = view.load %records[%record, 0] : view<74x8xi32> -> i32
    %actual_offset = view.load %records[%record, 1] : view<74x8xi32> -> i32
    %actual_temporal = view.load %records[%record, 2] : view<74x8xi32> -> i32
    %actual_height = view.load %records[%record, 3] : view<74x8xi32> -> i32
    %actual_width = view.load %records[%record, 4] : view<74x8xi32> -> i32
    %actual_frontier = view.load %records[%record, 5] : view<74x8xi32> -> i32
    %id_ok = scalar.cmpi eq, %actual_id, %id : i32
    %offset_ok = scalar.cmpi eq, %actual_offset, %feature_offset : i32
    %temporal_ok = scalar.cmpi eq, %actual_temporal, %temporal : i32
    %height_ok = scalar.cmpi eq, %actual_height, %height : i32
    %width_ok = scalar.cmpi eq, %actual_width, %width : i32
    %frontier_ok = scalar.cmpi eq, %actual_frontier, %frontier : i32
    %identity_ok = scalar.andi %id_ok, %offset_ok : i1
    %axes_ok = scalar.andi %temporal_ok, %height_ok : i1
    %position_ok = scalar.andi %width_ok, %frontier_ok : i1
    %first_ok = scalar.andi %identity_ok, %axes_ok : i1
    %all_ok = scalar.andi %first_ok, %position_ok : i1
    %failure = scf.select %all_ok, %c0_i32, %c1_i32 : i32
    %next = scalar.addi %failures, %failure : i32
    scf.yield %next, %frontier : i32, i32
  }
  %first = buffer.view %first_results[%origin] : buffer -> view<16x10xi32>
  %next = buffer.view %next_results[%origin] : buffer -> view<16x10xi32>
  view.store %split, %first[0, 0] : i32, view<16x10xi32>
  view.store %remaining, %next[0, 0] : i32, view<16x10xi32>
  %tag_origin = index.constant 640 : offset
  %tag_bytes = index.constant 64 : offset
  buffer.fill %none, %next_results[%tag_origin], %tag_bytes : i32
  %tags = buffer.view %next_results[%tag_origin] : buffer -> view<16xi32>
  view.store %c0_i32, %tags[0] : i32, view<16xi32>
  func.call @text_publish_epoch_v1(%plan, %media_plan, %c1_i32, %first_media, %next_media, %c1_i32, %c1_i32, %c0_i32, %first_results, %first_results, %next_results, %progress) : (buffer, buffer, i32, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer)
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %consumed = view.load %published[0, 0] : view<16x21xi32> -> i32
  %source = view.load %published[0, 4] : view<16x21xi32> -> i32
  %consumed_ok = scalar.cmpi eq, %consumed, %total : i32
  %source_ok = scalar.cmpi eq, %source, %expected_source : i32
  %published_ok = scalar.andi %consumed_ok, %source_ok : i1
  %failure = scf.select %published_ok, %c0_i32, %c1_i32 : i32
  %published_failures = scalar.addi %failures, %failure : i32
  // The production continuation compacts queued records in place. For small
  // first banks the destination overlaps the source, so retain the exact
  // expected records before calling it.
  %expected = buffer.alloca<private> align(4) %token_bytes : buffer
  buffer.fill %c0_i32, %expected[%origin], %token_bytes : i32
  %first_capacity_index = index.cast %first_capacity : i32 to index
  %next_capacity_index = index.cast %next_capacity : i32 to index
  %remaining_index = index.cast %remaining : i32 to index
  %record_bytes = index.constant 32 : offset
  %queued_origin = index.scale %first_capacity_index, %record_bytes : index, offset -> offset
  %queued_bytes = index.scale %remaining_index, %record_bytes : index, offset -> offset
  %active_bytes = index.scale %next_capacity_index, %record_bytes : index, offset -> offset
  buffer.copy %tokens[%queued_origin], %expected[%origin], %queued_bytes
  %context = index.constant 512 : index
  func.call @qwen38_continue_spans(%c1, %context, %next_capacity_index, %metadata, %tokens, %first_results) : (index, index, index, buffer, buffer, buffer)
  %difference = buffer.compare %tokens[%origin], %expected[%origin], %active_bytes
  %records_ok = scalar.cmpi eq, %difference, %c0_i32 : i32
  %record_failure = scf.select %records_ok, %c0_i32, %c1_i32 : i32
  %all_failures = scalar.addi %published_failures, %record_failure : i32
  func.return %all_failures : i32
}

func.def @all_mixed_splits(%grid_width: i32) -> (i32) {
  %c1 = index.constant 1 : index
  %c66 = index.constant 66 : index
  %c0_i32 = scalar.constant 0 : i32
  %failures = scf.for %split = [%c1 to %c66 step %c1](%prior = %c0_i32 : i32) -> (i32) {
    %split_word = index.cast %split : index to i32
    %current = func.call @mixed_split_observation(%split_word, %grid_width) : (i32, i32) -> (i32)
    %next = scalar.addi %prior, %current : i32
    scf.yield %next : i32
  }
  func.return %failures : i32
}

check.case public @mixed_image_frontier_across_every_epoch_split {
  %square = check.literal value(8) : i32
  %landscape = check.literal value(16) : i32
  %portrait = check.literal value(4) : i32
  %column = check.literal value(1) : i32
  %square_failures = func.call @all_mixed_splits(%square) : (i32) -> (i32)
  %landscape_failures = func.call @all_mixed_splits(%landscape) : (i32) -> (i32)
  %portrait_failures = func.call @all_mixed_splits(%portrait) : (i32) -> (i32)
  %column_failures = func.call @all_mixed_splits(%column) : (i32) -> (i32)
  %c0_i32 = check.literal value(0) : i32
  check.expect.equal actual(%square_failures) expected(%c0_i32) : i32
  check.expect.equal actual(%landscape_failures) expected(%c0_i32) : i32
  check.expect.equal actual(%portrait_failures) expected(%c0_i32) : i32
  check.expect.equal actual(%column_failures) expected(%c0_i32) : i32
  check.return
}

check.benchmark<@mixed_image_frontier_across_every_epoch_split> @mixed_image_frontier
