// Ownership updates change only read/write origins and fork positions. Event
// order differs from row order; KV origins and all unmentioned rows survive.
func.decl @text_encode_state_v1(%bindings: buffer, %count: i32, %origins: buffer)

global.rodata.def @expected_origins = bytes("")

func.def @update_origins() -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %bindings = buffer.alloca<private> align(8) %bytes : buffer
  %origins = buffer.alloca<private> align(8) %bytes : buffer
  %sentinel = scalar.constant -99 : i64
  buffer.fill %sentinel, %bindings[%origin], %bytes : i64
  buffer.fill %sentinel, %origins[%origin], %bytes : i64
  %events = buffer.view %bindings[%origin] : buffer -> view<16x4xi64>
  %last_row = scalar.constant 15 : i64
  %last_read = scalar.constant 21 : i64
  %last_write = scalar.constant 25 : i64
  %last_fork = scalar.constant 37 : i64
  %earlier_row = scalar.constant 3 : i64
  %earlier_read = scalar.constant 10 : i64
  %earlier_write = scalar.constant 12 : i64
  %earlier_fork = scalar.constant 17 : i64
  view.store %last_row, %events[0, 0] : i64, view<16x4xi64>
  view.store %last_read, %events[0, 1] : i64, view<16x4xi64>
  view.store %last_write, %events[0, 2] : i64, view<16x4xi64>
  view.store %last_fork, %events[0, 3] : i64, view<16x4xi64>
  view.store %earlier_row, %events[1, 0] : i64, view<16x4xi64>
  view.store %earlier_read, %events[1, 1] : i64, view<16x4xi64>
  view.store %earlier_write, %events[1, 2] : i64, view<16x4xi64>
  view.store %earlier_fork, %events[1, 3] : i64, view<16x4xi64>
  %count = scalar.constant 2 : i32
  func.call @text_encode_state_v1(%bindings, %count, %origins) : (buffer, i32, buffer)
  %expected = global.load @expected_origins : buffer
  %difference = buffer.compare %origins[%origin], %expected[%origin], %bytes
  func.return %difference : i32
}

check.case public @retained_origins_survive_ownership_changes {
  %difference = func.call @update_origins() : () -> (i32)
  %equal = check.literal value(0) : i32
  check.expect.equal actual(%difference) expected(%equal) : i32
  check.return
}

check.benchmark<@retained_origins_survive_ownership_changes> @ownership_changes
