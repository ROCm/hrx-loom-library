// Checkpoint resize expectations on the 32-pixel merged-patch grid. The image
// and video domains preserve independently established boundary results; they
// do not derive expected dimensions from the production resize arithmetic.
// Runtime trials share one compiled subject per policy, including benchmarks.

func.decl @qwen38_vision_geometry(%width: i32, %height: i32, %maximum_tokens: i32) -> (i32, i32)

func.decl @qwen38_video_geometry(%width: i32, %height: i32, %frames: i32) -> (i32, i32)

// Trial order: unchanged, landscape, portrait, odd dimensions, ties down/up,
// budget reduction, full budget, square reduction, single pixel, minimum
// alignment, maximum aspect ratio, and width/height ceilings.
func.def @image_geometry_trial(%trial: index) -> (i32, i32, i32, i32, i32) {
  %widths = vector.constanti [256, 320, 224, 333, 272, 304, 1024, 4096, 4096, 1, 63, 1, 4096, 49] : vector<14xi32>
  %heights = vector.constanti [256, 224, 320, 257, 256, 256, 768, 4096, 4096, 1, 1, 200, 49, 4096] : vector<14xi32>
  %budgets = vector.constanti [1024, 1024, 1024, 1024, 1024, 1024, 128, 16384, 1024, 128, 128, 128, 200, 200] : vector<14xi32>
  %expected_widths = vector.constanti [256, 320, 224, 320, 256, 320, 416, 4096, 1024, 256, 2048, 32, 4096, 32] : vector<14xi32>
  %expected_heights = vector.constanti [256, 224, 320, 256, 256, 256, 288, 4096, 1024, 256, 64, 3648, 32, 4096] : vector<14xi32>
  %width = vector.extract %widths[%trial] : vector<14xi32> -> i32
  %height = vector.extract %heights[%trial] : vector<14xi32> -> i32
  %budget = vector.extract %budgets[%trial] : vector<14xi32> -> i32
  %expected_width = vector.extract %expected_widths[%trial] : vector<14xi32> -> i32
  %expected_height = vector.extract %expected_heights[%trial] : vector<14xi32> -> i32
  func.return %width, %height, %budget, %expected_width, %expected_height : i32, i32, i32, i32, i32
}

// Trial order: tiny pair, odd tiny clip, thin landscape/portrait, unaligned
// clip, large pair, odd large clip, temporal ties below/above, and many frames.
// The frame count is the unpadded input count, including odd-tail witnesses.
func.def @video_geometry_trial(%trial: index) -> (i32, i32, i32, i32, i32) {
  %widths = vector.constanti [1, 1, 200, 1, 333, 4096, 4096, 1024, 1024, 320] : vector<10xi32>
  %heights = vector.constanti [1, 1, 1, 200, 257, 4096, 4096, 1024, 1024, 256] : vector<10xi32>
  %frame_counts = vector.constanti [2, 3, 2, 2, 3, 2, 3, 25, 27, 768] : vector<10xi32>
  %expected_widths = vector.constanti [64, 32, 6400, 32, 320, 3520, 2880, 1024, 960, 192] : vector<10xi32>
  %expected_heights = vector.constanti [64, 32, 32, 6400, 256, 3520, 2880, 1024, 960, 160] : vector<10xi32>
  %width = vector.extract %widths[%trial] : vector<10xi32> -> i32
  %height = vector.extract %heights[%trial] : vector<10xi32> -> i32
  %frames = vector.extract %frame_counts[%trial] : vector<10xi32> -> i32
  %expected_width = vector.extract %expected_widths[%trial] : vector<10xi32> -> i32
  %expected_height = vector.extract %expected_heights[%trial] : vector<10xi32> -> i32
  func.return %width, %height, %frames, %expected_width, %expected_height : i32, i32, i32, i32, i32
}

// Target and oracle share the trial ABI. Targets consume the workload; the
// oracle returns the independently recorded answer without recomputing it.
func.def @image_geometry(%width: i32, %height: i32, %budget: i32, %expected_width: i32, %expected_height: i32) -> (i32, i32) {
  %actual_width, %actual_height = func.call @qwen38_vision_geometry(%width, %height, %budget) : (i32, i32, i32) -> (i32, i32)
  func.return %actual_width, %actual_height : i32, i32
}

func.def @video_geometry(%width: i32, %height: i32, %frames: i32, %expected_width: i32, %expected_height: i32) -> (i32, i32) {
  %actual_width, %actual_height = func.call @qwen38_video_geometry(%width, %height, %frames) : (i32, i32, i32) -> (i32, i32)
  func.return %actual_width, %actual_height : i32, i32
}

func.def @expected_geometry(%width: i32, %height: i32, %budget_or_frames: i32, %expected_width: i32, %expected_height: i32) -> (i32, i32) {
  func.return %expected_width, %expected_height : i32, i32
}

check.scenario public @image_resize_boundaries {
  check.trial[14](%trial: index, %entropy: check.entropy) {
    %width, %height, %budget, %expected_width, %expected_height = check.generate<@image_geometry_trial>(%trial) : (index) -> (i32, i32, i32, i32, i32)
    check.compare<@image_geometry, @expected_geometry>(%width, %height, %budget, %expected_width, %expected_height) : (i32, i32, i32, i32, i32) -> [actual(%actual_width: i32, %actual_height: i32), expected(%oracle_width: i32, %oracle_height: i32)] {
      check.expect.equal actual(%actual_width) expected(%oracle_width) : i32
      check.expect.equal actual(%actual_height) expected(%oracle_height) : i32
    }
  }
  check.return
}

check.scenario public @video_resize_boundaries {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %width, %height, %frames, %expected_width, %expected_height = check.generate<@video_geometry_trial>(%trial) : (index) -> (i32, i32, i32, i32, i32)
    check.compare<@video_geometry, @expected_geometry>(%width, %height, %frames, %expected_width, %expected_height) : (i32, i32, i32, i32, i32) -> [actual(%actual_width: i32, %actual_height: i32), expected(%oracle_width: i32, %oracle_height: i32)] {
      check.expect.equal actual(%actual_width) expected(%oracle_width) : i32
      check.expect.equal actual(%actual_height) expected(%oracle_height) : i32
    }
  }
  check.return
}

check.benchmark<@image_resize_boundaries> @image_geometry_boundaries

check.benchmark<@video_resize_boundaries> @video_geometry_boundaries
