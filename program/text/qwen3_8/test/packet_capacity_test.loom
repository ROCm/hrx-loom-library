// Odd token budgets retain an even physical plane while every live prefix fits.
func.decl pure @qwen38.padded_tokens(%tokens: i64) -> (i64)

func.def @plane_extents(%trial: index) -> (i64, i64) {
  %inputs = vector.constanti [1, 2, 127, 128, 16385, 32768] : vector<6xi64>
  %expected = vector.constanti [2, 2, 128, 128, 16386, 32768] : vector<6xi64>
  %tokens = vector.extract %inputs[%trial] : vector<6xi64> -> i64
  %extent = vector.extract %expected[%trial] : vector<6xi64> -> i64
  %actual = func.call pure @qwen38.padded_tokens(%tokens) : (i64) -> (i64)
  func.return %actual, %extent : i64, i64
}

check.case public @token_plane_rounding {
  %trial = check.param.choice values([0, 1, 2, 3, 4, 5]) : index
  %actual, %expected = func.call @plane_extents(%trial) : (index) -> (i64, i64)
  check.expect.equal actual(%actual) expected(%expected) : i64
  check.return
}
