// Exact native bootstrap records, independent of model allocation geometry.
// Calls overwrite selected records in reverse and repeated order. Complete
// storage comparisons include untouched records and nonzero-origin guards.
// The largest allocation is a 296-byte metadata table, not model payload.

func.decl @qwen38.allocation(%records: buffer, %slot: index, %bytes: i64, %initial_zero_bytes: i64)

func.decl @qwen38.row_view(%records: buffer, %row_count: index, %row: index, %slot: index, %offset: i64, %length: i64)

// Eleven {bytes, alignment, initial_zero_bytes} records:
//   0: {0, 256, 0}; 1: {4294967303, 256, 1}; 5: {65536, 256, 65536};
//   9: {257, 256, 17}; 10: {9223372036854775807, 256, 4294967297}.
// Every word in unselected records remains -7.
global.rodata.def @allocation_expected = align(8) bytes("")

// Three residents, each with four {origin, length} views:
//   0: {0, 12}, {-7, -7}, {-7, -7}, {-7, -7};
//   1: {-7, -7}, {4294967305, 0}, {4294967313, 4096}, {-7, -7};
//   2: {64, 32}, {-7, -7}, {-7, -7}, {8589934593, 4097}.
global.rodata.def @view_expected = align(8) bytes("")

func.def @write_allocation_records(%records: buffer) {
  %first_slot = index.constant 0 : index
  %second_slot = index.constant 1 : index
  %middle_slot = index.constant 5 : index
  %replacement_slot = index.constant 9 : index
  %last_slot = index.constant 10 : index
  %c0_i64 = scalar.constant 0 : i64
  %minimum_clear = scalar.constant 1 : i64
  %partial_clear = scalar.constant 17 : i64
  %old_bytes = scalar.constant 96 : i64
  %replacement_bytes = scalar.constant 257 : i64
  %full_bytes = scalar.constant 65536 : i64
  %wide_bytes = scalar.constant 4294967303 : i64
  %wide_clear = scalar.constant 4294967297 : i64
  %maximum_bytes = scalar.constant 9223372036854775807 : i64
  func.call @qwen38.allocation(%records, %last_slot, %maximum_bytes, %wide_clear) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%records, %replacement_slot, %old_bytes, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%records, %first_slot, %c0_i64, %c0_i64) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%records, %middle_slot, %full_bytes, %full_bytes) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%records, %second_slot, %wide_bytes, %minimum_clear) : (buffer, index, i64, i64)
  func.call @qwen38.allocation(%records, %replacement_slot, %replacement_bytes, %partial_clear) : (buffer, index, i64, i64)
  func.return
}

func.def @expected_allocation_records(%records: buffer) {
  %source = global.load @allocation_expected : buffer
  %origin = index.constant 0 : offset
  %length = index.constant 264 : offset
  buffer.copy %source[%origin], %records[%origin], %length
  func.return
}

func.def @write_row_views(%records: buffer) {
  %rows = index.constant 3 : index
  %first_row = index.constant 0 : index
  %middle_row = index.constant 1 : index
  %last_row = index.constant 2 : index
  %control_slot = index.constant 0 : index
  %attention_slot = index.constant 1 : index
  %input_slot = index.constant 2 : index
  %progress_slot = index.constant 3 : index
  %c0_i64 = scalar.constant 0 : i64
  %control_bytes = scalar.constant 12 : i64
  %other_control_bytes = scalar.constant 32 : i64
  %other_control_origin = scalar.constant 64 : i64
  %old_input_origin = scalar.constant 2048 : i64
  %old_input_bytes = scalar.constant 2048 : i64
  %input_bytes = scalar.constant 4096 : i64
  %progress_bytes = scalar.constant 4097 : i64
  %attention_origin = scalar.constant 4294967305 : i64
  %input_origin = scalar.constant 4294967313 : i64
  %progress_origin = scalar.constant 8589934593 : i64
  func.call @qwen38.row_view(%records, %rows, %last_row, %progress_slot, %progress_origin, %progress_bytes) : (buffer, index, index, index, i64, i64)
  func.call @qwen38.row_view(%records, %rows, %middle_row, %input_slot, %old_input_origin, %old_input_bytes) : (buffer, index, index, index, i64, i64)
  func.call @qwen38.row_view(%records, %rows, %first_row, %control_slot, %c0_i64, %control_bytes) : (buffer, index, index, index, i64, i64)
  func.call @qwen38.row_view(%records, %rows, %middle_row, %attention_slot, %attention_origin, %c0_i64) : (buffer, index, index, index, i64, i64)
  func.call @qwen38.row_view(%records, %rows, %last_row, %control_slot, %other_control_origin, %other_control_bytes) : (buffer, index, index, index, i64, i64)
  func.call @qwen38.row_view(%records, %rows, %middle_row, %input_slot, %input_origin, %input_bytes) : (buffer, index, index, index, i64, i64)
  func.return
}

func.def @expected_row_views(%records: buffer) {
  %source = global.load @view_expected : buffer
  %origin = index.constant 0 : offset
  %length = index.constant 192 : offset
  buffer.copy %source[%origin], %records[%origin], %length
  func.return
}

check.scenario public @allocation_record_fields {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-7) : tensor<37xi64>
    %records = check.tensor.view %storage offset(16) : tensor<37xi64> -> tensor<33xi64>
    check.compare<@write_allocation_records, @expected_allocation_records>(%records) : (tensor<33xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<37xi64>
    }
  }
  check.return
}

check.scenario public @resident_view_records {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-7) : tensor<28xi64>
    %records = check.tensor.view %storage offset(24) : tensor<28xi64> -> tensor<24xi64>
    check.compare<@write_row_views, @expected_row_views>(%records) : (tensor<24xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<28xi64>
    }
  }
  check.return
}

// The guarded scenarios compare caller-owned subviews. VM case benchmarks
// measure the host program, including its small descriptor allocation.
func.def @allocation_table_order() -> (i32) {
  %origin = index.constant 0 : offset
  %length = index.constant 264 : offset
  %records = buffer.alloca<private> align(8) %length : buffer
  %sentinel = scalar.constant -7 : i64
  buffer.fill %sentinel, %records[%origin], %length : i64
  func.call @write_allocation_records(%records) : (buffer)
  %expected = global.load @allocation_expected : buffer
  %order = buffer.compare %records[%origin], %expected[%origin], %length
  func.return %order : i32
}

func.def @row_view_table_order() -> (i32) {
  %origin = index.constant 0 : offset
  %length = index.constant 192 : offset
  %records = buffer.alloca<private> align(8) %length : buffer
  %sentinel = scalar.constant -7 : i64
  buffer.fill %sentinel, %records[%origin], %length : i64
  func.call @write_row_views(%records) : (buffer)
  %expected = global.load @view_expected : buffer
  %order = buffer.compare %records[%origin], %expected[%origin], %length
  func.return %order : i32
}

check.case public @allocation_record_table {
  %order = func.call @allocation_table_order() : () -> (i32)
  %equal = check.literal value(0) : i32
  check.expect.equal actual(%order) expected(%equal) : i32
  check.return
}

check.case public @resident_view_table {
  %order = func.call @row_view_table_order() : () -> (i32)
  %equal = check.literal value(0) : i32
  check.expect.equal actual(%order) expected(%equal) : i32
  check.return
}

check.benchmark<@allocation_record_table> @write_allocation_descriptors

check.benchmark<@resident_view_table> @write_resident_views
