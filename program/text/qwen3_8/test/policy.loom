// Request policies belong to resident sessions. An epoch gathers only its
// participants, and compacted continuations keep the original policy owners.

func.decl @text_bind_request_v1(%state: buffer, %row: i32, %options: buffer)

func.decl @qwen38.control_create(%packet_capacity: i64, %context: i64, %pool: i64, %rows: i64, %pins: i64, %packed: i1, %enabled: i1, %dflash: i1) -> (buffer)

func.decl @text_encode_epoch_v1(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64)

func.decl @qwen38_continue_spans(%mixed_inputs: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

func.def @sampling_policy_ownership(%count_value: index) -> (i1) {
  %count = index.assume %count_value [range(%count_value, 4, 1025)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %following = index.sub %count, %c1 : index
  %c6 = index.constant 6 : index
  %padding = index.constant 3 : index
  %padded = index.add %count, %padding : index
  %half = index.div %padded, %c2 : index
  %capacity = index.mul %half, %c2 : index
  %twice = index.mul %count, %c2 : index
  %resident_count = index.add %twice, %c1 : index
  %plan_count = index.add %count, %following : index
  %c4 = index.assume %count [le(%count, %capacity), le(%count, %plan_count)] : index
  %c3 = index.assume %following [ge(%following, 0), le(%following, %capacity)] : index
  %origin = index.constant 0 : offset
  %policy_stride = index.constant 24 : offset
  %policy_bytes = index.scale %resident_count, %policy_stride : index, offset -> offset
  %packet_capacity = index.cast %capacity : index to i64
  %rows = index.cast %resident_count : index to i64
  %context_capacity = scalar.constant 256 : i64
  %pool_capacity = scalar.constant 4096 : i64
  %pins = scalar.constant 0 : i64
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %state = func.call @qwen38.control_create(%packet_capacity, %context_capacity, %pool_capacity, %rows, %pins, %true, %true, %false) : (i64, i64, i64, i64, i64, i1, i1, i1) -> (buffer)
  %options = buffer.alloca<private> align(8) %policy_stride : buffer
  %plan_stride = index.constant 36 : offset
  %plan_bytes = index.scale %plan_count, %plan_stride : index, offset -> offset
  %packet_stride = index.constant 112 : offset
  %packet_header = index.constant 40 : offset
  %packet_payload = index.scale %capacity, %packet_stride : index, offset -> offset
  %metadata_bytes = index.add %packet_header, %packet_payload : offset
  %input_stride = index.constant 8 : offset
  %input_bytes = index.scale %capacity, %input_stride : index, offset -> offset
  %result_stride = index.constant 84 : offset
  %result_bytes = index.scale %capacity, %result_stride : index, offset -> offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %metadata = buffer.alloca<private> align(8) %metadata_bytes : buffer
  %inputs = buffer.alloca<private> align(4) %input_bytes : buffer
  %tokens = buffer.alloca<private> align(4) %input_bytes : buffer
  %results = buffer.alloca<private> align(4) %result_bytes : buffer
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c3_i32 = index.cast %c3 : index to i32
  %c4_i32 = index.cast %c4 : index to i32
  %c7_i32 = index.cast %plan_count : index to i32
  %sentinel = scalar.constant -99 : i32
  buffer.fill %c0_i32, %plan[%origin], %plan_bytes : i32
  buffer.fill %sentinel, %metadata[%origin], %metadata_bytes : i32
  buffer.fill %c0_i32, %inputs[%origin], %input_bytes : i32
  buffer.fill %c0_i32, %tokens[%origin], %input_bytes : i32
  buffer.fill %c0_i32, %results[%origin], %result_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_count]x9xi32>
  %policy = buffer.view %options[%origin] : buffer -> view<6xi32>
  %prior = buffer.view %results[%origin] : buffer -> view<[%capacity]x10xi32>
  %last = index.sub %resident_count, %c1 : index
  scf.for %i = [%c0 to %c4 step %c1] {
    %resident = index.sub %last, %i : index
    %row = index.cast %resident : index to i32
    scf.for %field = [%c0 to %c6 step %c1] {
      %word = index.cast %field : index to i32
      %value = scalar.addi %row, %word : i32
      view.store %value, %policy[%field] : i32, view<6xi32>
    }
    func.call @text_bind_request_v1(%state, %row, %options) : (buffer, i32, buffer)
    %input = index.cast %i : index to i32
    view.store %c1_i32, %requests[%i, 0] : i32, view<[%plan_count]x9xi32>
    view.store %row, %requests[%i, 3] : i32, view<[%plan_count]x9xi32>
    view.store %input, %requests[%i, 4] : i32, view<[%plan_count]x9xi32>
    view.store %c1_i32, %requests[%i, 5] : i32, view<[%plan_count]x9xi32>
    view.store %c1_i32, %requests[%i, 6] : i32, view<[%plan_count]x9xi32>
    view.store %input, %requests[%i, 8] : i32, view<[%plan_count]x9xi32>
    view.store %c1_i32, %prior[%i, 0] : i32, view<[%capacity]x10xi32>
    view.store %c1_i32, %prior[%i, 1] : i32, view<[%capacity]x10xi32>
  }
  // Reverse the cohort and omit its first participant.
  scf.for %i = [%c0 to %c3 step %c1] {
    %owner = index.sub %c3, %i : index
    %resident = index.sub %last, %owner : index
    %row = index.cast %resident : index to i32
    %owner_word = index.cast %owner : index to i32
    %record_value = index.add %c4, %i : index
    %record = index.assume %record_value [ge(%record_value, 0), lt(%record_value, %plan_count)] : index
    %input = index.cast %record : index to i32
    view.store %c1_i32, %requests[%record, 0] : i32, view<[%plan_count]x9xi32>
    view.store %row, %requests[%record, 3] : i32, view<[%plan_count]x9xi32>
    view.store %input, %requests[%record, 4] : i32, view<[%plan_count]x9xi32>
    view.store %c1_i32, %requests[%record, 5] : i32, view<[%plan_count]x9xi32>
    view.store %c1_i32, %requests[%record, 6] : i32, view<[%plan_count]x9xi32>
    view.store %owner_word, %requests[%record, 8] : i32, view<[%plan_count]x9xi32>
  }
  %outputs, %transfers, %begin, %length = func.call @text_encode_epoch_v1(%state, %plan, %inputs, %inputs, %c4_i32, %c3_i32, %c7_i32, %c0_i32, %c0_i32, %c0_i32, %c0_i32, %sentinel, %metadata, %tokens) : (buffer, buffer, buffer, buffer, i32, i32, i32, i32, i32, i32, i32, i32, buffer, buffer) -> (i32, buffer, i64, i64)
  %tail_header = index.constant 32 : offset
  %policy_scale = index.constant 76 : offset
  %policy_relative = index.scale %capacity, %policy_scale : index, offset -> offset
  %policy_origin = index.add %tail_header, %policy_relative : offset
  %identity_scale = index.constant 100 : offset
  %identity_relative = index.scale %capacity, %identity_scale : index, offset -> offset
  %identity_origin = index.add %tail_header, %identity_relative : offset
  %policies = buffer.view %metadata[%policy_origin] : buffer -> view<[%capacity]x6xi32>
  %identities = buffer.view %metadata[%identity_origin] : buffer -> view<[%capacity]x2xi32>
  %output_count_matches = scalar.cmpi eq, %outputs, %c4_i32 : i32
  %policies_match = scf.for %i = [%c0 to %capacity step %c1](%equal = %output_count_matches : i1) -> (i1) {
    %active = index.cmp ult, %i, %c4 : index
    %resident = index.sub %last, %i : index
    %row = index.cast %resident : index to i32
    %same = scf.for %field = [%c0 to %c6 step %c1](%fields_match = %equal : i1) -> (i1) {
      %word = index.cast %field : index to i32
      %value = scalar.addi %row, %word : i32
      %expected = scf.select %active, %value, %sentinel : i32
      %actual = view.load %policies[%i, %field] : view<[%capacity]x6xi32> -> i32
      %match = scalar.cmpi eq, %actual, %expected : i32
      %same = scalar.andi %fields_match, %match : i1
      scf.yield %same : i1
    }
    scf.yield %same : i1
  }
  %first_matches = scf.for %i = [%c0 to %c4 step %c1](%equal = %policies_match : i1) -> (i1) {
    %expected = index.cast %i : index to i32
    %owner = view.load %identities[%i, 0] : view<[%capacity]x2xi32> -> i32
    %match = scalar.cmpi eq, %owner, %expected : i32
    %same = scalar.andi %equal, %match : i1
    scf.yield %same : i1
  }
  // The upload table follows the stage header, policies, and 64-byte recipe.
  %table_prefix = index.constant 104 : offset
  %table_origin = index.add %table_prefix, %policy_bytes : offset
  %expected_begin = index.cast %table_origin : offset to i64
  %expected_length = scalar.constant 560 : i64
  %begin_matches = scalar.cmpi eq, %begin, %expected_begin : i64
  %length_matches = scalar.cmpi eq, %length, %expected_length : i64
  %table = buffer.view %transfers[%table_origin] : buffer -> view<14x5xi64>
  %policy_transfer_bytes = view.load %table[9, 4] : view<14x5xi64> -> i64
  %live_policy_bytes = index.scale %count, %policy_stride : index, offset -> offset
  %expected_policy_bytes = index.cast %live_policy_bytes : offset to i64
  %transfer_matches = scalar.cmpi eq, %policy_transfer_bytes, %expected_policy_bytes : i64
  %range_matches = scalar.andi %begin_matches, %length_matches : i1
  %all_transfers_match = scalar.andi %range_matches, %transfer_matches : i1
  %encoded = scalar.andi %first_matches, %all_transfers_match : i1
  %context = index.constant 256 : index
  func.call @qwen38_continue_spans(%c0, %context, %capacity, %metadata, %tokens, %results) : (index, index, index, buffer, buffer, buffer)
  %continued = scf.for %i = [%c0 to %c3 step %c1](%equal = %encoded : i1) -> (i1) {
    %expected_index = index.sub %c3, %i : index
    %expected = index.cast %expected_index : index to i32
    %owner = view.load %identities[%i, 0] : view<[%capacity]x2xi32> -> i32
    %match = scalar.cmpi eq, %owner, %expected : i32
    %same = scalar.andi %equal, %match : i1
    scf.yield %same : i1
  }
  func.return %continued : i1
}

check.case public @sampling_follows_cohort_ownership {
  %residents = check.param.choice values([4, 17, 33, 65, 129, 1025]) : index
  %actual = func.call @sampling_policy_ownership(%residents) : (index) -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

check.benchmark<@sampling_follows_cohort_ownership> @sampling_policy_compaction
