// Qwen3.8 geometry-specific image/frame-pair projector stage declarations.
//
// Both cold preparation and request cohorts provide selected pixel height,
// width, a compatible group count, and one or two temporal planes.
// The prepare host owns the returned stage
// identifier, compilation, executable reuse, and checkpoint residency. This
// provider binds those dimensions to the model projector command root.
//

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

global.rodata.def @vision_root = bytes("7177656e33385f766973696f6e5f70726f6a6563746f72")

global.rodata.def @vision_height_key = bytes("7177656e33382e766973696f6e2e696d6167655f686569676874")

global.rodata.def @vision_width_key = bytes("7177656e33382e766973696f6e2e696d6167655f7769647468")

global.rodata.def @vision_count_key = bytes("7177656e33382e766973696f6e2e67726f75705f636f756e74")

global.rodata.def @vision_planes_key = bytes("7177656e33382e766973696f6e2e706c616e655f636f756e74")

// Cold preparation and request cohorts share one declaration contract. Native
// serving owns compilation, bounded executable reuse, and checkpoint residency.
func.def public @qwen38_vision_stage(%height: i64, %width: i64, %count: i64, %planes: i64) -> (i32) {
  %root = global.load @vision_root : buffer
  %stage = func.call @stage(%root, %count) : (buffer, i64) -> (i32)
  %height_key = global.load @vision_height_key : buffer
  %width_key = global.load @vision_width_key : buffer
  %count_key = global.load @vision_count_key : buffer
  func.call @config_i64(%stage, %height_key, %height) : (i32, buffer, i64)
  func.call @config_i64(%stage, %width_key, %width) : (i32, buffer, i64)
  func.call @config_i64(%stage, %count_key, %count) : (i32, buffer, i64)
  %planes_key = global.load @vision_planes_key : buffer
  func.call @config_i64(%stage, %planes_key, %planes) : (i32, buffer, i64)
  func.return %stage : i32
}
