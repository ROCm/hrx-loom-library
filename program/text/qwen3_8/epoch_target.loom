// Target computation sits after proposal and before feedback/predictor catch-up.
// The returned frontier covers target outputs and accepted-state publication.
// The source composition supplies exactly one provider of this family.

type.decl import("hal", "buffer") @HalBuffer

// Preparation resolves target, proposal, catch-up, verifier, and continuation.
template.decl @qwen38.epoch.stages(%state: buffer, %mixed: i1, %token_count: i32, %span_count: i32) -> (i32, i32, i32, i32, i32)

template.decl @qwen38.epoch.target(%control_state: buffer, %verify: i1, %mixed: i1, %target_stage: i32, %verify_stage: i32, %residual: ptr<@HalBuffer>, %metadata: ptr<@HalBuffer>, %origins: ptr<@HalBuffer>, %state: ptr<@HalBuffer>, %tokens: ptr<@HalBuffer>, %outputs: ptr<@HalBuffer>, %committed: ptr<@HalBuffer>, %results: ptr<@HalBuffer>) -> (i64)

// The model chooses how known-only cohorts publish their results. Submission
// and publication select the same format from the immutable prepared state.
template.decl @qwen38.epoch.feedback_bank(%state: buffer, %requested: i32) -> (i1)

template.def<@qwen38.epoch.feedback_bank> priority(-1) @requested_feedback_bank(%state: buffer, %requested: i32) -> (i1) {
  %c0_i32 = scalar.constant 0 : i32
  %banked = scalar.cmpi ne, %requested, %c0_i32 : i32
  template.return %banked : i1
}
