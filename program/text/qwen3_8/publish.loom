// Qwen3.8 text-service v1 completed-epoch publication.
// The caller joins work and feedback completion before entering this transform.
// Immutable result banks hold accepted tokens and actual proposal counts;
// continuation tags map compacted owners back to the first host cohort.
// Publication writes caller-owned progress/count arrays and submits no work.

func.decl @qwen38_feedback_records_origin() -> (offset)

func.decl @qwen38_feedback_bank_bytes(%capacity: index) -> (offset)

func.decl @qwen38_feedback_outputs(%counts: i32) -> (i32)

func.decl @qwen38_feedback_proposals(%counts: i32) -> (i32)

func.decl @publish_media_positions(%plan: buffer, %media_plan: buffer, %count: index, %progress: buffer)

// Semantic progress is {consumed, known, outputs, verifications,
// source_position, tokens[16]}. Only completed feedback enters this transform;
// bank contents are immutable. Actual candidate counts are published separately,
// indexed by the same first-cohort ordinal, including compacted continuations.
func.def public @text_publish_epoch_v1(%control_state: buffer, %plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %continuation_flags: buffer, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer, %proposal_counts: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %extent = index.cast %count : i32 to index
  %continuations = buffer.view %continuation_flags[%origin] : buffer -> view<[%extent]xi32>
  %progress_bytes = buffer.length %progress
  buffer.fill %zero32, %progress[%origin], %progress_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<[%extent]x9xi32>
  %proposals = buffer.view %proposal_counts[%origin] : buffer -> view<[%extent]xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<[%extent]x21xi32>
  %verifies = scalar.cmpi ne, %verified, %zero32 : i32
  %outputs = scf.for %i = [%c0 to %extent step %c1](%ordinary_index = %c0 : index) -> (index) {
    %consumed, %known, %output_count, %verifications, %proposed = scf.if %verifies -> (i32, i32, i32, i32, i32) {
      %result_origin = func.call @qwen38_feedback_records_origin() : () -> (offset)
      %records = buffer.view %first_results[%result_origin] : buffer -> view<[%extent]x10xi32>
      %consumed = view.load %records[%i, 0] : view<[%extent]x10xi32> -> i32
      %counts = view.load %records[%i, 1] : view<[%extent]x10xi32> -> i32
      %output_count = func.call @qwen38_feedback_outputs(%counts) : (i32) -> (i32)
      %proposed = func.call @qwen38_feedback_proposals(%counts) : (i32) -> (i32)
      %credit = view.load %requests[%i, 7] : view<[%extent]x9xi32> -> i32
      %speculative = scalar.cmpi ne, %credit, %zero32 : i32
      %verifications = scalar.extui %speculative : i1 to i32
      %known = scf.select %speculative, %zero32, %consumed : i32
      %bounded_outputs = scalar.assume %output_count [range(%output_count, 0, 8)] : i32
      %output_extent = index.cast %bounded_outputs : i32 to index
      scf.for %j = [%c0 to %output_extent step %c1] {
        %source = index.add %j, %c2 : index
        %target_value = index.add %j, %c4 : index
        %target = index.add %target_value, %c1 : index
        %token = view.load %records[%i, %source] : view<[%extent]x10xi32> -> i32
        view.store %token, %published[%i, %target] : i32, view<[%extent]x21xi32>
      }
      scf.yield %consumed, %known, %output_count, %verifications, %proposed : i32, i32, i32, i32, i32
    } else {
      %length = view.load %requests[%i, 0] : view<[%extent]x9xi32> -> i32
      %flags = view.load %requests[%i, 6] : view<[%extent]x9xi32> -> i32
      %selected_bits = scalar.andi %flags, %one32 : i32
      %selected = scalar.cmpi ne, %selected_bits, %zero32 : i32
      %selected_count = scalar.extui %selected : i1 to i32
      scf.if %selected {
        %tokens = buffer.view %ordinary[%origin] : buffer -> view<[%extent]xi32>
        %slot = index.assume %ordinary_index [range(%ordinary_index, 0, 2147483647), lt(%ordinary_index, %extent)] : index
        %token = view.load %tokens[%slot] : view<[%extent]xi32> -> i32
        view.store %token, %published[%i, 5] : i32, view<[%extent]x21xi32>
      }
      scf.yield %length, %length, %selected_count, %zero32, %zero32 : i32, i32, i32, i32, i32
    }
    view.store %proposed, %proposals[%i] : i32, view<[%extent]xi32>
    view.store %consumed, %published[%i, 0] : i32, view<[%extent]x21xi32>
    view.store %known, %published[%i, 1] : i32, view<[%extent]x21xi32>
    view.store %output_count, %published[%i, 2] : i32, view<[%extent]x21xi32>
    view.store %verifications, %published[%i, 3] : i32, view<[%extent]x21xi32>
    %source_position = view.load %requests[%i, 2] : view<[%extent]x9xi32> -> i32
    %next_source_position = scalar.addi %source_position, %consumed : i32
    view.store %next_source_position, %published[%i, 4] : i32, view<[%extent]x21xi32>
    %advance = index.cast %output_count : i32 to index
    %next_index = index.add %ordinary_index, %advance : index
    scf.yield %next_index : index
  }
  %has_next = scalar.cmpi ne, %continues, %zero32 : i32
  scf.if %has_next {
    %result_origin = func.call @qwen38_feedback_records_origin() : () -> (offset)
    %count_origin = index.constant 28 : offset
    %count_view = buffer.view %next_results[%count_origin] : buffer -> view<1xi32>
    %next_count_word = view.load %count_view[0] : view<1xi32> -> i32
    %next_count_value = index.cast %next_count_word : i32 to index
    %next_count = index.assume %next_count_value [range(%next_count_value, 0, %extent)] : index
    %records = buffer.view %next_results[%result_origin] : buffer -> view<[%next_count]x10xi32>
    %tags_origin = func.call @qwen38_feedback_bank_bytes(%next_count) : (index) -> (offset)
    %tags = buffer.view %next_results[%tags_origin] : buffer -> view<[%next_count]xi32>
    scf.for %i = [%c0 to %next_count step %c1] {
      %tag = view.load %tags[%i] : view<[%next_count]xi32> -> i32
      %first_value = index.cast %tag : i32 to index
      %first = index.assume %first_value [range(%first_value, 0, 2147483647), lt(%first_value, %extent)] : index
      %consumed = view.load %records[%i, 0] : view<[%next_count]x10xi32> -> i32
      %counts = view.load %records[%i, 1] : view<[%next_count]x10xi32> -> i32
      %output_count = func.call @qwen38_feedback_outputs(%counts) : (i32) -> (i32)
      %proposed = func.call @qwen38_feedback_proposals(%counts) : (i32) -> (i32)
      %prior_proposed = view.load %proposals[%first] : view<[%extent]xi32> -> i32
      %total_proposed = scalar.addi %prior_proposed, %proposed : i32
      view.store %total_proposed, %proposals[%first] : i32, view<[%extent]xi32>
      %prior_consumed = view.load %published[%first, 0] : view<[%extent]x21xi32> -> i32
      %prior_known = view.load %published[%first, 1] : view<[%extent]x21xi32> -> i32
      %prior_outputs = view.load %published[%first, 2] : view<[%extent]x21xi32> -> i32
      %prior_verifications = view.load %published[%first, 3] : view<[%extent]x21xi32> -> i32
      %prior_source_position = view.load %published[%first, 4] : view<[%extent]x21xi32> -> i32
      %bits = view.load %continuations[%first] : view<[%extent]xi32> -> i32
      %speculative = scalar.cmpi ne, %bits, %zero32 : i32
      %known = scf.select %speculative, %zero32, %consumed : i32
      %verification = scalar.extui %speculative : i1 to i32
      %total_consumed = scalar.addi %prior_consumed, %consumed : i32
      %total_known = scalar.addi %prior_known, %known : i32
      %total_outputs = scalar.addi %prior_outputs, %output_count : i32
      %total_verifications = scalar.addi %prior_verifications, %verification : i32
      %next_source_position = scalar.addi %prior_source_position, %consumed : i32
      view.store %total_consumed, %published[%first, 0] : i32, view<[%extent]x21xi32>
      view.store %total_known, %published[%first, 1] : i32, view<[%extent]x21xi32>
      view.store %total_outputs, %published[%first, 2] : i32, view<[%extent]x21xi32>
      view.store %total_verifications, %published[%first, 3] : i32, view<[%extent]x21xi32>
      view.store %next_source_position, %published[%first, 4] : i32, view<[%extent]x21xi32>
      %bounded_outputs = scalar.assume %output_count [range(%output_count, 0, 8)] : i32
      %output_extent = index.cast %bounded_outputs : i32 to index
      %prior_extent = index.cast %prior_outputs : i32 to index
      scf.for %j = [%c0 to %output_extent step %c1] {
        %source = index.add %j, %c2 : index
        %token_index = index.add %prior_extent, %j : index
        %target_base = index.add %token_index, %c4 : index
        %target_value = index.add %target_base, %c1 : index
        %target = index.assume %target_value [range(%target_value, 5, 20)] : index
        %token = view.load %records[%i, %source] : view<[%next_count]x10xi32> -> i32
        view.store %token, %published[%first, %target] : i32, view<[%extent]x21xi32>
      }
    }
  }
  %published_next_media = scf.select %has_next, %next_media_count, %zero32 : i32
  %media_count = scalar.addi %first_media_count, %published_next_media : i32
  %mixed = scalar.cmpi ne, %media_count, %zero32 : i32
  scf.if %mixed {
    %media_extent = index.cast %media_count : i32 to index
    func.call @publish_media_positions(%plan, %media_plan, %media_extent, %progress) : (buffer, buffer, index, buffer)
  }
  func.return
}
