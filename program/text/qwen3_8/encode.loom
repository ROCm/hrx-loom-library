// Qwen3.8 text input encoding and exact upload planning.
// The host supplies validated ownership events and first/continuation plans.
// Retained control, metadata, and token buffers belong to model preparation.
// Encoding mutates these host buffers before submission, allocates nothing,
// and returns borrowed upload descriptors valid until queued transfers retire.
// This unit never calls the runner or observes incomplete device feedback.

func.decl pure @qwen38.transfer_bytes() -> (offset)

func.decl @qwen38_packet_capacity(%bytes: offset) -> (index)

func.decl @qwen38_packet_selection_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_options_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_eos_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_bank_bytes(%capacity: index) -> (offset)

func.decl @qwen38_packet_indices_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_policy_origin(%capacity: index) -> (offset)

func.decl @qwen38_packet_identity_origin(%capacity: index) -> (offset)

func.decl @qwen38.speculation_choose(%state: buffer, %plan: buffer, %first_count: i32, %next_count: i32, %media_count: i32) -> (i32, i32)

func.decl @encode_media_plan(%plan: buffer, %inputs: buffer, %media_plan: buffer, %media_begin: index, %media_end: index, %count: index, %first: index, %metadata: buffer, %metadata_origin: offset, %tokens: buffer)

// Ownership events provide {row, read_origin, write_origin, fork_position}.
// The retained payload is source-owned; KV origins and unchanged rows survive.
func.def public @text_encode_state_v2(%bindings: buffer, %count: i32, %origins: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %length = index.cast %count : i32 to index
  %origin_bytes = buffer.length %origins
  %origin_length = index.cast %origin_bytes : offset to index
  %record_length = index.constant 40 : index
  %capacity = index.div %origin_length, %record_length : index
  %records = buffer.view %bindings[%origin] : buffer -> view<[%length]x4xi64>
  %rows = buffer.view %origins[%origin] : buffer -> view<[%capacity]x5xi64>
  scf.for %i = [%c0 to %length step %c1] {
    %row_word = view.load %records[%i, 0] : view<[%length]x4xi64> -> i64
    %row_value = index.cast %row_word : i64 to index
    %row = index.assume %row_value [range(%row_value, 0, 2147483647), lt(%row_value, %capacity)] : index
    %read = view.load %records[%i, 1] : view<[%length]x4xi64> -> i64
    %write = view.load %records[%i, 2] : view<[%length]x4xi64> -> i64
    %position = view.load %records[%i, 3] : view<[%length]x4xi64> -> i64
    view.store %read, %rows[%row, 0] : i64, view<[%capacity]x5xi64>
    view.store %write, %rows[%row, 1] : i64, view<[%capacity]x5xi64>
    view.store %position, %rows[%row, 3] : i64, view<[%capacity]x5xi64>
  }
  func.return
}

// Host plans carry {length, position, source_position, row, input_begin,
// input_count, flags, output_credit, first_span}. Flags are SELECT=1 and
// PROPOSE=2. The second plan follows the first cohort; known IDs form one
// contiguous host stream. Six-word descriptors preserve source position and
// selected output independently; neither field steals bits from the other.
func.def @encode_plan(%plan: buffer, %inputs: buffer, %count: index, %first: index, %metadata: buffer, %metadata_origin: offset, %tokens: buffer, %token_origin: offset, %record_origin: i32, %ordinary: i1, %target_width: i32, %neural_width: i32) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : offset
  %descriptor_base = index.constant 12 : offset
  %metadata_bytes = buffer.length %metadata
  %capacity = func.call @qwen38_packet_capacity(%metadata_bytes) : (offset) -> (index)
  %selection_base = func.call @qwen38_packet_selection_origin(%capacity) : (index) -> (offset)
  %options_base = func.call @qwen38_packet_options_origin(%capacity) : (index) -> (offset)
  %descriptor_origin = index.add %metadata_origin, %descriptor_base : offset
  %selection_origin = index.add %metadata_origin, %selection_base : offset
  %options_origin = index.add %metadata_origin, %options_base : offset
  %plan_bytes = buffer.length %plan
  %plan_length = index.cast %plan_bytes : offset to index
  %plan_stride = index.constant 36 : index
  %plan_capacity = index.div %plan_length, %plan_stride : index
  %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_capacity]x9xi32>
  %descriptors = buffer.view %metadata[%descriptor_origin] : buffer -> view<[%capacity]x6xi32>
  %selections = buffer.view %metadata[%selection_origin] : buffer -> view<[%capacity]xi32>
  %options = buffer.view %metadata[%options_origin] : buffer -> view<[%capacity]x2xi32>
  %identity_origin = func.call @qwen38_packet_identity_origin(%capacity) : (index) -> (offset)
  %identities = buffer.view %metadata[%identity_origin] : buffer -> view<[%capacity]x2xi32>
  %primary = index.cmp eq, %metadata_origin, %origin : offset
  %span_count = index.assume %count [range(%count, 1, %capacity)] : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %absent = scalar.constant -1 : i32
  %token_count, %output_count = scf.for %i = [%c0 to %span_count step %c1](%cursor = %zero32 : i32, %outputs = %zero32 : i32) -> (i32, i32) {
    %record_value = index.add %first, %i : index
    %record = index.assume %record_value [ge(%record_value, 0), lt(%record_value, %plan_capacity)] : index
    %reserved_length = view.load %requests[%record, 0] : view<[%plan_capacity]x9xi32> -> i32
    %position = view.load %requests[%record, 1] : view<[%plan_capacity]x9xi32> -> i32
    %source_position = view.load %requests[%record, 2] : view<[%plan_capacity]x9xi32> -> i32
    %row = view.load %requests[%record, 3] : view<[%plan_capacity]x9xi32> -> i32
    %input_begin = view.load %requests[%record, 4] : view<[%plan_capacity]x9xi32> -> i32
    %input_count = view.load %requests[%record, 5] : view<[%plan_capacity]x9xi32> -> i32
    %flags = view.load %requests[%record, 6] : view<[%plan_capacity]x9xi32> -> i32
    %credit = view.load %requests[%record, 7] : view<[%plan_capacity]x9xi32> -> i32
    %select_bits = scalar.andi %flags, %one32 : i32
    %selected = scalar.cmpi ne, %select_bits, %zero32 : i32
    %propose_bits = scalar.andi %flags, %two32 : i32
    %proposes = scalar.cmpi ne, %propose_bits, %zero32 : i32
    %chosen = scalar.cmpi ne, %target_width, %zero32 : i32
    %shortened = scalar.andi %chosen, %proposes : i1
    %length = scf.select %shortened, %target_width, %reserved_length : i32
    %speculative = scalar.cmpi ne, %credit, %zero32 : i32
    %speculative32 = scalar.extui %speculative : i1 to i32
    %limited = scalar.cmpi ne, %neural_width, %zero32 : i32
    %draft_width = scf.select %limited, %neural_width, %reserved_length : i32
    %mode = scf.select %proposes, %draft_width, %speculative32 : i32
    %selection = scf.select %selected, %outputs, %absent : i32
    view.store %length, %descriptors[%i, 0] : i32, view<[%capacity]x6xi32>
    view.store %position, %descriptors[%i, 1] : i32, view<[%capacity]x6xi32>
    %record_begin = scalar.addi %record_origin, %cursor : i32
    view.store %record_begin, %descriptors[%i, 2] : i32, view<[%capacity]x6xi32>
    view.store %row, %descriptors[%i, 3] : i32, view<[%capacity]x6xi32>
    view.store %source_position, %descriptors[%i, 4] : i32, view<[%capacity]x6xi32>
    view.store %selection, %descriptors[%i, 5] : i32, view<[%capacity]x6xi32>
    view.store %mode, %options[%i, 0] : i32, view<[%capacity]x2xi32>
    view.store %credit, %options[%i, 1] : i32, view<[%capacity]x2xi32>
    %input_index = index.cast %input_begin : i32 to index
    %input_extent = index.cast %input_count : i32 to index
    %cursor_index = index.cast %cursor : i32 to index
    %source_offset = index.scale %input_index, %c4 : index, offset -> offset
    %input_bytes = index.scale %input_extent, %c4 : index, offset -> offset
    %cursor_bytes = index.scale %cursor_index, %c4 : index, offset -> offset
    %target_offset = index.add %token_origin, %cursor_bytes : offset
    scf.if %ordinary {
      buffer.copy %inputs[%source_offset], %tokens[%target_offset], %input_bytes
      // Speculative placeholders are live; unused packet capacity is not.
      %unknown_count = scalar.subi %length, %input_count : i32
      %unknown = index.cast %unknown_count : i32 to index
      %unknown_bytes = index.scale %unknown, %c4 : index, offset -> offset
      %unknown_begin = index.add %target_offset, %input_bytes : offset
      buffer.fill %zero32, %tokens[%unknown_begin], %unknown_bytes : i32
    }
    %end = scalar.addi %cursor, %length : i32
    %selected_count = scf.select %speculative, %length, %one32 : i32
    %active_selections = scf.select %selected, %selected_count, %zero32 : i32
    %bounded_selections = scalar.assume %active_selections [range(%active_selections, 0, 16)] : i32
    %selection_count = index.cast %bounded_selections : i32 to index
    %selection_first = scalar.subi %end, %active_selections : i32
    scf.for %j = [%c0 to %selection_count step %c1] {
      %j32 = index.cast %j : index to i32
      %slot32 = scalar.addi %outputs, %j32 : i32
      %slot_value = index.cast %slot32 : i32 to index
      %slot = index.assume %slot_value [ge(%slot_value, 0), lt(%slot_value, %capacity)] : index
      %token = scalar.addi %selection_first, %j32 : i32
      view.store %token, %selections[%slot] : i32, view<[%capacity]xi32>
      scf.if %primary {
        %relative = scalar.subi %token, %cursor : i32
        %input_position = scalar.addi %position, %relative : i32
        %target_position = scalar.addi %input_position, %one32 : i32
        %owner = index.cast %i : index to i32
        view.store %owner, %identities[%slot, 0] : i32, view<[%capacity]x2xi32>
        view.store %target_position, %identities[%slot, 1] : i32, view<[%capacity]x2xi32>
      }
    }
    %next_outputs = scalar.addi %outputs, %active_selections : i32
    scf.yield %end, %next_outputs : i32, i32
  }
  %header = buffer.view %metadata[%metadata_origin] : buffer -> view<3xi32>
  %count32 = index.cast %count : index to i32
  view.store %token_count, %header[0] : i32, view<3xi32>
  view.store %count32, %header[1] : i32, view<3xi32>
  view.store %output_count, %header[2] : i32, view<3xi32>
  func.return %output_count, %token_count : i32, i32
}

// All backing is cold retained storage. This transform allocates nothing and
// completes before its opaque outputs are borrowed by queued host uploads.
func.def public @text_encode_epoch_v2(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_reserved_tokens: i32, %next_reserved_tokens: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %zero32 = scalar.constant 0 : i32
  %token_bytes = buffer.length %tokens
  %metadata_bytes = buffer.length %metadata
  %capacity = func.call @qwen38_packet_capacity(%metadata_bytes) : (offset) -> (index)
  %policy_source = index.constant 40 : offset
  %policy_target = func.call @qwen38_packet_policy_origin(%capacity) : (index) -> (offset)
  %policy_stride = index.constant 24 : offset
  %first_bounded = scalar.assume %first_count [range(%first_count, 1, 2147483647)] : i32
  %first = index.cast %first_bounded : i32 to index
  %requests = buffer.view %plan[%origin] : buffer -> view<[%first]x9xi32>
  // Sampling follows the compact first cohort, not the resident directory.
  // A queued continuation retains its first-plan policy index after compaction.
  scf.for %i = [%c0 to %first step %c1] {
    %row_word = view.load %requests[%i, 3] : view<[%first]x9xi32> -> i32
    %row = index.cast %row_word : i32 to index
    %source_relative = index.scale %row, %policy_stride : index, offset -> offset
    %source_offset = index.add %policy_source, %source_relative : offset
    %target_relative = index.scale %i, %policy_stride : index, offset -> offset
    %target_offset = index.add %policy_target, %target_relative : offset
    buffer.copy %control_state[%source_offset], %metadata[%target_offset], %policy_stride
  }
  %media_count = scalar.addi %first_media_count, %next_media_count : i32
  %target_width, %neural_width = func.call @qwen38.speculation_choose(%control_state, %plan, %first_count, %next_count, %media_count) : (buffer, buffer, i32, i32, i32) -> (i32, i32)
  %ordinary = scalar.cmpi eq, %media_count, %zero32 : i32
  %outputs, %first_tokens = func.call @encode_plan(%plan, %inputs, %first, %c0, %metadata, %origin, %tokens, %origin, %zero32, %ordinary, %target_width, %neural_width) : (buffer, buffer, index, index, buffer, offset, buffer, offset, i32, i1, i32, i32) -> (i32, i32)
  %eos_offset = func.call @qwen38_packet_eos_origin(%capacity) : (index) -> (offset)
  %terminal = buffer.view %metadata[%eos_offset] : buffer -> view<1xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  %continues = scalar.cmpi ne, %next_count, %zero32 : i32
  %metadata_base = func.call @qwen38_packet_bank_bytes(%capacity) : (index) -> (offset)
  %next_output_count, %next_token_count = scf.if %continues -> (i32, i32) {
    %next_bounded = scalar.assume %next_count [range(%next_count, 1, 2147483647)] : i32
    %next_value = index.cast %next_bounded : i32 to index
    %next = index.assume %next_value [le(%next_value, %capacity)] : index
    // Ordinary IDs use two equal retained planes. Mixed spans index one
    // contiguous record array, even if the GPU later shortens the first epoch.
    %token_byte_count = index.cast %token_bytes : offset to index
    %plane_count = index.constant 2 : index
    %plane_bytes = index.div %token_byte_count, %plane_count : index
    %token_base = index.cast %plane_bytes : index to offset
    %queued_record_origin = scf.select %ordinary, %zero32, %first_reserved_tokens : i32
    %next_outputs, %next_tokens = func.call @encode_plan(%plan, %inputs, %next, %first, %metadata, %metadata_base, %tokens, %token_base, %queued_record_origin, %ordinary, %target_width, %neural_width) : (buffer, buffer, index, index, buffer, offset, buffer, offset, i32, i1, i32, i32) -> (i32, i32)
    %next_eos_offset = index.add %metadata_base, %eos_offset : offset
    %next_terminal = buffer.view %metadata[%next_eos_offset] : buffer -> view<1xi32>
    view.store %eos, %next_terminal[0] : i32, view<1xi32>
    %plan_count = index.add %first, %next : index
    %requests = buffer.view %plan[%origin] : buffer -> view<[%plan_count]x9xi32>
    %indices_origin = func.call @qwen38_packet_indices_origin(%capacity) : (index) -> (offset)
    %indices = buffer.view %metadata[%indices_origin] : buffer -> view<[%capacity]xi32>
    scf.for %i = [%c0 to %next step %c1] {
      %record = index.add %first, %i : index
      %first_span = view.load %requests[%record, 8] : view<[%plan_count]x9xi32> -> i32
      view.store %first_span, %indices[%i] : i32, view<[%capacity]xi32>
    }
    scf.yield %next_outputs, %next_tokens : i32, i32
  } else {
    scf.yield %zero32, %zero32 : i32, i32
  }
  %mixed = scalar.cmpi ne, %media_count, %zero32 : i32
  scf.if %mixed {
    %first_media = index.cast %first_media_count : i32 to index
    func.call @encode_media_plan(%plan, %inputs, %media_plan, %c0, %first_media, %first, %c0, %metadata, %origin, %tokens) : (buffer, buffer, buffer, index, index, index, index, buffer, offset, buffer)
    scf.if %continues {
      %next = index.cast %next_count : i32 to index
      %all_media = index.cast %media_count : i32 to index
      func.call @encode_media_plan(%plan, %inputs, %media_plan, %first_media, %all_media, %next, %first, %metadata, %metadata_base, %tokens) : (buffer, buffer, buffer, index, index, index, index, buffer, offset, buffer)
    }
  }
  %state_bytes = buffer.length %control_state
  %transfer_bytes = func.call pure @qwen38.transfer_bytes() : () -> (offset)
  %transfer_offset = index.sub %state_bytes, %transfer_bytes : offset
  %table = buffer.view %control_state[%transfer_offset] : buffer -> view<13x5xi64>
  func.call @qwen38.epoch_transfers(%table, %capacity, %first_count, %next_count, %outputs, %next_output_count, %first_tokens, %next_token_count, %tokens, %mixed) : (view<13x5xi64>, index, i32, i32, i32, i32, i32, i32, buffer, i1)
  %transfer_begin = index.cast %transfer_offset : offset to i64
  %transfer_length = index.cast %transfer_bytes : offset to i64
  func.return %outputs, %control_state, %transfer_begin, %transfer_length : i32, buffer, i64, i64
}

// The ordered, disjoint placements describe the live packet fields.
// The retained table follows the 40-byte control header and resident sampling
// directory. Empty placements carry zero length; they upload no bytes.
func.def @qwen38.epoch_transfer(%table: view<13x5xi64>, %slot: index, %binding: i64, %begin: i64, %length: i64) {
  %entry = index.assume %slot [range(%slot, 0, 12)] : index
  view.store %binding, %table[%entry, 0] : i64, view<13x5xi64>
  view.store %begin, %table[%entry, 1] : i64, view<13x5xi64>
  view.store %binding, %table[%entry, 2] : i64, view<13x5xi64>
  view.store %begin, %table[%entry, 3] : i64, view<13x5xi64>
  view.store %length, %table[%entry, 4] : i64, view<13x5xi64>
  func.return
}

func.def @qwen38.epoch_transfers(%table: view<13x5xi64>, %capacity: index, %first_count: i32, %next_count: i32, %first_outputs: i32, %next_outputs: i32, %first_tokens: i32, %next_tokens: i32, %tokens: buffer, %mixed: i1) {
  %metadata = scalar.constant 0 : i64
  %input = scalar.constant 1 : i64
  %word = scalar.constant 4 : i64
  %pair = scalar.constant 8 : i64
  %header = scalar.constant 12 : i64
  %descriptor = scalar.constant 24 : i64
  %record = scalar.constant 32 : i64
  %c0_i32 = scalar.constant 0 : i32
  %has_next = scalar.cmpi ne, %next_count, %c0_i32 : i32
  %first = scalar.extui %first_count : i32 to i64
  %next = scalar.extui %next_count : i32 to i64
  %outputs = scalar.extui %first_outputs : i32 to i64
  %following_outputs = scalar.extui %next_outputs : i32 to i64
  %first_descriptors = scalar.muli %first, %descriptor : i64
  %first_header = scalar.addi %header, %first_descriptors : i64
  %next_descriptors = scalar.muli %next, %descriptor : i64
  %next_header_size = scalar.addi %header, %next_descriptors : i64
  %next_header = scf.select %has_next, %next_header_size, %metadata : i64
  %first_selections = scalar.muli %outputs, %word : i64
  %next_selections = scalar.muli %following_outputs, %word : i64
  %first_options = scalar.muli %first, %pair : i64
  %next_options = scalar.muli %next, %pair : i64
  %next_eos = scf.select %has_next, %word, %metadata : i64
  %indices = scalar.muli %next, %word : i64
  %policy_stride = scalar.constant 24 : i64
  %policies = scalar.muli %first, %policy_stride : i64
  %identities = scalar.muli %outputs, %pair : i64
  %stride = scf.select %mixed, %record, %word : i64
  %first_token_count = scalar.extui %first_tokens : i32 to i64
  %next_token_count = scalar.extui %next_tokens : i32 to i64
  %first_length = scalar.muli %first_token_count, %stride : i64
  %next_length = scalar.muli %next_token_count, %stride : i64
  %token_bytes = buffer.length %tokens
  %token_length = index.cast %token_bytes : offset to i64
  %planes = scalar.constant 2 : i64
  %token_plane = scalar.divui %token_length, %planes : i64
  %input_next = scf.select %mixed, %first_length, %token_plane : i64
  %slot0 = index.constant 0 : index
  %begin0 = scalar.constant 0 : i64
  func.call @qwen38.epoch_transfer(%table, %slot0, %metadata, %begin0, %first_header) : (view<13x5xi64>, index, i64, i64, i64)
  %slot1 = index.constant 1 : index
  %offset1 = func.call @qwen38_packet_selection_origin(%capacity) : (index) -> (offset)
  %begin1 = index.cast %offset1 : offset to i64
  func.call @qwen38.epoch_transfer(%table, %slot1, %metadata, %begin1, %first_selections) : (view<13x5xi64>, index, i64, i64, i64)
  %slot2 = index.constant 2 : index
  %offset2 = func.call @qwen38_packet_options_origin(%capacity) : (index) -> (offset)
  %begin2 = index.cast %offset2 : offset to i64
  func.call @qwen38.epoch_transfer(%table, %slot2, %metadata, %begin2, %first_options) : (view<13x5xi64>, index, i64, i64, i64)
  %slot3 = index.constant 3 : index
  %offset3 = func.call @qwen38_packet_eos_origin(%capacity) : (index) -> (offset)
  %begin3 = index.cast %offset3 : offset to i64
  func.call @qwen38.epoch_transfer(%table, %slot3, %metadata, %begin3, %word) : (view<13x5xi64>, index, i64, i64, i64)
  %slot4 = index.constant 4 : index
  %offset4 = func.call @qwen38_packet_bank_bytes(%capacity) : (index) -> (offset)
  %begin4 = index.cast %offset4 : offset to i64
  func.call @qwen38.epoch_transfer(%table, %slot4, %metadata, %begin4, %next_header) : (view<13x5xi64>, index, i64, i64, i64)
  %slot5 = index.constant 5 : index
  %begin5 = scalar.addi %begin4, %begin1 : i64
  func.call @qwen38.epoch_transfer(%table, %slot5, %metadata, %begin5, %next_selections) : (view<13x5xi64>, index, i64, i64, i64)
  %slot6 = index.constant 6 : index
  %begin6 = scalar.addi %begin4, %begin2 : i64
  func.call @qwen38.epoch_transfer(%table, %slot6, %metadata, %begin6, %next_options) : (view<13x5xi64>, index, i64, i64, i64)
  %slot7 = index.constant 7 : index
  %begin7 = scalar.addi %begin4, %begin3 : i64
  func.call @qwen38.epoch_transfer(%table, %slot7, %metadata, %begin7, %next_eos) : (view<13x5xi64>, index, i64, i64, i64)
  %slot8 = index.constant 8 : index
  %offset8 = func.call @qwen38_packet_indices_origin(%capacity) : (index) -> (offset)
  %begin8 = index.cast %offset8 : offset to i64
  func.call @qwen38.epoch_transfer(%table, %slot8, %metadata, %begin8, %indices) : (view<13x5xi64>, index, i64, i64, i64)
  %slot9 = index.constant 9 : index
  %offset9 = func.call @qwen38_packet_policy_origin(%capacity) : (index) -> (offset)
  %begin9 = index.cast %offset9 : offset to i64
