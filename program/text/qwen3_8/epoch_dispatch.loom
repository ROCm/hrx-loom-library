template.decl @qwen38.epoch.target(%control_state: buffer, %verify: i1, %mixed: i1, %shape: i32, %target_stage: i32, %verify_stage: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %committed: hal.buffer, %results: hal.buffer) -> (i64)

// The ordinary source composition executes one target command per cohort.
func.decl import("runner") @execute_6(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer, %b4: hal.buffer, %b5: hal.buffer) -> (i64)

func.decl import("runner") @execute_7(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer, %b4: hal.buffer, %b5: hal.buffer, %b6: hal.buffer) -> (i64)

template.def<@qwen38.epoch.target> @qwen38_epoch_dispatch(%control_state: buffer, %verify: i1, %mixed: i1, %shape: i32, %target_stage: i32, %verify_stage: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %committed: hal.buffer, %results: hal.buffer) -> (i64) {
  %completion = scf.if %verify -> (i64) {
    %completion = func.call @execute_7(%verify_stage, %residual, %metadata, %origins, %state, %tokens, %committed, %results) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %completion : i64
  } else {
    %completion = func.call @execute_6(%target_stage, %residual, %metadata, %origins, %state, %tokens, %outputs) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %completion : i64
  }
  template.return %completion : i64
}
