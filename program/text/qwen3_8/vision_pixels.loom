// Qwen3.8 image packet preparation for the text image service.
//
// Codec admission supplies a decoded RGB8/RGBA8 plane, display orientation,
// and checked dimensions; chat policy supplies the selected output geometry.
// qwen38_vision_axis_plan returns I32 starts/offsets and normalized F32 weights.
// qwen38_vision_pixel_packet owns one aligned projection group with one or
// two planes. Each plane has a 64-byte resize header, two axis plans, and decoded
// pixels. The device filter consumes this layout without a resized host image.
//
// Antialiased bicubic coefficients for the trained image processor. Coefficients
// and reductions use F32; sampling-center arithmetic retains its F64 evaluation
// before each explicit F32 rounding. Pixel filtering stays on the device.

func.def @qwen38_vision_cubic(%position: f32) -> (f32) {
  %x = scalar.absf %position : f32
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c2_f32 = scalar.constant 2.0 : f32
  %inner = scalar.cmpf olt, %x, %c1_f32 : f32
  %value = scf.if %inner -> (f32) {
    %a = scalar.constant 1.5 : f32
    %b = scalar.constant 2.5 : f32
    %ax = scalar.mulf %a, %x : f32
    %difference = scalar.subf %ax, %b : f32
    %quadratic = scalar.mulf %difference, %x : f32
    %cubic = scalar.mulf %quadratic, %x : f32
    %result = scalar.addf %cubic, %c1_f32 : f32
    scf.yield %result : f32
  } else {
    %outer = scalar.cmpf olt, %x, %c2_f32 : f32
    %result = scf.if %outer -> (f32) {
      %a = scalar.constant -0.5 : f32
      %b = scalar.constant 2.5 : f32
      %c4_f32 = scalar.constant 4.0 : f32
      %ax = scalar.mulf %a, %x : f32
      %sum = scalar.addf %ax, %b : f32
      %quadratic = scalar.mulf %sum, %x : f32
      %difference = scalar.subf %quadratic, %c4_f32 : f32
      %cubic = scalar.mulf %difference, %x : f32
      %value = scalar.addf %cubic, %c2_f32 : f32
      scf.yield %value : f32
    } else {
      scf.yield %c0_f32 : f32
    }
    scf.yield %result : f32
  }
  func.return %value : f32
}

// A compact axis plan contains output_size I32 source starts, output_size + 1
// I32 coefficient offsets, then contiguous normalized F32 coefficients. The
// returned count identifies the live prefix of the bounded coefficient storage.
// Input extents come from codec admission; output extents come from chat policy.
func.def @qwen38_vision_axis_plan(%input_size: i32, %output_size: i32) -> (buffer, i32) {
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %input_float = scalar.uitofp %input_size : i32 to f32
  %output_float = scalar.uitofp %output_size : i32 to f32
  %scale = scalar.divf %input_float, %output_float : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c2_f32 = scalar.constant 2.0 : f32
  %downsampling = scalar.cmpf oge, %scale, %c1_f32 : f32
  %support_value = scalar.mulf %scale, %c2_f32 : f32
  %support = scf.select %downsampling, %support_value, %c2_f32 : f32
  %scale_wide = scalar.extf %scale : f32 to f64
  %c1_f64 = scalar.constant 1.0 : f64
  %inverse_wide = scalar.divf %c1_f64, %scale_wide : f64
  %inverse_value = scalar.fptrunc %inverse_wide : f64 to f32
  %inverse = scf.select %downsampling, %inverse_value, %c1_f32 : f32
  %inverse_scale = scalar.extf %inverse : f32 to f64
  %ceil_support = scalar.ceilf %support : f32
  %support_integer = scalar.fptoui %ceil_support : f32 to i32
  %diameter = scalar.muli %support_integer, %c2_i32 : i32
  %maximum_taps = scalar.addi %diameter, %c1_i32 : i32
  %capacity32 = scalar.muli %output_size, %maximum_taps : i32
  %capacity = index.cast %capacity32 : i32 to index
  %outputs = index.cast %output_size : i32 to index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %origin = index.constant 0 : offset
  %word_bytes = index.constant 4 : offset
  %offsets_count = index.add %outputs, %c1 : index
  %offsets_offset = index.scale %outputs, %word_bytes : index, offset -> offset
  %table_words = index.madd %outputs, %c2, %c1 : index
  %weights_offset = index.scale %table_words, %word_bytes : index, offset -> offset
  %coefficient_bytes = index.scale %capacity, %word_bytes : index, offset -> offset
  %plan_bytes = index.add %weights_offset, %coefficient_bytes : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %starts = buffer.view %plan[%origin] : buffer -> view<[%outputs]xi32>
  %offsets = buffer.view %plan[%offsets_offset] : buffer -> view<[%offsets_count]xi32>
  %weights = buffer.view %plan[%weights_offset] : buffer -> view<[%capacity]xf32>
  view.store %c0_i32, %offsets[0] : i32, view<[%offsets_count]xi32>
  %half = scalar.constant 0.5 : f64
  %c0_f32 = scalar.constant 0.0 : f32
  %weight_count = scf.for %output = [%c0 to %outputs step %c1](%begin = %c0 : index) -> (index) {
    %output_word = index.cast %output : index to i32
    %output_wide = scalar.uitofp %output_word : i32 to f64
    %center_index = scalar.addf %output_wide, %half : f64
    %center_value = scalar.mulf %scale_wide, %center_index : f64
    %center = scalar.fptrunc %center_value : f64 to f32
    %lower = scalar.subf %center, %support : f32
    %upper = scalar.addf %center, %support : f32
    %lower_wide = scalar.extf %lower : f32 to f64
    %upper_wide = scalar.extf %upper : f32 to f64
    %lower_center = scalar.addf %lower_wide, %half : f64
    %upper_center = scalar.addf %upper_wide, %half : f64
    %lower_integer = scalar.fptosi %lower_center : f64 to i32
    %upper_integer = scalar.fptosi %upper_center : f64 to i32
    %start = scalar.maxsi %lower_integer, %c0_i32 : i32
    %limit = scalar.minsi %upper_integer, %input_size : i32
    %span = scalar.subi %limit, %start : i32
    %nonnegative = scalar.maxsi %span, %c0_i32 : i32
    %count32 = scalar.minsi %nonnegative, %maximum_taps : i32
    %count = index.cast %count32 : i32 to index
    %end = index.add %begin, %count : index
    %end32 = index.cast %end : index to i32
    %next = index.add %output, %c1 : index
    view.store %start, %starts[%output] : i32, view<[%outputs]xi32>
    view.store %end32, %offsets[%next] : i32, view<[%offsets_count]xi32>
    %center_wide = scalar.extf %center : f32 to f64
    %total = scf.for %tap = [%begin to %end step %c1](%sum = %c0_f32 : f32) -> (f32) {
      %relative = index.sub %tap, %begin : index
      %relative32 = index.cast %relative : index to i32
      %source = scalar.addi %start, %relative32 : i32
      %source_wide = scalar.uitofp %source : i32 to f64
      %distance = scalar.subf %source_wide, %center_wide : f64
      %shifted = scalar.addf %distance, %half : f64
      %scaled = scalar.mulf %shifted, %inverse_scale : f64
      %position = scalar.fptrunc %scaled : f64 to f32
      %weight = func.call @qwen38_vision_cubic(%position) : (f32) -> (f32)
      %weight_index = index.assume %tap [ge(%tap, 0), lt(%tap, %capacity)] : index
      view.store %weight, %weights[%weight_index] : f32, view<[%capacity]xf32>
      %accumulated = scalar.addf %sum, %weight : f32
      scf.yield %accumulated : f32
    }
    scf.for %tap = [%begin to %end step %c1] {
      %weight_index = index.assume %tap [ge(%tap, 0), lt(%tap, %capacity)] : index
      %weight = view.load %weights[%weight_index] : view<[%capacity]xf32> -> f32
      %normalized = scalar.divf %weight, %total : f32
      view.store %normalized, %weights[%weight_index] : f32, view<[%capacity]xf32>
    }
    scf.yield %end : index
  }
  %count = index.cast %weight_count : index to i32
  func.return %plan, %count : buffer, i32
}

global.rodata.def @qwen38_orientation_layouts = bytes("00040c0802060e0a")

// Plan one checked native plane without copying pixels. The returned storage
// contains a complete resize header and axis tables, padded to the pixel start.
// Header offsets remain relative to this plane when placed in a larger upload.
// Source pixel range and complete aligned extent are returned with the plan.
func.def @qwen38_vision_plane_plan(%request: buffer, %plane_offset: offset, %width: i32, %height: i32) -> (buffer, offset, offset, offset) {
  %origin = index.constant 0 : offset
  %plane = buffer.view %request[%plane_offset] : buffer -> view<12xi32>
  %source_width = view.load %plane[3] : view<12xi32> -> i32
  %source_height = view.load %plane[4] : view<12xi32> -> i32
  %orientation = view.load %plane[5] : view<12xi32> -> i32
  %source_word = view.load %plane[6] : view<12xi32> -> i32
  %source_bytes = view.load %plane[7] : view<12xi32> -> i32
  %channels = view.load %plane[8] : view<12xi32> -> i32
  %horizontal, %horizontal_count = func.call @qwen38_vision_axis_plan(%source_width, %width) : (i32, i32) -> (buffer, i32)
  %vertical, %vertical_count = func.call @qwen38_vision_axis_plan(%source_height, %height) : (i32, i32) -> (buffer, i32)
  %c1_i32 = scalar.constant 1 : i32
  %rgb_channels = scalar.constant 3 : i32
  %word_bytes = scalar.constant 4 : i32
  %alignment_bias = scalar.constant 15 : i32
  %alignment_mask = scalar.constant -16 : i32
  %width_bytes = scalar.muli %width, %word_bytes : i32
  %height_bytes = scalar.muli %height, %word_bytes : i32
  %horizontal_starts = scalar.constant 64 : i32
  %horizontal_offsets = scalar.addi %horizontal_starts, %width_bytes : i32
  %horizontal_weights_base = scalar.addi %horizontal_offsets, %width_bytes : i32
  %horizontal_weights = scalar.addi %horizontal_weights_base, %word_bytes : i32
  %horizontal_weight_bytes = scalar.muli %horizontal_count, %word_bytes : i32
  %vertical_starts = scalar.addi %horizontal_weights, %horizontal_weight_bytes : i32
  %vertical_offsets = scalar.addi %vertical_starts, %height_bytes : i32
  %vertical_weights_base = scalar.addi %vertical_offsets, %height_bytes : i32
  %vertical_weights = scalar.addi %vertical_weights_base, %word_bytes : i32
  %vertical_weight_bytes = scalar.muli %vertical_count, %word_bytes : i32
  %plan_end = scalar.addi %vertical_weights, %vertical_weight_bytes : i32
  %rounded_plan_end = scalar.addi %plan_end, %alignment_bias : i32
  %pixels = scalar.andi %rounded_plan_end, %alignment_mask : i32
  %pixel_end = scalar.addi %pixels, %source_bytes : i32
  %rounded_pixel_end = scalar.addi %pixel_end, %alignment_bias : i32
  %packet_end = scalar.andi %rounded_pixel_end, %alignment_mask : i32
  %packet_bytes = index.cast %packet_end : i32 to offset
  %plan_bytes = index.cast %pixels : i32 to offset
  %plan = buffer.alloca<private> align(16) %plan_bytes : buffer
  %resize_header = buffer.view %plan[%origin] : buffer -> view<16xi32>
  view.store %source_height, %resize_header[0] : i32, view<16xi32>
  view.store %source_width, %resize_header[1] : i32, view<16xi32>
  view.store %height, %resize_header[2] : i32, view<16xi32>
  view.store %width, %resize_header[3] : i32, view<16xi32>
  view.store %horizontal_count, %resize_header[4] : i32, view<16xi32>
  view.store %vertical_count, %resize_header[5] : i32, view<16xi32>
  view.store %source_bytes, %resize_header[6] : i32, view<16xi32>
  %pixel_count = scalar.muli %width, %height : i32
  %output_bytes = scalar.muli %pixel_count, %rgb_channels : i32
  view.store %output_bytes, %resize_header[7] : i32, view<16xi32>
  view.store %pixels, %resize_header[8] : i32, view<16xi32>
  view.store %horizontal_starts, %resize_header[9] : i32, view<16xi32>
  view.store %horizontal_offsets, %resize_header[10] : i32, view<16xi32>
  view.store %horizontal_weights, %resize_header[11] : i32, view<16xi32>
  view.store %vertical_starts, %resize_header[12] : i32, view<16xi32>
  view.store %vertical_offsets, %resize_header[13] : i32, view<16xi32>
  view.store %vertical_weights, %resize_header[14] : i32, view<16xi32>
  %orientation_word = scalar.subi %orientation, %c1_i32 : i32
  %orientation_index0 = index.cast %orientation_word : i32 to index
  %orientation_index = index.assume %orientation_index0 [range(%orientation_index0, 0, 7)] : index
  %layouts = global.load @qwen38_orientation_layouts : buffer
  %layout_view = buffer.view %layouts[%origin] : buffer -> view<8xi8>
  %axes_byte = view.load %layout_view[%orientation_index] : view<8xi8> -> i8
  %axes = scalar.extui %axes_byte : i8 to i32
  %alpha = scalar.subi %channels, %rgb_channels : i32
  %layout = scalar.ori %axes, %alpha : i32
  view.store %layout, %resize_header[15] : i32, view<16xi32>
  %horizontal_length = scalar.subi %vertical_starts, %horizontal_starts : i32
  %vertical_length = scalar.subi %plan_end, %vertical_starts : i32
  %horizontal_destination = index.cast %horizontal_starts : i32 to offset
  %vertical_destination = index.cast %vertical_starts : i32 to offset
  %horizontal_bytes = index.cast %horizontal_length : i32 to offset
  %vertical_bytes = index.cast %vertical_length : i32 to offset
  buffer.copy %horizontal[%origin], %plan[%horizontal_destination], %horizontal_bytes
  buffer.copy %vertical[%origin], %plan[%vertical_destination], %vertical_bytes
  %padding_length = scalar.subi %pixels, %plan_end : i32
  %padding_offset = index.cast %plan_end : i32 to offset
  %padding_bytes = index.cast %padding_length : i32 to offset
  %c0_i8 = scalar.constant 0 : i8
  buffer.fill %c0_i8, %plan[%padding_offset], %padding_bytes : i8
  %pixel_source = index.cast %source_word : i32 to offset
  %pixel_bytes = index.cast %source_bytes : i32 to offset
  func.return %plan, %pixel_source, %pixel_bytes, %packet_bytes : buffer, offset, offset, offset
}

// One projection contains one still/odd-tail plane or two temporal planes.
// The 16-byte group header stores selected width/height and two plane offsets.
// A repeated tail aliases its first plane; no pixels or filter plans repeat.
// Native cohort packing prefixes its own shared request directory.
func.def public @qwen38_vision_pixel_packet(%request: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %request[%origin] : buffer -> view<8xi32>
  %plane_count_word = view.load %header[1] : view<8xi32> -> i32
  %plane_count_bound = scalar.assume %plane_count_word [range(%plane_count_word, 1, 2)] : i32
  %plane_count = index.cast %plane_count_bound : i32 to index
  %metadata_word = view.load %header[3] : view<8xi32> -> i32
  %metadata_offset = index.cast %metadata_word : i32 to offset
  %metadata = buffer.view %request[%metadata_offset] : buffer -> view<2xi32>
  %width = view.load %metadata[0] : view<2xi32> -> i32
  %height = view.load %metadata[1] : view<2xi32> -> i32
  %first_descriptor = index.constant 32 : offset
  %first_plan, %first_source, %first_pixels, %first_bytes = func.call @qwen38_vision_plane_plan(%request, %first_descriptor, %width, %height) : (buffer, offset, i32, i32) -> (buffer, offset, offset, offset)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %paired = index.cmp ugt, %plane_count, %c1 : index
  %second_plan, %second_source, %second_pixels, %second_bytes = scf.if %paired -> (buffer, offset, offset, offset) {
    %second_descriptor = index.constant 80 : offset
    %plan, %source, %pixels, %bytes = func.call @qwen38_vision_plane_plan(%request, %second_descriptor, %width, %height) : (buffer, offset, i32, i32) -> (buffer, offset, offset, offset)
    scf.yield %plan, %source, %pixels, %bytes : buffer, offset, offset, offset
  } else {
    scf.yield %first_plan, %first_source, %first_pixels, %origin : buffer, offset, offset, offset
  }
  %header_bytes = index.constant 16 : offset
  %packet_bytes, %header_offset, %first_offset, %second_storage = buffer.pack [align(16) %header_bytes, align(16) %first_bytes, align(16) %second_bytes] : offset
  %second_offset = scf.select %paired, %second_storage, %first_offset : offset
  %packet = buffer.alloca<private> align(16) %packet_bytes : buffer
  %group = buffer.view %packet[%header_offset] : buffer -> view<4xi32>
  %first_word = index.cast %first_offset : offset to i32
  %second_word = index.cast %second_offset : offset to i32
  view.store %width, %group[0] : i32, view<4xi32>
  view.store %height, %group[1] : i32, view<4xi32>
  view.store %first_word, %group[2] : i32, view<4xi32>
  view.store %second_word, %group[3] : i32, view<4xi32>
  scf.for %plane = [%c0 to %plane_count step %c1] {
    %first = index.cmp eq, %plane, %c0 : index
    %plan = scf.select %first, %first_plan, %second_plan : buffer
    %source = scf.select %first, %first_source, %second_source : offset
    %pixels = scf.select %first, %first_pixels, %second_pixels : offset
    %bytes = scf.select %first, %first_bytes, %second_bytes : offset
    %target = scf.select %first, %first_offset, %second_offset : offset
    %plan_bytes = buffer.length %plan
    %pixel_target = index.add %target, %plan_bytes : offset
    buffer.copy %plan[%origin], %packet[%target], %plan_bytes
    buffer.copy %request[%source], %packet[%pixel_target], %pixels
    %pixel_end = index.add %plan_bytes, %pixels : offset
    %tail_bytes = index.sub %bytes, %pixel_end : offset
    %tail_offset = index.add %target, %pixel_end : offset
    %c0_i8 = scalar.constant 0 : i8
    buffer.fill %c0_i8, %packet[%tail_offset], %tail_bytes : i8
  }
  func.return %packet : buffer
}
