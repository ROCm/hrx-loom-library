// Model-authored proposal widths and optional program pairs for the shared text
// packet ABI. Three {verification width, proposal stage, verifier stage} I32
// records cover rounded cohorts of two, four, and eight owners. Width includes
// the anchor. A zero width selects the ordinary phases. The final words hold the
// configured width ceiling, admitted cohort capacity, and selected record
// (three selects ordinary programs). Preparation owns all handles and widths.
// Selection allocates nothing and never reads device memory. Both queued banks
// use the same choice, captured as stage identities before asynchronous dispatch.

func.decl pure @qwen38.speculation_origin(%state: buffer) -> (offset)

func.decl @qwen38.proposal_level(%count: i32) -> (i32)

// Preparation supplies the width ceiling and the maximum owners admitted by
// the packet. The optional shorter widths cover up to eight simultaneous
// owners. Larger cohorts use the ordinary proposal and verification programs.
func.def public @qwen38.speculation_configure(%state: buffer, %ceiling: i32, %capacity: i32) {
  %origin = func.call pure @qwen38.speculation_origin(%state) : (buffer) -> (offset)
  %words = buffer.view %state[%origin] : buffer -> view<12xi32>
  %limit = scalar.constant 8 : i32
  %admitted = scalar.minui %capacity, %limit : i32
  %ordinary = scalar.constant 3 : i32
  view.store %ceiling, %words[9] : i32, view<12xi32>
  view.store %admitted, %words[10] : i32, view<12xi32>
  view.store %ordinary, %words[11] : i32, view<12xi32>
  func.return
}

// Each registered width is positive, smaller than the configured ceiling, and
// supported by both supplied programs. Levels one/two/three cover two/four/eight
// owners. Entries whose ordinary programs already have that width remain zero.
func.def public @qwen38.speculation_register(%state: buffer, %level_value: index, %width: i32, %proposal: i32, %verifier: i32) {
  %origin = func.call pure @qwen38.speculation_origin(%state) : (buffer) -> (offset)
  %entries = buffer.view %state[%origin] : buffer -> view<3x3xi32>
  %level = index.assume %level_value [range(%level_value, 1, 3)] : index
  %c1 = index.constant 1 : index
  %entry = index.sub %level, %c1 : index
  view.store %width, %entries[%entry, 0] : i32, view<3x3xi32>
  view.store %proposal, %entries[%entry, 1] : i32, view<3x3xi32>
  view.store %verifier, %entries[%entry, 2] : i32, view<3x3xi32>
  func.return
}

// The ordinary stages can cap paid neural predictions while retaining the
// whole target reservation for candidates already available from history.
func.def public @qwen38.speculation_register_width(%state: buffer, %level: index, %width: i32) {
  %ordinary = scalar.constant -1 : i32
  func.call @qwen38.speculation_register(%state, %level, %width, %ordinary, %ordinary) : (buffer, index, i32, i32, i32)
  func.return
}

// A valid native plan can contain work requiring the ordinary program:
// multi-token prefill, media, or supplied candidates. Alternative widths apply
// to generated spans beside optional one-token final decodes. The host plan and
// owner identities stay immutable. Named stage pairs constrain both the target
// and draft widths. Shared stages can constrain just the neural draft width.
func.def public @qwen38.speculation_choose(%state: buffer, %plan: buffer, %first_count: i32, %next_count: i32, %media_count: i32) -> (i32, i32) {
  %origin = func.call pure @qwen38.speculation_origin(%state) : (buffer) -> (offset)
  %words = buffer.view %state[%origin] : buffer -> view<12xi32>
  %entries = buffer.view %state[%origin] : buffer -> view<3x3xi32>
  %ceiling = view.load %words[9] : view<12xi32> -> i32
  %capacity = view.load %words[10] : view<12xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %propose_flag = scalar.constant 2 : i32
  %ordinary_entry = scalar.constant 3 : i32
  %multiple = scalar.cmpi ugt, %first_count, %c1 : i32
  %bounded = scalar.cmpi ule, %first_count, %capacity : i32
  %next_bounded = scalar.cmpi ule, %next_count, %first_count : i32
  %text = scalar.cmpi eq, %media_count, %c0 : i32
  %first_fits = scalar.andi %multiple, %bounded : i1
  %rest_fits = scalar.andi %next_bounded, %text : i1
  %eligible = scalar.andi %first_fits, %rest_fits : i1
  %target_width, %neural_width, %selected = scf.if %eligible -> (i32, i32, i32) {
    %level = func.call @qwen38.proposal_level(%first_count) : (i32) -> (i32)
    %entry_word = scalar.subi %level, %c1 : i32
    %entry_value = index.cast %entry_word : i32 to index
    %entry = index.assume %entry_value [range(%entry_value, 0, 2)] : index
    %candidate = view.load %entries[%entry, 0] : view<3x3xi32> -> i32
    %available = scalar.cmpi ne, %candidate, %c0 : i32
    %supported = scf.if %available -> (i1) {
      %bytes = buffer.length %plan
      %length = index.cast %bytes : offset to index
      %record_bytes = index.constant 36 : index
      %extent = index.div %length, %record_bytes : index
      %plan_origin = index.constant 0 : offset
      %requests = buffer.view %plan[%plan_origin] : buffer -> view<[%extent]x9xi32>
      %total = scalar.addi %first_count, %next_count : i32
      %count_value = index.cast %total : i32 to index
      %count = index.assume %count_value [range(%count_value, 1, 16), le(%count_value, %extent)] : index
      %begin = index.constant 0 : index
      %step = index.constant 1 : index
      %yes = scalar.constant true : i1
      %compatible = scf.for %record = [%begin to %count step %step](%valid = %yes : i1) -> (i1) {
        %reserved = view.load %requests[%record, 0] : view<[%extent]x9xi32> -> i32
        %inputs = view.load %requests[%record, 5] : view<[%extent]x9xi32> -> i32
        %flags = view.load %requests[%record, 6] : view<[%extent]x9xi32> -> i32
        %credit = view.load %requests[%record, 7] : view<[%extent]x9xi32> -> i32
        %full = scalar.cmpi eq, %reserved, %ceiling : i32
        %anchor = scalar.cmpi ule, %inputs, %c1 : i32
        %bits = scalar.andi %flags, %propose_flag : i32
        %proposes = scalar.cmpi ne, %bits, %c0 : i32
        %credited = scalar.cmpi ne, %credit, %c0 : i32
        %proposal_shape = scalar.andi %full, %anchor : i1
        %proposal_mode = scalar.andi %proposes, %credited : i1
        %proposal = scalar.andi %proposal_shape, %proposal_mode : i1
        %single = scalar.cmpi eq, %reserved, %c1 : i32
        %known = scalar.cmpi eq, %inputs, %c1 : i32
        %selected = scalar.cmpi eq, %flags, %c1 : i32
        %uncredited = scalar.cmpi eq, %credit, %c0 : i32
        %ordinary_shape = scalar.andi %single, %known : i1
        %ordinary_mode = scalar.andi %selected, %uncredited : i1
        %ordinary = scalar.andi %ordinary_shape, %ordinary_mode : i1
        %record_ok = scalar.ori %proposal, %ordinary : i1
        %next = scalar.andi %valid, %record_ok : i1
        scf.yield %next : i1
      }
      scf.yield %compatible : i1
    } else {
      %no = scalar.constant false : i1
      scf.yield %no : i1
    }
    %chosen_width = scf.select %supported, %candidate, %c0 : i32
    %proposal = view.load %entries[%entry, 1] : view<3x3xi32> -> i32
    %named_pair = scalar.cmpi sge, %proposal, %c0 : i32
    %override = scalar.andi %supported, %named_pair : i1
    %chosen_entry = scf.select %override, %entry_word, %ordinary_entry : i32
    %named_width = scf.select %override, %candidate, %c0 : i32
    scf.yield %named_width, %chosen_width, %chosen_entry : i32, i32, i32
  } else {
    scf.yield %c0, %c0, %ordinary_entry : i32, i32, i32
  }
  view.store %selected, %words[11] : i32, view<12xi32>
  func.return %target_width, %neural_width : i32, i32
}

// A zero width selects the ordinary stages; stage identities remain opaque.
// Identities are copied into queue submissions, so later host decisions cannot
// alter already queued work.
func.def public @qwen38.speculation_stages(%state: buffer) -> (i32, i32, i32) {
  %origin = func.call pure @qwen38.speculation_origin(%state) : (buffer) -> (offset)
  %words = buffer.view %state[%origin] : buffer -> view<12xi32>
  %selected = view.load %words[11] : view<12xi32> -> i32
  %ordinary = scalar.constant 3 : i32
  %active = scalar.cmpi ult, %selected, %ordinary : i32
  %width, %proposal, %verifier = scf.if %active -> (i32, i32, i32) {
    %value = index.cast %selected : i32 to index
    %entry = index.assume %value [range(%value, 0, 2)] : index
    %entries = buffer.view %state[%origin] : buffer -> view<3x3xi32>
    %width = view.load %entries[%entry, 0] : view<3x3xi32> -> i32
    %proposal = view.load %entries[%entry, 1] : view<3x3xi32> -> i32
    %verifier = view.load %entries[%entry, 2] : view<3x3xi32> -> i32
    scf.yield %width, %proposal, %verifier : i32, i32, i32
  } else {
    %c0 = scalar.constant 0 : i32
    scf.yield %c0, %c0, %c0 : i32, i32, i32
  }
  func.return %width, %proposal, %verifier : i32, i32, i32
}
