// Qwen3.8 text-service v1 asynchronous execution.
// Preparation supplies opaque stage IDs and retained buffer bindings. The
// runner imports enqueue proposal, target verification, feedback transfer, and
// accepted-state catch-up. Feedback banks remain immutable while private draft
// state catches up; the returned work completion does not join feedback.
// The native caller retains bindings and joins both timelines before reuse.

type.decl import("hal", "buffer") @HalBuffer

func.decl @qwen38_feedback_records_origin() -> (offset)

func.decl @qwen38_feedback_tagged_bytes(%capacity: index) -> (offset)

func.decl import("runner") @timestamp(%target: ptr<@HalBuffer>, %offset: i64) -> (i64)

func.decl @qwen38.proposal_level(%count: i32) -> (i32)

func.decl @qwen38.speculation_stages(%state: buffer) -> (i32, i32, i32)

func.decl import("runner") @execute_3(%stage: i32, %b0: ptr<@HalBuffer>, %b1: ptr<@HalBuffer>, %b2: ptr<@HalBuffer>) -> (i64)

func.decl import("runner") @execute_6(%stage: i32, %b0: ptr<@HalBuffer>, %b1: ptr<@HalBuffer>, %b2: ptr<@HalBuffer>, %b3: ptr<@HalBuffer>, %b4: ptr<@HalBuffer>, %b5: ptr<@HalBuffer>) -> (i64)

template.decl @qwen38.epoch.target(%control_state: buffer, %verify: i1, %mixed: i1, %shape: i32, %target_stage: i32, %verify_stage: i32, %residual: ptr<@HalBuffer>, %metadata: ptr<@HalBuffer>, %origins: ptr<@HalBuffer>, %state: ptr<@HalBuffer>, %tokens: ptr<@HalBuffer>, %outputs: ptr<@HalBuffer>, %committed: ptr<@HalBuffer>, %results: ptr<@HalBuffer>) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: ptr<@HalBuffer>, %offset: i64, %length: i64) -> (i64)

// The program is shared; all request state arrives as buffer bindings.
func.def public @text_step_v1(%state: buffer, %initialize: i32, %source_position: i32, %input_count: i32, %residual: ptr<@HalBuffer>, %control: ptr<@HalBuffer>, %gdn: ptr<@HalBuffer>, %attention: ptr<@HalBuffer>, %tokens: ptr<@HalBuffer>, %progress: ptr<@HalBuffer>) -> (i64, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %state[%origin] : buffer -> view<10xi32>
  %prefill = view.load %view[0] : view<10xi32> -> i32
  %decode = view.load %view[1] : view<10xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %is_prefill = scalar.cmpi ne, %initialize, %c0 : i32
  %stage = scf.select %is_prefill, %prefill, %decode : i32
  %completion = func.call @execute_6(%stage, %residual, %control, %gdn, %attention, %tokens, %progress) : (i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
  %next_source_position = scalar.addi %source_position, %input_count : i32
  func.return %completion, %next_source_position : i64, i32
}

// Cold state supplies the first target shape, allowing models to omit
// isolated stages. Optional proposal, catch-up, and verifier catalogs retain
// their explicit origins. All sessions share these commands and one process;
// descriptors and buffers carry their live state.
// Feedback slot zero holds ordinary tokens; slots one/two hold separate
// verification banks. Neither branch waits: the owner joins both timelines
// before advancing host frontiers.
func.def @epoch_once(%control_state: buffer, %mixed: i1, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %feedback_slot: i32, %residual: ptr<@HalBuffer>, %metadata: ptr<@HalBuffer>, %origins: ptr<@HalBuffer>, %state: ptr<@HalBuffer>, %tokens: ptr<@HalBuffer>, %outputs: ptr<@HalBuffer>, %carry: ptr<@HalBuffer>, %committed: ptr<@HalBuffer>, %results: ptr<@HalBuffer>, %draft_cache: ptr<@HalBuffer>, %draft_origins: ptr<@HalBuffer>) -> (i64) {
  %origin = index.constant 0 : offset
  %view = buffer.view %control_state[%origin] : buffer -> view<10xi32>
  %shape_count = view.load %view[2] : view<10xi32> -> i32
  %ordinary_draft_first = view.load %view[3] : view<10xi32> -> i32
  %mixed_draft_first = view.load %view[7] : view<10xi32> -> i32
  %draft_first = scf.select %mixed, %mixed_draft_first, %ordinary_draft_first : i32
  %ordinary_warm_first = view.load %view[8] : view<10xi32> -> i32
  %mixed_warm_first = view.load %view[9] : view<10xi32> -> i32
  %warm_first = scf.select %mixed, %mixed_warm_first, %ordinary_warm_first : i32
  %ordinary_target_first = view.load %view[5] : view<10xi32> -> i32
  %mixed_target_first = view.load %view[6] : view<10xi32> -> i32
  %target_first = scf.select %mixed, %mixed_target_first, %ordinary_target_first : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c0_2 = scalar.constant 0 : i64
  %chosen_width, %chosen_proposal, %chosen_verifier = func.call @qwen38.speculation_stages(%control_state) : (buffer) -> (i32, i32, i32)
  %alternative = scalar.cmpi ne, %chosen_width, %c0 : i32
  %propose = scalar.cmpi ne, %proposes, %c0 : i32
  %verify = scalar.cmpi ne, %verifies, %c0 : i32
  scf.if %verify {
    %started = func.call @timestamp(%results, %c0_2) : (ptr<@HalBuffer>, i64) -> (i64)
  }
  scf.if %propose {
    // Live spans bound the proposing subset, including mixed prefill/decode.
    // The final variant covers the largest cohort admitted by target shapes.
    %variants = scalar.subi %warm_first, %draft_first : i32
    %last = scalar.subi %variants, %c1 : i32
    %level = func.call @qwen38.proposal_level(%span_count) : (i32) -> (i32)
    %selected = scalar.minui %level, %last : i32
    %ordinary_draft_stage = scalar.addi %draft_first, %selected : i32
    %draft_stage = scf.select %alternative, %chosen_proposal, %ordinary_draft_stage : i32
    %proposal = func.call @execute_6(%draft_stage, %metadata, %tokens, %draft_origins, %draft_cache, %carry, %results) : (i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
  }
  scf.if %verify {
    %target_offset = scalar.constant 8 : i64
    %target_started = func.call @timestamp(%results, %target_offset) : (ptr<@HalBuffer>, i64) -> (i64)
  }
  %warm_stage = scalar.addi %warm_first, %shape : i32
  %target_stage = scalar.addi %shape, %target_first : i32
  %ordinary_verify_stage = scalar.addi %warm_stage, %shape_count : i32
  %verify_stage = scf.select %alternative, %chosen_verifier, %ordinary_verify_stage : i32
  %computed = template.apply<@qwen38.epoch.target>(%control_state, %verify, %mixed, %shape, %target_stage, %verify_stage, %residual, %metadata, %origins, %state, %tokens, %outputs, %committed, %results) : (buffer, i1, i1, i32, i32, i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
  %target = scf.if %verify -> (i64) {
    %end_offset = scalar.constant 16 : i64
    %measured = func.call @timestamp(%results, %end_offset) : (ptr<@HalBuffer>, i64) -> (i64)
    %count = scalar.extui %span_count : i32 to i64
    %record_bytes = scalar.constant 40 : i64
    %record_payload = scalar.muli %count, %record_bytes : i64
    %header_origin = func.call @qwen38_feedback_records_origin() : () -> (offset)
    %header_bytes = index.cast %header_origin : offset to i64
    %record_length = scalar.addi %record_payload, %header_bytes : i64
    %tagged = scalar.cmpi eq, %feedback_slot, %c2 : i32
    %length = scf.if %tagged -> (i64) {
      // The device may retire fewer owners before this queued epoch. The host
      // already knows their first-plan bound, so no count readback is needed.
      %capacity = index.cast %span_count : i32 to index
      %tagged_bytes = func.call @qwen38_feedback_tagged_bytes(%capacity) : (index) -> (offset)
      %tagged_length = index.cast %tagged_bytes : offset to i64
      scf.yield %tagged_length : i64
    } else {
      scf.yield %record_length : i64
    }
    %feedback = func.call @feedback(%feedback_slot, %results, %c0_2, %length) : (i32, ptr<@HalBuffer>, i64, i64) -> (i64)
    scf.yield %measured : i64
  } else {
    %has_output = scalar.cmpi ne, %output_count, %c0 : i32
    scf.if %has_output {
      %count = scalar.extui %output_count : i32 to i64
      %token_bytes = scalar.constant 4 : i64
      %length = scalar.muli %count, %token_bytes : i64
      %feedback = func.call @feedback(%c0, %outputs, %c0_2, %length) : (i32, ptr<@HalBuffer>, i64, i64) -> (i64)
    }
    scf.yield %computed : i64
  }
  // Catch-up only mutates the private draft cache and committed carry. Target
  // feedback stays immutable and can transfer concurrently with this command.
  %draft_enabled = scalar.cmpi ne, %draft_first, %c0 : i32
  %completion = scf.if %draft_enabled -> (i64) {
    %accepted = scf.if %verify -> (ptr<@HalBuffer>) {
      scf.yield %committed : ptr<@HalBuffer>
    } else {
      scf.yield %metadata : ptr<@HalBuffer>
    }
    %warm = func.call @execute_6(%warm_stage, %residual, %accepted, %draft_origins, %draft_cache, %carry, %tokens) : (i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
    scf.yield %warm : i64
  } else {
    scf.yield %target : i64
  }
  func.return %completion : i64
}

// A bounded cohort reuses retained state on the work timeline, while each
// feedback bank stays immutable on its independent transfer branch. Acceptance
// produces the next input and position entirely on device; neither call waits.
func.def public @text_epoch_v1(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %epoch_count: i32, %continuation_shape: i32, %continuation_proposes: i32, %first_media_count: i32, %next_media_count: i32, %residual: ptr<@HalBuffer>, %metadata: ptr<@HalBuffer>, %origins: ptr<@HalBuffer>, %state: ptr<@HalBuffer>, %tokens: ptr<@HalBuffer>, %outputs: ptr<@HalBuffer>, %carry: ptr<@HalBuffer>, %committed: ptr<@HalBuffer>, %results: ptr<@HalBuffer>, %draft_cache: ptr<@HalBuffer>, %draft_origins: ptr<@HalBuffer>, %next_results: ptr<@HalBuffer>) -> (i64) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %media_count = scalar.addi %first_media_count, %next_media_count : i32
  %mixed = scalar.cmpi ne, %media_count, %c0 : i32
  %first = func.call @epoch_once(%control_state, %mixed, %shape, %proposes, %verifies, %span_count, %output_count, %c1, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %results, %draft_cache, %draft_origins) : (buffer, i1, i32, i32, i32, i32, i32, i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
  %continues = scalar.cmpi eq, %epoch_count, %c2 : i32
  %completion = scf.if %continues -> (i64) {
    %origin = index.constant 0 : offset
    %view = buffer.view %control_state[%origin] : buffer -> view<10xi32>
    %shape_count = view.load %view[2] : view<10xi32> -> i32
    %ordinary_warm = view.load %view[8] : view<10xi32> -> i32
    %mixed_warm = view.load %view[9] : view<10xi32> -> i32
    %warm = scf.select %mixed, %mixed_warm, %ordinary_warm : i32
    %shapes = scalar.muli %shape_count, %c2 : i32
    %continuation = scalar.addi %warm, %shapes : i32
    %ready = func.call @execute_3(%continuation, %metadata, %tokens, %results) : (i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
    %next = func.call @epoch_once(%control_state, %mixed, %continuation_shape, %continuation_proposes, %c1, %span_count, %c0, %c2, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %next_results, %draft_cache, %draft_origins) : (buffer, i1, i32, i32, i32, i32, i32, i32, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
    scf.yield %next : i64
  } else {
    scf.yield %first : i64
  }
  func.return %completion : i64
}
