load("//build_tools/bazel:defs.bzl", "loom_library")

package(default_visibility = ["//visibility:public"])

loom_library(
    name = "chat",
    srcs = ["chat.loom"],
    deps = [
        ":chat_history",
        ":chat_media",
    ],
)

loom_library(
    name = "chat_media",
    srcs = ["chat_media.loom"],
    deps = [":vision_geometry"],
)

loom_library(
    name = "chat_history",
    srcs = ["chat_history.loom"],
)

loom_library(
    name = "epoch",
    srcs = ["epoch.loom"],
    deps = [
        ":media",
        ":storage",
        "//motif/sequence/qwen3_8:packet",
        "//motif/sequence/qwen3_8:span",
    ],
)

loom_library(
    name = "media",
    srcs = ["media.loom"],
    deps = ["//motif/sequence/qwen3_8:packet"],
)

loom_library(
    name = "storage",
    srcs = ["storage.loom"],
)

loom_library(
    name = "vision_geometry",
    srcs = ["vision_geometry.loom"],
)

loom_library(
    name = "vision_pixels",
    srcs = ["vision_pixels.loom"],
)

loom_library(
    name = "vision_stages",
    srcs = ["vision_stages.loom"],
)

loom_library(
    name = "vision_prepare",
    srcs = ["vision_prepare.loom"],
    deps = [":vision_stages"],
)

loom_library(
    name = "vision_control",
    srcs = ["vision_control.loom"],
    deps = [
        ":vision_pixels",
        ":vision_stages",
        "//motif/vision/qwen3_8:workspace",
    ],
)
