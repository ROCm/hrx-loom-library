    %lhs1_2 = vector.fragment.load<lhs> %input_wave_view[%fragment_row1_2, %fragment_column2] shape [%tile, %tile] : view<64x72xbf16> -> vector<16xbf16>
    %fragment_row2_2 = index.constant 32 : index
    %lhs2_2 = vector.fragment.load<lhs> %input_wave_view[%fragment_row2_2, %fragment_column2] shape [%tile, %tile] : view<64x72xbf16> -> vector<16xbf16>
