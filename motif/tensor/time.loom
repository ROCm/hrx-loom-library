// One feature from a cosine-then-sine sinusoidal embedding of BF16 time.
// The caller supplies the positive half-width, a channel below twice that
// width, the negative logarithm of the period, and an F32 time scale.
// Half-width fits U32; arithmetic inputs and intermediates remain finite.
// Frequency, scaled time, and phase have separate F32 rounding boundaries.
// Exponential and trigonometric math are approximate; publication is BF16.
template.decl @time.sinusoidal_element_bf16(%half_width: index, %channel: index, %negative_log_period: f32, %time_scale: f32, %time: bf16) -> (bf16)

template.def<@time.sinusoidal_element_bf16> device @time_sinusoidal_element_bf16(%half_width: index, %channel: index, %negative_log_period: f32, %time_scale: f32, %time: bf16) -> (bf16) {
  %frequency_index = index.rem %channel, %half_width : index
  %frequency_i32 = index.cast %frequency_index : index to i32
  %frequency_f32 = scalar.uitofp %frequency_i32 : i32 to f32
  %half_i32 = index.cast %half_width : index to i32
  %half_f32 = scalar.uitofp %half_i32 : i32 to f32
  %scaled_index = scalar.mulf %negative_log_period, %frequency_f32 : f32
  %exponent = scalar.divf %scaled_index, %half_f32 : f32
  %frequency = scalar.expf<afn> %exponent : f32
  %time_f32 = scalar.extf %time : bf16 to f32
  %scaled_time = scalar.mulf %time_f32, %time_scale : f32
  %angle = scalar.mulf %scaled_time, %frequency : f32
  %cosine_half = index.cmp ult, %channel, %half_width : index
  %value = scf.if %cosine_half -> (f32) {
    %cosine = scalar.cosf<afn> %angle : f32
    scf.yield %cosine : f32
  } else {
    %sine = scalar.sinf<afn> %angle : f32
    scf.yield %sine : f32
  }
  %rounded = scalar.fptrunc %value : f32 to bf16
  template.return %rounded : bf16
}
