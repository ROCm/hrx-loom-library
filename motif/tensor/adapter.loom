      vector.fragment.store<result> %combined12, %output_view[%result_row1, %result_column2] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%outputs]xbf16, %output_layout>
    }
  }
  %row_valid13 = index.cmp ult, %result_row1, %rows : index
  %column_valid13 = index.cmp ult, %result_column3, %outputs : index
