// Channel normalization checks ordered F32 accumulation, post-root clamping,
// channel-first addressing, and exact input/output aliasing. An independent VM
// oracle uses correctly rounded roots on the zero/normal input domain; device
// roots retain their derived 2^-20 relative allowance. Directed single-channel
// arithmetic, immutable operands, and allocation guards compare bitwise.
// SiLU uses strict F64 exponential evaluation before F32 publication.

config.def @test.channel_norm.workgroup_size = 32 : %value: index where [range(%value, 32, 256)]

amdgpu.target<gfx11-generic> @channel_norm_wave32 {subgroup_size = 32}

template.decl @image.channel_norm_f32(%pixels: index, %channels: index, %pixel: index, %silu: i1, %minimum_norm: f32, %input: buffer, %weight: buffer, %output: buffer)

// Random input values occupy the interior; guards and directed columns are
// authored here. Patterns select general rows, the singleton, or clamp factors.
func.def @initialize_channel_norm(%pixels_value: index, %channels_value: index, %minimum_norm: f32, %silu: i1, %pattern: index, %parameters: buffer, %input: buffer, %weight: buffer) {
  %pixels = index.assume %pixels_value [ge(%pixels_value, 1), le(%pixels_value, 259)] : index
  %channels = index.assume %channels_value [ge(%channels_value, 1), le(%channels_value, 384)] : index
  %base = index.constant 0 : offset
  %origin = index.constant 64 : offset
  %metadata = buffer.view %parameters[%base] : buffer -> view<4xi32>
  %pixels_word = index.cast %pixels : index to i32
  %channels_word = index.cast %channels : index to i32
  %minimum_word = scalar.bitcast %minimum_norm : f32 to i32
  view.store %pixels_word, %metadata[0] : i32, view<4xi32>
  view.store %channels_word, %metadata[1] : i32, view<4xi32>
  view.store %minimum_word, %metadata[2] : i32, view<4xi32>
  %silu_word = scalar.extui %silu : i1 to i32
  view.store %silu_word, %metadata[3] : i32, view<4xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c7 = index.constant 7 : index
  %c9 = index.constant 9 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %count = index.mul %pixels, %channels : index
  %input_count = index.add %count, %c32 : index
  %weight_count = index.add %channels, %c32 : index
  %input_suffix = index.add %count, %c16 : index
  %weight_suffix = index.add %channels, %c16 : index
  %input_storage = buffer.view %input[%base] : buffer -> view<[%input_count]xf32>
  %weight_storage = buffer.view %weight[%base] : buffer -> view<[%weight_count]xf32>
  %input_guard = scalar.constant 123.25 : f32
  %weight_guard = scalar.constant 333.25 : f32
  scf.for %i = [%c0 to %c16 step %c1] {
    %input_end = index.add %input_suffix, %i : index
    %weight_end = index.add %weight_suffix, %i : index
    view.store %input_guard, %input_storage[%i] : f32, view<[%input_count]xf32>
    view.store %input_guard, %input_storage[%input_end] : f32, view<[%input_count]xf32>
    view.store %weight_guard, %weight_storage[%i] : f32, view<[%weight_count]xf32>
    view.store %weight_guard, %weight_storage[%weight_end] : f32, view<[%weight_count]xf32>
  }
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c2_f32 = scalar.constant 2.0 : f32
  %c3_f32 = scalar.constant 3.0 : f32
  %cneg1_f32 = scalar.constant -1.0 : f32
  %cneg2_f32 = scalar.constant -2.0 : f32
  %half = scalar.constant 0.5 : f32
  %negative_half = scalar.constant -0.5 : f32
  %quarter = scalar.constant 0.25 : f32
  %eighth = scalar.constant 0.125 : f32
  %five_quarters = scalar.constant 1.25 : f32
  %negative_seven_quarters = scalar.constant -1.75 : f32
  %sign_bit = scalar.constant -2147483648 : i32
  %negative_zero = scalar.bitcast %sign_bit : i32 to f32
  %weights = buffer.view %weight[%origin] : buffer -> view<[%channels]xf32>
  scf.for %channel = [%c0 to %channels step %c1] {
    %choice = index.rem %channel, %c7 : index
    %gamma = scf.lookup %choice {
      0 = (%c1_f32),
      1 = (%negative_half),
      2 = (%c0_f32),
      3 = (%five_quarters),
      4 = (%negative_seven_quarters),
      5 = (%eighth)
    } default(%c2_f32) : f32
    view.store %gamma, %weights[%channel] : f32, view<[%channels]xf32>
  }
  %singleton = index.cmp eq, %pattern, %c1 : index
  %clamp = index.cmp uge, %pattern, %c2 : index
  scf.if %singleton {
    %value = buffer.view %input[%origin] : buffer -> view<1xf32>
    view.store %cneg2_f32, %value[0] : f32, view<1xf32>
  } else {
    scf.if %clamp {
      %exact = index.cmp eq, %pattern, %c3 : index
      %small_scale = scalar.mulf %minimum_norm, %quarter : f32
      %scale = scf.select %exact, %small_scale, %minimum_norm : f32
      %values = buffer.view %input[%origin] : buffer -> view<9xf32>
      scf.for %pixel = [%c0 to %c9 step %c1] {
        %factor = scf.lookup %pixel {
          0 = (%cneg2_f32),
          1 = (%cneg1_f32),
          2 = (%negative_half),
          3 = (%negative_zero),
          4 = (%c0_f32),
          5 = (%half),
          6 = (%c1_f32),
          7 = (%c2_f32)
        } default(%c3_f32) : f32
        %value = scalar.mulf %scale, %factor : f32
        view.store %value, %values[%pixel] : f32, view<9xf32>
      }
    } else {
      %channels_word = index.cast %channels : index to i32
      %channels_f32 = scalar.uitofp %channels_word : i32 to f32
      %divisor = scalar.mulf %c2_f32, %channels_f32 : f32
      %below_clamp = scalar.divf %minimum_norm, %divisor : f32
      %above_clamp = scalar.mulf %minimum_norm, %c2_f32 : f32
      %general_pixels = index.assume %pixels [ge(%pixels, 3)] : index
      %values = buffer.view %input[%origin] : buffer -> view<[%channels]x[%general_pixels]xf32>
      scf.for %channel = [%c0 to %channels step %c1] {
        %parity = index.rem %channel, %c2 : index
        %even = index.cmp eq, %parity, %c0 : index
        %zero = scf.select %even, %c0_f32, %negative_zero : f32
        view.store %zero, %values[%channel, 0] : f32, view<[%channels]x[%general_pixels]xf32>
        view.store %below_clamp, %values[%channel, 1] : f32, view<[%channels]x[%general_pixels]xf32>
        view.store %above_clamp, %values[%channel, 2] : f32, view<[%channels]x[%general_pixels]xf32>
      }
    }
  }
  func.return
}

kernel.def target(@channel_norm_wave32) @normalize_channels(%pixels: index) {
  %threads = config.get @test.channel_norm.workgroup_size : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %padded = index.add %pixels, %tail : index
  %groups = index.div %padded, %threads : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%pixels_value: index, %channels_value: index, %minimum_norm: f32, %silu: i1, %input: buffer, %weight: buffer, %output: buffer) {
  %pixels = index.assume %pixels_value [ge(%pixels_value, 1), le(%pixels_value, 259)] : index
  %channels = index.assume %channels_value [ge(%channels_value, 1), le(%channels_value, 384)] : index
  %threads = config.get @test.channel_norm.workgroup_size : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %pixel = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %pixel, %pixels : index
  scf.if %live {
    %bounded_pixel = index.assume %pixel [ge(%pixel, 0), lt(%pixel, %pixels)] : index
    template.apply<@image.channel_norm_f32>(%pixels, %channels, %bounded_pixel, %silu, %minimum_norm, %input, %weight, %output) : (index, index, index, i1, f32, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def target(@channel_norm_wave32) @normalize_channels_in_place(%pixels: index) {
  %threads = config.get @test.channel_norm.workgroup_size : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %padded = index.add %pixels, %tail : index
  %groups = index.div %padded, %threads : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%pixels_value: index, %channels_value: index, %minimum_norm: f32, %silu: i1, %input: buffer, %weight: buffer) {
  %pixels = index.assume %pixels_value [ge(%pixels_value, 1), le(%pixels_value, 259)] : index
  %channels = index.assume %channels_value [ge(%channels_value, 1), le(%channels_value, 384)] : index
  %threads = config.get @test.channel_norm.workgroup_size : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %pixel = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %pixel, %pixels : index
  scf.if %live {
    %bounded_pixel = index.assume %pixel [ge(%pixel, 0), lt(%pixel, %pixels)] : index
    template.apply<@image.channel_norm_f32>(%pixels, %channels, %bounded_pixel, %silu, %minimum_norm, %input, %weight, %input) : (index, index, index, i1, f32, buffer, buffer, buffer)
  }
  kernel.return
}

// Ordered F32 accumulation is the operation's numerical contract. The VM
// supplies a correctly rounded root for these zero/normal nonnegative sums;
// the device root is allowed its separate native approximation budget.
func.def @channel_norm_reference(%parameters: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %metadata = buffer.view %parameters[%base] : buffer -> view<4xi32>
  %pixels_word = view.load %metadata[0] : view<4xi32> -> i32
  %channels_word = view.load %metadata[1] : view<4xi32> -> i32
  %minimum_word = view.load %metadata[2] : view<4xi32> -> i32
  %silu_word = view.load %metadata[3] : view<4xi32> -> i32
  %silu = scalar.trunci %silu_word : i32 to i1
  %pixels_value = index.cast %pixels_word : i32 to index
  %channels_value = index.cast %channels_word : i32 to index
  %minimum_norm = scalar.bitcast %minimum_word : i32 to f32
  %pixels = index.assume %pixels_value [ge(%pixels_value, 1), le(%pixels_value, 259)] : index
  %channels = index.assume %channels_value [ge(%channels_value, 1), le(%channels_value, 384)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %channel_word = index.cast %channels : index to i32
  %channel_count = scalar.uitofp %channel_word : i32 to f32
  %scale = scalar.sqrtf %channel_count : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%channels]x[%pixels]xf32>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%channels]xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%channels]x[%pixels]xf32>
  scf.for %pixel = [%c0 to %pixels step %c1] {
    %squared = scf.for %channel = [%c0 to %channels step %c1](%sum = %c0_f32 : f32) -> (f32) {
      %value = view.load %inputs[%channel, %pixel] : view<[%channels]x[%pixels]xf32> -> f32
      %next = scalar.fmaf %value, %value, %sum : f32
      scf.yield %next : f32
    }
    %length = scalar.sqrtf %squared : f32
    %clamped = scalar.cmpf olt, %length, %minimum_norm : f32
    %denominator = scf.select %clamped, %minimum_norm, %length : f32
    scf.for %channel = [%c0 to %channels step %c1] {
      %value = view.load %inputs[%channel, %pixel] : view<[%channels]x[%pixels]xf32> -> f32
      %gamma = view.load %weights[%channel] : view<[%channels]xf32> -> f32
      %normalized = scalar.divf %value, %denominator : f32
      %scaled = scalar.mulf %normalized, %scale : f32
      %affine = scalar.mulf %scaled, %gamma : f32
      %result = scf.if %silu -> (f32) {
        %affine_f64 = scalar.extf %affine : f32 to f64
        %negative = scalar.negf %affine_f64 : f64
        %exponential = scalar.expf %negative : f64
        %c1_f64 = scalar.constant 1.0 : f64
        %divisor = scalar.addf %c1_f64, %exponential : f64
        %activated = scalar.divf %affine_f64, %divisor : f64
        %rounded = scalar.fptrunc %activated : f64 to f32
        scf.yield %rounded : f32
      } else {
        scf.yield %affine : f32
      }
      view.store %result, %outputs[%channel, %pixel] : f32, view<[%channels]x[%pixels]xf32>
    }
  }
  func.return
}

func.def @channel_norm_reference_in_place(%parameters: buffer, %input: buffer, %weight: buffer) {
  func.call @channel_norm_reference(%parameters, %input, %weight, %input) : (buffer, buffer, buffer, buffer)
  func.return
}

command.program.def @channel_norm_program(%pixels: index, %channels: index, %minimum_norm: f32, %silu: i1) launch(%parameters: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  kernel.launch @normalize_channels[%pixels](%pixels, %channels, %minimum_norm, %silu, %input, %weight, %output) : [index](index, index, f32, i1, buffer, buffer, buffer)
  command.return
}

command.program.def @channel_norm_in_place_program(%pixels: index, %channels: index, %minimum_norm: f32, %silu: i1) launch(%parameters: buffer, %input: buffer, %weight: buffer) {
  kernel.launch @normalize_channels_in_place[%pixels](%pixels, %channels, %minimum_norm, %silu, %input, %weight) : [index](index, index, f32, i1, buffer, buffer)
  command.return
}

check.scenario public @affine_single {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %pixels = check.literal value(1) : index
  %channels = check.literal value(1) : index
  %minimum_norm = check.literal value(9.9999999999999998e-13) : f32
  %silu = check.literal value(false) : i1
  %pattern = check.literal value(1) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<33xf32>
    %weight_storage = check.generate.fill value(333.25) : tensor<33xf32>
    check.generate<@initialize_channel_norm>(%pixels, %channels, %minimum_norm, %silu, %pattern, %parameters, %input_storage, %weight_storage) : (index, index, f32, i1, index, tensor<4xi32>, tensor<33xf32>, tensor<33xf32>) -> ()
    %input = check.tensor.view %input_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %output_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<33xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(68) : tensor<33xf32> -> tensor<16xf32>
    check.compare<@channel_norm_program, @channel_norm_reference>[%pixels, %channels, %minimum_norm, %silu](%parameters, %input, %weight, %output) : [index, index, f32, i1](tensor<4xi32>, tensor<1xf32>, tensor<1xf32>, tensor<1xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<33xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<33xf32>
    }
  }
  check.return
}

check.benchmark<@affine_single> @affine_single_normalize

check.scenario public @affine_tail {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %pixels = check.literal value(35) : index
  %channels = check.literal value(3) : index
  %minimum_norm = check.literal value(9.9999999999999998e-13) : f32
  %silu = check.literal value(false) : i1
  %pattern = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<137xf32>
    %weight_storage = check.generate.fill value(333.25) : tensor<35xf32>
    check.generate<@initialize_channel_norm>(%pixels, %channels, %minimum_norm, %silu, %pattern, %parameters, %input_storage, %weight_storage) : (index, index, f32, i1, index, tensor<4xi32>, tensor<137xf32>, tensor<35xf32>) -> ()
    %input = check.tensor.view %input_storage offset(64) : tensor<137xf32> -> tensor<105xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<35xf32> -> tensor<3xf32>
    %output_storage = check.generate.fill value(123.25) : tensor<137xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<137xf32> -> tensor<105xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<137xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(484) : tensor<137xf32> -> tensor<16xf32>
    check.compare<@channel_norm_program, @channel_norm_reference>[%pixels, %channels, %minimum_norm, %silu](%parameters, %input, %weight, %output) : [index, index, f32, i1](tensor<4xi32>, tensor<105xf32>, tensor<3xf32>, tensor<105xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(9.5367431640625e-07) nan(different) : tensor<105xf32>, tensor<105xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<35xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<137xf32>
    }
  }
  check.return
}

check.benchmark<@affine_tail> @affine_tail_normalize

check.scenario public @affine_exact_group {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %pixels = check.literal value(64) : index
  %channels = check.literal value(16) : index
  %minimum_norm = check.literal value(9.9999999999999998e-13) : f32
  %silu = check.literal value(false) : i1
  %pattern = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<1056xf32>
    %weight_storage = check.generate.fill value(333.25) : tensor<48xf32>
    check.generate<@initialize_channel_norm>(%pixels, %channels, %minimum_norm, %silu, %pattern, %parameters, %input_storage, %weight_storage) : (index, index, f32, i1, index, tensor<4xi32>, tensor<1056xf32>, tensor<48xf32>) -> ()
    %input = check.tensor.view %input_storage offset(64) : tensor<1056xf32> -> tensor<1024xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<48xf32> -> tensor<16xf32>
    %output_storage = check.generate.fill value(123.25) : tensor<1056xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<1056xf32> -> tensor<1024xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<1056xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(4160) : tensor<1056xf32> -> tensor<16xf32>
    check.compare<@channel_norm_program, @channel_norm_reference>[%pixels, %channels, %minimum_norm, %silu](%parameters, %input, %weight, %output) : [index, index, f32, i1](tensor<4xi32>, tensor<1024xf32>, tensor<16xf32>, tensor<1024xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(9.5367431640625e-07) nan(different) : tensor<1024xf32>, tensor<1024xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<48xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1056xf32>
    }
  }
  check.return
}

check.benchmark<@affine_exact_group> @affine_exact_group_normalize

check.scenario public @affine_in_place {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %pixels = check.literal value(7) : index
  %channels = check.literal value(384) : index
  %minimum_norm = check.literal value(9.9999999999999998e-13) : f32
  %silu = check.literal value(false) : i1
  %pattern = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<2720xf32>
    %weight_storage = check.generate.fill value(333.25) : tensor<416xf32>
    check.generate<@initialize_channel_norm>(%pixels, %channels, %minimum_norm, %silu, %pattern, %parameters, %input_storage, %weight_storage) : (index, index, f32, i1, index, tensor<4xi32>, tensor<2720xf32>, tensor<416xf32>) -> ()
    %input = check.tensor.view %input_storage offset(64) : tensor<2720xf32> -> tensor<2688xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<416xf32> -> tensor<384xf32>
    %prefix = check.tensor.view %input_storage offset(0) : tensor<2720xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %input_storage offset(10816) : tensor<2720xf32> -> tensor<16xf32>
    check.compare<@channel_norm_in_place_program, @channel_norm_reference_in_place>[%pixels, %channels, %minimum_norm, %silu](%parameters, %input, %weight) : [index, index, f32, i1](tensor<4xi32>, tensor<2688xf32>, tensor<384xf32>) -> () {
      check.expect.approximate actual(%input) expected(%input) atol(0.0) rtol(9.5367431640625e-07) nan(different) : tensor<2688xf32>, tensor<2688xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<416xf32>
    }
  }
