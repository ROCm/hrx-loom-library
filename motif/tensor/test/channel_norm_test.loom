    check.compare<@normalize_multiple_groups, @reference_multiple_groups>(%input, %weight, %output) : (tensor<1813xf32>, tensor<7xf32>, tensor<1813xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(9.5367431640625e-07) nan(different) : tensor<1813xf32>, tensor<1813xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<39xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1845xf32>
    }
  }
  check.return
}

check.benchmark<@multiple_groups> @multiple_groups_normalize
