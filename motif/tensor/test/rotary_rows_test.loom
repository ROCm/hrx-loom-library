  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    %pattern = check.literal value(3) : index
    %adjacent = check.literal value(true) : i1
    %normalized = check.literal value(true) : i1
    %epsilon = check.literal value(9.9999997473787516e-06) : f32
    %input_storage = check.generate.fill value(-12345) : tensor<800xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<800xi16> -> tensor<768xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<160xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<160xf32> -> tensor<128xf32>
    %cosine_storage = check.generate.fill value(123.0) : tensor<288xf32>
    %cosine = check.tensor.view %cosine_storage offset(64) : tensor<288xf32> -> tensor<256xf32>
    %sine_storage = check.generate.fill value(123.0) : tensor<288xf32>
    %sine = check.tensor.view %sine_storage offset(64) : tensor<288xf32> -> tensor<256xf32>
    check.generate<@initialize_rotary_rows>(%pattern, %adjacent, %normalized, %epsilon, %parameters, %input, %weight, %cosine_storage, %sine_storage) : (index, i1, i1, f32, tensor<3xi32>, tensor<768xbf16>, tensor<128xf32>, tensor<288xf32>, tensor<288xf32>) -> ()
    %prefix = check.tensor.view %input_storage offset(0) : tensor<800xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %input_storage offset(1568) : tensor<800xi16> -> tensor<16xi16>
    check.compare<@apply_adjacent_inplace, @reference_rotary_rows>(%parameters, %input, %weight, %cosine, %sine, %input) : (tensor<3xi32>, tensor<768xbf16>, tensor<128xf32>, tensor<256xf32>, tensor<256xf32>, tensor<768xbf16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<768xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<160xf32>
      check.expect.bitwise actual(%cosine_storage) expected(%cosine_storage) : tensor<288xf32>
      check.expect.bitwise actual(%sine_storage) expected(%sine_storage) : tensor<288xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@adjacent_inplace> @adjacent_inplace_benchmark

check.scenario public @normalized_half_inplace {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    %pattern = check.literal value(3) : index
    %adjacent = check.literal value(false) : i1
    %normalized = check.literal value(true) : i1
    %epsilon = check.literal value(9.9999999747524271e-07) : f32
    %input_storage = check.generate.fill value(-12345) : tensor<800xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<800xi16> -> tensor<768xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<160xbf16>
    %weight = check.tensor.view %weight_storage offset(32) : tensor<160xbf16> -> tensor<128xbf16>
    %cosine_storage = check.generate.fill value(123.0) : tensor<288xbf16>
    %cosine = check.tensor.view %cosine_storage offset(32) : tensor<288xbf16> -> tensor<256xbf16>
    %sine_storage = check.generate.fill value(123.0) : tensor<288xbf16>
    %sine = check.tensor.view %sine_storage offset(32) : tensor<288xbf16> -> tensor<256xbf16>
    check.generate<@initialize_rotary_rows>(%pattern, %adjacent, %normalized, %epsilon, %parameters, %input, %weight, %cosine_storage, %sine_storage) : (index, i1, i1, f32, tensor<3xi32>, tensor<768xbf16>, tensor<128xbf16>, tensor<288xbf16>, tensor<288xbf16>) -> ()
    %prefix = check.tensor.view %input_storage offset(0) : tensor<800xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %input_storage offset(1568) : tensor<800xi16> -> tensor<16xi16>
    check.compare<@apply_normalized_half_inplace, @reference_rotary_rows>(%parameters, %input, %weight, %cosine, %sine, %input) : (tensor<3xi32>, tensor<768xbf16>, tensor<128xbf16>, tensor<256xbf16>, tensor<256xbf16>, tensor<768xbf16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<768xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<160xbf16>
      check.expect.bitwise actual(%cosine_storage) expected(%cosine_storage) : tensor<288xbf16>
      check.expect.bitwise actual(%sine_storage) expected(%sine_storage) : tensor<288xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@normalized_half_inplace> @normalized_half_inplace_benchmark
