// Row rotation distinguishes adjacent and half pairing, per-token tables, and
// BF16 product boundaries. Independent scalar oracles use F64 roots and trig;
// normalized rows retain their BF16 values across the inverse error interval.
// Nonzero origins, immutable operands, guards, and exact aliasing are checked.

amdgpu.target<gfx11-generic> @rotary_rows_wave32 {subgroup_size = 32}

template.decl @attention.normalize_rotary_bf16(%tokens: index, %heads: index, %width: index, %epsilon: f32, %input: buffer, %weight: buffer, %cosine: buffer, %sine: buffer, %output: buffer)

template.decl @attention.normalize_half_rotary_bf16(%tokens: index, %heads: index, %width: index, %epsilon: f32, %input: buffer, %weight: buffer, %cosine: buffer, %sine: buffer, %output: buffer)

template.decl @attention.half_rotary_bf16(%tokens: index, %heads: index, %width: index, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @reference_rotary_rows(%parameters: buffer, %input: buffer, %weight: buffer, %cosine: buffer, %sine: buffer, %output: buffer)

// Dyadic inputs and per-channel weights retain exact signs and magnitudes.
// Patterns select sampled coefficients, unit boundaries, signed zeros, or
// analytic per-token sine/cosine tables.
func.def @initialize_rotary_rows(%pattern: index, %adjacent: i1, %normalized: i1, %epsilon: f32, %parameters: buffer, %input: buffer, %weight: buffer, %cosine_storage: buffer, %sine_storage: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %parameters[%origin] : buffer -> view<3xi32>
  %adjacent_word = scalar.extui %adjacent : i1 to i32
  %normalized_word = scalar.extui %normalized : i1 to i32
  %epsilon_word = scalar.bitcast %epsilon : f32 to i32
  view.store %adjacent_word, %metadata[0] : i32, view<3xi32>
  view.store %normalized_word, %metadata[1] : i32, view<3xi32>
  view.store %epsilon_word, %metadata[2] : i32, view<3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c11 = index.constant 11 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %weight_length = buffer.length %weight
  %weight_bytes = index.cast %weight_length : offset to index
  %element_bytes = scf.select %adjacent, %c4, %c2 : index
  %width = index.div %weight_bytes, %element_bytes : index
  %input_length = buffer.length %input
  %input_bytes = index.cast %input_length : offset to index
  %row_bytes = index.mul %width, %c2 : index
  %rows = index.div %input_bytes, %row_bytes : index
  %unit = index.cmp eq, %pattern, %c1 : index
  %zeroed = index.cmp eq, %pattern, %c2 : index
  %analytic = index.cmp eq, %pattern, %c3 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c2_f32 = scalar.constant 2.0 : f32
  %cneg1_f32 = scalar.constant -1.0 : f32
  %cneg2_f32 = scalar.constant -2.0 : f32
  %half = scalar.constant 0.5 : f32
  %negative_half = scalar.constant -0.5 : f32
  %quarter = scalar.constant 0.25 : f32
  %negative_quarter = scalar.constant -0.25 : f32
  %three_quarters = scalar.constant 0.75 : f32
  %negative_three_quarters = scalar.constant -0.75 : f32
  %three_halves = scalar.constant 1.5 : f32
  %negative_three_halves = scalar.constant -1.5 : f32
  %perturbation = scalar.constant 0.0009765625 : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%rows]x[%width]xi16>
  scf.for %row = [%c0 to %rows step %c1] {
    %row_part = index.mul %row, %c7 : index
    scf.for %column = [%c0 to %width step %c1] {
      %affine = index.madd %column, %c11, %row_part : index
      %choice = index.rem %affine, %c8 : index
      %sample = scf.lookup %choice {
        0 = (%cneg2_f32),
        1 = (%cneg1_f32),
        2 = (%negative_half),
        3 = (%negative_quarter),
        4 = (%quarter),
        5 = (%half),
        6 = (%c1_f32)
      } default(%c2_f32) : f32
      %negative = scalar.cmpf olt, %sample, %c0_f32 : f32
      %magnitude = scf.select %zeroed, %c0_f32, %c1_f32 : f32
      %negated = scalar.negf %magnitude : f32
      %signed = scf.select %negative, %negated, %magnitude : f32
      %directed = scalar.ori %unit, %zeroed : i1
      %value = scf.select %directed, %signed, %sample : f32
      %bits = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
      view.store %bits, %inputs[%row, %column] : i16, view<[%rows]x[%width]xi16>
    }
  }
  scf.for %column = [%c0 to %width step %c1] {
    %affine = index.mul %column, %c5 : index
    %choice = index.rem %affine, %c6 : index
    %value = scf.lookup %choice {
      0 = (%negative_three_halves),
      1 = (%negative_three_quarters),
      2 = (%negative_quarter),
      3 = (%quarter),
      4 = (%three_quarters)
    } default(%three_halves) : f32
    scf.if %adjacent {
      %values = buffer.view %weight[%origin] : buffer -> view<[%width]xf32>
      %perturbed = scalar.addf %value, %perturbation : f32
      view.store %perturbed, %values[%column] : f32, view<[%width]xf32>
    } else {
      %values = buffer.view %weight[%origin] : buffer -> view<[%width]xi16>
      %bits = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
      view.store %bits, %values[%column] : i16, view<[%width]xi16>
    }
  }
  %table_length = buffer.length %cosine_storage
  %table_bytes = index.cast %table_length : offset to index
  %storage_count = index.div %table_bytes, %element_bytes : index
  %table_count = index.sub %storage_count, %c32 : index
  %suffix = index.add %table_count, %c16 : index
  %guard = scalar.constant 123.0 : f64
  %cosine_period = scalar.constant 17.0 : f64
  %sine_period = scalar.constant 23.0 : f64
  %directed = scalar.ori %unit, %analytic : i1
  scf.for %i = [%c0 to %storage_count step %c1] {
    %prefix = index.cmp ult, %i, %c16 : index
    %suffix_element = index.cmp uge, %i, %suffix : index
    %outside = scalar.ori %prefix, %suffix_element : i1
    %write = scalar.ori %outside, %directed : i1
    scf.if %write {
      %cosine_value, %sine_value = scf.if %outside -> (f64, f64) {
        scf.yield %guard, %guard : f64, f64
      } else {
        %position = index.sub %i, %c16 : index
        %cosine_value, %sine_value = scf.if %analytic -> (f64, f64) {
          %token = index.div %position, %width : index
          %column = index.rem %position, %width : index
          %cosine_row = index.add %token, %c1 : index
          %sine_row = index.add %token, %c2 : index
          %cosine_column = index.add %column, %c3 : index
          %sine_column = index.add %column, %c5 : index
          %cosine_numerator = index.mul %cosine_row, %cosine_column : index
          %sine_numerator = index.mul %sine_row, %sine_column : index
          %cosine_word = index.cast %cosine_numerator : index to i32
          %sine_word = index.cast %sine_numerator : index to i32
          %cosine_number = scalar.uitofp %cosine_word : i32 to f64
          %sine_number = scalar.uitofp %sine_word : i32 to f64
          %cosine_phase = scalar.divf %cosine_number, %cosine_period : f64
          %sine_phase = scalar.divf %sine_number, %sine_period : f64
          %cosine_value = scalar.cosf %cosine_phase : f64
          %sine_value = scalar.sinf %sine_phase : f64
          scf.yield %cosine_value, %sine_value : f64, f64
        } else {
          %cosine_index = index.rem %position, %c5 : index
          %shifted = index.add %position, %c1 : index
          %sine_index = index.rem %shifted, %c5 : index
          %cosine = scf.lookup %cosine_index {
            0 = (%c0_f32),
            1 = (%half),
            2 = (%c1_f32),
            3 = (%negative_half)
          } default(%cneg1_f32) : f32
          %sine = scf.lookup %sine_index {
            0 = (%c0_f32),
            1 = (%half),
            2 = (%c1_f32),
            3 = (%negative_half)
          } default(%cneg1_f32) : f32
          %cosine_value = scalar.extf %cosine : f32 to f64
          %sine_value = scalar.extf %sine : f32 to f64
          scf.yield %cosine_value, %sine_value : f64, f64
        }
        scf.yield %cosine_value, %sine_value : f64, f64
      }
      scf.if %adjacent {
        %cosines = buffer.view %cosine_storage[%origin] : buffer -> view<[%storage_count]xf32>
        %sines = buffer.view %sine_storage[%origin] : buffer -> view<[%storage_count]xf32>
        %cosine_f32 = scalar.fptrunc %cosine_value : f64 to f32
        %sine_f32 = scalar.fptrunc %sine_value : f64 to f32
        view.store %cosine_f32, %cosines[%i] : f32, view<[%storage_count]xf32>
        view.store %sine_f32, %sines[%i] : f32, view<[%storage_count]xf32>
      } else {
        %cosines = buffer.view %cosine_storage[%origin] : buffer -> view<[%storage_count]xbf16>
        %sines = buffer.view %sine_storage[%origin] : buffer -> view<[%storage_count]xbf16>
        %cosine_bf16 = scalar.fptrunc %cosine_value : f64 to bf16
        %sine_bf16 = scalar.fptrunc %sine_value : f64 to bf16
        view.store %cosine_bf16, %cosines[%i] : bf16, view<[%storage_count]xbf16>
        view.store %sine_bf16, %sines[%i] : bf16, view<[%storage_count]xbf16>
      }
    }
  }
  func.return
}

kernel.def target(@rotary_rows_wave32) @apply_adjacent_unit() {
  %rows = index.constant 1 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%parameters: buffer, %input: buffer, %weight: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %tokens = index.constant 1 : index
  %heads = index.constant 1 : index
  %width = index.constant 64 : index
  %epsilon = scalar.constant 0.0 : f32
  template.apply<@attention.normalize_rotary_bf16>(%tokens, %heads, %width, %epsilon, %input, %weight, %cosine, %sine, %output) : (index, index, index, f32, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

