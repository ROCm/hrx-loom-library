// Shared target/draft order against direct numeric and ID comparisons.
// Runtime records carry a finite F32 logit and nonnegative I32 token ID.
// Every pair, recovered ID, empty sentinel, and complete storage is checked.

amdgpu.target<gfx11-generic> @native

func.decl @sampling_key(%value: f32, %id: i32) -> (i64)

// Each finite endpoint occurs with ID zero and INT_MAX. Adjacent entries
// straddle signed zero, normal/subnormal, and unit-magnitude boundaries.
global.rodata.def @directed_records = bytes("")

func.def @initialize_directed(%input: buffer) {
  %source = global.load @directed_records : buffer
  %source_origin = index.constant 0 : offset
  %input_origin = index.constant 16 : offset
  %record_bytes = index.constant 256 : offset
  buffer.copy %source[%source_origin], %input[%input_origin], %record_bytes
  func.return
}

func.def @initialize_ids(%input: buffer) {
  %origin = index.constant 16 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %count = index.constant 32 : index
  %stride = scalar.constant 67108863 : i32
  %records = buffer.view %input[%origin] : buffer -> view<32x2xi32>
  scf.for %row = [%begin to %count step %unit] {
    %ordinal = index.cast %row : index to i32
    %id = scalar.muli %ordinal, %stride : i32
    view.store %id, %records[%row, 1] : i32, view<32x2xi32>
  }
  func.return
}

kernel.def target(@native) @compare_keys() {
  %rows = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%rows, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %column = kernel.workitem.id<x> : index
  %begin = index.constant 0 : index
  %origin = index.constant 16 : offset
  %id_origin = index.constant 4112 : offset
  %sentinel_origin = index.constant 4240 : offset
  %records = buffer.view %input[%origin] : buffer -> view<32x2xi32>
  %comparisons = buffer.view %output[%origin] : buffer -> view<32x32xi32>
  %ids = buffer.view %output[%id_origin] : buffer -> view<32xi32>
  %sentinels = buffer.view %output[%sentinel_origin] : buffer -> view<32xi32>
  %left_bits = view.load %records[%row, 0] : view<32x2xi32> -> i32
  %right_bits = view.load %records[%column, 0] : view<32x2xi32> -> i32
  %left_id = view.load %records[%row, 1] : view<32x2xi32> -> i32
  %right_id = view.load %records[%column, 1] : view<32x2xi32> -> i32
  %left = scalar.bitcast %left_bits : i32 to f32
  %right = scalar.bitcast %right_bits : i32 to f32
  %left_key = func.call @sampling_key(%left, %left_id) : (f32, i32) -> (i64)
  %right_key = func.call @sampling_key(%right, %right_id) : (f32, i32) -> (i64)
  %greater = scalar.cmpi ugt, %left_key, %right_key : i64
  %result = scalar.extui %greater : i1 to i32
  view.store %result, %comparisons[%row, %column] : i32, view<32x32xi32>
  %leader = index.cmp eq, %column, %begin : index
  scf.if %leader {
    %inverse = scalar.trunci %left_key : i64 to i32
    %all_bits = scalar.constant -1 : i32
    %recovered = scalar.xori %inverse, %all_bits : i32
    view.store %recovered, %ids[%row] : i32, view<32xi32>
    %empty = scalar.constant 0 : i64
    %valid = scalar.cmpi ugt, %left_key, %empty : i64
    %valid_word = scalar.extui %valid : i1 to i32
    view.store %valid_word, %sentinels[%row] : i32, view<32xi32>
  }
  kernel.return
}

func.def @reference(%input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %count = index.constant 32 : index
  %origin = index.constant 16 : offset
  %id_origin = index.constant 4112 : offset
  %sentinel_origin = index.constant 4240 : offset
  %valid = scalar.constant 1 : i32
  %values = buffer.view %input[%origin] : buffer -> view<32x2xf32>
  %records = buffer.view %input[%origin] : buffer -> view<32x2xi32>
  %comparisons = buffer.view %output[%origin] : buffer -> view<32x32xi32>
  %ids = buffer.view %output[%id_origin] : buffer -> view<32xi32>
  %sentinels = buffer.view %output[%sentinel_origin] : buffer -> view<32xi32>
  scf.for %row = [%begin to %count step %unit] {
    %left = view.load %values[%row, 0] : view<32x2xf32> -> f32
    %left_wide = scalar.extf %left : f32 to f64
    %left_id = view.load %records[%row, 1] : view<32x2xi32> -> i32
    view.store %left_id, %ids[%row] : i32, view<32xi32>
    view.store %valid, %sentinels[%row] : i32, view<32xi32>
    scf.for %column = [%begin to %count step %unit] {
      %right = view.load %values[%column, 0] : view<32x2xf32> -> f32
      %right_wide = scalar.extf %right : f32 to f64
      %right_id = view.load %records[%column, 1] : view<32x2xi32> -> i32
      %greater = scalar.cmpf ogt, %left_wide, %right_wide : f64
      %equal = scalar.cmpf oeq, %left_wide, %right_wide : f64
      %lower_id = scalar.cmpi slt, %left_id, %right_id : i32
      %tie = scalar.andi %equal, %lower_id : i1
      %precedes = scalar.ori %greater, %tie : i1
      %result = scalar.extui %precedes : i1 to i32
      view.store %result, %comparisons[%row, %column] : i32, view<32x32xi32>
    }
  }
  func.return
}

check.scenario public @directed {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-1) : tensor<72xi32>
    check.generate<@initialize_directed>(%input) : (tensor<72xi32>) -> ()
    %output = check.generate.fill value(-99) : tensor<1096xi32>
    check.compare<@compare_keys, @reference>(%input, %output) : (tensor<72xi32>, tensor<1096xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1096xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<72xi32>
    }
  }
  check.return
}

check.scenario public @random {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1000.0 to 1000.0) : tensor<72xf32>
    check.generate<@initialize_ids>(%input) : (tensor<72xf32>) -> ()
    %output = check.generate.fill value(-99) : tensor<1096xi32>
    check.compare<@compare_keys, @reference>(%input, %output) : (tensor<72xf32>, tensor<1096xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1096xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<72xf32>
    }
  }
  check.return
}

check.benchmark<@directed> @order_endpoints

check.benchmark<@random> @order_random
