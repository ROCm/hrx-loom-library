// Exercise logical-dimension rounding and grouped tile traversal on the GPU.
// Each configuration binds logical dimensions and their expected launch grid;
// the independent VM oracle enumerates that grid in group/column/row order.
// The 25 configurations cover both-axis tails, all eight group remainders,
// singleton/oversized groups, model dimensions, and the maximum grid.

template.decl @projection.temporal_coordinates(%rows: index, %outputs: index, %group_size: index) -> (index, index)

func.decl @coordinate_storage_size(%rows: index, %columns: index) -> (index)

func.decl @initialize_coordinate_grid(%rows: index, %columns: index, %group: index, %storage: buffer)

func.decl @coordinate_grid_reference(%storage: buffer)

template.decl @coordinate_grid(%configuration: index) -> (index, index, index, index, index)

template.def<@coordinate_grid> @coordinate_grid_values(%configuration: index) -> (index, index, index, index, index) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %c9 = scalar.constant 9 : i32
  %c10 = scalar.constant 10 : i32
  %c11 = scalar.constant 11 : i32
  %c12 = scalar.constant 12 : i32
  %c13 = scalar.constant 13 : i32
  %c14 = scalar.constant 14 : i32
  %c15 = scalar.constant 15 : i32
  %c16 = scalar.constant 16 : i32
  %c33 = scalar.constant 33 : i32
  %c36 = scalar.constant 36 : i32
  %c64 = scalar.constant 64 : i32
  %c96 = scalar.constant 96 : i32
  %c112 = scalar.constant 112 : i32
  %c128 = scalar.constant 128 : i32
  %c144 = scalar.constant 144 : i32
  %c160 = scalar.constant 160 : i32
  %c171 = scalar.constant 171 : i32
  %c176 = scalar.constant 176 : i32
  %c192 = scalar.constant 192 : i32
  %c208 = scalar.constant 208 : i32
  %c272 = scalar.constant 272 : i32
  %c288 = scalar.constant 288 : i32
  %c512 = scalar.constant 512 : i32
  %c1024 = scalar.constant 1024 : i32
  %c1040 = scalar.constant 1040 : i32
  %c1056 = scalar.constant 1056 : i32
  %c1072 = scalar.constant 1072 : i32
  %c1088 = scalar.constant 1088 : i32
  %c1104 = scalar.constant 1104 : i32
  %c1120 = scalar.constant 1120 : i32
  %c1136 = scalar.constant 1136 : i32
  %c1152 = scalar.constant 1152 : i32
  %c1280 = scalar.constant 1280 : i32
  %c1408 = scalar.constant 1408 : i32
  %c1536 = scalar.constant 1536 : i32
  %c1664 = scalar.constant 1664 : i32
  %c1792 = scalar.constant 1792 : i32
  %c1920 = scalar.constant 1920 : i32
  %c4224 = scalar.constant 4224 : i32
  %c4608 = scalar.constant 4608 : i32
  %c6144 = scalar.constant 6144 : i32
  %c16384 = scalar.constant 16384 : i32
  %c65536 = scalar.constant 65536 : i32
  %row_counts = vector.from_elements %c16, %c128, %c144, %c272, %c1040, %c1056, %c1072, %c1088, %c1104, %c1120, %c1136, %c1152, %c1024, %c1152, %c1280, %c1408, %c1536, %c1664, %c1792, %c1920, %c4224, %c4224, %c4608, %c4608, %c65536 : vector<25xi32>
  %column_counts = vector.from_elements %c16, %c96, %c112, %c208, %c112, %c128, %c144, %c160, %c176, %c192, %c112, %c128, %c288, %c288, %c288, %c288, %c288, %c288, %c288, %c288, %c6144, %c16384, %c16384, %c6144, %c16384 : vector<25xi32>
  %group_sizes = vector.from_elements %c1, %c1, %c1, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c8, %c4, %c4, %c8 : vector<25xi32>
  // Expected tile counts are explicit so the test does not repeat the
  // production helper's rounding arithmetic.
  %row_tile_counts = vector.from_elements %c1, %c1, %c2, %c3, %c9, %c9, %c9, %c9, %c9, %c9, %c9, %c9, %c8, %c9, %c10, %c11, %c12, %c13, %c14, %c15, %c33, %c33, %c36, %c36, %c512 : vector<25xi32>
  %column_tile_counts = vector.from_elements %c1, %c1, %c2, %c3, %c2, %c2, %c2, %c2, %c2, %c2, %c2, %c2, %c3, %c3, %c3, %c3, %c3, %c3, %c3, %c3, %c64, %c171, %c171, %c64, %c171 : vector<25xi32>
  %row_word = vector.extract %row_counts[%configuration] : vector<25xi32> -> i32
  %column_word = vector.extract %column_counts[%configuration] : vector<25xi32> -> i32
  %group_word = vector.extract %group_sizes[%configuration] : vector<25xi32> -> i32
  %row_tile_word = vector.extract %row_tile_counts[%configuration] : vector<25xi32> -> i32
  %column_tile_word = vector.extract %column_tile_counts[%configuration] : vector<25xi32> -> i32
  %rows = index.cast %row_word : i32 to index
  %columns = index.cast %column_word : i32 to index
  %group = index.cast %group_word : i32 to index
  %row_tiles = index.cast %row_tile_word : i32 to index
  %column_tiles = index.cast %column_tile_word : i32 to index
  template.return %rows, %columns, %group, %row_tiles, %column_tiles : index, index, index, index, index
}

func.def @generate_coordinate_grid(%configuration: index) -> (index, index, index) {
  %rows, %columns, %group, %row_tiles, %column_tiles = template.apply<@coordinate_grid>(%configuration) : (index) -> (index, index, index, index, index)
  func.return %row_tiles, %column_tiles, %group : index, index, index
}

kernel.def @apply_grid(%row_tiles: index, %column_tiles: index) {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%row_tiles, %column_tiles, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%rows: index, %columns: index, %group: index, %row_tiles: index, %column_tiles: index, %storage: buffer) {
  %row, %column = template.apply<@projection.temporal_coordinates>(%rows, %columns, %group) : (index, index, index) -> (index, index)
  %payload = index.constant 80 : offset
  %row_id = kernel.workgroup.id<x> : index
  %column_id = kernel.workgroup.id<y> : index
  // The launch grid is exactly row_tiles x column_tiles.
  %physical_row = index.assume %row_id [ge(%row_id, 0), lt(%row_id, %row_tiles)] : index
  %physical_column = index.assume %column_id [ge(%column_id, 0), lt(%column_id, %column_tiles)] : index
  %position = index.madd %physical_column, %row_tiles, %physical_row : index
  %count = index.mul %row_tiles, %column_tiles : index
  %row_value = index.cast %row : index to i32
  %column_value = index.cast %column : index to i32
  %view = buffer.view %storage[%payload] : buffer -> view<[%count]x2xi32>
  view.store %row_value, %view[%position, 0] : i32, view<[%count]x2xi32>
  view.store %column_value, %view[%position, 1] : i32, view<[%count]x2xi32>
  kernel.return
}

command.program.def @coordinate_program(%configuration: index) launch(%storage: buffer) {
  %rows, %columns, %group, %row_tiles, %column_tiles = template.apply<@coordinate_grid>(%configuration) : (index) -> (index, index, index, index, index)
  kernel.launch @apply_grid[%row_tiles, %column_tiles](%rows, %columns, %group, %row_tiles, %column_tiles, %storage) : [index, index](index, index, index, index, index, buffer)
  command.return
}

check.scenario public @grouped_grid configure[25](%configuration: index, %configuration_entropy: check.entropy) {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %rows, %columns, %group = check.generate<@generate_coordinate_grid>(%configuration) : (index) -> (index, index, index)
    %storage_count = check.generate<@coordinate_storage_size>(%rows, %columns) : (index, index) -> (index)
    %storage = check.generate.fill value(-77) : tensor<[%storage_count]xi32>
    check.generate<@initialize_coordinate_grid>(%rows, %columns, %group, %storage) : (index, index, index, tensor<[%storage_count]xi32>) -> ()
    check.compare<@coordinate_program, @coordinate_grid_reference>[%configuration](%storage) : [index](tensor<[%storage_count]xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<[%storage_count]xi32>
    }
  }
  check.return
}

check.benchmark<@grouped_grid> @grouped_grid_benchmark
