check.scenario public @inverse_unit {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(1) : index
  %width = check.literal value(32) : index
  %epsilon = check.literal value(0.0) : f32
  %pattern = check.literal value(2) : index
  %centered = check.literal value(true) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %input_storage = check.generate.fill value(-12345) : tensor<64xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<64xi16> -> tensor<32xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<64xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<64xf32> -> tensor<32xf32>
    check.generate<@initialize_rms_rows>(%rows, %width, %epsilon, %pattern, %centered, %parameters, %input, %weight) : (index, index, f32, index, i1, tensor<4xi32>, tensor<32xbf16>, tensor<32xf32>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<33xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(68) : tensor<33xf32> -> tensor<16xf32>
    check.compare<@apply_inverse_unit, @rms_inverse_reference>(%parameters, %input, %weight, %output) : (tensor<4xi32>, tensor<32xbf16>, tensor<32xf32>, tensor<1xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(1.52587890625e-05) nan(different) : tensor<1xf32>, tensor<1xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<64xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<64xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@inverse_unit> @inverse_unit_benchmark

check.scenario public @inverse_head_pairs {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(3) : index
  %width = check.literal value(128) : index
  %epsilon = check.literal value(9.9999999999999995e-07) : f32
  %pattern = check.literal value(0) : index
  %centered = check.literal value(true) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %input_storage = check.generate.fill value(-12345) : tensor<416xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<416xi16> -> tensor<384xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<160xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<160xf32> -> tensor<128xf32>
    check.generate<@initialize_rms_rows>(%rows, %width, %epsilon, %pattern, %centered, %parameters, %input, %weight) : (index, index, f32, index, i1, tensor<4xi32>, tensor<384xbf16>, tensor<128xf32>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<35xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<35xf32> -> tensor<3xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<35xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(76) : tensor<35xf32> -> tensor<16xf32>
    check.compare<@apply_inverse_head_pairs, @rms_inverse_reference>(%parameters, %input, %weight, %output) : (tensor<4xi32>, tensor<384xbf16>, tensor<128xf32>, tensor<3xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(1.52587890625e-05) nan(different) : tensor<3xf32>, tensor<3xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<416xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<160xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@inverse_head_pairs> @inverse_head_pairs_benchmark

