global.rodata.def @inverse_unit_input = align(2) bytes("803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf803f80bf")

global.rodata.def @inverse_unit_weight = align(4) bytes("00c0ffbf00c0e5bf00c0cbbf00c0b1bf00c097bf00807bbf008047bf008013bf0000bfbe00002ebe0000083d0000723e0000e13e0080243f0080583f0040863f0040a03f0040ba3f0040d43f0040ee3f00c0f9bf00c0dfbf00c0c5bf00c0abbf00c091bf00806fbf00803bbf008007bf0000a7be0000fcbd0000a43d0000913e")

global.rodata.def @inverse_unit_expected = align(4) bytes("0000803f")

func.def @initialize_inverse_unit(%input: buffer, %weight: buffer) {
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 64 : offset
  %weight_bytes = index.constant 128 : offset
  %inputs = global.load @inverse_unit_input : buffer
  %weights = global.load @inverse_unit_weight : buffer
  buffer.copy %inputs[%origin], %input[%origin], %input_bytes
  buffer.copy %weights[%origin], %weight[%origin], %weight_bytes
  func.return
}

kernel.def target(@rms_rows_wave32) @apply_inverse_unit() {
  %rows = index.constant 1 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 1 : index
  %width = index.constant 32 : index
  %threads = index.constant 32 : index
  %epsilon = scalar.constant 0.0 : f32
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %inverse = template.apply<@normalization.rms_inverse_bf16>(%rows, %width, %threads, %row, %epsilon, %input) : (index, index, index, index, f32, buffer) -> (f32)
  %begin = index.constant 0 : index
  %leader = index.cmp eq, %lane, %begin : index
  scf.if %leader {
    %origin = index.constant 0 : offset
    %outputs = buffer.view %output[%origin] : buffer -> view<[%rows]xf32>
    view.store %inverse, %outputs[%row] : f32, view<[%rows]xf32>
  }
  kernel.return
}

func.def @reference_inverse_unit(%input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %expected = global.load @inverse_unit_expected : buffer
  buffer.copy %expected[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @inverse_unit {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<64xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<64xi16> -> tensor<32xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<64xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<64xf32> -> tensor<32xf32>
    check.generate<@initialize_inverse_unit>(%input, %weight) : (tensor<32xbf16>, tensor<32xf32>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<33xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(68) : tensor<33xf32> -> tensor<16xf32>
    check.compare<@apply_inverse_unit, @reference_inverse_unit>(%input, %weight, %output) : (tensor<32xbf16>, tensor<32xf32>, tensor<1xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(1.52587890625e-05) nan(different) : tensor<1xf32>, tensor<1xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<64xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<64xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@inverse_unit> @inverse_unit_benchmark
