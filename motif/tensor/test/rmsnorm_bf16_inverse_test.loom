// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT

// Whole-row normalization compares native reductions with an independent F64
// oracle. Signed zeros, unit rows, and epsilon-dominated values exercise the
// root and epilogues; immutable operands and allocation guards remain exact.

amdgpu.target<gfx11-generic> @rms_rows_wave32 {subgroup_size = 32}

template.decl @normalization.rms_inverse_bf16(%rows: index, %width: index, %threads: index, %row: index, %epsilon: f32, %input: buffer) -> (f32)

func.decl @initialize_rms_rows(%rows_value: index, %width_value: index, %epsilon: f32, %pattern: index, %centered: i1, %parameters: buffer, %input: buffer, %weight: buffer)

func.decl @rms_inverse_reference(%parameters: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.def target(@rms_rows_wave32) @apply_inverse_unit() {
  %rows = index.constant 1 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%parameters: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 1 : index
  %width = index.constant 32 : index
  %threads = index.constant 32 : index
  %epsilon = scalar.constant 0.0 : f32
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %inverse = template.apply<@normalization.rms_inverse_bf16>(%rows, %width, %threads, %row, %epsilon, %input) : (index, index, index, index, f32, buffer) -> (f32)
  %begin = index.constant 0 : index
  %leader = index.cmp eq, %lane, %begin : index
  scf.if %leader {
    %origin = index.constant 0 : offset
    %outputs = buffer.view %output[%origin] : buffer -> view<[%rows]xf32>
    view.store %inverse, %outputs[%row] : f32, view<[%rows]xf32>
  }
  kernel.return
}

