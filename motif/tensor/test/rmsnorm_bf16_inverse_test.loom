check.scenario public @inverse_epsilon_dominated {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(2) : index
  %width = check.literal value(64) : index
  %epsilon = check.literal value(9.9999999999999995e-07) : f32
  %pattern = check.literal value(3) : index
  %centered = check.literal value(true) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %input_storage = check.generate.fill value(-12345) : tensor<160xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<160xi16> -> tensor<128xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<96xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<96xf32> -> tensor<64xf32>
    check.generate<@initialize_rms_rows>(%rows, %width, %epsilon, %pattern, %centered, %parameters, %input, %weight) : (index, index, f32, index, i1, tensor<4xi32>, tensor<128xbf16>, tensor<64xf32>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<34xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<34xf32> -> tensor<2xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<34xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(72) : tensor<34xf32> -> tensor<16xf32>
    check.compare<@apply_inverse_epsilon_dominated, @rms_inverse_reference>(%parameters, %input, %weight, %output) : (tensor<4xi32>, tensor<128xbf16>, tensor<64xf32>, tensor<2xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(1.52587890625e-05) nan(different) : tensor<2xf32>, tensor<2xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<160xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<96xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@inverse_epsilon_dominated> @inverse_epsilon_dominated_benchmark
