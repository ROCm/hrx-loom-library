loom_test(
    name = "channel_norm",
    srcs = ["channel_norm.loom"],
    execution_profiles = [
        AMD_GPU_HARDWARE_PROFILE,
        amd_gpu_execution_profile(
            name = "amd_gpu_access",
            runner_args = ["--sanitizer=access"],
            tags = ["notsan"],
        ),
    ],
    deps = ["//motif/tensor:channel_norm"],
)

