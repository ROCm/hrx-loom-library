// Shared attention covers K16/K32, four query heads per KV head, channel-first
// values, empty mask tiles, and late maxima. Dense F64 softmax and directed
// probability-rounding cases complement exact masked-mean identities. Scenario
// entropy varies ordinary operands within fixed error budgets; every input and
// output allocation retains immutable storage and guard checks.
//
// General accuracy budgets follow operand magnitude, BF16 probability
// conversion, native contractions, F32 recurrence, and gate/output rounding.
// Single-tile probability cases round unnormalized probabilities but retain
// the unrounded denominator. Inputs stay away from BF16 midpoints throughout
// the fixed arithmetic error interval, so those cases compare exact bits.

amdgpu.target<gfx11-generic> @tensor_shared_attention_rdna3

amdgpu.target<gfx11-generic> @shared_attention_wave32 {subgroup_size = 32}

template.decl @attention.shared_four_head_bf16(%tokens: index, %heads: index, %gated: i1, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer)

template.decl @attention.shared_four_head_k32_bf16(%tokens: index, %heads: index, %gated: i1, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer)

func.decl @initialize_attention_samples(%samples: buffer, %scale: f32, %output: buffer)

func.decl @reference_attention_mean(%transposed: i1, %gated: i1, %value: buffer, %mask: buffer, %output: buffer)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @initialize_attention_options(%row_stride: index, %column_stride: index, %causal: i1, %gated: i1, %round_probability: i1, %parameters: buffer)

func.decl @initialize_attention_numerics(%pattern: index, %tile: index, %mask_begin: index, %mask_end: index, %mask_cycle: index, %parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer)

func.decl @attention_reference(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer)

// Patterns select a last-key copy, all-zero V, equal zero logits with a zero
// gate, or huge negative logits after two entirely masked key tiles.
func.def @initialize_shared_identity(%pattern: index, %tile: index, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer) {
  %bytes = buffer.length %mask
  %tokens = index.cast %bytes : offset to index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %channels = index.constant 128 : index
  %last_channel = index.constant 127 : index
  %query_width = index.constant 512 : index
  %last_token = index.sub %tokens, %c1 : index
  %first_visible = index.sub %tokens, %tile : index
  %single = index.cmp eq, %pattern, %c0 : index
  %zero = index.cmp eq, %pattern, %c1 : index
  %uniform = index.cmp eq, %pattern, %c2 : index
  %negative = index.cmp eq, %pattern, %c3 : index
  %constant_query = index.cmp ne, %pattern, %c0 : index
  %queries = buffer.view %query[%origin] : buffer -> view<[%tokens]x512xi16>
  %keys = buffer.view %key[%origin] : buffer -> view<[%tokens]x128xi16>
  %values = buffer.view %value[%origin] : buffer -> view<128x[%tokens]xi16>
  %visibility = buffer.view %mask[%origin] : buffer -> view<[%tokens]xi8>
  %gates = buffer.view %gate[%origin] : buffer -> view<[%tokens]x512xi16>
  %unset = scalar.constant 0 : i8
  %enabled = scalar.constant 1 : i8
  %all_bits = scalar.constant -1 : i8
  %clear_bits = scalar.constant 0 : i16
  %unit_bits = scalar.constant 16256 : i16
  %huge = scalar.constant 72057594037927936.0 : f32
  %negative_huge = scalar.constant -72057594037927936.0 : f32
  %huge_word = func.call @reference_bf16_bits(%huge) : (f32) -> (i16)
  %negative_word = func.call @reference_bf16_bits(%negative_huge) : (f32) -> (i16)
  scf.for %row = [%c0 to %tokens step %c1] {
    %last = index.cmp eq, %row, %last_token : index
    %visible = index.cmp uge, %row, %first_visible : index
    %single_mask = scf.select %last, %all_bits, %unset : i8
    %negative_mask = scf.select %visible, %enabled, %unset : i8
    %ordinary_mask = scf.select %negative, %negative_mask, %enabled : i8
    %mask_byte = scf.select %single, %single_mask, %ordinary_mask : i8
    view.store %mask_byte, %visibility[%row] : i8, view<[%tokens]xi8>
    scf.for %column = [%c0 to %query_width step %c1] {
      %channel = index.rem %column, %channels : index
      %active_channel = index.cmp eq, %channel, %last_channel : index
      %active = scalar.andi %negative, %active_channel : i1
      %query_word = scf.select %active, %huge_word, %clear_bits : i16
      scf.if %constant_query {
        view.store %query_word, %queries[%row, %column] : i16, view<[%tokens]x512xi16>
      }
      scf.if %uniform {
        view.store %clear_bits, %gates[%row, %column] : i16, view<[%tokens]x512xi16>
      }
    }
    scf.for %channel = [%c0 to %channels step %c1] {
      scf.if %negative {
        %active_channel = index.cmp eq, %channel, %last_channel : index
        %key_word = scf.select %active_channel, %negative_word, %clear_bits : i16
        view.store %key_word, %keys[%row, %channel] : i16, view<[%tokens]x128xi16>
        view.store %unit_bits, %values[%channel, %row] : i16, view<128x[%tokens]xi16>
      }
      scf.if %zero {
        view.store %clear_bits, %values[%channel, %row] : i16, view<128x[%tokens]xi16>
      }
    }
  }
  func.return
}

kernel.def target(@shared_attention_wave32) @apply_shared_attention(%tokens: index, %heads: index) {
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%tokens_value: index, %heads_value: index, %key_tile: index, %gated: i1, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %tokens = index.assume %tokens_value [ge(%tokens_value, 16), le(%tokens_value, 128), multiple_of(%tokens_value, 16)] : index
  %heads = index.assume %heads_value [ge(%heads_value, 1), le(%heads_value, 12)] : index
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %group = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %live_group = index.cmp ult, %group, %groups : index
  %live_head = index.cmp ult, %head, %heads : index
  %live = scalar.andi %live_group, %live_head : i1
  scf.if %live {
    %gate_buffer = scf.if %gated -> (buffer) {
      scf.yield %gate : buffer
    } else {
      scf.yield %output : buffer
    }
    %small = index.cmp eq, %key_tile, %tile : index
    scf.if %small {
      template.apply<@attention.shared_four_head_bf16>(%tokens, %heads, %gated, %query, %key, %value, %mask, %gate_buffer, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      template.apply<@attention.shared_four_head_k32_bf16>(%tokens, %heads, %gated, %query, %key, %value, %mask, %gate_buffer, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
    }
  }
  kernel.return
}

command.def @shared_attention_program(%tokens: index, %key_tile: index, %heads: index, %gated: i1) launch(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  kernel.launch @apply_shared_attention[%tokens, %heads](%tokens, %heads, %key_tile, %gated, %query, %key, %value, %mask, %gate, %output) : [index, index](index, index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @reference_shared_identity(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %transposed = scalar.constant true : i1
  %gated = scalar.constant false : i1
  func.call @reference_attention_mean(%transposed, %gated, %value, %mask, %output) : (i1, i1, buffer, buffer, buffer)
  func.return
}

func.def @reference_shared_gated_identity(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %transposed = scalar.constant true : i1
  %gated = scalar.constant true : i1
  func.call @reference_attention_mean(%transposed, %gated, %value, %mask, %output) : (i1, i1, buffer, buffer, buffer)
  func.return
}

check.scenario public @k16_single {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(48) : index
  %tile = check.literal value(16) : index
  %pattern = check.literal value(0) : index
  %gated = check.literal value(false) : i1
  %heads = check.literal value(1) : index
  %causal = check.literal value(false) : i1
  %row_stride = check.literal value(1) : index
  %column_stride = check.literal value(48) : index
  %rounded = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_storage = check.generate.fill value(123.0) : tensor<24608xbf16>
    %query = check.tensor.view %query_storage offset(32) : tensor<24608xbf16> -> tensor<24576xbf16>
    %key_storage = check.generate.fill value(123.0) : tensor<6176xbf16>
    %key = check.tensor.view %key_storage offset(32) : tensor<6176xbf16> -> tensor<6144xbf16>
    %value_storage = check.generate.fill value(123.0) : tensor<6176xbf16>
    %value = check.tensor.view %value_storage offset(32) : tensor<6176xbf16> -> tensor<6144xbf16>
    %mask_storage = check.generate.fill value(123) : tensor<80xi8>
    %mask = check.tensor.view %mask_storage offset(16) : tensor<80xi8> -> tensor<48xi8>
    %gate_storage = check.generate.fill value(123.0) : tensor<24608xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<24608xbf16> -> tensor<24576xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<24608xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<24608xbf16> -> tensor<24576xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<24608xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(49184) : tensor<24608xbf16> -> tensor<16xbf16>
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<24576xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %input_scale, %query) : (tensor<24576xi32>, f32, tensor<24576xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<6144xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<6144xi32>, f32, tensor<6144xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<6144xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<6144xi32>, f32, tensor<6144xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<24576xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<24576xi32>, f32, tensor<24576xbf16>) -> ()
    check.generate<@initialize_shared_identity>(%pattern, %tile, %query, %key, %value, %mask, %gate) : (index, index, tensor<24576xbf16>, tensor<6144xbf16>, tensor<6144xbf16>, tensor<48xi8>, tensor<24576xbf16>) -> ()
    check.compare<@shared_attention_program, @reference_shared_identity>[%tokens, %tile, %heads, %gated](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1](tensor<5xi32>, tensor<24576xbf16>, tensor<6144xbf16>, tensor<6144xbf16>, tensor<48xi8>, tensor<24576xbf16>, tensor<24576xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<24576xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<5xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<24608xbf16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<6176xbf16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<6176xbf16>
      check.expect.bitwise actual(%mask_storage) expected(%mask_storage) : tensor<80xi8>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<24608xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@k16_single> @k16_single_benchmark

check.scenario public @k16_zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(16) : index
  %tile = check.literal value(16) : index
  %pattern = check.literal value(1) : index
  %gated = check.literal value(false) : i1
  %heads = check.literal value(1) : index
  %causal = check.literal value(false) : i1
  %row_stride = check.literal value(1) : index
  %column_stride = check.literal value(16) : index
  %rounded = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_storage = check.generate.fill value(123.0) : tensor<8224xbf16>
    %query = check.tensor.view %query_storage offset(32) : tensor<8224xbf16> -> tensor<8192xbf16>
    %key_storage = check.generate.fill value(123.0) : tensor<2080xbf16>
    %key = check.tensor.view %key_storage offset(32) : tensor<2080xbf16> -> tensor<2048xbf16>
    %value_storage = check.generate.fill value(123.0) : tensor<2080xbf16>
    %value = check.tensor.view %value_storage offset(32) : tensor<2080xbf16> -> tensor<2048xbf16>
    %mask_storage = check.generate.fill value(123) : tensor<48xi8>
    %mask = check.tensor.view %mask_storage offset(16) : tensor<48xi8> -> tensor<16xi8>
    %gate_storage = check.generate.fill value(123.0) : tensor<8224xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<8224xbf16> -> tensor<8192xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<8224xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<8224xbf16> -> tensor<8192xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<8224xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(16416) : tensor<8224xbf16> -> tensor<16xbf16>
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<8192xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %input_scale, %query) : (tensor<8192xi32>, f32, tensor<8192xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<2048xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<2048xi32>, f32, tensor<2048xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<2048xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<2048xi32>, f32, tensor<2048xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<8192xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<8192xi32>, f32, tensor<8192xbf16>) -> ()
    check.generate<@initialize_shared_identity>(%pattern, %tile, %query, %key, %value, %mask, %gate) : (index, index, tensor<8192xbf16>, tensor<2048xbf16>, tensor<2048xbf16>, tensor<16xi8>, tensor<8192xbf16>) -> ()
    check.compare<@shared_attention_program, @reference_shared_identity>[%tokens, %tile, %heads, %gated](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1](tensor<5xi32>, tensor<8192xbf16>, tensor<2048xbf16>, tensor<2048xbf16>, tensor<16xi8>, tensor<8192xbf16>, tensor<8192xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8192xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<5xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<8224xbf16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<2080xbf16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<2080xbf16>
      check.expect.bitwise actual(%mask_storage) expected(%mask_storage) : tensor<48xi8>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<8224xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@k16_zero> @k16_zero_benchmark

check.scenario public @k16_uniform {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(32) : index
  %tile = check.literal value(16) : index
  %pattern = check.literal value(2) : index
  %gated = check.literal value(true) : i1
  %heads = check.literal value(1) : index
  %causal = check.literal value(false) : i1
  %row_stride = check.literal value(1) : index
  %column_stride = check.literal value(32) : index
  %rounded = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_storage = check.generate.fill value(123.0) : tensor<16416xbf16>
    %query = check.tensor.view %query_storage offset(32) : tensor<16416xbf16> -> tensor<16384xbf16>
    %key_storage = check.generate.fill value(123.0) : tensor<4128xbf16>
    %key = check.tensor.view %key_storage offset(32) : tensor<4128xbf16> -> tensor<4096xbf16>
    %value_storage = check.generate.fill value(123.0) : tensor<4128xbf16>
    %value = check.tensor.view %value_storage offset(32) : tensor<4128xbf16> -> tensor<4096xbf16>
    %mask_storage = check.generate.fill value(123) : tensor<64xi8>
    %mask = check.tensor.view %mask_storage offset(16) : tensor<64xi8> -> tensor<32xi8>
    %gate_storage = check.generate.fill value(123.0) : tensor<16416xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<16416xbf16> -> tensor<16384xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<16416xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<16416xbf16> -> tensor<16384xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<16416xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(32800) : tensor<16416xbf16> -> tensor<16xbf16>
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<16384xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %input_scale, %query) : (tensor<16384xi32>, f32, tensor<16384xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<4096xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<4096xi32>, f32, tensor<4096xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<4096xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<4096xi32>, f32, tensor<4096xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<16384xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<16384xi32>, f32, tensor<16384xbf16>) -> ()
    check.generate<@initialize_shared_identity>(%pattern, %tile, %query, %key, %value, %mask, %gate) : (index, index, tensor<16384xbf16>, tensor<4096xbf16>, tensor<4096xbf16>, tensor<32xi8>, tensor<16384xbf16>) -> ()
    check.compare<@shared_attention_program, @reference_shared_gated_identity>[%tokens, %tile, %heads, %gated](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1](tensor<5xi32>, tensor<16384xbf16>, tensor<4096xbf16>, tensor<4096xbf16>, tensor<32xi8>, tensor<16384xbf16>, tensor<16384xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.019443005323410034) rtol(0.0) nan(different) : tensor<16384xbf16>, tensor<16384xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<5xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<16416xbf16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<4128xbf16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<4128xbf16>
      check.expect.bitwise actual(%mask_storage) expected(%mask_storage) : tensor<64xi8>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<16416xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
