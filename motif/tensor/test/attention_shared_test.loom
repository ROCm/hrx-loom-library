    %prefix = check.tensor.view %output_storage offset(0) : tensor<16416xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(32800) : tensor<16416xbf16> -> tensor<16xbf16>
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_scale = check.literal value(0.00390625) : f32
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<16384xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %query_scale, %query) : (tensor<16384xi32>, f32, tensor<16384xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<4096xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<4096xi32>, f32, tensor<4096xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<4096xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<4096xi32>, f32, tensor<4096xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<16384xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<16384xi32>, f32, tensor<16384xbf16>) -> ()
    check.generate<@initialize_attention_numerics>(%pattern, %tile, %mask_begin, %mask_end, %mask_cycle, %parameters, %query, %key, %value, %mask) : (index, index, index, index, index, tensor<5xi32>, tensor<16384xbf16>, tensor<4096xbf16>, tensor<4096xbf16>, tensor<32xi8>) -> ()
    check.compare<@shared_attention_program, @attention_reference>[%tokens, %tile, %heads, %gated](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1](tensor<5xi32>, tensor<16384xbf16>, tensor<4096xbf16>, tensor<4096xbf16>, tensor<32xi8>, tensor<16384xbf16>, tensor<16384xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16384xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<5xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<16416xbf16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<4128xbf16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<4128xbf16>
      check.expect.bitwise actual(%mask_storage) expected(%mask_storage) : tensor<64xi8>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<16416xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@k32_probability> @k32_probability_benchmark
