template.decl @projection.adapter_down_bf16(%rows: index, %inputs: index, %count: index, %offset_layout: encoding<layout>, %strength_layout: encoding<layout>, %offsets: view<[%count]xi64, %offset_layout>, %strengths: view<[%count]xf32, %strength_layout>, %input: buffer, %factors: buffer, %low: buffer)

template.decl @projection.adapter_up_bf16(%rows: index, %outputs: index, %count: index, %output_layout: encoding<layout>, %offset_layout: encoding<layout>, %offsets: view<[%count]xi64, %offset_layout>, %low: buffer, %factors: buffer, %base: buffer, %output: buffer)

// Runtime bank selection over shared factors. Only this test leaf owns
// the metadata record layout; the providers consume typed strided views.
amdgpu.target<gfx11-generic> @count_wave32 {subgroup_size = 32}

amdgpu.target<gfx11-generic> @tensor_adapter_rdna3

kernel.def target(@count_wave32) @count_down() {
  %groups_x = index.constant 5 : index
  %groups_y = index.constant 1 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %factors: buffer, %selections: buffer, %low: buffer) {
  %rows = index.constant 80 : index
  %inputs = index.constant 64 : index
  %outputs = index.constant 64 : index
  %output_layout = encoding.layout.dense : encoding<layout>
  %selection_origin = index.constant 0 : offset
  %selection_header = buffer.view %selections[%selection_origin] : buffer -> view<1xi32>
  %selection_count32 = view.load %selection_header[0] : view<1xi32> -> i32
  %selection_count_nonnegative = scalar.assume %selection_count32 [range(%selection_count32, 0, 2147483647)] : i32
  %count = index.cast %selection_count_nonnegative : i32 to index
  %offset_begin = index.constant 16 : offset
  %offset_layout = encoding.layout.strided [2] : encoding<layout>
  %offsets = buffer.view %selections[%offset_begin] : buffer -> view<[%count]xi64, %offset_layout>
  %strength_begin = index.constant 24 : offset
  %strength_layout = encoding.layout.strided [4] : encoding<layout>
  %strengths = buffer.view %selections[%strength_begin] : buffer -> view<[%count]xf32, %strength_layout>
  template.apply<@projection.adapter_down_bf16>(%rows, %inputs, %count, %offset_layout, %strength_layout, %offsets, %strengths, %input, %factors, %low) : (index, index, index, encoding<layout>, encoding<layout>, view<[%count]xi64, %offset_layout>, view<[%count]xf32, %strength_layout>, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@count_wave32) @count_up() {
  %groups_x = index.constant 1 : index
  %groups_y = index.constant 2 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%low: buffer, %factors: buffer, %selections: buffer, %base: buffer, %output: buffer) {
  %rows = index.constant 80 : index
  %inputs = index.constant 64 : index
  %outputs = index.constant 64 : index
  %output_layout = encoding.layout.dense : encoding<layout>
  %selection_origin = index.constant 0 : offset
  %selection_header = buffer.view %selections[%selection_origin] : buffer -> view<1xi32>
  %selection_count32 = view.load %selection_header[0] : view<1xi32> -> i32
  %selection_count_nonnegative = scalar.assume %selection_count32 [range(%selection_count32, 0, 2147483647)] : i32
  %count = index.cast %selection_count_nonnegative : i32 to index
  %offset_begin = index.constant 16 : offset
  %offset_layout = encoding.layout.strided [2] : encoding<layout>
  %offsets = buffer.view %selections[%offset_begin] : buffer -> view<[%count]xi64, %offset_layout>
  template.apply<@projection.adapter_up_bf16>(%rows, %outputs, %count, %output_layout, %offset_layout, %offsets, %low, %factors, %base, %output) : (index, index, index, encoding<layout>, encoding<layout>, view<[%count]xi64, %offset_layout>, buffer, buffer, buffer, buffer)
  kernel.return
}
