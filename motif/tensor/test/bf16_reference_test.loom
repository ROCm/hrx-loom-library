// Add just below half an ULP, plus the retained significand's low bit: exact
// ties then round to even. Masking the discarded bits preserves signed zero
// and BF16 subnormals. Callers keep inputs and intermediates finite.
func.def @reference_bf16_round(%value: f32) -> (f32) {
  %bits = scalar.bitcast %value : f32 to i32
  %shift = scalar.constant 16 : i32
  %low_bit_mask = scalar.constant 1 : i32
  %bias = scalar.constant 32767 : i32
  %mask = scalar.constant -65536 : i32
  %upper = scalar.shrui %bits, %shift : i32
  %odd = scalar.andi %upper, %low_bit_mask : i32
  %biased = scalar.addi %bits, %bias : i32
  %rounded = scalar.addi %biased, %odd : i32
  %retained = scalar.andi %rounded, %mask : i32
  %result = scalar.bitcast %retained : i32 to f32
  func.return %result : f32
}

// Read and write storage bits independently of the production BF16 casts.
func.def @reference_bf16_value(%word: i16) -> (f32) {
  %upper = scalar.extui %word : i16 to i32
  %shift = scalar.constant 16 : i32
  %bits = scalar.shli %upper, %shift : i32
  %value = scalar.bitcast %bits : i32 to f32
  func.return %value : f32
}

func.def @reference_bf16_bits(%value: f32) -> (i16) {
  %rounded = func.call @reference_bf16_round(%value) : (f32) -> (f32)
  %bits = scalar.bitcast %rounded : f32 to i32
  %shift = scalar.constant 16 : i32
  %upper = scalar.shrui %bits, %shift : i32
  %word = scalar.trunci %upper : i32 to i16
  func.return %word : i16
}
