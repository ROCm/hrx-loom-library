// Counter-based random words against published Random123 known answers.
// Runtime inputs cover zero, all-one, and mixed counter/key words.

template.decl @random.philox4x32(%counter0: i32, %counter1: i32, %counter2: i32, %counter3: i32, %seed0: i32, %seed1: i32) -> (i32, i32, i32, i32)

kernel.def @philox_words() {
  %unit = index.constant 1 : index
  %rows = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%rows, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer) {
  %origin = index.constant 0 : offset
  %input = buffer.view %input_storage[%origin] : buffer -> view<3x6xi32>
  %output = buffer.view %output_storage[%origin] : buffer -> view<3x4xi32>
  %row = kernel.workitem.id<x> : index
  %counter0 = view.load %input[%row, 0] : view<3x6xi32> -> i32
  %counter1 = view.load %input[%row, 1] : view<3x6xi32> -> i32
  %counter2 = view.load %input[%row, 2] : view<3x6xi32> -> i32
  %counter3 = view.load %input[%row, 3] : view<3x6xi32> -> i32
  %seed0 = view.load %input[%row, 4] : view<3x6xi32> -> i32
  %seed1 = view.load %input[%row, 5] : view<3x6xi32> -> i32
  %a, %b, %c, %d = template.apply<@random.philox4x32>(%counter0, %counter1, %counter2, %counter3, %seed0, %seed1) : (i32, i32, i32, i32, i32, i32) -> (i32, i32, i32, i32)
  view.store %a, %output[%row, 0] : i32, view<3x4xi32>
  view.store %b, %output[%row, 1] : i32, view<3x4xi32>
  view.store %c, %output[%row, 2] : i32, view<3x4xi32>
  view.store %d, %output[%row, 3] : i32, view<3x4xi32>
  kernel.return
}

// Published Random123 words, stored little-endian for the kernel input ABI.
global.rodata.def @philox_input = align(4) bytes("000000000000000000000000000000000000000000000000ffffffffffffffffffffffffffffffffffffffffffffffff886a3f24d308a3852e8a191344737003223809a4d0319f29")

global.rodata.def @philox_output = align(4) bytes("d5e827668dc569e14cac57bcd8db009b6d278f400e3bc841c6c70ba2fd51546d09fe6cd1ebccfd9420e40150a16e1224")

func.def @initialize_philox(%input: buffer) {
  %origin = index.constant 0 : offset
  %input_length = index.constant 72 : offset
  %words = global.load @philox_input : buffer
  buffer.copy %words[%origin], %input[%origin], %input_length
  func.return
}

func.def @expected_philox(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 48 : offset
  %values = global.load @philox_output : buffer
  buffer.copy %values[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @philox_known_words {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<3x6xi32>
    %output = check.generate.fill value(0) : tensor<3x4xi32>
    check.generate<@initialize_philox>(%input) : (tensor<3x6xi32>) -> ()
    check.compare<@philox_words, @expected_philox>(%input, %output) : (tensor<3x6xi32>, tensor<3x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3x4xi32>
    }
  }
  check.return
}

check.benchmark<@philox_known_words> @philox_counter_blocks
