global.rodata.def @scaled_unit_expected = align(2) bytes("f8bf403fe03ed0bf90bf80bda03fc03fa0be60bff0bf303f003fd8bf88bf00bea83fb83f80be70bfe8bf203f103fe0bf80bf40beb03fb03f40be80bfe0bf103f")

func.def @initialize_scaled_unit(%input: buffer, %weight: buffer) {
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 64 : offset
  %weight_bytes = index.constant 64 : offset
  %inputs = global.load @scaled_unit_input : buffer
  %weights = global.load @scaled_unit_weight : buffer
  buffer.copy %inputs[%origin], %input[%origin], %input_bytes
  buffer.copy %weights[%origin], %weight[%origin], %weight_bytes
  func.return
}

kernel.def target(@rms_rows_wave32) @apply_scaled_unit() {
  %rows = index.constant 1 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 1 : index
  %width = index.constant 32 : index
  %threads = index.constant 32 : index
  %epsilon = scalar.constant 0.0 : f32
  template.apply<@normalization.scaled_rows_bf16>(%rows, %width, %threads, %epsilon, %input, %weight, %output) : (index, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

func.def @reference_scaled_unit(%input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %expected = global.load @scaled_unit_expected : buffer
  buffer.copy %expected[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @scaled_unit {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<64xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<64xi16> -> tensor<32xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<64xbf16>
    %weight = check.tensor.view %weight_storage offset(32) : tensor<64xbf16> -> tensor<32xbf16>
    check.generate<@initialize_scaled_unit>(%input, %weight) : (tensor<32xbf16>, tensor<32xbf16>) -> ()
    %output_storage = check.generate.fill value(-12345) : tensor<64xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<64xi16> -> tensor<32xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<64xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(96) : tensor<64xi16> -> tensor<16xi16>
    check.compare<@apply_scaled_unit, @reference_scaled_unit>(%input, %weight, %output) : (tensor<32xbf16>, tensor<32xbf16>, tensor<32xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<64xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<64xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@scaled_unit> @scaled_unit_benchmark

