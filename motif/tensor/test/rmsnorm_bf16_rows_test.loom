    %output_storage = check.generate.fill value(-12345) : tensor<64xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<64xi16> -> tensor<32xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<64xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(96) : tensor<64xi16> -> tensor<16xi16>
    check.compare<@rms_identity_program, @rms_rows_reference>[%width, %epsilon, %centered](%parameters, %input, %weight, %output) : [index, f32, i1](tensor<4xi32>, tensor<32xbf16>, tensor<32xf32>, tensor<32xbf16>) -> () {
