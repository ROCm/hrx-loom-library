// Whole-row normalization compares native reductions with an independent F64
// oracle. Signed zeros, unit rows, and epsilon-dominated values exercise the
// root and epilogues; immutable operands and allocation guards remain exact.
//
// The inverse has an independent 2^-16 relative requirement. The row budget
// is (1+2^-16)*(1+2^-24)^2*(1+2^-8)^n/(1-2^-8)-1, with zero absolute error:
// two F32 products, n native BF16 boundaries, and ideal BF16 publication.
// The zero-centered epilogue has n=1; the scaled epilogue has n=2. Zero and
// unit rows remain bitwise, and scalar checks isolate the rounding boundaries.

amdgpu.target<gfx11-generic> @rms_rows_wave32 {subgroup_size = 32}

template.decl @normalization.zero_centered_rows_bf16(%rows: index, %width: index, %threads: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

template.decl @normalization.scaled_rows_bf16(%rows: index, %width: index, %threads: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

func.decl @initialize_rms_rows(%rows_value: index, %width_value: index, %epsilon: f32, %pattern: index, %centered: i1, %parameters: buffer, %input: buffer, %weight: buffer)

func.decl @rms_rows_reference(%parameters: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.def target(@rms_rows_wave32) @apply_rms_identity() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%width_value: index, %epsilon: f32, %centered: i1, %input: buffer, %weight: buffer, %output: buffer) {
  %width = index.assume %width_value [ge(%width_value, 32), le(%width_value, 128), multiple_of(%width_value, 32)] : index
  %rows = index.constant 1 : index
  %threads = index.constant 32 : index
  scf.if %centered {
    template.apply<@normalization.zero_centered_rows_bf16>(%rows, %width, %threads, %epsilon, %input, %weight, %output) : (index, index, index, f32, buffer, buffer, buffer)
  } else {
    template.apply<@normalization.scaled_rows_bf16>(%rows, %width, %threads, %epsilon, %input, %weight, %output) : (index, index, index, f32, buffer, buffer, buffer)
  }
  kernel.return
}

