}

check.scenario public @zero_centered_zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(1) : index
  %width = check.literal value(128) : index
  %epsilon = check.literal value(1.0000000000000001e-05) : f32
  %pattern = check.literal value(1) : index
  %centered = check.literal value(true) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<4xi32>
    %input_storage = check.generate.fill value(-12345) : tensor<160xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<160xi16> -> tensor<128xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<160xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<160xf32> -> tensor<128xf32>
    check.generate<@initialize_rms_rows>(%rows, %width, %epsilon, %pattern, %centered, %parameters, %input, %weight) : (index, index, f32, index, i1, tensor<4xi32>, tensor<128xbf16>, tensor<128xf32>) -> ()
    %output_storage = check.generate.fill value(-12345) : tensor<160xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<160xi16> -> tensor<128xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<160xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(288) : tensor<160xi16> -> tensor<16xi16>
    check.compare<@rms_identity_program, @rms_rows_reference>[%width, %epsilon, %centered](%parameters, %input, %weight, %output) : [index, f32, i1](tensor<4xi32>, tensor<128xbf16>, tensor<128xf32>, tensor<128xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<4xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<160xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<160xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@zero_centered_zero> @zero_centered_zero_benchmark

