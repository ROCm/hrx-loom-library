  %rows = index.constant 3 : index
  %threads = index.constant 64 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%parameters: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 3 : index
  %width = index.constant 128 : index
  %threads = index.constant 64 : index
  %epsilon = scalar.constant 9.9999999747524271e-07 : f32
  template.apply<@normalization.zero_centered_rows_bf16>(%rows, %width, %threads, %epsilon, %input, %weight, %output) : (index, index, index, f32, buffer, buffer, buffer)
  kernel.return
}

