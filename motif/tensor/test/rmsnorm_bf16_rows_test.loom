check.scenario public @zero_centered_inplace {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<416xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<416xi16> -> tensor<384xbf16>
    %weight_storage = check.generate.fill value(123.0) : tensor<160xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<160xf32> -> tensor<128xf32>
    check.generate<@initialize_zero_centered_inplace>(%input, %weight) : (tensor<384xbf16>, tensor<128xf32>) -> ()
    %prefix = check.tensor.view %input_storage offset(0) : tensor<416xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %input_storage offset(800) : tensor<416xi16> -> tensor<16xi16>
    check.compare<@apply_zero_centered_inplace, @reference_zero_centered_inplace>(%input, %weight, %input) : (tensor<384xbf16>, tensor<128xf32>, tensor<384xbf16>) -> () {
      check.expect.approximate actual(%input) expected(%input) atol(0.0) rtol(0.0078586358668426559) nan(different) : tensor<384xbf16>, tensor<384xbf16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<160xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

