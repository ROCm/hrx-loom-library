// Scalar rotary pairs preserve four BF16 product boundaries before addition.
// An integer-rounding oracle checks randomized inputs and explicit signed-zero,
// subnormal, and large-exponent cases, with nonzero origins and storage guards.

amdgpu.target<gfx11-generic> @rotary_scalar_wave32 {subgroup_size = 32}

template.decl @attention.half_pair_bf16(%left: bf16, %right: bf16, %left_cosine: bf16, %right_cosine: bf16, %left_sine: bf16, %right_sine: bf16) -> (vector<2xbf16>)

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.decl @reference_rotary_half_pair(%left: f32, %right: f32, %left_cosine: f32, %right_cosine: f32, %left_sine: f32, %right_sine: f32) -> (i16, i16)

// Scenario entropy supplies the random prefix. Boundary rows retain signed
// zero, the least subnormal, the least normal, and a large finite exponent.
func.def @initialize_pair_inputs(%input: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %boundary_begin = index.constant 256 : index
  %count = index.constant 304 : index
  %c0_i16 = scalar.constant 0 : i16
  %sign_bit = scalar.constant -32768 : i16
  %normal_bits = scalar.constant 128 : i16
  %large_bits = scalar.constant 29056 : i16
  %unit_bits = scalar.constant 16256 : i16
  %negative_unit_bits = scalar.constant -16512 : i16
  %half_bits = scalar.constant 16128 : i16
  %negative_half_bits = scalar.constant -16640 : i16
  %eighth_bits = scalar.constant 15872 : i16
  %inputs = buffer.view %input[%origin] : buffer -> view<304x6xi16>
  scf.for %row = [%boundary_begin to %count step %c1] {
    %ordinal = index.sub %row, %boundary_begin : index
    %value_index = index.div %ordinal, %c8 : index
    %small = index.cmp ult, %value_index, %c4 : index
    %left = scf.if %small -> (i16) {
      %magnitude_index = index.div %value_index, %c2 : index
      %sign_index = index.rem %value_index, %c2 : index
      %magnitude = index.cast %magnitude_index : index to i16
      %sign = index.cast %sign_index : index to i16
      %sign_bits = scalar.muli %sign, %sign_bit : i16
      %bits = scalar.ori %magnitude, %sign_bits : i16
      scf.yield %bits : i16
    } else {
      %normal = index.cmp eq, %value_index, %c4 : index
      %bits = scf.select %normal, %normal_bits, %large_bits : i16
      scf.yield %bits : i16
    }
    %within_value = index.rem %ordinal, %c8 : index
    %opposite = index.cmp uge, %within_value, %c4 : index
    %right_sign = scf.select %opposite, %sign_bit, %c0_i16 : i16
    %right = scalar.xori %left, %right_sign : i16
    %coefficients = index.rem %ordinal, %c4 : index
    %identity = index.cmp eq, %coefficients, %c0 : index
    %left_cosine, %right_cosine, %left_sine, %right_sine = scf.if %identity -> (i16, i16, i16, i16) {
      scf.yield %unit_bits, %unit_bits, %c0_i16, %c0_i16 : i16, i16, i16, i16
    } else {
      %swap = index.cmp eq, %coefficients, %c1 : index
      %left_cosine, %right_cosine, %left_sine, %right_sine = scf.if %swap -> (i16, i16, i16, i16) {
        scf.yield %c0_i16, %c0_i16, %unit_bits, %negative_unit_bits : i16, i16, i16, i16
      } else {
        %balanced = index.cmp eq, %coefficients, %c2 : index
        %left_cosine = scf.select %balanced, %half_bits, %eighth_bits : i16
        %right_cosine = scf.select %balanced, %negative_half_bits, %unit_bits : i16
        %left_sine = scf.select %balanced, %half_bits, %eighth_bits : i16
        %right_sine = scf.select %balanced, %half_bits, %unit_bits : i16
        scf.yield %left_cosine, %right_cosine, %left_sine, %right_sine : i16, i16, i16, i16
      }
      scf.yield %left_cosine, %right_cosine, %left_sine, %right_sine : i16, i16, i16, i16
    }
    view.store %left, %inputs[%row, 0] : i16, view<304x6xi16>
    view.store %right, %inputs[%row, 1] : i16, view<304x6xi16>
    view.store %left_cosine, %inputs[%row, 2] : i16, view<304x6xi16>
    view.store %right_cosine, %inputs[%row, 3] : i16, view<304x6xi16>
    view.store %left_sine, %inputs[%row, 4] : i16, view<304x6xi16>
    view.store %right_sine, %inputs[%row, 5] : i16, view<304x6xi16>
  }
  func.return
}

kernel.def target(@rotary_scalar_wave32) @apply_pairs() {
  %groups = index.constant 3 : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %count = index.constant 304 : index
  %threads = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x6xbf16>
    %outputs = buffer.view %output[%origin] : buffer -> view<[%count]x2xbf16>
    %left = view.load %inputs[%row, 0] : view<[%count]x6xbf16> -> bf16
    %right = view.load %inputs[%row, 1] : view<[%count]x6xbf16> -> bf16
    %left_cosine = view.load %inputs[%row, 2] : view<[%count]x6xbf16> -> bf16
    %right_cosine = view.load %inputs[%row, 3] : view<[%count]x6xbf16> -> bf16
    %left_sine = view.load %inputs[%row, 4] : view<[%count]x6xbf16> -> bf16
    %right_sine = view.load %inputs[%row, 5] : view<[%count]x6xbf16> -> bf16
    %pair = template.apply<@attention.half_pair_bf16>(%left, %right, %left_cosine, %right_cosine, %left_sine, %right_sine) : (bf16, bf16, bf16, bf16, bf16, bf16) -> (vector<2xbf16>)
    vector.store %pair, %outputs[%row, 0] : vector<2xbf16>, view<[%count]x2xbf16>
  }
  kernel.return
}

// Decode and round BF16 through integer bits independently of the production
// casts. Every product rounds before the two signed pair sums are formed.
func.def @pair_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 304 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<304x6xi16>
  %outputs = buffer.view %output[%origin] : buffer -> view<304x2xi16>
  scf.for %row = [%c0 to %count step %c1] {
    %left_bits = view.load %inputs[%row, 0] : view<304x6xi16> -> i16
    %right_bits = view.load %inputs[%row, 1] : view<304x6xi16> -> i16
    %left_cosine_bits = view.load %inputs[%row, 2] : view<304x6xi16> -> i16
    %right_cosine_bits = view.load %inputs[%row, 3] : view<304x6xi16> -> i16
    %left_sine_bits = view.load %inputs[%row, 4] : view<304x6xi16> -> i16
    %right_sine_bits = view.load %inputs[%row, 5] : view<304x6xi16> -> i16
    %left = func.call @reference_bf16_value(%left_bits) : (i16) -> (f32)
    %right = func.call @reference_bf16_value(%right_bits) : (i16) -> (f32)
    %left_cosine = func.call @reference_bf16_value(%left_cosine_bits) : (i16) -> (f32)
    %right_cosine = func.call @reference_bf16_value(%right_cosine_bits) : (i16) -> (f32)
    %left_sine = func.call @reference_bf16_value(%left_sine_bits) : (i16) -> (f32)
    %right_sine = func.call @reference_bf16_value(%right_sine_bits) : (i16) -> (f32)
    %left_result, %right_result = func.call @reference_rotary_half_pair(%left, %right, %left_cosine, %right_cosine, %left_sine, %right_sine) : (f32, f32, f32, f32, f32, f32) -> (i16, i16)
    view.store %left_result, %outputs[%row, 0] : i16, view<304x2xi16>
    view.store %right_result, %outputs[%row, 1] : i16, view<304x2xi16>
  }
  func.return
}

check.scenario public @pair_rounding {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<1856xbf16>
    %input = check.tensor.view %input_storage offset(32) : tensor<1856xbf16> -> tensor<1824xbf16>
    check.generate<@initialize_pair_inputs>(%input) : (tensor<1824xbf16>) -> ()
    %output_storage = check.generate.fill value(-12345) : tensor<640xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<640xi16> -> tensor<608xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<640xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(1248) : tensor<640xi16> -> tensor<16xi16>
    check.compare<@apply_pairs, @pair_reference>(%input, %output) : (tensor<1824xbf16>, tensor<608xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<608xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1856xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@pair_rounding> @pair_rounding_benchmark
