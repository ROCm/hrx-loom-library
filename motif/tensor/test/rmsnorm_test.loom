check.scenario public @decode_f32 {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %rows = check.literal value(1) : index
    %input_origin = check.literal value(0) : offset
    %output_origin = check.literal value(0) : offset
    %stride = check.literal value(5120) : index
    %epsilon = check.literal value(9.9999999999999995e-07) : f32
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-2.0 to 2.0) : tensor<5120xf32>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-2.0 to 2.0) : tensor<5120xf32>
    %output = check.generate.fill value(-99.0) : tensor<5120xf32>
    check.compare<@normalize_5120_f32, @normalize_5120_f32_reference>[%rows](%rows, %input_origin, %output_origin, %stride, %epsilon, %input, %weight, %output) : [index](index, offset, offset, index, f32, tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<5120xf32>, tensor<5120xf32>
    }
  }
  check.return
}

