// Independent segment-local F64 oracles cover complete softmax and exact
// mean/copy identities. Inputs distinguish segment/head ownership, common-key
// offsets, and the final channel. Scenarios share a launch with configurable
// wave count; allocation guards and immutable Q/K/V compare bitwise.
//
// The absolute budget follows input magnitude, 132 F32 score operations,
// eight online operations per segment row, and 2^-16 per approximate exp/rcp.
// The relative budget 2^-7/(1-2^-8) accounts for BF16 rounding of both
// observations. Single-key and segment-constant values remain bitwise.

config.def @test.segmented_attention.waves = 4 : %value: index where [range(%value, 1, 4)]

amdgpu.target<gfx11-generic> @segmented_wave32 {subgroup_size = 32}

template.decl @attention.segmented_128_bf16(%rows: index, %length: index, %heads: index, %row: index, %head: index, %query: buffer, %key: buffer, %value: buffer) -> (vector<4xbf16>)

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @segmented_attention_reference(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer)

// Integer samples become exact dyadic BF16 values. Varied queries are bounded
// so every entropy sample fits the fixed error budget. Constant values vary
// by segment/head; directed cases preserve key offsets and the last channel.
func.def @initialize_segmented_attention(%rows_value: index, %length_value: index, %heads_value: index, %pattern: index, %samples: buffer, %parameters: buffer, %query: buffer, %key: buffer, %value: buffer) {
  %rows = index.assume %rows_value [ge(%rows_value, 1), le(%rows_value, 66)] : index
  %length = index.assume %length_value [ge(%length_value, 1), le(%length_value, 33)] : index
  %heads = index.assume %heads_value [ge(%heads_value, 1), le(%heads_value, 20)] : index
  %origin = index.constant 0 : offset
  %metadata = buffer.view %parameters[%origin] : buffer -> view<3xi32>
  %rows_word = index.cast %rows : index to i32
  %length_word = index.cast %length : index to i32
  %heads_word = index.cast %heads : index to i32
  view.store %rows_word, %metadata[0] : i32, view<3xi32>
  view.store %length_word, %metadata[1] : i32, view<3xi32>
  view.store %heads_word, %metadata[2] : i32, view<3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %last_channel = index.constant 127 : index
  %c7 = index.constant 7 : index
  %channels = index.constant 128 : index
  %width = index.mul %heads, %channels : index
  %random = buffer.view %samples[%origin] : buffer -> view<3x[%rows]x[%width]xi32>
  %queries = buffer.view %query[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %keys = buffer.view %key[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %values = buffer.view %value[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %c0_f32 = scalar.constant 0.0 : f32
  %c3_f32 = scalar.constant 3.0 : f32
  %quarter = scalar.constant 0.25 : f32
  %scale = scalar.constant 0.015625 : f32
  %half = scalar.constant 0.5 : f32
  %c8_f32 = scalar.constant 8.0 : f32
  %c32_f32 = scalar.constant 32.0 : f32
  %common_base = scalar.constant 4096.0 : f32
  %bucket_width = scalar.constant 21 : i32
  %c1_i32 = scalar.constant 1 : i32
  %single = index.cmp eq, %pattern, %c0 : index
  %general = index.cmp eq, %pattern, %c3 : index
  %common = index.cmp eq, %pattern, %c4 : index
  %last = index.cmp eq, %pattern, %c5 : index
  %varied = scalar.ori %single, %general : i1
  %varied_query = scalar.ori %varied, %common : i1
  %constant = index.cmp eq, %pattern, %c1 : index
  scf.for %row = [%c0 to %rows step %c1] {
    %segment = index.div %row, %length : index
    scf.for %column = [%c0 to %width step %c1] {
      %query_sample = view.load %random[0, %row, %column] : view<3x[%rows]x[%width]xi32> -> i32
      %key_sample = view.load %random[1, %row, %column] : view<3x[%rows]x[%width]xi32> -> i32
      %value_sample = view.load %random[2, %row, %column] : view<3x[%rows]x[%width]xi32> -> i32
      %query_float = scalar.sitofp %query_sample : i32 to f32
      %key_float = scalar.sitofp %key_sample : i32 to f32
      %value_float = scalar.sitofp %value_sample : i32 to f32
      %random_query = scalar.mulf %query_float, %scale : f32
      %random_key = scalar.mulf %key_float, %scale : f32
      %bucket = scalar.divsi %key_sample, %bucket_width : i32
      %bucket_float = scalar.sitofp %bucket : i32 to f32
      %key_offset = scalar.mulf %bucket_float, %c32_f32 : f32
      %common_key = scalar.addf %common_base, %key_offset : f32
      %key_value = scf.select %common, %common_key, %random_key : f32
      %random_value = scalar.mulf %value_float, %scale : f32
      %bounded_query = scalar.mulf %random_query, %half : f32
      %ordinary_query = scf.select %general, %bounded_query, %random_query : f32
      %common_query = scalar.mulf %random_query, %scale : f32
      %selected_query = scf.select %common, %common_query, %ordinary_query : f32
      %query_value = scf.select %varied_query, %selected_query, %c0_f32 : f32
      %head = index.div %column, %channels : index
      %group = index.madd %segment, %c3, %head : index
      %cycle = index.rem %group, %c7 : index
      %cycle_word = index.cast %cycle : index to i32
      %cycle_float = scalar.uitofp %cycle_word : i32 to f32
      %centered = scalar.subf %cycle_float, %c3_f32 : f32
      %constant_value = scalar.mulf %centered, %quarter : f32
      %value_value = scf.select %constant, %constant_value, %random_value : f32
      %query_result, %key_result, %value_result = scf.if %last -> (f32, f32, f32) {
        %channel = index.rem %column, %channels : index
        %live = index.cmp eq, %channel, %last_channel : index
        %local = index.rem %row, %length : index
        %local_word = index.cast %local : index to i32
        %centered_word = scalar.subi %local_word, %c1_i32 : i32
        %centered_value = scalar.sitofp %centered_word : i32 to f32
        %last_query = scf.select %live, %c8_f32, %c0_f32 : f32
        %last_key = scf.select %live, %centered_value, %c0_f32 : f32
        %parity = index.rem %channel, %c2 : index
        %even = index.cmp eq, %parity, %c0 : index
        %negative = scalar.negf %centered_value : f32
        %last_value = scf.select %even, %negative, %centered_value : f32
        scf.yield %last_query, %last_key, %last_value : f32, f32, f32
      } else {
        scf.yield %query_value, %key_value, %value_value : f32, f32, f32
      }
      %query_bits = func.call @reference_bf16_bits(%query_result) : (f32) -> (i16)
      %key_bits = func.call @reference_bf16_bits(%key_result) : (f32) -> (i16)
      %value_bits = func.call @reference_bf16_bits(%value_result) : (f32) -> (i16)
      view.store %query_bits, %queries[%row, %column] : i16, view<[%rows]x[%width]xi16>
      view.store %key_bits, %keys[%row, %column] : i16, view<[%rows]x[%width]xi16>
      view.store %value_bits, %values[%row, %column] : i16, view<[%rows]x[%width]xi16>
    }
  }
  func.return
}

kernel.def target(@segmented_wave32) @apply_segmented_attention(%rows: index, %heads: index) {
  %waves = config.get @test.segmented_attention.waves : index
  %c1 = index.constant 1 : index
  %tail = index.sub %waves, %c1 : index
  %padded = index.add %rows, %tail : index
  %groups = index.div %padded, %waves : index
  %wave_size = index.constant 32 : index
  %threads = index.mul %waves, %wave_size : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%rows_value: index, %length_value: index, %heads_value: index, %query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %rows = index.assume %rows_value [ge(%rows_value, 1), le(%rows_value, 66)] : index
  %length = index.assume %length_value [ge(%length_value, 1), le(%length_value, 33)] : index
  %heads = index.assume %heads_value [ge(%heads_value, 1), le(%heads_value, 20)] : index
  %waves = config.get @test.segmented_attention.waves : index
  %channels_per_lane = index.constant 4 : index
  %head_width = index.constant 128 : index
  %width = index.mul %heads, %head_width : index
  %group = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %row = index.madd %group, %waves, %wave : index
  %valid_row = index.cmp ult, %row, %rows : index
  %valid_head = index.cmp ult, %head, %heads : index
  %valid = scalar.andi %valid_row, %valid_head : i1
  scf.if %valid {
    %result = template.apply<@attention.segmented_128_bf16>(%rows, %length, %heads, %row, %head, %query, %key, %value) : (index, index, index, index, index, buffer, buffer, buffer) -> (vector<4xbf16>)
    %origin = index.constant 0 : offset
    %lane_channel = index.mul %lane, %channels_per_lane : index
    %column = index.madd %head, %head_width, %lane_channel : index
    %view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
    vector.store %result, %view[%row, %column] : vector<4xbf16>, view<[%rows]x[%width]xbf16>
  }
  kernel.return
}

command.program.def @segmented_attention_program(%rows: index, %length: index, %heads: index) launch(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  kernel.launch @apply_segmented_attention[%rows, %heads](%rows, %length, %heads, %query, %key, %value, %output) : [index, index](index, index, index, buffer, buffer, buffer, buffer)
  command.return
}

// A single key or equal logits reduce softmax to a segment-local mean. F64
// addition is exact for these multiples of 1/64. Dividing by 1 or 12 retains
// enough precision for BF16 publication through F32; storage uses the bit-level
// reference independently of native BF16 casts.
func.def @segmented_mean_reference(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %parameters[%origin] : buffer -> view<3xi32>
  %rows_word = view.load %metadata[0] : view<3xi32> -> i32
  %length_word = view.load %metadata[1] : view<3xi32> -> i32
  %heads_word = view.load %metadata[2] : view<3xi32> -> i32
  %rows_value = index.cast %rows_word : i32 to index
  %length_value = index.cast %length_word : i32 to index
  %heads_value = index.cast %heads_word : i32 to index
  %rows = index.assume %rows_value [ge(%rows_value, 1), le(%rows_value, 66)] : index
  %length = index.assume %length_value [ge(%length_value, 1), le(%length_value, 33)] : index
  %heads = index.assume %heads_value [ge(%heads_value, 1), le(%heads_value, 20)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %channels = index.constant 128 : index
  %width = index.mul %heads, %channels : index
  %values = buffer.view %value[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %c0_f64 = scalar.constant 0.0 : f64
  %divisor = scalar.uitofp %length_word : i32 to f64
  scf.for %row = [%c0 to %rows step %c1] {
    %segment = index.div %row, %length : index
    %begin = index.mul %segment, %length : index
    %segment_end = index.add %begin, %length : index
    %end = index.assume %segment_end [le(%segment_end, %rows)] : index
    scf.for %column = [%c0 to %width step %c1] {
      %total = scf.for %position = [%begin to %end step %c1](%sum = %c0_f64 : f64) -> (f64) {
        %word = view.load %values[%position, %column] : view<[%rows]x[%width]xi16> -> i16
        %element = func.call @reference_bf16_value(%word) : (i16) -> (f32)
        %wide = scalar.extf %element : f32 to f64
        %next = scalar.addf %sum, %wide : f64
        scf.yield %next : f64
      }
      %mean = scalar.divf %total, %divisor : f64
      %narrow = scalar.fptrunc %mean : f64 to f32
      %result = func.call @reference_bf16_bits(%narrow) : (f32) -> (i16)
      view.store %result, %outputs[%row, %column] : i16, view<[%rows]x[%width]xi16>
    }
  }
  func.return
}

check.scenario public @single_key {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(3) : index
  %length = check.literal value(1) : index
  %heads = check.literal value(2) : index
  %pattern = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %samples = check.generate.random.uniform seed(%seed) range(-63 to 63) : tensor<2304xi32>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    %query_storage = check.generate.fill value(17142) : tensor<800xi16>
    %query = check.tensor.view %query_storage offset(32) : tensor<800xi16> -> tensor<768xbf16>
    %key_storage = check.generate.fill value(17142) : tensor<800xi16>
    %key = check.tensor.view %key_storage offset(32) : tensor<800xi16> -> tensor<768xbf16>
    %value_storage = check.generate.fill value(17142) : tensor<800xi16>
    %value = check.tensor.view %value_storage offset(32) : tensor<800xi16> -> tensor<768xbf16>
    %output_storage = check.generate.fill value(17142) : tensor<800xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<800xi16> -> tensor<768xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<800xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(1568) : tensor<800xi16> -> tensor<16xi16>
    check.generate<@initialize_segmented_attention>(%rows, %length, %heads, %pattern, %samples, %parameters, %query, %key, %value) : (index, index, index, index, tensor<2304xi32>, tensor<3xi32>, tensor<768xbf16>, tensor<768xbf16>, tensor<768xbf16>) -> ()
    check.compare<@segmented_attention_program, @segmented_mean_reference>[%rows, %length, %heads](%parameters, %query, %key, %value, %output) : [index, index, index](tensor<3xi32>, tensor<768xbf16>, tensor<768xbf16>, tensor<768xbf16>, tensor<768xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<768xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<800xi16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<800xi16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<800xi16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@single_key> @single_key_benchmark

check.scenario public @constant_values {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(36) : index
  %length = check.literal value(12) : index
  %heads = check.literal value(2) : index
  %pattern = check.literal value(1) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %samples = check.generate.random.uniform seed(%seed) range(-63 to 63) : tensor<27648xi32>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    %query_storage = check.generate.fill value(17142) : tensor<9248xi16>
    %query = check.tensor.view %query_storage offset(32) : tensor<9248xi16> -> tensor<9216xbf16>
    %key_storage = check.generate.fill value(17142) : tensor<9248xi16>
    %key = check.tensor.view %key_storage offset(32) : tensor<9248xi16> -> tensor<9216xbf16>
    %value_storage = check.generate.fill value(17142) : tensor<9248xi16>
    %value = check.tensor.view %value_storage offset(32) : tensor<9248xi16> -> tensor<9216xbf16>
    %output_storage = check.generate.fill value(17142) : tensor<9248xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<9248xi16> -> tensor<9216xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<9248xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(18464) : tensor<9248xi16> -> tensor<16xi16>
    check.generate<@initialize_segmented_attention>(%rows, %length, %heads, %pattern, %samples, %parameters, %query, %key, %value) : (index, index, index, index, tensor<27648xi32>, tensor<3xi32>, tensor<9216xbf16>, tensor<9216xbf16>, tensor<9216xbf16>) -> ()
    check.compare<@segmented_attention_program, @segmented_mean_reference>[%rows, %length, %heads](%parameters, %query, %key, %value, %output) : [index, index, index](tensor<3xi32>, tensor<9216xbf16>, tensor<9216xbf16>, tensor<9216xbf16>, tensor<9216xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<9216xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<9248xi16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<9248xi16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<9248xi16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@constant_values> @constant_values_benchmark

check.scenario public @zero_scores {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(24) : index
  %length = check.literal value(12) : index
  %heads = check.literal value(2) : index
  %pattern = check.literal value(2) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %samples = check.generate.random.uniform seed(%seed) range(-63 to 63) : tensor<18432xi32>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    %query_storage = check.generate.fill value(17142) : tensor<6176xi16>
    %query = check.tensor.view %query_storage offset(32) : tensor<6176xi16> -> tensor<6144xbf16>
    %key_storage = check.generate.fill value(17142) : tensor<6176xi16>
    %key = check.tensor.view %key_storage offset(32) : tensor<6176xi16> -> tensor<6144xbf16>
    %value_storage = check.generate.fill value(17142) : tensor<6176xi16>
    %value = check.tensor.view %value_storage offset(32) : tensor<6176xi16> -> tensor<6144xbf16>
    %output_storage = check.generate.fill value(17142) : tensor<6176xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<6176xi16> -> tensor<6144xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<6176xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(12320) : tensor<6176xi16> -> tensor<16xi16>
    check.generate<@initialize_segmented_attention>(%rows, %length, %heads, %pattern, %samples, %parameters, %query, %key, %value) : (index, index, index, index, tensor<18432xi32>, tensor<3xi32>, tensor<6144xbf16>, tensor<6144xbf16>, tensor<6144xbf16>) -> ()
    check.compare<@segmented_attention_program, @segmented_mean_reference>[%rows, %length, %heads](%parameters, %query, %key, %value, %output) : [index, index, index](tensor<3xi32>, tensor<6144xbf16>, tensor<6144xbf16>, tensor<6144xbf16>, tensor<6144xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00039616230373003671) rtol(0.0078431372549019607) nan(different) : tensor<6144xbf16>, tensor<6144xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<6176xi16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<6176xi16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<6176xi16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@zero_scores> @zero_scores_benchmark

check.scenario public @pairs {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %rows = check.literal value(6) : index
  %length = check.literal value(2) : index
  %heads = check.literal value(2) : index
  %pattern = check.literal value(3) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %samples = check.generate.random.uniform seed(%seed) range(-63 to 63) : tensor<4608xi32>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    %query_storage = check.generate.fill value(17142) : tensor<1568xi16>
    %query = check.tensor.view %query_storage offset(32) : tensor<1568xi16> -> tensor<1536xbf16>
    %key_storage = check.generate.fill value(17142) : tensor<1568xi16>
    %key = check.tensor.view %key_storage offset(32) : tensor<1568xi16> -> tensor<1536xbf16>
    %value_storage = check.generate.fill value(17142) : tensor<1568xi16>
    %value = check.tensor.view %value_storage offset(32) : tensor<1568xi16> -> tensor<1536xbf16>
    %output_storage = check.generate.fill value(17142) : tensor<1568xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<1568xi16> -> tensor<1536xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<1568xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(3104) : tensor<1568xi16> -> tensor<16xi16>
    check.generate<@initialize_segmented_attention>(%rows, %length, %heads, %pattern, %samples, %parameters, %query, %key, %value) : (index, index, index, index, tensor<4608xi32>, tensor<3xi32>, tensor<1536xbf16>, tensor<1536xbf16>, tensor<1536xbf16>) -> ()
    check.compare<@segmented_attention_program, @segmented_attention_reference>[%rows, %length, %heads](%parameters, %query, %key, %value, %output) : [index, index, index](tensor<3xi32>, tensor<1536xbf16>, tensor<1536xbf16>, tensor<1536xbf16>, tensor<1536xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00042535534018751247) rtol(0.0078431372549019607) nan(different) : tensor<1536xbf16>, tensor<1536xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
