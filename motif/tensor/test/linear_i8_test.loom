// Signed I8 projection uses exact integer dot products, F32 row/channel scales,
// and one BF16 publication. Scalar VM arithmetic and integer BF16 rounding are
// independent of the production matrix fragments. Scenarios retain every row
// tail, panel and traversal boundary, nonzero payload origins, output padding,
// and immutable inputs. Directed operands distinguish signed extremes, scale
// order, large I32-to-F32 conversions, and both signs/parities of BF16 ties.
// The longest mixed reduction repeats a 256-term integer period; the largest
// sum has one exceptional term and a constant tail. Those exact identities
// bound reference work without changing the full device reductions.

amdgpu.target<gfx11-generic> @tensor_projection_tiled_rdna3

amdgpu.target<gfx11-generic> @i8_projection_wave32 {subgroup_size = 32}

template.decl @projection.linear_tiled_i8(%rows: index, %inputs: index, %outputs: index, %row_tile_group_size: index, %layout: encoding<layout>, %input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer, %output: buffer)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

template.decl @i8_shape(%configuration: index) -> (index, index, index, index, index, index, index)

template.def<@i8_shape> @i8_shape_values(%configuration: index) -> (index, index, index, index, index, index, index) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c80 = index.constant 80 : index
  %c96 = index.constant 96 : index
  %c112 = index.constant 112 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c192 = index.constant 192 : index
  %c256 = index.constant 256 : index
  %c272 = index.constant 272 : index
  %c6144 = index.constant 6144 : index
  %c16384 = index.constant 16384 : index
  %rows, %inputs, %outputs, %group = scf.lookup %configuration {
    0 = (%c16, %c64, %c64, %c1),
    1 = (%c32, %c128, %c64, %c1),
    2 = (%c48, %c192, %c128, %c1),
    3 = (%c64, %c256, %c64, %c1),
    4 = (%c80, %c128, %c192, %c2),
    5 = (%c96, %c192, %c64, %c1),
    6 = (%c112, %c128, %c64, %c1),
    7 = (%c128, %c256, %c128, %c1),
    8 = (%c144, %c192, %c192, %c2),
    9 = (%c272, %c128, %c64, %c2),
    10 = (%c16, %c128, %c64, %c8),
    11 = (%c16, %c64, %c64, %c1),
    12 = (%c16, %c6144, %c64, %c1)
  } default(%c16, %c16384, %c64, %c1) : index, index, index, index
  %column_major = index.cmp eq, %configuration, %c4 : index
  %padded = index.cmp eq, %configuration, %c8 : index
  %wide = index.add %outputs, %c16 : index
  %pitch = scf.select %padded, %wide, %outputs : index
  %row_stride = scf.select %column_major, %c1, %pitch : index
  %column_stride = scf.select %column_major, %rows, %c1 : index
  %output_count = index.mul %rows, %pitch : index
  template.return %rows, %inputs, %outputs, %group, %row_stride, %column_stride, %output_count : index, index, index, index, index, index, index
}

func.def @i8_storage(%configuration: index) -> (index, index, index, index, index) {
  %rows, %inputs, %outputs, %group, %row_stride, %column_stride, %output_count = template.apply<@i8_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index)
  %guards = index.constant 32 : index
  %input_storage = index.madd %rows, %inputs, %guards : index
  %row_storage = index.add %rows, %guards : index
  %weight_storage = index.madd %outputs, %inputs, %guards : index
  %channel_storage = index.add %outputs, %guards : index
  %output_storage = index.add %output_count, %guards : index
  func.return %input_storage, %row_storage, %weight_storage, %channel_storage, %output_storage : index, index, index, index, index
}

func.def @i8_input_value(%configuration: index, %row: index, %column: index) -> (i8) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %maximum = scalar.constant 127 : i32
  %value = scf.switch %configuration -> (i32) {
    case 11 {
      %first = index.cmp eq, %column, %c0 : index
      %second = index.cmp eq, %column, %c1 : index
      %tail = scf.select %second, %c1_i32, %c0_i32 : i32
      %value = scf.select %first, %maximum, %tail : i32
      scf.yield %value : i32
    }
    case 13 {
      %first = index.cmp eq, %column, %c0 : index
      %neighbor = scalar.constant 126 : i32
      %value = scf.select %first, %neighbor, %maximum : i32
      scf.yield %value : i32
    }
    default {
      %row_factor = index.constant 53 : index
      %column_factor = index.constant 31 : index
      %period = index.constant 256 : index
      %row_part = index.mul %row, %row_factor : index
      %affine = index.madd %column, %column_factor, %row_part : index
      %reduced = index.rem %affine, %period : index
      %unsigned = index.cast %reduced : index to i32
      %center = scalar.constant 128 : i32
      %value = scalar.subi %unsigned, %center : i32
      scf.yield %value : i32
    }
  }
  %byte = scalar.trunci %value : i32 to i8
  func.return %byte : i8
}

func.def @i8_weight_value(%configuration: index, %channel: index, %column: index) -> (i8) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %parity = index.rem %channel, %c2 : index
  %even = index.cmp eq, %parity, %c0 : index
  %value = scf.switch %configuration -> (i32) {
    case 11 {
      %c0_i32 = scalar.constant 0 : i32
      %c2_i32 = scalar.constant 2 : i32
      %c3_i32 = scalar.constant 3 : i32
      %c5_i32 = scalar.constant 5 : i32
      %phase = index.rem %channel, %c4 : index
      %positive = index.cmp ult, %phase, %c2 : index
      %first = index.cmp eq, %column, %c0 : index
      %second = index.cmp eq, %column, %c1 : index
      %midpoint = scf.select %even, %c3_i32, %c5_i32 : i32
      %tail = scf.select %second, %midpoint, %c0_i32 : i32
      %magnitude = scf.select %first, %c2_i32, %tail : i32
      %negative = scalar.subi %c0_i32, %magnitude : i32
      %value = scf.select %positive, %magnitude, %negative : i32
      scf.yield %value : i32
    }
    case 13 {
      %maximum = scalar.constant 127 : i32
      %minimum = scalar.constant -128 : i32
      %value = scf.select %even, %maximum, %minimum : i32
      scf.yield %value : i32
    }
    default {
      %row_factor = index.constant 41 : index
      %column_factor = index.constant 17 : index
      %period = index.constant 256 : index
      %row_part = index.mul %channel, %row_factor : index
      %affine = index.madd %column, %column_factor, %row_part : index
      %reduced = index.rem %affine, %period : index
      %unsigned = index.cast %reduced : index to i32
      %center = scalar.constant 128 : i32
      %value = scalar.subi %unsigned, %center : i32
      scf.yield %value : i32
    }
  }
  %byte = scalar.trunci %value : i32 to i8
  func.return %byte : i8
}

func.def @i8_scale(%position: index, %channel: i1) -> (f32) {
  %period = index.constant 7 : index
  %ordinal = index.rem %position, %period : index
  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %c0125 = scalar.constant 0.125 : f32
  %c025n = scalar.constant -0.25 : f32
  %c01 = scalar.constant 0.10000000000000001 : f32
  %c0001 = scalar.constant 0.001 : f32
  %c003125 = scalar.constant 0.03125 : f32
  %c00625 = scalar.constant 0.0625 : f32
  %c03 = scalar.constant 0.29999999999999999 : f32
  %c0125n = scalar.constant -0.125 : f32
  %c0009 = scalar.constant 0.0089999999999999993 : f32
  %c05 = scalar.constant 0.5 : f32
  %row_scale, %channel_scale = scf.lookup %ordinal {
    0 = (%c0, %c00625),
    1 = (%c0125, %c03),
    2 = (%c025n, %c0125n),
    3 = (%c01, %c1),
    4 = (%c0001, %c0009),
    5 = (%c1, %c05)
  } default(%c003125, %c0) : f32, f32
  %scale = scf.select %channel, %channel_scale, %row_scale : f32
  func.return %scale : f32
}

func.def @initialize_i8_projection(%configuration: index, %input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer) {
  %rows, %inputs, %outputs, %group, %row_stride, %column_stride, %output_count = template.apply<@i8_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index)
  %base = index.constant 0 : offset
  %byte_origin = index.constant 16 : offset
  %scale_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %midpoints = index.constant 11 : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %unit = scalar.constant 1.0 : f32
  %unit_scales = index.cmp eq, %configuration, %midpoints : index
  // The immutable scale prefix carries the reference's configuration. The
  // remaining prefix words and every other allocation boundary retain guards.
  %header = buffer.view %input_scales[%base] : buffer -> view<1xi32>
  %configuration_word = index.cast %configuration : index to i32
  view.store %configuration_word, %header[0] : i32, view<1xi32>
  %activation = buffer.view %input[%byte_origin] : buffer -> view<[%rows]x[%inputs]xi8>
  %weights = buffer.view %weight[%byte_origin] : buffer -> view<[%outputs]x[%inputs]xi8>
  %row_scales = buffer.view %input_scales[%scale_origin] : buffer -> view<[%rows]xf32>
  %channel_scales = buffer.view %weight_scales[%scale_origin] : buffer -> view<[%outputs]xf32>
  scf.for %row = [%c0 to %rows step %c1] {
    %mixed_scale = func.call @i8_scale(%row, %false) : (index, i1) -> (f32)
    %scale = scf.select %unit_scales, %unit, %mixed_scale : f32
    view.store %scale, %row_scales[%row] : f32, view<[%rows]xf32>
    scf.for %column = [%c0 to %inputs step %c1] {
      %value = func.call @i8_input_value(%configuration, %row, %column) : (index, index, index) -> (i8)
      view.store %value, %activation[%row, %column] : i8, view<[%rows]x[%inputs]xi8>
    }
  }
  scf.for %channel = [%c0 to %outputs step %c1] {
    %mixed_scale = func.call @i8_scale(%channel, %true) : (index, i1) -> (f32)
    %scale = scf.select %unit_scales, %unit, %mixed_scale : f32
    view.store %scale, %channel_scales[%channel] : f32, view<[%outputs]xf32>
    scf.for %column = [%c0 to %inputs step %c1] {
      %value = func.call @i8_weight_value(%configuration, %channel, %column) : (index, index, index) -> (i8)
      view.store %value, %weights[%channel, %column] : i8, view<[%outputs]x[%inputs]xi8>
    }
  }
  func.return
}

kernel.def target(@i8_projection_wave32) @apply_i8_projection(%rows: index, %outputs: index) {
  %tile = index.constant 128 : index
  %rounding = index.constant 127 : index
  %threads = index.constant 256 : index
  %unit = index.constant 1 : index
  %row_numerator = index.add %rows, %rounding : index
  %output_numerator = index.add %outputs, %rounding : index
  %row_tiles = index.div %row_numerator, %tile : index
  %output_tiles = index.div %output_numerator, %tile : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%configuration: index, %input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer, %output: buffer) {
  %rows, %inputs, %outputs, %group, %row_stride, %column_stride, %output_count = template.apply<@i8_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index)
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  template.apply<@projection.linear_tiled_i8>(%rows, %inputs, %outputs, %group, %layout, %input, %input_scales, %weight, %weight_scales, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

command.program.def @i8_projection_program(%configuration: index) launch(%input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer, %output: buffer) {
  %rows, %inputs, %outputs, %group, %row_stride, %column_stride, %output_count = template.apply<@i8_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index)
  %byte_origin = index.constant 16 : offset
  %scale_origin = index.constant 64 : offset
  %output_origin = index.constant 32 : offset
  %activation = buffer.view %input[%byte_origin] : buffer -> view<[%rows]x[%inputs]xi8>
  %row_scales = buffer.view %input_scales[%scale_origin] : buffer -> view<[%rows]xf32>
  %weights = buffer.view %weight[%byte_origin] : buffer -> view<[%outputs]x[%inputs]xi8>
  %channel_scales = buffer.view %weight_scales[%scale_origin] : buffer -> view<[%outputs]xf32>
  %results = buffer.view %output[%output_origin] : buffer -> view<[%output_count]xbf16>
  kernel.launch @apply_i8_projection[%rows, %outputs](%configuration, %activation, %row_scales, %weights, %channel_scales, %results) : [index, index](index, view<[%rows]x[%inputs]xi8>, view<[%rows]xf32>, view<[%outputs]x[%inputs]xi8>, view<[%outputs]xf32>, view<[%output_count]xbf16>)
  command.return
}

func.def @i8_projection_reference(%input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %byte_origin = index.constant 16 : offset
  %scale_origin = index.constant 64 : offset
  %output_origin = index.constant 32 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %large_case = index.constant 13 : index
  %period = index.constant 256 : index
  %c0_i32 = scalar.constant 0 : i32
  %header = buffer.view %input_scales[%base] : buffer -> view<1xi32>
  %configuration_word = view.load %header[0] : view<1xi32> -> i32
  %configuration = index.cast %configuration_word : i32 to index
  %rows, %inputs, %outputs, %group, %row_stride, %column_stride, %output_count = template.apply<@i8_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index)
  %activation = buffer.view %input[%byte_origin] : buffer -> view<[%rows]x[%inputs]xi8>
  %weights = buffer.view %weight[%byte_origin] : buffer -> view<[%outputs]x[%inputs]xi8>
  %row_scales = buffer.view %input_scales[%scale_origin] : buffer -> view<[%rows]xf32>
  %channel_scales = buffer.view %weight_scales[%scale_origin] : buffer -> view<[%outputs]xf32>
  %results = buffer.view %output[%output_origin] : buffer -> view<[%output_count]xi16>
  %large = index.cmp eq, %configuration, %large_case : index
  %terms = index.min %inputs, %period : index
  %repetitions = index.div %inputs, %terms : index
  %repeat_word = index.cast %repetitions : index to i32
  scf.for %row = [%c0 to %rows step %c1] {
    %row_scale = view.load %row_scales[%row] : view<[%rows]xf32> -> f32
    scf.for %channel = [%c0 to %outputs step %c1] {
      %total = scf.if %large -> (i32) {
        // One exceptional activation followed by a constant tail. Each weight
        // row is constant, so this is the exact integer dot product.
        %head = view.load %activation[%row, 0] : view<[%rows]x[%inputs]xi8> -> i8
        %tail = view.load %activation[%row, 1] : view<[%rows]x[%inputs]xi8> -> i8
        %right = view.load %weights[%channel, 0] : view<[%outputs]x[%inputs]xi8> -> i8
        %head_word = scalar.extsi %head : i8 to i32
        %tail_word = scalar.extsi %tail : i8 to i32
        %right_word = scalar.extsi %right : i8 to i32
        %remaining = index.sub %inputs, %c1 : index
        %remaining_word = index.cast %remaining : index to i32
        %repeated = scalar.muli %tail_word, %remaining_word : i32
        %sum = scalar.addi %head_word, %repeated : i32
        %total = scalar.muli %sum, %right_word : i32
        scf.yield %total : i32
      } else {
        // Both authored mixed operands repeat every 256 terms. Shorter
        // reductions, including the sparse midpoint case, read every term.
        %partial = scf.for %column = [%c0 to %terms step %c1](%sum = %c0_i32 : i32) -> (i32) {
          %input_column = index.assume %column [ge(%column, 0), lt(%column, %inputs)] : index
          %left = view.load %activation[%row, %input_column] : view<[%rows]x[%inputs]xi8> -> i8
          %right = view.load %weights[%channel, %input_column] : view<[%outputs]x[%inputs]xi8> -> i8
          %left_word = scalar.extsi %left : i8 to i32
          %right_word = scalar.extsi %right : i8 to i32
          %product = scalar.muli %left_word, %right_word : i32
          %next = scalar.addi %sum, %product : i32
          scf.yield %next : i32
        }
        %total = scalar.muli %partial, %repeat_word : i32
        scf.yield %total : i32
      }
      %channel_scale = view.load %channel_scales[%channel] : view<[%outputs]xf32> -> f32
      %scale = scalar.mulf %row_scale, %channel_scale : f32
      %dot = scalar.sitofp %total : i32 to f32
      %scaled = scalar.mulf %dot, %scale : f32
      %word = func.call @reference_bf16_bits(%scaled) : (f32) -> (i16)
      %row_offset = index.mul %row, %row_stride : index
      %position = index.madd %channel, %column_stride, %row_offset : index
      view.store %word, %results[%position] : i16, view<[%output_count]xi16>
    }
  }
  func.return
}

check.scenario public @i8_projection configure[14](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_count, %row_count, %weight_count, %channel_count, %output_count = check.generate<@i8_storage>(%configuration) : (index) -> (index, index, index, index, index)
    %input = check.generate.fill value(-77) : tensor<[%input_count]xi8>
    %input_scales = check.generate.fill value(-77) : tensor<[%row_count]xi32>
    %weight = check.generate.fill value(-77) : tensor<[%weight_count]xi8>
    %weight_scales = check.generate.fill value(-77) : tensor<[%channel_count]xi32>
    %output = check.generate.fill value(17142) : tensor<[%output_count]xi16>
    check.generate<@initialize_i8_projection>(%configuration, %input, %input_scales, %weight, %weight_scales) : (index, tensor<[%input_count]xi8>, tensor<[%row_count]xi32>, tensor<[%weight_count]xi8>, tensor<[%channel_count]xi32>) -> ()
    check.compare<@i8_projection_program, @i8_projection_reference>[%configuration](%input, %input_scales, %weight, %weight_scales, %output) : [index](tensor<[%input_count]xi8>, tensor<[%row_count]xi32>, tensor<[%weight_count]xi8>, tensor<[%channel_count]xi32>, tensor<[%output_count]xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xi8>
      check.expect.bitwise actual(%input_scales) expected(%input_scales) : tensor<[%row_count]xi32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<[%weight_count]xi8>
      check.expect.bitwise actual(%weight_scales) expected(%weight_scales) : tensor<[%channel_count]xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<[%output_count]xi16>
    }
  }
  check.return
}

check.benchmark<@i8_projection> @i8_projection_benchmark
