check.scenario public @four_model {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<40992xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<40992xi16> -> tensor<40960xbf16>
    %weight_storage = check.generate.fill value(-12345) : tensor<40992xi16>
    %weight = check.tensor.view %weight_storage offset(32) : tensor<40992xi16> -> tensor<40960xbf16>
    check.generate<@initialize_four_model>(%input, %weight) : (tensor<40960xbf16>, tensor<40960xbf16>) -> ()
    %wide_storage = check.generate.fill value(123.25) : tensor<288xf32>
    %wide = check.tensor.view %wide_storage offset(64) : tensor<288xf32> -> tensor<256xf32>
    %wide_prefix = check.tensor.view %wide_storage offset(0) : tensor<288xf32> -> tensor<16xf32>
    %wide_suffix = check.tensor.view %wide_storage offset(1088) : tensor<288xf32> -> tensor<16xf32>
    %output_storage = check.generate.fill value(17142) : tensor<288xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<288xi16> -> tensor<256xbf16>
    check.compare<@apply_four_model, @reference_four_model>(%input, %weight, %wide, %output) : (tensor<40960xbf16>, tensor<40960xbf16>, tensor<256xf32>, tensor<256xbf16>) -> () {
      check.expect.close actual(%wide) expected(%wide) atol(0.00053898990154266357) rtol(0.0) nan(different) : tensor<256xf32>
      check.expect.bitwise actual(%wide_prefix) expected(%wide_prefix) : tensor<16xf32>
      check.expect.bitwise actual(%wide_suffix) expected(%wide_suffix) : tensor<16xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<288xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<40992xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<40992xi16>
    }
  }
  check.return
}

check.benchmark<@four_model> @four_model_benchmark

