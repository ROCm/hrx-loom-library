// Single-wave projections exercise BF16/F32 checkpoint storage, four-chain
// accumulation, reverse tile traversal, and strided publication. The scalar
// oracle reads actual operands, independently rounds F32 weights to BF16, and
// sums exact dyadic products in F64. Named scenarios retain their storage and
// accuracy contracts: atol = max(sum(abs(products))) / 2^20, with zero relative
// tolerance and an absolute budget below half the smallest nonzero product.
// Accumulator-precision witnesses, BF16 results, and storage guards are exact.

amdgpu.target<gfx11-generic> @tensor_projection_rdna3

amdgpu.target<gfx11-generic> @projection_rdna3_wave32 {subgroup_size = 32}

template.decl @projection.linear_storage_bf16(%rows: index, %inputs: index, %outputs: index, %weight_is_bf16: i1, %row_origin: index, %output_origin: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)

template.decl @projection.linear_bf16(%rows: index, %inputs: index, %outputs: index, %row_origin: index, %output_origin: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)

template.decl @projection.store_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.decl @reference_bf16_round(%value: f32) -> (f32)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @linear_fixture_value(%row: index, %column: index, %weight: i1, %precision: i1) -> (f32)

template.decl @single_shape(%configuration: index) -> (index, index, index, index, index, index, i1, i1, i1)

template.def<@single_shape> @single_shape_values(%configuration: index) -> (index, index, index, index, index, index, i1, i1, i1) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c10 = index.constant 10 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c272 = index.constant 272 : index
  %c320 = index.constant 320 : index
  %c512 = index.constant 512 : index
  %c2560 = index.constant 2560 : index
  %c6144 = index.constant 6144 : index
  %rows, %inputs, %outputs = scf.lookup %configuration {
    0 = (%c16, %c16, %c16),
    1 = (%c32, %c48, %c48),
    2 = (%c32, %c272, %c32),
    3 = (%c16, %c16, %c32),
    4 = (%c16, %c6144, %c16),
    5 = (%c16, %c256, %c16),
    6 = (%c16, %c64, %c16),
    7 = (%c32, %c320, %c32),
    8 = (%c16, %c512, %c48),
    9 = (%c16, %c2560, %c16)
  } default(%c16, %c256, %c16) : index, index, index
  %padded = index.cmp eq, %configuration, %c1 : index
  %storage_column = index.cmp eq, %configuration, %c2 : index
  %four_column = index.cmp eq, %configuration, %c8 : index
  %column_major = scalar.ori %storage_column, %four_column : i1
  %wide = index.add %outputs, %c16 : index
  %pitch = scf.select %padded, %wide, %outputs : index
  %row_stride = scf.select %column_major, %c1, %pitch : index
  %column_stride = scf.select %column_major, %rows, %c1 : index
  %storage_first = index.cmp uge, %configuration, %c2 : index
  %storage_last = index.cmp ule, %configuration, %c4 : index
  %weight_f32 = scalar.andi %storage_first, %storage_last : i1
  %weight_bytes = scf.select %weight_f32, %c4, %c2 : index
  %four_chains = index.cmp uge, %configuration, %c6 : index
  %four_reverse = index.cmp eq, %configuration, %c7 : index
  %storage_reverse = scalar.ori %padded, %storage_column : i1
  %reverse = scalar.ori %storage_reverse, %four_reverse : i1
  %storage_precision = index.cmp eq, %configuration, %c5 : index
  %four_precision = index.cmp eq, %configuration, %c10 : index
  %precision = scalar.ori %storage_precision, %four_precision : i1
  template.return %rows, %inputs, %outputs, %row_stride, %column_stride, %weight_bytes, %four_chains, %reverse, %precision : index, index, index, index, index, index, i1, i1, i1
}

func.def @single_weight_value(%configuration: index, %channel: index, %column: index, %precision: i1) -> (f32) {
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %midpoints = index.cmp eq, %configuration, %c3 : index
  %value = scf.if %midpoints -> (f32) {
    %c0 = index.constant 0 : index
    %c2 = index.constant 2 : index
    %sum = index.add %channel, %column : index
    %phase = index.rem %sum, %c4 : index
    %parity = index.rem %phase, %c2 : index
    %odd = index.cmp ne, %parity, %c0 : index
    %negative = index.cmp uge, %phase, %c2 : index
    %even_midpoint = scalar.constant 1.00390625 : f32
    %odd_midpoint = scalar.constant 1.01171875 : f32
    %magnitude = scf.select %odd, %odd_midpoint, %even_midpoint : f32
    %signed = scalar.negf %magnitude : f32
    %value = scf.select %negative, %signed, %magnitude : f32
    scf.yield %value : f32
  } else {
    %true = scalar.constant true : i1
    %value = func.call @linear_fixture_value(%channel, %column, %true, %precision) : (index, index, i1, i1) -> (f32)
    scf.yield %value : f32
  }
  func.return %value : f32
}

func.def @initialize_single_projection(%configuration: index, %input: buffer, %weight: buffer) {
  %rows, %inputs, %outputs, %row_stride, %column_stride, %weight_bytes, %four_chains, %reverse, %precision = template.apply<@single_shape>(%configuration) : (index) -> (index, index, index, index, index, index, i1, i1, i1)
  %base = index.constant 0 : offset
  %origin = index.constant 32 : offset
  %wide_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %false = scalar.constant false : i1
  // Configuration is immutable reference metadata inside the guarded prefix.
  %header = buffer.view %input[%base] : buffer -> view<1xi32>
  %configuration_word = index.cast %configuration : index to i32
  view.store %configuration_word, %header[0] : i32, view<1xi32>
  %activation = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xi16>
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %column = [%c0 to %inputs step %c1] {
      %value = func.call @linear_fixture_value(%row, %column, %false, %precision) : (index, index, i1, i1) -> (f32)
      %word = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
      view.store %word, %activation[%row, %column] : i16, view<[%rows]x[%inputs]xi16>
    }
  }
  %weight_bf16 = index.cmp eq, %weight_bytes, %c2 : index
  scf.if %weight_bf16 {
    %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]xi16>
    scf.for %channel = [%c0 to %outputs step %c1] {
      scf.for %column = [%c0 to %inputs step %c1] {
        %value = func.call @single_weight_value(%configuration, %channel, %column, %precision) : (index, index, index, i1) -> (f32)
        %word = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
        view.store %word, %weights[%channel, %column] : i16, view<[%outputs]x[%inputs]xi16>
      }
    }
  } else {
    %weights = buffer.view %weight[%wide_origin] : buffer -> view<[%outputs]x[%inputs]xf32>
    scf.for %channel = [%c0 to %outputs step %c1] {
      scf.for %column = [%c0 to %inputs step %c1] {
        %value = func.call @single_weight_value(%configuration, %channel, %column, %precision) : (index, index, index, i1) -> (f32)
        view.store %value, %weights[%channel, %column] : f32, view<[%outputs]x[%inputs]xf32>
      }
    }
  }
  func.return
}

kernel.def target(@projection_rdna3_wave32) @apply_single_projection(%rows: index, %outputs: index) {
  %tile = index.constant 16 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.div %outputs, %tile : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%configuration: index, %input: buffer, %weight: buffer, %wide: buffer, %output: buffer) {
  %rows, %inputs, %outputs, %row_stride, %column_stride, %weight_bytes, %four_chains, %reverse, %precision = template.apply<@single_shape>(%configuration) : (index) -> (index, index, index, index, index, index, i1, i1, i1)
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.div %outputs, %tile : index
  %grid_row = kernel.workgroup.id<x> : index
  %grid_output = kernel.workgroup.id<y> : index
  %last_row = index.sub %row_tiles, %c1 : index
  %last_output = index.sub %output_tiles, %c1 : index
  %reversed_row = index.sub %last_row, %grid_row : index
  %reversed_output = index.sub %last_output, %grid_output : index
  %row_value = scf.select %reverse, %reversed_row, %grid_row : index
  %output_value = scf.select %reverse, %reversed_output, %grid_output : index
  %row_tile = index.assume %row_value [ge(%row_value, 0), lt(%row_value, %row_tiles)] : index
  %output_tile = index.assume %output_value [ge(%output_value, 0), lt(%output_value, %output_tiles)] : index
  %row_origin = index.mul %row_tile, %tile : index
  %output_origin = index.mul %output_tile, %tile : index
  %result = scf.if %four_chains -> (vector<8xf32>) {
    %value = template.apply<@projection.linear_bf16>(%rows, %inputs, %outputs, %row_origin, %output_origin, %input, %weight) : (index, index, index, index, index, buffer, buffer) -> (vector<8xf32>)
    scf.yield %value : vector<8xf32>
  } else {
    %weight_bf16 = index.cmp eq, %weight_bytes, %c2 : index
    %value = template.apply<@projection.linear_storage_bf16>(%rows, %inputs, %outputs, %weight_bf16, %row_origin, %output_origin, %input, %weight) : (index, index, index, i1, index, index, buffer, buffer) -> (vector<8xf32>)
    scf.yield %value : vector<8xf32>
  }
  %origin = index.constant 0 : offset
  %wide_view = buffer.view %wide[%origin] : buffer -> view<[%rows]x[%outputs]xf32>
  vector.fragment.store<result> %result, %wide_view[%row_origin, %output_origin] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%outputs]xf32>
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %layout, %result, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

command.program.def @single_projection_program(%configuration: index) launch(%input: buffer, %weight: buffer, %wide: buffer, %output: buffer) {
  %rows, %inputs, %outputs, %row_stride, %column_stride, %weight_bytes, %four_chains, %reverse, %precision = template.apply<@single_shape>(%configuration) : (index) -> (index, index, index, index, index, index, i1, i1, i1)
  %origin = index.constant 32 : offset
  %wide_origin = index.constant 64 : offset
  %guards = index.constant 16 : index
  %weight_elements = index.mul %outputs, %inputs : index
  %weight_length = index.mul %weight_elements, %weight_bytes : index
  %weight_prefix = index.mul %guards, %weight_bytes : index
  %weight_origin = index.cast %weight_prefix : index to offset
  %pitch = index.max %row_stride, %outputs : index
  %output_count = index.mul %rows, %pitch : index
  %activation = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xbf16>
  %weights = buffer.view %weight[%weight_origin] : buffer -> view<[%weight_length]xi8>
  %accumulators = buffer.view %wide[%wide_origin] : buffer -> view<[%rows]x[%outputs]xf32>
  %results = buffer.view %output[%origin] : buffer -> view<[%output_count]xbf16>
  kernel.launch @apply_single_projection[%rows, %outputs](%configuration, %activation, %weights, %accumulators, %results) : [index, index](index, view<[%rows]x[%inputs]xbf16>, view<[%weight_length]xi8>, view<[%rows]x[%outputs]xf32>, view<[%output_count]xbf16>)
  command.return
}

func.def @single_projection_reference(%input: buffer, %weight: buffer, %wide: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %origin = index.constant 32 : offset
  %wide_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c0_f64 = scalar.constant 0.0 : f64
  %header = buffer.view %input[%base] : buffer -> view<1xi32>
  %configuration_word = view.load %header[0] : view<1xi32> -> i32
  %configuration = index.cast %configuration_word : i32 to index
  %rows, %inputs, %outputs, %row_stride, %column_stride, %weight_bytes, %four_chains, %reverse, %precision = template.apply<@single_shape>(%configuration) : (index) -> (index, index, index, index, index, index, i1, i1, i1)
  %pitch = index.max %row_stride, %outputs : index
  %output_count = index.mul %rows, %pitch : index
  %activation = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xi16>
  %accumulators = buffer.view %wide[%wide_origin] : buffer -> view<[%rows]x[%outputs]xf32>
  %results = buffer.view %output[%origin] : buffer -> view<[%output_count]xi16>
  %weight_bf16 = index.cmp eq, %weight_bytes, %c2 : index
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %channel = [%c0 to %outputs step %c1] {
      %total = scf.for %column = [%c0 to %inputs step %c1](%sum = %c0_f64 : f64) -> (f64) {
        %left_word = view.load %activation[%row, %column] : view<[%rows]x[%inputs]xi16> -> i16
        %left = func.call @reference_bf16_value(%left_word) : (i16) -> (f32)
        %right = scf.if %weight_bf16 -> (f32) {
          %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]xi16>
          %word = view.load %weights[%channel, %column] : view<[%outputs]x[%inputs]xi16> -> i16
          %value = func.call @reference_bf16_value(%word) : (i16) -> (f32)
          scf.yield %value : f32
        } else {
          %weights = buffer.view %weight[%wide_origin] : buffer -> view<[%outputs]x[%inputs]xf32>
          %value = view.load %weights[%channel, %column] : view<[%outputs]x[%inputs]xf32> -> f32
          %rounded = func.call @reference_bf16_round(%value) : (f32) -> (f32)
          scf.yield %rounded : f32
        }
        %left_wide = scalar.extf %left : f32 to f64
        %right_wide = scalar.extf %right : f32 to f64
        %product = scalar.mulf %left_wide, %right_wide : f64
        %next = scalar.addf %sum, %product : f64
        scf.yield %next : f64
      }
      %value = scalar.fptrunc %total : f64 to f32
      view.store %value, %accumulators[%row, %channel] : f32, view<[%rows]x[%outputs]xf32>
      %word = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
      %row_offset = index.mul %row, %row_stride : index
      %position_value = index.madd %channel, %column_stride, %row_offset : index
      %position = index.assume %position_value [ge(%position_value, 0), lt(%position_value, %output_count)] : index
      view.store %word, %results[%position] : i16, view<[%output_count]xi16>
    }
  }
  func.return
}

check.scenario public @storage_minimum {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %configuration = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<288xi16>
    %weight_storage = check.generate.fill value(-12345) : tensor<288xi16>
    check.generate<@initialize_single_projection>(%configuration, %input_storage, %weight_storage) : (index, tensor<288xi16>, tensor<288xi16>) -> ()
    %wide_storage = check.generate.fill value(123.25) : tensor<288xf32>
    %wide = check.tensor.view %wide_storage offset(64) : tensor<288xf32> -> tensor<256xf32>
    %wide_prefix = check.tensor.view %wide_storage offset(0) : tensor<288xf32> -> tensor<16xf32>
    %wide_suffix = check.tensor.view %wide_storage offset(1088) : tensor<288xf32> -> tensor<16xf32>
    %output_storage = check.generate.fill value(17142) : tensor<288xi16>
    check.compare<@single_projection_program, @single_projection_reference>[%configuration](%input_storage, %weight_storage, %wide_storage, %output_storage) : [index](tensor<288xi16>, tensor<288xi16>, tensor<288xf32>, tensor<288xi16>) -> () {
      check.expect.approximate actual(%wide) expected(%wide) atol(3.8295984268188477e-06) rtol(0.0) nan(different) : tensor<256xf32>, tensor<256xf32>
      check.expect.bitwise actual(%wide_prefix) expected(%wide_prefix) : tensor<16xf32>
      check.expect.bitwise actual(%wide_suffix) expected(%wide_suffix) : tensor<16xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<288xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<288xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<288xi16>
    }
  }
  check.return
}

check.benchmark<@storage_minimum> @storage_minimum_benchmark

check.scenario public @storage_short_tail {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %configuration = check.literal value(1) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<1568xi16>
    %weight_storage = check.generate.fill value(-12345) : tensor<2336xi16>
    check.generate<@initialize_single_projection>(%configuration, %input_storage, %weight_storage) : (index, tensor<1568xi16>, tensor<2336xi16>) -> ()
    %wide_storage = check.generate.fill value(123.25) : tensor<1568xf32>
    %wide = check.tensor.view %wide_storage offset(64) : tensor<1568xf32> -> tensor<1536xf32>
    %wide_prefix = check.tensor.view %wide_storage offset(0) : tensor<1568xf32> -> tensor<16xf32>
    %wide_suffix = check.tensor.view %wide_storage offset(6208) : tensor<1568xf32> -> tensor<16xf32>
    %output_storage = check.generate.fill value(17142) : tensor<2080xi16>
    check.compare<@single_projection_program, @single_projection_reference>[%configuration](%input_storage, %weight_storage, %wide_storage, %output_storage) : [index](tensor<1568xi16>, tensor<2336xi16>, tensor<1568xf32>, tensor<2080xi16>) -> () {
      check.expect.approximate actual(%wide) expected(%wide) atol(1.0266900062561035e-05) rtol(0.0) nan(different) : tensor<1536xf32>, tensor<1536xf32>
      check.expect.bitwise actual(%wide_prefix) expected(%wide_prefix) : tensor<16xf32>
      check.expect.bitwise actual(%wide_suffix) expected(%wide_suffix) : tensor<16xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<2080xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1568xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<2336xi16>
    }
  }
  check.return
}

check.benchmark<@storage_short_tail> @storage_short_tail_benchmark

