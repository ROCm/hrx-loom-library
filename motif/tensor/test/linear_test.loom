      check.expect.bitwise actual(%wide_suffix) expected(%wide_suffix) : tensor<16xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<1056xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<8736xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<8736xf32>
