check.benchmark<@storage_midpoints> @storage_midpoints_benchmark

check.scenario public @storage_model {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %configuration = check.literal value(4) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<98336xi16>
    %weight_storage = check.generate.fill value(123.25) : tensor<98336xf32>
    check.generate<@initialize_single_projection>(%configuration, %input_storage, %weight_storage) : (index, tensor<98336xi16>, tensor<98336xf32>) -> ()
    %wide_storage = check.generate.fill value(123.25) : tensor<288xf32>
    %wide = check.tensor.view %wide_storage offset(64) : tensor<288xf32> -> tensor<256xf32>
    %wide_prefix = check.tensor.view %wide_storage offset(0) : tensor<288xf32> -> tensor<16xf32>
    %wide_suffix = check.tensor.view %wide_storage offset(1088) : tensor<288xf32> -> tensor<16xf32>
    %output_storage = check.generate.fill value(17142) : tensor<288xi16>
    check.compare<@single_projection_program, @single_projection_reference>[%configuration](%input_storage, %weight_storage, %wide_storage, %output_storage) : [index](tensor<98336xi16>, tensor<98336xf32>, tensor<288xf32>, tensor<288xi16>) -> () {
      check.expect.approximate actual(%wide) expected(%wide) atol(0.0012938976287841797) rtol(0.0) nan(different) : tensor<256xf32>, tensor<256xf32>
      check.expect.bitwise actual(%wide_prefix) expected(%wide_prefix) : tensor<16xf32>
      check.expect.bitwise actual(%wide_suffix) expected(%wide_suffix) : tensor<16xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<288xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<98336xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<98336xf32>
    }
  }
  check.return
}

