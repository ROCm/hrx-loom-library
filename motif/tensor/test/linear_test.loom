    %wide_prefix = check.tensor.view %wide_storage offset(0) : tensor<1056xf32> -> tensor<16xf32>
    %wide_suffix = check.tensor.view %wide_storage offset(4160) : tensor<1056xf32> -> tensor<16xf32>
    %output_storage = check.generate.fill value(17142) : tensor<1056xi16>
