global.rodata.def @single_ids = align(4) bytes("00000000")

kernel.def target(@embedding_wave32) @gather_single() {
  %rows = index.constant 1 : index
  %groups = index.constant 1 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
