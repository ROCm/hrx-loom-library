// Gather immutable BF16 rows without interpreting their bits as numbers. The
// independent VM oracle copies complete rows; the device motif loads individual
// values. Directed IDs cover duplicates, vocabulary boundaries, and reversed
// rows. Weight words span every BF16 encoding, including NaNs and signed zero,
// with a non-power-of-two period distinguishing high vocabulary IDs. Complete
// allocations retain input immutability and guards around nonzero origins.

config.def @test.embedding.workgroup_size = 64 : %value: index where [range(%value, 32, 256)]

template.decl @embedding.lookup_bf16(%vocabulary: index, %width: index, %token_id: i32, %channel: index, %weight: buffer) -> (bf16)

template.decl @embedding_shape(%configuration: index) -> (index, index, index)

template.def<@embedding_shape> @embedding_shape_values(%configuration: index) -> (index, index, index) {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c17 = index.constant 17 : index
  %c31 = index.constant 31 : index
  %c256 = index.constant 256 : index
  %c2560 = index.constant 2560 : index
  %c151936 = index.constant 151936 : index
  %rows, %vocabulary, %width = scf.lookup %configuration {
    0 = (%c1, %c1, %c1),
    1 = (%c4, %c17, %c31),
    2 = (%c5, %c151936, %c3),
    3 = (%c4, %c3, %c2560)
  } default(%c256, %c256, %c256) : index, index, index
  template.return %rows, %vocabulary, %width : index, index, index
}

func.def @embedding_storage(%configuration: index) -> (index, index, index, index) {
  %rows, %vocabulary, %width = template.apply<@embedding_shape>(%configuration) : (index) -> (index, index, index)
  %guards = index.constant 32 : index
  %id_count = index.add %rows, %guards : index
  %weight_count = index.madd %vocabulary, %width, %guards : index
  %output_count = index.madd %rows, %width, %guards : index
  func.return %rows, %id_count, %weight_count, %output_count : index, index, index, index
}

func.def @embedding_id(%configuration: index, %row: index) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %selected = scf.switch %configuration -> (i32) {
    case 0 {
      scf.yield %c0 : i32
    }
    case 1 {
      %c7 = scalar.constant 7 : i32
      %c16 = scalar.constant 16 : i32
      %ids = vector.from_elements %c16, %c0, %c7, %c7 : vector<4xi32>
      %selected = vector.extract %ids[%row] : vector<4xi32> -> i32
      scf.yield %selected : i32
    }
    case 2 {
      %c128 = scalar.constant 128 : i32
      %c65535 = scalar.constant 65535 : i32
      %c65536 = scalar.constant 65536 : i32
      %c151935 = scalar.constant 151935 : i32
      %ids = vector.from_elements %c151935, %c0, %c65536, %c65535, %c128 : vector<5xi32>
      %selected = vector.extract %ids[%row] : vector<5xi32> -> i32
      scf.yield %selected : i32
    }
    case 3 {
      %c1 = scalar.constant 1 : i32
      %c2 = scalar.constant 2 : i32
      %ids = vector.from_elements %c2, %c0, %c1, %c2 : vector<4xi32>
      %selected = vector.extract %ids[%row] : vector<4xi32> -> i32
      scf.yield %selected : i32
    }
    default {
      %last = scalar.constant 255 : i32
      %word = index.cast %row : index to i32
      %selected = scalar.subi %last, %word : i32
      scf.yield %selected : i32
    }
  }
  func.return %selected : i32
}

func.def @initialize_embedding(%configuration: index, %weight_count: index, %ids: buffer, %weight: buffer) {
  %rows, %vocabulary, %width = template.apply<@embedding_shape>(%configuration) : (index) -> (index, index, index)
  %base = index.constant 0 : offset
  %id_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %header = buffer.view %ids[%base] : buffer -> view<3xi32>
  %row_word = index.cast %rows : index to i32
  %width_word = index.cast %width : index to i32
  %vocabulary_word = index.cast %vocabulary : index to i32
  view.store %row_word, %header[0] : i32, view<3xi32>
  view.store %width_word, %header[1] : i32, view<3xi32>
  view.store %vocabulary_word, %header[2] : i32, view<3xi32>
  %tokens = buffer.view %ids[%id_origin] : buffer -> view<[%rows]xi32>
  scf.for %row = [%c0 to %rows step %c1] {
    %selected = func.call @embedding_id(%configuration, %row) : (index, index) -> (i32)
    view.store %selected, %tokens[%row] : i32, view<[%rows]xi32>
  }
  %boundary_case = index.cmp eq, %configuration, %c2 : index
  scf.if %boundary_case {
    %period = index.constant 65521 : index
    %minimum = scalar.constant -32768 : i32
    %words = buffer.view %weight[%base] : buffer -> view<[%weight_count]xi16>
    scf.for %position = [%c0 to %weight_count step %c1] {
      %reduced = index.rem %position, %period : index
      %value = index.cast %reduced : index to i32
      %signed = scalar.addi %value, %minimum : i32
      %word = scalar.trunci %signed : i32 to i16
      view.store %word, %words[%position] : i16, view<[%weight_count]xi16>
    }
  }
  func.return
}

kernel.def @gather_embedding(%rows: index, %vocabulary: index, %width: index) {
  %threads = config.get @test.embedding.workgroup_size : index
  %unit = index.constant 1 : index
  %padded = index.add %width, %threads : index
  %numerator = index.sub %padded, %unit : index
  %groups = index.div %numerator, %threads : index
  kernel.launch.config workgroups(%rows, %groups, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%rows: index, %vocabulary: index, %width: index, %ids: buffer, %weight: buffer, %output: buffer) {
  %threads = config.get @test.embedding.workgroup_size : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [ge(%row_id, 0), lt(%row_id, %rows)] : index
  %group = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %channel_id = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %channel_id, %width : index
  scf.if %live {
    %channel = index.assume %channel_id [ge(%channel_id, 0), lt(%channel_id, %width)] : index
    %id_origin = index.constant 64 : offset
    %output_origin = index.constant 32 : offset
    %tokens = buffer.view %ids[%id_origin] : buffer -> view<[%rows]xi32>
    %outputs = buffer.view %output[%output_origin] : buffer -> view<[%rows]x[%width]xbf16>
    %token = view.load %tokens[%row] : view<[%rows]xi32> -> i32
    %value = template.apply<@embedding.lookup_bf16>(%vocabulary, %width, %token, %channel, %weight) : (index, index, i32, index, buffer) -> (bf16)
    view.store %value, %outputs[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
  }
  kernel.return
}

command.program.def @embedding_program(%configuration: index) launch(%ids: buffer, %weight_storage: buffer, %output: buffer) {
  %rows, %vocabulary, %width = template.apply<@embedding_shape>(%configuration) : (index) -> (index, index, index)
  %weight_origin = index.constant 32 : offset
  %weight = buffer.view %weight_storage[%weight_origin] : buffer -> view<[%vocabulary]x[%width]xbf16>
  kernel.launch @gather_embedding[%rows, %vocabulary, %width](%rows, %vocabulary, %width, %ids, %weight, %output) : [index, index, index](index, index, index, buffer, view<[%vocabulary]x[%width]xbf16>, buffer)
  command.return
}

// Copy complete selected byte ranges without reusing the element lookup or its
// address expression. Shapes occupy the immutable ID prefix, outside the payload.
func.def @embedding_reference(%ids: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %id_origin = index.constant 64 : offset
  %payload_origin = index.constant 32 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element_bytes = index.constant 2 : offset
  %header = buffer.view %ids[%base] : buffer -> view<3xi32>
  %row_word = view.load %header[0] : view<3xi32> -> i32
  %width_word = view.load %header[1] : view<3xi32> -> i32
  %vocabulary_word = view.load %header[2] : view<3xi32> -> i32
  %rows = index.cast %row_word : i32 to index
  %width_value = index.cast %width_word : i32 to index
  %width = index.assume %width_value [ge(%width_value, 1), le(%width_value, 2560)] : index
  %vocabulary = index.cast %vocabulary_word : i32 to index
  %tokens = buffer.view %ids[%id_origin] : buffer -> view<[%rows]xi32>
  %row_bytes = index.scale %width, %element_bytes : index, offset -> offset
  scf.for %row = [%c0 to %rows step %c1] {
    %token = view.load %tokens[%row] : view<[%rows]xi32> -> i32
    %selected_value = index.cast %token : i32 to index
    %selected = index.assume %selected_value [ge(%selected_value, 0), lt(%selected_value, %vocabulary)] : index
    %source_row = index.scale %selected, %row_bytes : index, offset -> offset
    %destination_row = index.scale %row, %row_bytes : index, offset -> offset
    %source = index.add %source_row, %payload_origin : offset
    %destination = index.add %destination_row, %payload_origin : offset
    buffer.copy %weight[%source], %output[%destination], %row_bytes
  }
  func.return
}

check.scenario public @embedding_rows configure[5](%configuration: index, %configuration_entropy: check.entropy) {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %rows, %id_count, %weight_count, %output_count = check.generate<@embedding_storage>(%configuration) : (index) -> (index, index, index, index)
    %id_storage = check.generate.fill value(-1) : tensor<[%id_count]xi32>
    %weight_storage = check.generate.iota offset(-32768) step(1) period(65536) : tensor<[%weight_count]xi16>
    %output_storage = check.generate.fill value(-12345) : tensor<[%output_count]xi16>
    check.generate<@initialize_embedding>(%configuration, %weight_count, %id_storage, %weight_storage) : (index, index, tensor<[%id_count]xi32>, tensor<[%weight_count]xi16>) -> ()
    check.compare<@embedding_program, @embedding_reference>[%configuration](%id_storage, %weight_storage, %output_storage) : [index](tensor<[%id_count]xi32>, tensor<[%weight_count]xi16>, tensor<[%output_count]xi16>) -> () {
      check.expect.bitwise actual(%id_storage) expected(%id_storage) : tensor<[%id_count]xi32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<[%weight_count]xi16>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<[%output_count]xi16>
    }
  }
  check.return
}

check.benchmark<@embedding_rows> @embedding_rows_benchmark
