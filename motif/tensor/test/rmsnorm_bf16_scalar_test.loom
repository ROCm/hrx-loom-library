// Check both RMS BF16 epilogue contracts against an independent VM oracle.
// The oracle rounds finite F32 values to BF16 with integer bits, without the
// production casts. Halfway inputs expose the weight, scale-offset, and
// normalized-value rounding boundaries; random values supplement signed zeros,
// subnormals, and widely separated exponents. Rounding checks are bitwise;
// directed underflow cases have separate bounds for native subnormal flushing.
// All inputs and expected values are constructed in IR, with no external data
// or generator dependency.
// Nonzero buffer origins, complete input immutability, and output guards check
// storage ownership independently of numerical acceptance.

template.decl @normalization.zero_centered_bf16(%value: bf16, %weight: f32, %inverse: f32) -> (bf16)

template.decl @normalization.scaled_bf16(%value: bf16, %weight: bf16, %inverse: f32) -> (bf16)

func.decl @reference_bf16_round(%value: f32) -> (f32)

func.def @initialize_epilogue_inputs(%input: buffer) {
  %origin = index.constant 0 : offset
  %count = index.constant 186 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c20 = index.constant 20 : index
  %boundary_end = index.constant 40 : index
  %random_end = index.constant 168 : index
  %unit = scalar.constant 1.0 : f32
  %negative_sign = scalar.constant -1.0 : f32
  %half = scalar.constant 0.5 : f32
  %one_and_half = scalar.constant 1.5 : f32
  %negative_one_and_half = scalar.constant -1.5 : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xf32>
  scf.for %row = [%c0 to %count step %c1] {
    %boundary = index.cmp ult, %row, %boundary_end : index
    %value, %weight, %inverse = scf.if %boundary -> (f32, f32, f32) {
      // Odd numerators 1, 3, 7, 63, and 127 hit both sides of exponent
      // boundaries. Each combines both weight signs, both value signs,
      // and weights near one and near zero.
      %group = index.div %row, %c4 : index
      %ordinal = index.rem %group, %c5 : index
      %early = index.cmp ult, %ordinal, %c3 : index
      %low = index.add %ordinal, %c1 : index
      %high = index.add %ordinal, %c3 : index
      %exponent = scf.select %early, %low, %high : index
      %shift = index.cast %exponent : index to i32
      %integer_one = scalar.constant 1 : i32
      %power = scalar.shli %integer_one, %shift : i32
      %numerator = scalar.subi %power, %integer_one : i32
      %fraction = scalar.uitofp %numerator : i32 to f32
      %spacing = scalar.constant 0.00390625 : f32
      %delta = scalar.mulf %fraction, %spacing : f32
      %near_one = scalar.addf %unit, %delta : f32
      %near_zero = scalar.mulf %delta, %half : f32
      %kind = index.rem %row, %c2 : index
      %first = index.cmp eq, %kind, %c0 : index
      %magnitude = scf.select %first, %near_one, %near_zero : f32
      %negative_weight = index.cmp ult, %row, %c20 : index
      %sign = scf.select %negative_weight, %negative_sign, %unit : f32
      %weight = scalar.mulf %magnitude, %sign : f32
      %within_group = index.rem %row, %c4 : index
      %negative_value = index.cmp ult, %within_group, %c2 : index
      %value = scf.select %negative_value, %negative_one_and_half, %one_and_half : f32
      %inverse = scalar.divf %near_one, %one_and_half : f32
      scf.yield %value, %weight, %inverse : f32, f32, f32
    } else {
      %random = index.cmp ult, %row, %random_end : index
      %value, %weight, %inverse = scf.if %random -> (f32, f32, f32) {
        %value_unit = view.load %inputs[%row, 0] : view<[%count]x3xf32> -> f32
        %weight_unit = view.load %inputs[%row, 1] : view<[%count]x3xf32> -> f32
        %inverse_unit = view.load %inputs[%row, 2] : view<[%count]x3xf32> -> f32
        %value_range = scalar.constant 8.0 : f32
        %weight_range = scalar.constant 4.0 : f32
        %inverse_range = scalar.constant 3.9375 : f32
        %inverse_center = scalar.constant 4.0625 : f32
        %value_f32 = scalar.mulf %value_unit, %value_range : f32
        %value = func.call @reference_bf16_round(%value_f32) : (f32) -> (f32)
        %weight = scalar.mulf %weight_unit, %weight_range : f32
        %inverse_delta = scalar.mulf %inverse_unit, %inverse_range : f32
        %inverse = scalar.addf %inverse_center, %inverse_delta : f32
        scf.yield %value, %weight, %inverse : f32, f32, f32
      } else {
        // Exact F32 words for +0, -0, the signed minimum BF16 subnormals,
        // the minimum normal, and 2^100. Each uses weights -1, 1, and 2.
        %element = index.sub %row, %random_end : index
        %ordinal = index.div %element, %c3 : index
        %c0_i32 = scalar.constant 0 : i32
        %sign_bit = scalar.constant -2147483648 : i32
        %subnormal = scalar.constant 65536 : i32
        %negative_subnormal = scalar.constant -2147418112 : i32
        %normal = scalar.constant 8388608 : i32
        %large = scalar.constant 1904214016 : i32
        %is_negative_zero = index.cmp eq, %ordinal, %c1 : index
        %is_subnormal = index.cmp eq, %ordinal, %c2 : index
        %is_negative_subnormal = index.cmp eq, %ordinal, %c3 : index
        %is_normal = index.cmp eq, %ordinal, %c4 : index
        %is_large = index.cmp eq, %ordinal, %c5 : index
        %zero_bits = scf.select %is_negative_zero, %sign_bit, %c0_i32 : i32
        %small_bits = scf.select %is_subnormal, %subnormal, %zero_bits : i32
        %signed_bits = scf.select %is_negative_subnormal, %negative_subnormal, %small_bits : i32
        %normal_bits = scf.select %is_normal, %normal, %signed_bits : i32
        %bits = scf.select %is_large, %large, %normal_bits : i32
        %value = scalar.bitcast %bits : i32 to f32
        %weight_ordinal = index.rem %element, %c3 : index
        %weight_integer = index.cast %weight_ordinal : index to i32
        %weight_positive = scalar.uitofp %weight_integer : i32 to f32
        %first = index.cmp eq, %weight_ordinal, %c0 : index
        %weight = scf.select %first, %negative_sign, %weight_positive : f32
        scf.yield %value, %weight, %half : f32, f32, f32
      }
      scf.yield %value, %weight, %inverse : f32, f32, f32
    }
    view.store %value, %inputs[%row, 0] : f32, view<[%count]x3xf32>
    view.store %weight, %inputs[%row, 1] : f32, view<[%count]x3xf32>
    view.store %inverse, %inputs[%row, 2] : f32, view<[%count]x3xf32>
  }
  func.return
}

kernel.def @epilogues() {
  %groups = index.constant 2 : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %count = index.constant 186 : index
  %threads = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xf32>
    %outputs = buffer.view %output[%origin] : buffer -> view<[%count]x2xbf16>
    %stored = view.load %inputs[%row, 0] : view<[%count]x3xf32> -> f32
    %weight = view.load %inputs[%row, 1] : view<[%count]x3xf32> -> f32
    %inverse = view.load %inputs[%row, 2] : view<[%count]x3xf32> -> f32
    %value = scalar.fptrunc %stored : f32 to bf16
    %weight_bf16 = scalar.fptrunc %weight : f32 to bf16
    %centered = template.apply<@normalization.zero_centered_bf16>(%value, %weight, %inverse) : (bf16, f32, f32) -> (bf16)
    %scaled = template.apply<@normalization.scaled_bf16>(%value, %weight_bf16, %inverse) : (bf16, bf16, f32) -> (bf16)
    view.store %centered, %outputs[%row, 0] : bf16, view<[%count]x2xbf16>
    view.store %scaled, %outputs[%row, 1] : bf16, view<[%count]x2xbf16>
  }
  kernel.return
}

func.def @reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %count = index.constant 186 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %scale_offset = scalar.constant 1.0 : f32
  %shift = scalar.constant 16 : i32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%count]x2xi16>
  scf.for %row = [%c0 to %count step %c1] {
    %value = view.load %inputs[%row, 0] : view<[%count]x3xf32> -> f32
    %weight_f32 = view.load %inputs[%row, 1] : view<[%count]x3xf32> -> f32
    %inverse = view.load %inputs[%row, 2] : view<[%count]x3xf32> -> f32
    %weight = func.call @reference_bf16_round(%weight_f32) : (f32) -> (f32)
    %offset = scalar.addf %weight, %scale_offset : f32
    %scale = func.call @reference_bf16_round(%offset) : (f32) -> (f32)
    %normalized = scalar.mulf %value, %inverse : f32
    %centered_f32 = scalar.mulf %normalized, %scale : f32
    %centered = func.call @reference_bf16_round(%centered_f32) : (f32) -> (f32)
    %rounded = func.call @reference_bf16_round(%normalized) : (f32) -> (f32)
    %scaled_f32 = scalar.mulf %rounded, %weight : f32
    %scaled = func.call @reference_bf16_round(%scaled_f32) : (f32) -> (f32)
    %centered_bits = scalar.bitcast %centered : f32 to i32
    %scaled_bits = scalar.bitcast %scaled : f32 to i32
    %centered_upper = scalar.shrui %centered_bits, %shift : i32
    %scaled_upper = scalar.shrui %scaled_bits, %shift : i32
    %centered_word = scalar.trunci %centered_upper : i32 to i16
    %scaled_word = scalar.trunci %scaled_upper : i32 to i16
    view.store %centered_word, %outputs[%row, 0] : i16, view<[%count]x2xi16>
    view.store %scaled_word, %outputs[%row, 1] : i16, view<[%count]x2xi16>
  }
  func.return
}

check.scenario public @epilogue_rounding {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<590xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<590xf32> -> tensor<558xf32>
    check.generate<@initialize_epilogue_inputs>(%input) : (tensor<558xf32>) -> ()
    %output_storage = check.generate.fill value(-12345) : tensor<404xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<404xi16> -> tensor<372xbf16>
    %rounding = check.tensor.view %output offset(0) : tensor<372xbf16> -> tensor<348xbf16>
    %subnormal = check.tensor.view %output offset(696) : tensor<372xbf16> -> tensor<12xbf16>
    %underflow = check.tensor.view %output offset(720) : tensor<372xbf16> -> tensor<6xbf16>
    %large = check.tensor.view %output offset(732) : tensor<372xbf16> -> tensor<6xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<404xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(776) : tensor<404xi16> -> tensor<16xi16>
    check.compare<@epilogues, @reference>(%input, %output) : (tensor<558xf32>, tensor<372xbf16>) -> () {
      check.expect.bitwise actual(%rounding) expected(%rounding) : tensor<348xbf16>
      // The signed minimum BF16 subnormals are multiplied by 0.5 and a scale
      // no larger than three. The largest rounded result is 2^-132; flushing
      // either multiply can lose that value. Other rounding cases remain exact.
      check.expect.approximate actual(%subnormal) expected(%subnormal) atol(1.8367099231598242e-40) rtol(0.0) nan(different) : tensor<12xbf16>, tensor<12xbf16>
      // A minimum-normal input also underflows when multiplied by 0.5, before
      // scaling back as high as 1.5 * 2^-126. A result-only subnormal check would
      // miss this intermediate-underflow case.
      check.expect.approximate actual(%underflow) expected(%underflow) atol(1.7632415262334313e-38) rtol(0.0) nan(different) : tensor<6xbf16>, tensor<6xbf16>
      check.expect.bitwise actual(%large) expected(%large) : tensor<6xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<590xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@epilogue_rounding> @epilogue_rounding_benchmark
