// Native GPU sampling checks. Philox uses published integer known answers;
// normal pairs use an independent F64 Box-Muller reference in the VM
// after the public F32 uniform conversion. The 64 pairs cross radial endpoints,
// conversion rounding boundaries, and every angular octant.

amdgpu.target<gfx11-generic> @sampling {subgroup_size = 32}

template.decl @random.philox4x32(%counter0: i32, %counter1: i32, %counter2: i32, %counter3: i32, %seed0: i32, %seed1: i32) -> (i32, i32, i32, i32)

template.decl @random.normal_pair(%radius_word: i32, %angle_word: i32) -> (f32, f32)

kernel.def target(@sampling) @normal_pairs() {
  %unit = index.constant 1 : index
  %rows = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%rows, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer) {
  %origin = index.constant 0 : offset
  %input = buffer.view %input_storage[%origin] : buffer -> view<64x2xi32>
  %output = buffer.view %output_storage[%origin] : buffer -> view<64x2xf32>
  %row = kernel.workitem.id<x> : index
  %radial = view.load %input[%row, 0] : view<64x2xi32> -> i32
  %angular = view.load %input[%row, 1] : view<64x2xi32> -> i32
  %first, %second = template.apply<@random.normal_pair>(%radial, %angular) : (i32, i32) -> (f32, f32)
  view.store %first, %output[%row, 0] : f32, view<64x2xf32>
  view.store %second, %output[%row, 1] : f32, view<64x2xf32>
  kernel.return
}

// Cross unsigned-word conversion boundaries with the angular octants. The
// final radial inputs exercise clamping after F32 rounds the word to 2^32.
func.def @initialize_normal(%input: buffer) {
  %origin = index.constant 0 : offset
  %destination = buffer.view %input[%origin] : buffer -> view<64x2xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %octants = index.constant 8 : index
  %last_octant = index.constant 7 : index
  %count = index.constant 64 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %before_exact_limit = scalar.constant 16777215 : i32
  %exact_limit = scalar.constant 16777216 : i32
  %before_half = scalar.constant 2147483647 : i32
  %half = scalar.constant -2147483648 : i32
  %before_wrap = scalar.constant -129 : i32
  %last_word = scalar.constant -1 : i32
  %octant_shift = scalar.constant 29 : i32
  scf.for %row = [%c0 to %count step %c1] {
    %radial_index = index.div %row, %octants : index
    %radial = scf.lookup %radial_index {
      0 = (%c0_i32),
      1 = (%c1_i32),
      2 = (%before_exact_limit),
      3 = (%exact_limit),
      4 = (%before_half),
      5 = (%half),
      6 = (%before_wrap)
    } default(%last_word) : i32
    %octant = index.rem %row, %octants : index
    %octant_word = index.cast %octant : index to i32
    %boundary = scalar.shli %octant_word, %octant_shift : i32
    %last = index.cmp eq, %octant, %last_octant : index
    %angular = scf.select %last, %last_word, %boundary : i32
    view.store %radial, %destination[%row, 0] : i32, view<64x2xi32>
    view.store %angular, %destination[%row, 1] : i32, view<64x2xi32>
  }
  func.return
}

// The F32 word conversion and half-bin addition are the input contract.
// Everything afterward uses strict F64 math with angles in radians, independent
// of the native approximate log/turns operations, until final F32 publication.
func.def @expected_normal(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<64x2xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<64x2xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 64 : index
  %half = scalar.constant 0.5 : f32
  %scale = scalar.constant 2.3283064365386963e-10 : f64
  %upper = scalar.constant 0.99999994039535522 : f64
  %cneg2 = scalar.constant -2.0 : f64
  %tau = scalar.constant 6.2831853071795862 : f64
  scf.for %row = [%c0 to %count step %c1] {
    %radial_word = view.load %source[%row, 0] : view<64x2xi32> -> i32
    %angular_word = view.load %source[%row, 1] : view<64x2xi32> -> i32
    %radial = scalar.uitofp %radial_word : i32 to f32
    %angular = scalar.uitofp %angular_word : i32 to f32
    %radial_offset = scalar.addf %radial, %half : f32
    %angular_offset = scalar.addf %angular, %half : f32
    %wide_radial = scalar.extf %radial_offset : f32 to f64
    %wide_angular = scalar.extf %angular_offset : f32 to f64
    %radial_unit = scalar.mulf %wide_radial, %scale : f64
    %turns = scalar.mulf %wide_angular, %scale : f64
    %uniform = scalar.minnumf %radial_unit, %upper : f64
    %logarithm = scalar.logf %uniform : f64
    %squared = scalar.mulf %logarithm, %cneg2 : f64
    %radius = scalar.sqrtf %squared : f64
    %radians = scalar.mulf %tau, %turns : f64
    %cosine = scalar.cosf %radians : f64
    %sine = scalar.sinf %radians : f64
    %first = scalar.mulf %radius, %cosine : f64
    %second = scalar.mulf %radius, %sine : f64
    %first_f32 = scalar.fptrunc %first : f64 to f32
    %second_f32 = scalar.fptrunc %second : f64 to f32
    view.store %first_f32, %destination[%row, 0] : f32, view<64x2xf32>
    view.store %second_f32, %destination[%row, 1] : f32, view<64x2xf32>
  }
  func.return
}

check.scenario public @normal_conversion_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<64x2xi32>
    %output = check.generate.fill value(0.0) : tensor<64x2xf32>
    check.generate<@initialize_normal>(%input) : (tensor<64x2xi32>) -> ()
    check.compare<@normal_pairs, @expected_normal>(%input, %output) : (tensor<64x2xi32>, tensor<64x2xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64x2xi32>
      check.expect.approximate actual(%output) expected(%output) atol(2.0000000000000001e-09) rtol(4.9999999999999998e-07) nan(same) : tensor<64x2xf32>, tensor<64x2xf32>
    }
  }
  check.return
}

kernel.def target(@sampling) @philox_words() {
  %unit = index.constant 1 : index
  %rows = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%rows, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer) {
  %origin = index.constant 0 : offset
  %input = buffer.view %input_storage[%origin] : buffer -> view<3x6xi32>
  %output = buffer.view %output_storage[%origin] : buffer -> view<3x4xi32>
  %row = kernel.workitem.id<x> : index
  %counter0 = view.load %input[%row, 0] : view<3x6xi32> -> i32
  %counter1 = view.load %input[%row, 1] : view<3x6xi32> -> i32
  %counter2 = view.load %input[%row, 2] : view<3x6xi32> -> i32
  %counter3 = view.load %input[%row, 3] : view<3x6xi32> -> i32
  %seed0 = view.load %input[%row, 4] : view<3x6xi32> -> i32
  %seed1 = view.load %input[%row, 5] : view<3x6xi32> -> i32
  %a, %b, %c, %d = template.apply<@random.philox4x32>(%counter0, %counter1, %counter2, %counter3, %seed0, %seed1) : (i32, i32, i32, i32, i32, i32) -> (i32, i32, i32, i32)
  view.store %a, %output[%row, 0] : i32, view<3x4xi32>
  view.store %b, %output[%row, 1] : i32, view<3x4xi32>
  view.store %c, %output[%row, 2] : i32, view<3x4xi32>
  view.store %d, %output[%row, 3] : i32, view<3x4xi32>
  kernel.return
}

// Published Random123 words, stored little-endian for the native input ABI.
global.rodata.def @philox_input = align(4) bytes("000000000000000000000000000000000000000000000000ffffffffffffffffffffffffffffffffffffffffffffffff886a3f24d308a3852e8a191344737003223809a4d0319f29")

global.rodata.def @philox_output = align(4) bytes("d5e827668dc569e14cac57bcd8db009b6d278f400e3bc841c6c70ba2fd51546d09fe6cd1ebccfd9420e40150a16e1224")

func.def @initialize_philox(%input: buffer) {
  %origin = index.constant 0 : offset
  %input_length = index.constant 72 : offset
  %words = global.load @philox_input : buffer
  buffer.copy %words[%origin], %input[%origin], %input_length
  func.return
}

func.def @expected_philox(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 48 : offset
  %values = global.load @philox_output : buffer
  buffer.copy %values[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @philox_known_words {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<3x6xi32>
    %output = check.generate.fill value(0) : tensor<3x4xi32>
    check.generate<@initialize_philox>(%input) : (tensor<3x6xi32>) -> ()
    check.compare<@philox_words, @expected_philox>(%input, %output) : (tensor<3x6xi32>, tensor<3x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3x4xi32>
    }
  }
  check.return
}

check.benchmark<@normal_conversion_boundaries> @normal_pairs_64

check.benchmark<@philox_known_words> @philox_counter_blocks
