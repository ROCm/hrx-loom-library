// Independent F64 references cover dense attention and uniform-logit means.
// Directed cases distinguish Q/K/V and probability rounding, whole-row max
// removal, late maxima, and channel-first output. All immutable operands and
// allocation guards compare bitwise; native launches share one fixed ABI.

amdgpu.target<gfx11-generic> @tensor_image_attention_rdna3

amdgpu.target<gfx11-generic> @image_attention_wave32 {subgroup_size = 32}

template.decl @attention.single_head_384_matrix_nchw_f32(%tokens: index, %qkv: buffer, %output: buffer)

// Q/K occupy channel-first planes; V is token-first. Patterns replace random
// values only where the identity or a directed rounding boundary requires it.
func.def @initialize_uniform_attention(%tokens_value: index, %pattern: index, %storage: buffer) {
  %tokens = index.assume %tokens_value [ge(%tokens_value, 16), le(%tokens_value, 32)] : index
  %base = index.constant 0 : offset
  %origin = index.constant 64 : offset
  %plane_bytes = index.constant 1536 : offset
  %key_base = index.scale %tokens, %plane_bytes : index, offset -> offset
  %value_base = index.add %key_base, %key_base : offset
  %key_origin = index.add %origin, %key_base : offset
  %value_origin = index.add %origin, %value_base : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %channels = index.constant 384 : index
  %plane = index.mul %tokens, %channels : index
  %count = index.mul %plane, %c3 : index
  %suffix = index.add %count, %c16 : index
  %storage_count = index.add %count, %c32 : index
  %guard = scalar.constant 123.25 : f32
  %allocation = buffer.view %storage[%base] : buffer -> view<[%storage_count]xf32>
  scf.for %i = [%c0 to %c16 step %c1] {
    %end = index.add %suffix, %i : index
    view.store %guard, %allocation[%i] : f32, view<[%storage_count]xf32>
    view.store %guard, %allocation[%end] : f32, view<[%storage_count]xf32>
  }
  %queries = buffer.view %storage[%origin] : buffer -> view<384x[%tokens]xf32>
  %keys = buffer.view %storage[%key_origin] : buffer -> view<384x[%tokens]xf32>
  %values = buffer.view %storage[%value_origin] : buffer -> view<[%tokens]x384xf32>
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %cneg1_f32 = scalar.constant -1.0 : f32
  %quarter = scalar.constant 0.25 : f32
  %midpoint = scalar.constant 1.00390625 : f32
  %above = scalar.constant 1.0078125 : f32
  %huge = scalar.constant 72057594037927936.0 : f32
  %negative_huge = scalar.constant -72057594037927936.0 : f32
  %all_zero = index.cmp eq, %pattern, %c0 : index
  %rounding = index.cmp eq, %pattern, %c2 : index
  %negative = index.cmp eq, %pattern, %c3 : index
  scf.for %channel = [%c0 to %channels step %c1] {
    %first_channel = index.cmp eq, %channel, %c0 : index
    %large_query = scf.select %first_channel, %huge, %c0_f32 : f32
    %large_key = scf.select %first_channel, %negative_huge, %c0_f32 : f32
    %query = scf.select %negative, %large_query, %c0_f32 : f32
    %scale_index = index.rem %channel, %c4 : index
    %scale_value = index.add %scale_index, %c1 : index
    %scale_word = index.cast %scale_value : index to i32
    %scale_float = scalar.uitofp %scale_word : i32 to f32
    %magnitude = scalar.mulf %scale_float, %quarter : f32
    %parity = index.rem %channel, %c2 : index
    %even = index.cmp eq, %parity, %c0 : index
    %sign = scf.select %even, %c1_f32, %cneg1_f32 : f32
    %scale = scalar.mulf %magnitude, %sign : f32
    %first_value = scalar.mulf %midpoint, %scale : f32
    %second_value = scalar.mulf %above, %scale : f32
    scf.for %token = [%c0 to %tokens step %c1] {
      view.store %query, %queries[%channel, %token] : f32, view<384x[%tokens]xf32>
      scf.if %all_zero {
        view.store %c0_f32, %keys[%channel, %token] : f32, view<384x[%tokens]xf32>
        view.store %c0_f32, %values[%token, %channel] : f32, view<[%tokens]x384xf32>
      } else {
        scf.if %negative {
          view.store %large_key, %keys[%channel, %token] : f32, view<384x[%tokens]xf32>
          view.store %c1_f32, %values[%token, %channel] : f32, view<[%tokens]x384xf32>
        } else {
          scf.if %rounding {
            %first = index.cmp eq, %token, %c0 : index
            %second = index.cmp eq, %token, %c1 : index
            %after_first = scf.select %second, %second_value, %c0_f32 : f32
            %value = scf.select %first, %first_value, %after_first : f32
            view.store %value, %values[%token, %channel] : f32, view<[%tokens]x384xf32>
          }
        }
      }
    }
  }
  func.return
}

kernel.def target(@image_attention_wave32) @apply_image_attention(%tokens: index) {
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%tokens_value: index, %input: buffer, %output: buffer) {
  %tokens = index.assume %tokens_value [ge(%tokens_value, 16), le(%tokens_value, 144), multiple_of(%tokens_value, 16)] : index
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %group = kernel.workgroup.id<x> : index
  %live = index.cmp ult, %group, %groups : index
  scf.if %live {
    template.apply<@attention.single_head_384_matrix_nchw_f32>(%tokens, %input, %output) : (index, buffer, buffer)
  }
  kernel.return
}

command.def @image_attention_program(%tokens: index) launch(%input: buffer, %output: buffer) {
  kernel.launch @apply_image_attention[%tokens](%tokens, %input, %output) : [index](index, buffer, buffer)
  command.return
}

func.decl @reference_bf16_round(%value: f32) -> (f32)

func.decl @image_attention_reference(%input: buffer, %output: buffer)

func.decl @image_attention_rounded_reference(%input: buffer, %output: buffer)

// Q/K occupy channel-first planes; V is token-first. Ordinary Q/K samples
// are bounded by one half, keeping every seed within the fixed score-error
// budget. Directed cases preserve conversion midpoints and late tile maxima.
func.def @initialize_image_attention(%tokens_value: index, %pattern: index, %storage: buffer) {
  %tokens = index.assume %tokens_value [ge(%tokens_value, 16), le(%tokens_value, 144)] : index
  %base = index.constant 0 : offset
  %origin = index.constant 64 : offset
  %plane_bytes = index.constant 1536 : offset
  %key_base = index.scale %tokens, %plane_bytes : index, offset -> offset
  %value_base = index.add %key_base, %key_base : offset
  %key_origin = index.add %origin, %key_base : offset
  %value_origin = index.add %origin, %value_base : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %last_channel = index.constant 383 : index
  %channels = index.constant 384 : index
  %plane = index.mul %tokens, %channels : index
  %value_start = index.mul %plane, %c2 : index
  %count = index.mul %plane, %c3 : index
  %suffix = index.add %count, %c16 : index
  %storage_count = index.add %count, %c32 : index
  %guard = scalar.constant 123.25 : f32
  %allocation = buffer.view %storage[%base] : buffer -> view<[%storage_count]xf32>
  scf.for %i = [%c0 to %c16 step %c1] {
    %end = index.add %suffix, %i : index
    view.store %guard, %allocation[%i] : f32, view<[%storage_count]xf32>
    view.store %guard, %allocation[%end] : f32, view<[%storage_count]xf32>
  }
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %cneg1_f32 = scalar.constant -1.0 : f32
  %half = scalar.constant 0.5 : f32
  %varied = index.cmp eq, %pattern, %c0 : index
  scf.if %varied {
    %values = buffer.view %storage[%origin] : buffer -> view<[%count]xf32>
    scf.for %i = [%c0 to %count step %c1] {
      %raw = view.load %values[%i] : view<[%count]xf32> -> f32
      %score_operand = index.cmp ult, %i, %value_start : index
      %scale = scf.select %score_operand, %half, %c1_f32 : f32
      %scaled = scalar.mulf %raw, %scale : f32
      %rounded = func.call @reference_bf16_round(%scaled) : (f32) -> (f32)
      view.store %rounded, %values[%i] : f32, view<[%count]xf32>
    }
  } else {
    %queries = buffer.view %storage[%origin] : buffer -> view<384x[%tokens]xf32>
    %keys = buffer.view %storage[%key_origin] : buffer -> view<384x[%tokens]xf32>
    %values = buffer.view %storage[%value_origin] : buffer -> view<[%tokens]x384xf32>
    %query_boundary = index.cmp eq, %pattern, %c1 : index
    %key_boundary = index.cmp eq, %pattern, %c2 : index
    %probability_boundary = index.cmp eq, %pattern, %c3 : index
    %late = index.cmp eq, %pattern, %c4 : index
    %query_midpoint = scalar.constant 16.0625 : f32
    %query_unit = scalar.constant 16.0 : f32
    %query_value = scf.select %query_boundary, %query_midpoint, %query_unit : f32
    %quarter = scalar.constant 0.25 : f32
    %c8_f32h = scalar.constant 0.125 : f32
    %midpoint_spacing = scalar.constant 0.00390625 : f32
    %c8_f32 = scalar.constant 8.0 : f32
    %c8_i32 = scalar.constant 8 : i32
    %half_tokens = index.div %tokens, %c2 : index
    %c16_f64 = scalar.constant 16.0 : f64
    %width_f64 = scalar.constant 384.0 : f64
    %root = scalar.sqrtf %width_f64 : f64
    %last = index.sub %tokens, %c1 : index
    %last_word = index.cast %last : index to i32
    %last_centered = scalar.subi %last_word, %c8_i32 : i32
    %last_float = scalar.sitofp %last_centered : i32 to f32
    %last_key = scalar.mulf %last_float, %c8_f32h : f32
    %last_wide = scalar.extf %last_key : f32 to f64
    %last_dot = scalar.mulf %last_wide, %c16_f64 : f64
    %maximum = scalar.divf %last_dot, %root : f64
    scf.for %token = [%c0 to %tokens step %c1] {
      %key_value = scf.if %key_boundary -> (f32) {
        %choice = index.rem %token, %c8 : index
        %odd = index.madd %choice, %c2, %c1 : index
        %word = index.cast %odd : index to i32
        %number = scalar.uitofp %word : i32 to f32
        %fraction = scalar.mulf %number, %midpoint_spacing : f32
        %magnitude = scalar.addf %c1_f32, %fraction : f32
        %early = index.cmp ult, %token, %c8 : index
        %negative = scalar.negf %magnitude : f32
        %signed = scf.select %early, %negative, %magnitude : f32
        scf.yield %signed : f32
      } else {
        %key_value = scf.if %late -> (f32) {
          %tile = index.div %token, %c16 : index
          %within = index.rem %token, %c16 : index
          %tile_word = index.cast %tile : index to i32
          %within_word = index.cast %within : index to i32
          %tile_float = scalar.uitofp %tile_word : i32 to f32
          %within_float = scalar.uitofp %within_word : i32 to f32
          %tile_part = scalar.mulf %tile_float, %c8_f32 : f32
          %within_part = scalar.mulf %within_float, %c8_f32h : f32
          %value = scalar.addf %tile_part, %within_part : f32
          scf.yield %value : f32
        } else {
          %word = index.cast %token : index to i32
          %centered = scalar.subi %word, %c8_i32 : i32
          %number = scalar.sitofp %centered : i32 to f32
          %step = scf.select %query_boundary, %quarter, %c8_f32h : f32
          %value = scalar.mulf %number, %step : f32
          scf.yield %value : f32
        }
        scf.yield %key_value : f32
      }
      %value_sign = scf.if %probability_boundary -> (f32) {
        %key_wide = scalar.extf %key_value : f32 to f64
        %dot = scalar.mulf %key_wide, %c16_f64 : f64
        %score = scalar.divf %dot, %root : f64
        %shifted = scalar.subf %score, %maximum : f64
        %probability = scalar.expf %shifted : f64
        %rounded = scalar.fptrunc %probability : f64 to bf16
        %extended = scalar.extf %rounded : bf16 to f64
        %upward = scalar.cmpf ogt, %extended, %probability : f64
        %sign = scf.select %upward, %c1_f32, %cneg1_f32 : f32
        scf.yield %sign : f32
      } else {
        %early = index.cmp ult, %token, %half_tokens : index
        %sign = scf.select %early, %cneg1_f32, %c1_f32 : f32
        scf.yield %sign : f32
      }
      scf.for %channel = [%c0 to %channels step %c1] {
        %live = index.cmp eq, %channel, %last_channel : index
        %query = scf.select %live, %query_value, %c0_f32 : f32
        %key = scf.select %live, %key_value, %c0_f32 : f32
        %scale_index = index.rem %channel, %c4 : index
        %scale_value = index.add %scale_index, %c1 : index
        %scale_word = index.cast %scale_value : index to i32
        %scale_float = scalar.uitofp %scale_word : i32 to f32
        %magnitude = scalar.mulf %scale_float, %quarter : f32
        %parity = index.rem %channel, %c2 : index
        %even = index.cmp eq, %parity, %c0 : index
        %signed = scf.select %even, %c1_f32, %cneg1_f32 : f32
        %channel_sign = scf.select %probability_boundary, %c1_f32, %signed : f32
        %scale = scalar.mulf %magnitude, %channel_sign : f32
        %value = scalar.mulf %scale, %value_sign : f32
        view.store %query, %queries[%channel, %token] : f32, view<384x[%tokens]xf32>
        view.store %key, %keys[%channel, %token] : f32, view<384x[%tokens]xf32>
        view.store %value, %values[%token, %channel] : f32, view<[%tokens]x384xf32>
      }
    }
  }
  func.return
}

// Equal logits have equal unit softmax weights. Sum BF16-rounded values in
// F64, then publish their mean in the independent channel-first output layout.
func.def @uniform_attention_reference(%input: buffer, %output: buffer) {
  %length = buffer.length %output
  %bytes = index.cast %length : offset to index
  %row_bytes = index.constant 1536 : index
  %tokens_value = index.div %bytes, %row_bytes : index
  %tokens = index.assume %tokens_value [ge(%tokens_value, 16), le(%tokens_value, 32)] : index
  %token_word = index.cast %tokens : index to i32
  %divisor = scalar.uitofp %token_word : i32 to f64
  %plane_bytes = index.constant 3072 : offset
  %value_base = index.scale %tokens, %plane_bytes : index, offset -> offset
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %channels = index.constant 384 : index
  %c0_f64 = scalar.constant 0.0 : f64
  %values = buffer.view %input[%value_base] : buffer -> view<[%tokens]x384xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<384x[%tokens]xf32>
  scf.for %channel = [%c0 to %channels step %c1] {
    %sum = scf.for %token = [%c0 to %tokens step %c1](%accumulator = %c0_f64 : f64) -> (f64) {
      %stored = view.load %values[%token, %channel] : view<[%tokens]x384xf32> -> f32
      %rounded = func.call @reference_bf16_round(%stored) : (f32) -> (f32)
      %wide = scalar.extf %rounded : f32 to f64
      %next = scalar.addf %accumulator, %wide : f64
      scf.yield %next : f64
    }
    %mean = scalar.divf %sum, %divisor : f64
    %value = scalar.fptrunc %mean : f64 to f32
    scf.for %token = [%c0 to %tokens step %c1] {
      view.store %value, %outputs[%channel, %token] : f32, view<384x[%tokens]xf32>
    }
  }
  func.return
}

check.scenario public @zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(16) : index
  %pattern = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-0.9921875 to 0.9921875) : tensor<18464xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<18464xf32> -> tensor<18432xf32>
    %output_storage = check.generate.fill value(123.25) : tensor<6176xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<6176xf32> -> tensor<6144xf32>
    %output_bits = check.tensor.view %output offset(0) : tensor<6144xf32> -> tensor<6144xi32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<6176xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(24640) : tensor<6176xf32> -> tensor<16xf32>
    check.generate<@initialize_uniform_attention>(%tokens, %pattern, %input_storage) : (index, index, tensor<18464xf32>) -> ()
    check.compare<@image_attention_program, @uniform_attention_reference>[%tokens](%input, %output) : [index](tensor<18432xf32>, tensor<6144xf32>) -> () {
      check.expect.bitwise actual(%output_bits) expected(%output_bits) : tensor<6144xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<18464xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@zero> @zero_benchmark

check.scenario public @uniform {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(32) : index
  %pattern = check.literal value(1) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-0.9921875 to 0.9921875) : tensor<36896xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<36896xf32> -> tensor<36864xf32>
    %output_storage = check.generate.fill value(123.25) : tensor<12320xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<12320xf32> -> tensor<12288xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<12320xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(49216) : tensor<12320xf32> -> tensor<16xf32>
    check.generate<@initialize_uniform_attention>(%tokens, %pattern, %input_storage) : (index, index, tensor<36896xf32>) -> ()
    check.compare<@image_attention_program, @uniform_attention_reference>[%tokens](%input, %output) : [index](tensor<36864xf32>, tensor<12288xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(9.4622373580932617e-07) rtol(0.0) nan(different) : tensor<12288xf32>, tensor<12288xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<36896xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@uniform> @uniform_benchmark

