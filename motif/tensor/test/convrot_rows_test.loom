// Exact ConvRot-256 quantization covers the complete basis, uneven block
// distribution across subgroups, multiple rows, and full hidden/FFN widths.
// Dyadic inputs keep the transform exact before its BF16 publication. Directed
// zero/tiny/large/saturating rows distinguish the scale floor, all three BF16
// boundaries, nearest-even ties of both signs/parities, and I8 saturation.
// Scenarios generate BF16 storage directly; the scalar matrix oracle observes
// the same payload through integer bits. All buffers, guards, and scales compare
// bitwise. Geometry occupies the otherwise immutable input prefix.

amdgpu.target<gfx11-generic> @convrot_wave32 {subgroup_size = 32}

template.decl @quantization.convrot256_i8(%rows: index, %columns: index, %input: buffer, %output: buffer, %scales: buffer)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @convrot_row_reference(%input: buffer, %output: buffer, %scales: buffer)

template.decl @convrot_shape(%configuration: index) -> (index, index, index)

template.def<@convrot_shape> @convrot_shape_values(%configuration: index) -> (index, index, index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c768 = index.constant 768 : index
  %c1280 = index.constant 1280 : index
  %c6144 = index.constant 6144 : index
  %c16384 = index.constant 16384 : index
  %rows, %columns, %pattern = scf.lookup %configuration {
    0 = (%c256, %c256, %c1),
    1 = (%c4, %c256, %c0),
    2 = (%c3, %c512, %c0),
    3 = (%c2, %c768, %c0),
    4 = (%c3, %c1280, %c0),
    5 = (%c2, %c6144, %c0),
    6 = (%c1, %c16384, %c0),
    7 = (%c2, %c256, %c2),
    8 = (%c2, %c256, %c3),
    9 = (%c2, %c256, %c4)
  } default(%c2, %c256, %c5) : index, index, index
  template.return %rows, %columns, %pattern : index, index, index
}

func.def @convrot_storage(%configuration: index) -> (index, index) {
  %rows, %columns, %pattern = template.apply<@convrot_shape>(%configuration) : (index) -> (index, index, index)
  %guards = index.constant 32 : index
  %count = index.madd %rows, %columns, %guards : index
  %scales = index.add %rows, %guards : index
  func.return %count, %scales : index, index
}

func.def @initialize_convrot_rows(%configuration: index, %input: buffer) {
  %rows, %columns, %pattern = template.apply<@convrot_shape>(%configuration) : (index) -> (index, index, index)
  %base = index.constant 0 : offset
  %origin = index.constant 32 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c17 = index.constant 17 : index
  %c31 = index.constant 31 : index
  %c43 = index.constant 43 : index
  %c256 = index.constant 256 : index
  %period = index.constant 255 : index
  %center = scalar.constant 127 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %cneg0_f32 = scalar.constant -0.0 : f32
  %basis_value = scalar.constant 16.0 : f32
  %step = scalar.constant 0.0625 : f32
  %tiny = scalar.constant 7.7037197775489434e-34 : f32
  %large_factor = scalar.constant 7.9228162514264338e+28 : f32
  %saturation = scalar.constant 1.328125 : f32
  %header = buffer.view %input[%base] : buffer -> view<2xi32>
  %rows_word = index.cast %rows : index to i32
  %columns_word = index.cast %columns : index to i32
  view.store %rows_word, %header[0] : i32, view<2xi32>
  view.store %columns_word, %header[1] : i32, view<2xi32>
  %values = buffer.view %input[%origin] : buffer -> view<[%rows]x[%columns]xi16>
  scf.for %row = [%c0 to %rows step %c1] {
    %positive = index.cmp eq, %row, %c0 : index
    %negative_tiny = scalar.negf %tiny : f32
    %negative_saturation = scalar.negf %saturation : f32
    %tiny_value = scf.select %positive, %tiny, %negative_tiny : f32
    %saturating_value = scf.select %positive, %saturation, %negative_saturation : f32
    scf.for %column = [%c0 to %columns step %c1] {
      %block = index.div %column, %c256 : index
      %block_part = index.mul %block, %c17 : index
      %row_part = index.madd %row, %c43, %block_part : index
      %affine = index.madd %column, %c31, %row_part : index
      %reduced = index.rem %affine, %period : index
      %word = index.cast %reduced : index to i32
      %signed = scalar.subi %word, %center : i32
      %integer = scalar.sitofp %signed : i32 to f32
      %ordinary = scalar.mulf %integer, %step : f32
      %basis_column = index.cmp eq, %row, %column : index
      %basis = scf.select %basis_column, %basis_value, %c0_f32 : f32
      %parity = index.rem %column, %c2 : index
      %even = index.cmp eq, %parity, %c0 : index
      %zero = scf.select %even, %c0_f32, %cneg0_f32 : f32
      %large = scalar.mulf %ordinary, %large_factor : f32
      %value = scf.lookup %pattern {
        0 = (%ordinary),
        1 = (%basis),
        2 = (%zero),
        3 = (%tiny_value),
        4 = (%large)
      } default(%saturating_value) : f32
      %bits = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
      view.store %bits, %values[%row, %column] : i16, view<[%rows]x[%columns]xi16>
    }
  }
  func.return
}

kernel.def target(@convrot_wave32) @apply_convrot_rows(%rows: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%rows: index, %columns: index, %input: buffer, %output: buffer, %scales: buffer) {
  template.apply<@quantization.convrot256_i8>(%rows, %columns, %input, %output, %scales) : (index, index, buffer, buffer, buffer)
  kernel.return
}

command.program.def @convrot_rows_program(%configuration: index) launch(%input: buffer, %output: buffer, %scales: buffer) {
  %rows, %columns, %pattern = template.apply<@convrot_shape>(%configuration) : (index) -> (index, index, index)
  %input_origin = index.constant 32 : offset
  %output_origin = index.constant 16 : offset
  %scale_origin = index.constant 64 : offset
  %values = buffer.view %input[%input_origin] : buffer -> view<[%rows]x[%columns]xbf16>
  %results = buffer.view %output[%output_origin] : buffer -> view<[%rows]x[%columns]xi8>
  %row_scales = buffer.view %scales[%scale_origin] : buffer -> view<[%rows]xf32>
  kernel.launch @apply_convrot_rows[%rows](%rows, %columns, %values, %results, %row_scales) : [index](index, index, view<[%rows]x[%columns]xbf16>, view<[%rows]x[%columns]xi8>, view<[%rows]xf32>)
  command.return
}

check.scenario public @convrot_rows configure[11](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count, %scale_count = check.generate<@convrot_storage>(%configuration) : (index) -> (index, index)
    %input = check.generate.fill value(-12345) : tensor<[%count]xi16>
    %output = check.generate.fill value(99) : tensor<[%count]xi8>
    %scales = check.generate.fill value(123.25) : tensor<[%scale_count]xf32>
    check.generate<@initialize_convrot_rows>(%configuration, %input) : (index, tensor<[%count]xi16>) -> ()
    check.compare<@convrot_rows_program, @convrot_row_reference>[%configuration](%input, %output, %scales) : [index](tensor<[%count]xi16>, tensor<[%count]xi8>, tensor<[%scale_count]xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%count]xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<[%count]xi8>
      check.expect.bitwise actual(%scales) expected(%scales) : tensor<[%scale_count]xf32>
    }
  }
  check.return
}

check.benchmark<@convrot_rows> @convrot_rows_benchmark
