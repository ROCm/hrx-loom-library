// Cooperative convolution exercises spatial/channel tiles, nearest expansion,
// temporal-plane storage, BF16 midpoint rounding, and in-place residual output.
// The reference expands/pads the image, rounds operands through integer bits,
// and contracts in F64 before separate F32 bias/residual additions. Ordinary
// operands lie on a 1/16 lattice, so the exact sum is representable in F32.
// The absolute budgets are below half the smallest nonzero ordinary product;
// F32 accumulation and bias/residual order have directed bitwise witnesses.
// Guards, geometry, and all immutable input allocations always compare exactly.

amdgpu.target<gfx11-generic> @tensor_convolution_rdna3

amdgpu.target<gfx11-generic> @convolution_matrix_wave32 {subgroup_size = 32}

template.decl @image.convolution_3x3_matrix_f32(%height: index, %width: index, %inputs: index, %outputs: index, %planes: index, %upsample: index, %add_residual: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)

func.decl @convolution_guard(%length: index, %storage: buffer)

func.decl @convolution_header(%height: index, %width: index, %inputs: index, %outputs: index, %extent: index, %planes: index, %upsample: index, %residual: i1, %alias: i1, %input: buffer)

func.decl @convolution_geometry(%input: buffer) -> (index, index, index, index, index, index, index, i1, i1)

func.decl @convolution_pad(%height: index, %width: index, %inputs: index, %extent: index, %upsample: index, %input: buffer, %padded: buffer)

func.decl @reference_bf16_round(%value: f32) -> (f32)

template.decl @matrix_convolution_shape(%configuration: index) -> (index, index, index, index, index, index, i1, i1)

template.def<@matrix_convolution_shape> @matrix_convolution_shape_values(%configuration: index) -> (index, index, index, index, index, index, i1, i1) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c384 = index.constant 384 : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %height, %width, %inputs, %outputs, %planes, %upsample, %residual, %alias = scf.lookup %configuration {
    0 = (%c1, %c1, %c32, %c32, %c1, %c1, %false, %false),
    1 = (%c3, %c5, %c32, %c64, %c3, %c1, %true, %false),
    2 = (%c4, %c8, %c64, %c32, %c1, %c1, %true, %true),
    3 = (%c3, %c5, %c32, %c32, %c1, %c2, %false, %false),
    4 = (%c1, %c2, %c64, %c64, %c2, %c3, %true, %true),
    5 = (%c1, %c1, %c384, %c32, %c1, %c1, %false, %false),
    6 = (%c1, %c5, %c32, %c32, %c1, %c1, %false, %false),
    7 = (%c1, %c1, %c32, %c32, %c1, %c1, %false, %false)
  } default(%c1, %c1, %c32, %c32, %c1, %c1, %true, %true) : index, index, index, index, index, index, i1, i1
  template.return %height, %width, %inputs, %outputs, %planes, %upsample, %residual, %alias : index, index, index, index, index, index, i1, i1
}

// Floor the runner's uniform samples before scaling to exact dyadic operands.
func.def @convolution_lattice(%length_value: index, %scale: f32, %storage: buffer) {
  %length = index.assume %length_value [ge(%length_value, 0)] : index
  %origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %values = buffer.view %storage[%origin] : buffer -> view<[%length]xf32>
  scf.for %i = [%c0 to %length step %c1] {
    %random = view.load %values[%i] : view<[%length]xf32> -> f32
    %integer = scalar.floorf %random : f32
    %value = scalar.mulf %integer, %scale : f32
    view.store %value, %values[%i] : f32, view<[%length]xf32>
  }
  func.call @convolution_guard(%length, %storage) : (index, buffer)
  func.return
}

func.def @convolution_midpoint(%position: index) -> (f32) {
  %c4 = index.constant 4 : index
  %parity = index.rem %position, %c4 : index
  %even = scalar.constant 1.00390625 : f32
  %odd = scalar.constant 1.01171875 : f32
  %negative_even = scalar.constant -1.00390625 : f32
  %negative_odd = scalar.constant -1.01171875 : f32
  %value = scf.lookup %parity {
    0 = (%even),
    1 = (%odd),
    2 = (%negative_even)
  } default(%negative_odd) : f32
  func.return %value : f32
}

func.def @initialize_matrix_convolution(%configuration: index, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer) {
  %height, %width, %inputs, %outputs, %planes, %upsample, %add_residual, %alias = template.apply<@matrix_convolution_shape>(%configuration) : (index) -> (index, index, index, index, index, index, i1, i1)
  %origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c9 = index.constant 9 : index
  %c1000 = index.constant 1000 : index
  %operand_scale = scalar.constant 0.0625 : f32
  %epilogue_scale = scalar.constant 0.125 : f32
  %pixels = index.mul %height, %width : index
  %input_length = index.mul %inputs, %pixels : index
  %stored_taps = index.mul %planes, %c9 : index
  %coefficients = index.mul %inputs, %stored_taps : index
  %weight_length = index.mul %outputs, %coefficients : index
  %expansion = index.mul %upsample, %upsample : index
  %expanded_pixels = index.mul %pixels, %expansion : index
  %output_length = index.mul %outputs, %expanded_pixels : index
  func.call @convolution_lattice(%input_length, %operand_scale, %input) : (index, f32, buffer)
  func.call @convolution_lattice(%weight_length, %operand_scale, %weight) : (index, f32, buffer)
  func.call @convolution_lattice(%outputs, %epilogue_scale, %bias) : (index, f32, buffer)
  func.call @convolution_lattice(%output_length, %epilogue_scale, %residual) : (index, f32, buffer)
  func.call @convolution_header(%height, %width, %inputs, %outputs, %c3, %planes, %upsample, %add_residual, %alias, %input) : (index, index, index, index, index, index, index, i1, i1, buffer)
  %last_plane = index.sub %planes, %c1 : index
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]x[%planes]x3x3xf32>
  scf.for %output_channel = [%c0 to %outputs step %c1] {
    scf.for %channel = [%c0 to %inputs step %c1] {
      scf.for %plane = [%c0 to %last_plane step %c1] {
        %base = index.add %c1000, %plane : index
        %poison_index = index.add %base, %channel : index
        %poison_word = index.cast %poison_index : index to i32
        %poison = scalar.sitofp %poison_word : i32 to f32
        scf.for %ky = [%c0 to %c3 step %c1] {
          scf.for %kx = [%c0 to %c3 step %c1] {
            view.store %poison, %weights[%output_channel, %channel, %plane, %ky, %kx] : f32, view<[%outputs]x[%inputs]x[%planes]x3x3xf32>
          }
        }
      }
    }
  }
  %directed = index.cmp uge, %configuration, %c6 : index
  scf.if %directed {
    %midpoint = index.cmp eq, %configuration, %c6 : index
    %accumulation = index.cmp eq, %configuration, %c7 : index
    %c0_f32 = scalar.constant 0.0 : f32
    %c1_f32 = scalar.constant 1.0 : f32
    %small = scalar.constant 0.000244140625 : f32
    %large = scalar.constant 16777216.0 : f32
    %negative_large = scalar.constant -16777216.0 : f32
    %values = buffer.view %input[%origin] : buffer -> view<[%input_length]xf32>
    scf.for %i = [%c0 to %input_length step %c1] {
      %value = scf.if %midpoint -> (f32) {
        %sample = func.call @convolution_midpoint(%i) : (index) -> (f32)
        scf.yield %sample : f32
      } else {
        %first = index.cmp eq, %i, %c0 : index
        %tail = scf.select %accumulation, %small, %c0_f32 : f32
        %selected = scf.select %first, %c1_f32, %tail : f32
        scf.yield %selected : f32
      }
      view.store %value, %values[%i] : f32, view<[%input_length]xf32>
    }
    %biases = buffer.view %bias[%origin] : buffer -> view<[%outputs]xf32>
    %skips = buffer.view %residual[%origin] : buffer -> view<[%output_length]xf32>
    %precision = scalar.ori %midpoint, %accumulation : i1
    %bias_value = scf.select %precision, %c0_f32, %c1_f32 : f32
    scf.for %output_channel = [%c0 to %outputs step %c1] {
      view.store %bias_value, %biases[%output_channel] : f32, view<[%outputs]xf32>
      %selected_channel = index.rem %output_channel, %inputs : index
      %midpoint_index = index.add %output_channel, %c1 : index
      %midpoint_value = func.call @convolution_midpoint(%midpoint_index) : (index) -> (f32)
      scf.for %channel = [%c0 to %inputs step %c1] {
        %selected = index.cmp eq, %channel, %selected_channel : index
        %first = index.cmp eq, %channel, %c0 : index
        %midpoint_coefficient = scf.select %selected, %midpoint_value, %c0_f32 : f32
        %first_coefficient = scf.select %first, %large, %c0_f32 : f32
        %precision_coefficient = scf.select %accumulation, %c1_f32, %first_coefficient : f32
        %coefficient = scf.select %midpoint, %midpoint_coefficient, %precision_coefficient : f32
        scf.for %ky = [%c0 to %c3 step %c1] {
          scf.for %kx = [%c0 to %c3 step %c1] {
            %center_y = index.cmp eq, %ky, %c1 : index
            %center_x = index.cmp eq, %kx, %c1 : index
            %center = scalar.andi %center_y, %center_x : i1
            %value = scf.select %center, %coefficient, %c0_f32 : f32
            view.store %value, %weights[%output_channel, %channel, 0, %ky, %kx] : f32, view<[%outputs]x[%inputs]x[%planes]x3x3xf32>
          }
        }
      }
    }
    scf.for %i = [%c0 to %output_length step %c1] {
      view.store %negative_large, %skips[%i] : f32, view<[%output_length]xf32>
    }
  }
  func.return
}

// Dyadic input products and sums are exact in F64, independent of the native
// matrix accumulation order. Bias and residual retain their F32 boundaries.
func.def @convolution_matrix_reference(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %height, %width, %inputs, %outputs, %extent, %planes, %upsample, %add_residual, %alias = func.call @convolution_geometry(%input) : (buffer) -> (index, index, index, index, index, index, index, i1, i1)
  %base = index.constant 0 : offset
  %origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %element_bytes = index.constant 4 : offset
  %c0_f64 = scalar.constant 0.0 : f64
  %output_height = index.mul %height, %upsample : index
  %output_width = index.mul %width, %upsample : index
  %padded_height = index.add %output_height, %c2 : index
  %padded_width = index.add %output_width, %c2 : index
  %padded_pixels = index.mul %padded_height, %padded_width : index
  %padded_count = index.mul %inputs, %padded_pixels : index
  %padded_bytes = index.scale %padded_count, %element_bytes : index, offset -> offset
  %padded = buffer.alloca<private> align(4) %padded_bytes : buffer
  func.call @convolution_pad(%height, %width, %inputs, %c3, %upsample, %input, %padded) : (index, index, index, index, index, buffer, buffer)
  %image = buffer.view %padded[%base] : buffer -> view<[%inputs]x[%padded_height]x[%padded_width]xf32>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]x[%planes]x3x3xf32>
  %biases = buffer.view %bias[%origin] : buffer -> view<[%outputs]xf32>
  %skips = buffer.view %residual[%origin] : buffer -> view<[%outputs]x[%output_height]x[%output_width]xf32>
  %destination = scf.select %alias, %residual, %output : buffer
  %results = buffer.view %destination[%origin] : buffer -> view<[%outputs]x[%output_height]x[%output_width]xf32>
  %plane_value = index.sub %planes, %c1 : index
  %plane = index.assume %plane_value [ge(%plane_value, 0), lt(%plane_value, %planes)] : index
  scf.for %output_channel = [%c0 to %outputs step %c1] {
    scf.for %y = [%c0 to %output_height step %c1] {
      scf.for %x = [%c0 to %output_width step %c1] {
        %sum = scf.for %channel = [%c0 to %inputs step %c1](%accumulator = %c0_f64 : f64) -> (f64) {
          %rows = scf.for %ky = [%c0 to %c3 step %c1](%row_sum = %accumulator : f64) -> (f64) {
            %columns = scf.for %kx = [%c0 to %c3 step %c1](%column_sum = %row_sum : f64) -> (f64) {
              %image_y_value = index.add %y, %ky : index
              %image_x_value = index.add %x, %kx : index
              %image_y = index.assume %image_y_value [ge(%image_y_value, 0), lt(%image_y_value, %padded_height)] : index
              %image_x = index.assume %image_x_value [ge(%image_x_value, 0), lt(%image_x_value, %padded_width)] : index
              %value = view.load %image[%channel, %image_y, %image_x] : view<[%inputs]x[%padded_height]x[%padded_width]xf32> -> f32
              %coefficient = view.load %weights[%output_channel, %channel, %plane, %ky, %kx] : view<[%outputs]x[%inputs]x[%planes]x3x3xf32> -> f32
              %operand = func.call @reference_bf16_round(%value) : (f32) -> (f32)
              %factor = func.call @reference_bf16_round(%coefficient) : (f32) -> (f32)
              %wide_value = scalar.extf %operand : f32 to f64
              %wide_coefficient = scalar.extf %factor : f32 to f64
              %product = scalar.mulf %wide_value, %wide_coefficient : f64
              %next = scalar.addf %column_sum, %product : f64
              scf.yield %next : f64
            }
            scf.yield %columns : f64
          }
          scf.yield %rows : f64
        }
        %contracted = scalar.fptrunc %sum : f64 to f32
        %bias_value = view.load %biases[%output_channel] : view<[%outputs]xf32> -> f32
        %biased = scalar.addf %contracted, %bias_value : f32
        %result = scf.if %add_residual -> (f32) {
          %skip = view.load %skips[%output_channel, %y, %x] : view<[%outputs]x[%output_height]x[%output_width]xf32> -> f32
          %combined = scalar.addf %biased, %skip : f32
          scf.yield %combined : f32
        } else {
          scf.yield %biased : f32
        }
        view.store %result, %results[%output_channel, %y, %x] : f32, view<[%outputs]x[%output_height]x[%output_width]xf32>
      }
    }
  }
  func.return
}

kernel.def target(@convolution_matrix_wave32) @convolve_matrix(%pixels: index, %outputs: index) {
  %tile = index.constant 32 : index
  %last = index.constant 31 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  %numerator = index.add %pixels, %last : index
  %groups = index.div %numerator, %tile : index
  %channels = index.div %outputs, %tile : index
  kernel.launch.config workgroups(%groups, %channels, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%height: index, %width: index, %inputs: index, %outputs: index, %planes: index, %upsample: index, %add_residual: i1, %alias: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %destination = scf.select %alias, %residual, %output : buffer
  template.apply<@image.convolution_3x3_matrix_f32>(%height, %width, %inputs, %outputs, %planes, %upsample, %add_residual, %input, %weight, %bias, %residual, %destination) : (index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

command.program.def @matrix_convolution_program(%configuration: index) launch(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %height, %width, %inputs, %outputs, %planes, %upsample, %add_residual, %alias = template.apply<@matrix_convolution_shape>(%configuration) : (index) -> (index, index, index, index, index, index, i1, i1)
  %origin = index.constant 64 : offset
  %output_height = index.mul %height, %upsample : index
  %output_width = index.mul %width, %upsample : index
  %pixels = index.mul %output_height, %output_width : index
  %activation = buffer.view %input[%origin] : buffer -> view<[%inputs]x[%height]x[%width]xf32>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]x[%planes]x3x3xf32>
  %biases = buffer.view %bias[%origin] : buffer -> view<[%outputs]xf32>
  %skips = buffer.view %residual[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
  %results = buffer.view %output[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
  kernel.launch @convolve_matrix[%pixels, %outputs](%height, %width, %inputs, %outputs, %planes, %upsample, %add_residual, %alias, %activation, %weights, %biases, %skips, %results) : [index, index](index, index, index, index, index, index, i1, i1, view<[%inputs]x[%height]x[%width]xf32>, view<[%outputs]x[%inputs]x[%planes]x3x3xf32>, view<[%outputs]xf32>, view<[%outputs]x[%pixels]xf32>, view<[%outputs]x[%pixels]xf32>)
  command.return
}

check.scenario public @minimum {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %configuration = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-7.0 to 8.0) : tensor<64xf32>
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %weight = check.generate.random.uniform seed(%weight_seed) range(-7.0 to 8.0) : tensor<9248xf32>
    %bias_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %bias = check.generate.random.uniform seed(%bias_seed) range(-7.0 to 8.0) : tensor<64xf32>
    %residual_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %residual = check.generate.random.uniform seed(%residual_seed) range(-7.0 to 8.0) : tensor<64xf32>
    %output = check.generate.fill value(123.25) : tensor<64xf32>
    check.generate<@initialize_matrix_convolution>(%configuration, %input, %weight, %bias, %residual) : (index, tensor<64xf32>, tensor<9248xf32>, tensor<64xf32>, tensor<64xf32>) -> ()
    %result = check.tensor.view %output offset(64) : tensor<64xf32> -> tensor<32xf32>
    %prefix = check.tensor.view %output offset(0) : tensor<64xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output offset(192) : tensor<64xf32> -> tensor<16xf32>
    check.compare<@matrix_convolution_program, @convolution_matrix_reference>[%configuration](%input, %weight, %bias, %residual, %output) : [index](tensor<64xf32>, tensor<9248xf32>, tensor<64xf32>, tensor<64xf32>, tensor<64xf32>) -> () {
      check.expect.approximate actual(%result) expected(%result) atol(2.5220215320587158e-06) rtol(0.0) nan(different) : tensor<32xf32>, tensor<32xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<9248xf32>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<64xf32>
      check.expect.bitwise actual(%residual) expected(%residual) : tensor<64xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@minimum> @minimum_convolution

check.scenario public @spatial_tail {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %configuration = check.literal value(1) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-7.0 to 8.0) : tensor<512xf32>
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %weight = check.generate.random.uniform seed(%weight_seed) range(-7.0 to 8.0) : tensor<55328xf32>
    %bias_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %bias = check.generate.random.uniform seed(%bias_seed) range(-7.0 to 8.0) : tensor<96xf32>
    %residual_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %residual = check.generate.random.uniform seed(%residual_seed) range(-7.0 to 8.0) : tensor<992xf32>
    %output = check.generate.fill value(123.25) : tensor<992xf32>
    check.generate<@initialize_matrix_convolution>(%configuration, %input, %weight, %bias, %residual) : (index, tensor<512xf32>, tensor<55328xf32>, tensor<96xf32>, tensor<992xf32>) -> ()
    %result = check.tensor.view %output offset(64) : tensor<992xf32> -> tensor<960xf32>
    %prefix = check.tensor.view %output offset(0) : tensor<992xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output offset(3904) : tensor<992xf32> -> tensor<16xf32>
    check.compare<@matrix_convolution_program, @convolution_matrix_reference>[%configuration](%input, %weight, %bias, %residual, %output) : [index](tensor<512xf32>, tensor<55328xf32>, tensor<96xf32>, tensor<992xf32>, tensor<992xf32>) -> () {
      check.expect.approximate actual(%result) expected(%result) atol(1.8157064914703369e-05) rtol(0.0) nan(different) : tensor<960xf32>, tensor<960xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<512xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<55328xf32>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<96xf32>
      check.expect.bitwise actual(%residual) expected(%residual) : tensor<992xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@spatial_tail> @spatial_tail_convolution

check.scenario public @complete_tile {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %configuration = check.literal value(2) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-7.0 to 8.0) : tensor<2080xf32>
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %weight = check.generate.random.uniform seed(%weight_seed) range(-7.0 to 8.0) : tensor<18464xf32>
