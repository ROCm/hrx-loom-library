// Dense F64 attention keeps mask, head mapping, causal visibility, value
// layout, and each BF16 boundary explicit. It shares no native matrix,
// centering, online-softmax, or fragment-store implementation.

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.def @initialize_attention_options(%row_stride: index, %column_stride: index, %causal: i1, %gated: i1, %round_probability: i1, %parameters: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %parameters[%origin] : buffer -> view<5xi32>
  %row_word = index.cast %row_stride : index to i32
  %column_word = index.cast %column_stride : index to i32
  %causal_word = scalar.extui %causal : i1 to i32
  %gated_word = scalar.extui %gated : i1 to i32
  %round_word = scalar.extui %round_probability : i1 to i32
  view.store %row_word, %metadata[0] : i32, view<5xi32>
  view.store %column_word, %metadata[1] : i32, view<5xi32>
  view.store %causal_word, %metadata[2] : i32, view<5xi32>
  view.store %gated_word, %metadata[3] : i32, view<5xi32>
  view.store %round_word, %metadata[4] : i32, view<5xi32>
  func.return
}

// Context and sigmoid round separately before their product is published.
func.def @reference_attention_gate(%context: f64, %gate: f64) -> (bf16) {
  %c1 = scalar.constant 1.0 : f64
  %negative = scalar.negf %gate : f64
  %exponential = scalar.expf %negative : f64
  %denominator = scalar.addf %c1, %exponential : f64
  %sigmoid = scalar.divf %c1, %denominator : f64
  %context_bf16 = scalar.fptrunc %context : f64 to bf16
  %sigmoid_bf16 = scalar.fptrunc %sigmoid : f64 to bf16
  %context_wide = scalar.extf %context_bf16 : bf16 to f64
  %sigmoid_wide = scalar.extf %sigmoid_bf16 : bf16 to f64
  %product = scalar.mulf %context_wide, %sigmoid_wide : f64
  %result = scalar.fptrunc %product : f64 to bf16
  func.return %result : bf16
}

func.def @attention_reference(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %parameters[%origin] : buffer -> view<5xi32>
  %row_word = view.load %metadata[0] : view<5xi32> -> i32
  %column_word = view.load %metadata[1] : view<5xi32> -> i32
  %causal_word = view.load %metadata[2] : view<5xi32> -> i32
  %gated_word = view.load %metadata[3] : view<5xi32> -> i32
  %round_word = view.load %metadata[4] : view<5xi32> -> i32
  %row_value = index.cast %row_word : i32 to index
  %column_value = index.cast %column_word : i32 to index
  %row_stride = index.assume %row_value [ge(%row_value, 1), le(%row_value, 2576)] : index
  %column_stride = index.assume %column_value [ge(%column_value, 1), le(%column_value, 208)] : index
  %causal = scalar.trunci %causal_word : i32 to i1
  %gated = scalar.trunci %gated_word : i32 to i1
  %round_probability = scalar.trunci %round_word : i32 to i1
  %mask_length = buffer.length %mask
  %token_value = index.cast %mask_length : offset to index
  %tokens = index.assume %token_value [ge(%token_value, 16), le(%token_value, 192)] : index
  %query_length = buffer.length %query
  %key_length = buffer.length %key
  %query_bytes = index.cast %query_length : offset to index
  %key_bytes = index.cast %key_length : offset to index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %channels = index.constant 128 : index
  %head_bytes = index.constant 256 : index
  %sequence_bytes = index.mul %tokens, %head_bytes : index
  %query_heads_value = index.div %query_bytes, %sequence_bytes : index
  %key_heads_value = index.div %key_bytes, %sequence_bytes : index
  %query_heads = index.assume %query_heads_value [ge(%query_heads_value, 1), le(%query_heads_value, 48)] : index
  %key_heads = index.assume %key_heads_value [ge(%key_heads_value, 1), le(%key_heads_value, 20)] : index
  %sharing_value = index.div %query_heads, %key_heads : index
  %sharing = index.assume %sharing_value [ge(%sharing_value, 1), le(%sharing_value, 48)] : index
  %query_width = index.mul %query_heads, %channels : index
  %key_width = index.mul %key_heads, %channels : index
  %query_count = index.mul %tokens, %query_width : index
  %key_count = index.mul %tokens, %key_width : index
  %key_value_count = index.mul %key_count, %c2 : index
  %input_count = index.add %query_count, %key_value_count : index
  %element_bytes = index.constant 8 : offset
  %input_bytes = index.scale %input_count, %element_bytes : index, offset -> offset
  %key_origin = index.scale %query_count, %element_bytes : index, offset -> offset
  %key_plane_bytes = index.scale %key_count, %element_bytes : index, offset -> offset
  %value_origin = index.add %key_origin, %key_plane_bytes : offset
  %converted = buffer.alloca<private> align(8) %input_bytes : buffer
  %queries = buffer.view %converted[%origin] : buffer -> view<[%tokens]x[%query_width]xf64>
  %keys = buffer.view %converted[%key_origin] : buffer -> view<[%tokens]x[%key_width]xf64>
  %values = buffer.view %converted[%value_origin] : buffer -> view<[%tokens]x[%key_width]xf64>
  %stored_queries = buffer.view %query[%origin] : buffer -> view<[%tokens]x[%query_width]xi16>
  %stored_keys = buffer.view %key[%origin] : buffer -> view<[%tokens]x[%key_width]xi16>
  %value_layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %stored_values = buffer.view %value[%origin] : buffer -> view<[%tokens]x[%key_width]xi16, %value_layout>
  %gates = buffer.view %gate[%origin] : buffer -> view<[%tokens]x[%query_width]xi16>
  %visibility = buffer.view %mask[%origin] : buffer -> view<[%tokens]xi8>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%query_width]xbf16>
  scf.for %row = [%c0 to %tokens step %c1] {
    scf.for %column = [%c0 to %query_width step %c1] {
      %word = view.load %stored_queries[%row, %column] : view<[%tokens]x[%query_width]xi16> -> i16
      %number = func.call @reference_bf16_value(%word) : (i16) -> (f32)
      %wide = scalar.extf %number : f32 to f64
      view.store %wide, %queries[%row, %column] : f64, view<[%tokens]x[%query_width]xf64>
    }
    scf.for %column = [%c0 to %key_width step %c1] {
      %key_word = view.load %stored_keys[%row, %column] : view<[%tokens]x[%key_width]xi16> -> i16
      %value_word = view.load %stored_values[%row, %column] : view<[%tokens]x[%key_width]xi16, %value_layout> -> i16
      %key_number = func.call @reference_bf16_value(%key_word) : (i16) -> (f32)
      %value_number = func.call @reference_bf16_value(%value_word) : (i16) -> (f32)
      %key_wide = scalar.extf %key_number : f32 to f64
      %value_wide = scalar.extf %value_number : f32 to f64
      view.store %key_wide, %keys[%row, %column] : f64, view<[%tokens]x[%key_width]xf64>
      view.store %value_wide, %values[%row, %column] : f64, view<[%tokens]x[%key_width]xf64>
    }
  }
  %scratch_bytes = index.scale %tokens, %element_bytes : index, offset -> offset
  %scratch = buffer.alloca<private> align(8) %scratch_bytes : buffer
  %weights = buffer.view %scratch[%origin] : buffer -> view<[%tokens]xf64>
  %c0_i8 = scalar.constant 0 : i8
  %disabled = scalar.constant false : i1
  %c0_f64 = scalar.constant 0.0 : f64
  %minimum = scalar.constant -inf : f64
  %head_width = scalar.constant 128.0 : f64
  %scale = scalar.sqrtf %head_width : f64
  scf.for %row = [%c0 to %tokens step %c1] {
    scf.for %head = [%c0 to %query_heads step %c1] {
      %key_head_value = index.div %head, %sharing : index
      %key_head = index.assume %key_head_value [ge(%key_head_value, 0), lt(%key_head_value, %key_heads)] : index
      %query_begin = index.mul %head, %channels : index
      %key_begin = index.mul %key_head, %channels : index
      %maximum = scf.for %position = [%c0 to %tokens step %c1](%maximum = %minimum : f64) -> (f64) {
        %byte = view.load %visibility[%position] : view<[%tokens]xi8> -> i8
        %unmasked = scalar.cmpi ne, %byte, %c0_i8 : i8
        %future = index.cmp ugt, %position, %row : index
        %excluded = scalar.andi %causal, %future : i1
        %visible = scf.select %excluded, %disabled, %unmasked : i1
        %score = scf.if %visible -> (f64) {
          %dot = scf.for %channel = [%c0 to %channels step %c1](%sum = %c0_f64 : f64) -> (f64) {
            %query_column = index.add %query_begin, %channel : index
            %key_column = index.add %key_begin, %channel : index
            %left = view.load %queries[%row, %query_column] : view<[%tokens]x[%query_width]xf64> -> f64
            %right = view.load %keys[%position, %key_column] : view<[%tokens]x[%key_width]xf64> -> f64
            %product = scalar.mulf %left, %right : f64
            %next = scalar.addf %sum, %product : f64
            scf.yield %next : f64
          }
          %score = scalar.divf %dot, %scale : f64
          scf.yield %score : f64
        } else {
          scf.yield %minimum : f64
        }
        view.store %score, %weights[%position] : f64, view<[%tokens]xf64>
        %next = scalar.maxnumf %maximum, %score : f64
        scf.yield %next : f64
      }
      %denominator = scf.for %position = [%c0 to %tokens step %c1](%sum = %c0_f64 : f64) -> (f64) {
        %score = view.load %weights[%position] : view<[%tokens]xf64> -> f64
        %shifted = scalar.subf %score, %maximum : f64
        %probability = scalar.expf %shifted : f64
        %weight = scf.if %round_probability -> (f64) {
          %rounded = scalar.fptrunc %probability : f64 to bf16
          %extended = scalar.extf %rounded : bf16 to f64
          scf.yield %extended : f64
        } else {
          scf.yield %probability : f64
        }
        view.store %weight, %weights[%position] : f64, view<[%tokens]xf64>
        %next = scalar.addf %sum, %probability : f64
        scf.yield %next : f64
      }
      scf.for %channel = [%c0 to %channels step %c1] {
        %query_column = index.add %query_begin, %channel : index
        %key_column = index.add %key_begin, %channel : index
        %numerator = scf.for %position = [%c0 to %tokens step %c1](%sum = %c0_f64 : f64) -> (f64) {
          %weight = view.load %weights[%position] : view<[%tokens]xf64> -> f64
          %value = view.load %values[%position, %key_column] : view<[%tokens]x[%key_width]xf64> -> f64
          %product = scalar.mulf %weight, %value : f64
          %next = scalar.addf %sum, %product : f64
          scf.yield %next : f64
        }
        %context = scalar.divf %numerator, %denominator : f64
        %result = scf.if %gated -> (bf16) {
          %gate_word = view.load %gates[%row, %query_column] : view<[%tokens]x[%query_width]xi16> -> i16
          %gate_value = func.call @reference_bf16_value(%gate_word) : (i16) -> (f32)
          %gate_wide = scalar.extf %gate_value : f32 to f64
          %result = func.call @reference_attention_gate(%context, %gate_wide) : (f64, f64) -> (bf16)
          scf.yield %result : bf16
        } else {
          %result = scalar.fptrunc %context : f64 to bf16
          scf.yield %result : bf16
        }
        view.store %result, %outputs[%row, %query_column] : bf16, view<[%tokens]x[%query_width]xbf16>
      }
    }
  }
  func.return
}
