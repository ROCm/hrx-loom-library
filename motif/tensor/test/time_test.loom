  %configuration = check.literal value(2) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(123.0) : tensor<35xbf16>
    %input = check.tensor.view %input_storage offset(32) : tensor<35xbf16> -> tensor<3xbf16>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@initialize_time>(%configuration, %half_width, %negative_log_period, %time_scale, %parameters, %input) : (index, index, f32, f32, tensor<3xi32>, tensor<3xbf16>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<4128xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<4128xf32> -> tensor<4096xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<4128xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(16448) : tensor<4128xf32> -> tensor<16xf32>
    %padding = check.tensor.view %output offset(3072) : tensor<4096xf32> -> tensor<3328xf32>
    check.compare<@time_program, @time_reference>[%count, %rows, %half_width, %negative_log_period, %time_scale](%parameters, %input, %output) : [index, index, index, f32, f32](tensor<3xi32>, tensor<3xbf16>, tensor<4096xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.00095462799072265625) rtol(0.00390625) nan(different) : tensor<4096xf32>, tensor<4096xf32>
      check.expect.bitwise actual(%padding) expected(%padding) : tensor<3328xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<35xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

