// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT

// Time embeddings cover signed times, frequency/channel tails, zero phases,
// and physical rows beyond the logical input. A scalar F64 oracle constructs
// complete cosine/sine halves while preserving the contract's F32 phase steps.
// The relative budget is one BF16 unit roundoff; the absolute budget is
// (maximum phase + 1) * 2^-20 for F32 phase and native transcendental error.
// Zero phases, padding, immutable inputs, and allocation guards compare exactly.

config.def @test.time.workgroup_size = 32 : %value: index where [range(%value, 32, 256)]

amdgpu.target<gfx11-generic> @time_wave32 {subgroup_size = 32}

template.decl @time.sinusoidal_element_bf16(%half_width: index, %channel: index, %negative_log_period: f32, %time_scale: f32, %time: bf16) -> (bf16)

func.decl @initialize_time(%configuration: index, %half_width: index, %negative_log_period: f32, %time_scale: f32, %parameters: buffer, %input: buffer)

func.decl @time_reference(%parameters: buffer, %input: buffer, %output: buffer)

kernel.def target(@time_wave32) @features(%rows: index, %half_width: index) {
  %c2 = index.constant 2 : index
  %width = index.mul %half_width, %c2 : index
  %c1 = index.constant 1 : index
  %threads = config.get @test.time.workgroup_size : index
  %tail = index.sub %threads, %c1 : index
  %padded = index.add %width, %tail : index
  %groups = index.div %padded, %threads : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %groups, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%count_value: index, %rows_value: index, %half_width_value: index, %negative_log_period: f32, %time_scale: f32, %input: buffer, %output: buffer) {
  %count = index.assume %count_value [ge(%count_value, 1), le(%count_value, 6)] : index
  %rows = index.assume %rows_value [ge(%rows_value, 1), le(%rows_value, 16)] : index
  %half_width = index.assume %half_width_value [ge(%half_width_value, 1), le(%half_width_value, 129)] : index
  %c2 = index.constant 2 : index
  %width = index.mul %half_width, %c2 : index
  %threads = config.get @test.time.workgroup_size : index
  %row = kernel.workgroup.id<x> : index
  %group = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %channel = index.madd %group, %threads, %lane : index
  %valid_row = index.cmp ult, %row, %rows : index
  %valid_channel = index.cmp ult, %channel, %width : index
  %live = scalar.andi %valid_row, %valid_channel : i1
  scf.if %live {
    %origin = index.constant 0 : offset
    %inputs = buffer.view %input[%origin] : buffer -> view<[%count]xbf16>
    %outputs = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xf32>
    %logical = index.cmp ult, %row, %count : index
    %time = scf.if %logical -> (bf16) {
      %stored = view.load %inputs[%row] : view<[%count]xbf16> -> bf16
      scf.yield %stored : bf16
    } else {
      %padding_time = scalar.constant 0.0 : bf16
      scf.yield %padding_time : bf16
    }
    %feature = template.apply<@time.sinusoidal_element_bf16>(%half_width, %channel, %negative_log_period, %time_scale, %time) : (index, index, f32, f32, bf16) -> (bf16)
    %value = scalar.extf %feature : bf16 to f32
    view.store %value, %outputs[%row, %channel] : f32, view<[%rows]x[%width]xf32>
  }
  kernel.return
}

command.def @time_program(%count: index, %rows: index, %half_width: index, %negative_log_period: f32, %time_scale: f32) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  kernel.launch @features[%rows, %half_width](%count, %rows, %half_width, %negative_log_period, %time_scale, %input, %output) : [index, index](index, index, index, f32, f32, buffer, buffer)
  command.return
}

check.scenario public @zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %count = check.literal value(1) : index
  %rows = check.literal value(1) : index
  %half_width = check.literal value(128) : index
  %negative_log_period = check.literal value(-9.2103404998779297) : f32
  %time_scale = check.literal value(1000.0) : f32
  %configuration = check.literal value(0) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(123.0) : tensor<33xbf16>
    %input = check.tensor.view %input_storage offset(32) : tensor<33xbf16> -> tensor<1xbf16>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@initialize_time>(%configuration, %half_width, %negative_log_period, %time_scale, %parameters, %input) : (index, index, f32, f32, tensor<3xi32>, tensor<1xbf16>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<288xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<288xf32> -> tensor<256xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<288xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(1088) : tensor<288xf32> -> tensor<16xf32>
    check.compare<@time_program, @time_reference>[%count, %rows, %half_width, %negative_log_period, %time_scale](%parameters, %input, %output) : [index, index, index, f32, f32](tensor<3xi32>, tensor<1xbf16>, tensor<256xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<256xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<33xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@zero> @zero_features

check.scenario public @zero_scale {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %count = check.literal value(2) : index
  %rows = check.literal value(3) : index
  %half_width = check.literal value(7) : index
  %negative_log_period = check.literal value(-9.2103404998779297) : f32
  %time_scale = check.literal value(0.0) : f32
  %configuration = check.literal value(1) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(123.0) : tensor<34xbf16>
    %input = check.tensor.view %input_storage offset(32) : tensor<34xbf16> -> tensor<2xbf16>
    %parameters = check.generate.fill value(0) : tensor<3xi32>
    check.generate<@initialize_time>(%configuration, %half_width, %negative_log_period, %time_scale, %parameters, %input) : (index, index, f32, f32, tensor<3xi32>, tensor<2xbf16>) -> ()
    %output_storage = check.generate.fill value(123.25) : tensor<74xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<74xf32> -> tensor<42xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<74xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(232) : tensor<74xf32> -> tensor<16xf32>
    %padding = check.tensor.view %output offset(112) : tensor<42xf32> -> tensor<14xf32>
    check.compare<@time_program, @time_reference>[%count, %rows, %half_width, %negative_log_period, %time_scale](%parameters, %input, %output) : [index, index, index, f32, f32](tensor<3xi32>, tensor<2xbf16>, tensor<42xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<42xf32>
      check.expect.bitwise actual(%padding) expected(%padding) : tensor<14xf32>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<3xi32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<34xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
    }
  }
  check.return
}

check.benchmark<@zero_scale> @zero_scale_features

check.scenario public @padded_model_rows {
