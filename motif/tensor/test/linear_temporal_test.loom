// Temporal-bank projection covers both operand acquisition schedules with the
// same independent dyadic reference. Row/column tails, interior tiles, grouped
// traversal, and model-sized reductions exercise the complete contraction.
// Precision inputs distinguish F32 accumulation from BF16 accumulation; final
// publication, immutable operands, and complete allocation guards are bitwise.

amdgpu.target<gfx11-generic> @tensor_projection_temporal_rdna3

amdgpu.target<gfx11-generic> @temporal_projection_wave32 {subgroup_size = 32}

template.decl @projection.linear_temporal_bf16(%rows: index, %inputs: index, %outputs: index, %group_size: index, %rhs_read_ahead: i1, %input: buffer, %weight: buffer, %output: buffer)

func.decl @linear_fixture_initialize(%rows: index, %inputs: index, %outputs: index, %row_stride: index, %column_stride: index, %precision: i1, %input: buffer, %weight: buffer)

func.decl @linear_fixture_reference(%input: buffer, %weight: buffer, %output: buffer)

template.decl @temporal_shape(%configuration: index) -> (index, index, index, index, i1, i1)

template.def<@temporal_shape> @temporal_shape_values(%configuration: index) -> (index, index, index, index, i1, i1) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c80 = index.constant 80 : index
  %c96 = index.constant 96 : index
  %c112 = index.constant 112 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c208 = index.constant 208 : index
  %c256 = index.constant 256 : index
  %c416 = index.constant 416 : index
  %c512 = index.constant 512 : index
  %c768 = index.constant 768 : index
  %c6144 = index.constant 6144 : index
  %c16384 = index.constant 16384 : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %rows, %inputs, %outputs, %group, %read_ahead, %precision = scf.lookup %configuration {
    0 = (%c16, %c256, %c16, %c1, %true, %false),
    1 = (%c32, %c256, %c32, %c1, %false, %false),
    2 = (%c48, %c256, %c48, %c1, %true, %false),
    3 = (%c64, %c256, %c64, %c1, %false, %false),
    4 = (%c80, %c256, %c80, %c1, %true, %false),
    5 = (%c96, %c256, %c96, %c1, %false, %false),
    6 = (%c112, %c256, %c112, %c1, %true, %false),
    7 = (%c128, %c512, %c96, %c1, %false, %false),
    8 = (%c128, %c512, %c96, %c1, %true, %false),
    9 = (%c144, %c768, %c208, %c1, %false, %false),
    10 = (%c144, %c768, %c208, %c1, %true, %false),
    11 = (%c416, %c256, %c112, %c2, %true, %false),
    12 = (%c144, %c256, %c112, %c8, %false, %false),
    13 = (%c16, %c6144, %c112, %c1, %true, %false),
    14 = (%c16, %c16384, %c96, %c1, %false, %false),
    15 = (%c16, %c256, %c16, %c1, %false, %true)
  } default(%c16, %c256, %c16, %c1, %true, %true) : index, index, index, index, i1, i1
  template.return %rows, %inputs, %outputs, %group, %read_ahead, %precision : index, index, index, index, i1, i1
}

func.def @temporal_storage(%configuration: index) -> (index, index, index) {
  %rows, %inputs, %outputs, %group, %read_ahead, %precision = template.apply<@temporal_shape>(%configuration) : (index) -> (index, index, index, index, i1, i1)
  %guards = index.constant 32 : index
  %input_storage = index.madd %rows, %inputs, %guards : index
  %weight_storage = index.madd %outputs, %inputs, %guards : index
  %output_storage = index.madd %rows, %outputs, %guards : index
  func.return %input_storage, %weight_storage, %output_storage : index, index, index
}

func.def @initialize_temporal_projection(%configuration: index, %input: buffer, %weight: buffer) {
  %rows, %inputs, %outputs, %group, %read_ahead, %precision = template.apply<@temporal_shape>(%configuration) : (index) -> (index, index, index, index, i1, i1)
  %unit = index.constant 1 : index
  func.call @linear_fixture_initialize(%rows, %inputs, %outputs, %outputs, %unit, %precision, %input, %weight) : (index, index, index, index, index, i1, buffer, buffer)
  func.return
}

kernel.def target(@temporal_projection_wave32) @apply_temporal_projection(%rows: index, %outputs: index) {
  %row_tile = index.constant 128 : index
  %output_tile = index.constant 96 : index
  %row_rounding = index.constant 127 : index
  %output_rounding = index.constant 95 : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  %row_numerator = index.add %rows, %row_rounding : index
  %output_numerator = index.add %outputs, %output_rounding : index
  %row_tiles = index.div %row_numerator, %row_tile : index
  %output_tiles = index.div %output_numerator, %output_tile : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%rows: index, %inputs: index, %outputs: index, %group: index, %read_ahead: i1, %input: buffer, %weight: buffer, %output: buffer) {
  template.apply<@projection.linear_temporal_bf16>(%rows, %inputs, %outputs, %group, %read_ahead, %input, %weight, %output) : (index, index, index, index, i1, buffer, buffer, buffer)
  kernel.return
}

command.def @temporal_projection_program(%configuration: index) launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows, %inputs, %outputs, %group, %read_ahead, %precision = template.apply<@temporal_shape>(%configuration) : (index) -> (index, index, index, index, i1, i1)
  %origin = index.constant 32 : offset
  %activation = buffer.view %input[%origin] : buffer -> view<[%rows]x[%inputs]xbf16>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]xbf16>
  %results = buffer.view %output[%origin] : buffer -> view<[%rows]x[%outputs]xbf16>
  kernel.launch @apply_temporal_projection[%rows, %outputs](%rows, %inputs, %outputs, %group, %read_ahead, %activation, %weights, %results) : [index, index](index, index, index, index, i1, view<[%rows]x[%inputs]xbf16>, view<[%outputs]x[%inputs]xbf16>, view<[%rows]x[%outputs]xbf16>)
  command.return
}

check.scenario public @temporal_projection configure[17](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_count, %weight_count, %output_count = check.generate<@temporal_storage>(%configuration) : (index) -> (index, index, index)
    %input = check.generate.fill value(-12345) : tensor<[%input_count]xi16>
    %weight = check.generate.fill value(-12345) : tensor<[%weight_count]xi16>
    %output = check.generate.fill value(17142) : tensor<[%output_count]xi16>
    check.generate<@initialize_temporal_projection>(%configuration, %input, %weight) : (index, tensor<[%input_count]xi16>, tensor<[%weight_count]xi16>) -> ()
    check.compare<@temporal_projection_program, @linear_fixture_reference>[%configuration](%input, %weight, %output) : [index](tensor<[%input_count]xi16>, tensor<[%weight_count]xi16>, tensor<[%output_count]xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xi16>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<[%weight_count]xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<[%output_count]xi16>
    }
  }
  check.return
}

check.benchmark<@temporal_projection> @temporal_projection_benchmark
