check.scenario public @precision_read_ahead {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<4128xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<4128xi16> -> tensor<4096xbf16>
    %weight_storage = check.generate.fill value(-12345) : tensor<4128xi16>
