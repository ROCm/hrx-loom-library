    check.generate<@initialize_precision_read_ahead>(%input, %weight) : (tensor<4096xbf16>, tensor<4096xbf16>) -> ()
    check.compare<@apply_precision_read_ahead, @reference_precision_read_ahead>(%input, %weight, %output) : (tensor<4096xbf16>, tensor<4096xbf16>, tensor<256xbf16>) -> () {
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<288xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<4128xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<4128xi16>
    }
  }
  check.return
}

check.benchmark<@precision_read_ahead> @precision_read_ahead_benchmark
