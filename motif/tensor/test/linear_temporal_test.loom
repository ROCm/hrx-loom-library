  %input_bytes = index.constant 8192 : offset
  %weight_bytes = index.constant 8192 : offset
  %input_values = global.load @precision_pairwise_input : buffer
  %weight_values = global.load @precision_pairwise_weight : buffer
  buffer.copy %input_values[%origin], %input[%origin], %input_bytes
  buffer.copy %weight_values[%origin], %weight[%origin], %weight_bytes
  func.return
}

kernel.def target(@temporal_projection_wave32) @apply_precision_pairwise() {
  %row_tiles = index.constant 1 : index
  %output_tiles = index.constant 1 : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 16 : index
  %inputs = index.constant 256 : index
  %outputs = index.constant 16 : index
  %group = index.constant 1 : index
  %read_ahead = scalar.constant false : i1
  template.apply<@projection.linear_temporal_bf16>(%rows, %inputs, %outputs, %group, %read_ahead, %input, %weight, %output) : (index, index, index, index, i1, buffer, buffer, buffer)
  kernel.return
}

func.def @reference_precision_pairwise(%input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %expected = global.load @precision_pairwise_expected : buffer
  buffer.copy %expected[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @precision_pairwise {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<4128xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<4128xi16> -> tensor<4096xbf16>
    %weight_storage = check.generate.fill value(-12345) : tensor<4128xi16>
    %weight = check.tensor.view %weight_storage offset(32) : tensor<4128xi16> -> tensor<4096xbf16>
    %output_storage = check.generate.fill value(17142) : tensor<288xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<288xi16> -> tensor<256xbf16>
    check.generate<@initialize_precision_pairwise>(%input, %weight) : (tensor<4096xbf16>, tensor<4096xbf16>) -> ()
    check.compare<@apply_precision_pairwise, @reference_precision_pairwise>(%input, %weight, %output) : (tensor<4096xbf16>, tensor<4096xbf16>, tensor<256xbf16>) -> () {
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<288xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<4128xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<4128xi16>
    }
  }
  check.return
}

check.benchmark<@precision_pairwise> @precision_pairwise_benchmark

global.rodata.def @precision_read_ahead_input = align(2) bytes("")

global.rodata.def @precision_read_ahead_weight = align(2) bytes("")

global.rodata.def @precision_read_ahead_expected = align(2) bytes("")

func.def @initialize_precision_read_ahead(%input: buffer, %weight: buffer) {
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 8192 : offset
  %weight_bytes = index.constant 8192 : offset
  %input_values = global.load @precision_read_ahead_input : buffer
  %weight_values = global.load @precision_read_ahead_weight : buffer
  buffer.copy %input_values[%origin], %input[%origin], %input_bytes
  buffer.copy %weight_values[%origin], %weight[%origin], %weight_bytes
  func.return
}

kernel.def target(@temporal_projection_wave32) @apply_precision_read_ahead() {
  %row_tiles = index.constant 1 : index
  %output_tiles = index.constant 1 : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 16 : index
  %inputs = index.constant 256 : index
  %outputs = index.constant 16 : index
  %group = index.constant 1 : index
  %read_ahead = scalar.constant true : i1
  template.apply<@projection.linear_temporal_bf16>(%rows, %inputs, %outputs, %group, %read_ahead, %input, %weight, %output) : (index, index, index, index, i1, buffer, buffer, buffer)
  kernel.return
}

func.def @reference_precision_read_ahead(%input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %expected = global.load @precision_read_ahead_expected : buffer
  buffer.copy %expected[%origin], %output[%origin], %bytes
  func.return
