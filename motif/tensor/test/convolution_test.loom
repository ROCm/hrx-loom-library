// Scalar convolution covers padding, nearest expansion, temporal-plane storage,
// channel/spatial tails, and residual aliasing. Loom supplies random full-F32
// operands; directed cases distinguish fused products and bias/residual order.
// The independent oracle expands and pads the image before ascending F32 FMAs.
// Every allocation compares bitwise, including immutable inputs and guards.

config.def @test.convolution.workgroup_size = 32 : %value: index where [range(%value, 32, 256)]

amdgpu.target<gfx11-generic> @convolution_wave32 {subgroup_size = 32}

template.decl @image.convolution_nchw_element_f32(%height: index, %width: index, %inputs: index, %outputs: index, %extent: index, %planes: index, %upsample: index, %channel: index, %pixel: index, %input: buffer, %weight: buffer, %bias: buffer) -> (f32)

func.decl @convolution_guard(%length: index, %storage: buffer)

func.decl @convolution_header(%height: index, %width: index, %inputs: index, %outputs: index, %extent: index, %planes: index, %upsample: index, %residual: i1, %alias: i1, %input: buffer)

func.decl @convolution_scalar_reference(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)

template.decl @convolution_shape(%configuration: index) -> (index, index, index, index, index, index, index, i1, i1)

template.def<@convolution_shape> @convolution_shape_values(%configuration: index) -> (index, index, index, index, index, index, index, i1, i1) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c17 = index.constant 17 : index
  %c96 = index.constant 96 : index
  %c384 = index.constant 384 : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %height, %width, %inputs, %outputs, %extent, %planes, %upsample, %residual, %alias = scf.lookup %configuration {
    0 = (%c1, %c1, %c1, %c1, %c1, %c1, %c1, %false, %false),
    1 = (%c1, %c1, %c3, %c2, %c3, %c3, %c1, %true, %false),
    2 = (%c3, %c5, %c3, %c4, %c3, %c3, %c1, %false, %false),
    3 = (%c2, %c3, %c2, %c3, %c3, %c2, %c2, %true, %true),
    4 = (%c2, %c1, %c2, %c2, %c5, %c2, %c3, %false, %false),
    5 = (%c4, %c8, %c2, %c2, %c1, %c1, %c1, %true, %false),
    6 = (%c9, %c17, %c2, %c3, %c1, %c1, %c1, %true, %true),
    7 = (%c1, %c3, %c384, %c2, %c1, %c1, %c1, %false, %false),
    8 = (%c1, %c2, %c3, %c384, %c1, %c1, %c1, %false, %false),
    9 = (%c2, %c2, %c96, %c3, %c3, %c3, %c1, %false, %false),
    10 = (%c1, %c1, %c2, %c1, %c1, %c1, %c1, %false, %false),
    11 = (%c1, %c1, %c2, %c1, %c1, %c1, %c1, %false, %false)
  } default(%c1, %c1, %c2, %c1, %c1, %c1, %c1, %true, %true) : index, index, index, index, index, index, index, i1, i1
  template.return %height, %width, %inputs, %outputs, %extent, %planes, %upsample, %residual, %alias : index, index, index, index, index, index, index, i1, i1
}

func.def @convolution_storage(%configuration: index) -> (index, index, index, index) {
  %height, %width, %inputs, %outputs, %extent, %planes, %upsample, %residual, %alias = template.apply<@convolution_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index, i1, i1)
  %guards = index.constant 32 : index
  %pixels = index.mul %height, %width : index
  %input_count = index.madd %inputs, %pixels, %guards : index
  %taps = index.mul %extent, %extent : index
  %stored_taps = index.mul %planes, %taps : index
  %coefficients = index.mul %inputs, %stored_taps : index
  %weight_count = index.madd %outputs, %coefficients, %guards : index
  %bias_count = index.add %outputs, %guards : index
  %expansion = index.mul %upsample, %upsample : index
  %expanded_pixels = index.mul %pixels, %expansion : index
  %output_count = index.madd %outputs, %expanded_pixels, %guards : index
  func.return %input_count, %weight_count, %bias_count, %output_count : index, index, index, index
}

func.def @initialize_convolution(%configuration: index, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer) {
  %height, %width, %inputs, %outputs, %extent, %planes, %upsample, %add_residual, %alias = template.apply<@convolution_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index, i1, i1)
  %input_count, %weight_count, %bias_count, %output_count = func.call @convolution_storage(%configuration) : (index) -> (index, index, index, index)
  %guards = index.constant 32 : index
  %input_length = index.sub %input_count, %guards : index
  %weight_length = index.sub %weight_count, %guards : index
  %output_length = index.sub %output_count, %guards : index
  func.call @convolution_guard(%input_length, %input) : (index, buffer)
  func.call @convolution_guard(%weight_length, %weight) : (index, buffer)
  func.call @convolution_guard(%outputs, %bias) : (index, buffer)
  func.call @convolution_guard(%output_length, %residual) : (index, buffer)
  func.call @convolution_header(%height, %width, %inputs, %outputs, %extent, %planes, %upsample, %add_residual, %alias, %input) : (index, index, index, index, index, index, index, i1, i1, buffer)
  %origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c10 = index.constant 10 : index
  %c11 = index.constant 11 : index
  %c1000 = index.constant 1000 : index
  %last_plane = index.sub %planes, %c1 : index
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]x[%planes]x[%extent]x[%extent]xf32>
  // Inactive temporal planes must never influence a fresh causal frame.
  scf.for %output_channel = [%c0 to %outputs step %c1] {
    scf.for %channel = [%c0 to %inputs step %c1] {
      scf.for %plane = [%c0 to %last_plane step %c1] {
        %base = index.add %c1000, %plane : index
        %poison_index = index.add %base, %channel : index
        %poison_word = index.cast %poison_index : index to i32
        %poison = scalar.sitofp %poison_word : i32 to f32
        scf.for %ky = [%c0 to %extent step %c1] {
          scf.for %kx = [%c0 to %extent step %c1] {
            view.store %poison, %weights[%output_channel, %channel, %plane, %ky, %kx] : f32, view<[%outputs]x[%inputs]x[%planes]x[%extent]x[%extent]xf32>
          }
        }
      }
    }
  }
  %directed = index.cmp uge, %configuration, %c10 : index
  scf.if %directed {
    %fused = index.cmp eq, %configuration, %c10 : index
    %bias_order = index.cmp eq, %configuration, %c11 : index
    %c0_f32 = scalar.constant 0.0 : f32
    %c1_f32 = scalar.constant 1.0 : f32
    %cneg1_f32 = scalar.constant -1.0 : f32
    %above_one = scalar.constant 1.0000001192092896 : f32
    %below_one = scalar.constant 0.99999988079071045 : f32
    %large = scalar.constant 16777216.0 : f32
    %negative_large = scalar.constant -16777216.0 : f32
    %left = scf.select %fused, %cneg1_f32, %large : f32
    %tail = scf.select %bias_order, %negative_large, %c0_f32 : f32
    %right = scf.select %fused, %above_one, %tail : f32
    %coefficient = scf.select %fused, %below_one, %c1_f32 : f32
    %offset = scf.select %fused, %c0_f32, %c1_f32 : f32
    %values = buffer.view %input[%origin] : buffer -> view<2xf32>
    %coefficients = buffer.view %weight[%origin] : buffer -> view<2xf32>
    %biases = buffer.view %bias[%origin] : buffer -> view<1xf32>
    %skips = buffer.view %residual[%origin] : buffer -> view<1xf32>
    view.store %left, %values[0] : f32, view<2xf32>
    view.store %right, %values[1] : f32, view<2xf32>
    view.store %c1_f32, %coefficients[0] : f32, view<2xf32>
    view.store %coefficient, %coefficients[1] : f32, view<2xf32>
    view.store %offset, %biases[0] : f32, view<1xf32>
    view.store %negative_large, %skips[0] : f32, view<1xf32>
  }
  func.return
}

kernel.def target(@convolution_wave32) @convolve_pixels(%pixels: index, %outputs: index) {
  %threads = config.get @test.convolution.workgroup_size : index
  %c1 = index.constant 1 : index
  %last = index.sub %threads, %c1 : index
  %numerator = index.add %pixels, %last : index
  %groups = index.div %numerator, %threads : index
  kernel.launch.config workgroups(%groups, %outputs, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%height: index, %width: index, %inputs: index, %outputs: index, %extent: index, %planes: index, %upsample: index, %add_residual: i1, %alias: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %threads = config.get @test.convolution.workgroup_size : index
  %output_height = index.mul %height, %upsample : index
  %output_width = index.mul %width, %upsample : index
  %pixels = index.mul %output_height, %output_width : index
  %group = kernel.workgroup.id<x> : index
  %channel_value = kernel.workgroup.id<y> : index
  %channel = index.assume %channel_value [ge(%channel_value, 0), lt(%channel_value, %outputs)] : index
  %lane = kernel.workitem.id<x> : index
  %pixel = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %pixel, %pixels : index
  scf.if %live {
    %value = template.apply<@image.convolution_nchw_element_f32>(%height, %width, %inputs, %outputs, %extent, %planes, %upsample, %channel, %pixel, %input, %weight, %bias) : (index, index, index, index, index, index, index, index, index, buffer, buffer, buffer) -> (f32)
    %result = scf.if %add_residual -> (f32) {
      %skips = buffer.view %residual[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
      %skip = view.load %skips[%channel, %pixel] : view<[%outputs]x[%pixels]xf32> -> f32
      %combined = scalar.addf %value, %skip : f32
      scf.yield %combined : f32
    } else {
      scf.yield %value : f32
    }
    %destination = scf.select %alias, %residual, %output : buffer
    %results = buffer.view %destination[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
    view.store %result, %results[%channel, %pixel] : f32, view<[%outputs]x[%pixels]xf32>
  }
  kernel.return
}

command.def @convolution_program(%configuration: index) launch(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %height, %width, %inputs, %outputs, %extent, %planes, %upsample, %add_residual, %alias = template.apply<@convolution_shape>(%configuration) : (index) -> (index, index, index, index, index, index, index, i1, i1)
  %origin = index.constant 64 : offset
  %output_height = index.mul %height, %upsample : index
  %output_width = index.mul %width, %upsample : index
  %pixels = index.mul %output_height, %output_width : index
  %activation = buffer.view %input[%origin] : buffer -> view<[%inputs]x[%height]x[%width]xf32>
  %weights = buffer.view %weight[%origin] : buffer -> view<[%outputs]x[%inputs]x[%planes]x[%extent]x[%extent]xf32>
  %biases = buffer.view %bias[%origin] : buffer -> view<[%outputs]xf32>
  %skips = buffer.view %residual[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
  %results = buffer.view %output[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
  kernel.launch @convolve_pixels[%pixels, %outputs](%height, %width, %inputs, %outputs, %extent, %planes, %upsample, %add_residual, %alias, %activation, %weights, %biases, %skips, %results) : [index, index](index, index, index, index, index, index, index, i1, i1, view<[%inputs]x[%height]x[%width]xf32>, view<[%outputs]x[%inputs]x[%planes]x[%extent]x[%extent]xf32>, view<[%outputs]xf32>, view<[%outputs]x[%pixels]xf32>, view<[%outputs]x[%pixels]xf32>)
  command.return
}

check.scenario public @scalar_convolution configure[13](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_count, %weight_count, %bias_count, %output_count = check.generate<@convolution_storage>(%configuration) : (index) -> (index, index, index, index)
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %bias_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %residual_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-4.0 to 4.0) : tensor<[%input_count]xf32>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-4.0 to 4.0) : tensor<[%weight_count]xf32>
    %bias = check.generate.random.uniform seed(%bias_seed) range(-4.0 to 4.0) : tensor<[%bias_count]xf32>
    %residual = check.generate.random.uniform seed(%residual_seed) range(-4.0 to 4.0) : tensor<[%output_count]xf32>
    %output = check.generate.fill value(123.25) : tensor<[%output_count]xf32>
    check.generate<@initialize_convolution>(%configuration, %input, %weight, %bias, %residual) : (index, tensor<[%input_count]xf32>, tensor<[%weight_count]xf32>, tensor<[%bias_count]xf32>, tensor<[%output_count]xf32>) -> ()
    check.compare<@convolution_program, @convolution_scalar_reference>[%configuration](%input, %weight, %bias, %residual, %output) : [index](tensor<[%input_count]xf32>, tensor<[%weight_count]xf32>, tensor<[%bias_count]xf32>, tensor<[%output_count]xf32>, tensor<[%output_count]xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<[%weight_count]xf32>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<[%bias_count]xf32>
      check.expect.bitwise actual(%residual) expected(%residual) : tensor<[%output_count]xf32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<[%output_count]xf32>
    }
  }
  check.return
}

check.benchmark<@scalar_convolution> @scalar_convolution_benchmark
