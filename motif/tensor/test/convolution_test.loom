kernel.def target(@convolution_wave32) @convolve_residual_after_bias() {
  %groups = index.constant 1 : index
  %channels = index.constant 1 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %channels, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer) {
  %height = index.constant 1 : index
  %width = index.constant 1 : index
  %inputs = index.constant 2 : index
  %outputs = index.constant 1 : index
  %extent = index.constant 1 : index
  %planes = index.constant 1 : index
  %upsample = index.constant 1 : index
  %pixels = index.constant 1 : index
  %threads = index.constant 32 : index
  %origin = index.constant 0 : offset
  %group = kernel.workgroup.id<x> : index
  %channel = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %pixel = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %pixel, %pixels : index
  scf.if %live {
    %value = template.apply<@image.convolution_nchw_element_f32>(%height, %width, %inputs, %outputs, %extent, %planes, %upsample, %channel, %pixel, %input, %weight, %bias) : (index, index, index, index, index, index, index, index, index, buffer, buffer, buffer) -> (f32)
    %residual_view = buffer.view %residual[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
    %skip = view.load %residual_view[%channel, %pixel] : view<[%outputs]x[%pixels]xf32> -> f32
    %combined = scalar.addf %value, %skip : f32
    %output_view = buffer.view %residual[%origin] : buffer -> view<[%outputs]x[%pixels]xf32>
    view.store %combined, %output_view[%channel, %pixel] : f32, view<[%outputs]x[%pixels]xf32>
  }
  kernel.return
}

