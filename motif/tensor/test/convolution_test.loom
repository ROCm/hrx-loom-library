  %bytes_residual = index.constant 132 : offset
  %values_residual = global.load @bias_after_sum_residual : buffer
  buffer.copy %values_residual[%origin], %residual[%origin], %bytes_residual
  func.return
}

func.def @reference_bias_after_sum(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
