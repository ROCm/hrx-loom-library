check.scenario public @bias_after_sum {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(123.25) : tensor<34xf32>
    %weight_storage = check.generate.fill value(123.25) : tensor<34xf32>
    %bias_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %residual_storage = check.generate.fill value(123.25) : tensor<33xf32>
    check.generate<@initialize_bias_after_sum>(%input_storage, %weight_storage, %bias_storage, %residual_storage) : (tensor<34xf32>, tensor<34xf32>, tensor<33xf32>, tensor<33xf32>) -> ()
    %input = check.tensor.view %input_storage offset(64) : tensor<34xf32> -> tensor<2xf32>
    %weight = check.tensor.view %weight_storage offset(64) : tensor<34xf32> -> tensor<2xf32>
    %bias = check.tensor.view %bias_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %residual = check.tensor.view %residual_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %output_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %output = check.tensor.view %output_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<33xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %output_storage offset(68) : tensor<33xf32> -> tensor<16xf32>
    check.compare<@convolve_bias_after_sum, @reference_bias_after_sum>(%input, %weight, %bias, %residual, %output) : (tensor<2xf32>, tensor<2xf32>, tensor<1xf32>, tensor<1xf32>, tensor<1xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<34xf32>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<34xf32>
      check.expect.bitwise actual(%bias_storage) expected(%bias_storage) : tensor<33xf32>
      check.expect.bitwise actual(%residual_storage) expected(%residual_storage) : tensor<33xf32>
    }
  }
  check.return
}

