// Exercise projection store, bias, and adapter epilogues without contraction.
// An independent scalar VM oracle observes both the F32 intermediate and BF16
// publication, including midpoint neighbors, signed zeros, and subnormals.
// Reversed tile traversal and dense, column-major, and padded storage test the
// layout contract. Adapter cases include exact base/output aliasing and signed
// zero strengths, which preserve the base rather than evaluating a zero delta.

amdgpu.target<gfx11-generic> @tensor_projection_rdna3

amdgpu.target<gfx11-generic> @projection_rdna3_wave32 {subgroup_size = 32}

template.decl @projection.store_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)

template.decl @projection.bias_storage_bf16(%outputs: index, %output_origin: index, %weight_is_bf16: i1, %result: vector<8xf32>, %bias: buffer) -> (vector<8xf32>)

template.decl @projection.adapter_epilogue_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %base_layout: encoding<layout>, %result: vector<8xf32>, %strength: buffer, %base: buffer) -> (vector<8xf32>)

func.decl @reference_bf16_round(%value: f32) -> (f32)

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

template.decl @epilogue_shape(%configuration: index) -> (index, index, index, index, index, i1, i1, f32)

template.def<@epilogue_shape> @epilogue_shape_values(%configuration: index) -> (index, index, index, index, index, i1, i1, f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c9 = index.constant 9 : index
  %c11 = index.constant 11 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %small = index.cmp eq, %configuration, %c0 : index
  %rows = scf.select %small, %c16, %c32 : index
  %columns = scf.select %small, %c32, %c48 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  // Layout choices follow store, bias, then adapter configurations.
  %layouts = vector.from_elements %c0_i32, %c1_i32, %c2_i32, %c0_i32, %c1_i32, %c2_i32, %c0_i32, %c1_i32, %c2_i32, %c2_i32, %c0_i32, %c1_i32 : vector<12xi32>
  %layout = vector.extract %layouts[%configuration] : vector<12xi32> -> i32
  %column_major = scalar.cmpi eq, %layout, %c1_i32 : i32
  %padded = scalar.cmpi eq, %layout, %c2_i32 : i32
  %padding = scf.select %padded, %c16, %c0 : index
  %padded_columns = index.add %columns, %padding : index
  %row_stride = scf.select %column_major, %c1, %padded_columns : index
  %column_stride = scf.select %column_major, %rows, %c1 : index
  %store = index.cmp ult, %configuration, %c3 : index
  %before_adapter = index.cmp ult, %configuration, %c6 : index
  %other_operation = scf.select %before_adapter, %c1, %c2 : index
  %operation = scf.select %store, %c0, %other_operation : index
  %bias_bf16 = index.cmp eq, %configuration, %c3 : index
  %alias_negative = index.cmp eq, %configuration, %c7 : index
  %alias_positive = index.cmp eq, %configuration, %c9 : index
  %alias_zero = index.cmp eq, %configuration, %c11 : index
  %alias_nonzero = scalar.ori %alias_negative, %alias_positive : i1
  %inplace = scalar.ori %alias_nonzero, %alias_zero : i1
  %unit = scalar.constant 1.0 : f32
  %half = scalar.constant 0.5 : f32
  %negative = scalar.constant -0.625 : f32
  %midpoint = scalar.constant 1.00390625 : f32
  %positive = scalar.constant 1.25 : f32
  %c0_f32 = scalar.constant 0.0 : f32
  %sign_payload = scalar.constant -0.0 : f32
  %strengths = vector.from_elements %unit, %unit, %unit, %unit, %unit, %unit, %half, %negative, %midpoint, %positive, %c0_f32, %sign_payload : vector<12xf32>
  %strength = vector.extract %strengths[%configuration] : vector<12xf32> -> f32
  template.return %rows, %columns, %row_stride, %column_stride, %operation, %bias_bf16, %inplace, %strength : index, index, index, index, index, i1, i1, f32
}

// A small runtime pool combines directed F32 words with trial entropy. Input,
// bias, and base traverse different permutations so cancellation varies by tile.
func.def @initialize_epilogue_choices(%storage: buffer) {
  %origin = index.constant 0 : offset
  %values = buffer.view %storage[%origin] : buffer -> view<178xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c18 = index.constant 18 : index
  %c24 = index.constant 24 : index
  %c50 = index.constant 50 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %sign_bit = scalar.constant -2147483648 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %sign_payload = scalar.bitcast %sign_bit : i32 to f32
  view.store %c0_f32, %values[0] : f32, view<178xf32>
  view.store %sign_payload, %values[1] : f32, view<178xf32>
  scf.for %position = [%c2 to %c50 step %c1] {
    %element = index.sub %position, %c2 : index
    %negative = index.cmp ult, %element, %c24 : index
    %sign = scf.select %negative, %sign_bit, %c0_i32 : i32
    %ordinal = index.rem %element, %c24 : index
    %midpoint = index.cmp ult, %ordinal, %c18 : index
    %magnitude = scf.if %midpoint -> (i32) {
      %mantissa = index.div %ordinal, %c3 : index
      %early = index.cmp ult, %mantissa, %c4 : index
      %low = index.add %mantissa, %c1 : index
      %high = index.add %mantissa, %c2 : index
      %exponent = scf.select %early, %low, %high : index
      %shift = index.cast %exponent : index to i32
      %power = scalar.shli %c1_i32, %shift : i32
      %numerator = scalar.subi %power, %c1_i32 : i32
      %fraction = scalar.uitofp %numerator : i32 to f32
      %spacing = scalar.constant 0.00390625 : f32
      %unit = scalar.constant 1.0 : f32
      %delta = scalar.mulf %fraction, %spacing : f32
      %value = scalar.addf %unit, %delta : f32
      %bits = scalar.bitcast %value : f32 to i32
      %neighbor = index.rem %ordinal, %c3 : index
      %neighbor_word = index.cast %neighbor : index to i32
      %displacement = scalar.subi %neighbor_word, %c1_i32 : i32
      %displaced = scalar.addi %bits, %displacement : i32
      scf.yield %displaced : i32
    } else {
      %p0 = scalar.constant 1 : i32
      %p1 = scalar.constant 32768 : i32
      %p2 = scalar.constant 65536 : i32
      %p3 = scalar.constant 8388608 : i32
      %p4 = scalar.constant 562036736 : i32
      %p5 = scalar.constant 1568669696 : i32
      %powers = vector.from_elements %p0, %p1, %p2, %p3, %p4, %p5 : vector<6xi32>
      %power_index = index.sub %ordinal, %c18 : index
      %bits = vector.extract %powers[%power_index] : vector<6xi32> -> i32
      scf.yield %bits : i32
    }
    %bits = scalar.ori %magnitude, %sign : i32
    %value = scalar.bitcast %bits : i32 to f32
    view.store %value, %values[%position] : f32, view<178xf32>
  }
  func.return
}

func.def @epilogue_storage(%configuration: index) -> (index, index, index, index, index, index) {
  %rows, %columns, %row_stride, %column_stride, %operation, %bias_bf16, %inplace, %strength = template.apply<@epilogue_shape>(%configuration) : (index) -> (index, index, index, index, index, i1, i1, f32)
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %guards = index.constant 32 : index
  %logical = index.mul %rows, %columns : index
  %column_major = index.cmp eq, %row_stride, %c1 : index
  %padded = index.mul %rows, %row_stride : index
  %physical = scf.select %column_major, %logical, %padded : index
  %bias_element_words = scf.select %bias_bf16, %c1, %c2 : index
  %bias_words = index.mul %columns, %bias_element_words : index
  %logical_storage = index.add %logical, %guards : index
  %physical_storage = index.add %physical, %guards : index
  %bias_storage = index.add %bias_words, %guards : index
  func.return %logical, %physical, %bias_words, %logical_storage, %physical_storage, %bias_storage : index, index, index, index, index, index
}

func.def @initialize_epilogue(%configuration: index, %choices: buffer, %input: buffer, %bias: buffer, %strength: buffer, %base: buffer, %wide: buffer) {
  %rows, %columns, %row_stride, %column_stride, %operation, %bias_bf16, %inplace, %scale = template.apply<@epilogue_shape>(%configuration) : (index) -> (index, index, index, index, index, i1, i1, f32)
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c7 = index.constant 7 : index
  %c11 = index.constant 11 : index
  %c13 = index.constant 13 : index
  %c37 = index.constant 37 : index
  %choice_count = index.constant 178 : index
  %values = buffer.view %choices[%origin] : buffer -> view<178xf32>
  %inputs = buffer.view %input[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %bases = buffer.view %base[%origin] : buffer -> view<[%rows]x[%columns]xi16, %layout>
  %strengths = buffer.view %strength[%origin] : buffer -> view<1xf32>
  view.store %scale, %strengths[0] : f32, view<1xf32>
  // Metadata is immutable in the otherwise guarded wide-output prefix.
  %header = buffer.view %wide[%origin] : buffer -> view<7xi32>
  %row_word = index.cast %rows : index to i32
  %column_word = index.cast %columns : index to i32
  %row_stride_word = index.cast %row_stride : index to i32
  %column_stride_word = index.cast %column_stride : index to i32
  %operation_word = index.cast %operation : index to i32
  %bias_word = scalar.extui %bias_bf16 : i1 to i32
  %inplace_word = scalar.extui %inplace : i1 to i32
  view.store %row_word, %header[0] : i32, view<7xi32>
  view.store %column_word, %header[1] : i32, view<7xi32>
  view.store %row_stride_word, %header[2] : i32, view<7xi32>
  view.store %column_stride_word, %header[3] : i32, view<7xi32>
  view.store %operation_word, %header[4] : i32, view<7xi32>
  view.store %bias_word, %header[5] : i32, view<7xi32>
  view.store %inplace_word, %header[6] : i32, view<7xi32>
  scf.for %column = [%c0 to %columns step %c1] {
    %index_value = index.madd %column, %c7, %c2 : index
    %choice = index.rem %index_value, %choice_count : index
    %value = view.load %values[%choice] : view<178xf32> -> f32
    scf.if %bias_bf16 {
      %biases = buffer.view %bias[%origin] : buffer -> view<[%columns]xi16>
      %word = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
      view.store %word, %biases[%column] : i16, view<[%columns]xi16>
    } else {
      %biases = buffer.view %bias[%origin] : buffer -> view<[%columns]xf32>
      view.store %value, %biases[%column] : f32, view<[%columns]xf32>
    }
  }
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %column = [%c0 to %columns step %c1] {
      %row_term = index.mul %row, %c37 : index
      %index_value = index.madd %column, %c11, %row_term : index
      %choice = index.rem %index_value, %choice_count : index
      %value = view.load %values[%choice] : view<178xf32> -> f32
      view.store %value, %inputs[%row, %column] : f32, view<[%rows]x[%columns]xf32>
      %logical = index.madd %row, %columns, %column : index
      %base_index = index.madd %logical, %c13, %c1 : index
      %base_choice = index.rem %base_index, %choice_count : index
      %base_value = view.load %values[%base_choice] : view<178xf32> -> f32
      %base_bits = func.call @reference_bf16_bits(%base_value) : (f32) -> (i16)
      %remainder = index.rem %logical, %c7 : index
      %signed_zero = index.cmp eq, %remainder, %c0 : index
      %sign_payload = scalar.constant -32768 : i16
      %selected = scf.select %signed_zero, %sign_payload, %base_bits : i16
      view.store %selected, %bases[%row, %column] : i16, view<[%rows]x[%columns]xi16, %layout>
    }
  }
  func.return
}

kernel.def target(@projection_rdna3_wave32) @apply_epilogue(%rows: index, %columns: index) {
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.div %columns, %tile : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%rows: index, %columns: index, %row_stride: index, %column_stride: index, %operation: index, %bias_bf16: i1, %input: buffer, %bias: buffer, %strength: buffer, %base: buffer, %wide: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.div %columns, %tile : index
  %last_row = index.sub %row_tiles, %c1 : index
  %last_output = index.sub %output_tiles, %c1 : index
  %grid_row = kernel.workgroup.id<x> : index
  %grid_output = kernel.workgroup.id<y> : index
  %row_tile = index.sub %last_row, %grid_row : index
  %output_tile = index.sub %last_output, %grid_output : index
  %row_begin = index.mul %row_tile, %tile : index
  %column_begin = index.mul %output_tile, %tile : index
  // A reversed traversal still owns one complete, aligned tile per workgroup.
  %max_row = index.sub %rows, %tile : index
  %max_column = index.sub %columns, %tile : index
  %row_origin = index.assume %row_begin [ge(%row_begin, 0), le(%row_begin, %max_row), multiple_of(%row_begin, 16)] : index
  %output_origin = index.assume %column_begin [ge(%column_begin, 0), le(%column_begin, %max_column), multiple_of(%column_begin, 16)] : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  %result = vector.fragment.load<result> %input_view[%row_origin, %output_origin] shape [%tile, %tile] : view<[%rows]x[%columns]xf32> -> vector<8xf32>
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %is_bias = index.cmp eq, %operation, %c1 : index
  %is_adapter = index.cmp eq, %operation, %c2 : index
  %selected = scf.if %is_bias -> (vector<8xf32>) {
    %combined = template.apply<@projection.bias_storage_bf16>(%columns, %output_origin, %bias_bf16, %result, %bias) : (index, index, i1, vector<8xf32>, buffer) -> (vector<8xf32>)
    scf.yield %combined : vector<8xf32>
  } else {
    %combined = scf.if %is_adapter -> (vector<8xf32>) {
      %adapted = template.apply<@projection.adapter_epilogue_bf16>(%rows, %columns, %row_origin, %output_origin, %layout, %result, %strength, %base) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer, buffer) -> (vector<8xf32>)
      scf.yield %adapted : vector<8xf32>
    } else {
      scf.yield %result : vector<8xf32>
    }
    scf.yield %combined : vector<8xf32>
  }
  %wide_origin = index.constant 64 : offset
  %wide_view = buffer.view %wide[%wide_origin] : buffer -> view<[%rows]x[%columns]xf32>
  vector.fragment.store<result> %selected, %wide_view[%row_origin, %output_origin] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%columns]xf32>
  template.apply<@projection.store_bf16>(%rows, %columns, %row_origin, %output_origin, %layout, %selected, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

command.def @epilogue_program(%configuration: index) launch(%input: buffer, %bias: buffer, %strength: buffer, %base: buffer, %wide: buffer, %output: buffer) {
  %rows, %columns, %row_stride, %column_stride, %operation, %bias_bf16, %inplace, %scale = template.apply<@epilogue_shape>(%configuration) : (index) -> (index, index, index, index, index, i1, i1, f32)
  %destination = scf.select %inplace, %base, %output : buffer
  kernel.launch @apply_epilogue[%rows, %columns](%rows, %columns, %row_stride, %column_stride, %operation, %bias_bf16, %input, %bias, %strength, %base, %wide, %destination) : [index, index](index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @epilogue_reference(%input: buffer, %bias: buffer, %strength: buffer, %base: buffer, %wide: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %wide_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c0_i32 = scalar.constant 0 : i32
  %header = buffer.view %wide[%origin] : buffer -> view<7xi32>
  %row_word = view.load %header[0] : view<7xi32> -> i32
  %column_word = view.load %header[1] : view<7xi32> -> i32
  %row_stride_word = view.load %header[2] : view<7xi32> -> i32
  %column_stride_word = view.load %header[3] : view<7xi32> -> i32
  %operation_word = view.load %header[4] : view<7xi32> -> i32
  %bias_word = view.load %header[5] : view<7xi32> -> i32
  %inplace_word = view.load %header[6] : view<7xi32> -> i32
  %rows = index.cast %row_word : i32 to index
  %columns = index.cast %column_word : i32 to index
  %row_stride = index.cast %row_stride_word : i32 to index
  %column_stride = index.cast %column_stride_word : i32 to index
  %operation = index.cast %operation_word : i32 to index
  %bias_bf16 = scalar.cmpi ne, %bias_word, %c0_i32 : i32
  %inplace = scalar.cmpi ne, %inplace_word, %c0_i32 : i32
  %destination = scf.select %inplace, %base, %output : buffer
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %inputs = buffer.view %input[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  %bases = buffer.view %base[%origin] : buffer -> view<[%rows]x[%columns]xi16, %layout>
  %outputs = buffer.view %destination[%origin] : buffer -> view<[%rows]x[%columns]xi16, %layout>
  %wides = buffer.view %wide[%wide_origin] : buffer -> view<[%rows]x[%columns]xf32>
  %strengths = buffer.view %strength[%origin] : buffer -> view<1xf32>
  %scale = view.load %strengths[0] : view<1xf32> -> f32
  %c0_f32 = scalar.constant 0.0 : f32
  %disabled = scalar.cmpf oeq, %scale, %c0_f32 : f32
  %is_bias = index.cmp eq, %operation, %c1 : index
  %is_adapter = index.cmp eq, %operation, %c2 : index
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %column = [%c0 to %columns step %c1] {
      %value = view.load %inputs[%row, %column] : view<[%rows]x[%columns]xf32> -> f32
      %result = scf.if %is_bias -> (f32) {
        %coefficient = scf.if %bias_bf16 -> (f32) {
          %biases = buffer.view %bias[%origin] : buffer -> view<[%columns]xi16>
          %word = view.load %biases[%column] : view<[%columns]xi16> -> i16
          %value = func.call @reference_bf16_value(%word) : (i16) -> (f32)
          scf.yield %value : f32
        } else {
          %biases = buffer.view %bias[%origin] : buffer -> view<[%columns]xf32>
          %stored = view.load %biases[%column] : view<[%columns]xf32> -> f32
          %rounded = func.call @reference_bf16_round(%stored) : (f32) -> (f32)
          scf.yield %rounded : f32
        }
        %sum = scalar.addf %value, %coefficient : f32
        scf.yield %sum : f32
      } else {
        %result = scf.if %is_adapter -> (f32) {
          %base_word = view.load %bases[%row, %column] : view<[%rows]x[%columns]xi16, %layout> -> i16
          %base_value = func.call @reference_bf16_value(%base_word) : (i16) -> (f32)
          %adapted = scf.if %disabled -> (f32) {
            scf.yield %base_value : f32
          } else {
            %delta = func.call @reference_bf16_round(%value) : (f32) -> (f32)
            %product = scalar.mulf %delta, %scale : f32
            %scaled = func.call @reference_bf16_round(%product) : (f32) -> (f32)
            %sum = scalar.addf %base_value, %scaled : f32
            scf.yield %sum : f32
          }
          scf.yield %adapted : f32
        } else {
          scf.yield %value : f32
        }
        scf.yield %result : f32
      }
      %word = func.call @reference_bf16_bits(%result) : (f32) -> (i16)
      view.store %result, %wides[%row, %column] : f32, view<[%rows]x[%columns]xf32>
      view.store %word, %outputs[%row, %column] : i16, view<[%rows]x[%columns]xi16, %layout>
    }
  }
  func.return
}

check.scenario public @projection_epilogues configure[12](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %logical, %physical, %bias_words, %logical_storage, %physical_storage, %bias_storage_count = check.generate<@epilogue_storage>(%configuration) : (index) -> (index, index, index, index, index, index)
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %choices = check.generate.random.uniform seed(%seed) range(-8.0 to 8.0) : tensor<178xf32>
    check.generate<@initialize_epilogue_choices>(%choices) : (tensor<178xf32>) -> ()
    %input_storage = check.generate.fill value(123.25) : tensor<[%logical_storage]xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<[%logical_storage]xf32> -> tensor<[%logical]xf32>
    %bias_storage = check.generate.fill value(17142) : tensor<[%bias_storage_count]xi16>
    %bias = check.tensor.view %bias_storage offset(32) : tensor<[%bias_storage_count]xi16> -> tensor<[%bias_words]xi16>
    %strength_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %strength = check.tensor.view %strength_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %base_storage = check.generate.fill value(17142) : tensor<[%physical_storage]xi16>
    %base = check.tensor.view %base_storage offset(32) : tensor<[%physical_storage]xi16> -> tensor<[%physical]xi16>
    %wide = check.generate.fill value(123.25) : tensor<[%logical_storage]xf32>
    %output_storage = check.generate.fill value(17142) : tensor<[%physical_storage]xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<[%physical_storage]xi16> -> tensor<[%physical]xi16>
    check.generate<@initialize_epilogue>(%configuration, %choices, %input, %bias, %strength, %base, %wide) : (index, tensor<178xf32>, tensor<[%logical]xf32>, tensor<[%bias_words]xi16>, tensor<1xf32>, tensor<[%physical]xi16>, tensor<[%logical_storage]xf32>) -> ()
    check.compare<@epilogue_program, @epilogue_reference>[%configuration](%input, %bias, %strength, %base, %wide, %output) : [index](tensor<[%logical]xf32>, tensor<[%bias_words]xi16>, tensor<1xf32>, tensor<[%physical]xi16>, tensor<[%logical_storage]xf32>, tensor<[%physical]xi16>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<[%logical_storage]xf32>
      check.expect.bitwise actual(%bias_storage) expected(%bias_storage) : tensor<[%bias_storage_count]xi16>
      check.expect.bitwise actual(%strength_storage) expected(%strength_storage) : tensor<33xf32>
      check.expect.bitwise actual(%base_storage) expected(%base_storage) : tensor<[%physical_storage]xi16>
      check.expect.bitwise actual(%wide) expected(%wide) : tensor<[%logical_storage]xf32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<[%physical_storage]xi16>
    }
  }
  check.return
}

check.benchmark<@projection_epilogues> @projection_epilogues_benchmark
