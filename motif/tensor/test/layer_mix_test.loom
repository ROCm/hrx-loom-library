// Twelve-layer mixing preserves ordered F32 fused accumulation and explicit
// BF16 boundaries between projections. The independent VM oracle uses scalar
// loops and integer BF16 rounding, and observes gathered values, the base, and
// the final result. Directed cancellation separates accumulation order and
// precision; tiny inputs expose signed-zero preservation. Inactive adapters
// receive one NaN per factor buffer, so accidental reads cannot hide behind
// a fully allocated rank tensor. Whole allocations retain guards and inputs.

amdgpu.target<gfx11-generic> @layer_mix_wave32 {subgroup_size = 32}

config.def @test.layer_mix.workgroup_size = 32 : %value: index where [range(%value, 32, 256)]

template.decl @projection.gather_12_bf16(%rows: index, %width: index, %row: index, %channel: index, %input: buffer) -> (vector<12xf32>)

template.decl @projection.dot_12_storage_bf16(%outputs: index, %row: index, %weight_is_bf16: i1, %values: vector<12xf32>, %weight: buffer) -> (bf16)

template.decl @projection.layer_mix_12_bf16(%rows: index, %width: index, %rank: index, %row: index, %channel: index, %adapted: i1, %weight_is_bf16: i1, %input: buffer, %weight: buffer, %down: buffer, %up: buffer, %strength: buffer) -> (bf16)

func.decl @reference_bf16_round(%value: f32) -> (f32)

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

template.decl @mix_shape(%configuration: index) -> (index, index, index, i1, f32)

template.def<@mix_shape> @mix_shape_values(%configuration: index) -> (index, index, index, i1, f32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %c16 = scalar.constant 16 : i32
  %c17 = scalar.constant 17 : i32
  %c19 = scalar.constant 19 : i32
  %c31 = scalar.constant 31 : i32
  %c32 = scalar.constant 32 : i32
  %c33 = scalar.constant 33 : i32
  %c65 = scalar.constant 65 : i32
  %c2560 = scalar.constant 2560 : i32
  %row_counts = vector.from_elements %c3, %c2, %c1, %c1, %c2, %c2, %c2, %c2, %c3, %c1, %c1 : vector<11xi32>
  %widths = vector.from_elements %c17, %c65, %c2560, %c3, %c19, %c31, %c33, %c65, %c17, %c17, %c17 : vector<11xi32>
  %ranks = vector.from_elements %c0, %c0, %c0, %c0, %c1, %c7, %c16, %c32, %c33, %c32, %c32 : vector<11xi32>
  %storage_types = vector.from_elements %c1, %c0, %c0, %c1, %c0, %c1, %c0, %c0, %c1, %c0, %c1 : vector<11xi32>
  %row_word = vector.extract %row_counts[%configuration] : vector<11xi32> -> i32
  %width_word = vector.extract %widths[%configuration] : vector<11xi32> -> i32
  %rank_word = vector.extract %ranks[%configuration] : vector<11xi32> -> i32
  %storage_type = vector.extract %storage_types[%configuration] : vector<11xi32> -> i32
  %rows = index.cast %row_word : i32 to index
  %width = index.cast %width_word : i32 to index
  %rank = index.cast %rank_word : i32 to index
  %weight_bf16 = scalar.cmpi ne, %storage_type, %c0 : i32
  %nan_bits = scalar.constant 2143289344 : i32
  %inactive = scalar.bitcast %nan_bits : i32 to f32
  %positive = scalar.constant 1.25 : f32
  %negative = scalar.constant -0.625 : f32
  %half = scalar.constant 0.5 : f32
  %midpoint = scalar.constant 1.00390625 : f32
  %c0_f32 = scalar.constant 0.0 : f32
  %sign_payload = scalar.constant -0.0 : f32
  %strengths = vector.from_elements %inactive, %inactive, %inactive, %inactive, %positive, %negative, %half, %midpoint, %positive, %c0_f32, %sign_payload : vector<11xf32>
  %strength = vector.extract %strengths[%configuration] : vector<11xf32> -> f32
  template.return %rows, %width, %rank, %weight_bf16, %strength : index, index, index, i1, f32
}

func.def @mix_storage(%configuration: index) -> (index, index, index, index, index, index, index, index, index, index, index) {
  %rows, %width, %rank, %weight_bf16, %strength = template.apply<@mix_shape>(%configuration) : (index) -> (index, index, index, i1, f32)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %layers = index.constant 12 : index
  %f32_weight_words = index.constant 24 : index
  %guards = index.constant 32 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %adapted = index.cmp ugt, %rank, %c0 : index
  %nonzero = scalar.cmpf one, %strength, %c0_f32 : f32
  %active = scalar.andi %adapted, %nonzero : i1
  %output_count = index.mul %rows, %width : index
  %input_count = index.mul %output_count, %layers : index
  %weight_words = scf.select %weight_bf16, %layers, %f32_weight_words : index
  %full_down_count = index.mul %rank, %layers : index
  %down_count = scf.select %active, %full_down_count, %c1 : index
  %up_count = scf.select %active, %rank, %c1 : index
  %input_and_weight = index.add %input_count, %layers : index
  %with_down = index.add %input_and_weight, %down_count : index
  %random_count = index.add %with_down, %up_count : index
  %input_storage = index.add %input_count, %guards : index
  %output_storage = index.add %output_count, %guards : index
  %weight_storage = index.add %weight_words, %guards : index
  %down_storage = index.add %down_count, %guards : index
  %up_storage = index.add %up_count, %guards : index
  func.return %input_count, %output_count, %weight_words, %down_count, %up_count, %random_count, %input_storage, %output_storage, %weight_storage, %down_storage, %up_storage : index, index, index, index, index, index, index, index, index, index, index
}

func.def @initialize_mix(%configuration: index, %random: buffer, %input: buffer, %weight: buffer, %down: buffer, %up: buffer, %strength: buffer, %gathered: buffer) {
  %rows, %width, %rank, %weight_bf16, %scale = template.apply<@mix_shape>(%configuration) : (index) -> (index, index, index, i1, f32)
  %input_count, %output_count, %weight_words, %down_count, %up_count, %random_count, %input_storage, %output_storage, %weight_storage, %down_storage, %up_storage = func.call @mix_storage(%configuration) : (index) -> (index, index, index, index, index, index, index, index, index, index, index)
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c9 = index.constant 9 : index
  %layers = index.constant 12 : index
  %ordered = index.cmp eq, %configuration, %c3 : index
  %tiny = index.cmp uge, %configuration, %c9 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %unit = scalar.constant 1.0 : f32
  %negative_sign = scalar.constant -1.0 : f32
  %half = scalar.constant 0.5 : f32
  %quarter = scalar.constant 0.25 : f32
  %large = scalar.constant 16777216.0 : f32
  %negative_large = scalar.constant -16777216.0 : f32
  %increment = scalar.constant 0.001953125 : f32
  // The recipe concatenates input, weight, down, and up random spans.
  // Each loop below stays within its span of that allocation.
  %randoms = buffer.view %random[%origin] : buffer -> view<[%random_count]xf32>
  %inputs = buffer.view %input[%origin] : buffer -> view<[%rows]x12x[%width]xi16>
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %layer = [%c0 to %layers step %c1] {
      scf.for %channel = [%c0 to %width step %c1] {
        %value = scf.if %ordered -> (f32) {
          // Opposite cancellation orders surround a channel whose small terms
          // accumulate in F32 but disappear under premature BF16 rounding.
          %first_layer = index.cmp eq, %layer, %c0 : index
          %second_layer = index.cmp eq, %layer, %c1 : index
          %third_layer = index.cmp eq, %layer, %c2 : index
          %first_column = index.cmp eq, %channel, %c0 : index
          %middle_column = index.cmp eq, %channel, %c1 : index
          %leading = scf.select %first_column, %large, %negative_large : f32
          %trailing = scf.select %first_column, %negative_large, %large : f32
          %middle = scf.select %first_column, %unit, %negative_sign : f32
          %tail = scf.select %third_layer, %trailing, %c0_f32 : f32
          %after_leading = scf.select %second_layer, %middle, %tail : f32
          %cancellation = scf.select %first_layer, %leading, %after_leading : f32
          %accumulation = scf.select %first_layer, %unit, %increment : f32
          %value = scf.select %middle_column, %accumulation, %cancellation : f32
          scf.yield %value : f32
        } else {
          %value = scf.if %tiny -> (f32) {
            %negative_small = scalar.constant -32767 : i16
            %positive_small = scalar.constant 1 : i16
            %negative_larger = scalar.constant -32764 : i16
            %positive_larger = scalar.constant 4 : i16
            %words = vector.from_elements %negative_small, %positive_small, %negative_larger, %positive_larger : vector<4xi16>
            %ordinal = index.rem %channel, %c4 : index
            %word = vector.extract %words[%ordinal] : vector<4xi16> -> i16
            %small = func.call @reference_bf16_value(%word) : (i16) -> (f32)
            %first_layer = index.cmp eq, %layer, %c0 : index
            %value = scf.select %first_layer, %small, %c0_f32 : f32
            scf.yield %value : f32
          } else {
            %row_layer = index.madd %row, %layers, %layer : index
            %position = index.madd %row_layer, %width, %channel : index
            %random_position = index.assume %position [ge(%position, 0), lt(%position, %random_count)] : index
            %value = view.load %randoms[%random_position] : view<[%random_count]xf32> -> f32
            scf.yield %value : f32
          }
          scf.yield %value : f32
        }
        %word = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
        view.store %word, %inputs[%row, %layer, %channel] : i16, view<[%rows]x12x[%width]xi16>
      }
    }
  }
  %tie_lower = scalar.constant 1.00390625 : f32
  %tie_upper = scalar.constant 1.01171875 : f32
  %negative_lower = scalar.constant -1.00390625 : f32
  %negative_upper = scalar.constant -1.01171875 : f32
  %ties = vector.from_elements %tie_lower, %tie_upper, %negative_lower, %negative_upper : vector<4xf32>
  scf.for %layer = [%c0 to %layers step %c1] {
    %first_layer = index.cmp eq, %layer, %c0 : index
    %tiny_weight = scf.select %first_layer, %quarter, %c0_f32 : f32
    %special = scalar.ori %ordered, %tiny : i1
    %coefficient = scf.if %special -> (f32) {
      %value = scf.select %ordered, %unit, %tiny_weight : f32
      scf.yield %value : f32
    } else {
      %directed = index.cmp ult, %layer, %c4 : index
      %value = scf.if %directed -> (f32) {
        %value = vector.extract %ties[%layer] : vector<4xf32> -> f32
        scf.yield %value : f32
      } else {
        %position = index.add %input_count, %layer : index
        %random_position = index.assume %position [ge(%position, 0), lt(%position, %random_count)] : index
        %random_value = view.load %randoms[%random_position] : view<[%random_count]xf32> -> f32
        %value = scalar.mulf %random_value, %half : f32
        scf.yield %value : f32
      }
      scf.yield %value : f32
    }
    scf.if %weight_bf16 {
      %weights = buffer.view %weight[%origin] : buffer -> view<12xi16>
      %word = func.call @reference_bf16_bits(%coefficient) : (f32) -> (i16)
      view.store %word, %weights[%layer] : i16, view<12xi16>
    } else {
      %weights = buffer.view %weight[%origin] : buffer -> view<12xf32>
      view.store %coefficient, %weights[%layer] : f32, view<12xf32>
    }
  }
  %adapted = index.cmp ugt, %rank, %c0 : index
  %nonzero = scalar.cmpf one, %scale, %c0_f32 : f32
  %active = scalar.andi %adapted, %nonzero : i1
  %nan_bits = scalar.constant 2143289344 : i32
  %inactive = scalar.bitcast %nan_bits : i32 to f32
  %downs = buffer.view %down[%origin] : buffer -> view<[%down_count]xf32>
  %ups = buffer.view %up[%origin] : buffer -> view<[%up_count]xf32>
  %down_begin = index.add %input_count, %layers : index
  %up_begin = index.add %down_begin, %down_count : index
  scf.for %element = [%c0 to %down_count step %c1] {
    %position = index.add %down_begin, %element : index
    %random_position = index.assume %position [ge(%position, 0), lt(%position, %random_count)] : index
    %random_value = view.load %randoms[%random_position] : view<[%random_count]xf32> -> f32
    %coefficient = scalar.mulf %random_value, %half : f32
    %selected = scf.select %active, %coefficient, %inactive : f32
    view.store %selected, %downs[%element] : f32, view<[%down_count]xf32>
  }
  scf.for %element = [%c0 to %up_count step %c1] {
    %position = index.add %up_begin, %element : index
    %random_position = index.assume %position [ge(%position, 0), lt(%position, %random_count)] : index
    %random_value = view.load %randoms[%random_position] : view<[%random_count]xf32> -> f32
    %coefficient = scalar.mulf %random_value, %half : f32
    %selected = scf.select %active, %coefficient, %inactive : f32
    view.store %selected, %ups[%element] : f32, view<[%up_count]xf32>
  }
  %strengths = buffer.view %strength[%origin] : buffer -> view<1xf32>
  view.store %scale, %strengths[0] : f32, view<1xf32>
  // The gathered-output prefix carries immutable scalar inputs for the oracle.
  %header = buffer.view %gathered[%origin] : buffer -> view<4xi32>
  %row_word = index.cast %rows : index to i32
  %width_word = index.cast %width : index to i32
  %rank_word = index.cast %rank : index to i32
  %weight_word = scalar.extui %weight_bf16 : i1 to i32
  view.store %row_word, %header[0] : i32, view<4xi32>
  view.store %width_word, %header[1] : i32, view<4xi32>
  view.store %rank_word, %header[2] : i32, view<4xi32>
  view.store %weight_word, %header[3] : i32, view<4xi32>
  func.return
}

kernel.def target(@layer_mix_wave32) @apply_mix(%rows: index, %width: index) {
  %threads = config.get @test.layer_mix.workgroup_size : index
  %unit = index.constant 1 : index
  %padded = index.add %width, %threads : index
  %numerator = index.sub %padded, %unit : index
  %groups = index.div %numerator, %threads : index
  kernel.launch.config workgroups(%rows, %groups, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%rows: index, %width: index, %rank: index, %weight_bf16: i1, %input: buffer, %weight: buffer, %down: buffer, %up: buffer, %strength: buffer, %gathered: buffer, %base: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %gathered_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %layers = index.constant 12 : index
  %threads = config.get @test.layer_mix.workgroup_size : index
  %row_id = kernel.workgroup.id<x> : index
  %row = index.assume %row_id [ge(%row_id, 0), lt(%row_id, %rows)] : index
  %group = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %channel_id = index.madd %group, %threads, %lane : index
  %valid = index.cmp ult, %channel_id, %width : index
  scf.if %valid {
    %channel = index.assume %channel_id [ge(%channel_id, 0), lt(%channel_id, %width)] : index
    %adapted = index.cmp ugt, %rank, %c0 : index
    %values = template.apply<@projection.gather_12_bf16>(%rows, %width, %row, %channel, %input) : (index, index, index, index, buffer) -> (vector<12xf32>)
    %base_value = template.apply<@projection.dot_12_storage_bf16>(%c1, %c0, %weight_bf16, %values, %weight) : (index, index, i1, vector<12xf32>, buffer) -> (bf16)
    %result = template.apply<@projection.layer_mix_12_bf16>(%rows, %width, %rank, %row, %channel, %adapted, %weight_bf16, %input, %weight, %down, %up, %strength) : (index, index, index, index, index, i1, i1, buffer, buffer, buffer, buffer, buffer) -> (bf16)
    %gathers = buffer.view %gathered[%gathered_origin] : buffer -> view<[%rows]x[%width]x12xf32>
    scf.for %layer = [%c0 to %layers step %c1] unroll {
      %value = vector.extract %values[%layer] : vector<12xf32> -> f32
      view.store %value, %gathers[%row, %channel, %layer] : f32, view<[%rows]x[%width]x12xf32>
    }
    %bases = buffer.view %base[%origin] : buffer -> view<[%rows]x[%width]xbf16>
    %outputs = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
    view.store %base_value, %bases[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
    view.store %result, %outputs[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
  }
  kernel.return
}

command.program.def @mix_program(%configuration: index) launch(%input: buffer, %weight: buffer, %down: buffer, %up: buffer, %strength: buffer, %gathered: buffer, %base: buffer, %output: buffer) {
  %rows, %width, %rank, %weight_bf16, %scale = template.apply<@mix_shape>(%configuration) : (index) -> (index, index, index, i1, f32)
  kernel.launch @apply_mix[%rows, %width](%rows, %width, %rank, %weight_bf16, %input, %weight, %down, %up, %strength, %gathered, %base, %output) : [index, index](index, index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @mix_reference(%input: buffer, %weight: buffer, %down: buffer, %up: buffer, %strength: buffer, %gathered: buffer, %base: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %gathered_origin = index.constant 64 : offset
  %header = buffer.view %gathered[%origin] : buffer -> view<4xi32>
  %row_word = view.load %header[0] : view<4xi32> -> i32
  %width_word = view.load %header[1] : view<4xi32> -> i32
  %rank_word = view.load %header[2] : view<4xi32> -> i32
  %weight_word = view.load %header[3] : view<4xi32> -> i32
  %rows = index.cast %row_word : i32 to index
  %width = index.cast %width_word : i32 to index
  %rank = index.cast %rank_word : i32 to index
  %c0_i32 = scalar.constant 0 : i32
  %weight_bf16 = scalar.cmpi ne, %weight_word, %c0_i32 : i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %layers = index.constant 12 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%rows]x12x[%width]xi16>
  %gathers = buffer.view %gathered[%gathered_origin] : buffer -> view<[%rows]x[%width]x12xf32>
  %bases = buffer.view %base[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xi16>
  %adapted = index.cmp ugt, %rank, %c0 : index
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %channel = [%c0 to %width step %c1] {
      %base_sum = scf.for %layer = [%c0 to %layers step %c1](%accumulator = %c0_f32 : f32) -> (f32) {
        %word = view.load %inputs[%row, %layer, %channel] : view<[%rows]x12x[%width]xi16> -> i16
        %value = func.call @reference_bf16_value(%word) : (i16) -> (f32)
        view.store %value, %gathers[%row, %channel, %layer] : f32, view<[%rows]x[%width]x12xf32>
        %coefficient = scf.if %weight_bf16 -> (f32) {
          %weights = buffer.view %weight[%origin] : buffer -> view<12xi16>
          %word = view.load %weights[%layer] : view<12xi16> -> i16
          %value = func.call @reference_bf16_value(%word) : (i16) -> (f32)
          scf.yield %value : f32
        } else {
          %weights = buffer.view %weight[%origin] : buffer -> view<12xf32>
          %stored = view.load %weights[%layer] : view<12xf32> -> f32
          %rounded = func.call @reference_bf16_round(%stored) : (f32) -> (f32)
          scf.yield %rounded : f32
        }
        %next = scalar.fmaf %value, %coefficient, %accumulator : f32
        scf.yield %next : f32
      }
      %base_value = func.call @reference_bf16_round(%base_sum) : (f32) -> (f32)
      %result = scf.if %adapted -> (f32) {
        %strengths = buffer.view %strength[%origin] : buffer -> view<1xf32>
        %scale = view.load %strengths[0] : view<1xf32> -> f32
        %disabled = scalar.cmpf oeq, %scale, %c0_f32 : f32
        %result = scf.if %disabled -> (f32) {
          scf.yield %base_value : f32
        } else {
          %downs = buffer.view %down[%origin] : buffer -> view<[%rank]x12xf32>
          %ups = buffer.view %up[%origin] : buffer -> view<[%rank]xf32>
          %sum = scf.for %element = [%c0 to %rank step %c1](%accumulator = %c0_f32 : f32) -> (f32) {
            %low_sum = scf.for %layer = [%c0 to %layers step %c1](%partial = %c0_f32 : f32) -> (f32) {
              %value = view.load %gathers[%row, %channel, %layer] : view<[%rows]x[%width]x12xf32> -> f32
              %stored = view.load %downs[%element, %layer] : view<[%rank]x12xf32> -> f32
              %coefficient = func.call @reference_bf16_round(%stored) : (f32) -> (f32)
              %next = scalar.fmaf %value, %coefficient, %partial : f32
              scf.yield %next : f32
            }
            %low = func.call @reference_bf16_round(%low_sum) : (f32) -> (f32)
            %stored = view.load %ups[%element] : view<[%rank]xf32> -> f32
            %coefficient = func.call @reference_bf16_round(%stored) : (f32) -> (f32)
            %next = scalar.fmaf %low, %coefficient, %accumulator : f32
            scf.yield %next : f32
          }
          %delta = func.call @reference_bf16_round(%sum) : (f32) -> (f32)
          %product = scalar.mulf %delta, %scale : f32
          %scaled = func.call @reference_bf16_round(%product) : (f32) -> (f32)
          %total = scalar.addf %base_value, %scaled : f32
          scf.yield %total : f32
        }
        scf.yield %result : f32
      } else {
        scf.yield %base_value : f32
      }
      %base_bits = func.call @reference_bf16_bits(%base_value) : (f32) -> (i16)
      %result_bits = func.call @reference_bf16_bits(%result) : (f32) -> (i16)
      view.store %base_bits, %bases[%row, %channel] : i16, view<[%rows]x[%width]xi16>
      view.store %result_bits, %outputs[%row, %channel] : i16, view<[%rows]x[%width]xi16>
    }
  }
  func.return
}

check.scenario public @layer_mixing configure[11](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_count, %output_count, %weight_words, %down_count, %up_count, %random_count, %input_storage_count, %output_storage_count, %weight_storage_count, %down_storage_count, %up_storage_count = check.generate<@mix_storage>(%configuration) : (index) -> (index, index, index, index, index, index, index, index, index, index, index)
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %random = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<[%random_count]xf32>
    %input_storage = check.generate.fill value(17142) : tensor<[%input_storage_count]xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<[%input_storage_count]xi16> -> tensor<[%input_count]xi16>
    %weight_storage = check.generate.fill value(17142) : tensor<[%weight_storage_count]xi16>
    %weight = check.tensor.view %weight_storage offset(32) : tensor<[%weight_storage_count]xi16> -> tensor<[%weight_words]xi16>
    %down_storage = check.generate.fill value(123.25) : tensor<[%down_storage_count]xf32>
    %down = check.tensor.view %down_storage offset(64) : tensor<[%down_storage_count]xf32> -> tensor<[%down_count]xf32>
    %up_storage = check.generate.fill value(123.25) : tensor<[%up_storage_count]xf32>
    %up = check.tensor.view %up_storage offset(64) : tensor<[%up_storage_count]xf32> -> tensor<[%up_count]xf32>
    %strength_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %strength = check.tensor.view %strength_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %gathered = check.generate.fill value(123.25) : tensor<[%input_storage_count]xf32>
    %base_storage = check.generate.fill value(17142) : tensor<[%output_storage_count]xi16>
    %base = check.tensor.view %base_storage offset(32) : tensor<[%output_storage_count]xi16> -> tensor<[%output_count]xi16>
    %output_storage = check.generate.fill value(17142) : tensor<[%output_storage_count]xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<[%output_storage_count]xi16> -> tensor<[%output_count]xi16>
    check.generate<@initialize_mix>(%configuration, %random, %input, %weight, %down, %up, %strength, %gathered) : (index, tensor<[%random_count]xf32>, tensor<[%input_count]xi16>, tensor<[%weight_words]xi16>, tensor<[%down_count]xf32>, tensor<[%up_count]xf32>, tensor<1xf32>, tensor<[%input_storage_count]xf32>) -> ()
    check.compare<@mix_program, @mix_reference>[%configuration](%input, %weight, %down, %up, %strength, %gathered, %base, %output) : [index](tensor<[%input_count]xi16>, tensor<[%weight_words]xi16>, tensor<[%down_count]xf32>, tensor<[%up_count]xf32>, tensor<1xf32>, tensor<[%input_storage_count]xf32>, tensor<[%output_count]xi16>, tensor<[%output_count]xi16>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<[%input_storage_count]xi16>
      check.expect.bitwise actual(%weight_storage) expected(%weight_storage) : tensor<[%weight_storage_count]xi16>
      check.expect.bitwise actual(%down_storage) expected(%down_storage) : tensor<[%down_storage_count]xf32>
      check.expect.bitwise actual(%up_storage) expected(%up_storage) : tensor<[%up_storage_count]xf32>
      check.expect.bitwise actual(%strength_storage) expected(%strength_storage) : tensor<33xf32>
      check.expect.bitwise actual(%gathered) expected(%gathered) : tensor<[%input_storage_count]xf32>
      check.expect.bitwise actual(%base_storage) expected(%base_storage) : tensor<[%output_storage_count]xi16>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<[%output_storage_count]xi16>
    }
  }
  check.return
}

check.benchmark<@layer_mixing> @layer_mixing_benchmark
