// Attention stores scatter fragments into a contiguous BF16 tensor.
// Ungated conversion checks midpoint rounding with an integer-bit oracle;
// gated observations independently round context and sigmoid before the product.

amdgpu.target<gfx11-generic> @tensor_shared_attention_rdna3

amdgpu.target<gfx11-generic> @shared_attention_wave32 {subgroup_size = 32}

template.decl @attention.shared_four_head_store(%tokens: index, %query_width: index, %query_origin: index, %column: index, %values: vector<8xf32>, %gated: i1, %gate: buffer, %output: buffer)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @initialize_attention_gates(%gate: buffer)

func.decl @reference_attention_gate(%context: f64, %gate: f64) -> (bf16)

// Retain both neighbors and the exact midpoint for alternating signs and
// significand parity. Scenario entropy supplies the rest of the input.
func.def @initialize_store(%input: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c64 = index.constant 64 : index
  %boundary_count = index.constant 384 : index
  %c1_i32 = scalar.constant 1 : i32
  %positive = scalar.constant 1.0 : f32
  %negative = scalar.constant -1.0 : f32
  %spacing = scalar.constant 0.00390625 : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<1536xf32>
  scf.for %index = [%c2 to %boundary_count step %c1] {
    %mantissa = index.rem %index, %c64 : index
    %odd = index.madd %mantissa, %c2, %c1 : index
    %integer = index.cast %odd : index to i32
    %fraction = scalar.uitofp %integer : i32 to f32
    %part = scalar.mulf %fraction, %spacing : f32
    %magnitude = scalar.addf %positive, %part : f32
    %parity = index.rem %index, %c2 : index
    %even = index.cmp eq, %parity, %c0 : index
    %sign = scf.select %even, %positive, %negative : f32
    %midpoint = scalar.mulf %sign, %magnitude : f32
    %bits = scalar.bitcast %midpoint : f32 to i32
    %neighbor = index.rem %index, %c3 : index
    %ordinal = index.cast %neighbor : index to i32
    %displacement = scalar.subi %ordinal, %c1_i32 : i32
    %adjusted = scalar.addi %bits, %displacement : i32
    %value = scalar.bitcast %adjusted : i32 to f32
    view.store %value, %inputs[%index] : f32, view<1536xf32>
  }
  %c0_f32 = scalar.constant 0.0 : f32
  %sign_bit = scalar.constant -2147483648 : i32
  %negative_zero = scalar.bitcast %sign_bit : i32 to f32
  view.store %c0_f32, %inputs[0] : f32, view<1536xf32>
  view.store %negative_zero, %inputs[1] : f32, view<1536xf32>
  func.return
}

kernel.def target(@shared_attention_wave32) @apply_store() {
  %row_groups = index.constant 2 : index
  %column_groups = index.constant 3 : index
  %threads = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%row_groups, %column_groups, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%gated: i1, %input: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %rows = index.constant 32 : index
  %columns = index.constant 48 : index
  %tile = index.constant 16 : index
  %row_group = kernel.workgroup.id<x> : index
  %column_group = kernel.workgroup.id<y> : index
  %row = index.mul %row_group, %tile : index
  %column = index.mul %column_group, %tile : index
  %input_view = buffer.view %input[%origin] : buffer -> view<32x48xf32>
  %values = vector.fragment.load<result> %input_view[%row, %column] shape [%tile, %tile] : view<32x48xf32> -> vector<8xf32>
  %gate_buffer = scf.if %gated -> (buffer) {
    scf.yield %gate : buffer
  } else {
    scf.yield %output : buffer
  }
  template.apply<@attention.shared_four_head_store>(%rows, %columns, %row, %column, %values, %gated, %gate_buffer, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  kernel.return
}

command.def @store_program(%gated: i1) launch(%input: buffer, %gate: buffer, %output: buffer) {
  kernel.launch @apply_store(%gated, %input, %gate, %output) : (i1, buffer, buffer, buffer)
  command.return
}

// The oracle sees a contiguous tensor, independently of the fragment layout
// and lane scatter. Integer rounding also keeps it independent of BF16 casts.
func.def @reference_ungated(%input: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 1536 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<1536xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<1536xi16>
  scf.for %index = [%c0 to %count step %c1] {
    %value = view.load %inputs[%index] : view<1536xf32> -> f32
    %word = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
    view.store %word, %outputs[%index] : i16, view<1536xi16>
  }
  func.return
}

check.scenario public @ungated {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %gated = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-8.0 to 8.0) : tensor<1568xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<1568xf32> -> tensor<1536xf32>
    %gate_storage = check.generate.fill value(123.0) : tensor<1568xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<1568xbf16> -> tensor<1536xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<1568xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<1568xbf16> -> tensor<1536xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<1568xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(3104) : tensor<1568xbf16> -> tensor<16xbf16>
    check.generate<@initialize_store>(%input) : (tensor<1536xf32>) -> ()
    check.compare<@store_program, @reference_ungated>[%gated](%input, %gate, %output) : [i1](tensor<1536xf32>, tensor<1536xbf16>, tensor<1536xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1536xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1568xf32>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<1568xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@ungated> @ungated_benchmark

func.def @reference_gated(%input: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 1536 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<1536xf32>
  %gates = buffer.view %gate[%origin] : buffer -> view<1536xbf16>
  %outputs = buffer.view %output[%origin] : buffer -> view<1536xbf16>
  scf.for %i = [%c0 to %count step %c1] {
    %context = view.load %inputs[%i] : view<1536xf32> -> f32
    %gate_value = view.load %gates[%i] : view<1536xbf16> -> bf16
    %wide_context = scalar.extf %context : f32 to f64
    %wide_gate = scalar.extf %gate_value : bf16 to f64
    %result = func.call @reference_attention_gate(%wide_context, %wide_gate) : (f64, f64) -> (bf16)
    view.store %result, %outputs[%i] : bf16, view<1536xbf16>
  }
  func.return
}

check.scenario public @gated {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %gated = check.literal value(true) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-8.0 to 8.0) : tensor<1568xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<1568xf32> -> tensor<1536xf32>
    %gate_storage = check.generate.fill value(123.0) : tensor<1568xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<1568xbf16> -> tensor<1536xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<1568xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<1568xbf16> -> tensor<1536xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<1568xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(3104) : tensor<1568xbf16> -> tensor<16xbf16>
    check.generate<@initialize_store>(%input) : (tensor<1536xf32>) -> ()
    check.generate<@initialize_attention_gates>(%gate) : (tensor<1536xbf16>) -> ()
    check.compare<@store_program, @reference_gated>[%gated](%input, %gate, %output) : [i1](tensor<1536xf32>, tensor<1536xbf16>, tensor<1536xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1536xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1568xf32>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<1568xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@gated> @gated_benchmark
