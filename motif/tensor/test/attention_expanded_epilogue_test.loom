// Attention epilogues scatter packed BF16 pairs into a contiguous tensor.
// The ungated oracle copies that tensor without reproducing the lane layout;
// signed zeros, nonzero buffer origins, and guards check exact storage behavior.
// Gated observations separately round sigmoid before the final BF16 product.

amdgpu.target<gfx11-generic> @tensor_expanded_attention_rdna3

amdgpu.target<gfx11-generic> @expanded_attention_wave64 {subgroup_size = 64}

template.decl @attention.expanded_masked_gqa_128_bf16(%tokens: index, %query_heads: index, %key_value_heads: index, %causal: i1, %value_layout: encoding<layout>, %query: buffer, %key: buffer, %value: buffer, %mask: buffer) -> (vector<8xbf16>)

template.decl @attention.store_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %output: buffer)

template.decl @attention.gate_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %gate: buffer) -> (vector<8xbf16>)

func.decl @initialize_attention_gates(%gate: buffer)

func.decl @reference_attention_gate(%context: f64, %gate: f64) -> (bf16)

// Preserve signed-zero coverage alongside the scenario's random BF16 values.
func.def @initialize_store(%input: buffer) {
  %origin = index.constant 0 : offset
  %c0_i16 = scalar.constant 0 : i16
  %sign_bit = scalar.constant -32768 : i16
  %inputs = buffer.view %input[%origin] : buffer -> view<12288xi16>
  view.store %c0_i16, %inputs[0] : i16, view<12288xi16>
  view.store %sign_bit, %inputs[1] : i16, view<12288xi16>
  func.return
}

kernel.def target(@expanded_attention_wave64) @apply_store() {
  %groups = index.constant 2 : index
  %heads = index.constant 3 : index
  %threads = index.constant 256 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%gated: i1, %input: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %tokens = index.constant 32 : index
  %heads = index.constant 3 : index
  %tile = index.constant 16 : index
  %rows = index.constant 4 : index
  %pair = index.constant 2 : index
  %head_width = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %tile_origin = index.mul %group, %tile : index
  %row = index.madd %wave, %rows, %tile_origin : index
  %head_origin = index.mul %head, %head_width : index
  %column = index.madd %lane, %pair, %head_origin : index
  %input_view = buffer.view %input[%origin] : buffer -> view<32x384xbf16>
  %offset0 = index.constant 0 : index
  %row0 = index.add %row, %offset0 : index
  %pair0 = vector.load %input_view[%row0, %column] : view<32x384xbf16> -> vector<2xbf16>
  %offset1 = index.constant 1 : index
  %row1 = index.add %row, %offset1 : index
  %pair1 = vector.load %input_view[%row1, %column] : view<32x384xbf16> -> vector<2xbf16>
  %offset2 = index.constant 2 : index
  %row2 = index.add %row, %offset2 : index
  %pair2 = vector.load %input_view[%row2, %column] : view<32x384xbf16> -> vector<2xbf16>
  %offset3 = index.constant 3 : index
  %row3 = index.add %row, %offset3 : index
  %pair3 = vector.load %input_view[%row3, %column] : view<32x384xbf16> -> vector<2xbf16>
  %values = vector.concat<0> %pair0, %pair1, %pair2, %pair3 : vector<2xbf16>, vector<2xbf16>, vector<2xbf16>, vector<2xbf16> -> vector<8xbf16>
  %result = scf.if %gated -> (vector<8xbf16>) {
    %result = template.apply<@attention.gate_128_bf16>(%tokens, %heads, %values, %gate) : (index, index, vector<8xbf16>, buffer) -> (vector<8xbf16>)
    scf.yield %result : vector<8xbf16>
  } else {
    scf.yield %values : vector<8xbf16>
  }
  template.apply<@attention.store_128_bf16>(%tokens, %heads, %result, %output) : (index, index, vector<8xbf16>, buffer)
  kernel.return
}

command.def @store_program(%gated: i1) launch(%input: buffer, %gate: buffer, %output: buffer) {
  kernel.launch @apply_store(%gated, %input, %gate, %output) : (i1, buffer, buffer, buffer)
  command.return
}

func.def @reference_ungated(%input: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24576 : offset
  buffer.copy %input[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @ungated {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %gated = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-8.0 to 8.0) : tensor<12320xbf16>
    %input = check.tensor.view %input_storage offset(32) : tensor<12320xbf16> -> tensor<12288xbf16>
    %gate_storage = check.generate.fill value(123.0) : tensor<12320xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<12320xbf16> -> tensor<12288xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<12320xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<12320xbf16> -> tensor<12288xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<12320xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(24608) : tensor<12320xbf16> -> tensor<16xbf16>
    check.generate<@initialize_store>(%input) : (tensor<12288xbf16>) -> ()
    check.compare<@store_program, @reference_ungated>[%gated](%input, %gate, %output) : [i1](tensor<12288xbf16>, tensor<12288xbf16>, tensor<12288xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12288xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<12320xbf16>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<12320xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@ungated> @ungated_benchmark

func.def @reference_gated(%input: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 12288 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<12288xbf16>
  %gates = buffer.view %gate[%origin] : buffer -> view<12288xbf16>
  %outputs = buffer.view %output[%origin] : buffer -> view<12288xbf16>
  scf.for %i = [%c0 to %count step %c1] {
    %context = view.load %inputs[%i] : view<12288xbf16> -> bf16
    %gate_value = view.load %gates[%i] : view<12288xbf16> -> bf16
    %wide_context = scalar.extf %context : bf16 to f64
    %wide_gate = scalar.extf %gate_value : bf16 to f64
    %result = func.call @reference_attention_gate(%wide_context, %wide_gate) : (f64, f64) -> (bf16)
    view.store %result, %outputs[%i] : bf16, view<12288xbf16>
  }
  func.return
}

check.scenario public @gated {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %gated = check.literal value(true) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-8.0 to 8.0) : tensor<12320xbf16>
    %input = check.tensor.view %input_storage offset(32) : tensor<12320xbf16> -> tensor<12288xbf16>
    %gate_storage = check.generate.fill value(123.0) : tensor<12320xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<12320xbf16> -> tensor<12288xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<12320xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<12320xbf16> -> tensor<12288xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<12320xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(24608) : tensor<12320xbf16> -> tensor<16xbf16>
    check.generate<@initialize_store>(%input) : (tensor<12288xbf16>) -> ()
    check.generate<@initialize_attention_gates>(%gate) : (tensor<12288xbf16>) -> ()
    check.compare<@store_program, @reference_gated>[%gated](%input, %gate, %output) : [i1](tensor<12288xbf16>, tensor<12288xbf16>, tensor<12288xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12288xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<12320xbf16>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<12320xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@gated> @gated_benchmark
