  %tile = index.constant 16 : index
  %last_row = index.constant 1 : index
  %last_output = index.constant 2 : index
  %grid_row = kernel.workgroup.id<x> : index
  %grid_output = kernel.workgroup.id<y> : index
  %row_tile = index.sub %last_row, %grid_row : index
  %output_tile = index.sub %last_output, %grid_output : index
  %row_origin = index.mul %row_tile, %tile : index
  %output_origin = index.mul %output_tile, %tile : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  %result = vector.fragment.load<result> %input_view[%row_origin, %output_origin] shape [%tile, %tile] : view<[%rows]x[%columns]xf32> -> vector<8xf32>
  %row_stride = index.constant 1 : index
  %column_stride = index.constant 32 : index
  %layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %combined = template.apply<@projection.adapter_epilogue_bf16>(%rows, %columns, %row_origin, %output_origin, %layout, %result, %strength, %base) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer, buffer) -> (vector<8xf32>)
  %wide_view = buffer.view %wide[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  vector.fragment.store<result> %combined, %wide_view[%row_origin, %output_origin] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%columns]xf32>
  template.apply<@projection.store_bf16>(%rows, %columns, %row_origin, %output_origin, %layout, %combined, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

func.def @reference_adapter_negative_zero(%input: buffer, %bias: buffer, %strength: buffer, %base: buffer, %wide: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %wide_bytes = index.constant 6144 : offset
  %output_bytes = index.constant 3072 : offset
  %wide_values = global.load @adapter_negative_zero_wide : buffer
  %output_values = global.load @adapter_negative_zero_expected : buffer
  buffer.copy %wide_values[%origin], %wide[%origin], %wide_bytes
  buffer.copy %output_values[%origin], %output[%origin], %output_bytes
  func.return
}

check.scenario public @adapter_negative_zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(123.25) : tensor<1568xf32>
    %input = check.tensor.view %input_storage offset(64) : tensor<1568xf32> -> tensor<1536xf32>
    %bias_storage = check.generate.fill value(123.25) : tensor<80xf32>
    %bias = check.tensor.view %bias_storage offset(64) : tensor<80xf32> -> tensor<48xf32>
    %strength_storage = check.generate.fill value(123.25) : tensor<33xf32>
    %strength = check.tensor.view %strength_storage offset(64) : tensor<33xf32> -> tensor<1xf32>
    %base_storage = check.generate.fill value(17142) : tensor<1568xi16>
    %base = check.tensor.view %base_storage offset(32) : tensor<1568xi16> -> tensor<1536xbf16>
    %wide_storage = check.generate.fill value(123.25) : tensor<1568xf32>
    %wide = check.tensor.view %wide_storage offset(64) : tensor<1568xf32> -> tensor<1536xf32>
    %output = check.tensor.view %base_storage offset(32) : tensor<1568xi16> -> tensor<1536xbf16>
    check.generate<@initialize_adapter_negative_zero>(%input, %bias, %strength, %base) : (tensor<1536xf32>, tensor<48xf32>, tensor<1xf32>, tensor<1536xbf16>) -> ()
    check.compare<@apply_adapter_negative_zero, @reference_adapter_negative_zero>(%input, %bias, %strength, %base, %wide, %output) : (tensor<1536xf32>, tensor<48xf32>, tensor<1xf32>, tensor<1536xbf16>, tensor<1536xf32>, tensor<1536xbf16>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<1568xf32>
      check.expect.bitwise actual(%bias_storage) expected(%bias_storage) : tensor<80xf32>
      check.expect.bitwise actual(%strength_storage) expected(%strength_storage) : tensor<33xf32>
      check.expect.bitwise actual(%base_storage) expected(%base_storage) : tensor<1568xi16>
      check.expect.bitwise actual(%wide_storage) expected(%wide_storage) : tensor<1568xf32>
    }
  }
  check.return
}

check.benchmark<@adapter_negative_zero> @adapter_negative_zero_benchmark
