  %output_column = index.assume %output_column_value [range(%output_column_value, 0, 32), multiple_of(%output_column_value, 16)] : index
  %half_accumulator = scalar.constant true : i1
  %operand_elements = index.constant 16 : index
  func.call @matrix_reference(%half_accumulator, %operand_elements, %reduction, %left_columns, %left_row_stride, %left_column_stride, %right_rows, %right_columns, %right_origin, %right_row, %right_column, %output_columns, %output_column, %waves, %left, %right, %output, %metadata) : (i1, index, index, index, index, index, index, index, offset, index, index, index, index, index, buffer, buffer, buffer, buffer)
