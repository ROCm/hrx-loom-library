template.decl @projection.adapter_layer_mix_12_bf16(%rows: index, %width: index, %rank: index, %row: index, %channel: index, %weight_is_bf16: i1, %input: buffer, %weight: buffer, %a: buffer, %b: buffer, %count: index, %offset_layout: encoding<layout>, %strength_layout: encoding<layout>, %offsets: view<[%count]xi64, %offset_layout>, %strengths: view<[%count]xf32, %strength_layout>) -> (bf16)

amdgpu.target<gfx11-generic> @scalar_wave32 {subgroup_size = 32}

kernel.def target(@scalar_wave32) @count_scalar_f32() {
  %rows = index.constant 2 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %a: buffer, %b: buffer, %selections: buffer, %output: buffer) {
  %rows = index.constant 2 : index
  %width = index.constant 65 : index
  %rank = index.constant 32 : index
  %row = kernel.workgroup.id<x> : index
  %channel = kernel.workitem.id<x> : index
  %valid = index.cmp ult, %channel, %width : index
  scf.if %valid {
    %weight_is_bf16 = scalar.constant false : i1
    %selection_origin = index.constant 0 : offset
    %selection_header = buffer.view %selections[%selection_origin] : buffer -> view<1xi32>
    %selection_count32 = view.load %selection_header[0] : view<1xi32> -> i32
    %selection_count_nonnegative = scalar.assume %selection_count32 [range(%selection_count32, 0, 2147483647)] : i32
    %count = index.cast %selection_count_nonnegative : i32 to index
    %offset_begin = index.constant 16 : offset
    %offset_layout = encoding.layout.strided [2] : encoding<layout>
    %offsets = buffer.view %selections[%offset_begin] : buffer -> view<[%count]xi64, %offset_layout>
    %strength_begin = index.constant 24 : offset
    %strength_layout = encoding.layout.strided [4] : encoding<layout>
    %strengths = buffer.view %selections[%strength_begin] : buffer -> view<[%count]xf32, %strength_layout>
    %value = template.apply<@projection.adapter_layer_mix_12_bf16>(%rows, %width, %rank, %row, %channel, %weight_is_bf16, %input, %weight, %a, %b, %count, %offset_layout, %strength_layout, %offsets, %strengths) : (index, index, index, index, index, i1, buffer, buffer, buffer, buffer, index, encoding<layout>, encoding<layout>, view<[%count]xi64, %offset_layout>, view<[%count]xf32, %strength_layout>) -> (bf16)
    %origin = index.constant 0 : offset
    %target = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
    view.store %value, %target[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
  }
  kernel.return
}

kernel.def target(@scalar_wave32) @count_scalar_bf16() {
  %rows = index.constant 2 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %a: buffer, %b: buffer, %selections: buffer, %output: buffer) {
  %rows = index.constant 2 : index
  %width = index.constant 65 : index
  %rank = index.constant 32 : index
  %row = kernel.workgroup.id<x> : index
  %channel = kernel.workitem.id<x> : index
  %valid = index.cmp ult, %channel, %width : index
  scf.if %valid {
    %weight_is_bf16 = scalar.constant true : i1
    %selection_origin = index.constant 0 : offset
    %selection_header = buffer.view %selections[%selection_origin] : buffer -> view<1xi32>
    %selection_count32 = view.load %selection_header[0] : view<1xi32> -> i32
    %selection_count_nonnegative = scalar.assume %selection_count32 [range(%selection_count32, 0, 2147483647)] : i32
    %count = index.cast %selection_count_nonnegative : i32 to index
    %offset_begin = index.constant 16 : offset
    %offset_layout = encoding.layout.strided [2] : encoding<layout>
    %offsets = buffer.view %selections[%offset_begin] : buffer -> view<[%count]xi64, %offset_layout>
    %strength_begin = index.constant 24 : offset
    %strength_layout = encoding.layout.strided [4] : encoding<layout>
    %strengths = buffer.view %selections[%strength_begin] : buffer -> view<[%count]xf32, %strength_layout>
    %value = template.apply<@projection.adapter_layer_mix_12_bf16>(%rows, %width, %rank, %row, %channel, %weight_is_bf16, %input, %weight, %a, %b, %count, %offset_layout, %strength_layout, %offsets, %strengths) : (index, index, index, index, index, i1, buffer, buffer, buffer, buffer, index, encoding<layout>, encoding<layout>, view<[%count]xi64, %offset_layout>, view<[%count]xf32, %strength_layout>) -> (bf16)
    %origin = index.constant 0 : offset
    %target = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
    view.store %value, %target[%row, %channel] : bf16, view<[%rows]x[%width]xbf16>
  }
  kernel.return
}
