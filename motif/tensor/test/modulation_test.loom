// Modulation keeps a BF16 boundary after each table conversion, combination,
// scale offset, and multiplication. The VM reference uses integer rounding,
// independently of the production casts. Midpoint neighbors, signed zeros,
// subnormal powers, and random inputs distinguish those boundaries; widened
// tables exercise leaves that decompress BF16 checkpoints to F32. Guarded
// subviews check tails and immutable inputs. The JIT configuration selects
// workgroup size independently of the scenario's arithmetic cases.
amdgpu.target<gfx11-generic> @modulation_wave32 {subgroup_size = 32}

config.def @test.modulation.workgroup_size = 128 : %value: index where [range(%value, 32, 256)]

template.decl @modulation.combine_bf16(%value: bf16, %table: f32) -> (bf16)

template.decl @modulation.affine_bf16(%value: bf16, %scale: bf16, %scale_table: f32, %shift: bf16, %shift_table: f32) -> (bf16)

func.decl @reference_bf16_round(%value: f32) -> (f32)

func.decl @reference_bf16_value(%word: i16) -> (f32)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

template.decl @modulation_shape(%configuration: index) -> (index)

template.def<@modulation_shape> @modulation_shape_values(%configuration: index) -> (index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %rounding = index.cmp eq, %configuration, %c0 : index
  %extremes = index.cmp eq, %configuration, %c1 : index
  %c200 = index.constant 200 : index
  %c56 = index.constant 56 : index
  %c63 = index.constant 63 : index
  %other_count = scf.select %extremes, %c56, %c63 : index
  %count = scf.select %rounding, %c200, %other_count : index
  template.return %count : index
}

func.def @modulation_storage(%configuration: index) -> (index, index, index, index, index) {
  %count = template.apply<@modulation_shape>(%configuration) : (index) -> (index)
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %guards = index.constant 32 : index
  %input_count = index.mul %count, %c3 : index
  %table_count = index.mul %count, %c2 : index
  %input_storage = index.add %input_count, %guards : index
  %table_storage = index.add %table_count, %guards : index
  func.return %count, %input_count, %table_count, %input_storage, %table_storage : index, index, index, index, index
}

func.def @initialize_modulation(%configuration: index, %count: index, %random: buffer, %input: buffer, %table: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c36 = index.constant 36 : index
  %c48 = index.constant 48 : index
  %c72 = index.constant 72 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %unit = scalar.constant 1.0 : f32
  %negative_sign = scalar.constant -1.0 : f32
  %half = scalar.constant 0.5 : f32
  %negative_half = scalar.constant -0.5 : f32
  %magnitude = scalar.constant 1.5 : f32
  %negative_magnitude = scalar.constant -1.5 : f32
  %c0_i32 = scalar.constant 0 : i32
  %low_bit = scalar.constant 1 : i32
  %sign_bit = scalar.constant -2147483648 : i32
  %randoms = buffer.view %random[%origin] : buffer -> view<[%count]x5xf32>
  %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xi16>
  %tables = buffer.view %table[%origin] : buffer -> view<[%count]x2xf32>
  %rounding = index.cmp eq, %configuration, %c0 : index
  %extremes = index.cmp eq, %configuration, %c1 : index
  %widened = index.cmp eq, %configuration, %c2 : index
  scf.for %row = [%c0 to %count step %c1] {
    %early = index.cmp ult, %row, %c72 : index
    %boundary = scalar.andi %rounding, %early : i1
    %value, %scale, %scale_table, %shift, %shift_table = scf.if %boundary -> (f32, f32, f32, f32, f32) {
      // Odd mantissas 1, 3, 7, 15, 63, 127; both signs, each midpoint's
      // immediate F32 neighbors, and both signs of the multiplied value.
      %group = index.div %row, %c6 : index
      %ordinal = index.rem %group, %c6 : index
      %short = index.cmp ult, %ordinal, %c4 : index
      %low = index.add %ordinal, %c1 : index
      %high = index.add %ordinal, %c2 : index
      %exponent = scf.select %short, %low, %high : index
      %exponent_word = index.cast %exponent : index to i32
      %power = scalar.shli %low_bit, %exponent_word : i32
      %numerator = scalar.subi %power, %low_bit : i32
      %fraction = scalar.uitofp %numerator : i32 to f32
      %spacing = scalar.constant 0.00390625 : f32
      %delta = scalar.mulf %fraction, %spacing : f32
      %positive = scalar.addf %unit, %delta : f32
      %negative = index.cmp ult, %row, %c36 : index
      %sign = scf.select %negative, %negative_sign, %unit : f32
      %midpoint = scalar.mulf %positive, %sign : f32
      %bits = scalar.bitcast %midpoint : f32 to i32
      %pair = index.div %row, %c2 : index
      %neighbor = index.rem %pair, %c3 : index
      %neighbor_word = index.cast %neighbor : index to i32
      %displacement = scalar.subi %neighbor_word, %low_bit : i32
      %displaced = scalar.addi %bits, %displacement : i32
      %table_value = scalar.bitcast %displaced : i32 to f32
      %negated_bits = scalar.xori %displaced, %sign_bit : i32
      %negative_table = scalar.bitcast %negated_bits : i32 to f32
      %parity = index.rem %row, %c2 : index
      %first = index.cmp eq, %parity, %c0 : index
      %value = scf.select %first, %negative_magnitude, %magnitude : f32
      scf.yield %value, %half, %table_value, %negative_half, %negative_table : f32, f32, f32, f32, f32
    } else {
      %value, %scale, %scale_table, %shift, %shift_table = scf.if %extremes -> (f32, f32, f32, f32, f32) {
        %initial = index.cmp ult, %row, %c4 : index
        %value, %scale, %scale_table, %shift, %shift_table = scf.if %initial -> (f32, f32, f32, f32, f32) {
          %negative_zero = scalar.bitcast %sign_bit : i32 to f32
          %values = vector.from_elements %c0_f32, %negative_zero, %negative_zero, %magnitude : vector<4xf32>
          %scales = vector.from_elements %c0_f32, %c0_f32, %negative_sign, %negative_sign : vector<4xf32>
          %shifts = vector.from_elements %c0_f32, %negative_zero, %negative_zero, %negative_sign : vector<4xf32>
          %shift_tables = vector.from_elements %c0_f32, %negative_zero, %negative_zero, %unit : vector<4xf32>
          %value = vector.extract %values[%row] : vector<4xf32> -> f32
          %scale = vector.extract %scales[%row] : vector<4xf32> -> f32
          %shift = vector.extract %shifts[%row] : vector<4xf32> -> f32
          %shift_table = vector.extract %shift_tables[%row] : vector<4xf32> -> f32
          scf.yield %value, %scale, %c0_f32, %shift, %shift_table : f32, f32, f32, f32, f32
        } else {
          %ordinary = index.cmp ult, %row, %c48 : index
          %value, %scale, %scale_table, %shift, %shift_table = scf.if %ordinary -> (f32, f32, f32, f32, f32) {
            // Exact powers 2^[-133,-132,-127,-126,-100,-60,-20,0,20,60,100].
            %p0 = scalar.constant 65536 : i32
            %p1 = scalar.constant 131072 : i32
            %p2 = scalar.constant 4194304 : i32
            %p3 = scalar.constant 8388608 : i32
            %p4 = scalar.constant 226492416 : i32
            %p5 = scalar.constant 562036736 : i32
            %p6 = scalar.constant 897581056 : i32
            %p7 = scalar.constant 1065353216 : i32
            %p8 = scalar.constant 1233125376 : i32
            %p9 = scalar.constant 1568669696 : i32
            %p10 = scalar.constant 1904214016 : i32
            %powers = vector.from_elements %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8, %p9, %p10 : vector<11xi32>
            %element = index.sub %row, %c4 : index
            %ordinal = index.div %element, %c4 : index
            %within = index.rem %element, %c4 : index
            %negative = index.cmp ult, %within, %c2 : index
            %positive_bits = vector.extract %powers[%ordinal] : vector<11xi32> -> i32
            %sign = scf.select %negative, %sign_bit, %c0_i32 : i32
            %bits = scalar.ori %positive_bits, %sign : i32
            %value = scalar.bitcast %bits : i32 to f32
            %opposite_bits = scalar.xori %bits, %sign_bit : i32
            %opposite = scalar.bitcast %opposite_bits : i32 to f32
            %parity = index.rem %element, %c2 : index
            %first = index.cmp eq, %parity, %c0 : index
            %scale = scf.select %first, %negative_half, %half : f32
            %shift = scf.select %first, %c0_f32, %opposite : f32
            scf.yield %value, %scale, %c0_f32, %shift, %c0_f32 : f32, f32, f32, f32, f32
          } else {
            %p0 = scalar.constant 1 : i32
            %p1 = scalar.constant 32768 : i32
            %p2 = scalar.constant 65536 : i32
            %p3 = scalar.constant 8388608 : i32
            %powers = vector.from_elements %p0, %p1, %p2, %p3 : vector<4xi32>
            %element = index.sub %row, %c48 : index
            %ordinal = index.div %element, %c2 : index
            %parity = index.rem %element, %c2 : index
            %negative = index.cmp eq, %parity, %c0 : index
            %positive_bits = vector.extract %powers[%ordinal] : vector<4xi32> -> i32
            %sign = scf.select %negative, %sign_bit, %c0_i32 : i32
            %bits = scalar.ori %positive_bits, %sign : i32
            %table_value = scalar.bitcast %bits : i32 to f32
            scf.yield %unit, %c0_f32, %table_value, %c0_f32, %table_value : f32, f32, f32, f32, f32
          }
          scf.yield %value, %scale, %scale_table, %shift, %shift_table : f32, f32, f32, f32, f32
        }
        scf.yield %value, %scale, %scale_table, %shift, %shift_table : f32, f32, f32, f32, f32
      } else {
        %value = view.load %randoms[%row, 0] : view<[%count]x5xf32> -> f32
        %scale = view.load %randoms[%row, 1] : view<[%count]x5xf32> -> f32
        %scale_table = view.load %randoms[%row, 2] : view<[%count]x5xf32> -> f32
        %shift = view.load %randoms[%row, 3] : view<[%count]x5xf32> -> f32
        %shift_table = view.load %randoms[%row, 4] : view<[%count]x5xf32> -> f32
        %scale_table_half = scalar.mulf %scale_table, %half : f32
        %shift_table_half = scalar.mulf %shift_table, %half : f32
        %scale_table_bf16 = func.call @reference_bf16_round(%scale_table_half) : (f32) -> (f32)
        %shift_table_bf16 = func.call @reference_bf16_round(%shift_table_half) : (f32) -> (f32)
        %selected_scale_table = scf.select %widened, %scale_table_bf16, %scale_table_half : f32
        %selected_shift_table = scf.select %widened, %shift_table_bf16, %shift_table_half : f32
        scf.yield %value, %scale, %selected_scale_table, %shift, %selected_shift_table : f32, f32, f32, f32, f32
      }
      scf.yield %value, %scale, %scale_table, %shift, %shift_table : f32, f32, f32, f32, f32
    }
    %value_bits = func.call @reference_bf16_bits(%value) : (f32) -> (i16)
    %scale_bits = func.call @reference_bf16_bits(%scale) : (f32) -> (i16)
    %shift_bits = func.call @reference_bf16_bits(%shift) : (f32) -> (i16)
    view.store %value_bits, %inputs[%row, 0] : i16, view<[%count]x3xi16>
    view.store %scale_bits, %inputs[%row, 1] : i16, view<[%count]x3xi16>
    view.store %shift_bits, %inputs[%row, 2] : i16, view<[%count]x3xi16>
    view.store %scale_table, %tables[%row, 0] : f32, view<[%count]x2xf32>
    view.store %shift_table, %tables[%row, 1] : f32, view<[%count]x2xf32>
  }
  func.return
}

kernel.def target(@modulation_wave32) @apply_modulation(%count: index) {
  %threads = config.get @test.modulation.workgroup_size : index
  %last = index.constant 1 : index
  %padded = index.add %count, %threads : index
  %numerator = index.sub %padded, %last : index
  %groups = index.div %numerator, %threads : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%count: index, %input: buffer, %table: buffer, %output: buffer) {
  %threads = config.get @test.modulation.workgroup_size : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    // The live-row predicate excludes padding lanes in the final workgroup.
    %live_row = index.assume %row [ge(%row, 0), lt(%row, %count)] : index
    %origin = index.constant 0 : offset
    %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xbf16>
    %tables = buffer.view %table[%origin] : buffer -> view<[%count]x2xf32>
    %output_origin = index.constant 32 : offset
    %outputs = buffer.view %output[%output_origin] : buffer -> view<[%count]x3xbf16>
    %value = view.load %inputs[%live_row, 0] : view<[%count]x3xbf16> -> bf16
    %scale = view.load %inputs[%live_row, 1] : view<[%count]x3xbf16> -> bf16
    %shift = view.load %inputs[%live_row, 2] : view<[%count]x3xbf16> -> bf16
    %scale_table = view.load %tables[%live_row, 0] : view<[%count]x2xf32> -> f32
    %shift_table = view.load %tables[%live_row, 1] : view<[%count]x2xf32> -> f32
    %scale_sum = template.apply<@modulation.combine_bf16>(%scale, %scale_table) : (bf16, f32) -> (bf16)
    %shift_sum = template.apply<@modulation.combine_bf16>(%shift, %shift_table) : (bf16, f32) -> (bf16)
    %affine = template.apply<@modulation.affine_bf16>(%value, %scale, %scale_table, %shift, %shift_table) : (bf16, bf16, f32, bf16, f32) -> (bf16)
    view.store %scale_sum, %outputs[%live_row, 0] : bf16, view<[%count]x3xbf16>
    view.store %shift_sum, %outputs[%live_row, 1] : bf16, view<[%count]x3xbf16>
    view.store %affine, %outputs[%live_row, 2] : bf16, view<[%count]x3xbf16>
  }
  kernel.return
}

command.program.def @modulation_program(%configuration: index) launch(%input: buffer, %table: buffer, %output: buffer) {
  %count = template.apply<@modulation_shape>(%configuration) : (index) -> (index)
  kernel.launch @apply_modulation[%count](%count, %input, %table, %output) : [index](index, buffer, buffer, buffer)
  command.return
}

func.def @modulation_reference(%input: buffer, %table: buffer, %output: buffer) {
  %length = buffer.length %input
  %bytes = index.cast %length : offset to index
  %row_bytes = index.constant 6 : index
  %count = index.div %bytes, %row_bytes : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %scale_offset = scalar.constant 1.0 : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xi16>
  %tables = buffer.view %table[%origin] : buffer -> view<[%count]x2xf32>
  %output_origin = index.constant 32 : offset
  %outputs = buffer.view %output[%output_origin] : buffer -> view<[%count]x3xi16>
  scf.for %row = [%c0 to %count step %c1] {
    %value_bits = view.load %inputs[%row, 0] : view<[%count]x3xi16> -> i16
    %scale_bits = view.load %inputs[%row, 1] : view<[%count]x3xi16> -> i16
    %shift_bits = view.load %inputs[%row, 2] : view<[%count]x3xi16> -> i16
    %value = func.call @reference_bf16_value(%value_bits) : (i16) -> (f32)
    %scale = func.call @reference_bf16_value(%scale_bits) : (i16) -> (f32)
    %shift = func.call @reference_bf16_value(%shift_bits) : (i16) -> (f32)
    %scale_table_f32 = view.load %tables[%row, 0] : view<[%count]x2xf32> -> f32
    %shift_table_f32 = view.load %tables[%row, 1] : view<[%count]x2xf32> -> f32
    %scale_table = func.call @reference_bf16_round(%scale_table_f32) : (f32) -> (f32)
    %shift_table = func.call @reference_bf16_round(%shift_table_f32) : (f32) -> (f32)
    %scale_sum_f32 = scalar.addf %scale, %scale_table : f32
    %shift_sum_f32 = scalar.addf %shift, %shift_table : f32
    %scale_sum = func.call @reference_bf16_round(%scale_sum_f32) : (f32) -> (f32)
    %shift_sum = func.call @reference_bf16_round(%shift_sum_f32) : (f32) -> (f32)
    %offset = scalar.addf %scale_sum, %scale_offset : f32
    %affine_scale = func.call @reference_bf16_round(%offset) : (f32) -> (f32)
    %product = scalar.mulf %value, %affine_scale : f32
    %scaled = func.call @reference_bf16_round(%product) : (f32) -> (f32)
    %result = scalar.addf %scaled, %shift_sum : f32
    %scale_word = func.call @reference_bf16_bits(%scale_sum) : (f32) -> (i16)
    %shift_word = func.call @reference_bf16_bits(%shift_sum) : (f32) -> (i16)
    %result_word = func.call @reference_bf16_bits(%result) : (f32) -> (i16)
    view.store %scale_word, %outputs[%row, 0] : i16, view<[%count]x3xi16>
    view.store %shift_word, %outputs[%row, 1] : i16, view<[%count]x3xi16>
    view.store %result_word, %outputs[%row, 2] : i16, view<[%count]x3xi16>
  }
  func.return
}

check.scenario public @modulation_rounding configure[3](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count, %input_count, %table_count, %input_storage_count, %table_storage_count = check.generate<@modulation_storage>(%configuration) : (index) -> (index, index, index, index, index)
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %random = check.generate.random.uniform seed(%seed) range(-8.0 to 8.0) : tensor<[%count]x5xf32>
    %input_storage = check.generate.fill value(-12345) : tensor<[%input_storage_count]xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<[%input_storage_count]xi16> -> tensor<[%input_count]xbf16>
    %table_storage = check.generate.fill value(-99.0) : tensor<[%table_storage_count]xf32>
    %table = check.tensor.view %table_storage offset(64) : tensor<[%table_storage_count]xf32> -> tensor<[%table_count]xf32>
    check.generate<@initialize_modulation>(%configuration, %count, %random, %input, %table) : (index, index, tensor<[%count]x5xf32>, tensor<[%input_count]xbf16>, tensor<[%table_count]xf32>) -> ()
    %output_storage = check.generate.fill value(-12345) : tensor<[%input_storage_count]xi16>
    check.compare<@modulation_program, @modulation_reference>[%configuration](%input, %table, %output_storage) : [index](tensor<[%input_count]xbf16>, tensor<[%table_count]xf32>, tensor<[%input_storage_count]xi16>) -> () {
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<[%input_storage_count]xi16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<[%input_storage_count]xi16>
      check.expect.bitwise actual(%table_storage) expected(%table_storage) : tensor<[%table_storage_count]xf32>
    }
  }
  check.return
}

check.benchmark<@modulation_rounding> @modulation_rounding_benchmark
