template.decl @modulation.combine_bf16(%value: bf16, %table: f32) -> (bf16)

template.decl @modulation.affine_bf16(%value: bf16, %scale: bf16, %scale_table: f32, %shift: bf16, %shift_table: f32) -> (bf16)

global.rodata.def @rounding_inputs = align(2) bytes("")

global.rodata.def @rounding_tables = align(4) bytes("")

global.rodata.def @rounding_expected = align(2) bytes("")

func.def @initialize_rounding(%input: buffer, %table: buffer) {
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 1200 : offset
  %table_bytes = index.constant 1600 : offset
  %inputs = global.load @rounding_inputs : buffer
  %tables = global.load @rounding_tables : buffer
  buffer.copy %inputs[%origin], %input[%origin], %input_bytes
  buffer.copy %tables[%origin], %table[%origin], %table_bytes
  func.return
}

kernel.def target(@modulation_wave32) @apply_rounding() {
  %groups = index.constant 2 : index
  %threads = index.constant 128 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %count = index.constant 200 : index
  %threads = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xbf16>
    %tables = buffer.view %table[%origin] : buffer -> view<[%count]x2xf32>
    %outputs = buffer.view %output[%origin] : buffer -> view<[%count]x3xbf16>
    %value = view.load %inputs[%row, 0] : view<[%count]x3xbf16> -> bf16
    %scale = view.load %inputs[%row, 1] : view<[%count]x3xbf16> -> bf16
    %shift = view.load %inputs[%row, 2] : view<[%count]x3xbf16> -> bf16
    %scale_table = view.load %tables[%row, 0] : view<[%count]x2xf32> -> f32
    %shift_table = view.load %tables[%row, 1] : view<[%count]x2xf32> -> f32
    %scale_sum = template.apply<@modulation.combine_bf16>(%scale, %scale_table) : (bf16, f32) -> (bf16)
    %shift_sum = template.apply<@modulation.combine_bf16>(%shift, %shift_table) : (bf16, f32) -> (bf16)
    %affine = template.apply<@modulation.affine_bf16>(%value, %scale, %scale_table, %shift, %shift_table) : (bf16, bf16, f32, bf16, f32) -> (bf16)
    view.store %scale_sum, %outputs[%row, 0] : bf16, view<[%count]x3xbf16>
    view.store %shift_sum, %outputs[%row, 1] : bf16, view<[%count]x3xbf16>
    view.store %affine, %outputs[%row, 2] : bf16, view<[%count]x3xbf16>
  }
  kernel.return
}

func.def @reference_rounding(%input: buffer, %table: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 1200 : offset
  %expected = global.load @rounding_expected : buffer
  buffer.copy %expected[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @rounding {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-12345) : tensor<632xi16>
    %input = check.tensor.view %input_storage offset(32) : tensor<632xi16> -> tensor<600xbf16>
    %table_storage = check.generate.fill value(-99.0) : tensor<432xf32>
    %table = check.tensor.view %table_storage offset(64) : tensor<432xf32> -> tensor<400xf32>
    check.generate<@initialize_rounding>(%input, %table) : (tensor<600xbf16>, tensor<400xf32>) -> ()
    %output_storage = check.generate.fill value(-12345) : tensor<632xi16>
    %output = check.tensor.view %output_storage offset(32) : tensor<632xi16> -> tensor<600xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<632xi16> -> tensor<16xi16>
    %suffix = check.tensor.view %output_storage offset(1232) : tensor<632xi16> -> tensor<16xi16>
    check.compare<@apply_rounding, @reference_rounding>(%input, %table, %output) : (tensor<600xbf16>, tensor<400xf32>, tensor<600xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<600xbf16>
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<632xi16>
      check.expect.bitwise actual(%table_storage) expected(%table_storage) : tensor<432xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi16>
    }
  }
  check.return
}

check.benchmark<@rounding> @rounding_modulation

