func.def @initialize_division_rounding(%inputs: buffer, %affine: buffer) {
  %origin = index.constant 0 : offset
  %input_bytes = index.constant 48 : offset
  %affine_bytes = index.constant 80 : offset
  %input_values = global.load @division_rounding_inputs : buffer
  %affine_values = global.load @division_rounding_affine : buffer
  buffer.copy %input_values[%origin], %inputs[%origin], %input_bytes
  buffer.copy %affine_values[%origin], %affine[%origin], %affine_bytes
  func.return
}

func.def @reference_division_rounding(%inputs: buffer, %affine: buffer, %outputs: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 160 : offset
  %values = global.load @division_rounding_expected : buffer
  buffer.copy %values[%origin], %outputs[%origin], %bytes
  func.return
}

check.scenario public @division_rounding {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %inputs = check.generate.fill value(0.0) : tensor<24xbf16>
    %affine = check.generate.fill value(0.0) : tensor<20xf32>
    %outputs = check.generate.fill value(123.25) : tensor<40xf32>
    check.generate<@initialize_division_rounding>(%inputs, %affine) : (tensor<24xbf16>, tensor<20xf32>) -> ()
    check.compare<@unpack_division_rounding, @reference_division_rounding>(%inputs, %affine, %outputs) : (tensor<24xbf16>, tensor<20xf32>, tensor<40xf32>) -> () {
      check.expect.bitwise actual(%outputs) expected(%outputs) : tensor<40xf32>
      check.expect.bitwise actual(%inputs) expected(%inputs) : tensor<24xbf16>
      check.expect.bitwise actual(%affine) expected(%affine) : tensor<20xf32>
    }
  }
  check.return
}

check.benchmark<@division_rounding> @division_rounding_unpack
