// Decode packed 2x2 BF16 patches to channel-first pixels. The VM oracle walks
// stored patches and scatters pixels; production independently maps each output
// coordinate back to its input. The division-rounding case cancels a rounded
// quotient exactly, distinguishing separate F32 division/addition from a fused
// expression. Complete buffer comparisons retain input/affine immutability and
// output guards. Shapes cover singleton patches, aspect ratios, and launch tails.

amdgpu.target<gfx11-generic> @image_unpack_wave32 {subgroup_size = 32}

config.def @test.image_unpack.workgroup_size = 128 : %value: index where [range(%value, 32, 256)]

func.decl @reference_bf16_value(%word: i16) -> (f32)

template.decl @image.unpack_affine_element_bf16_f32(%height: index, %width: index, %channels: index, %channel: index, %pixel: index, %input: buffer, %affine: buffer) -> (f32)

template.decl @image_shape(%configuration: index) -> (index, index, index)

template.def<@image_shape> @image_shape_values(%configuration: index) -> (index, index, index) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c10 = scalar.constant 10 : i32
  %c16 = scalar.constant 16 : i32
  %c18 = scalar.constant 18 : i32
  %c22 = scalar.constant 22 : i32
  %heights = vector.from_elements %c2, %c10, %c2, %c8, %c6, %c18, %c2 : vector<7xi32>
  %widths = vector.from_elements %c2, %c2, %c22, %c16, %c22, %c18, %c2 : vector<7xi32>
  %channels = vector.from_elements %c1, %c3, %c7, %c16, %c5, %c16, %c2 : vector<7xi32>
  %height_word = vector.extract %heights[%configuration] : vector<7xi32> -> i32
  %width_word = vector.extract %widths[%configuration] : vector<7xi32> -> i32
  %channel_word = vector.extract %channels[%configuration] : vector<7xi32> -> i32
  %height = index.cast %height_word : i32 to index
  %width = index.cast %width_word : i32 to index
  %channel_count = index.cast %channel_word : i32 to index
  template.return %height, %width, %channel_count : index, index, index
}

func.def @image_storage(%configuration: index) -> (index, index, index, index, index, index, index) {
  %height, %width, %channels = template.apply<@image_shape>(%configuration) : (index) -> (index, index, index)
  %c2 = index.constant 2 : index
  %suffix = index.constant 16 : index
  %guards = index.constant 32 : index
  %pixels = index.mul %height, %width : index
  %values = index.mul %pixels, %channels : index
  %input_count = index.add %values, %suffix : index
  %affine_count = index.madd %channels, %c2, %suffix : index
  %output_count = index.add %values, %guards : index
  func.return %height, %width, %channels, %values, %input_count, %affine_count, %output_count : index, index, index, index, index, index, index
}

func.def @initialize_image(%configuration: index, %values: index, %channels: index, %random: buffer, %input: buffer, %affine: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  // Three shape words occupy the output prefix; both executions preserve them.
  %height, %width, %shape_channels = template.apply<@image_shape>(%configuration) : (index) -> (index, index, index)
  %header = buffer.view %output[%origin] : buffer -> view<3xi32>
  %height_word = index.cast %height : index to i32
  %width_word = index.cast %width : index to i32
  %channel_word = index.cast %shape_channels : index to i32
  view.store %height_word, %header[0] : i32, view<3xi32>
  view.store %width_word, %header[1] : i32, view<3xi32>
  view.store %channel_word, %header[2] : i32, view<3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %special = index.cmp eq, %configuration, %c6 : index
  %randoms = buffer.view %random[%origin] : buffer -> view<[%values]xi32>
  %inputs = buffer.view %input[%origin] : buffer -> view<[%values]xi16>
  %affines = buffer.view %affine[%origin] : buffer -> view<2x[%channels]xf32>
  scf.for %element = [%c0 to %values step %c1] {
    %entropy = view.load %randoms[%element] : view<[%values]xi32> -> i32
    %mantissa_mask = scalar.constant 127 : i32
    %sign_mask = scalar.constant 32768 : i32
    %shift = scalar.constant 7 : i32
    %exponent_span = scalar.constant 9 : i32
    %minimum_exponent = scalar.constant 123 : i32
    %mantissa = scalar.andi %entropy, %mantissa_mask : i32
    %sign = scalar.andi %entropy, %sign_mask : i32
    %upper = scalar.shrui %entropy, %shift : i32
    %exponent_delta = scalar.remui %upper, %exponent_span : i32
    %exponent = scalar.addi %minimum_exponent, %exponent_delta : i32
    %exponent_bits = scalar.shli %exponent, %shift : i32
    %magnitude = scalar.ori %exponent_bits, %mantissa : i32
    %bits = scalar.ori %sign, %magnitude : i32
    %patch_channel = index.div %element, %c4 : index
    %channel = index.rem %patch_channel, %channels : index
    %first_channel = index.cmp eq, %channel, %c0 : index
    %positive_unit = scalar.constant 16256 : i32
    %negative_unit = scalar.constant 49024 : i32
    %directed = scf.select %first_channel, %positive_unit, %negative_unit : i32
    %selected = scf.select %special, %directed, %bits : i32
    %word = scalar.trunci %selected : i32 to i16
    view.store %word, %inputs[%element] : i16, view<[%values]xi16>
  }
  %unit = scalar.constant 1.0 : f32
  %quarter = scalar.constant 0.25 : f32
  %third_divisor = scalar.constant 3.0 : f32
  %tenth_divisor = scalar.constant 10.0 : f32
  %other_divisor = scalar.constant 5.5 : f32
  %eighth = scalar.constant 0.125 : f32
  %double = scalar.constant 2.0 : f32
  %inverses = vector.from_elements %unit, %quarter, %third_divisor, %tenth_divisor, %other_divisor, %eighth, %double : vector<7xf32>
  %center = index.div %channels, %c2 : index
  scf.for %channel = [%c0 to %channels step %c1] {
    %ordinal = index.rem %channel, %c7 : index
    %inverse = vector.extract %inverses[%ordinal] : vector<7xf32> -> f32
    %channel_word = index.cast %channel : index to i32
    %center_word = index.cast %center : index to i32
    %difference = scalar.subi %channel_word, %center_word : i32
    %difference_f32 = scalar.sitofp %difference : i32 to f32
    %spacing = scalar.constant 0.03125 : f32
    %mean = scalar.mulf %difference_f32, %spacing : f32
    %first_channel = index.cmp eq, %channel, %c0 : index
    %directed_inverse = scf.select %first_channel, %third_divisor, %tenth_divisor : f32
    %negative_third = scalar.constant -0.3333333432674408 : f32
    %positive_tenth = scalar.constant 0.10000000149011612 : f32
    %directed_mean = scf.select %first_channel, %negative_third, %positive_tenth : f32
    %selected_inverse = scf.select %special, %directed_inverse, %inverse : f32
    %selected_mean = scf.select %special, %directed_mean, %mean : f32
    view.store %selected_inverse, %affines[0, %channel] : f32, view<2x[%channels]xf32>
    view.store %selected_mean, %affines[1, %channel] : f32, view<2x[%channels]xf32>
  }
  func.return
}

kernel.def target(@image_unpack_wave32) @unpack_image(%height: index, %width: index, %channels: index) {
  %threads = config.get @test.image_unpack.workgroup_size : index
  %unit = index.constant 1 : index
  %pixels = index.mul %height, %width : index
  %padded = index.add %pixels, %threads : index
  %numerator = index.sub %padded, %unit : index
  %groups = index.div %numerator, %threads : index
  kernel.launch.config workgroups(%groups, %channels, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%height: index, %width: index, %channels: index, %input: buffer, %affine: buffer, %output: buffer) {
  %threads = config.get @test.image_unpack.workgroup_size : index
  %pixels = index.mul %height, %width : index
  %group = kernel.workgroup.id<x> : index
  %channel_value = kernel.workgroup.id<y> : index
  %channel = index.assume %channel_value [ge(%channel_value, 0), lt(%channel_value, %channels)] : index
  %lane = kernel.workitem.id<x> : index
  %pixel_value = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %pixel_value, %pixels : index
  scf.if %live {
    %pixel = index.assume %pixel_value [ge(%pixel_value, 0), lt(%pixel_value, %pixels)] : index
    %value = template.apply<@image.unpack_affine_element_bf16_f32>(%height, %width, %channels, %channel, %pixel, %input, %affine) : (index, index, index, index, index, buffer, buffer) -> (f32)
    %output_origin = index.constant 64 : offset
    %outputs = buffer.view %output[%output_origin] : buffer -> view<[%channels]x[%pixels]xf32>
    view.store %value, %outputs[%channel, %pixel] : f32, view<[%channels]x[%pixels]xf32>
  }
  kernel.return
}

command.program.def @image_program(%configuration: index) launch(%input: buffer, %affine: buffer, %output: buffer) {
  %grid_height, %grid_width, %grid_channels = template.apply<@image_shape>(%configuration) : (index) -> (index, index, index)
  kernel.launch @unpack_image[%grid_height, %grid_width, %grid_channels](%grid_height, %grid_width, %grid_channels, %input, %affine, %output) : [index, index, index](index, index, index, buffer, buffer, buffer)
  command.return
}

// Walk patches in storage order; advance the input cursor without using the
// production inverse mapping. F32 arithmetic rounds the quotient before adding.
func.def @image_reference(%input: buffer, %affine: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %output[%origin] : buffer -> view<3xi32>
  %height_word = view.load %header[0] : view<3xi32> -> i32
  %width_word = view.load %header[1] : view<3xi32> -> i32
  %channel_word = view.load %header[2] : view<3xi32> -> i32
  %height = index.cast %height_word : i32 to index
  %width = index.cast %width_word : i32 to index
  %channels = index.cast %channel_word : i32 to index
  %output_origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %pixels = index.mul %height, %width : index
  %values = index.mul %pixels, %channels : index
  %inputs = buffer.view %input[%origin] : buffer -> view<[%values]xi16>
  %affines = buffer.view %affine[%origin] : buffer -> view<2x[%channels]xf32>
  %outputs = buffer.view %output[%output_origin] : buffer -> view<[%channels]x[%height]x[%width]xf32>
  %end = scf.for %patch_y = [%c0 to %height step %c2](%row_position = %c0 : index) -> (index) {
    %next_row = scf.for %patch_x = [%c0 to %width step %c2](%patch_position = %row_position : index) -> (index) {
      %next_patch = scf.for %channel = [%c0 to %channels step %c1](%channel_position = %patch_position : index) -> (index) {
        %inverse = view.load %affines[0, %channel] : view<2x[%channels]xf32> -> f32
        %mean = view.load %affines[1, %channel] : view<2x[%channels]xf32> -> f32
        %next_channel = scf.for %dy = [%c0 to %c2 step %c1](%pixel_row_position = %channel_position : index) -> (index) {
          %y = index.add %patch_y, %dy : index
          %next_pixel_row = scf.for %dx = [%c0 to %c2 step %c1](%position = %pixel_row_position : index) -> (index) {
            %x = index.add %patch_x, %dx : index
            // The patch traversal consumes every input once and visits only
            // coordinates inside the authored positive, even image dimensions.
            %input_position = index.assume %position [ge(%position, 0), lt(%position, %values)] : index
            %output_y = index.assume %y [ge(%y, 0), lt(%y, %height)] : index
            %output_x = index.assume %x [ge(%x, 0), lt(%x, %width)] : index
            %word = view.load %inputs[%input_position] : view<[%values]xi16> -> i16
            %value = func.call @reference_bf16_value(%word) : (i16) -> (f32)
            %quotient = scalar.divf %value, %inverse : f32
            %result = scalar.addf %quotient, %mean : f32
            view.store %result, %outputs[%channel, %output_y, %output_x] : f32, view<[%channels]x[%height]x[%width]xf32>
            %next = index.add %position, %c1 : index
            scf.yield %next : index
          }
          scf.yield %next_pixel_row : index
        }
        scf.yield %next_channel : index
      }
      scf.yield %next_patch : index
    }
    scf.yield %next_row : index
  }
  func.return
}

check.scenario public @patch_unpack configure[7](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %height, %width, %channels, %values, %input_count, %affine_count, %output_count = check.generate<@image_storage>(%configuration) : (index) -> (index, index, index, index, index, index, index)
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %random = check.generate.random.uniform seed(%seed) range(0 to 65535) : tensor<[%values]xi32>
    %input = check.generate.fill value(32639) : tensor<[%input_count]xi16>
    %affine = check.generate.fill value(777.0) : tensor<[%affine_count]xf32>
    %output = check.generate.fill value(123.25) : tensor<[%output_count]xf32>
    check.generate<@initialize_image>(%configuration, %values, %channels, %random, %input, %affine, %output) : (index, index, index, tensor<[%values]xi32>, tensor<[%input_count]xi16>, tensor<[%affine_count]xf32>, tensor<[%output_count]xf32>) -> ()
    check.compare<@image_program, @image_reference>[%configuration](%input, %affine, %output) : [index](tensor<[%input_count]xi16>, tensor<[%affine_count]xf32>, tensor<[%output_count]xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<[%output_count]xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xi16>
      check.expect.bitwise actual(%affine) expected(%affine) : tensor<[%affine_count]xf32>
    }
  }
  check.return
}

check.benchmark<@patch_unpack> @patch_unpack_benchmark
