// Large adapter projections retain full-width device operands while the scalar
// reference evaluates their exact periods. Configuration fans out shape families
// sharing one input-derived numerical envelope; rank scratch and full output
// remain observable. These opt-in cases use the ordinary test's kernels, bank
// records, guarded allocation, and F32/BF16 publication boundaries.

command.program.decl @adapter_matrix_program(%group: index, %configuration: index) launch(%input: buffer, %down: buffer, %up: buffer, %selections: buffer, %base: buffer, %low: buffer, %output: buffer)

func.decl @adapter_storage(%group: index, %configuration: index) -> (index, index, index, index, index, index, index, index, index, index)

func.decl @initialize_adapter_matrix(%group: index, %configuration: index, %input: buffer, %down: buffer, %up: buffer, %selections: buffer, %base: buffer)

func.decl @adapter_matrix_reference(%input: buffer, %down: buffer, %up: buffer, %selections: buffer, %base: buffer, %low: buffer, %output: buffer)

check.scenario public @short_reduction configure[1](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %group = check.literal value(9) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_bytes, %factor_bytes, %selection_bytes, %selection_storage_bytes, %output_elements, %output_words, %low_elements, %low_words, %geometry, %selection = check.generate<@adapter_storage>(%group, %configuration) : (index, index) -> (index, index, index, index, index, index, index, index, index, index)
    %input = check.generate.fill value(77) : tensor<[%input_bytes]xi8>
    %down = check.generate.fill value(77) : tensor<[%factor_bytes]xi8>
    %up = check.generate.fill value(77) : tensor<[%factor_bytes]xi8>
    %selections_storage = check.generate.fill value(77) : tensor<[%selection_storage_bytes]xi8>
    %selections = check.tensor.view %selections_storage offset(16) : tensor<[%selection_storage_bytes]xi8> -> tensor<[%selection_bytes]xi8>
    %base = check.generate.fill value(19789) : tensor<[%output_words]xi16>
    %low = check.generate.fill value(19789) : tensor<[%low_words]xi16>
    %output = check.generate.fill value(19789) : tensor<[%output_words]xi16>
    %low_values = check.tensor.view %low offset(0) : tensor<[%low_words]xi16> -> tensor<[%low_words]xbf16>
    %output_values = check.tensor.view %output offset(0) : tensor<[%output_words]xi16> -> tensor<[%output_words]xbf16>
    check.generate<@initialize_adapter_matrix>(%group, %configuration, %input, %down, %up, %selections, %base) : (index, index, tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>) -> ()
    check.compare<@adapter_matrix_program, @adapter_matrix_reference>[%group, %configuration](%input, %down, %up, %selections, %base, %low, %output) : [index, index](tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>, tensor<[%low_words]xi16>, tensor<[%output_words]xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_bytes]xi8>
      check.expect.bitwise actual(%down) expected(%down) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%up) expected(%up) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%selections_storage) expected(%selections_storage) : tensor<[%selection_storage_bytes]xi8>
      check.expect.bitwise actual(%base) expected(%base) : tensor<[%output_words]xi16>
      check.expect.approximate actual(%low_values) expected(%low_values) atol(6.2882900238037109e-06) rtol(0.0) nan(different) : tensor<[%low_words]xbf16>, tensor<[%low_words]xbf16>
      check.expect.approximate actual(%output_values) expected(%output_values) atol(0.015625) rtol(0.0) nan(different) : tensor<[%output_words]xbf16>, tensor<[%output_words]xbf16>
    }
  }
  check.return
}

check.benchmark<@short_reduction> @short_reduction_benchmark

check.scenario public @medium_reduction configure[1](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %group = check.literal value(10) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_bytes, %factor_bytes, %selection_bytes, %selection_storage_bytes, %output_elements, %output_words, %low_elements, %low_words, %geometry, %selection = check.generate<@adapter_storage>(%group, %configuration) : (index, index) -> (index, index, index, index, index, index, index, index, index, index)
    %input = check.generate.fill value(77) : tensor<[%input_bytes]xi8>
    %down = check.generate.fill value(77) : tensor<[%factor_bytes]xi8>
    %up = check.generate.fill value(77) : tensor<[%factor_bytes]xi8>
    %selections_storage = check.generate.fill value(77) : tensor<[%selection_storage_bytes]xi8>
    %selections = check.tensor.view %selections_storage offset(16) : tensor<[%selection_storage_bytes]xi8> -> tensor<[%selection_bytes]xi8>
    %base = check.generate.fill value(19789) : tensor<[%output_words]xi16>
    %low = check.generate.fill value(19789) : tensor<[%low_words]xi16>
    %output = check.generate.fill value(19789) : tensor<[%output_words]xi16>
    %low_values = check.tensor.view %low offset(0) : tensor<[%low_words]xi16> -> tensor<[%low_words]xbf16>
    %output_values = check.tensor.view %output offset(0) : tensor<[%output_words]xi16> -> tensor<[%output_words]xbf16>
    check.generate<@initialize_adapter_matrix>(%group, %configuration, %input, %down, %up, %selections, %base) : (index, index, tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>) -> ()
    check.compare<@adapter_matrix_program, @adapter_matrix_reference>[%group, %configuration](%input, %down, %up, %selections, %base, %low, %output) : [index, index](tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>, tensor<[%low_words]xi16>, tensor<[%output_words]xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_bytes]xi8>
      check.expect.bitwise actual(%down) expected(%down) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%up) expected(%up) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%selections_storage) expected(%selections_storage) : tensor<[%selection_storage_bytes]xi8>
      check.expect.bitwise actual(%base) expected(%base) : tensor<[%output_words]xi16>
      check.expect.approximate actual(%low_values) expected(%low_values) atol(2.3484230041503906e-05) rtol(0.0) nan(different) : tensor<[%low_words]xbf16>, tensor<[%low_words]xbf16>
      check.expect.approximate actual(%output_values) expected(%output_values) atol(0.015625) rtol(0.0) nan(different) : tensor<[%output_words]xbf16>, tensor<[%output_words]xbf16>
    }
  }
  check.return
}

check.benchmark<@medium_reduction> @medium_reduction_benchmark

check.scenario public @wide_reduction configure[3](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %group = check.literal value(11) : index
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input_bytes, %factor_bytes, %selection_bytes, %selection_storage_bytes, %output_elements, %output_words, %low_elements, %low_words, %geometry, %selection = check.generate<@adapter_storage>(%group, %configuration) : (index, index) -> (index, index, index, index, index, index, index, index, index, index)
    %input = check.generate.fill value(77) : tensor<[%input_bytes]xi8>
    %down = check.generate.fill value(77) : tensor<[%factor_bytes]xi8>
    %up = check.generate.fill value(77) : tensor<[%factor_bytes]xi8>
    %selections_storage = check.generate.fill value(77) : tensor<[%selection_storage_bytes]xi8>
    %selections = check.tensor.view %selections_storage offset(16) : tensor<[%selection_storage_bytes]xi8> -> tensor<[%selection_bytes]xi8>
    %base = check.generate.fill value(19789) : tensor<[%output_words]xi16>
    %low = check.generate.fill value(19789) : tensor<[%low_words]xi16>
    %output = check.generate.fill value(19789) : tensor<[%output_words]xi16>
    %low_values = check.tensor.view %low offset(0) : tensor<[%low_words]xi16> -> tensor<[%low_words]xbf16>
    %output_values = check.tensor.view %output offset(0) : tensor<[%output_words]xi16> -> tensor<[%output_words]xbf16>
    check.generate<@initialize_adapter_matrix>(%group, %configuration, %input, %down, %up, %selections, %base) : (index, index, tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>) -> ()
    check.compare<@adapter_matrix_program, @adapter_matrix_reference>[%group, %configuration](%input, %down, %up, %selections, %base, %low, %output) : [index, index](tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>, tensor<[%low_words]xi16>, tensor<[%output_words]xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_bytes]xi8>
      check.expect.bitwise actual(%down) expected(%down) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%up) expected(%up) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%selections_storage) expected(%selections_storage) : tensor<[%selection_storage_bytes]xi8>
      check.expect.bitwise actual(%base) expected(%base) : tensor<[%output_words]xi16>
      check.expect.approximate actual(%low_values) expected(%low_values) atol(0.00048828125) rtol(0.0) nan(different) : tensor<[%low_words]xbf16>, tensor<[%low_words]xbf16>
      check.expect.approximate actual(%output_values) expected(%output_values) atol(0.015625) rtol(0.0) nan(different) : tensor<[%output_words]xbf16>, tensor<[%output_words]xbf16>
    }
  }
  check.return
}

