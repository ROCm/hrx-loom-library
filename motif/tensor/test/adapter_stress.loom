    %output_values = check.tensor.view %output offset(0) : tensor<[%output_words]xi16> -> tensor<[%output_words]xbf16>
    check.generate<@initialize_adapter_matrix>(%group, %configuration, %input, %down, %up, %selections, %base) : (index, index, tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>) -> ()
    check.compare<@adapter_matrix_program, @adapter_matrix_reference>[%group, %configuration](%input, %down, %up, %selections, %base, %low, %output) : [index, index](tensor<[%input_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%factor_bytes]xi8>, tensor<[%selection_bytes]xi8>, tensor<[%output_words]xi16>, tensor<[%low_words]xi16>, tensor<[%output_words]xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_bytes]xi8>
      check.expect.bitwise actual(%down) expected(%down) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%up) expected(%up) : tensor<[%factor_bytes]xi8>
      check.expect.bitwise actual(%selections_storage) expected(%selections_storage) : tensor<[%selection_storage_bytes]xi8>
      check.expect.bitwise actual(%base) expected(%base) : tensor<[%output_words]xi16>
      check.expect.approximate actual(%low_values) expected(%low_values) atol(0.001953125) rtol(0.0) nan(different) : tensor<[%low_words]xbf16>, tensor<[%low_words]xbf16>
      check.expect.approximate actual(%output_values) expected(%output_values) atol(0.0546875) rtol(0.0) nan(different) : tensor<[%output_words]xbf16>, tensor<[%output_words]xbf16>
    }
  }
  check.return
}

