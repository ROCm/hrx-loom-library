// Runtime selections shared by the adapter tests. Records contain an I64 bank
// byte offset and an F32 strength, with a sixteen-byte header and record stride.
// Duplicates retain their independent strengths and order. Signed zero and
// fractional strengths exercise arithmetic boundaries independently of shapes.

func.def pure @adapter_selection_count(%selection: index, %banks: index) -> (index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %count = scf.lookup %selection {
    0 = (%c0),
    1 = (%c1),
    2 = (%c2),
    4 = (%c2),
    5 = (%c4),
    6 = (%banks),
    10 = (%c2)
  } default(%c3) : index
  func.return %count : index
}

func.def @adapter_selection_value(%selection: index, %ordinal: index, %exact: i1) -> (index, f32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c0n_f32 = scalar.constant -0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c1n_f32 = scalar.constant -1.0 : f32
  %half = scalar.constant 0.5 : f32
  %negative_half = scalar.constant -0.5 : f32
  %quarter = scalar.constant 0.25 : f32
  %three_quarters = scalar.constant 0.75 : f32
  %negative_three_quarters = scalar.constant -0.75 : f32
  %three_tenths = scalar.constant 0.29999999999999999 : f32
  %seven_tenths = scalar.constant 0.69999999999999996 : f32
  %negative_five_eighths = scalar.constant -0.625 : f32
  %bank, %strength = scf.switch %selection -> (index, f32) {
    case 1 {
      scf.yield %c3, %half : index, f32
    }
    case 2 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c1, %negative_three_quarters)
      } default(%c5, %c1_f32) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    case 4 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c1, %quarter)
      } default(%c3, %c1n_f32) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    case 5 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c0, %c1_f32),
        1 = (%c2, %negative_half),
        2 = (%c4, %quarter)
      } default(%c6, %three_quarters) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    case 6 {
      %phase = index.rem %ordinal, %c3 : index
      %strength = scf.lookup %phase {
        0 = (%c1_f32),
        1 = (%negative_half)
      } default(%quarter) : f32
      scf.yield %ordinal, %strength : index, f32
    }
    case 7 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c2, %three_quarters),
        1 = (%c0, %c1_f32)
      } default(%c1, %negative_half) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    case 8 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c1, %c0_f32),
        1 = (%c6, %c0n_f32)
      } default(%c4, %c0_f32) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    case 9 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c1, %quarter),
        1 = (%c3, %c1n_f32)
      } default(%c1, %three_quarters) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    case 10 {
      %first = index.cmp eq, %ordinal, %c0 : index
      %strength = scf.select %first, %c1_f32, %c1n_f32 : f32
      scf.yield %c1, %strength : index, f32
    }
    case 11 {
      %bank, %strength = scf.lookup %ordinal {
        0 = (%c1, %three_tenths),
        1 = (%c4, %seven_tenths)
      } default(%c6, %negative_five_eighths) : index, f32
      scf.yield %bank, %strength : index, f32
    }
    default {
      %strength = scf.lookup %ordinal {
        0 = (%c1_f32),
        1 = (%negative_half)
      } default(%three_quarters) : f32
      scf.yield %ordinal, %strength : index, f32
    }
  }
  %positive = scalar.absf %strength : f32
  %scale = scf.select %exact, %positive, %strength : f32
  func.return %bank, %scale : index, f32
}

func.def @initialize_adapter_selection(%selection: index, %banks: index, %stride: index, %exact: i1, %selections: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %records_origin = index.constant 16 : offset
  %strength_origin = index.constant 24 : offset
  %padding_origin = index.constant 28 : offset
  %offset_layout = encoding.layout.strided [2] : encoding<layout>
  %word_layout = encoding.layout.strided [4] : encoding<layout>
  %count = func.call pure @adapter_selection_count(%selection, %banks) : (index, index) -> (index)
  %count_word = index.cast %count : index to i32
  %header = buffer.view %selections[%origin] : buffer -> view<4xi32>
  view.store %count_word, %header[0] : i32, view<4xi32>
  view.store %c0_i32, %header[1] : i32, view<4xi32>
  view.store %c0_i32, %header[2] : i32, view<4xi32>
  view.store %c0_i32, %header[3] : i32, view<4xi32>
  %offsets = buffer.view %selections[%records_origin] : buffer -> view<[%count]xi64, %offset_layout>
  %strengths = buffer.view %selections[%strength_origin] : buffer -> view<[%count]xf32, %word_layout>
  %padding = buffer.view %selections[%padding_origin] : buffer -> view<[%count]xi32, %word_layout>
  scf.for %ordinal = [%c0 to %count step %c1] {
    %bank, %strength = func.call @adapter_selection_value(%selection, %ordinal, %exact) : (index, index, i1) -> (index, f32)
    %position = index.mul %bank, %stride : index
    %address = index.cast %position : index to i64
    view.store %address, %offsets[%ordinal] : i64, view<[%count]xi64, %offset_layout>
    view.store %strength, %strengths[%ordinal] : f32, view<[%count]xf32, %word_layout>
    view.store %c0_i32, %padding[%ordinal] : i32, view<[%count]xi32, %word_layout>
  }
  func.return
}
