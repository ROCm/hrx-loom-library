check.scenario public @negative160 {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(160) : index
  %heads = check.literal value(1) : index
  %pattern = check.literal value(2) : index
  %key_heads = check.literal value(1) : index
  %gated = check.literal value(false) : i1
  %causal = check.literal value(false) : i1
  %row_stride = check.literal value(128) : index
  %column_stride = check.literal value(1) : index
  %rounded = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_storage = check.generate.fill value(123.0) : tensor<20512xbf16>
    %query = check.tensor.view %query_storage offset(32) : tensor<20512xbf16> -> tensor<20480xbf16>
    %key_storage = check.generate.fill value(123.0) : tensor<20512xbf16>
    %key = check.tensor.view %key_storage offset(32) : tensor<20512xbf16> -> tensor<20480xbf16>
    %value_storage = check.generate.fill value(123.0) : tensor<20512xbf16>
    %value = check.tensor.view %value_storage offset(32) : tensor<20512xbf16> -> tensor<20480xbf16>
    %mask_storage = check.generate.fill value(123) : tensor<192xi8>
    %mask = check.tensor.view %mask_storage offset(16) : tensor<192xi8> -> tensor<160xi8>
    %gate_storage = check.generate.fill value(123.0) : tensor<20512xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<20512xbf16> -> tensor<20480xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<20512xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<20512xbf16> -> tensor<20480xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<20512xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(40992) : tensor<20512xbf16> -> tensor<16xbf16>
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<20480xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %input_scale, %query) : (tensor<20480xi32>, f32, tensor<20480xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<20480xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<20480xi32>, f32, tensor<20480xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<20480xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<20480xi32>, f32, tensor<20480xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<20480xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<20480xi32>, f32, tensor<20480xbf16>) -> ()
    check.generate<@initialize_expanded_identity>(%pattern, %query, %key, %value, %mask, %gate) : (index, tensor<20480xbf16>, tensor<20480xbf16>, tensor<20480xbf16>, tensor<160xi8>, tensor<20480xbf16>) -> ()
    check.compare<@expanded_attention_program, @reference_expanded_identity>[%tokens, %heads, %key_heads, %causal, %gated, %row_stride, %column_stride](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1, i1, index, index](tensor<5xi32>, tensor<20480xbf16>, tensor<20480xbf16>, tensor<20480xbf16>, tensor<160xi8>, tensor<20480xbf16>, tensor<20480xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20480xbf16>
