// Copyright 2026 AMD ROCm™ Software
// SPDX-License-Identifier: MIT

// Expanded attention covers causal and noncausal GQA, residual keys, common
// score offsets, and dense/padded/transposed V layouts. Dense F64 contraction
// and softmax remain independent of native centering and online recurrence.
// Directed probability and identity cases compare exactly; bounded scenario
// entropy exercises general scores under fixed numerical budgets and guards.
//
// The accuracy budget uses centered operand magnitudes, twenty-bit native
// contraction accuracy, F32 recurrence bounds, and 2^-16 per approximate
// exponential/reciprocal, followed by an explicit BF16 publication allowance.
// Directed probability cases stay away from rounding boundaries under that
// fixed budget. No tolerance is fitted to observed device errors.

amdgpu.target<gfx11-generic> @tensor_expanded_attention_rdna3

amdgpu.target<gfx11-generic> @expanded_attention_wave64 {subgroup_size = 64}

template.decl @attention.expanded_masked_gqa_128_bf16(%tokens: index, %query_heads: index, %key_value_heads: index, %causal: i1, %value_layout: encoding<layout>, %query: buffer, %key: buffer, %value: buffer, %mask: buffer) -> (vector<8xbf16>)

template.decl @attention.store_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %output: buffer)

template.decl @attention.gate_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %gate: buffer) -> (vector<8xbf16>)

func.decl @initialize_attention_samples(%samples: buffer, %scale: f32, %output: buffer)

func.decl @reference_attention_mean(%transposed: i1, %gated: i1, %value: buffer, %mask: buffer, %output: buffer)

func.decl @reference_bf16_bits(%value: f32) -> (i16)

func.decl @initialize_attention_options(%row_stride: index, %column_stride: index, %causal: i1, %gated: i1, %round_probability: i1, %parameters: buffer)

func.decl @initialize_attention_numerics(%pattern: index, %tile: index, %mask_begin: index, %mask_end: index, %mask_cycle: index, %parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer)

func.decl @attention_reference(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer)

// The negative-score pattern keeps the final, masked anchor key at zero and
// exposes only keys 64..95 with byte value 128. Its huge logits live entirely
// in channel 127. Single-key and zero patterns retain random unused operands.
func.def @initialize_expanded_identity(%pattern: index, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer) {
  %bytes = buffer.length %mask
  %tokens = index.cast %bytes : offset to index
  %query_bytes = buffer.length %query
  %query_length = index.cast %query_bytes : offset to index
  %element_bytes = index.constant 2 : index
  %row_bytes = index.mul %tokens, %element_bytes : index
  %query_width = index.div %query_length, %row_bytes : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %channels = index.constant 128 : index
  %last_channel = index.constant 127 : index
  %visible_begin = index.constant 64 : index
  %visible_end = index.constant 96 : index
  %last_token = index.sub %tokens, %c1 : index
  %single = index.cmp eq, %pattern, %c0 : index
  %zero = index.cmp eq, %pattern, %c1 : index
  %negative = index.cmp eq, %pattern, %c2 : index
  %constant_query = index.cmp ne, %pattern, %c0 : index
  %queries = buffer.view %query[%origin] : buffer -> view<[%tokens]x[%query_width]xi16>
  %keys = buffer.view %key[%origin] : buffer -> view<[%tokens]x128xi16>
  %values = buffer.view %value[%origin] : buffer -> view<[%tokens]x128xi16>
  %visibility = buffer.view %mask[%origin] : buffer -> view<[%tokens]xi8>
  %unset = scalar.constant 0 : i8
  %enabled = scalar.constant 1 : i8
  %high_bit = scalar.constant -128 : i8
  %all_bits = scalar.constant -1 : i8
  %clear_bits = scalar.constant 0 : i16
  %unit_bits = scalar.constant 16256 : i16
  %huge = scalar.constant 72057594037927936.0 : f32
  %negative_huge = scalar.constant -72057594037927936.0 : f32
  %huge_word = func.call @reference_bf16_bits(%huge) : (f32) -> (i16)
  %negative_word = func.call @reference_bf16_bits(%negative_huge) : (f32) -> (i16)
  scf.for %row = [%c0 to %tokens step %c1] {
    %last = index.cmp eq, %row, %last_token : index
    %after_begin = index.cmp uge, %row, %visible_begin : index
    %before_end = index.cmp ult, %row, %visible_end : index
    %visible = scalar.andi %after_begin, %before_end : i1
    %single_mask = scf.select %last, %all_bits, %unset : i8
    %negative_mask = scf.select %visible, %high_bit, %unset : i8
    %ordinary_mask = scf.select %negative, %negative_mask, %enabled : i8
    %mask_byte = scf.select %single, %single_mask, %ordinary_mask : i8
    view.store %mask_byte, %visibility[%row] : i8, view<[%tokens]xi8>
    scf.for %column = [%c0 to %query_width step %c1] {
      %channel = index.rem %column, %channels : index
      %active_channel = index.cmp eq, %channel, %last_channel : index
      %active = scalar.andi %negative, %active_channel : i1
      %query_word = scf.select %active, %huge_word, %clear_bits : i16
      scf.if %constant_query {
        view.store %query_word, %queries[%row, %column] : i16, view<[%tokens]x[%query_width]xi16>
      }
    }
    scf.for %channel = [%c0 to %channels step %c1] {
      scf.if %negative {
        %active_channel = index.cmp eq, %channel, %last_channel : index
        %directed_key = scf.select %active_channel, %negative_word, %clear_bits : i16
        %key_word = scf.select %last, %clear_bits, %directed_key : i16
        view.store %key_word, %keys[%row, %channel] : i16, view<[%tokens]x128xi16>
        view.store %unit_bits, %values[%row, %channel] : i16, view<[%tokens]x128xi16>
      }
      scf.if %zero {
        view.store %clear_bits, %values[%row, %channel] : i16, view<[%tokens]x128xi16>
      }
    }
  }
  func.return
}

kernel.def target(@expanded_attention_wave64) @apply_expanded_attention(%tokens: index, %heads: index) {
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %threads = index.constant 256 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%tokens_value: index, %heads_value: index, %key_heads_value: index, %causal: i1, %gated: i1, %row_stride: index, %column_stride: index, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %tokens = index.assume %tokens_value [ge(%tokens_value, 16), le(%tokens_value, 192), multiple_of(%tokens_value, 16)] : index
  %heads = index.assume %heads_value [ge(%heads_value, 1), le(%heads_value, 32)] : index
  %key_heads = index.assume %key_heads_value [ge(%key_heads_value, 1), le(%key_heads_value, 20)] : index
  %value_layout = encoding.layout.strided [%row_stride, %column_stride] : encoding<layout>
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %group = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %live_group = index.cmp ult, %group, %groups : index
  %live_head = index.cmp ult, %head, %heads : index
  %live = scalar.andi %live_group, %live_head : i1
  scf.if %live {
    %values = template.apply<@attention.expanded_masked_gqa_128_bf16>(%tokens, %heads, %key_heads, %causal, %value_layout, %query, %key, %value, %mask) : (index, index, index, i1, encoding<layout>, buffer, buffer, buffer, buffer) -> (vector<8xbf16>)
    %result = scf.if %gated -> (vector<8xbf16>) {
      %result = template.apply<@attention.gate_128_bf16>(%tokens, %heads, %values, %gate) : (index, index, vector<8xbf16>, buffer) -> (vector<8xbf16>)
      scf.yield %result : vector<8xbf16>
    } else {
      scf.yield %values : vector<8xbf16>
    }
    template.apply<@attention.store_128_bf16>(%tokens, %heads, %result, %output) : (index, index, vector<8xbf16>, buffer)
  }
  kernel.return
}

command.def @expanded_attention_program(%tokens: index, %heads: index, %key_heads: index, %causal: i1, %gated: i1, %row_stride: index, %column_stride: index) launch(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  kernel.launch @apply_expanded_attention[%tokens, %heads](%tokens, %heads, %key_heads, %causal, %gated, %row_stride, %column_stride, %query, %key, %value, %mask, %gate, %output) : [index, index](index, index, index, i1, i1, index, index, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @reference_expanded_identity(%parameters: buffer, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %transposed = scalar.constant false : i1
  %gated = scalar.constant false : i1
  func.call @reference_attention_mean(%transposed, %gated, %value, %mask, %output) : (i1, i1, buffer, buffer, buffer)
  func.return
}

check.scenario public @zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(16) : index
  %heads = check.literal value(4) : index
  %pattern = check.literal value(1) : index
  %key_heads = check.literal value(1) : index
  %gated = check.literal value(false) : i1
  %causal = check.literal value(false) : i1
  %row_stride = check.literal value(128) : index
  %column_stride = check.literal value(1) : index
  %rounded = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_storage = check.generate.fill value(123.0) : tensor<8224xbf16>
    %query = check.tensor.view %query_storage offset(32) : tensor<8224xbf16> -> tensor<8192xbf16>
    %key_storage = check.generate.fill value(123.0) : tensor<2080xbf16>
    %key = check.tensor.view %key_storage offset(32) : tensor<2080xbf16> -> tensor<2048xbf16>
    %value_storage = check.generate.fill value(123.0) : tensor<2080xbf16>
    %value = check.tensor.view %value_storage offset(32) : tensor<2080xbf16> -> tensor<2048xbf16>
    %mask_storage = check.generate.fill value(123) : tensor<48xi8>
    %mask = check.tensor.view %mask_storage offset(16) : tensor<48xi8> -> tensor<16xi8>
    %gate_storage = check.generate.fill value(123.0) : tensor<8224xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<8224xbf16> -> tensor<8192xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<8224xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<8224xbf16> -> tensor<8192xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<8224xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(16416) : tensor<8224xbf16> -> tensor<16xbf16>
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<8192xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %input_scale, %query) : (tensor<8192xi32>, f32, tensor<8192xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<2048xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<2048xi32>, f32, tensor<2048xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<2048xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<2048xi32>, f32, tensor<2048xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<8192xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<8192xi32>, f32, tensor<8192xbf16>) -> ()
    check.generate<@initialize_expanded_identity>(%pattern, %query, %key, %value, %mask, %gate) : (index, tensor<8192xbf16>, tensor<2048xbf16>, tensor<2048xbf16>, tensor<16xi8>, tensor<8192xbf16>) -> ()
    check.compare<@expanded_attention_program, @reference_expanded_identity>[%tokens, %heads, %key_heads, %causal, %gated, %row_stride, %column_stride](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1, i1, index, index](tensor<5xi32>, tensor<8192xbf16>, tensor<2048xbf16>, tensor<2048xbf16>, tensor<16xi8>, tensor<8192xbf16>, tensor<8192xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8192xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<5xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<8224xbf16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<2080xbf16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<2080xbf16>
      check.expect.bitwise actual(%mask_storage) expected(%mask_storage) : tensor<48xi8>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<8224xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

check.benchmark<@zero> @zero_benchmark

check.scenario public @single80 {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %tokens = check.literal value(80) : index
  %heads = check.literal value(1) : index
  %pattern = check.literal value(0) : index
  %key_heads = check.literal value(1) : index
  %gated = check.literal value(false) : i1
  %causal = check.literal value(false) : i1
  %row_stride = check.literal value(128) : index
  %column_stride = check.literal value(1) : index
  %rounded = check.literal value(false) : i1
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %parameters = check.generate.fill value(0) : tensor<5xi32>
    check.generate<@initialize_attention_options>(%row_stride, %column_stride, %causal, %gated, %rounded, %parameters) : (index, index, i1, i1, i1, tensor<5xi32>) -> ()
    %query_storage = check.generate.fill value(123.0) : tensor<10272xbf16>
    %query = check.tensor.view %query_storage offset(32) : tensor<10272xbf16> -> tensor<10240xbf16>
    %key_storage = check.generate.fill value(123.0) : tensor<10272xbf16>
    %key = check.tensor.view %key_storage offset(32) : tensor<10272xbf16> -> tensor<10240xbf16>
    %value_storage = check.generate.fill value(123.0) : tensor<10272xbf16>
    %value = check.tensor.view %value_storage offset(32) : tensor<10272xbf16> -> tensor<10240xbf16>
    %mask_storage = check.generate.fill value(123) : tensor<112xi8>
    %mask = check.tensor.view %mask_storage offset(16) : tensor<112xi8> -> tensor<80xi8>
    %gate_storage = check.generate.fill value(123.0) : tensor<10272xbf16>
    %gate = check.tensor.view %gate_storage offset(32) : tensor<10272xbf16> -> tensor<10240xbf16>
    %output_storage = check.generate.fill value(123.0) : tensor<10272xbf16>
    %output = check.tensor.view %output_storage offset(32) : tensor<10272xbf16> -> tensor<10240xbf16>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<10272xbf16> -> tensor<16xbf16>
    %suffix = check.tensor.view %output_storage offset(20512) : tensor<10272xbf16> -> tensor<16xbf16>
    %input_scale = check.literal value(0.0078125) : f32
    %gate_scale = check.literal value(0.0625) : f32
    %query_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %query_samples = check.generate.random.uniform seed(%query_seed) range(-127 to 127) : tensor<10240xi32>
    check.generate<@initialize_attention_samples>(%query_samples, %input_scale, %query) : (tensor<10240xi32>, f32, tensor<10240xbf16>) -> ()
    %key_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %key_samples = check.generate.random.uniform seed(%key_seed) range(-127 to 127) : tensor<10240xi32>
    check.generate<@initialize_attention_samples>(%key_samples, %input_scale, %key) : (tensor<10240xi32>, f32, tensor<10240xbf16>) -> ()
    %value_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value_samples = check.generate.random.uniform seed(%value_seed) range(-127 to 127) : tensor<10240xi32>
    check.generate<@initialize_attention_samples>(%value_samples, %input_scale, %value) : (tensor<10240xi32>, f32, tensor<10240xbf16>) -> ()
    %gate_seed = check.entropy.read %entropy[3] : check.entropy -> i64
    %gate_samples = check.generate.random.uniform seed(%gate_seed) range(-64 to 64) : tensor<10240xi32>
    check.generate<@initialize_attention_samples>(%gate_samples, %gate_scale, %gate) : (tensor<10240xi32>, f32, tensor<10240xbf16>) -> ()
    check.generate<@initialize_expanded_identity>(%pattern, %query, %key, %value, %mask, %gate) : (index, tensor<10240xbf16>, tensor<10240xbf16>, tensor<10240xbf16>, tensor<80xi8>, tensor<10240xbf16>) -> ()
    check.compare<@expanded_attention_program, @reference_expanded_identity>[%tokens, %heads, %key_heads, %causal, %gated, %row_stride, %column_stride](%parameters, %query, %key, %value, %mask, %gate, %output) : [index, index, index, i1, i1, index, index](tensor<5xi32>, tensor<10240xbf16>, tensor<10240xbf16>, tensor<10240xbf16>, tensor<80xi8>, tensor<10240xbf16>, tensor<10240xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<10240xbf16>
      check.expect.bitwise actual(%parameters) expected(%parameters) : tensor<5xi32>
      check.expect.bitwise actual(%query_storage) expected(%query_storage) : tensor<10272xbf16>
      check.expect.bitwise actual(%key_storage) expected(%key_storage) : tensor<10272xbf16>
      check.expect.bitwise actual(%value_storage) expected(%value_storage) : tensor<10272xbf16>
      check.expect.bitwise actual(%mask_storage) expected(%mask_storage) : tensor<112xi8>
      check.expect.bitwise actual(%gate_storage) expected(%gate_storage) : tensor<10272xbf16>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xbf16>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xbf16>
    }
  }
  check.return
}

