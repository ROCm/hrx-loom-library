// Runtime BF16 arithmetic against independently authored numerical answers.
// Activation answers use binary64 libm; rounded residual/Euler answers use
// exact rationals with ties-to-even at each specified storage boundary.

amdgpu.target<gfx11-generic> @pointwise_wave32 {subgroup_size = 32}

template.decl @activation.silu_bf16(%value: bf16) -> (bf16)

template.decl @activation.gelu_bf16(%value: bf16) -> (bf16)

template.decl @residual.gated_bf16(%value: bf16, %update: bf16, %gate: bf16) -> (bf16)

template.decl @diffusion.euler_bf16(%sample: bf16, %velocity: bf16, %delta: f32) -> (bf16)

// BEGIN GENERATED POINTWISE ORACLE
global.rodata.def @activation_inputs = align(4) bytes("")

global.rodata.def @activation_expected = align(4) bytes("")

global.rodata.def @residual_inputs = align(4) bytes("")

global.rodata.def @residual_expected = align(4) bytes("")

global.rodata.def @euler_inputs = align(4) bytes("")

global.rodata.def @euler_expected = align(4) bytes("")

// END GENERATED POINTWISE ORACLE
kernel.def target(@pointwise_wave32) @activation_values() {
  %unit = index.constant 1 : index
  %groups = index.constant 5 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: buffer, %outputs: buffer) {
  %threads = index.constant 64 : index
  %rows = index.constant 265 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %input = buffer.view %inputs[%origin] : buffer -> view<265xf32>
    %output = buffer.view %outputs[%origin] : buffer -> view<265x2xf32>
    %stored = view.load %input[%row] : view<265xf32> -> f32
    %value = scalar.fptrunc %stored : f32 to bf16
    %silu = template.apply<@activation.silu_bf16>(%value) : (bf16) -> (bf16)
    %gelu = template.apply<@activation.gelu_bf16>(%value) : (bf16) -> (bf16)
    %silu32 = scalar.extf %silu : bf16 to f32
    %gelu32 = scalar.extf %gelu : bf16 to f32
    view.store %silu32, %output[%row, 0] : f32, view<265x2xf32>
    view.store %gelu32, %output[%row, 1] : f32, view<265x2xf32>
  }
  kernel.return
}

func.def @initialize_activation(%input: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 1060 : offset
  %values = global.load @activation_inputs : buffer
  buffer.copy %values[%origin], %input[%origin], %bytes
  func.return
}

func.def @reference_activation(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 2120 : offset
  %values = global.load @activation_expected : buffer
  buffer.copy %values[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @activation_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0.0) : tensor<265xf32>
    %output = check.generate.fill value(123.0) : tensor<265x2xf32>
    check.generate<@initialize_activation>(%input) : (tensor<265xf32>) -> ()
    check.compare<@activation_values, @reference_activation>(%input, %output) : (tensor<265xf32>, tensor<265x2xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(0.00390625) nan(same) : tensor<265x2xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<265xf32>
    }
  }
  check.return
}

check.benchmark<@activation_boundaries> @activation_runtime_values

kernel.def target(@pointwise_wave32) @residual_values() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: buffer, %outputs: buffer) {
  %threads = index.constant 64 : index
  %rows = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %input = buffer.view %inputs[%origin] : buffer -> view<128x3xf32>
    %output = buffer.view %outputs[%origin] : buffer -> view<128xf32>
    %first32 = view.load %input[%row, 0] : view<128x3xf32> -> f32
    %second32 = view.load %input[%row, 1] : view<128x3xf32> -> f32
    %third32 = view.load %input[%row, 2] : view<128x3xf32> -> f32
    %first = scalar.fptrunc %first32 : f32 to bf16
    %second = scalar.fptrunc %second32 : f32 to bf16
    %third = scalar.fptrunc %third32 : f32 to bf16
    %result = template.apply<@residual.gated_bf16>(%first, %second, %third) : (bf16, bf16, bf16) -> (bf16)
    %wide = scalar.extf %result : bf16 to f32
    view.store %wide, %output[%row] : f32, view<128xf32>
  }
  kernel.return
}

func.def @initialize_residual(%input: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 1536 : offset
  %values = global.load @residual_inputs : buffer
  buffer.copy %values[%origin], %input[%origin], %bytes
  func.return
}

func.def @reference_residual(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %values = global.load @residual_expected : buffer
  buffer.copy %values[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @residual_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0.0) : tensor<128x3xf32>
    %output = check.generate.fill value(123.0) : tensor<128xf32>
    check.generate<@initialize_residual>(%input) : (tensor<128x3xf32>) -> ()
    check.compare<@residual_values, @reference_residual>(%input, %output) : (tensor<128x3xf32>, tensor<128xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<128x3xf32>
    }
  }
  check.return
}

check.benchmark<@residual_boundaries> @residual_runtime_values

kernel.def target(@pointwise_wave32) @euler_values() {
  %unit = index.constant 1 : index
  %groups = index.constant 3 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: buffer, %outputs: buffer) {
  %threads = index.constant 64 : index
  %rows = index.constant 132 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %input = buffer.view %inputs[%origin] : buffer -> view<132x3xf32>
    %output = buffer.view %outputs[%origin] : buffer -> view<132xf32>
    %first32 = view.load %input[%row, 0] : view<132x3xf32> -> f32
    %second32 = view.load %input[%row, 1] : view<132x3xf32> -> f32
    %third32 = view.load %input[%row, 2] : view<132x3xf32> -> f32
    %first = scalar.fptrunc %first32 : f32 to bf16
    %second = scalar.fptrunc %second32 : f32 to bf16
    %result = template.apply<@diffusion.euler_bf16>(%first, %second, %third32) : (bf16, bf16, f32) -> (bf16)
    %wide = scalar.extf %result : bf16 to f32
    view.store %wide, %output[%row] : f32, view<132xf32>
  }
  kernel.return
}

func.def @initialize_euler(%input: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 1584 : offset
  %values = global.load @euler_inputs : buffer
  buffer.copy %values[%origin], %input[%origin], %bytes
  func.return
}

func.def @reference_euler(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 528 : offset
  %values = global.load @euler_expected : buffer
  buffer.copy %values[%origin], %output[%origin], %bytes
  func.return
}

check.scenario public @euler_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0.0) : tensor<132x3xf32>
    %output = check.generate.fill value(123.0) : tensor<132xf32>
    check.generate<@initialize_euler>(%input) : (tensor<132x3xf32>) -> ()
    check.compare<@euler_values, @reference_euler>(%input, %output) : (tensor<132x3xf32>, tensor<132xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<132xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<132x3xf32>
    }
  }
  check.return
}

check.benchmark<@euler_boundaries> @euler_runtime_values
