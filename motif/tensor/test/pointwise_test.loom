// BF16 activations use independent F64 SiLU and tanh-GELU expressions.
// Residual and Euler checks construct midpoint, cancellation, signed-time-step,
// and random inputs in IR. Their oracle uses exact F64 products, the specified
// F32 intermediate, and integer BF16 rounding without production templates.

amdgpu.target<gfx11-generic> @pointwise_wave32 {subgroup_size = 32}

template.decl @activation.silu_bf16(%value: bf16) -> (bf16)

template.decl @activation.gelu_bf16(%value: bf16) -> (bf16)

template.decl @residual.gated_bf16(%value: bf16, %update: bf16, %gate: bf16) -> (bf16)

template.decl @diffusion.euler_bf16(%sample: bf16, %velocity: bf16, %delta: f32) -> (bf16)

func.decl @reference_bf16_round(%value: f32) -> (f32)

// Boundary rows enumerate signs, cancellation, midpoint parity, and time-step
// precision. The remaining rows start with scenario-owned uniform entropy.
func.def @initialize_update_inputs(%euler: i1, %count: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c10 = index.constant 10 : index
  %c20 = index.constant 20 : index
  %boundary_count = index.constant 80 : index
  %random_end = index.constant 128 : index
  %unit = scalar.constant 1.0 : f32
  %negative = scalar.constant -1.0 : f32
  %half = scalar.constant 0.5 : f32
  %one_and_half = scalar.constant 1.5 : f32
  %negative_one_and_half = scalar.constant -1.5 : f32
  %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xf32>
  scf.for %row = [%c0 to %count step %c1] {
    %boundary = index.cmp ult, %row, %boundary_count : index
    %sample, %velocity, %delta = scf.if %boundary -> (f32, f32, f32) {
      %sample, %velocity, %delta = scf.if %euler -> (f32, f32, f32) {
        %ordinal = index.div %row, %c20 : index
        %odd = index.madd %ordinal, %c2, %c1 : index
        %integer = index.cast %odd : index to i32
        %fraction = scalar.uitofp %integer : i32 to f32
        %spacing = scalar.constant 0.0009765625 : f32
        %part = scalar.mulf %fraction, %spacing : f32
        %magnitude = scalar.addf %unit, %part : f32
        %within = index.rem %row, %c20 : index
        %negative_delta = index.cmp ult, %within, %c10 : index
        %sign = scf.select %negative_delta, %negative, %unit : f32
        %delta = scalar.mulf %sign, %magnitude : f32
        %pair = index.div %row, %c2 : index
        %sample_index = index.rem %pair, %c5 : index
        %sample_integer = index.cast %sample_index : index to i32
        %center = scalar.constant 2 : i32
        %centered = scalar.subi %sample_integer, %center : i32
        %wide = scalar.sitofp %centered : i32 to f32
        %middle = scalar.mulf %wide, %half : f32
        %first = index.cmp eq, %sample_index, %c0 : index
        %last = index.cmp eq, %sample_index, %c4 : index
        %low = scf.select %first, %negative_one_and_half, %middle : f32
        %sample = scf.select %last, %one_and_half, %low : f32
        %parity = index.rem %row, %c2 : index
        %negative_velocity = index.cmp eq, %parity, %c0 : index
        %velocity = scf.select %negative_velocity, %negative_one_and_half, %one_and_half : f32
        scf.yield %sample, %velocity, %delta : f32, f32, f32
      } else {
        %ordinal = index.div %row, %c10 : index
        %early = index.cmp ult, %ordinal, %c4 : index
        %numerator = scf.if %early -> (index) {
          %odd = index.madd %ordinal, %c2, %c1 : index
          scf.yield %odd : index
        } else {
          %shift = index.cast %ordinal : index to i32
          %integer_one = scalar.constant 1 : i32
          %power = scalar.shli %integer_one, %shift : i32
          %odd = scalar.subi %power, %integer_one : i32
          %value = index.cast %odd : i32 to index
          scf.yield %value : index
        }
        %integer = index.cast %numerator : index to i32
        %fraction = scalar.uitofp %integer : i32 to f32
        %spacing = scalar.constant 0.0078125 : f32
        %part = scalar.mulf %fraction, %spacing : f32
        %magnitude = scalar.addf %unit, %part : f32
        %within = index.rem %row, %c10 : index
        %negative_velocity = index.cmp ult, %within, %c5 : index
        %sign = scf.select %negative_velocity, %negative, %unit : f32
        %velocity = scalar.mulf %sign, %magnitude : f32
        %sample_index = index.rem %row, %c5 : index
        %sample_integer = index.cast %sample_index : index to i32
        %center = scalar.constant 2 : i32
        %centered = scalar.subi %sample_integer, %center : i32
        %wide = scalar.sitofp %centered : i32 to f32
        %regular_sample = scalar.mulf %wide, %half : f32
        %product = scalar.mulf %velocity, %one_and_half : f32
        %rounded = func.call @reference_bf16_round(%product) : (f32) -> (f32)
        %canceling_sample = scalar.negf %rounded : f32
        %cancel = index.cmp eq, %sample_index, %c0 : index
        %sample = scf.select %cancel, %canceling_sample, %regular_sample : f32
        scf.yield %sample, %velocity, %one_and_half : f32, f32, f32
      }
      scf.yield %sample, %velocity, %delta : f32, f32, f32
    } else {
      %random = index.cmp ult, %row, %random_end : index
      %sample, %velocity, %delta = scf.if %random -> (f32, f32, f32) {
        %sample_unit = view.load %inputs[%row, 0] : view<[%count]x3xf32> -> f32
        %velocity_unit = view.load %inputs[%row, 1] : view<[%count]x3xf32> -> f32
        %delta_unit = view.load %inputs[%row, 2] : view<[%count]x3xf32> -> f32
        %value_range = scalar.constant 8.0 : f32
        %delta_range = scalar.constant 2.0 : f32
        %sample_value = scalar.mulf %sample_unit, %value_range : f32
        %velocity_value = scalar.mulf %velocity_unit, %value_range : f32
        %delta_value = scalar.mulf %delta_unit, %delta_range : f32
        %sample = func.call @reference_bf16_round(%sample_value) : (f32) -> (f32)
        %velocity = func.call @reference_bf16_round(%velocity_value) : (f32) -> (f32)
        %gate = func.call @reference_bf16_round(%delta_value) : (f32) -> (f32)
        %delta = scf.select %euler, %delta_value, %gate : f32
        scf.yield %sample, %velocity, %delta : f32, f32, f32
      } else {
        // Products adjacent to a BF16 midpoint first round to F32. These
        // distinguish two-stage rounding from direct F64-to-BF16 rounding.
        %first_target_end = index.constant 130 : index
        %first_target = index.cmp ult, %row, %first_target_end : index
        %even_midpoint = scalar.constant 1.00390625 : f64
        %odd_midpoint = scalar.constant 1.01171875 : f64
        %midpoint = scf.select %first_target, %even_midpoint, %odd_midpoint : f64
        %divisor = scalar.constant 1.5 : f64
        %quotient = scalar.divf %midpoint, %divisor : f64
        %delta_value = scalar.fptrunc %quotient : f64 to f32
        %bits = scalar.bitcast %delta_value : f32 to i32
        %parity = index.rem %row, %c2 : index
        %below = index.cmp eq, %parity, %c0 : index
        %previous_neighbor = scalar.constant -1 : i32
        %next_neighbor = scalar.constant 1 : i32
        %displacement = scf.select %below, %previous_neighbor, %next_neighbor : i32
        %neighbor_bits = scalar.addi %bits, %displacement : i32
        %delta = scalar.bitcast %neighbor_bits : i32 to f32
        scf.yield %negative, %one_and_half, %delta : f32, f32, f32
      }
      scf.yield %sample, %velocity, %delta : f32, f32, f32
    }
    view.store %sample, %inputs[%row, 0] : f32, view<[%count]x3xf32>
    view.store %velocity, %inputs[%row, 1] : f32, view<[%count]x3xf32>
    view.store %delta, %inputs[%row, 2] : f32, view<[%count]x3xf32>
  }
  func.return
}

// A BF16 velocity times an F32 delta is exact in F64. Retain the specified
// F32 rounding before applying integer-bit BF16 rounding at each boundary.
func.def @reference_updates(%count: index, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<[%count]x3xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<[%count]xf32>
  scf.for %row = [%c0 to %count step %c1] {
    %sample = view.load %inputs[%row, 0] : view<[%count]x3xf32> -> f32
    %velocity = view.load %inputs[%row, 1] : view<[%count]x3xf32> -> f32
    %delta = view.load %inputs[%row, 2] : view<[%count]x3xf32> -> f32
    %sample64 = scalar.extf %sample : f32 to f64
    %velocity64 = scalar.extf %velocity : f32 to f64
    %delta64 = scalar.extf %delta : f32 to f64
    %product64 = scalar.mulf %velocity64, %delta64 : f64
    %product32 = scalar.fptrunc %product64 : f64 to f32
    %update = func.call @reference_bf16_round(%product32) : (f32) -> (f32)
    %update64 = scalar.extf %update : f32 to f64
    %sum64 = scalar.addf %sample64, %update64 : f64
    %sum32 = scalar.fptrunc %sum64 : f64 to f32
    %result = func.call @reference_bf16_round(%sum32) : (f32) -> (f32)
    view.store %result, %outputs[%row] : f32, view<[%count]xf32>
  }
  func.return
}

kernel.def target(@pointwise_wave32) @activation_values() {
  %unit = index.constant 1 : index
  %groups = index.constant 5 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: buffer, %outputs: buffer) {
  %threads = index.constant 64 : index
  %rows = index.constant 265 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %input = buffer.view %inputs[%origin] : buffer -> view<265xf32>
    %output = buffer.view %outputs[%origin] : buffer -> view<265x2xf32>
    %stored = view.load %input[%row] : view<265xf32> -> f32
    %value = scalar.fptrunc %stored : f32 to bf16
    %silu = template.apply<@activation.silu_bf16>(%value) : (bf16) -> (bf16)
    %gelu = template.apply<@activation.gelu_bf16>(%value) : (bf16) -> (bf16)
    %silu32 = scalar.extf %silu : bf16 to f32
    %gelu32 = scalar.extf %gelu : bf16 to f32
    view.store %silu32, %output[%row, 0] : f32, view<265x2xf32>
    view.store %gelu32, %output[%row, 1] : f32, view<265x2xf32>
  }
  kernel.return
}

func.def @initialize_activation(%input: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<265xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %regular_count = index.constant 257 : index
  %count = index.constant 265 : index
  %c128_f32 = scalar.constant 128.0 : f32
  %eighth = scalar.constant 0.125 : f32
  %tiny = scalar.constant 9.5367431640625e-07 : f32
  %negative_tiny = scalar.constant -9.5367431640625e-07 : f32
  %small = scalar.constant 0.00390625 : f32
  %negative_small = scalar.constant -0.00390625 : f32
  %silu_lower = scalar.constant -1.28125 : f32
  %silu_upper = scalar.constant -1.2734375 : f32
  %gelu_lower = scalar.constant -0.75390625 : f32
  %gelu_upper = scalar.constant -0.75 : f32
  scf.for %i = [%c0 to %count step %c1] {
    %regular = index.cmp ult, %i, %regular_count : index
    %value = scf.if %regular -> (f32) {
      %word = index.cast %i : index to i32
      %number = scalar.uitofp %word : i32 to f32
      %centered = scalar.subf %number, %c128_f32 : f32
      %value = scalar.mulf %centered, %eighth : f32
      scf.yield %value : f32
    } else {
      %extra = index.sub %i, %regular_count : index
      %value = scf.lookup %extra {
        0 = (%negative_tiny),
        1 = (%tiny),
        2 = (%negative_small),
        3 = (%small),
        4 = (%silu_lower),
        5 = (%silu_upper),
        6 = (%gelu_lower)
      } default(%gelu_upper) : f32
      scf.yield %value : f32
    }
    view.store %value, %inputs[%i] : f32, view<265xf32>
  }
  func.return
}

func.def @reference_activation(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<265xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<265x2xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 265 : index
  %c1_f64 = scalar.constant 1.0 : f64
  %c2_f64 = scalar.constant 2.0 : f64
  %pi = scalar.constant 3.1415926535897931 : f64
  %cubic_scale = scalar.constant 0.044714999999999998 : f64
  %variance = scalar.divf %c2_f64, %pi : f64
  %scale = scalar.sqrtf %variance : f64
  scf.for %i = [%c0 to %count step %c1] {
    %stored = view.load %inputs[%i] : view<265xf32> -> f32
    %value = scalar.extf %stored : f32 to f64
    %negative = scalar.negf %value : f64
    %exponential = scalar.expf %negative : f64
    %denominator = scalar.addf %c1_f64, %exponential : f64
    %silu = scalar.divf %value, %denominator : f64
    %square = scalar.mulf %value, %value : f64
    %cube = scalar.mulf %square, %value : f64
    %cubic = scalar.mulf %cubic_scale, %cube : f64
    %polynomial = scalar.addf %value, %cubic : f64
    %argument = scalar.mulf %scale, %polynomial : f64
    %tangent = scalar.tanhf %argument : f64
    %shifted = scalar.addf %c1_f64, %tangent : f64
    %product = scalar.mulf %value, %shifted : f64
    %gelu = scalar.divf %product, %c2_f64 : f64
    %silu_f32 = scalar.fptrunc %silu : f64 to f32
    %gelu_f32 = scalar.fptrunc %gelu : f64 to f32
    view.store %silu_f32, %outputs[%i, 0] : f32, view<265x2xf32>
    view.store %gelu_f32, %outputs[%i, 1] : f32, view<265x2xf32>
  }
  func.return
}

check.scenario public @activation_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0.0) : tensor<265xf32>
    %output = check.generate.fill value(123.0) : tensor<265x2xf32>
    check.generate<@initialize_activation>(%input) : (tensor<265xf32>) -> ()
    check.compare<@activation_values, @reference_activation>(%input, %output) : (tensor<265xf32>, tensor<265x2xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(0.00390625) nan(same) : tensor<265x2xf32>, tensor<265x2xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<265xf32>
    }
  }
  check.return
}

check.benchmark<@activation_boundaries> @activation_runtime_values

kernel.def target(@pointwise_wave32) @residual_values() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: buffer, %outputs: buffer) {
  %threads = index.constant 64 : index
  %rows = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %input = buffer.view %inputs[%origin] : buffer -> view<128x3xf32>
    %output = buffer.view %outputs[%origin] : buffer -> view<128xf32>
    %first32 = view.load %input[%row, 0] : view<128x3xf32> -> f32
    %second32 = view.load %input[%row, 1] : view<128x3xf32> -> f32
    %third32 = view.load %input[%row, 2] : view<128x3xf32> -> f32
    %first = scalar.fptrunc %first32 : f32 to bf16
    %second = scalar.fptrunc %second32 : f32 to bf16
    %third = scalar.fptrunc %third32 : f32 to bf16
    %result = template.apply<@residual.gated_bf16>(%first, %second, %third) : (bf16, bf16, bf16) -> (bf16)
    %wide = scalar.extf %result : bf16 to f32
    view.store %wide, %output[%row] : f32, view<128xf32>
  }
  kernel.return
}

func.def @initialize_residual(%input: buffer) {
  %euler = scalar.constant false : i1
  %count = index.constant 128 : index
  func.call @initialize_update_inputs(%euler, %count, %input) : (i1, index, buffer)
  func.return
}

func.def @reference_residual(%input: buffer, %output: buffer) {
  %count = index.constant 128 : index
  func.call @reference_updates(%count, %input, %output) : (index, buffer, buffer)
  func.return
}

check.scenario public @residual_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<128x3xf32>
    %output = check.generate.fill value(123.0) : tensor<128xf32>
    check.generate<@initialize_residual>(%input) : (tensor<128x3xf32>) -> ()
    check.compare<@residual_values, @reference_residual>(%input, %output) : (tensor<128x3xf32>, tensor<128xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<128x3xf32>
    }
  }
  check.return
}

check.benchmark<@residual_boundaries> @residual_runtime_values

kernel.def target(@pointwise_wave32) @euler_values() {
  %unit = index.constant 1 : index
  %groups = index.constant 3 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%inputs: buffer, %outputs: buffer) {
  %threads = index.constant 64 : index
  %rows = index.constant 132 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %row = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %input = buffer.view %inputs[%origin] : buffer -> view<132x3xf32>
    %output = buffer.view %outputs[%origin] : buffer -> view<132xf32>
    %first32 = view.load %input[%row, 0] : view<132x3xf32> -> f32
    %second32 = view.load %input[%row, 1] : view<132x3xf32> -> f32
    %third32 = view.load %input[%row, 2] : view<132x3xf32> -> f32
    %first = scalar.fptrunc %first32 : f32 to bf16
    %second = scalar.fptrunc %second32 : f32 to bf16
    %result = template.apply<@diffusion.euler_bf16>(%first, %second, %third32) : (bf16, bf16, f32) -> (bf16)
    %wide = scalar.extf %result : bf16 to f32
    view.store %wide, %output[%row] : f32, view<132xf32>
  }
  kernel.return
}

func.def @initialize_euler(%input: buffer) {
  %euler = scalar.constant true : i1
  %count = index.constant 132 : index
  func.call @initialize_update_inputs(%euler, %count, %input) : (i1, index, buffer)
  func.return
}

func.def @reference_euler(%input: buffer, %output: buffer) {
  %count = index.constant 132 : index
  func.call @reference_updates(%count, %input, %output) : (index, buffer, buffer)
  func.return
}

check.scenario public @euler_boundaries {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<132x3xf32>
    %output = check.generate.fill value(123.0) : tensor<132xf32>
    check.generate<@initialize_euler>(%input) : (tensor<132x3xf32>) -> ()
    check.compare<@euler_values, @reference_euler>(%input, %output) : (tensor<132x3xf32>, tensor<132xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<132xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<132x3xf32>
    }
  }
  check.return
}

check.benchmark<@euler_boundaries> @euler_runtime_values
