check.scenario public @sampling_beyond {
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %columns = check.literal value(67) : index
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %position = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.iota offset(-1.0) step(0.125) period(17) : tensor<67xf32>
    %output = check.generate.fill value(-1) : tensor<1xi32>
    %temperature = check.literal value(0.69999999999999996) : f32
    %top_p = check.literal value(0.72999999999999998) : f32
    %top_k = check.literal value(100) : i32
    check.compare<@sample, @reference>[%columns](%columns, %input, %temperature, %top_p, %top_k, %seed, %position, %output) : [index](index, tensor<67xf32>, f32, f32, i32, i64, i64, tensor<1xi32>) -> () {
      check.expect.equal actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}

// The first twenty repeated maxima are top-k; p=.95 retains nineteen of
// them. This analytic support avoids a quadratic oracle over the vocabulary.
func.def @vocabulary_reference(%columns: index, %logits: buffer, %temperature_argument: f32, %top_p: f32, %top_k: i32, %seed: i64, %position: i64, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c19 = index.constant 19 : index
  %period = scalar.constant 1009 : i32
  %first = scalar.constant 1008 : i32
  %negative = scalar.constant -inf : f32
  %maximum_logit = scalar.constant 1.0 : f32
  %temperature = scalar.constant 0.69999999999999996 : f32
  %score, %winner = scf.for %i = [%c0 to %c19 step %c1](%best = %negative : f32, %id = %first : i32) -> (f32, i32) {
    %ordinal = index.cast %i : index to i32
    %offset = scalar.muli %ordinal, %period : i32
    %token = scalar.addi %first, %offset : i32
    %race = func.call @reference_race(%maximum_logit, %maximum_logit, %temperature, %seed, %position, %token) : (f32, f32, f32, i64, i64, i32) -> (f32)
    %better = scalar.cmpf ogt, %race, %best : f32
    %next = scf.select %better, %race, %best : f32
    %next_id = scf.select %better, %token, %id : i32
    scf.yield %next, %next_id : f32, i32
  }
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %winner, %result[0] : i32, view<1xi32>
  func.return
}

check.scenario public @sampling_vocabulary {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %columns = check.literal value(248320) : index
    %seed = check.literal value(1234567890123) : i64
    %position = check.literal value(1234) : i64
    %input = check.generate.iota offset(-1.0) step(0.001) period(1009) : tensor<248320xf32>
    %output = check.generate.fill value(-1) : tensor<1xi32>
    %temperature = check.literal value(0.69999999999999996) : f32
    %top_p = check.literal value(0.94999999999999996) : f32
    %top_k = check.literal value(20) : i32
    check.compare<@sample, @vocabulary_reference>[%columns](%columns, %input, %temperature, %top_p, %top_k, %seed, %position, %output) : [index](index, tensor<248320xf32>, f32, f32, i32, i64, i64, tensor<1xi32>) -> () {
      check.expect.equal actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}

check.benchmark<@sampling_vocabulary> @sampling_vocabulary_benchmark

// Independent libm answers span both logarithms used by the race oracle.
check.case public @reference_log_values {
  %input0 = check.literal value(2.9802322387695312e-08) : f64
  %actual0 = func.call @reference_log(%input0) : (f64) -> (f64)
  %expected0 = check.literal value(-17.328679513998633) : f64
  check.expect.approximate actual(%actual0) expected(%expected0) atol(1.0000000000000001e-15) rtol(2e-14) nan(different) : f64, f64
  %input1 = check.literal value(0.99999994039535522) : f64
  %actual1 = func.call @reference_log(%input1) : (f64) -> (f64)
  %expected1 = check.literal value(-5.9604646551747531e-08) : f64
  check.expect.approximate actual(%actual1) expected(%expected1) atol(1.0000000000000001e-15) rtol(2e-14) nan(different) : f64, f64
  %input2 = check.literal value(0.5) : f64
  %actual2 = func.call @reference_log(%input2) : (f64) -> (f64)
  %expected2 = check.literal value(-0.69314718055994529) : f64
  check.expect.approximate actual(%actual2) expected(%expected2) atol(1.0000000000000001e-15) rtol(2e-14) nan(different) : f64, f64
  %input3 = check.literal value(1.0) : f64
  %actual3 = func.call @reference_log(%input3) : (f64) -> (f64)
  %expected3 = check.literal value(0.0) : f64
  check.expect.approximate actual(%actual3) expected(%expected3) atol(1.0000000000000001e-15) rtol(2e-14) nan(different) : f64, f64
  %input4 = check.literal value(2.0) : f64
  %actual4 = func.call @reference_log(%input4) : (f64) -> (f64)
  %expected4 = check.literal value(0.69314718055994529) : f64
  check.expect.approximate actual(%actual4) expected(%expected4) atol(1.0000000000000001e-15) rtol(2e-14) nan(different) : f64, f64
  %input5 = check.literal value(0.123456789) : f64
  %actual5 = func.call @reference_log(%input5) : (f64) -> (f64)
  %expected5 = check.literal value(-2.0918640707783931) : f64
  check.expect.approximate actual(%actual5) expected(%expected5) atol(1.0000000000000001e-15) rtol(2e-14) nan(different) : f64, f64
  %input6 = check.literal value(17.328679513998633) : f64
  %actual6 = func.call @reference_log(%input6) : (f64) -> (f64)
  %expected6 = check.literal value(2.8523629042865366) : f64
