// Compare both supported lane-digit distances against a dense scalar H4 row.
// Exact dyadic inputs expose lane/component routing; full-allocation checks
// retain immutable inputs and both output guards. The input prefix records the
// distance for the reference without sharing the device's shuffle expressions.

amdgpu.target<gfx11-generic> @convrot_digit_wave32 {subgroup_size = 32}

template.decl @quantization.convrot_digit(%value: vector<8xf32>, %distance: i32) -> (vector<8xf32>)

func.decl @convrot_digit_reference(%input: buffer, %output: buffer)

template.decl @convrot_digit_distance(%configuration: index) -> (i32)

template.def<@convrot_digit_distance> @convrot_digit_distance_values(%configuration: index) -> (i32) {
  %c1 = scalar.constant 1 : i32
  %c4 = scalar.constant 4 : i32
  %distance = scf.lookup %configuration {
    0 = (%c1)
  } default(%c4) : i32
  template.return %distance : i32
}

func.def @initialize_convrot_digit(%configuration: index, %input: buffer) {
  %distance = template.apply<@convrot_digit_distance>(%configuration) : (index) -> (i32)
  %base = index.constant 0 : offset
  %origin = index.constant 64 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c13 = index.constant 13 : index
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %period = index.constant 127 : index
  %center = scalar.constant 63 : i32
  %scale = scalar.constant 0.125 : f32
  %header = buffer.view %input[%base] : buffer -> view<1xi32>
  view.store %distance, %header[0] : i32, view<1xi32>
  %values = buffer.view %input[%origin] : buffer -> view<32x8xf32>
  scf.for %lane = [%c0 to %c32 step %c1] {
    scf.for %component = [%c0 to %c8 step %c1] {
      %lane_part = index.mul %lane, %c17 : index
      %affine = index.madd %component, %c13, %lane_part : index
      %reduced = index.rem %affine, %period : index
      %word = index.cast %reduced : index to i32
      %signed = scalar.subi %word, %center : i32
      %integer = scalar.sitofp %signed : i32 to f32
      %value = scalar.mulf %integer, %scale : f32
      view.store %value, %values[%lane, %component] : f32, view<32x8xf32>
    }
  }
  func.return
}

kernel.def target(@convrot_digit_wave32) @apply_convrot_digit() {
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%distance: i32, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %lane = kernel.subgroup.lane.id : index
  %inputs = buffer.view %input[%origin] : buffer -> view<32x8xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<32x8xf32>
  %values = vector.load %inputs[%lane, 0] : view<32x8xf32> -> vector<8xf32>
  %transformed = template.apply<@quantization.convrot_digit>(%values, %distance) : (vector<8xf32>, i32) -> (vector<8xf32>)
  vector.store %transformed, %outputs[%lane, 0] : vector<8xf32>, view<32x8xf32>
  kernel.return
}

command.def @convrot_digit_program(%configuration: index) launch(%input: buffer, %output: buffer) {
  %distance = template.apply<@convrot_digit_distance>(%configuration) : (index) -> (i32)
  %origin = index.constant 64 : offset
  %values = buffer.view %input[%origin] : buffer -> view<32x8xf32>
  %results = buffer.view %output[%origin] : buffer -> view<32x8xf32>
  kernel.launch @apply_convrot_digit(%distance, %values, %results) : (i32, view<32x8xf32>, view<32x8xf32>)
  command.return
}

check.scenario public @convrot_digits configure[2](%configuration: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(123.25) : tensor<288xf32>
    %output = check.generate.fill value(123.25) : tensor<288xf32>
    check.generate<@initialize_convrot_digit>(%configuration, %input) : (index, tensor<288xf32>) -> ()
    check.compare<@convrot_digit_program, @convrot_digit_reference>[%configuration](%input, %output) : [index](tensor<288xf32>, tensor<288xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<288xf32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<288xf32>
    }
  }
  check.return
}

check.benchmark<@convrot_digits> @convrot_digits_benchmark
