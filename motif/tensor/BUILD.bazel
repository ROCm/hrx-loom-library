load("//build_tools/bazel:defs.bzl", "loom_motif_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "random.loom",
    "sampling.loom",
    "topk.loom",
])

loom_motif_library(
    name = "random",
    srcs = ["random.loom"],
)

loom_motif_library(
    name = "sampling",
    srcs = ["sampling.loom"],
    deps = [":random"],
)

loom_motif_library(
    name = "topk",
    srcs = ["topk.loom"],
)
