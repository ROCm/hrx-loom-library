// One BF16 Euler scheduler update with an F32 time delta.
// The velocity product evaluates in F32, rounds to BF16, and is added to
// the sample in F32 before a final BF16 rounding. Keeping the delta in F32
// and retaining the intermediate BF16 boundary are observable semantics.
// Inputs and arithmetic intermediates are finite. The caller supplies scalar
// values and owns tensor addressing, in-place storage, and launch geometry.
// Independent rational-rounding checks cover signed time steps, midpoint
// ties, cancellation, and differences from a single fused update.

template.decl @diffusion.euler_bf16(%sample: bf16, %velocity: bf16, %delta: f32) -> (bf16)

template.def<@diffusion.euler_bf16> @diffusion_euler_bf16(%sample: bf16, %velocity: bf16, %delta: f32) -> (bf16) {
  %previous = scalar.extf %sample : bf16 to f32
  %speed = scalar.extf %velocity : bf16 to f32
  %product = scalar.mulf %speed, %delta : f32
  %rounded = scalar.fptrunc %product : f32 to bf16
  %update = scalar.extf %rounded : bf16 to f32
  %sum = scalar.addf %previous, %update : f32
  %result = scalar.fptrunc %sum : f32 to bf16
  template.return %result : bf16
}
