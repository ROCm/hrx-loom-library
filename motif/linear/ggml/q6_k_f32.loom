template.def<@ggml.q6k.f32.single.body> device @ggml_q6k_f32_single_body(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 4)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 17408), multiple_of(%input_size, 256)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4_bytes = index.constant 4 : offset
  %c210_bytes = index.constant 210 : offset
  %c256 = index.constant 256 : index
  %row_tile = kernel.workgroup.id<x> : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %lane = kernel.subgroup.lane.id : index
  %row0 = index.mul %row_tile, %c2 : index
  %row1 = index.add %row0, %c1 : index
  %valid_row0 = index.cmp ult, %row0, %bounded_output_size : index
  %valid_row1 = index.cmp ult, %row1, %bounded_output_size : index
  %safe_row0_raw = scf.select %valid_row0, %row0, %c0 : index
  %safe_row1_raw = scf.select %valid_row1, %row1, %c0 : index
  %safe_row0 = index.assume %safe_row0_raw [lt(%safe_row0_raw, %bounded_output_size)] : index
  %safe_row1 = index.assume %safe_row1_raw [lt(%safe_row1_raw, %bounded_output_size)] : index
  %block_count = index.div %bounded_input_size, %c256 : index
  %weight_row_bytes = index.scale %block_count, %c210_bytes : index, offset -> offset
  %weight_row0_byte_base = index.scale %safe_row0, %weight_row_bytes : index, offset -> offset
  %weight_row1_byte_base = index.scale %safe_row1, %weight_row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %bounded_input_size, %c4_bytes : index, offset -> offset
  %input_row_byte_base = index.scale %token, %input_row_bytes : index, offset -> offset
  %lane_row0, %lane_row1 = scf.if %valid_row0 -> (f32, f32) {
    %value0, %value1 = func.call @ggml_q6k_f32_row_lane2(%bounded_input_size, %input_noalias, %input_row_byte_base, %weight_noalias, %weight_row0_byte_base, %weight_row1_byte_base, %lane) : (index, buffer, offset, buffer, offset, offset, index) -> (f32, f32)
    scf.yield %value0, %value1 : f32, f32
  } else {
    %c0_f32 = scalar.constant 0.0 : f32
    scf.yield %c0_f32, %c0_f32 : f32, f32
  }
  %dot0 = kernel.subgroup.reduce<addf> %lane_row0 : f32
  %dot1 = kernel.subgroup.reduce<addf> %lane_row1 : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
