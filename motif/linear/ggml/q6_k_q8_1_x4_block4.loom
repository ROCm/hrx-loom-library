      %high0 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row0_byte_base, %block0, %virtual_lane1) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %low1 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row1_byte_base, %block0, %virtual_lane0) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %high1 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row1_byte_base, %block0, %virtual_lane1) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %low2 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row2_byte_base, %block0, %virtual_lane0) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %high2 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row2_byte_base, %block0, %virtual_lane1) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %low3 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row3_byte_base, %block0, %virtual_lane0) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %high3 = func.call @ggml_q6k_q8_1_x4_block_lane(%weight, %weight_row_byte_base, %q8_input, %q8_row3_byte_base, %block0, %virtual_lane1) : (buffer, offset, buffer, offset, index, index) -> (f32)
      %value0 = scalar.addf<reassoc|nnan|ninf|nsz> %low0, %high0 : f32
      %value1 = scalar.addf<reassoc|nnan|ninf|nsz> %low1, %high1 : f32
      %value2 = scalar.addf<reassoc|nnan|ninf|nsz> %low2, %high2 : f32
      %value3 = scalar.addf<reassoc|nnan|ninf|nsz> %low3, %high3 : f32
      scf.yield %value0, %value1, %value2, %value3 : f32, f32, f32, f32
    } else {
      scf.yield %c0_f32, %c0_f32, %c0_f32, %c0_f32 : f32, f32, f32, f32
    }
    %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %row0_acc, %block_row0 : f32
    %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %row1_acc, %block_row1 : f32
    %next2 = scalar.addf<reassoc|nnan|ninf|nsz> %row2_acc, %block_row2 : f32
    %next3 = scalar.addf<reassoc|nnan|ninf|nsz> %row3_acc, %block_row3 : f32
    scf.yield %next0, %next1, %next2, %next3 : f32, f32, f32, f32
  }
  func.return %row0, %row1, %row2, %row3 : f32, f32, f32, f32
}

