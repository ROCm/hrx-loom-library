// Affine Q4_K/Q5_K half-group contraction against Q8_1 activations.
//
// Codes are nonnegative signed I8 values (0..31). Each invocation contracts
// sixteen values and applies half of the complete 32-value block's minimum
// correction. The caller pairs both halves before publishing a result. Q8's
// stored sum is used directly; it need not equal the rounded scale times the
// integer-code sum. Arithmetic is F32 with reassociation permitted.

template.decl @ggml.qk.unsigned_q8_1_dot(%quantized_values: vector<16xi8>, %d_scale: f32, %dmin_scale: f32, %q8_values: vector<16xi8>, %q8_d: f32, %q8_s: f32) -> (f32)

template.def<@ggml.qk.unsigned_q8_1_dot> device @ggml_qk_unsigned_q8_1_dot(%quantized_values: vector<16xi8>, %d_scale: f32, %dmin_scale: f32, %q8_values: vector<16xi8>, %q8_d: f32, %q8_s: f32) -> (f32) {
  %zero_integer = scalar.constant 0 : i32
  %zero_dots = vector.constant 0 : vector<4xi32>
  %half = scalar.constant 0.5 : f32
  %partial_dots = vector.dot4i<s8s8> %quantized_values, %q8_values, %zero_dots : vector<16xi8>, vector<16xi8>, vector<4xi32>
  %quantized_sum = vector.reduce<addi> %partial_dots, %zero_integer : vector<4xi32>, i32
  %quantized_sum_f32 = scalar.sitofp %quantized_sum : i32 to f32
  %scaled_dot0 = scalar.mulf<reassoc|nnan|ninf|nsz> %q8_d, %d_scale : f32
  %scaled_dot = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled_dot0, %quantized_sum_f32 : f32
  %q8_half_sum = scalar.mulf<reassoc|nnan|ninf|nsz> %q8_s, %half : f32
  %minimum_correction = scalar.mulf<reassoc|nnan|ninf|nsz> %dmin_scale, %q8_half_sum : f32
  %contribution = scalar.subf<reassoc|nnan|ninf|nsz> %scaled_dot, %minimum_correction : f32
  template.return %contribution : f32
}
