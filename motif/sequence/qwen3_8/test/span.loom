// Qwen sequence fields against arithmetic packing and explicit state coordinates.
// Metadata storage is compared completely, including unused records and guards.

amdgpu.target<gfx11-generic> @native

func.decl @qwen38_descriptor_pack(%source: i32, %selection: i32) -> (i32)

func.decl @qwen38_descriptor_source_position(%word: i32) -> (i32)

func.decl @qwen38_descriptor_selection(%word: i32) -> (i32)

func.decl @qwen38_descriptor_without_selection(%word: i32) -> (i32)

func.decl @qwen38_span_active(%epoch: buffer, %span: index) -> (i1)

func.decl @qwen38_span_source_position(%epoch: buffer, %span: index) -> (i32)

func.decl @qwen38_span_binding(%epoch: buffer, %span: index) -> (offset, index, index)

func.decl @qwen38_row_gdn_binding(%epoch: buffer, %control: offset, %rows: buffer, %row: index, %layer: offset) -> (offset, offset, i1)

func.decl @qwen38_row_kv_origin(%rows: buffer, %row: index, %layer: offset) -> (offset)

func.decl @qwen38_row_kv_map_origin(%rows: buffer, %row: index) -> (offset)

func.decl @qwen38_kv_position(%capacity: index, %map: buffer, %origin: offset, %position: index, %pool: index) -> (index)

// Cartesian product: sources 0, 1, 2^21, 2^22-1 and selections -1, 0, 127,
// 447, 1022. This includes absent selection, both consumers' row limits,
// the packed word's sign bit, and both field maxima.
global.rodata.def @descriptor_records = bytes("")

func.def @initialize_descriptors(%input: buffer) {
  %source = global.load @descriptor_records : buffer
  %source_origin = index.constant 0 : offset
  %input_origin = index.constant 16 : offset
  %bytes = index.constant 160 : offset
  buffer.copy %source[%source_origin], %input[%input_origin], %bytes
  func.return
}

kernel.def target(@native) @exercise_descriptors() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 16 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %count = index.constant 20 : index
  %records = buffer.view %input[%origin] : buffer -> view<20x2xi32>
  %results = buffer.view %output[%origin] : buffer -> view<20x4xi32>
  scf.for %record = [%begin to %count step %unit] {
    %source = view.load %records[%record, 0] : view<20x2xi32> -> i32
    %selection = view.load %records[%record, 1] : view<20x2xi32> -> i32
    %word = func.call @qwen38_descriptor_pack(%source, %selection) : (i32, i32) -> (i32)
    %decoded_source = func.call @qwen38_descriptor_source_position(%word) : (i32) -> (i32)
    %decoded_selection = func.call @qwen38_descriptor_selection(%word) : (i32) -> (i32)
    %without_selection = func.call @qwen38_descriptor_without_selection(%word) : (i32) -> (i32)
    view.store %word, %results[%record, 0] : i32, view<20x4xi32>
    view.store %decoded_source, %results[%record, 1] : i32, view<20x4xi32>
    view.store %decoded_selection, %results[%record, 2] : i32, view<20x4xi32>
    view.store %without_selection, %results[%record, 3] : i32, view<20x4xi32>
  }
  kernel.return
}

func.def @reference_descriptors(%input: buffer, %output: buffer) {
  %origin = index.constant 16 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %count = index.constant 20 : index
  %scale = scalar.constant 1024 : i32
  %bias = scalar.constant 1 : i32
  %records = buffer.view %input[%origin] : buffer -> view<20x2xi32>
  %results = buffer.view %output[%origin] : buffer -> view<20x4xi32>
  scf.for %record = [%begin to %count step %unit] {
    %source = view.load %records[%record, 0] : view<20x2xi32> -> i32
    %selection = view.load %records[%record, 1] : view<20x2xi32> -> i32
    %upper = scalar.muli %source, %scale : i32
    %code = scalar.addi %selection, %bias : i32
    %word = scalar.addi %upper, %code : i32
    view.store %word, %results[%record, 0] : i32, view<20x4xi32>
    view.store %source, %results[%record, 1] : i32, view<20x4xi32>
    view.store %selection, %results[%record, 2] : i32, view<20x4xi32>
    view.store %upper, %results[%record, 3] : i32, view<20x4xi32>
  }
  func.return
}

check.scenario public @descriptors {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-77) : tensor<48xi32>
    check.generate<@initialize_descriptors>(%input) : (tensor<48xi32>) -> ()
    %output = check.generate.fill value(-99) : tensor<88xi32>
    check.compare<@exercise_descriptors, @reference_descriptors>(%input, %output) : (tensor<48xi32>, tensor<88xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<48xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<88xi32>
    }
  }
  check.return
}

check.benchmark<@descriptors> @descriptor_fields

// Epoch: five packed tokens, two spans, two selected outputs. Span 0 starts
// at the row-1 fork (position 100), span 1 follows the row-256 fork (101).
// Descriptor words are count, position, packed begin, row, source/selection.
global.rodata.def @epoch_records = bytes("05000000020000000200000003000000640000000000000001000000015c00000200000065000000030000000001000080fcffff")

// The first four words contain anchor, writer, K/V origin, and fork position.
// Initialization appends the independently placed page-map origin.
global.rodata.def @row_fork = bytes("0001000000000000000200000000000000030000000000006400000000000000")

global.rodata.def @row_last = bytes("00040000000000000008000000000000000c0000000000006400000000000000")

// Three-page maps for logical capacity 130 and physical capacity 256.
global.rodata.def @page_fork = bytes("030000000000000002000000")

global.rodata.def @page_last = bytes("010000000300000000000000")

global.rodata.def @positions = bytes("000000003f000000400000007f0000008000000081000000")

func.def @initialize_state(%epoch: buffer, %rows: buffer) {
  %source_origin = index.constant 0 : offset
  %epoch_records_data = global.load @epoch_records : buffer
  %epoch_records_origin = index.constant 0 : offset
  %epoch_records_bytes = index.constant 52 : offset
  buffer.copy %epoch_records_data[%source_origin], %epoch[%epoch_records_origin], %epoch_records_bytes
  %row_fork_data = global.load @row_fork : buffer
  %row_fork_origin = index.constant 40 : offset
  %row_fork_bytes = index.constant 32 : offset
  buffer.copy %row_fork_data[%source_origin], %rows[%row_fork_origin], %row_fork_bytes
  %row_last_data = global.load @row_last : buffer
  %row_last_origin = index.constant 10240 : offset
  %row_last_bytes = index.constant 32 : offset
  buffer.copy %row_last_data[%source_origin], %rows[%row_last_origin], %row_last_bytes
  %page_fork_data = global.load @page_fork : buffer
  %page_fork_origin = index.constant 10292 : offset
  %page_fork_bytes = index.constant 12 : offset
  buffer.copy %page_fork_data[%source_origin], %rows[%page_fork_origin], %page_fork_bytes
  %page_last_data = global.load @page_last : buffer
  %page_last_origin = index.constant 13352 : offset
  %page_last_bytes = index.constant 12 : offset
  buffer.copy %page_last_data[%source_origin], %rows[%page_last_origin], %page_last_bytes
  %origins = buffer.view %rows[%source_origin] : buffer -> view<257x5xi64>
  %first_map = index.cast %page_fork_origin : offset to i64
  %last_map = index.cast %page_last_origin : offset to i64
  view.store %first_map, %origins[1, 4] : i64, view<257x5xi64>
  view.store %last_map, %origins[256, 4] : i64, view<257x5xi64>
  func.return
}

kernel.def target(@native) @exercise_state() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%epoch: buffer, %rows: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %span_count = index.constant 3 : index
  %position_count = index.constant 6 : index
  %origin = index.constant 0 : offset
  %output_origin = index.constant 16 : offset
  %logical_capacity = index.constant 130 : index
  %pool_capacity = index.constant 256 : index
  %layer_origin = index.constant 256 : offset
  %paged_field = index.constant 10 : index
  %dense_field = index.constant 16 : index
  %position_data = global.load @positions : buffer
  %positions = buffer.view %position_data[%origin] : buffer -> view<6xi32>
  %results = buffer.view %output[%output_origin] : buffer -> view<3x22xi64>
  scf.for %span = [%begin to %span_count step %unit] {
    %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
    %active_word = scalar.extui %active : i1 to i64
    view.store %active_word, %results[%span, 0] : i64, view<3x22xi64>
    scf.if %active {
      %control, %token_begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
      %source = func.call @qwen38_span_source_position(%epoch, %span) : (buffer, index) -> (i32)
      %anchor, %writer, %fork = func.call @qwen38_row_gdn_binding(%epoch, %control, %rows, %row, %layer_origin) : (buffer, offset, buffer, index, offset) -> (offset, offset, i1)
      %kv = func.call @qwen38_row_kv_origin(%rows, %row, %layer_origin) : (buffer, index, offset) -> (offset)
      %map = func.call @qwen38_row_kv_map_origin(%rows, %row) : (buffer, index) -> (offset)
      %control_word = index.cast %control : offset to i64
      view.store %control_word, %results[%span, 1] : i64, view<3x22xi64>
      %token_begin_word = index.cast %token_begin : index to i64
      view.store %token_begin_word, %results[%span, 2] : i64, view<3x22xi64>
      %row_word = index.cast %row : index to i64
      view.store %row_word, %results[%span, 3] : i64, view<3x22xi64>
      %source_word = scalar.extui %source : i32 to i64
      view.store %source_word, %results[%span, 4] : i64, view<3x22xi64>
      %anchor_word = index.cast %anchor : offset to i64
      view.store %anchor_word, %results[%span, 5] : i64, view<3x22xi64>
      %writer_word = index.cast %writer : offset to i64
      view.store %writer_word, %results[%span, 6] : i64, view<3x22xi64>
      %fork_word = scalar.extui %fork : i1 to i64
      view.store %fork_word, %results[%span, 7] : i64, view<3x22xi64>
      %kv_word = index.cast %kv : offset to i64
      view.store %kv_word, %results[%span, 8] : i64, view<3x22xi64>
      %map_word = index.cast %map : offset to i64
      view.store %map_word, %results[%span, 9] : i64, view<3x22xi64>
      scf.for %item = [%begin to %position_count step %unit] {
        %position_word = view.load %positions[%item] : view<6xi32> -> i32
        %position_value = index.cast %position_word : i32 to index
        %position = index.assume %position_value [range(%position_value, 0, 129)] : index
        %paged = func.call @qwen38_kv_position(%logical_capacity, %rows, %map, %position, %pool_capacity) : (index, buffer, offset, index, index) -> (index)
        %dense = func.call @qwen38_kv_position(%logical_capacity, %rows, %map, %position, %begin) : (index, buffer, offset, index, index) -> (index)
        %paged_word = index.cast %paged : index to i64
        %dense_word = index.cast %dense : index to i64
        %paged_column = index.add %paged_field, %item : index
        %dense_column = index.add %dense_field, %item : index
        view.store %paged_word, %results[%span, %paged_column] : i64, view<3x22xi64>
        view.store %dense_word, %results[%span, %dense_column] : i64, view<3x22xi64>
      }
    }
  }
  kernel.return
}

// Per span: active, descriptor byte origin, begin, row, source, anchor+layer,
// writer+layer, at-fork, K/V+layer, map byte origin, six paged positions,
// and six dense positions. The inactive span changes only its active flag.
global.rodata.def @expected_state = bytes("")

func.def @reference_state(%epoch: buffer, %rows: buffer, %output: buffer) {
  %source = global.load @expected_state : buffer
  %source_origin = index.constant 0 : offset
  %output_origin = index.constant 16 : offset
  %bytes = index.constant 528 : offset
  buffer.copy %source[%source_origin], %output[%output_origin], %bytes
  func.return
}

check.scenario public @retained_state {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(-77) : tensor<24xi32>
    %rows = check.generate.fill value(-77) : tensor<3341xi32>
    check.generate<@initialize_state>(%epoch, %rows) : (tensor<24xi32>, tensor<3341xi32>) -> ()
    %output = check.generate.fill value(-99) : tensor<70xi64>
    check.compare<@exercise_state, @reference_state>(%epoch, %rows, %output) : (tensor<24xi32>, tensor<3341xi32>, tensor<70xi64>) -> () {
      check.expect.bitwise actual(%epoch) expected(%epoch) : tensor<24xi32>
      check.expect.bitwise actual(%rows) expected(%rows) : tensor<3341xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<70xi64>
    }
  }
  check.return
}

check.benchmark<@retained_state> @retained_rows_and_pages
