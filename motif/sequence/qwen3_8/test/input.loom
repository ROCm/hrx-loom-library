// Token mutation and rotary coordinates against direct ordinary/media records.
// Selected records include both ends of the 512-record media packet.

amdgpu.target<gfx11-generic> @native

func.decl @qwen38_input_token(%mixed: index, %capacity: index, %input: buffer, %record: index) -> (i32)

func.decl @qwen38_input_store_token(%mixed: index, %capacity: index, %input: buffer, %record: index, %id: i32)

func.decl @qwen38_input_position(%mixed: index, %input: buffer, %record: index, %lane: index, %linear: i32) -> (i32)

global.rodata.def @selected_records = bytes("0000000001000000ff000000ff010000")

func.def @exercise(%mixed: index, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %output_origin = index.constant 16 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %selected_count = index.constant 4 : index
  %capacity = index.constant 512 : index
  %lanes = index.constant 64 : index
  %position_field = index.constant 3 : index
  %id_base = scalar.constant 7000 : i32
  %linear_base = scalar.constant 900000 : i32
  %selected = global.load @selected_records : buffer
  %selection = buffer.view %selected[%origin] : buffer -> view<4xi32>
  %results = buffer.view %output[%output_origin] : buffer -> view<4x67xi32>
  scf.for %item = [%begin to %selected_count step %unit] {
    %record_word = view.load %selection[%item] : view<4xi32> -> i32
    %record_value = index.cast %record_word : i32 to index
    %record = index.assume %record_value [range(%record_value, 0, 511)] : index
    %next_id = scalar.addi %id_base, %record_word : i32
    %linear = scalar.addi %linear_base, %record_word : i32
    %prior = func.call @qwen38_input_token(%mixed, %capacity, %input, %record) : (index, index, buffer, index) -> (i32)
    func.call @qwen38_input_store_token(%mixed, %capacity, %input, %record, %next_id) : (index, index, buffer, index, i32)
    %updated = func.call @qwen38_input_token(%mixed, %capacity, %input, %record) : (index, index, buffer, index) -> (i32)
    view.store %prior, %results[%item, 0] : i32, view<4x67xi32>
    view.store %updated, %results[%item, 1] : i32, view<4x67xi32>
    view.store %linear, %results[%item, 2] : i32, view<4x67xi32>
    scf.for %lane = [%begin to %lanes step %unit] {
      %position = func.call @qwen38_input_position(%mixed, %input, %record, %lane, %linear) : (index, buffer, index, index, i32) -> (i32)
      %column = index.add %lane, %position_field : index
      view.store %position, %results[%item, %column] : i32, view<4x67xi32>
    }
  }
  func.return
}

func.def @reference(%mixed: index, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %output_origin = index.constant 16 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %selected_count = index.constant 4 : index
  %lanes = index.constant 64 : index
  %half = index.constant 32 : index
  %axes = index.constant 3 : index
  %coordinate_field = index.constant 2 : index
  %position_field = index.constant 3 : index
  %id_base = scalar.constant 7000 : i32
  %linear_base = scalar.constant 900000 : i32
  %selected = global.load @selected_records : buffer
  %selection = buffer.view %selected[%origin] : buffer -> view<4xi32>
  %ordinary = buffer.view %input[%origin] : buffer -> view<512xi32>
  %media = buffer.view %input[%origin] : buffer -> view<512x8xi32>
  %results = buffer.view %output[%output_origin] : buffer -> view<4x67xi32>
  %is_media = index.cmp ne, %mixed, %begin : index
  scf.for %item = [%begin to %selected_count step %unit] {
    %record_word = view.load %selection[%item] : view<4xi32> -> i32
    %record_value = index.cast %record_word : i32 to index
    %record = index.assume %record_value [range(%record_value, 0, 511)] : index
    %next_id = scalar.addi %id_base, %record_word : i32
    %linear = scalar.addi %linear_base, %record_word : i32
    %prior = scf.if %is_media -> (i32) {
      %id = view.load %media[%record, 0] : view<512x8xi32> -> i32
      view.store %next_id, %media[%record, 0] : i32, view<512x8xi32>
      scf.yield %id : i32
    } else {
      %id = view.load %ordinary[%record] : view<512xi32> -> i32
      view.store %next_id, %ordinary[%record] : i32, view<512xi32>
      scf.yield %id : i32
    }
    view.store %prior, %results[%item, 0] : i32, view<4x67xi32>
    view.store %next_id, %results[%item, 1] : i32, view<4x67xi32>
    view.store %linear, %results[%item, 2] : i32, view<4x67xi32>
    scf.for %lane = [%begin to %lanes step %unit] {
      %position = scf.if %is_media -> (i32) {
        %second_half = index.cmp uge, %lane, %half : index
        %shifted = index.sub %lane, %half : index
        %pair = scf.select %second_half, %shifted, %lane : index
        %cycles = index.div %pair, %axes : index
        %used = index.mul %cycles, %axes : index
        %axis_value = index.sub %pair, %used : index
        %axis = index.assume %axis_value [range(%axis_value, 0, 2)] : index
        %field = index.add %coordinate_field, %axis : index
        %coordinate = view.load %media[%record, %field] : view<512x8xi32> -> i32
        scf.yield %coordinate : i32
      } else {
        scf.yield %linear : i32
      }
      %column = index.add %lane, %position_field : index
      view.store %position, %results[%item, %column] : i32, view<4x67xi32>
    }
  }
  func.return
}

kernel.def target(@native) @exercise_ordinary() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %layout = index.constant 0 : index
  func.call @exercise(%layout, %input, %output) : (index, buffer, buffer)
  kernel.return
}

func.def @reference_ordinary(%input: buffer, %output: buffer) {
  %layout = index.constant 0 : index
  func.call @reference(%layout, %input, %output) : (index, buffer, buffer)
  func.return
}

check.scenario public @ordinary {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0 to 65535) : tensor<4112xi32>
    %output = check.generate.fill value(-99) : tensor<276xi32>
    check.compare<@exercise_ordinary, @reference_ordinary>(%input, %output) : (tensor<4112xi32>, tensor<276xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4112xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<276xi32>
    }
  }
  check.return
}

check.benchmark<@ordinary> @ordinary_records

kernel.def target(@native) @exercise_media() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %layout = index.constant 1 : index
  func.call @exercise(%layout, %input, %output) : (index, buffer, buffer)
  kernel.return
}

func.def @reference_media(%input: buffer, %output: buffer) {
  %layout = index.constant 1 : index
  func.call @reference(%layout, %input, %output) : (index, buffer, buffer)
  func.return
}

check.scenario public @media {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0 to 65535) : tensor<4112xi32>
    %output = check.generate.fill value(-99) : tensor<276xi32>
    check.compare<@exercise_media, @reference_media>(%input, %output) : (tensor<4112xi32>, tensor<276xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4112xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<276xi32>
    }
  }
  check.return
}

check.benchmark<@media> @media_records
