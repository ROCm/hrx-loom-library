// Qwen sequence-packet geometry. Capacity is the prepared maximum number of
// tokens, rounded up to an even number for aligned sampling seeds. It is not
// a resident-session count. Each bank contains a three-word live header,
// capacity six-word descriptors, capacity selections, capacity option pairs,
// and EOS. Two banks are followed by continuation owners, sampling policies,
// output identities, source-frontier scratch, and two mixed-input capacities.
// Composition leaves specialize these scalar calculations; VM producers use
// the same functions. No helper reads global configuration or buffer metadata.

func.def public inline @qwen38_packet_selection_origin(%capacity: index) -> (offset) {
  %header = index.constant 12 : offset
  %stride = index.constant 24 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %header, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_options_origin(%capacity: index) -> (offset) {
  %header = index.constant 12 : offset
  %stride = index.constant 28 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %header, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_eos_origin(%capacity: index) -> (offset) {
  %header = index.constant 12 : offset
  %stride = index.constant 36 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %header, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_bank_bytes(%capacity: index) -> (offset) {
  %fixed = index.constant 16 : offset
  %stride = index.constant 36 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %extent = index.add %fixed, %bytes : offset
  func.return %extent : offset
}

func.def public inline @qwen38_packet_indices_origin(%capacity: index) -> (offset) {
  %fixed = index.constant 32 : offset
  %stride = index.constant 72 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %fixed, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_policy_origin(%capacity: index) -> (offset) {
  %fixed = index.constant 32 : offset
  %stride = index.constant 76 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %fixed, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_identity_origin(%capacity: index) -> (offset) {
  %fixed = index.constant 32 : offset
  %stride = index.constant 100 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %fixed, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_sources_origin(%capacity: index) -> (offset) {
  %fixed = index.constant 32 : offset
  %stride = index.constant 108 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %fixed, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_shape_origin(%capacity: index) -> (offset) {
  %fixed = index.constant 32 : offset
  %stride = index.constant 112 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %origin = index.add %fixed, %bytes : offset
  func.return %origin : offset
}

func.def public inline @qwen38_packet_bytes(%capacity: index) -> (offset) {
  %fixed = index.constant 40 : offset
  %stride = index.constant 112 : offset
  %bytes = index.scale %capacity, %stride : index, offset -> offset
  %extent = index.add %fixed, %bytes : offset
  func.return %extent : offset
}

func.def public inline @qwen38_packet_capacity(%bytes: offset) -> (index) {
  %fixed = index.constant 40 : offset
  %stride = index.constant 112 : index
  %payload = index.sub %bytes, %fixed : offset
  %length = index.cast %payload : offset to index
  %value = index.div %length, %stride : index
  %capacity = index.assume %value [range(%value, 2, 2147483646), multiple_of(%value, 2)] : index
  func.return %capacity : index
}
