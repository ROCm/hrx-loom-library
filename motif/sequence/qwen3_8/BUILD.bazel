load("//build_tools/bazel:defs.bzl", "loom_motif_library")

package(default_visibility = ["//visibility:public"])

loom_motif_library(
    name = "input",
    srcs = ["input.loom"],
)

loom_motif_library(
    name = "span",
    srcs = ["span.loom"],
)

loom_motif_library(
    name = "packet",
    srcs = ["packet.loom"],
)

loom_motif_library(
    name = "continuation",
    srcs = ["continuation.loom"],
    deps = [":packet", ":span"],
)
