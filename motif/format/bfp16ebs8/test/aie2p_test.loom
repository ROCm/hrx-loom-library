// Native FIFO packing against a scalar VM encoder. Directed BF16 words cover
// ties, signed carry, exponent spreads, and gradual-underflow boundaries. The
// reference uses exact binary64 power-of-two scaling and explicit integer tie
// handling, independently of the native FIFO conversion. Both high and residual
// streams flush subnormals to zero. Whole-storage comparisons include inputs,
// identity, nonzero origins, unused capacity, and patterned guards.

aie2p.target<core> @bfp16ebs8.core

aie2p.target<array> @bfp_array

func.decl inline @bfp16ebs8.pack_bf16_aie2p(%storage: buffer, %input: offset, %output: offset, %count: i32)

func.decl inline @bfp16ebs8.pack_bf16_residual_aie2p(%storage: buffer, %input: offset, %output: offset, %identity: offset, %count: i32)

// Directed groups are storage encodings, so signed zero and flushed subnormal
// inputs reach the native encoder without a floating conversion on the host.
func.def @input_word(%pattern: index, %element: index) -> (i16) {
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c21 = index.constant 21 : index
  %constant = index.cmp ult, %pattern, %c3 : index
  %word = scf.if %constant -> (i32) {
    %words = vector.constanti [0, 16256, 49024] : vector<3xi32>
    %word = vector.extract %words[%pattern] : vector<3xi32> -> i32
    scf.yield %word : i32
  } else {
    %group_offset = index.div %element, %c8 : index
    %first_group = index.sub %pattern, %c3 : index
    %ordinal = index.add %first_group, %group_offset : index
    %group = index.rem %ordinal, %c21 : index
    %lane = index.rem %element, %c8 : index
    %directed = index.cmp ult, %group, %c8 : index
    %word = scf.if %directed -> (i32) {
      %words = vector.constanti [0, 32768, 1, 32769, 127, 32895, 0, 0, 16256, 49024, 16384, 49152, 16128, 48896, 0, 32768, 16257, 16259, 16261, 16263, 49025, 49027, 49029, 49031, 16383, 16382, 16381, 16380, 49151, 49150, 49149, 49148, 49151, 49150, 49149, 49148, 49025, 49027, 49029, 49031, 16256, 16128, 16000, 15488, 15232, 48256, 48000, 47872, 32512, 32513, 32636, 32638, 65280, 65281, 65404, 65406, 32511, 65279, 128, 32896, 16259, 49027, 127, 32895] : vector<64xi32>
      %position = index.madd %group, %c8, %lane : index
      %word = vector.extract %words[%position] : vector<64xi32> -> i32
      scf.yield %word : i32
    } else {
      %c7 = scalar.constant 7 : i32
      %exponents = vector.constanti [1, 7, 31, 63, 95, 126, 127, 128, 159, 191, 223, 247, 253] : vector<13xi32>
      %exponent_index = index.sub %group, %c8 : index
      %exponent = vector.extract %exponents[%exponent_index] : vector<13xi32> -> i32
      %additive_identity = scalar.constant 0 : i32
      %mantissas = vector.constanti [0, 1, 63, 127] : vector<4xi32>
      %mantissa_index = index.rem %lane, %c4 : index
      %mantissa = vector.extract %mantissas[%mantissa_index] : vector<4xi32> -> i32
      %sign_bit = scalar.constant 32768 : i32
      %negative = index.cmp uge, %lane, %c4 : index
      %sign = scf.select %negative, %sign_bit, %additive_identity : i32
      %biased = scalar.shli %exponent, %c7 : i32
      %magnitude = scalar.ori %biased, %mantissa : i32
      %word = scalar.ori %magnitude, %sign : i32
      scf.yield %word : i32
    }
    scf.yield %word : i32
  }
  %storage_word = scalar.trunci %word : i32 to i16
  func.return %storage_word : i16
}

func.def @block_count(%trial: index) -> (i32) {
  %counts = vector.constanti [0, 1, 2, 7, 8, 9, 15, 16, 31, 32, 33, 63, 64] : vector<13xi32>
  %count = vector.extract %counts[%trial] : vector<13xi32> -> i32
  func.return %count : i32
}

// Quotients lie within [-128, 128]. Truncation plus an explicit signed unit
// correction separates tie parity from the target's floating rounding mode.
func.def @round_mantissa(%value: f64) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %negative_step = scalar.constant -1 : i32
  %additive_identity = scalar.constant 0.0 : f64
  %half = scalar.constant 0.5 : f64
  %integer = scalar.fptosi %value : f64 to i32
  %whole = scalar.sitofp %integer : i32 to f64
  %fraction = scalar.subf %value, %whole : f64
  %negative = scalar.cmpf olt, %fraction, %additive_identity : f64
  %negated = scalar.negf %fraction : f64
  %distance = scf.select %negative, %negated, %fraction : f64
  %greater = scalar.cmpf ogt, %distance, %half : f64
  %equal = scalar.cmpf oeq, %distance, %half : f64
  %parity = scalar.andi %integer, %c1 : i32
  %odd = scalar.cmpi ne, %parity, %c0 : i32
  %odd_tie = scalar.andi %equal, %odd : i1
  %increment = scalar.ori %greater, %odd_tie : i1
  %direction = scf.select %negative, %negative_step, %c1 : i32
  %adjustment = scf.select %increment, %direction, %c0 : i32
  %rounded = scalar.addi %integer, %adjustment : i32
  func.return %rounded : i32
}

func.def @encode_group(%values: vector<8xf64>) -> (vector<9xi8>, vector<8xf64>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %additive_identity = scalar.constant 0.0 : f64
  %minimum_normal = scalar.constant 1.1754943508222875e-38 : f64
  %empty = vector.splatf 0.0 : vector<8xf64>
  %inputs, %maximum = scf.for %lane = [%c0 to %c8 step %c1](%current = %empty : vector<8xf64>, %peak = %additive_identity : f64) -> (vector<8xf64>, f64) {
    %value = vector.extract %values[%lane] : vector<8xf64> -> f64
    %negative = scalar.cmpf olt, %value, %additive_identity : f64
    %negated = scalar.negf %value : f64
    %magnitude = scf.select %negative, %negated, %value : f64
    %normal = scalar.cmpf oge, %magnitude, %minimum_normal : f64
    %active = scf.select %normal, %value, %additive_identity : f64
    %active_magnitude = scf.select %normal, %magnitude, %additive_identity : f64
    %larger = scalar.cmpf ogt, %active_magnitude, %peak : f64
    %next_peak = scf.select %larger, %active_magnitude, %peak : f64
    %next = vector.insert %active into %current[%lane] : f64, vector<8xf64>
    scf.yield %next, %next_peak : vector<8xf64>, f64
  }
  %bits = scalar.bitcast %maximum : f64 to i64
  %shift = scalar.constant 52 : i64
  %exponent_mask = scalar.constant 2047 : i64
  %bias_difference = scalar.constant 896 : i64
  %scale_bias = scalar.constant 890 : i64
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %shifted = scalar.shrui %bits, %shift : i64
  %wide_exponent = scalar.andi %shifted, %exponent_mask : i64
  %biased = scalar.subi %wide_exponent, %bias_difference : i64
  %nonzero = scalar.cmpf ogt, %maximum, %additive_identity : f64
  %exponent = scf.select %nonzero, %biased, %c0_i64 : i64
  %scale_exponent = scalar.addi %exponent, %scale_bias : i64
  %scale_bits = scalar.shli %scale_exponent, %shift : i64
  %scale = scalar.bitcast %scale_bits : i64 to f64
  %positive_limit = scalar.constant 127 : i32
  %no_carry = scalar.constant false : i1
  %carry = scf.for %lane = [%c0 to %c8 step %c1](%needed = %no_carry : i1) -> (i1) {
    %value = vector.extract %inputs[%lane] : vector<8xf64> -> f64
    %quotient = scalar.divf %value, %scale : f64
    %mantissa = func.call @round_mantissa(%quotient) : (f64) -> (i32)
    %overflow = scalar.cmpi sgt, %mantissa, %positive_limit : i32
    %next = scalar.ori %needed, %overflow : i1
    scf.yield %next : i1
  }
  %increment = scf.select %carry, %c1_i64, %c0_i64 : i64
  %final_exponent = scalar.addi %exponent, %increment : i64
  %final_scale_exponent = scalar.addi %scale_exponent, %increment : i64
  %final_scale_bits = scalar.shli %final_scale_exponent, %shift : i64
  %final_scale = scalar.bitcast %final_scale_bits : i64 to f64
  %empty_record = vector.splati 0 : vector<9xi8>
  %exponent_byte = scalar.trunci %final_exponent : i64 to i8
  %header = vector.insert %exponent_byte into %empty_record[%c0] : i8, vector<9xi8>
  %record, %represented = scf.for %lane = [%c0 to %c8 step %c1](%bytes = %header : vector<9xi8>, %decoded = %empty : vector<8xf64>) -> (vector<9xi8>, vector<8xf64>) {
    %value = vector.extract %inputs[%lane] : vector<8xf64> -> f64
    %quotient = scalar.divf %value, %final_scale : f64
    %mantissa = func.call @round_mantissa(%quotient) : (f64) -> (i32)
    %byte = scalar.trunci %mantissa : i32 to i8
    %position = index.add %lane, %c1 : index
    %next_bytes = vector.insert %byte into %bytes[%position] : i8, vector<9xi8>
    %coefficient = scalar.sitofp %mantissa : i32 to f64
    %approximation = scalar.mulf %coefficient, %final_scale : f64
    %next_decoded = vector.insert %approximation into %decoded[%lane] : f64, vector<8xf64>
    scf.yield %next_bytes, %next_decoded : vector<9xi8>, vector<8xf64>
  }
  func.return %record, %represented : vector<9xi8>, vector<8xf64>
}

func.def @initialize_bfp_case(%trial_number: index, %storage: buffer) {
  %trial = index.assume %trial_number [range(%trial_number, 0, 12)] : index
  %origin = index.constant 0 : offset
  %input_origin = index.constant 128 : offset
  %identity_origin = index.constant 8448 : offset
  %begin = index.constant 0 : index
  %element_step = index.constant 1 : index
  %matrix_width = index.constant 8 : index
  %block_elements = index.constant 64 : index
  %blocks = index.constant 64 : index
  %pattern_count = index.constant 24 : index
  %storage_size = index.constant 18432 : index
  %bytes = buffer.view %storage[%origin] : buffer -> view<18432xi8>
  %multiplier = scalar.constant 37 : i32
  %bias = scalar.constant -91 : i32
  scf.for %position = [%begin to %storage_size step %element_step] {
    %ordinal = index.cast %position : index to i32
    %product = scalar.muli %ordinal, %multiplier : i32
    %shifted = scalar.addi %product, %bias : i32
    %value = scalar.trunci %shifted : i32 to i8
    view.store %value, %bytes[%position] : i8, view<18432xi8>
  }
  %input = buffer.view %storage[%input_origin] : buffer -> view<4096xi16>
  scf.for %block = [%begin to %blocks step %element_step] {
    %ordinal = index.add %block, %trial : index
    %pattern = index.rem %ordinal, %pattern_count : index
    %base = index.mul %block, %block_elements : index
    scf.for %element = [%begin to %block_elements step %element_step] {
      %word = func.call @input_word(%pattern, %element) : (index, index) -> (i16)
      %destination = index.add %base, %element : index
      view.store %word, %input[%destination] : i16, view<4096xi16>
    }
  }
  %identity = buffer.view %storage[%identity_origin] : buffer -> view<8x8xi16>
  %off_diagonal_bits = scalar.constant 0 : i16
  %diagonal_bits = scalar.constant 16256 : i16
  scf.for %row = [%begin to %matrix_width step %element_step] {
    scf.for %column = [%begin to %matrix_width step %element_step] {
      %diagonal = index.cmp eq, %row, %column : index
      %value = scf.select %diagonal, %diagonal_bits, %off_diagonal_bits : i16
      view.store %value, %identity[%row, %column] : i16, view<8x8xi16>
    }
  }
  %metadata = buffer.view %storage[%origin] : buffer -> view<16xi32>
  %count = func.call @block_count(%trial) : (index) -> (i32)
  %trial_value = index.cast %trial : index to i32
  view.store %count, %metadata[0] : i32, view<16xi32>
  view.store %trial_value, %metadata[1] : i32, view<16xi32>
  func.return
}

func.def inline @pack(%storage: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %storage[%origin] : buffer -> view<16xi32>
  %count = view.load %metadata[0] : view<16xi32> -> i32
  %input = index.constant 128 : offset
  %identity = index.constant 8448 : offset
  %high = index.constant 8704 : offset
  %residual = index.constant 13568 : offset
  func.call @bfp16ebs8.pack_bf16_aie2p(%storage, %input, %high, %count) : (buffer, offset, offset, i32)
  func.call @bfp16ebs8.pack_bf16_residual_aie2p(%storage, %input, %residual, %identity, %count) : (buffer, offset, offset, offset, i32)
  func.return
}

pipeline.def<kernel> public retain target(@bfp_array) @pack_storage() run(%external_storage: buffer) {
  %external = buffer.assume.alignment %external_storage {minimum_alignment = 64} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 18432 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x18432xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x18432xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x18432xi8>, index -> channel<tile<18432xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x18432xi8>, index -> channel<tile<18432xi8>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_view = buffer.view %external[%origin] : buffer -> view<18432xi8>
    %write, %incoming = channel.reserve %inputs : channel<tile<18432xi8>> -> (write<tile<18432xi8>>, view<18432xi8>)
    %ingress = kernel.async.copy %external_view to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<18432xi8> to view<18432xi8> -> kernel.async.token
    %ingress_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<18432xi8>>
    %read, %outgoing = channel.acquire %outputs : channel<tile<18432xi8>> -> (read<tile<18432xi8>>, view<18432xi8>)
    %egress = kernel.async.copy %outgoing to %external_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<18432xi8> to view<18432xi8> -> kernel.async.token
    %egress_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %egress_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<18432xi8>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %incoming = channel.acquire %inputs : channel<tile<18432xi8>> -> (read<tile<18432xi8>>, view<18432xi8>)
    %write, %outgoing = channel.reserve %outputs : channel<tile<18432xi8>> -> (write<tile<18432xi8>>, view<18432xi8>)
    %begin = index.constant 0 : index
    %end = index.constant 18432 : index
    %step = index.constant 64 : index
    scf.for %position = [%begin to %end step %step] {
      %packet = vector.load %incoming[%position] : view<18432xi8> -> vector<64xi8>
      vector.store %packet, %outgoing[%position] : vector<64xi8>, view<18432xi8>
    }
    func.call @pack(%output_storage) : (buffer)
    channel.publish %write : write<tile<18432xi8>>
    channel.release %read : read<tile<18432xi8>>
  }
}

func.def @reference(%storage: buffer) {
  %origin = index.constant 0 : offset
  %input_origin = index.constant 128 : offset
  %high_origin = index.constant 8704 : offset
  %residual_origin = index.constant 13568 : offset
  %metadata = buffer.view %storage[%origin] : buffer -> view<16xi32>
  %count_word = view.load %metadata[0] : view<16xi32> -> i32
  %bounded_count = scalar.assume %count_word [range(%count_word, 0, 64)] : i32
  %count = index.cast %bounded_count : i32 to index
  %inputs = buffer.view %storage[%input_origin] : buffer -> view<[%count]x8x8xi16>
  %high = buffer.view %storage[%high_origin] : buffer -> view<[%count]x8x9xi8>
  %residual = buffer.view %storage[%residual_origin] : buffer -> view<[%count]x8x9xi8>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %shift = scalar.constant 16 : i32
  %empty = vector.splatf 0.0 : vector<8xf64>
  scf.for %block = [%c0 to %count step %c1] {
    scf.for %group = [%c0 to %c8 step %c1] {
      %values = scf.for %lane = [%c0 to %c8 step %c1](%current = %empty : vector<8xf64>) -> (vector<8xf64>) {
        %word = view.load %inputs[%block, %group, %lane] : view<[%count]x8x8xi16> -> i16
        %upper = scalar.extui %word : i16 to i32
        %bits = scalar.shli %upper, %shift : i32
        %narrow = scalar.bitcast %bits : i32 to f32
        %value = scalar.extf %narrow : f32 to f64
        %next = vector.insert %value into %current[%lane] : f64, vector<8xf64>
        scf.yield %next : vector<8xf64>
      }
      %high_record, %represented = func.call @encode_group(%values) : (vector<8xf64>) -> (vector<9xi8>, vector<8xf64>)
      // BF16 operands and their rounded high values have short significands.
      // Their difference is exact in this binary64 reference domain.
      %difference = vector.subf %values, %represented : vector<8xf64>
      %residual_record, %residual_represented = func.call @encode_group(%difference) : (vector<8xf64>) -> (vector<9xi8>, vector<8xf64>)
      scf.for %byte = [%c0 to %c9 step %c1] {
        %high_value = vector.extract %high_record[%byte] : vector<9xi8> -> i8
        %residual_value = vector.extract %residual_record[%byte] : vector<9xi8> -> i8
        view.store %high_value, %high[%block, %group, %byte] : i8, view<[%count]x8x9xi8>
        view.store %residual_value, %residual[%block, %group, %byte] : i8, view<[%count]x8x9xi8>
      }
    }
  }
  func.return
}

check.scenario @bfp_packing {
  check.trial[13](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-91) : tensor<18432xi8>
    check.generate<@initialize_bfp_case>(%trial, %storage) : (index, tensor<18432xi8>) -> ()
    check.compare<@pack_storage, @reference>(%storage) : (tensor<18432xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<18432xi8>
    }
  }
  check.return
}

check.benchmark<@bfp_packing> @bfp_fifo_boundaries
