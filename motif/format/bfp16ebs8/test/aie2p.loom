// Native FIFO packing against independently generated rational-arithmetic bytes.
// Storage includes input/identity guards, nonzero origins, and unused output
// capacity. Metadata chooses the runtime count; the byte oracle is CPU-only.

aie2p.target<core> @bfp16ebs8.core

aie2p.target<array> @bfp_array

func.decl inline @bfp16ebs8.pack_bf16_aie2p(%storage: buffer, %input: offset, %output: offset, %count: i32)

func.decl inline @bfp16ebs8.pack_bf16_residual_aie2p(%storage: buffer, %input: offset, %output: offset, %identity: offset, %count: i32)

// BEGIN GENERATED ORACLE
// 24 complete blocks; refresh with generate_oracle.py.
global.rodata.def @input_words = align(64) bytes("")

global.rodata.def @high_records = align(64) bytes("")

global.rodata.def @residual_records = align(64) bytes("")

// END GENERATED ORACLE
global.rodata.def @block_counts = align(4) bytes("0000000001000000020000000700000008000000090000000f000000100000001f00000020000000210000003f00000040000000")

func.def @initialize_bfp_case(%trial_number: index, %storage: buffer) {
  %trial = index.assume %trial_number [range(%trial_number, 0, 12)] : index
  %origin = index.constant 0 : offset
  %input_origin = index.constant 128 : offset
  %identity_origin = index.constant 8448 : offset
  %begin = index.constant 0 : index
  %element_step = index.constant 1 : index
  %matrix_width = index.constant 8 : index
  %block_elements = index.constant 64 : index
  %blocks = index.constant 64 : index
  %pattern_count = index.constant 24 : index
  %storage_size = index.constant 18432 : index
  %bytes = buffer.view %storage[%origin] : buffer -> view<18432xi8>
  %multiplier = scalar.constant 37 : i32
  %bias = scalar.constant -91 : i32
  scf.for %position = [%begin to %storage_size step %element_step] {
    %ordinal = index.cast %position : index to i32
    %product = scalar.muli %ordinal, %multiplier : i32
    %shifted = scalar.addi %product, %bias : i32
    %value = scalar.trunci %shifted : i32 to i8
    view.store %value, %bytes[%position] : i8, view<18432xi8>
  }
  %input = buffer.view %storage[%input_origin] : buffer -> view<4096xi16>
  %input_data = global.load @input_words : buffer
  %patterns = buffer.view %input_data[%origin] : buffer -> view<24x64xi16>
  scf.for %block = [%begin to %blocks step %element_step] {
    %ordinal = index.add %block, %trial : index
    %pattern = index.rem %ordinal, %pattern_count : index
    %base = index.mul %block, %block_elements : index
    scf.for %element = [%begin to %block_elements step %element_step] {
      %word = view.load %patterns[%pattern, %element] : view<24x64xi16> -> i16
      %destination = index.add %base, %element : index
      view.store %word, %input[%destination] : i16, view<4096xi16>
    }
  }
  %identity = buffer.view %storage[%identity_origin] : buffer -> view<8x8xi16>
  %off_diagonal_bits = scalar.constant 0 : i16
  %diagonal_bits = scalar.constant 16256 : i16
  scf.for %row = [%begin to %matrix_width step %element_step] {
    scf.for %column = [%begin to %matrix_width step %element_step] {
      %diagonal = index.cmp eq, %row, %column : index
      %value = scf.select %diagonal, %diagonal_bits, %off_diagonal_bits : i16
      view.store %value, %identity[%row, %column] : i16, view<8x8xi16>
    }
  }
  %metadata = buffer.view %storage[%origin] : buffer -> view<16xi32>
  %counts_data = global.load @block_counts : buffer
  %counts = buffer.view %counts_data[%origin] : buffer -> view<13xi32>
  %count = view.load %counts[%trial] : view<13xi32> -> i32
  %trial_value = index.cast %trial : index to i32
  view.store %count, %metadata[0] : i32, view<16xi32>
  view.store %trial_value, %metadata[1] : i32, view<16xi32>
  func.return
}

func.def inline @pack(%storage: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %storage[%origin] : buffer -> view<16xi32>
  %count = view.load %metadata[0] : view<16xi32> -> i32
  %input = index.constant 128 : offset
  %identity = index.constant 8448 : offset
  %high = index.constant 8704 : offset
  %residual = index.constant 13568 : offset
  func.call @bfp16ebs8.pack_bf16_aie2p(%storage, %input, %high, %count) : (buffer, offset, offset, i32)
  func.call @bfp16ebs8.pack_bf16_residual_aie2p(%storage, %input, %residual, %identity, %count) : (buffer, offset, offset, offset, i32)
  func.return
}

pipeline.def<kernel> public retain target(@bfp_array) @pack_storage() run(%external_storage: buffer) {
  %external = buffer.assume.alignment %external_storage {minimum_alignment = 64} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 18432 : offset
  %capacity = index.constant 1 : index
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x18432xi8>
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x18432xi8>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x18432xi8>, index -> channel<tile<18432xi8>>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x18432xi8>, index -> channel<tile<18432xi8>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_view = buffer.view %external[%origin] : buffer -> view<18432xi8>
    %write, %incoming = channel.reserve %inputs : channel<tile<18432xi8>> -> (write<tile<18432xi8>>, view<18432xi8>)
    %ingress = kernel.async.copy %external_view to %incoming {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<18432xi8> to view<18432xi8> -> kernel.async.token
    %ingress_group = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %ingress_group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<18432xi8>>
    %read, %outgoing = channel.acquire %outputs : channel<tile<18432xi8>> -> (read<tile<18432xi8>>, view<18432xi8>)
    %egress = kernel.async.copy %outgoing to %external_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<18432xi8> to view<18432xi8> -> kernel.async.token
    %egress_group = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %egress_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<18432xi8>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %incoming = channel.acquire %inputs : channel<tile<18432xi8>> -> (read<tile<18432xi8>>, view<18432xi8>)
    %write, %outgoing = channel.reserve %outputs : channel<tile<18432xi8>> -> (write<tile<18432xi8>>, view<18432xi8>)
    %begin = index.constant 0 : index
    %end = index.constant 18432 : index
    %step = index.constant 64 : index
    scf.for %position = [%begin to %end step %step] {
      %packet = vector.load %incoming[%position] : view<18432xi8> -> vector<64xi8>
      vector.store %packet, %outgoing[%position] : vector<64xi8>, view<18432xi8>
    }
    func.call @pack(%output_storage) : (buffer)
    channel.publish %write : write<tile<18432xi8>>
    channel.release %read : read<tile<18432xi8>>
  }
}

func.def @reference(%storage: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.view %storage[%origin] : buffer -> view<16xi32>
  %count_value = view.load %metadata[0] : view<16xi32> -> i32
  %bounded_count = scalar.assume %count_value [range(%count_value, 0, 64)] : i32
  %count = index.cast %bounded_count : i32 to index
  %trial_value = view.load %metadata[1] : view<16xi32> -> i32
  %bounded_trial = scalar.assume %trial_value [range(%trial_value, 0, 12)] : i32
  %trial = index.cast %bounded_trial : i32 to index
  %high_origin = index.constant 8704 : offset
  %residual_origin = index.constant 13568 : offset
  %high = buffer.view %storage[%high_origin] : buffer -> view<4608xi8>
  %residual = buffer.view %storage[%residual_origin] : buffer -> view<4608xi8>
  %high_data = global.load @high_records : buffer
  %residual_data = global.load @residual_records : buffer
  %high_patterns = buffer.view %high_data[%origin] : buffer -> view<24x72xi8>
  %residual_patterns = buffer.view %residual_data[%origin] : buffer -> view<24x72xi8>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 72 : index
  %pattern_count = index.constant 24 : index
  scf.for %block = [%begin to %count step %step] {
    %ordinal = index.add %block, %trial : index
    %pattern = index.rem %ordinal, %pattern_count : index
    %base = index.mul %block, %record_bytes : index
    scf.for %byte = [%begin to %record_bytes step %step] {
      %high_value = view.load %high_patterns[%pattern, %byte] : view<24x72xi8> -> i8
      %residual_value = view.load %residual_patterns[%pattern, %byte] : view<24x72xi8> -> i8
      %position = index.add %base, %byte : index
      view.store %high_value, %high[%position] : i8, view<4608xi8>
      view.store %residual_value, %residual[%position] : i8, view<4608xi8>
    }
  }
  func.return
}

check.scenario @bfp_packing {
  check.trial[13](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-91) : tensor<18432xi8>
    check.generate<@initialize_bfp_case>(%trial, %storage) : (index, tensor<18432xi8>) -> ()
    check.compare<@pack_storage, @reference>(%storage) : (tensor<18432xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<18432xi8>
    }
  }
  check.return
}

check.benchmark<@bfp_packing> @bfp_fifo_boundaries
