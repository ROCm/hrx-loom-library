// GGML Q5_K carrier accessors.
//
// Reference snapshot: llama.cpp commit
// e9fa0781f1c25fc4fe8c86be1edc6970661ad6f0.
//
//   https://github.com/ggml-org/llama.cpp/blob/e9fa0781f1c25fc4fe8c86be1edc6970661ad6f0/ggml/src/ggml-common.h
//   https://github.com/ggml-org/llama.cpp/blob/e9fa0781f1c25fc4fe8c86be1edc6970661ad6f0/ggml/src/ggml-quants.c
//
// One 176-byte Q5_K block stores 256 unsigned five-bit codes in eight
// 32-value groups. Its low four-bit carrier matches Q4_K code packing, while
// a 32-byte high plane contributes one group-selected bit to each code. Q5_K
// uses the same 12-byte scale/minimum carrier as Q4_K and links its accessor
// through the Q4_K motif. Carrier functions accept already-loaded packets;
// the buffer accessor adds explicit row/block addressing and affine
// coefficients. Callers retain control of memory placement, packet reuse,
// floating-point materialization, contraction, and launch geometry.

func.decl @ggml_q4_k_unpack_codes16(%packed_codes: vector<4xi32>, %nibble: index) -> (vector<16xi8>)

func.decl @ggml_q4_k_load_scale_minimum(%weight: buffer, %block_origin: offset, %group: index) -> (f32, f32)

// Recovers 16 consecutive unsigned codes from selected low/high carrier
// packets. `group` selects both the low nibble and the corresponding high bit
// for one of the eight 32-value groups in a Q5_K block.
func.def public inline @ggml_q5_k_unpack_codes16(%packed_codes: vector<4xi32>, %packed_high: vector<4xi32>, %group: index) -> (vector<16xi8>) {
  %bounded_group = index.assume %group [range(%group, 0, 7)] : index
  %c2 = index.constant 2 : index
  %c4_i32v = vector.constant 4 : vector<4xi32>
  %one_byte_mask = vector.constant 16843009 : vector<4xi32>
  %nibble = index.rem %bounded_group, %c2 : index
  %low_codes = func.call @ggml_q4_k_unpack_codes16(%packed_codes, %nibble) : (vector<4xi32>, index) -> (vector<16xi8>)
  %low_words = vector.bitcast %low_codes : vector<16xi8> to vector<4xi32>
  %group_i32 = index.cast %bounded_group : index to i32
  %high_shift = vector.splat %group_i32 : vector<4xi32>
  %shifted_high = vector.shrui %packed_high, %high_shift : vector<4xi32>
  %high_bit = vector.andi %shifted_high, %one_byte_mask : vector<4xi32>
  %high_codes = vector.shli %high_bit, %c4_i32v : vector<4xi32>
  %codes_words = vector.ori %low_words, %high_codes : vector<4xi32>
  %codes = vector.bitcast %codes_words : vector<4xi32> to vector<16xi8>
  func.return %codes : vector<16xi8>
}

// Loads one 16-value half-group and its affine coefficients. Row origin is
// in bytes; block selects a complete 176-byte record. Group is in [0, 7] and
// half in [0, 1]. Low codes, high bits, and metadata each use one 16-byte load.
// The same shared metadata decoder serves Q4_K and Q5_K buffer consumers.
func.def public inline @ggml_q5_k_load_chunk16(%weight: buffer, %row_origin: offset, %block: index, %group_value: index, %half_value: index) -> (vector<16xi8>, f32, f32) {
  %group = index.assume %group_value [range(%group_value, 0, 7)] : index
  %half = index.assume %half_value [range(%half_value, 0, 1)] : index
  %groups_per_page = index.constant 2 : index
  %words_per_half = index.constant 4 : index
  %words_per_page = index.constant 8 : index
  %block_bytes = index.constant 176 : offset
  %header_bytes = index.constant 16 : offset
  %low_displacement = index.constant 48 : offset
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_add : offset
  %high_origin = index.add %block_origin, %header_bytes : offset
  %low_origin = index.add %block_origin, %low_displacement : offset
  %page = index.div %group, %groups_per_page : index
  %within = index.mul %half, %words_per_half : index
  %word = index.madd %page, %words_per_page, %within : index
  %low_view = buffer.view %weight[%low_origin] : buffer -> view<32xi32>
  %high_view = buffer.view %weight[%high_origin] : buffer -> view<8xi32>
  %low = vector.load %low_view[%word] : view<32xi32> -> vector<4xi32>
  %high = vector.load %high_view[%within] : view<8xi32> -> vector<4xi32>
  %codes = func.call @ggml_q5_k_unpack_codes16(%low, %high, %group) : (vector<4xi32>, vector<4xi32>, index) -> (vector<16xi8>)
  %scale, %minimum = func.call @ggml_q4_k_load_scale_minimum(%weight, %block_origin, %group) : (buffer, offset, index) -> (f32, f32)
  func.return %codes, %scale, %minimum : vector<16xi8>, f32, f32
}
