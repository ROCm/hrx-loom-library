// IQ4_NL block reads against an independent scalar byte interpretation.
// Complete outputs preserve guard regions, and the source must remain intact.
// Two rows have nonzero, differently aligned origins and inter-row padding.

amdgpu.target<gfx11-generic> @native

func.decl @ggml_iq4_nl_block(%input: buffer, %block_origin: offset) -> (vector<32xi8>, f32)

// Zero, signed zero, subnormal endpoints, normal endpoints, and finite extrema.
global.rodata.def @scale_words = bytes("0000008001000180ff03ff8300040084003c00bcff7bfffb553555b5004000c0")

// Independent signed-byte form of the published nonlinear codebook.
global.rodata.def @reference_codes = bytes("8198adbfcfddeaf6010d192635455971")

func.def @initialize(%ordered: i1, %input: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 8 : index
  %payload_bytes = index.constant 16 : index
  %origin = index.constant 6 : offset
  %row_bytes = index.constant 154 : offset
  %block_bytes = index.constant 18 : offset
  %header_bytes = index.constant 2 : offset
  %table_origin = index.constant 0 : offset
  %scales = global.load @scale_words : buffer
  %scale_bits = buffer.view %scales[%table_origin] : buffer -> view<16xi16>
  scf.for %row = [%begin to %rows step %unit] {
    %row_delta = index.scale %row, %row_bytes : index, offset -> offset
    %row_origin = index.add %origin, %row_delta : offset
    scf.for %block = [%begin to %blocks step %unit] {
      %ordinal = index.madd %row, %blocks, %block : index
      %delta = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %delta : offset
      %header = buffer.view %input[%block_origin] : buffer -> view<1xi16>
      %word = view.load %scale_bits[%ordinal] : view<16xi16> -> i16
      view.store %word, %header[0] : i16, view<1xi16>
      scf.if %ordered {
        %payload_origin = index.add %block_origin, %header_bytes : offset
        %payload = buffer.view %input[%payload_origin] : buffer -> view<16xi8>
        scf.for %byte = [%begin to %payload_bytes step %unit] {
          %value = index.madd %ordinal, %payload_bytes, %byte : index
          %packed = index.cast %value : index to i8
          view.store %packed, %payload[%byte] : i8, view<16xi8>
        }
      }
    }
  }
  func.return
}

func.def @initialize_ordered(%input: buffer) {
  %ordered = scalar.constant true : i1
  func.call @initialize(%ordered, %input) : (i1, buffer)
  func.return
}

func.def @initialize_headers(%input: buffer) {
  %ordered = scalar.constant false : i1
  func.call @initialize(%ordered, %input) : (i1, buffer)
  func.return
}

func.def @reference(%input: buffer, %output: buffer, %metadata: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 8 : index
  %half_width = index.constant 16 : index
  %width = index.constant 32 : index
  %origin = index.constant 6 : offset
  %output_origin = index.constant 16 : offset
  %row_bytes = index.constant 154 : offset
  %block_bytes = index.constant 18 : offset
  %header_bytes = index.constant 2 : offset
  %table_origin = index.constant 0 : offset
  %nibble_mask = scalar.constant 15 : i8
  %nibble_shift = scalar.constant 4 : i8
  %table = global.load @reference_codes : buffer
  %codebook = buffer.view %table[%table_origin] : buffer -> view<16xi8>
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x8x32xi8>
  %coefficients = buffer.view %metadata[%output_origin] : buffer -> view<2x8xf32>
  scf.for %row = [%begin to %rows step %unit] {
    %row_delta = index.scale %row, %row_bytes : index, offset -> offset
    %row_origin = index.add %origin, %row_delta : offset
    scf.for %block = [%begin to %blocks step %unit] {
      %delta = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %delta : offset
      %payload_origin = index.add %block_origin, %header_bytes : offset
      %header = buffer.view %input[%block_origin] : buffer -> view<1xf16>
      %payload = buffer.view %input[%payload_origin] : buffer -> view<16xi8>
      %scale_half = view.load %header[0] : view<1xf16> -> f16
      %scale = scalar.extf %scale_half : f16 to f32
      view.store %scale, %coefficients[%row, %block] : f32, view<2x8xf32>
      scf.for %value = [%begin to %width step %unit] {
        %byte_index = index.rem %value, %half_width : index
        %upper = index.cmp uge, %value, %half_width : index
        %byte = view.load %payload[%byte_index] : view<16xi8> -> i8
        %high = scalar.shrui %byte, %nibble_shift : i8
        %selected = scf.select %upper, %high, %byte : i8
        %nibble = scalar.andi %selected, %nibble_mask : i8
        %lookup = index.cast %nibble : i8 to index
        %code = view.load %codebook[%lookup] : view<16xi8> -> i8
        view.store %code, %outputs[%row, %block, %value] : i8, view<2x8x32xi8>
      }
    }
  }
  func.return
}

kernel.def target(@native) @read_block() {
  %blocks = index.constant 8 : index
  %rows = index.constant 2 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%blocks, %rows, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %metadata: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %origin = index.constant 6 : offset
  %output_origin = index.constant 16 : offset
  %row_bytes = index.constant 154 : offset
  %block_bytes = index.constant 18 : offset
  %row_delta = index.scale %row, %row_bytes : index, offset -> offset
  %row_origin = index.add %origin, %row_delta : offset
  %block_delta = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_delta : offset
  %codes, %scale = func.call @ggml_iq4_nl_block(%input, %block_origin) : (buffer, offset) -> (vector<32xi8>, f32)
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x8x32xi8>
  %coefficients = buffer.view %metadata[%output_origin] : buffer -> view<2x8xf32>
  vector.store %codes, %outputs[%row, %block, 0] : vector<32xi8>, view<2x8x32xi8>
  view.store %scale, %coefficients[%row, %block] : f32, view<2x8xf32>
  kernel.return
}

check.scenario public @ordered {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(85) : tensor<320xi8>
    check.generate<@initialize_ordered>(%input) : (tensor<320xi8>) -> ()
    %output = check.generate.fill value(42) : tensor<544xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<24xf32>
    check.compare<@read_block, @reference>(%input, %output, %metadata) : (tensor<320xi8>, tensor<544xi8>, tensor<24xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<544xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<24xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<320xi8>
    }
  }
  check.return
}

check.scenario public @random {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<320xi8>
    check.generate<@initialize_headers>(%input) : (tensor<320xi8>) -> ()
    %output = check.generate.fill value(42) : tensor<544xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<24xf32>
    check.compare<@read_block, @reference>(%input, %output, %metadata) : (tensor<320xi8>, tensor<544xi8>, tensor<24xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<544xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<24xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<320xi8>
    }
  }
  check.return
}

check.scenario public @low_codes {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<320xi8>
    check.generate<@initialize_headers>(%input) : (tensor<320xi8>) -> ()
    %output = check.generate.fill value(42) : tensor<544xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<24xf32>
    check.compare<@read_block, @reference>(%input, %output, %metadata) : (tensor<320xi8>, tensor<544xi8>, tensor<24xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<544xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<24xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<320xi8>
    }
  }
  check.return
}

check.scenario public @high_codes {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-1) : tensor<320xi8>
    check.generate<@initialize_headers>(%input) : (tensor<320xi8>) -> ()
    %output = check.generate.fill value(42) : tensor<544xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<24xf32>
    check.compare<@read_block, @reference>(%input, %output, %metadata) : (tensor<320xi8>, tensor<544xi8>, tensor<24xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<544xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<24xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<320xi8>
    }
  }
  check.return
}

check.benchmark<@random> @block_records
