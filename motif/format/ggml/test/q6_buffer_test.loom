// Complete Q6_K records read as codes, retained coefficients, and F16 values.
// A scalar logical-element oracle independently addresses both code planes,
// signed group scales, and the F16 factor. Halfword-aligned row origins and
// 210-byte blocks exercise the alternating word alignment of real weights.

amdgpu.target<gfx11-generic> @native

func.decl @ggml_q6_k_load_values4_f16(%weight: buffer, %row_origin: offset, %block: index, %group: index, %packet: index) -> (vector<4xf16>)

func.decl @ggml_q6_k_load_codes4(%weight: buffer, %row_origin: offset, %block: index, %group: index, %packet: index) -> (vector<4xf32>)

func.decl @ggml_q6_k_load_scale_pair(%weight: buffer, %row_origin: offset, %block: index, %group: index) -> (vector<2xf32>)

func.def @initialize_factors(%input: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 3 : index
  %origin = index.constant 2 : offset
  %stride = index.constant 636 : offset
  %block_bytes = index.constant 210 : offset
  %factor_offset = index.constant 208 : offset
  %bias = scalar.constant 2.0 : f32
  %unit = scalar.constant 0.125 : f32
  scf.for %row = [%begin to %rows step %step] {
    %row_add = index.scale %row, %stride : index, offset -> offset
    %row_origin = index.add %origin, %row_add : offset
    scf.for %block = [%begin to %blocks step %step] {
      %block_add = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %block_add : offset
      %factor_origin = index.add %block_origin, %factor_offset : offset
      %ordinal = index.madd %row, %blocks, %block : index
      %integer = index.cast %ordinal : index to i32
      %value = scalar.uitofp %integer : i32 to f32
      %centered = scalar.subf %value, %bias : f32
      %scaled = scalar.mulf %centered, %unit : f32
      %factor = scalar.fptrunc %scaled : f32 to f16
      %view = buffer.view %input[%factor_origin] : buffer -> view<1xf16>
      view.store %factor, %view[0] : f16, view<1xf16>
    }
  }
  func.return
}

// Asymmetric adjacent scales expose lane swaps, signed extrema, and zero.
func.def @initialize_scale_extrema(%input: buffer) {
  func.call @initialize_factors(%input) : (buffer)
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 3 : index
  %patterns = index.constant 4 : index
  %origin = index.constant 2 : offset
  %stride = index.constant 636 : offset
  %block_bytes = index.constant 210 : offset
  %scale_offset = index.constant 192 : offset
  %minimum = scalar.constant -128 : i8
  %negative_unit = scalar.constant -1 : i8
  %zero_scale = scalar.constant 0 : i8
  %maximum = scalar.constant 127 : i8
  scf.for %row = [%begin to %rows step %step] {
    %row_add = index.scale %row, %stride : index, offset -> offset
    %row_origin = index.add %origin, %row_add : offset
    scf.for %block = [%begin to %blocks step %step] {
      %block_add = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %block_add : offset
      %scale_origin = index.add %block_origin, %scale_offset : offset
      %scales = buffer.view %input[%scale_origin] : buffer -> view<4x4xi8>
      scf.for %pattern = [%begin to %patterns step %step] {
        view.store %minimum, %scales[%pattern, 0] : i8, view<4x4xi8>
        view.store %negative_unit, %scales[%pattern, 1] : i8, view<4x4xi8>
        view.store %zero_scale, %scales[%pattern, 2] : i8, view<4x4xi8>
        view.store %maximum, %scales[%pattern, 3] : i8, view<4x4xi8>
      }
    }
  }
  func.return
}

kernel.def target(@native) @materialize() {
  %blocks = index.constant 3 : index
  %rows = index.constant 2 : index
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%blocks, %rows, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %codes_output: buffer, %scales_output: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %thread = kernel.workitem.id<x> : index
  %packets_per_group = index.constant 8 : index
  %packet_width = index.constant 4 : index
  %origin = index.constant 2 : offset
  %stride = index.constant 636 : offset
  %output_origin = index.constant 10 : offset
  %wide_origin = index.constant 20 : offset
  %scales_per_group = index.constant 2 : index
  %first_packet = index.constant 0 : index
  %row_add = index.scale %row, %stride : index, offset -> offset
  %row_origin = index.add %origin, %row_add : offset
  %group = index.div %thread, %packets_per_group : index
  %packet = index.rem %thread, %packets_per_group : index
  %values = func.call @ggml_q6_k_load_values4_f16(%input, %row_origin, %block, %group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf16>)
  %view = buffer.view %output[%output_origin] : buffer -> view<2x3x256xf16>
  %column = index.mul %thread, %packet_width : index
  vector.store %values, %view[%row, %block, %column] : vector<4xf16>, view<2x3x256xf16>
  %codes = func.call @ggml_q6_k_load_codes4(%input, %row_origin, %block, %group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf32>)
  %codes_view = buffer.view %codes_output[%wide_origin] : buffer -> view<2x3x256xf32>
  vector.store %codes, %codes_view[%row, %block, %column] : vector<4xf32>, view<2x3x256xf32>
  %publishes_scales = index.cmp eq, %packet, %first_packet : index
  scf.if %publishes_scales {
    %scales = func.call @ggml_q6_k_load_scale_pair(%input, %row_origin, %block, %group) : (buffer, offset, index, index) -> (vector<2xf32>)
    %scales_view = buffer.view %scales_output[%wide_origin] : buffer -> view<2x3x16xf32>
    %scale_column = index.mul %group, %scales_per_group : index
    vector.store %scales, %scales_view[%row, %block, %scale_column] : vector<2xf32>, view<2x3x16xf32>
  }
  kernel.return
}

func.def @reference(%input: buffer, %output: buffer, %codes_output: buffer, %scales_output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 3 : index
  %values = index.constant 256 : index
  %half_width = index.constant 128 : index
  %half_bytes = index.constant 64 : index
  %quarter_width = index.constant 32 : index
  %scale_width = index.constant 16 : index
  %sides = index.constant 2 : index
  %origin = index.constant 2 : offset
  %stride = index.constant 636 : offset
  %block_bytes = index.constant 210 : offset
  %high_offset = index.constant 128 : offset
  %scale_offset = index.constant 192 : offset
  %factor_offset = index.constant 208 : offset
  %output_origin = index.constant 10 : offset
  %wide_origin = index.constant 20 : offset
  %mask_low = scalar.constant 15 : i32
  %mask_high = scalar.constant 3 : i32
  %low_bits = scalar.constant 4 : i32
  %high_bits = scalar.constant 2 : i32
  %zero_point = scalar.constant 32 : i32
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x3x256xf16>
  %codes_view = buffer.view %codes_output[%wide_origin] : buffer -> view<2x3x256xf32>
  %scales_view = buffer.view %scales_output[%wide_origin] : buffer -> view<2x3x16xf32>
  scf.for %row = [%begin to %rows step %step] {
    %row_add = index.scale %row, %stride : index, offset -> offset
    %row_origin = index.add %origin, %row_add : offset
    scf.for %block = [%begin to %blocks step %step] {
      %block_add = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %block_add : offset
      %high_origin = index.add %block_origin, %high_offset : offset
      %scale_origin = index.add %block_origin, %scale_offset : offset
      %factor_origin = index.add %block_origin, %factor_offset : offset
      %low = buffer.view %input[%block_origin] : buffer -> view<128xi8>
      %high = buffer.view %input[%high_origin] : buffer -> view<64xi8>
      %scales = buffer.view %input[%scale_origin] : buffer -> view<16xi8>
      %factor_view = buffer.view %input[%factor_origin] : buffer -> view<1xf16>
      %factor_half = view.load %factor_view[0] : view<1xf16> -> f16
      %factor = scalar.extf %factor_half : f16 to f64
      scf.for %value = [%begin to %values step %step] {
        %half = index.div %value, %half_width : index
        %within_half = index.rem %value, %half_width : index
        %quarter = index.div %within_half, %quarter_width : index
        %within_quarter = index.rem %value, %quarter_width : index
        %side = index.rem %quarter, %sides : index
        %nibble = index.div %quarter, %sides : index
        %half_origin = index.mul %half, %half_bytes : index
        %side_origin = index.madd %side, %quarter_width, %half_origin : index
        %low_index = index.add %side_origin, %within_quarter : index
        %high_index = index.madd %half, %quarter_width, %within_quarter : index
        %scale_index = index.div %value, %scale_width : index
        %low_byte = view.load %low[%low_index] : view<128xi8> -> i8
        %high_byte = view.load %high[%high_index] : view<64xi8> -> i8
        %scale_byte = view.load %scales[%scale_index] : view<16xi8> -> i8
        %low_integer = scalar.extui %low_byte : i8 to i32
        %high_integer = scalar.extui %high_byte : i8 to i32
        %nibble_integer = index.cast %nibble : index to i32
        %quarter_integer = index.cast %quarter : index to i32
        %low_shift = scalar.muli %nibble_integer, %low_bits : i32
        %high_shift = scalar.muli %quarter_integer, %high_bits : i32
        %low_selected = scalar.shrui %low_integer, %low_shift : i32
        %high_selected = scalar.shrui %high_integer, %high_shift : i32
        %low_code = scalar.andi %low_selected, %mask_low : i32
        %high_code_bits = scalar.andi %high_selected, %mask_high : i32
        %high_code = scalar.shli %high_code_bits, %low_bits : i32
        %unsigned_code = scalar.ori %low_code, %high_code : i32
        %signed_code = scalar.subi %unsigned_code, %zero_point : i32
        %code = scalar.sitofp %signed_code : i32 to f64
        %scale = scalar.sitofp %scale_byte : i8 to f64
        %coefficient = scalar.mulf %scale, %factor : f64
        %code_f32 = scalar.sitofp %signed_code : i32 to f32
        view.store %code_f32, %codes_view[%row, %block, %value] : f32, view<2x3x256xf32>
        %within_scale = index.rem %value, %scale_width : index
        %publishes_scale = index.cmp eq, %within_scale, %begin : index
        scf.if %publishes_scale {
          %coefficient_f32 = scalar.fptrunc %coefficient : f64 to f32
          view.store %coefficient_f32, %scales_view[%row, %block, %scale_index] : f32, view<2x3x16xf32>
        }
        %wide = scalar.mulf %code, %coefficient : f64
        %result = scalar.fptrunc %wide : f64 to f16
        view.store %result, %outputs[%row, %block, %value] : f16, view<2x3x256xf16>
      }
    }
  }
  func.return
}

check.scenario public @records_random {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<1276xi8>
    check.generate<@initialize_factors>(%input) : (tensor<1276xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<1544xf16>
    %codes = check.generate.fill value(-99.0) : tensor<1544xf32>
    %scales = check.generate.fill value(-99.0) : tensor<104xf32>
    check.compare<@materialize, @reference>(%input, %output, %codes, %scales) : (tensor<1276xi8>, tensor<1544xf16>, tensor<1544xf32>, tensor<104xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1544xf16>
      check.expect.bitwise actual(%codes) expected(%codes) : tensor<1544xf32>
      check.expect.bitwise actual(%scales) expected(%scales) : tensor<104xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1276xi8>
    }
  }
  check.return
}

check.scenario public @records_zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<1276xi8>
    check.generate<@initialize_factors>(%input) : (tensor<1276xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<1544xf16>
    %codes = check.generate.fill value(-99.0) : tensor<1544xf32>
    %scales = check.generate.fill value(-99.0) : tensor<104xf32>
    check.compare<@materialize, @reference>(%input, %output, %codes, %scales) : (tensor<1276xi8>, tensor<1544xf16>, tensor<1544xf32>, tensor<104xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1544xf16>
      check.expect.bitwise actual(%codes) expected(%codes) : tensor<1544xf32>
      check.expect.bitwise actual(%scales) expected(%scales) : tensor<104xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1276xi8>
    }
  }
  check.return
}

check.scenario public @records_ones {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-1) : tensor<1276xi8>
    check.generate<@initialize_factors>(%input) : (tensor<1276xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<1544xf16>
    %codes = check.generate.fill value(-99.0) : tensor<1544xf32>
    %scales = check.generate.fill value(-99.0) : tensor<104xf32>
    check.compare<@materialize, @reference>(%input, %output, %codes, %scales) : (tensor<1276xi8>, tensor<1544xf16>, tensor<1544xf32>, tensor<104xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1544xf16>
      check.expect.bitwise actual(%codes) expected(%codes) : tensor<1544xf32>
      check.expect.bitwise actual(%scales) expected(%scales) : tensor<104xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1276xi8>
    }
  }
  check.return
}

check.scenario public @records_scale_extrema {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(85) : tensor<1276xi8>
    check.generate<@initialize_scale_extrema>(%input) : (tensor<1276xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<1544xf16>
    %codes = check.generate.fill value(-99.0) : tensor<1544xf32>
    %scales = check.generate.fill value(-99.0) : tensor<104xf32>
    check.compare<@materialize, @reference>(%input, %output, %codes, %scales) : (tensor<1276xi8>, tensor<1544xf16>, tensor<1544xf32>, tensor<104xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1544xf16>
      check.expect.bitwise actual(%codes) expected(%codes) : tensor<1544xf32>
      check.expect.bitwise actual(%scales) expected(%scales) : tensor<104xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1276xi8>
    }
  }
  check.return
}

check.benchmark<@records_random> @read_record_components
