check.scenario public @reader_32_ordered {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(85) : tensor<2352xi8>
    check.generate<@initialize_ordered>(%input) : (tensor<2352xi8>) -> ()
    %output = check.generate.fill value(-999.0) : tensor<2056xf32>
