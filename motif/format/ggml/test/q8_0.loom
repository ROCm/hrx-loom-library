kernel.def target(@native) @read_16() {
  %blocks = index.constant 4 : index
  %rows = index.constant 8 : index
  %layouts = index.constant 2 : index
  %unit = index.constant 1 : index
  %threads = index.constant 2 : index
  kernel.launch.config workgroups(%blocks, %rows, %layouts) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %metadata: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %layout = kernel.workgroup.id<z> : index
  %packet = kernel.workitem.id<x> : index
  %width = index.constant 16 : index
  %raw_origin = index.constant 6 : offset
  %row_bytes = index.constant 146 : offset
  %output_origin = index.constant 16 : offset
  %row_delta = index.scale %row, %row_bytes : index, offset -> offset
  %row_origin = index.add %raw_origin, %row_delta : offset
  %begin = index.constant 0 : index
  %channels = index.constant 4 : index
  %block_bytes = index.constant 34 : offset
  %header_bytes = index.constant 2 : offset
  %prepared_origin = index.constant 1238 : offset
  %group_bytes = index.constant 554 : offset
  %scale_plane_bytes = index.constant 32 : offset
  %code_bytes = index.constant 32 : offset
  %prepared = index.cmp ne, %layout, %begin : index
  %scale_origin, %payload_origin = scf.if %prepared -> (offset, offset) {
    %group = index.div %row, %channels : index
    %channel = index.rem %row, %channels : index
    %ordinal = index.madd %block, %channels, %channel : index
    %group_delta = index.scale %group, %group_bytes : index, offset -> offset
    %group_origin = index.add %prepared_origin, %group_delta : offset
    %scale_delta = index.scale %ordinal, %header_bytes : index, offset -> offset
    %scale_origin = index.add %group_origin, %scale_delta : offset
    %code_plane = index.add %group_origin, %scale_plane_bytes : offset
    %code_delta = index.scale %ordinal, %code_bytes : index, offset -> offset
    %code_origin = index.add %code_plane, %code_delta : offset
    scf.yield %scale_origin, %code_origin : offset, offset
  } else {
    %block_delta = index.scale %block, %block_bytes : index, offset -> offset
    %scale_origin = index.add %row_origin, %block_delta : offset
    %code_origin = index.add %scale_origin, %header_bytes : offset
    scf.yield %scale_origin, %code_origin : offset, offset
  }
  %packet_bytes = index.constant 16 : offset
  %packet_delta = index.scale %packet, %packet_bytes : index, offset -> offset
  %code_origin = index.add %payload_origin, %packet_delta : offset
  %codes, %scale = func.call @ggml_q8_0_load_chunk16(%input, %scale_origin, %code_origin) : (buffer, offset, offset) -> (vector<16xi8>, f32)
  %values = vector.sitofp %codes : vector<16xi8> to vector<16xf32>
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x8x4x32xf32>
  %coefficients = buffer.view %metadata[%output_origin] : buffer -> view<2x8x4x8xf32>
  %column = index.mul %packet, %width : index
  vector.store %values, %outputs[%layout, %row, %block, %column] : vector<16xf32>, view<2x8x4x32xf32>
  view.store %scale, %coefficients[%layout, %row, %block, %packet] : f32, view<2x8x4x8xf32>
  kernel.return
}

