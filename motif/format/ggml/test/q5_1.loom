    %output = check.generate.fill value(42) : tensor<1056xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<72xf32>
    check.compare<@read_selected_half, @reference>(%input, %output, %metadata) : (tensor<800xi8>, tensor<1056xi8>, tensor<72xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1056xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<72xf32>
