// Q5_1 retained codes and affine metadata against scalar byte decoding.
// Constant and lane-derived halves exercise contraction and matrix staging.
// Whole-storage comparisons retain row padding, guards, and immutable inputs.

amdgpu.target<gfx11-generic> @native

func.decl @ggml_q5_1_load_block(%input: buffer, %block_origin: offset) -> (vector<16xi8>, i32, f32, f32)

func.decl @ggml_q5_1_unpack_codes16(%packed: vector<16xi8>, %high: i32, %half: index) -> (vector<16xi8>)

// Signed zero, finite normal/subnormal endpoints, and finite magnitude extrema.
global.rodata.def @scale_words = bytes("0000008001000180ff03ff8300040084003c00bcff7bfffb553555b5004000c0")

func.def @initialize(%ordered: i1, %input: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 16 : index
  %payload_bytes = index.constant 16 : index
  %bias_rotation = index.constant 5 : index
  %origin = index.constant 6 : offset
  %row_bytes = index.constant 394 : offset
  %block_bytes = index.constant 24 : offset
  %high_add = index.constant 4 : offset
  %code_add = index.constant 8 : offset
  %table_origin = index.constant 0 : offset
  %high_bit = scalar.constant 1 : i32
  %scales = global.load @scale_words : buffer
  %scale_bits = buffer.view %scales[%table_origin] : buffer -> view<16xi16>
  scf.for %row = [%begin to %rows step %unit] {
    %row_delta = index.scale %row, %row_bytes : index, offset -> offset
    %row_origin = index.add %origin, %row_delta : offset
    scf.for %block = [%begin to %blocks step %unit] {
      %ordinal = index.madd %row, %blocks, %block : index
      %delta = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %delta : offset
      %header = buffer.view %input[%block_origin] : buffer -> view<2xi16>
      %shifted = index.add %block, %bias_rotation : index
      %minimum_index = index.rem %shifted, %blocks : index
      %scale = view.load %scale_bits[%block] : view<16xi16> -> i16
      %minimum = view.load %scale_bits[%minimum_index] : view<16xi16> -> i16
      view.store %scale, %header[0] : i16, view<2xi16>
      view.store %minimum, %header[1] : i16, view<2xi16>
      scf.if %ordered {
        %high_origin = index.add %block_origin, %high_add : offset
        %high_view = buffer.view %input[%high_origin] : buffer -> view<1xi32>
        %bit = index.cast %ordinal : index to i32
        %high = scalar.shli %high_bit, %bit : i32
        view.store %high, %high_view[0] : i32, view<1xi32>
        %payload_origin = index.add %block_origin, %code_add : offset
        %payload = buffer.view %input[%payload_origin] : buffer -> view<16xi8>
        scf.for %byte = [%begin to %payload_bytes step %unit] {
          %value = index.madd %ordinal, %payload_bytes, %byte : index
          %packed = index.cast %value : index to i8
          view.store %packed, %payload[%byte] : i8, view<16xi8>
        }
      }
    }
  }
  func.return
}

func.def @initialize_ordered(%input: buffer) {
  %ordered = scalar.constant true : i1
  func.call @initialize(%ordered, %input) : (i1, buffer)
  func.return
}

func.def @initialize_headers(%input: buffer) {
  %ordered = scalar.constant false : i1
  func.call @initialize(%ordered, %input) : (i1, buffer)
  func.return
}

func.def @reference(%input: buffer, %output: buffer, %metadata: buffer) {
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %rows = index.constant 2 : index
  %blocks = index.constant 16 : index
  %half_width = index.constant 16 : index
  %width = index.constant 32 : index
  %bits_per_byte = index.constant 8 : index
  %origin = index.constant 6 : offset
  %output_origin = index.constant 16 : offset
  %row_bytes = index.constant 394 : offset
  %block_bytes = index.constant 24 : offset
  %high_add = index.constant 4 : offset
  %code_add = index.constant 8 : offset
  %nibble_mask = scalar.constant 15 : i8
  %nibble_shift = scalar.constant 4 : i8
  %bit_mask = scalar.constant 1 : i8
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x16x32xi8>
  %coefficients = buffer.view %metadata[%output_origin] : buffer -> view<2x16x2xf32>
  scf.for %row = [%begin to %rows step %unit] {
    %row_delta = index.scale %row, %row_bytes : index, offset -> offset
    %row_origin = index.add %origin, %row_delta : offset
    scf.for %block = [%begin to %blocks step %unit] {
      %delta = index.scale %block, %block_bytes : index, offset -> offset
      %block_origin = index.add %row_origin, %delta : offset
      %high_origin = index.add %block_origin, %high_add : offset
      %payload_origin = index.add %block_origin, %code_add : offset
      %header = buffer.view %input[%block_origin] : buffer -> view<2xf16>
      %high_bytes = buffer.view %input[%high_origin] : buffer -> view<4xi8>
      %payload = buffer.view %input[%payload_origin] : buffer -> view<16xi8>
      %scale_half = view.load %header[0] : view<2xf16> -> f16
      %minimum_half = view.load %header[1] : view<2xf16> -> f16
      %scale = scalar.extf %scale_half : f16 to f32
      %minimum = scalar.extf %minimum_half : f16 to f32
      view.store %scale, %coefficients[%row, %block, 0] : f32, view<2x16x2xf32>
      view.store %minimum, %coefficients[%row, %block, 1] : f32, view<2x16x2xf32>
      scf.for %value = [%begin to %width step %unit] {
        %byte_index = index.rem %value, %half_width : index
        %upper = index.cmp uge, %value, %half_width : index
        %byte = view.load %payload[%byte_index] : view<16xi8> -> i8
        %shifted = scalar.shrui %byte, %nibble_shift : i8
        %selected = scf.select %upper, %shifted, %byte : i8
        %nibble = scalar.andi %selected, %nibble_mask : i8
        %high_index = index.div %value, %bits_per_byte : index
        %high_position = index.rem %value, %bits_per_byte : index
        %high_shift = index.cast %high_position : index to i8
        %packed_high = view.load %high_bytes[%high_index] : view<4xi8> -> i8
        %selected_high = scalar.shrui %packed_high, %high_shift : i8
        %bit = scalar.andi %selected_high, %bit_mask : i8
        %high = scalar.shli %bit, %nibble_shift : i8
        %code = scalar.ori %nibble, %high : i8
        view.store %code, %outputs[%row, %block, %value] : i8, view<2x16x32xi8>
      }
    }
  }
  func.return
}

kernel.def target(@native) @read_block() {
  %blocks = index.constant 16 : index
  %rows = index.constant 2 : index
  %unit = index.constant 1 : index
  %threads = index.constant 1 : index
  kernel.launch.config workgroups(%blocks, %rows, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %metadata: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %origin = index.constant 6 : offset
  %output_origin = index.constant 16 : offset
  %row_bytes = index.constant 394 : offset
  %block_bytes = index.constant 24 : offset
  %half_width = index.constant 16 : index
  %row_delta = index.scale %row, %row_bytes : index, offset -> offset
  %row_origin = index.add %origin, %row_delta : offset
  %block_delta = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_delta : offset
  %packed, %high, %scale, %minimum = func.call @ggml_q5_1_load_block(%input, %block_origin) : (buffer, offset) -> (vector<16xi8>, i32, f32, f32)
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x16x32xi8>
  %coefficients = buffer.view %metadata[%output_origin] : buffer -> view<2x16x2xf32>
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %unit = index.constant 1 : index
  scf.for %half = [%begin to %end step %unit] unroll {
    %codes = func.call @ggml_q5_1_unpack_codes16(%packed, %high, %half) : (vector<16xi8>, i32, index) -> (vector<16xi8>)
    %column = index.mul %half, %half_width : index
    vector.store %codes, %outputs[%row, %block, %column] : vector<16xi8>, view<2x16x32xi8>
  }
  view.store %scale, %coefficients[%row, %block, 0] : f32, view<2x16x2xf32>
  view.store %minimum, %coefficients[%row, %block, 1] : f32, view<2x16x2xf32>
  kernel.return
}

kernel.def target(@native) @read_selected_half() {
  %blocks = index.constant 16 : index
  %rows = index.constant 2 : index
  %unit = index.constant 1 : index
  %threads = index.constant 2 : index
  kernel.launch.config workgroups(%blocks, %rows, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %metadata: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %origin = index.constant 6 : offset
  %output_origin = index.constant 16 : offset
  %row_bytes = index.constant 394 : offset
  %block_bytes = index.constant 24 : offset
  %half_width = index.constant 16 : index
  %row_delta = index.scale %row, %row_bytes : index, offset -> offset
  %row_origin = index.add %origin, %row_delta : offset
  %block_delta = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_delta : offset
  %packed, %high, %scale, %minimum = func.call @ggml_q5_1_load_block(%input, %block_origin) : (buffer, offset) -> (vector<16xi8>, i32, f32, f32)
  %outputs = buffer.view %output[%output_origin] : buffer -> view<2x16x32xi8>
  %coefficients = buffer.view %metadata[%output_origin] : buffer -> view<2x16x2xf32>
  %half = kernel.workitem.id<x> : index
  %codes = func.call @ggml_q5_1_unpack_codes16(%packed, %high, %half) : (vector<16xi8>, i32, index) -> (vector<16xi8>)
  %column = index.mul %half, %half_width : index
  vector.store %codes, %outputs[%row, %block, %column] : vector<16xi8>, view<2x16x32xi8>
  %first = index.constant 0 : index
  %owns_metadata = index.cmp eq, %half, %first : index
  scf.if %owns_metadata {
    view.store %scale, %coefficients[%row, %block, 0] : f32, view<2x16x2xf32>
    view.store %minimum, %coefficients[%row, %block, 1] : f32, view<2x16x2xf32>
  }
  kernel.return
}

check.scenario public @ordered {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(85) : tensor<800xi8>
    check.generate<@initialize_ordered>(%input) : (tensor<800xi8>) -> ()
    %output = check.generate.fill value(42) : tensor<1056xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<72xf32>
    check.compare<@read_block, @reference>(%input, %output, %metadata) : (tensor<800xi8>, tensor<1056xi8>, tensor<72xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1056xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<72xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<800xi8>
    }
  }
  check.return
}

check.scenario public @random {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<800xi8>
    check.generate<@initialize_headers>(%input) : (tensor<800xi8>) -> ()
    %output = check.generate.fill value(42) : tensor<1056xi8>
    %metadata = check.generate.fill value(-99.0) : tensor<72xf32>
    check.compare<@read_block, @reference>(%input, %output, %metadata) : (tensor<800xi8>, tensor<1056xi8>, tensor<72xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1056xi8>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<72xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<800xi8>
    }
  }
  check.return
}

