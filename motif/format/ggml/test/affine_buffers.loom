}

check.benchmark<@q4_16_random> @q4_16_records

kernel.def target(@native) @read_q4_4() {
  %blocks = index.constant 3 : index
  %rows = index.constant 2 : index
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%blocks, %rows, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %metadata: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %thread = kernel.workitem.id<x> : index
  %begin = index.constant 0 : index
  %origin = index.constant 16 : offset
  %row_stride = index.constant 448 : offset
  %block_bytes = index.constant 144 : offset
  %packets_per_group = index.constant 8 : index
  %packet_width = index.constant 4 : index
  %row_add = index.scale %row, %row_stride : index, offset -> offset
  %row_origin = index.add %origin, %row_add : offset
  %group = index.div %thread, %packets_per_group : index
  %packet = index.rem %thread, %packets_per_group : index
  %values = func.call @ggml_q4_k_load_codes4(%input, %row_origin, %block, %group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf32>)
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_origin = index.add %row_origin, %block_add : offset
  %header_view = buffer.view %input[%block_origin] : buffer -> view<4xi32>
  %header = vector.load %header_view[0] : view<4xi32> -> vector<4xi32>
  %scale, %minimum = func.call @ggml_q4_k_scaled_metadata(%header, %group) : (vector<4xi32>, index) -> (f32, f32)
  %outputs = buffer.view %output[%origin] : buffer -> view<2x3x256xf32>
  %coefficients = buffer.view %metadata[%origin] : buffer -> view<2x3x8x2xf32>
  %output_index = index.mul %thread, %packet_width : index
  vector.store %values, %outputs[%row, %block, %output_index] : vector<4xf32>, view<2x3x256xf32>
  %first = index.cmp eq, %packet, %begin : index
  scf.if %first {
    view.store %scale, %coefficients[%row, %block, %group, 0] : f32, view<2x3x8x2xf32>
    view.store %minimum, %coefficients[%row, %block, %group, 1] : f32, view<2x3x8x2xf32>
  }
  kernel.return
}

func.def @reference_q4_4(%input: buffer, %output: buffer, %metadata: buffer) {
