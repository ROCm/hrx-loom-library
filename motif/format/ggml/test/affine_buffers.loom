check.scenario public @q5_16_zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %block_bytes = check.literal value(176) : offset
    %input = check.generate.fill value(0) : tensor<1104xi8>
    check.generate<@initialize_headers>(%block_bytes, %input) : (offset, tensor<1104xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<1544xf32>
    %metadata = check.generate.fill value(-99.0) : tensor<104xf32>
    check.compare<@read_q5_16, @reference_q5_16>(%input, %output, %metadata) : (tensor<1104xi8>, tensor<1544xf32>, tensor<104xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1544xf32>
      check.expect.bitwise actual(%metadata) expected(%metadata) : tensor<104xf32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<1104xi8>
    }
  }
  check.return
}

