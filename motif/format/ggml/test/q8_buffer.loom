kernel.def target(@native) @read_32() {
  %blocks = index.constant 12 : index
  %rows = index.constant 2 : index
  %unit = index.constant 1 : index
  %threads = index.constant 1 : index
  kernel.launch.config workgroups(%blocks, %rows, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %metadata: buffer) {
  %block = kernel.workgroup.id<x> : index
  %row = kernel.workgroup.id<y> : index
  %packet = kernel.workitem.id<x> : index
  %width = index.constant 32 : index
  %origin = index.constant 16 : offset
  %stride = index.constant 448 : offset
  %row_add = index.scale %row, %stride : index, offset -> offset
  %row_origin = index.add %origin, %row_add : offset
  %codes, %scale, %sum = func.call @ggml_q8_1_x4_block(%input, %row_origin, %block) : (buffer, offset, index) -> (vector<32xi8>, f32, f32)
  %values = vector.sitofp %codes : vector<32xi8> to vector<32xf32>
  %outputs = buffer.view %output[%origin] : buffer -> view<2x12x32xf32>
  %coefficients = buffer.view %metadata[%origin] : buffer -> view<2x12x8x2xf32>
  %column = index.mul %packet, %width : index
  vector.store %values, %outputs[%row, %block, %column] : vector<32xf32>, view<2x12x32xf32>
  view.store %scale, %coefficients[%row, %block, %packet, 0] : f32, view<2x12x8x2xf32>
  view.store %sum, %coefficients[%row, %block, %packet, 1] : f32, view<2x12x8x2xf32>
  kernel.return
}

func.def @reference_32(%input: buffer, %output: buffer, %metadata: buffer) {
  %width = index.constant 32 : index
  %has_sum = scalar.constant true : i1
  func.call @reference(%width, %has_sum, %input, %output, %metadata) : (index, i1, buffer, buffer, buffer)
  func.return
}

