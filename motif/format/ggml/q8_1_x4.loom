// GGML Q8_1 x4 physical-layout accessors and quantization motifs.
//
// Reference snapshot: llama.cpp commit
// 030ebb558a5820b444a8f836ed5cdd46c9b4bd7a.
//
//   https://github.com/ggml-org/llama.cpp/blob/030ebb558a5820b444a8f836ed5cdd46c9b4bd7a/ggml/src/ggml-vulkan/vulkan-shaders/types.glsl
//   https://github.com/ggml-org/llama.cpp/blob/030ebb558a5820b444a8f836ed5cdd46c9b4bd7a/ggml/src/ggml-vulkan/vulkan-shaders/quantize_q8_1.comp
//
// Four logical 32-element Q8_1 blocks share one 144-byte physical group:
//
//   struct block_q8_1_x4 {
//     f16 ds[4][2];   // per-block (scale, quantized_sum * scale)
//     i32 qs[4][8];   // four signed i8 values per packed word
//   };
//
// These motifs define the physical representation without selecting a launch
// grid or adopting GGML's operation ABI.

template.decl @ggml.quantize_q8_1_x4.group_body(%publish_output: i1, %group_count: index, %group: index, %input: buffer, %output: buffer)

template.decl @ggml.quantize_q8_1_x4.block_maximum(%block_in_group: index, %thread_maximum: f32) -> (f32)

template.decl @ggml.quantize_q8_1_x4.block_sum(%block_in_group: index, %thread_sum: f32) -> (f32)

// Loads one logical 32-element Q8_1 block from the four-way physical packing.
// `row_byte_base` addresses the first x4 group for one activation row.
func.def public inline @ggml_q8_1_x4_block(%q8_input: buffer, %row_byte_base: offset, %q8_block: index) -> (vector<32xi8>, f32, f32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %group_bytes = index.constant 144 : offset
  %payload_byte_add = index.constant 16 : offset
  %group = index.div %q8_block, %c4 : index
  %inner0 = index.rem %q8_block, %c4 : index
  %inner = index.assume %inner0 [range(%inner0, 0, 3)] : index
  %group_byte_add = index.scale %group, %group_bytes : index, offset -> offset
  %group_byte_base = index.add %row_byte_base, %group_byte_add : offset
  %payload_byte_base = index.add %group_byte_base, %payload_byte_add : offset
  %ds_view = buffer.view %q8_input[%group_byte_base] : buffer -> view<8xf16>
  %payload_view = buffer.view %q8_input[%payload_byte_base] : buffer -> view<32xi32>
  %d_index = index.mul %inner, %c2 : index
  %s_index = index.add %d_index, %c1 : index
  %word_index = index.mul %inner, %c8 : index
  %d_f16 = view.load %ds_view[%d_index] : view<8xf16> -> f16
  %s_f16 = view.load %ds_view[%s_index] : view<8xf16> -> f16
  %words = vector.load %payload_view[%word_index] : view<32xi32> -> vector<8xi32>
  %values = vector.bitcast %words : vector<8xi32> to vector<32xi8>
  %d = scalar.extf %d_f16 : f16 to f32
  %s = scalar.extf %s_f16 : f16 to f32
  func.return %values, %d, %s : vector<32xi8>, f32, f32
}

// Loads one packed four-value word and its block scale. Dot-product kernels
// use this narrower form so a lane does not load the other seven words owned
// by its subgroup peers.
func.def public inline @ggml_q8_1_x4_word(%q8_input: buffer, %row_byte_base: offset, %q8_block: index, %word_in_block: index) -> (vector<4xi8>, f32) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %group_bytes = index.constant 144 : offset
  %payload_byte_add = index.constant 16 : offset
  %group = index.div %q8_block, %c4 : index
  %inner0 = index.rem %q8_block, %c4 : index
  %inner = index.assume %inner0 [range(%inner0, 0, 3)] : index
  %word0 = index.assume %word_in_block [range(%word_in_block, 0, 7)] : index
  %group_byte_add = index.scale %group, %group_bytes : index, offset -> offset
  %group_byte_base = index.add %row_byte_base, %group_byte_add : offset
  %payload_byte_base = index.add %group_byte_base, %payload_byte_add : offset
  %ds_view = buffer.view %q8_input[%group_byte_base] : buffer -> view<8xf16>
  %payload_view = buffer.view %q8_input[%payload_byte_base] : buffer -> view<32xi32>
  %d_index = index.mul %inner, %c2 : index
  %inner_word_base = index.mul %inner, %c8 : index
  %word_index = index.add %inner_word_base, %word0 : index
  %d_f16 = view.load %ds_view[%d_index] : view<8xf16> -> f16
  %packed = vector.load %payload_view[%word_index] : view<32xi32> -> vector<1xi32>
  %values = vector.bitcast %packed : vector<1xi32> to vector<4xi8>
  %d = scalar.extf %d_f16 : f16 to f32
  func.return %values, %d : vector<4xi8>, f32
}

// Loads one 16-value half of a logical Q8_1 block, with the same full-block
// scale and sum returned by ggml_q8_1_x4_block. Half is in [0, 1]. Splitting
// the payload leaves paired contraction lanes in control of their minimum
// correction; the returned sum is not divided or otherwise reinterpreted.
func.def public inline @ggml_q8_1_x4_chunk16(%input: buffer, %row_origin: offset, %block: index, %half_value: index) -> (vector<16xi8>, f32, f32) {
  %half = index.assume %half_value [range(%half_value, 0, 1)] : index
  %step = index.constant 1 : index
  %metadata_width = index.constant 2 : index
  %blocks_per_group = index.constant 4 : index
  %words_per_half = index.constant 4 : index
  %words_per_block = index.constant 8 : index
  %group_bytes = index.constant 144 : offset
  %header_bytes = index.constant 16 : offset
  %group = index.div %block, %blocks_per_group : index
  %inner = index.rem %block, %blocks_per_group : index
  %group_add = index.scale %group, %group_bytes : index, offset -> offset
  %group_origin = index.add %row_origin, %group_add : offset
  %payload_origin = index.add %group_origin, %header_bytes : offset
  %metadata = buffer.view %input[%group_origin] : buffer -> view<8xf16>
  %payload = buffer.view %input[%payload_origin] : buffer -> view<32xi32>
  %within = index.mul %half, %words_per_half : index
  %word = index.madd %inner, %words_per_block, %within : index
  %scale_index = index.mul %inner, %metadata_width : index
  %sum_index = index.add %scale_index, %step : index
  %scale_half = view.load %metadata[%scale_index] : view<8xf16> -> f16
  %sum_half = view.load %metadata[%sum_index] : view<8xf16> -> f16
  %packed = vector.load %payload[%word] : view<32xi32> -> vector<4xi32>
  %values = vector.bitcast %packed : vector<4xi32> to vector<16xi8>
  %scale = scalar.extf %scale_half : f16 to f32
  %sum = scalar.extf %sum_half : f16 to f32
  func.return %values, %scale, %sum : vector<16xi8>, f32, f32
}

// Reduces one value across each independent eight-lane Q8 block. Static
// subgroup providers use three scalar XOR exchanges. The workgroup fallback
// keeps the physical block identity in four vector banks for targets without
// a known 32- or 64-lane subgroup.
func.def inline @ggml_q8_1_x4_block_maximum_subgroup(%thread_maximum: f32) -> (f32) {
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c8_i32 = scalar.constant 8 : i32
  %xor1, %xor1_valid = kernel.subgroup.shuffle<xor> %thread_maximum, %c1_i32, %c8_i32 : f32, i32, i32
  %maximum1 = scalar.maxnumf %thread_maximum, %xor1 : f32
  %xor2, %xor2_valid = kernel.subgroup.shuffle<xor> %maximum1, %c2_i32, %c8_i32 : f32, i32, i32
  %maximum2 = scalar.maxnumf %maximum1, %xor2 : f32
  %xor4, %xor4_valid = kernel.subgroup.shuffle<xor> %maximum2, %c4_i32, %c8_i32 : f32, i32, i32
  %maximum = scalar.maxnumf %maximum2, %xor4 : f32
  func.return %maximum : f32
}

func.def inline @ggml_q8_1_x4_block_sum_subgroup(%thread_sum: f32) -> (f32) {
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c8_i32 = scalar.constant 8 : i32
  %xor1, %xor1_valid = kernel.subgroup.shuffle<xor> %thread_sum, %c1_i32, %c8_i32 : f32, i32, i32
  %sum1 = scalar.addf %thread_sum, %xor1 : f32
  %xor2, %xor2_valid = kernel.subgroup.shuffle<xor> %sum1, %c2_i32, %c8_i32 : f32, i32, i32
  %sum2 = scalar.addf %sum1, %xor2 : f32
  %xor4, %xor4_valid = kernel.subgroup.shuffle<xor> %sum2, %c4_i32, %c8_i32 : f32, i32, i32
  %sum = scalar.addf %sum2, %xor4 : f32
  func.return %sum : f32
}

template.def<@ggml.quantize_q8_1_x4.block_maximum> device requires [#target.subgroup.size<32>] priority(20) @ggml_q8_1_x4_block_maximum_subgroup32(%block_in_group: index, %thread_maximum: f32) -> (f32) {
  %maximum = func.call @ggml_q8_1_x4_block_maximum_subgroup(%thread_maximum) : (f32) -> (f32)
  template.return %maximum : f32
}

template.def<@ggml.quantize_q8_1_x4.block_maximum> device requires [#target.subgroup.size<64>] priority(20) @ggml_q8_1_x4_block_maximum_subgroup64(%block_in_group: index, %thread_maximum: f32) -> (f32) {
  %maximum = func.call @ggml_q8_1_x4_block_maximum_subgroup(%thread_maximum) : (f32) -> (f32)
  template.return %maximum : f32
}

template.def<@ggml.quantize_q8_1_x4.block_maximum> device priority(0) @ggml_q8_1_x4_block_maximum_workgroup(%block_in_group: index, %thread_maximum: f32) -> (f32) {
  %c0_v4f32 = vector.splatf 0.0 : vector<4xf32>
  %thread_bank = vector.insert %thread_maximum into %c0_v4f32[%block_in_group] : f32, vector<4xf32>
  %maximum_bank = kernel.workgroup.reduce<maxnumf> %thread_bank : vector<4xf32>
  %maximum = vector.extract %maximum_bank[%block_in_group] : vector<4xf32> -> f32
  template.return %maximum : f32
}

template.def<@ggml.quantize_q8_1_x4.block_sum> device requires [#target.subgroup.size<32>] priority(20) @ggml_q8_1_x4_block_sum_subgroup32(%block_in_group: index, %thread_sum: f32) -> (f32) {
  %sum = func.call @ggml_q8_1_x4_block_sum_subgroup(%thread_sum) : (f32) -> (f32)
  template.return %sum : f32
}

template.def<@ggml.quantize_q8_1_x4.block_sum> device requires [#target.subgroup.size<64>] priority(20) @ggml_q8_1_x4_block_sum_subgroup64(%block_in_group: index, %thread_sum: f32) -> (f32) {
  %sum = func.call @ggml_q8_1_x4_block_sum_subgroup(%thread_sum) : (f32) -> (f32)
  template.return %sum : f32
}

template.def<@ggml.quantize_q8_1_x4.block_sum> device priority(0) @ggml_q8_1_x4_block_sum_workgroup(%block_in_group: index, %thread_sum: f32) -> (f32) {
  %c0_v4f32 = vector.splatf 0.0 : vector<4xf32>
  %thread_bank = vector.insert %thread_sum into %c0_v4f32[%block_in_group] : f32, vector<4xf32>
  %sum_bank = kernel.workgroup.reduce<addf> %thread_bank : vector<4xf32>
  %sum = vector.extract %sum_bank[%block_in_group] : vector<4xf32> -> f32
  template.return %sum : f32
}

// Packs one explicit physical group. Callers provide the complete physical
// group domain and an in-range ordinal, and guarantee that all 32 workitems
// in the workgroup execute after all 128 source values are visible. The uniform
// publication predicate suppresses only destination writes so every lane still
// participates in the cooperative reductions.
template.def<@ggml.quantize_q8_1_x4.group_body> device @ggml_quantize_q8_1_x4_group_body(%publish_output: i1, %group_count0: index, %group0: index, %input: buffer, %output: buffer) {
  %group_count, %group = index.assume %group_count0, %group0 [range(%group_count0, 1, 524288), lt(%group0, %group_count0)] : index, index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c128 = index.constant 128 : index
  %group_bytes = index.constant 144 : index
  %payload_byte_add = index.constant 16 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c127 = scalar.constant 127.0 : f32
  %c0_offset = index.constant 0 : offset
  %launched_element_count = index.mul %group_count, %c128 : index
  %block_in_group0 = index.div %lane, %c8 : index
  %block_in_group = index.assume %block_in_group0 [range(%block_in_group0, 0, 3)] : index
  %word_in_block0 = index.rem %lane, %c8 : index
  %word_in_block = index.assume %word_in_block0 [range(%word_in_block0, 0, 7)] : index
  %group_element_base = index.mul %group, %c128 : index
  %block_element_add = index.mul %block_in_group, %c32 : index
  %block_word_add = index.mul %block_in_group, %c8 : index
  %word_element_add = index.mul %word_in_block, %c4 : index
  %input_block_base = index.add %group_element_base, %block_element_add : index
  %input_index = index.add %input_block_base, %word_element_add : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%launched_element_count]xf32>
  %input_values = vector.load %input_view[%input_index] : view<[%launched_element_count]xf32> -> vector<4xf32>
  %absolute_values = vector.absf %input_values : vector<4xf32>
  %thread_max = vector.reduce<maxnumf> %absolute_values, %c0_f32 : vector<4xf32>, f32
  %amax = template.apply<@ggml.quantize_q8_1_x4.block_maximum>(%block_in_group, %thread_max) : (index, f32) -> (f32)
  %d = scalar.divf %amax, %c127 : f32
  %is_cohort_leader = index.cmp eq, %word_in_block, %c0 : index
  %d_nonzero = scalar.cmpf one, %d, %c0_f32 : f32
  %d_inverse = scf.if %d_nonzero -> (f32) {
    %inverse = scalar.divf %c1_f32, %d : f32
    scf.yield %inverse : f32
  } else {
    scf.yield %c0_f32 : f32
  }
  %d_inverse_vector = vector.splat %d_inverse : vector<4xf32>
  %scaled_values = vector.mulf %input_values, %d_inverse_vector : vector<4xf32>
  %rounded_values = vector.roundf %scaled_values : vector<4xf32>
  %quantized_values = vector.fptosi %rounded_values : vector<4xf32> to vector<4xi8>
  %packed_word = vector.bitcast %quantized_values : vector<4xi8> to vector<1xi32>
  %group_byte_index = index.mul %group, %group_bytes : index
  %group_byte_offset = index.cast %group_byte_index : index to offset
  %payload_byte_index = index.add %group_byte_index, %payload_byte_add : index
  %payload_byte_offset = index.cast %payload_byte_index : index to offset
  %group_ds = buffer.view %output_noalias[%group_byte_offset] : buffer -> view<8xf16>
  %group_qs = buffer.view %output_noalias[%payload_byte_offset] : buffer -> view<32xi32>
  %packed_word_index0 = index.add %block_word_add, %word_in_block : index
  %packed_word_index = index.assume %packed_word_index0 [range(%packed_word_index0, 0, 31)] : index
  scf.if %publish_output {
    vector.store %packed_word, %group_qs[%packed_word_index] : vector<1xi32>, view<32xi32>
  }
  %thread_sum = vector.reduce<addf> %rounded_values, %c0_f32 : vector<4xf32>, f32
  %quantized_sum = template.apply<@ggml.quantize_q8_1_x4.block_sum>(%block_in_group, %thread_sum) : (index, f32) -> (f32)
  %publishes_metadata = scalar.andi %is_cohort_leader, %publish_output : i1
  scf.if %publishes_metadata {
    %s = scalar.mulf %quantized_sum, %d : f32
    %d_f16 = scalar.fptrunc %d : f32 to f16
    %s_f16 = scalar.fptrunc %s : f32 to f16
    %ds_index = index.mul %block_in_group, %c2 : index
    view.store %d_f16, %group_ds[%ds_index] : f16, view<8xf16>
    %s_index = index.add %ds_index, %c1 : index
    view.store %s_f16, %group_ds[%s_index] : f16, view<8xf16>
  }
  template.return
}
