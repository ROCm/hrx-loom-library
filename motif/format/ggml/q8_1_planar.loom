// Planar Q8_1 activation publication from producer-retained F32 values.
//
// The representation separates codes from metadata for direct consumption by
// quantized matrix kernels. A [row_count, block_count] tensor contains:
//
//   i8 codes[row_count][block_count][32]
//   f32 metadata[row_count][block_count][2]  // (F16-rounded scale, code sum)
//
// Metadata begins after row_count * block_count * 32 payload bytes. The scale
// is max(abs(values)) / 127 rounded through F16 and extended back to F32. The
// sum is the exact signed sum of the 32 quantized codes, represented as F32.
//
// Producers retain complete blocks in several useful shapes. These entry
// points keep the numerical and storage contract common while matching that
// ownership directly: one lane may own all 32 values, four adjacent lanes may
// own eight contiguous values each, or 32 adjacent lanes may each own one
// value from four independent blocks.

// Publishes one complete block retained by the calling lane.
func.def public inline @ggml_q8_1_planar_publish_block32(%row_count0: index, %row0: index, %block_count0: index, %block0: index, %values: vector<32xf32>, %output: buffer) {
  %row_count, %row, %block_count, %block = index.assume %row_count0, %row0, %block_count0, %block0 [range(%row_count0, 1, 8192), lt(%row0, %row_count0), range(%block_count0, 1, 8192), lt(%block0, %block_count0)] : index, index, index, index
  %c0_offset = index.constant 0 : offset
  %begin = index.constant 0 : index
  %elements_per_block = index.constant 32 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c127_f32 = scalar.constant 127.0 : f32
  %c0_v32f32 = vector.splatf 0.0 : vector<32xf32>
  %absolute = vector.absf %values : vector<32xf32>
  %maximum = vector.reduce<maxnumf> %absolute, %c0_f32 : vector<32xf32>, f32
  %scale = scalar.divf %maximum, %c127_f32 : f32
  %nonzero = scalar.cmpf one, %maximum, %c0_f32 : f32
  %scales = vector.splat %scale : vector<32xf32>
  %scaled = vector.divf %values, %scales : vector<32xf32>
  %rounded = vector.roundf %scaled : vector<32xf32>
  %nonzero_values = vector.splat %nonzero : vector<32xi1>
  %selected = vector.select %nonzero_values, %rounded, %c0_v32f32 : vector<32xf32>
  %codes = vector.fptosi %selected : vector<32xf32> to vector<32xi8>
  %words = vector.bitcast %codes : vector<32xi8> to vector<8xi32>
  %payload = buffer.view %output[%c0_offset] : buffer -> view<[%row_count]x[%block_count]x8xi32>
  vector.store %words, %payload[%row, %block, %begin] : vector<8xi32>, view<[%row_count]x[%block_count]x8xi32>
  %c0_i32 = scalar.constant 0 : i32
  %c0_v8i32 = vector.splati 0 : vector<8xi32>
  %c1_v32i8 = vector.splati 1 : vector<32xi8>
  %partial_sums = vector.dot4i<s8s8> %codes, %c1_v32i8, %c0_v8i32 : vector<32xi8>, vector<32xi8>, vector<8xi32>
  %sum = vector.reduce<addi> %partial_sums, %c0_i32 : vector<8xi32>, i32
  %sum_float = scalar.sitofp %sum : i32 to f32
  %half_scale = scalar.fptrunc %scale : f32 to f16
  %stored_scale = scalar.extf %half_scale : f16 to f32
  %metadata_values = vector.from_elements %stored_scale, %sum_float : vector<2xf32>
  %row_elements = index.mul %block_count, %elements_per_block : index
  %row_bytes = index.cast %row_elements : index to offset
  %metadata_origin = index.scale %row_count, %row_bytes : index, offset -> offset
  %metadata = buffer.view %output[%metadata_origin] : buffer -> view<[%row_count]x[%block_count]x2xf32>
  vector.store %metadata_values, %metadata[%row, %block, %begin] : vector<2xf32>, view<[%row_count]x[%block_count]x2xf32>
  func.return
}

// Publishes eight contiguous values from each lane in an aligned four-lane
// cluster. All four lanes pass the same row and block; lane_in_block is 0..3.
func.def public inline @ggml_q8_1_planar_publish_packet8_cluster4(%row_count0: index, %row0: index, %block_count0: index, %block0: index, %lane_in_block0: index, %values: vector<8xf32>, %output: buffer) {
  %row_count, %row, %block_count, %block, %lane_in_block = index.assume %row_count0, %row0, %block_count0, %block0, %lane_in_block0 [range(%row_count0, 1, 8192), lt(%row0, %row_count0), range(%block_count0, 1, 8192), lt(%block0, %block_count0), range(%lane_in_block0, 0, 3)] : index, index, index, index, index
  %c0_offset = index.constant 0 : offset
  %begin = index.constant 0 : index
  %words_per_lane = index.constant 2 : index
  %elements_per_block = index.constant 32 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c127_f32 = scalar.constant 127.0 : f32
  %c0_v8f32 = vector.splatf 0.0 : vector<8xf32>
  %absolute = vector.absf %values : vector<8xf32>
  %lane_maximum = vector.reduce<maxnumf> %absolute, %c0_f32 : vector<8xf32>, f32
  %maximum = kernel.subgroup.reduce<maxnumf> %lane_maximum {cluster_size = 4} : f32
  %scale = scalar.divf %maximum, %c127_f32 : f32
  %nonzero = scalar.cmpf one, %maximum, %c0_f32 : f32
  %scales = vector.splat %scale : vector<8xf32>
  %scaled = vector.divf %values, %scales : vector<8xf32>
  %rounded = vector.roundf %scaled : vector<8xf32>
  %nonzero_values = vector.splat %nonzero : vector<8xi1>
  %selected = vector.select %nonzero_values, %rounded, %c0_v8f32 : vector<8xf32>
  %codes = vector.fptosi %selected : vector<8xf32> to vector<8xi8>
  %words = vector.bitcast %codes : vector<8xi8> to vector<2xi32>
  %word = index.mul %lane_in_block, %words_per_lane : index
  %payload = buffer.view %output[%c0_offset] : buffer -> view<[%row_count]x[%block_count]x8xi32>
  vector.store %words, %payload[%row, %block, %word] : vector<2xi32>, view<[%row_count]x[%block_count]x8xi32>
  %c0_i32 = scalar.constant 0 : i32
  %c0_v2i32 = vector.splati 0 : vector<2xi32>
  %c1_v8i8 = vector.splati 1 : vector<8xi8>
  %partial_sums = vector.dot4i<s8s8> %codes, %c1_v8i8, %c0_v2i32 : vector<8xi8>, vector<8xi8>, vector<2xi32>
  %lane_sum = vector.reduce<addi> %partial_sums, %c0_i32 : vector<2xi32>, i32
  %sum = kernel.subgroup.reduce<addi> %lane_sum {cluster_size = 4} : i32
  %leader = index.cmp eq, %lane_in_block, %begin : index
  scf.if %leader {
    %sum_float = scalar.sitofp %sum : i32 to f32
    %half_scale = scalar.fptrunc %scale : f32 to f16
    %stored_scale = scalar.extf %half_scale : f16 to f32
    %metadata_values = vector.from_elements %stored_scale, %sum_float : vector<2xf32>
    %row_elements = index.mul %block_count, %elements_per_block : index
    %row_bytes = index.cast %row_elements : index to offset
    %metadata_origin = index.scale %row_count, %row_bytes : index, offset -> offset
    %metadata = buffer.view %output[%metadata_origin] : buffer -> view<[%row_count]x[%block_count]x2xf32>
    vector.store %metadata_values, %metadata[%row, %block, %begin] : vector<2xf32>, view<[%row_count]x[%block_count]x2xf32>
  }
  func.return
}

// Publishes one value from each of four adjacent blocks per lane. All 32 lanes
// in an aligned cluster pass the same row and first block; lane_in_block is
// 0..31 and values[n] belongs to first_block + n.
func.def public inline @ggml_q8_1_planar_publish_columns4_cluster32(%row_count0: index, %row0: index, %block_count0: index, %first_block0: index, %lane_in_block0: index, %values: vector<4xf32>, %output: buffer) {
  %row_count, %row, %block_count, %first_block, %lane_in_block = index.assume %row_count0, %row0, %block_count0, %first_block0, %lane_in_block0 [range(%row_count0, 1, 8192), lt(%row0, %row_count0), range(%block_count0, 4, 8192), range(%first_block0, 0, 8191), range(%lane_in_block0, 0, 31)] : index, index, index, index, index
  %c0_offset = index.constant 0 : offset
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %elements_per_block = index.constant 32 : index
  %c0_v4f32 = vector.splatf 0.0 : vector<4xf32>
  %c127_v4f32 = vector.splatf 127.0 : vector<4xf32>
  %absolute = vector.absf %values : vector<4xf32>
  %maximum = kernel.subgroup.reduce<maxnumf> %absolute {cluster_size = 32} : vector<4xf32>
  %scale = vector.divf %maximum, %c127_v4f32 : vector<4xf32>
  %nonzero = vector.cmpf one, %maximum, %c0_v4f32 : vector<4xf32> -> vector<4xi1>
  %scaled = vector.divf %values, %scale : vector<4xf32>
  %rounded = vector.roundf %scaled : vector<4xf32>
  %selected = vector.select %nonzero, %rounded, %c0_v4f32 : vector<4xf32>
  %codes = vector.fptosi %selected : vector<4xf32> to vector<4xi8>
  %wide_codes = vector.extsi %codes : vector<4xi8> to vector<4xi32>
  %sums = kernel.subgroup.reduce<addi> %wide_codes {cluster_size = 32} : vector<4xi32>
  %half_scale = vector.fptrunc %scale : vector<4xf32> to vector<4xf16>
  %stored_scale = vector.extf %half_scale : vector<4xf16> to vector<4xf32>
  %block1 = index.add %first_block, %c1 : index
  %block2 = index.add %first_block, %c2 : index
  %block3_value = index.add %first_block, %c3 : index
  %block3 = index.assume %block3_value [lt(%block3_value, %block_count)] : index
  %code0 = vector.extract %codes[0] : vector<4xi8> -> i8
  %code1 = vector.extract %codes[1] : vector<4xi8> -> i8
  %code2 = vector.extract %codes[2] : vector<4xi8> -> i8
  %code3 = vector.extract %codes[3] : vector<4xi8> -> i8
  %payload = buffer.view %output[%c0_offset] : buffer -> view<[%row_count]x[%block_count]x32xi8>
  view.store %code0, %payload[%row, %first_block, %lane_in_block] : i8, view<[%row_count]x[%block_count]x32xi8>
  view.store %code1, %payload[%row, %block1, %lane_in_block] : i8, view<[%row_count]x[%block_count]x32xi8>
  view.store %code2, %payload[%row, %block2, %lane_in_block] : i8, view<[%row_count]x[%block_count]x32xi8>
  view.store %code3, %payload[%row, %block3, %lane_in_block] : i8, view<[%row_count]x[%block_count]x32xi8>
  %leader = index.cmp eq, %lane_in_block, %begin : index
  scf.if %leader {
    %sum0_integer = vector.extract %sums[0] : vector<4xi32> -> i32
    %sum1_integer = vector.extract %sums[1] : vector<4xi32> -> i32
    %sum2_integer = vector.extract %sums[2] : vector<4xi32> -> i32
    %sum3_integer = vector.extract %sums[3] : vector<4xi32> -> i32
    %sum0 = scalar.sitofp %sum0_integer : i32 to f32
    %sum1 = scalar.sitofp %sum1_integer : i32 to f32
    %sum2 = scalar.sitofp %sum2_integer : i32 to f32
    %sum3 = scalar.sitofp %sum3_integer : i32 to f32
    %scale0 = vector.extract %stored_scale[0] : vector<4xf32> -> f32
    %scale1 = vector.extract %stored_scale[1] : vector<4xf32> -> f32
    %scale2 = vector.extract %stored_scale[2] : vector<4xf32> -> f32
    %scale3 = vector.extract %stored_scale[3] : vector<4xf32> -> f32
    %metadata0 = vector.from_elements %scale0, %sum0 : vector<2xf32>
    %metadata1 = vector.from_elements %scale1, %sum1 : vector<2xf32>
    %metadata2 = vector.from_elements %scale2, %sum2 : vector<2xf32>
    %metadata3 = vector.from_elements %scale3, %sum3 : vector<2xf32>
    %row_elements = index.mul %block_count, %elements_per_block : index
    %row_bytes = index.cast %row_elements : index to offset
    %metadata_origin = index.scale %row_count, %row_bytes : index, offset -> offset
    %metadata = buffer.view %output[%metadata_origin] : buffer -> view<[%row_count]x[%block_count]x2xf32>
    vector.store %metadata0, %metadata[%row, %first_block, %begin] : vector<2xf32>, view<[%row_count]x[%block_count]x2xf32>
    vector.store %metadata1, %metadata[%row, %block1, %begin] : vector<2xf32>, view<[%row_count]x[%block_count]x2xf32>
    vector.store %metadata2, %metadata[%row, %block2, %begin] : vector<2xf32>, view<[%row_count]x[%block_count]x2xf32>
    vector.store %metadata3, %metadata[%row, %block3, %begin] : vector<2xf32>, view<[%row_count]x[%block_count]x2xf32>
  }
  func.return
}
