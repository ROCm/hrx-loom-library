// Independent CPython 3.12 / Unicode 15.0 observations cover every changed
// uppercase codepoint, every whitespace/digit member, their immediate neighbors,
// and UTF-8 width boundaries. Each row also exercises both UTF-8 directions.
// generate_unicode_oracle.py produces the NPY files through :unicode_fixture.
// The NPY records losslessly pack a codepoint in bits 0-20, whitespace in bit 21,
// and digit in bit 22; the second column indexes the uppercase observations.
// Uppercase rows hold the first output's delta and the second/third codepoints
// (zero when absent). Shared deltas keep the complete capture below 32 KiB.

func.decl @text.uppercase(%codepoint: i32) -> (i32, i32, i32)

func.decl @text.is_space(%codepoint: i32) -> (i1)

func.decl @text.is_digit(%codepoint: i32) -> (i1)

func.decl @text.next(%text: buffer, %position: offset) -> (i32, offset)

func.decl @text.previous(%text: buffer, %end: offset) -> (i32, offset)

func.decl @text.write(%text: buffer, %position: offset, %codepoint: i32) -> (offset)

func.def @unicode_observations(%records: view<3293x2xi32>, %uppercase: view<154x3xi32>) -> (i32) {
  %count = index.constant 3293 : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %row_step = index.constant 1 : index
  %initial_error_count = scalar.constant 0 : i32
  %capacity = index.constant 4 : offset
  %text = buffer.alloca<private> align(4) %capacity : buffer
  %codepoint_mask = scalar.constant 2097151 : i32
  %property_mask = scalar.constant 1 : i32
  %space_shift = scalar.constant 21 : i32
  %digit_shift = scalar.constant 22 : i32
  %errors = scf.for %i = [%begin to %count step %row_step](%errors = %initial_error_count : i32) -> (i32) {
    %packed = view.load %records[%i, 0] : view<3293x2xi32> -> i32
    %uppercase_index32 = view.load %records[%i, 1] : view<3293x2xi32> -> i32
    %codepoint = scalar.andi %packed, %codepoint_mask : i32
    %space_bits = scalar.shrui %packed, %space_shift : i32
    %digit_bits = scalar.shrui %packed, %digit_shift : i32
    %expected_space = scalar.andi %space_bits, %property_mask : i32
    %expected_digit = scalar.andi %digit_bits, %property_mask : i32
    %uppercase_index = index.cast %uppercase_index32 : i32 to index
    %row = index.assume %uppercase_index [ge(%uppercase_index, 0), lt(%uppercase_index, 154)] : index
    %delta = view.load %uppercase[%row, 0] : view<154x3xi32> -> i32
    %expected_a = scalar.addi %codepoint, %delta : i32
    %expected_b = view.load %uppercase[%row, 1] : view<154x3xi32> -> i32
    %expected_c = view.load %uppercase[%row, 2] : view<154x3xi32> -> i32
    %a, %b, %c = func.call @text.uppercase(%codepoint) : (i32) -> (i32, i32, i32)
    %space_bit = func.call @text.is_space(%codepoint) : (i32) -> (i1)
    %digit_bit = func.call @text.is_digit(%codepoint) : (i32) -> (i1)
    %space = scalar.extui %space_bit : i1 to i32
    %digit = scalar.extui %digit_bit : i1 to i32
    %same_a = scalar.cmpi eq, %a, %expected_a : i32
    %same_b = scalar.cmpi eq, %b, %expected_b : i32
    %same_c = scalar.cmpi eq, %c, %expected_c : i32
    %same_space = scalar.cmpi eq, %space, %expected_space : i32
    %same_digit = scalar.cmpi eq, %digit, %expected_digit : i32
    %pair = scalar.andi %same_a, %same_b : i1
    %upper = scalar.andi %pair, %same_c : i1
    %properties = scalar.andi %same_space, %same_digit : i1
    %same_tables = scalar.andi %upper, %properties : i1
    %end = func.call @text.write(%text, %origin, %codepoint) : (buffer, offset, i32) -> (offset)
    %forward, %after = func.call @text.next(%text, %origin) : (buffer, offset) -> (i32, offset)
    %backward, %before = func.call @text.previous(%text, %end) : (buffer, offset) -> (i32, offset)
    %same_forward = scalar.cmpi eq, %forward, %codepoint : i32
    %same_backward = scalar.cmpi eq, %backward, %codepoint : i32
    %same_end = index.cmp eq, %after, %end : offset
    %same_begin = index.cmp eq, %before, %origin : offset
    %same_directions = scalar.andi %same_forward, %same_backward : i1
    %same_positions = scalar.andi %same_end, %same_begin : i1
    %same_utf8 = scalar.andi %same_directions, %same_positions : i1
    %same = scalar.andi %same_tables, %same_utf8 : i1
    %false = scalar.constant false : i1
    %failed = scalar.cmpi eq, %same, %false : i1
    %failed32 = scalar.extui %failed : i1 to i32
    %next_errors = scalar.addi %errors, %failed32 : i32
    scf.yield %next_errors : i32
  }
  func.return %errors : i32
}

check.case public @unicode_properties {
  %records = check.file.read.npy path("unicode_records.npy") : view<3293x2xi32>
  %uppercase = check.file.read.npy path("unicode_uppercase.npy") : view<154x3xi32>
  %errors = func.call @unicode_observations(%records, %uppercase) : (view<3293x2xi32>, view<154x3xi32>) -> (i32)
  %zero = check.literal value(0) : i32
  check.expect.equal actual(%errors) expected(%zero) : i32
  check.return
}

check.benchmark<@unicode_properties> @unicode_properties_workload
