load("@hrx//build_tools/bazel:python.bzl", "iree_py_binary")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

iree_py_binary(
    name = "generate_unicode_oracle",
    testonly = True,
    srcs = ["generate_unicode_oracle.py"],
)

genrule(
    name = "unicode_fixture",
    testonly = True,
    outs = [
        "unicode_records.npy",
        "unicode_uppercase.npy",
    ],
    cmd = "$(location :generate_unicode_oracle) --output-directory=$(@D)",
    tools = [":generate_unicode_oracle"],
)

loom_test(
    name = "unicode",
    srcs = ["unicode_test.loom"],
    data = [
        "unicode_records.npy",
        "unicode_uppercase.npy",
    ],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = [
        "//motif/text:unicode",
        "//motif/text:utf8",
    ],
)

loom_test(
    name = "utf8",
    srcs = ["utf8_test.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//motif/text:utf8"],
)
