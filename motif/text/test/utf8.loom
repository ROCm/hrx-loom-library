// U+FFFF encodes as ef bf bf.
check.case public @utf8_three_last {
  %point = check.literal value(65535) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(12566511) : i32
  %expected_length = check.literal value(3) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

// U+10000 encodes as f0 90 80 80.
check.case public @utf8_four_first {
  %point = check.literal value(65536) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(-2139057936) : i32
  %expected_length = check.literal value(4) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

// U+10FFFF encodes as f4 8f bf bf.
check.case public @utf8_four_last {
  %point = check.literal value(1114111) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(-1077964812) : i32
  %expected_length = check.literal value(4) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

global.rodata.def @empty = bytes("")

func.def @trim_empty() -> (i64, i64) {
  %text = global.load @empty : buffer
  %begin, %end = func.call @text.trim(%text) : (buffer) -> (offset, offset)
  %begin64 = index.cast %begin : offset to i64
  %end64 = index.cast %end : offset to i64
  func.return %begin64, %end64 : i64, i64
}

check.case public @trim_empty_bounds {
  %begin, %end = func.call @trim_empty() : () -> (i64, i64)
  %expected_begin = check.literal value(0) : i64
  %expected_end = check.literal value(0) : i64
  check.expect.equal actual(%begin) expected(%expected_begin) : i64
  check.expect.equal actual(%end) expected(%expected_end) : i64
  check.return
}

global.rodata.def @all_space = bytes("09e2808320c285")

func.def @trim_all_space() -> (i64, i64) {
  %text = global.load @all_space : buffer
  %begin, %end = func.call @text.trim(%text) : (buffer) -> (offset, offset)
  %begin64 = index.cast %begin : offset to i64
  %end64 = index.cast %end : offset to i64
  func.return %begin64, %end64 : i64, i64
}

check.case public @trim_all_space_bounds {
  %begin, %end = func.call @trim_all_space() : () -> (i64, i64)
  %expected_begin = check.literal value(7) : i64
  %expected_end = check.literal value(7) : i64
  check.expect.equal actual(%begin) expected(%expected_begin) : i64
  check.expect.equal actual(%end) expected(%expected_end) : i64
  check.return
}

