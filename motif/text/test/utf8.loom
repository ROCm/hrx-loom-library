// UTF-8 byte encodings and whitespace trim bounds from Unicode scalar values.
// Expected bytes are literal UTF-8 sequences, independent of the Loom encoder
// and decoder. Public request validation establishes valid input before these
// transforms run; malformed byte sequences are outside the motif contract.

func.decl @text.next(%text: buffer, %position: offset) -> (i32, offset)

func.decl @text.previous(%text: buffer, %end: offset) -> (i32, offset)

func.decl @text.write(%text: buffer, %position: offset, %codepoint: i32) -> (offset)

func.decl @text.trim(%text: buffer) -> (offset, offset)

func.def @encoded_word(%codepoint: i32) -> (i32, i64, i32, i32) {
  %capacity = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %text = buffer.alloca<private> align(4) %capacity : buffer
  %word = buffer.view %text[%origin] : buffer -> view<1xi32>
  %zero = scalar.constant 0 : i32
  view.store %zero, %word[0] : i32, view<1xi32>
  %end = func.call @text.write(%text, %origin, %codepoint) : (buffer, offset, i32) -> (offset)
  %bits = view.load %word[0] : view<1xi32> -> i32
  %length = index.cast %end : offset to i64
  %forward, %next = func.call @text.next(%text, %origin) : (buffer, offset) -> (i32, offset)
  %backward, %previous = func.call @text.previous(%text, %end) : (buffer, offset) -> (i32, offset)
  func.return %bits, %length, %forward, %backward : i32, i64, i32, i32
}

// U+0000 encodes as 00.
check.case public @utf8_nul {
  %point = check.literal value(0) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(0) : i32
  %expected_length = check.literal value(1) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

// U+007F encodes as 7f.
check.case public @utf8_ascii_last {
  %point = check.literal value(127) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(127) : i32
  %expected_length = check.literal value(1) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

// U+0080 encodes as c2 80.
check.case public @utf8_two_first {
  %point = check.literal value(128) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(32962) : i32
  %expected_length = check.literal value(2) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

// U+07FF encodes as df bf.
check.case public @utf8_two_last {
  %point = check.literal value(2047) : i32
  %bits, %length, %forward, %backward = func.call @encoded_word(%point) : (i32) -> (i32, i64, i32, i32)
  %expected_bits = check.literal value(49119) : i32
  %expected_length = check.literal value(2) : i64
  check.expect.equal actual(%bits) expected(%expected_bits) : i32
  check.expect.equal actual(%length) expected(%expected_length) : i64
  check.expect.equal actual(%forward) expected(%point) : i32
  check.expect.equal actual(%backward) expected(%point) : i32
  check.return
}

// U+0800 encodes as e0 a0 80.
check.case public @utf8_three_first {
  %point = check.literal value(2048) : i32
