load("//build_tools/bazel:defs.bzl", "loom_motif_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE.unicode",
    "unicode.loom",
    "utf8.loom",
])

loom_motif_library(
    name = "unicode",
    srcs = ["unicode.loom"],
)

loom_motif_library(
    name = "utf8",
    srcs = ["utf8.loom"],
    deps = [":unicode"],
)
