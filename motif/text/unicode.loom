// Host text semantics backed by the runtime's Unicode properties. Uppercase
// returns one to three codepoints with unused second/third slots set to zero.
// Python-compatible whitespace extends White_Space with U+001C through U+001F;
// model-specific punctuation and capitalization remain with the caller.
func.decl import("string", "codepoint.to_upper") pure @unicode.to_upper(%codepoint: i32) -> (i32, i32, i32, i32)

func.decl import("string", "codepoint.is_whitespace") pure @unicode.is_whitespace(%codepoint: i32) -> (i32)

func.decl import("string", "codepoint.is_digit") pure @unicode.is_digit(%codepoint: i32) -> (i32)

func.def public @text.uppercase(%codepoint: i32) -> (i32, i32, i32) {
  %count, %first, %second, %third = func.call @unicode.to_upper(%codepoint) : (i32) -> (i32, i32, i32, i32)
  func.return %first, %second, %third : i32, i32, i32
}

// Python-compatible whitespace: category Zs or bidi class WS, B, or S.
func.def public @text.is_space(%codepoint: i32) -> (i1) {
  %ascii_end = scalar.constant 128 : i32
  %ascii = scalar.cmpi ult, %codepoint, %ascii_end : i32
  %result = scf.if %ascii -> (i1) {
    %tab = scalar.constant 9 : i32
    %carriage_return = scalar.constant 13 : i32
    %separator = scalar.constant 28 : i32
    %space = scalar.constant 32 : i32
    %after_tab = scalar.cmpi uge, %codepoint, %tab : i32
    %before_return = scalar.cmpi ule, %codepoint, %carriage_return : i32
    %control = scalar.andi %after_tab, %before_return : i1
    %after_separator = scalar.cmpi uge, %codepoint, %separator : i32
    %before_space = scalar.cmpi ule, %codepoint, %space : i32
    %framing = scalar.andi %after_separator, %before_space : i1
    %inside = scalar.ori %control, %framing : i1
    scf.yield %inside : i1
  } else {
    %value = func.call @unicode.is_whitespace(%codepoint) : (i32) -> (i32)
    %false_value = scalar.constant 0 : i32
    %inside = scalar.cmpi ne, %value, %false_value : i32
    scf.yield %inside : i1
  }
  func.return %result : i1
}

// Includes both Decimal and Digit numeric types, matching str.isdigit().
func.def public @text.is_digit(%codepoint: i32) -> (i1) {
  %ascii_end = scalar.constant 128 : i32
  %ascii = scalar.cmpi ult, %codepoint, %ascii_end : i32
  %result = scf.if %ascii -> (i1) {
    %digit_begin = scalar.constant 48 : i32
    %digit_end = scalar.constant 57 : i32
    %after = scalar.cmpi uge, %codepoint, %digit_begin : i32
    %before = scalar.cmpi ule, %codepoint, %digit_end : i32
    %inside = scalar.andi %after, %before : i1
    scf.yield %inside : i1
  } else {
    %value = func.call @unicode.is_digit(%codepoint) : (i32) -> (i32)
    %false_value = scalar.constant 0 : i32
    %inside = scalar.cmpi ne, %value, %false_value : i32
    scf.yield %inside : i1
  }
  func.return %result : i1
}
