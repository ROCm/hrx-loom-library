// Independent sparse temporal-convolution reference for direct RGB8 projection.
// Coordinate-coded pixels and signed per-channel weights expose patch, RGB,
// temporal-slice, and output-channel ordering. Each temporal matrix uses two
// taps, including the last reduction element. Minimum, full-tile, and tail
// shapes share this oracle. The source has a nonzero byte origin; output has
// sentinels on both sides. Repeated and distinct input planes exercise all
// four storage/compute combinations without requiring a container decoder.

config.def @vision_patch_test.bf16 = false : i1

config.def @vision_patch_test.weights_f32 = false : i1

func.decl @vision_round(%bf16: i1, %value: f32) -> (i16)

func.decl @vision_widen(%bf16: i1, %bits: i16) -> (f32)

func.def @patch_round_reference(%value: f32) -> (f32) {
  %bf16 = config.get @vision_patch_test.bf16 : i1
  %bits = func.call @vision_round(%bf16, %value) : (i1, f32) -> (i16)
  %rounded = func.call @vision_widen(%bf16, %bits) : (i1, i16) -> (f32)
  func.return %rounded : f32
}

amdgpu.target<gfx11-generic> @vision_patch_test_wave32 {subgroup_size = 32}

template.decl @qwen38.vision.patch_embedding(%image_height: index, %image_width: index, %bf16: i1, %weights_f32: i1, %first_row: index, %source_offset: offset, %source1_offset: offset, %source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer)

config.decl @vision_test.image_height : index

config.decl @vision_test.image_width : index

func.def pure inline @patch_shape() -> (index, index, index, index) {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %c16 = index.constant 16 : index
  %c3 = index.constant 3 : index
  %patch_height = index.div %height, %c16 : index
  %patch_width = index.div %width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  %pixels = index.mul %height, %width : index
  %source_elements = index.mul %pixels, %c3 : index
  func.return %patch_height, %patch_width, %rows, %source_elements : index, index, index, index
}

kernel.def target(@vision_patch_test_wave32) @patch_embedding() {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %area = index.mul %height, %width : index
  %patch_area = index.constant 256 : index
  %rows = index.div %area, %patch_area : index
  %tile = index.constant 64 : index
  %tail = index.constant 63 : index
  %rounded_rows = index.add %rows, %tail : index
  %row_tiles = index.div %rounded_rows, %tile : index
  %output_tiles = index.constant 18 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%first_row: index, %source_offset: offset, %source1_offset: offset, %source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer) {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %bf16 = config.get @vision_patch_test.bf16 : i1
  %weights_f32 = config.get @vision_patch_test.weights_f32 : i1
  template.apply<@qwen38.vision.patch_embedding>(%height, %width, %bf16, %weights_f32, %first_row, %source_offset, %source1_offset, %source, %weight0, %weight1, %bias, %output) : (index, index, i1, i1, index, offset, offset, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

func.def @patch_pixel(%y: index, %x: index, %channel: index, %frame: index) -> (i8) {
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %c11 = index.constant 11 : index
  %phase = index.constant 67 : index
  %c256 = index.constant 256 : index
  %vertical = index.mul %y, %c5 : index
  %spatial = index.madd %x, %c3, %vertical : index
  %colored = index.madd %channel, %c11, %spatial : index
  %temporal = index.madd %frame, %phase, %colored : index
  %wrapped = index.rem %temporal, %c256 : index
  %byte = index.cast %wrapped : index to i8
  func.return %byte : i8
}

// Defines the sparse fixture, not the matrix evaluation. Both coefficients
// require rounding when F32 checkpoint storage feeds either half format.
func.def inline @patch_coefficients(%channel: index, %temporal: index) -> (index, f32, f32) {
  %c3 = index.constant 3 : index
  %c7 = index.constant 7 : index
  %c37 = index.constant 37 : index
  %c79 = index.constant 79 : index
  %c767 = index.constant 767 : index
  %phase = index.mul %temporal, %c79 : index
  %key = index.madd %channel, %c37, %phase : index
  %column = index.rem %key, %c767 : index
  %mod7 = index.rem %channel, %c7 : index
  %mod3 = index.rem %channel, %c3 : index
  %mod7_i32 = index.cast %mod7 : index to i32
  %mod3_i32 = index.cast %mod3 : index to i32
  %temporal_i32 = index.cast %temporal : index to i32
  %mod7_f32 = scalar.uitofp %mod7_i32 : i32 to f32
  %mod3_f32 = scalar.uitofp %mod3_i32 : i32 to f32
  %temporal_f32 = scalar.uitofp %temporal_i32 : i32 to f32
  %first_base = scalar.constant 0.17000000000000001 : f32
  %first_step = scalar.constant 0.012999999999999999 : f32
  %temporal_first_step = scalar.constant -0.44 : f32
  %second_base = scalar.constant -0.29999999999999999 : f32
  %second_step = scalar.constant 0.019 : f32
  %temporal_second_step = scalar.constant 0.40000000000000002 : f32
  %first_delta = scalar.mulf %mod7_f32, %first_step : f32
  %first_shift = scalar.mulf %temporal_f32, %temporal_first_step : f32
  %first0 = scalar.addf %first_base, %first_delta : f32
  %first = scalar.addf %first0, %first_shift : f32
  %second_delta = scalar.mulf %mod3_f32, %second_step : f32
  %second_shift = scalar.mulf %temporal_f32, %temporal_second_step : f32
  %second0 = scalar.addf %second_base, %second_delta : f32
  %second = scalar.addf %second0, %second_shift : f32
  func.return %column, %first, %second : index, f32, f32
}

func.def inline @patch_store_weight(%weights: buffer, %row: index, %column: index, %value: f32) {
  %origin = index.constant 0 : offset
  %bf16 = config.get @vision_patch_test.bf16 : i1
  %weights_f32 = config.get @vision_patch_test.weights_f32 : i1
  scf.if %weights_f32 {
    %view = buffer.view %weights[%origin] : buffer -> view<1152x768xf32>
    view.store %value, %view[%row, %column] : f32, view<1152x768xf32>
  } else {
    scf.if %bf16 {
      %view = buffer.view %weights[%origin] : buffer -> view<1152x768xbf16>
      %rounded = scalar.fptrunc %value : f32 to bf16
      view.store %rounded, %view[%row, %column] : bf16, view<1152x768xbf16>
    } else {
      %view = buffer.view %weights[%origin] : buffer -> view<1152x768xf16>
      %rounded = scalar.fptrunc %value : f32 to f16
      view.store %rounded, %view[%row, %column] : f16, view<1152x768xf16>
    }
  }
  func.return
}

func.def @patch_sample_reference(%patch_y: index, %patch_x: index, %column: index, %frame: index) -> (f32) {
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %channel = index.div %column, %c256 : index
  %element = index.rem %column, %c256 : index
  %dy = index.div %element, %c16 : index
  %dx = index.rem %element, %c16 : index
  %y = index.madd %patch_y, %c16, %dy : index
  %x = index.madd %patch_x, %c16, %dx : index
  %byte = func.call @patch_pixel(%y, %x, %channel, %frame) : (index, index, index, index) -> (i8)
  %wide = scalar.extui %byte : i8 to i32
  %sample = scalar.uitofp %wide : i32 to f32
  %range = scalar.constant 255.0 : f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c2_f32 = scalar.constant 2.0 : f32
  %unit = scalar.divf %sample, %range : f32
  %doubled = scalar.mulf %unit, %c2_f32 : f32
  %normalized = scalar.subf %doubled, %c1_f32 : f32
  %rounded = func.call @patch_round_reference(%normalized) : (f32) -> (f32)
  func.return %rounded : f32
}

func.def @patch_fixture(%second_frame: index, %source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %expected: buffer) {
  %origin = index.constant 0 : offset
  %source_origin = index.constant 37 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %patch_height, %patch_width, %rows, %source_elements = func.call pure @patch_shape() : () -> (index, index, index, index)
  %width = config.get @vision_test.image_width : index
  %blocks_per_row = index.div %patch_width, %c2 : index
  %c767 = index.constant 767 : index
  %channels = index.constant 1152 : index
  %source_view = buffer.view %source[%source_origin] : buffer -> view<[%source_elements]xi8>
  %source_bytes = index.cast %source_elements : index to offset
  %source1_origin = index.add %source_origin, %source_bytes : offset
  %source1_view = buffer.view %source[%source1_origin] : buffer -> view<[%source_elements]xi8>
  %bias_view = buffer.view %bias[%origin] : buffer -> view<1152xf32>
  %expected_view = buffer.view %expected[%origin] : buffer -> view<[%rows]x1152xf32>
  scf.for %element = [%c0 to %source_elements step %c1] {
    %pixel = index.div %element, %c3 : index
    %channel = index.rem %element, %c3 : index
    %y = index.div %pixel, %width : index
    %x = index.rem %pixel, %width : index
    %byte = func.call @patch_pixel(%y, %x, %channel, %c0) : (index, index, index, index) -> (i8)
    %byte1 = func.call @patch_pixel(%y, %x, %channel, %c1) : (index, index, index, index) -> (i8)
    view.store %byte, %source_view[%element] : i8, view<[%source_elements]xi8>
    view.store %byte1, %source1_view[%element] : i8, view<[%source_elements]xi8>
  }
  scf.for %channel = [%c0 to %channels step %c1] {
    %column0, %first0, %last0 = func.call @patch_coefficients(%channel, %c0) : (index, index) -> (index, f32, f32)
    %column1, %first1, %last1 = func.call @patch_coefficients(%channel, %c1) : (index, index) -> (index, f32, f32)
    func.call @patch_store_weight(%weight0, %channel, %column0, %first0) : (buffer, index, index, f32)
    func.call @patch_store_weight(%weight0, %channel, %c767, %last0) : (buffer, index, index, f32)
    func.call @patch_store_weight(%weight1, %channel, %column1, %first1) : (buffer, index, index, f32)
    func.call @patch_store_weight(%weight1, %channel, %c767, %last1) : (buffer, index, index, f32)
    %channel_i32 = index.cast %channel : index to i32
    %channel_f32 = scalar.uitofp %channel_i32 : i32 to f32
    %bias_step = scalar.constant 0.000244140625 : f32
    %bias_base = scalar.constant 0.25 : f32
    %bias_delta = scalar.mulf %channel_f32, %bias_step : f32
    %shift = scalar.addf %bias_base, %bias_delta : f32
    view.store %shift, %bias_view[%channel] : f32, view<1152xf32>
    %rounded_first0 = func.call @patch_round_reference(%first0) : (f32) -> (f32)
    %rounded_last0 = func.call @patch_round_reference(%last0) : (f32) -> (f32)
    %rounded_first1 = func.call @patch_round_reference(%first1) : (f32) -> (f32)
    %rounded_last1 = func.call @patch_round_reference(%last1) : (f32) -> (f32)
    scf.for %y = [%c0 to %patch_height step %c1] {
      %block_y = index.div %y, %c2 : index
      %within_y = index.rem %y, %c2 : index
      scf.for %x = [%c0 to %patch_width step %c1] {
        %block_x = index.div %x, %c2 : index
        %within_x = index.rem %x, %c2 : index
        %block = index.madd %block_y, %blocks_per_row, %block_x : index
        %within = index.madd %within_y, %c2, %within_x : index
        %row = index.madd %block, %c4, %within : index
        %sample0 = func.call @patch_sample_reference(%y, %x, %column0, %c0) : (index, index, index, index) -> (f32)
        %sample1 = func.call @patch_sample_reference(%y, %x, %column1, %second_frame) : (index, index, index, index) -> (f32)
        %sample_last = func.call @patch_sample_reference(%y, %x, %c767, %c0) : (index, index, index, index) -> (f32)
        %sample_last1 = func.call @patch_sample_reference(%y, %x, %c767, %second_frame) : (index, index, index, index) -> (f32)
        %product00 = scalar.mulf %sample0, %rounded_first0 : f32
        %product01 = scalar.mulf %sample_last, %rounded_last0 : f32
        %product10 = scalar.mulf %sample1, %rounded_first1 : f32
        %product11 = scalar.mulf %sample_last1, %rounded_last1 : f32
        %temporal0 = scalar.addf %product00, %product01 : f32
        %temporal1 = scalar.addf %product10, %product11 : f32
        %combined = scalar.addf %temporal0, %temporal1 : f32
        %value = scalar.addf %combined, %shift : f32
        view.store %value, %expected_view[%row, %channel] : f32, view<[%rows]x1152xf32>
      }
    }
  }
  func.return
}

// All representation combinations specialize the same public motif.
command.program.def @patch_complete(%second_frame: index) launch(%source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer) {
  %source_offset = index.constant 37 : offset
  %patch_height, %patch_width, %rows, %source_elements = func.call pure @patch_shape() : () -> (index, index, index, index)
  %source_bytes = index.cast %source_elements : index to offset
  %plane_offset = index.scale %second_frame, %source_bytes : index, offset -> offset
  %source1_offset = index.add %source_offset, %plane_offset : offset
  %first_row = index.constant 1 : index
  kernel.launch @patch_embedding(%first_row, %source_offset, %source1_offset, %source, %weight0, %weight1, %bias, %output) : (index, offset, offset, buffer, buffer, buffer, buffer, buffer)
  command.return
}

func.def @patch_expected(%source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer) {
  func.return
}

check.scenario public @vision_patch_spatial_temporal configure[2](%second_frame: index, %configuration_entropy: check.entropy) {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %patch_height, %patch_width, %rows, %source_elements = check.generate<@patch_shape>() : () -> (index, index, index, index)
    %source = check.generate.fill value(-91) : tensor<110656xi8>
    %weight0 = check.generate.fill value(0) : tensor<3538944xi8>
    %weight1 = check.generate.fill value(0) : tensor<3538944xi8>
    %bias = check.generate.fill value(0.0) : tensor<1152xf32>
    %expected_storage = check.generate.fill value(99.0) : tensor<84112xf32>
    %expected = check.tensor.view %expected_storage offset(4608) : tensor<84112xf32> -> tensor<[%rows]x1152xf32>
    check.generate<@patch_fixture>(%second_frame, %source, %weight0, %weight1, %bias, %expected) : (index, tensor<110656xi8>, tensor<3538944xi8>, tensor<3538944xi8>, tensor<1152xf32>, tensor<[%rows]x1152xf32>) -> ()
    %storage = check.generate.fill value(99.0) : tensor<84112xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<84112xf32> -> tensor<16xf32>
    %suffix = check.tensor.view %storage offset(336384) : tensor<84112xf32> -> tensor<16xf32>
    check.compare<@patch_complete, @patch_expected>[%second_frame](%source, %weight0, %weight1, %bias, %storage) : [index](tensor<110656xi8>, tensor<3538944xi8>, tensor<3538944xi8>, tensor<1152xf32>, tensor<84112xf32>) -> () {
      check.expect.approximate actual(%storage) expected(%expected_storage) atol(3.0000000000000001e-06) rtol(1.0000000000000001e-05) nan(different) : tensor<84112xf32>, tensor<84112xf32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xf32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xf32>
      check.expect.bitwise actual(%source) expected(%source) : tensor<110656xi8>
      check.expect.bitwise actual(%weight0) expected(%weight0) : tensor<3538944xi8>
      check.expect.bitwise actual(%weight1) expected(%weight1) : tensor<3538944xi8>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<1152xf32>
    }
  }
  check.return
}

check.benchmark<@vision_patch_spatial_temporal> @vision_patch_projection
