config.decl @vision_test.image_height : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.decl @vision_test.image_width : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

amdgpu.target<gfx11-generic> @normalization_wave32 {subgroup_size = 32}

func.def pure inline @normalization_rows() -> (index) {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %area = index.mul %height, %width : index
  %patch_area = index.constant 256 : index
  %rows = index.div %area, %patch_area : index
  func.return %rows : index
}

template.decl @qwen38.vision.position_statistics(%height: index, %width: index, %position: buffer, %residual: buffer, %statistics: buffer)

kernel.def target(@normalization_wave32) @position_statistics() {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %area = index.mul %height, %width : index
  %patch_area = index.constant 256 : index
  %rows = index.div %area, %patch_area : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%position: buffer, %residual: buffer, %statistics: buffer) {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  template.apply<@qwen38.vision.position_statistics>(%height, %width, %position, %residual, %statistics) : (index, index, buffer, buffer, buffer)
  kernel.return
}

template.decl @qwen38.vision.layernorm_apply(%height: index, %width: index, %residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.def target(@normalization_wave32) @layernorm_apply() {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %area = index.mul %height, %width : index
  %patch_area = index.constant 256 : index
  %rows = index.div %area, %patch_area : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  template.apply<@qwen38.vision.layernorm_apply>(%height, %width, %residual, %statistics, %weight, %bias, %output) : (index, index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// A bilinear spatial field has a closed-form interpolation at every patch.
// Alternating channel signs give exact population moments without repeating
// the device reduction or its four-corner interpolation. Both rectangular
// orientations exercise fractional positions and all 2x2 merge-block slots.
func.def @vision_position_plane(%y: f32, %x: f32, %column: index) -> (f32, f32) {
  %c2 = index.constant 2 : index
  %parity = index.rem %column, %c2 : index
  %parity_i32 = index.cast %parity : index to i32
  %parity_f32 = scalar.uitofp %parity_i32 : i32 to f32
  %c1_f32 = scalar.constant 1.0 : f32
  %c2_f32 = scalar.constant 2.0 : f32
  %unit64 = scalar.constant 0.015625 : f32
  %unit128 = scalar.constant 0.0078125 : f32
  %unit256 = scalar.constant 0.00390625 : f32
  %twice_parity = scalar.mulf %parity_f32, %c2_f32 : f32
  %sign = scalar.subf %twice_parity, %c1_f32 : f32
  %mean_y = scalar.mulf %y, %unit64 : f32
  %mean_x = scalar.mulf %x, %unit128 : f32
  %mean = scalar.addf %mean_y, %mean_x : f32
  %spread_y = scalar.mulf %y, %unit128 : f32
  %spread_x = scalar.mulf %x, %unit256 : f32
  %spread_delta = scalar.addf %spread_y, %spread_x : f32
  %spread = scalar.addf %c1_f32, %spread_delta : f32
  %signed_spread = scalar.mulf %sign, %spread : f32
  %value = scalar.addf %mean, %signed_spread : f32
  func.return %value, %sign : f32, f32
}

func.def @vision_normalization_fixture(%position: buffer, %residual: buffer, %expected_residual: buffer, %expected_statistics: buffer, %expected_output: buffer) {
  %rows = func.call pure @normalization_rows() : () -> (index)
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c48 = index.constant 48 : index
  %c1152 = index.constant 1152 : index
  %height = config.get @vision_test.image_height : index
  %width = config.get @vision_test.image_width : index
  %patch_height = index.div %height, %c16 : index
  %patch_width = index.div %width, %c16 : index
  %blocks_per_row = index.div %patch_width, %c2 : index
  %last_y = index.sub %patch_height, %c1 : index
  %last_x = index.sub %patch_width, %c1 : index
  %last_y_i32 = index.cast %last_y : index to i32
  %last_x_i32 = index.cast %last_x : index to i32
  %last_y_f32 = scalar.uitofp %last_y_i32 : i32 to f32
  %last_x_f32 = scalar.uitofp %last_x_i32 : i32 to f32
  %span = scalar.constant 47.0 : f32
  %half = scalar.constant 0.5 : f32
  %bias = scalar.constant 0.25 : f32
  %row_step = scalar.constant 0.0009765625 : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %position_view = buffer.view %position[%origin] : buffer -> view<48x48x1152xf32>
  %residual_view = buffer.view %residual[%origin] : buffer -> view<[%rows]x1152xf32>
  %expected_view = buffer.view %expected_residual[%origin] : buffer -> view<[%rows]x1152xf32>
  %statistics_view = buffer.view %expected_statistics[%origin] : buffer -> view<[%rows]x2xf32>
  %output_view = buffer.view %expected_output[%origin] : buffer -> view<[%rows]x1152xf32>
  scf.for %y = [%c0 to %c48 step %c1] {
    %y_i32 = index.cast %y : index to i32
    %y_f32 = scalar.uitofp %y_i32 : i32 to f32
    scf.for %x = [%c0 to %c48 step %c1] {
      %x_i32 = index.cast %x : index to i32
      %x_f32 = scalar.uitofp %x_i32 : i32 to f32
      scf.for %column = [%c0 to %c1152 step %c1] {
        %value, %sign = func.call @vision_position_plane(%y_f32, %x_f32, %column) : (f32, f32, index) -> (f32, f32)
        view.store %value, %position_view[%y, %x, %column] : f32, view<48x48x1152xf32>
      }
    }
  }
  scf.for %y = [%c0 to %patch_height step %c1] {
    %block_y = index.div %y, %c2 : index
    %within_y = index.rem %y, %c2 : index
    %y_i32 = index.cast %y : index to i32
    %y_f32 = scalar.uitofp %y_i32 : i32 to f32
    %y_numerator = scalar.mulf %y_f32, %span : f32
    %source_y = scalar.divf %y_numerator, %last_y_f32 : f32
    scf.for %x = [%c0 to %patch_width step %c1] {
      %block_x = index.div %x, %c2 : index
      %within_x = index.rem %x, %c2 : index
      %block = index.madd %block_y, %blocks_per_row, %block_x : index
      %within = index.madd %within_y, %c2, %within_x : index
      %row = index.madd %block, %c4, %within : index
      %row_i32 = index.cast %row : index to i32
      %row_f32 = scalar.uitofp %row_i32 : i32 to f32
      %row_mean = scalar.mulf %row_f32, %row_step : f32
      %x_i32 = index.cast %x : index to i32
      %x_f32 = scalar.uitofp %x_i32 : i32 to f32
      %x_numerator = scalar.mulf %x_f32, %span : f32
      %source_x = scalar.divf %x_numerator, %last_x_f32 : f32
      %low, %negative = func.call @vision_position_plane(%source_y, %source_x, %c0) : (f32, f32, index) -> (f32, f32)
      %high, %positive = func.call @vision_position_plane(%source_y, %source_x, %c1) : (f32, f32, index) -> (f32, f32)
      %sum = scalar.addf %low, %high : f32
      %position_mean = scalar.mulf %sum, %half : f32
      %mean = scalar.addf %position_mean, %row_mean : f32
      %difference = scalar.subf %high, %low : f32
      %position_spread = scalar.mulf %difference, %half : f32
      %spread = scalar.addf %position_spread, %half : f32
      %variance = scalar.mulf %spread, %spread : f32
      %biased_variance = scalar.addf %variance, %epsilon : f32
      %inverse = scalar.rsqrtf<afn> %biased_variance : f32
      view.store %mean, %statistics_view[%row, %c0] : f32, view<[%rows]x2xf32>
      view.store %inverse, %statistics_view[%row, %c1] : f32, view<[%rows]x2xf32>
      scf.for %column = [%c0 to %c1152 step %c1] {
        %position_value, %sign = func.call @vision_position_plane(%source_y, %source_x, %column) : (f32, f32, index) -> (f32, f32)
        %residual_spread = scalar.mulf %sign, %half : f32
        %initial = scalar.addf %row_mean, %residual_spread : f32
        %expected = scalar.addf %initial, %position_value : f32
        %centered = scalar.mulf %sign, %spread : f32
        %normalized = scalar.mulf %centered, %inverse : f32
        %output = scalar.addf %normalized, %bias : f32
        view.store %initial, %residual_view[%row, %column] : f32, view<[%rows]x1152xf32>
        view.store %expected, %expected_view[%row, %column] : f32, view<[%rows]x1152xf32>
        view.store %output, %output_view[%row, %column] : f32, view<[%rows]x1152xf32>
      }
    }
  }
  func.return
}

command.program.def @vision_normalization_complete() launch(%position: buffer, %residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  kernel.launch @position_statistics(%position, %residual, %statistics) : (buffer, buffer, buffer)
  kernel.launch @layernorm_apply(%residual, %statistics, %weight, %bias, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Independent expected values were prepared in separate observation buffers.
func.def @vision_normalization_expected(%position: buffer, %residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  func.return
}

check.scenario public @vision_normalization_plane {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %rows = check.generate<@normalization_rows>() : () -> (index)
    %position = check.generate.fill value(0.0) : tensor<2304x1152xf32>
    %residual = check.generate.fill value(2.0) : tensor<[%rows]x1152xf32>
    %statistics = check.generate.fill value(99.0) : tensor<[%rows]x2xf32>
    %weight = check.generate.fill value(1.0) : tensor<1152xf32>
    %bias = check.generate.fill value(0.25) : tensor<1152xf32>
    %output = check.generate.fill value(99.0) : tensor<[%rows]x1152xf32>
    %expected_residual = check.generate.fill value(2.0) : tensor<[%rows]x1152xf32>
    %expected_statistics = check.generate.fill value(0.0) : tensor<[%rows]x2xf32>
    %expected_output = check.generate.fill value(0.25) : tensor<[%rows]x1152xf32>
    check.generate<@vision_normalization_fixture>(%position, %residual, %expected_residual, %expected_statistics, %expected_output) : (tensor<2304x1152xf32>, tensor<[%rows]x1152xf32>, tensor<[%rows]x1152xf32>, tensor<[%rows]x2xf32>, tensor<[%rows]x1152xf32>) -> ()
    check.compare<@vision_normalization_complete, @vision_normalization_expected>(%position, %residual, %statistics, %weight, %bias, %output) : (tensor<2304x1152xf32>, tensor<[%rows]x1152xf32>, tensor<[%rows]x2xf32>, tensor<1152xf32>, tensor<1152xf32>, tensor<[%rows]x1152xf32>) -> () {
      check.expect.close actual(%residual) expected(%expected_residual) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(different) : tensor<[%rows]x1152xf32>
      check.expect.close actual(%statistics) expected(%expected_statistics) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(different) : tensor<[%rows]x2xf32>
      check.expect.close actual(%output) expected(%expected_output) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(different) : tensor<[%rows]x1152xf32>
      check.expect.bitwise actual(%position) expected(%position) : tensor<2304x1152xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<1152xf32>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<1152xf32>
    }
  }
  check.return
}

check.benchmark<@vision_normalization_plane> @position_interpolation_and_normalization

// Constant channels exercise the epsilon path: zero variance must produce
// the affine bias, with no change to the residual.
check.scenario public @vision_normalization_uniform {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %rows = check.generate<@normalization_rows>() : () -> (index)
    %position = check.generate.fill value(0.0) : tensor<2304x1152xf32>
    %residual = check.generate.fill value(1.0) : tensor<[%rows]x1152xf32>
    %statistics = check.generate.fill value(99.0) : tensor<[%rows]x2xf32>
    %weight = check.generate.fill value(1.0) : tensor<1152xf32>
    %bias = check.generate.fill value(0.25) : tensor<1152xf32>
    %output = check.generate.fill value(99.0) : tensor<[%rows]x1152xf32>
    %expected = check.generate.fill value(0.25) : tensor<[%rows]x1152xf32>
    check.compare<@vision_normalization_complete, @vision_normalization_expected>(%position, %residual, %statistics, %weight, %bias, %output) : (tensor<2304x1152xf32>, tensor<[%rows]x1152xf32>, tensor<[%rows]x2xf32>, tensor<1152xf32>, tensor<1152xf32>, tensor<[%rows]x1152xf32>) -> () {
      check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(different) : tensor<[%rows]x1152xf32>
      check.expect.bitwise actual(%residual) expected(%residual) : tensor<[%rows]x1152xf32>
    }
  }
  check.return
}

check.benchmark<@vision_normalization_uniform> @zero_variance_normalization
