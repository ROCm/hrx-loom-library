load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE", "amd_gpu_execution_profile")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "workspace",
    srcs = ["workspace.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//motif/vision/qwen3_8:workspace"],
)

AMD_GPU_ACCESS_PROFILE = amd_gpu_execution_profile(
    name = "amd_gpu_access",
    runner_args = ["--sanitizer=access"],
    tags = ["notsan"],
)

loom_test(
    name = "ffn",
    srcs = ["ffn.loom", "reference.loom"],
    variants = {
        name: {"configs": {"vision_ffn_test.rows": rows}}
        for name, rows in [("minimum", "4"), ("full", "64"), ("tail", "68")]
    },
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE, AMD_GPU_ACCESS_PROFILE],
    deps = [
        "//motif/vision/qwen3_8:ffn",
        "//motif/vision/qwen3_8:normalization",
    ],
)

[
    loom_test(
        name = name,
        srcs = [name + ".loom", "reference.loom"],
        variants = {
            shape: {"configs": {"vision_test.image_height": height, "vision_test.image_width": width}}
            for shape, height, width in shapes
        },
        execution_profiles = [AMD_GPU_HARDWARE_PROFILE, AMD_GPU_ACCESS_PROFILE],
        deps = ["//motif/vision/qwen3_8:" + name],
    )
    for name, shapes in [
        ("attention", [("minimum", "32", "32"), ("full", "128", "128"), ("tail", "96", "192")]),
        ("key_value", [("minimum", "32", "32"), ("full", "32", "256"), ("tail", "96", "96")]),
    ]
]

loom_test(
    name = "merger",
    srcs = ["merger.loom", "reference.loom"],
    variants = {
        shape + "_" + columns + "_" + precision: {
            "case": "@vision_merger_" + precision,
            "configs": {
                "vision_merger_test.rows": rows,
                "vision_merger_test.columns": columns,
                "vision_merger_test.bf16": "true" if precision == "bf16" else "false",
            },
        }
        for shape, rows in [("minimum", "1"), ("full", "64"), ("tail", "70")]
        for columns in ["2560", "5120"]
        for precision in ["f16", "bf16"]
    },
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE, AMD_GPU_ACCESS_PROFILE],
    deps = ["//motif/vision/qwen3_8:merger"],
)

loom_test(
    name = "patch",
    srcs = ["patch.loom", "reference.loom"],
    variants = {
        shape + "_" + precision + "_" + storage: {"configs": {
            "vision_test.image_height": height,
            "vision_test.image_width": width,
            "vision_patch_test.bf16": "true" if precision == "bf16" else "false",
            "vision_patch_test.weights_f32": "true" if storage == "f32" else "false",
        }}
        for shape, height, width in [("minimum", "32", "32"), ("full", "128", "128"), ("tail", "64", "288")]
        for precision in ["f16", "bf16"]
        for storage in ["half", "f32"]
    },
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE, AMD_GPU_ACCESS_PROFILE],
    deps = ["//motif/vision/qwen3_8:patch"],
)

loom_test(
    name = "normalization",
    srcs = ["normalization.loom"],
    variants = {
        name: {"configs": {"vision_test.image_height": height, "vision_test.image_width": width}}
        for name, height, width in [
            ("minimum", "32", "32"),
            ("square", "256", "256"),
            ("landscape", "224", "320"),
            ("portrait", "320", "224"),
        ]
    },
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE, AMD_GPU_ACCESS_PROFILE],
    deps = ["//motif/vision/qwen3_8:normalization"],
)
