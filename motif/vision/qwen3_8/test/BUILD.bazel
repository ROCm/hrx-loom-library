load("@hrx//loom/target/amdgpu:execution_profiles.bzl", "AMD_GPU_HARDWARE_PROFILE", "amd_gpu_execution_profile")
load("@hrx//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")
load("//build_tools/bazel:defs.bzl", "loom_test")

package(default_visibility = ["//visibility:private"])

loom_test(
    name = "workspace",
    srcs = ["workspace.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    deps = ["//motif/vision/qwen3_8:workspace"],
)

AMD_GPU_ACCESS_PROFILE = amd_gpu_execution_profile(
    name = "amd_gpu_access",
    runner_args = ["--sanitizer=access"],
    tags = ["notsan"],
)

loom_test(
    name = "ffn",
    srcs = ["ffn.loom", "reference.loom"],
    execution_profiles = [AMD_GPU_HARDWARE_PROFILE, AMD_GPU_ACCESS_PROFILE],
    deps = [
        "//motif/vision/qwen3_8:ffn",
        "//motif/vision/qwen3_8:normalization",
    ],
)
