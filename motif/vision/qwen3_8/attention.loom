  %final_sum = scf.select %lane_group_even, %final_sum_even, %final_sum_odd : vector<8xf32>
  %output0_f32 = vector.divf<nnan|ninf|nsz|arcp> %final_acc0, %final_sum : vector<8xf32>
  %output1_f32 = vector.divf<nnan|ninf|nsz|arcp> %final_acc1, %final_sum : vector<8xf32>
  %output2_f32 = vector.divf<nnan|ninf|nsz|arcp> %final_acc2, %final_sum : vector<8xf32>
  %output3_f32 = vector.divf<nnan|ninf|nsz|arcp> %final_acc3, %final_sum : vector<8xf32>
  %output4_f32 = vector.divf<nnan|ninf|nsz|arcp> %final_acc4, %final_sum : vector<8xf32>
  %output0 = func.call @qwen38_vision_round_fragment(%bf16, %output0_f32) : (i1, vector<8xf32>) -> (vector<8xi16>)
  %output1 = func.call @qwen38_vision_round_fragment(%bf16, %output1_f32) : (i1, vector<8xf32>) -> (vector<8xi16>)
  %output2 = func.call @qwen38_vision_round_fragment(%bf16, %output2_f32) : (i1, vector<8xf32>) -> (vector<8xi16>)
  %output3 = func.call @qwen38_vision_round_fragment(%bf16, %output3_f32) : (i1, vector<8xf32>) -> (vector<8xi16>)
  %output4 = func.call @qwen38_vision_round_fragment(%bf16, %output4_f32) : (i1, vector<8xf32>) -> (vector<8xi16>)
