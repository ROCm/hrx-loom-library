    %context_row_valid = index.cmp ult, %context_row, %rows : index
    scf.if %context_row_valid {
      %value0 = vector.extract %output0[%element] : vector<8xi16> -> i16
      %value1 = vector.extract %output1[%element] : vector<8xi16> -> i16
      %value2 = vector.extract %output2[%element] : vector<8xi16> -> i16
      %value3 = vector.extract %output3[%element] : vector<8xi16> -> i16
      view.store %value0, %context_view[%context_row, %global_context_column0] : i16, view<[%rows]x1152xi16>
      view.store %value1, %context_view[%context_row, %global_context_column1] : i16, view<[%rows]x1152xi16>
      view.store %value2, %context_view[%context_row, %global_context_column2] : i16, view<[%rows]x1152xi16>
      view.store %value3, %context_view[%context_row, %global_context_column3] : i16, view<[%rows]x1152xi16>
      scf.if %tail_column_valid {
        %value4 = vector.extract %output4[%element] : vector<8xi16> -> i16
        view.store %value4, %context_view[%context_row, %global_context_column4] : i16, view<[%rows]x1152xi16>
      }
    }
  }
  template.return
}

template.def<@qwen38.vision.attention_output> device @qwen38_vision_attention_output_body(%rows_value: index, %bf16: i1, %context: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c1152 = index.constant 1152 : index
  %input_stage_bytes = index.constant 9216 : offset
  %weight_stage_bytes = index.constant 16384 : offset
  %c0_f32x8 = vector.constant 0.0 : vector<8xf32>

  %rows = index.assume %rows_value [range(%rows_value, 4, 65536), multiple_of(%rows_value, 4)] : index
  %tail_rows = index.rem %rows, %c64 : index
  %all_tiles_full = index.cmp eq, %tail_rows, %c0 : index

  %row_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %lane_column = index.rem %lane, %c16 : index
  %wave_row_group = index.div %subgroup, %c2 : index
  %wave_output_group = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_row_group, %c16 : index
  %wave_output = index.mul %wave_output_group, %c64 : index
  %weight_stage_row0 = index.add %wave_output, %lane_column : index
  %weight_stage_row1 = index.add %weight_stage_row0, %c16 : index
  %weight_stage_row2 = index.add %weight_stage_row1, %c16 : index
  %weight_stage_row3 = index.add %weight_stage_row2, %c16 : index
  %row_origin = index.mul %row_tile, %c64 : index
  %output_origin = index.mul %output_tile, %c128 : index
  %result_row = index.add %row_origin, %wave_row : index
  %result_column0 = index.add %output_origin, %wave_output : index
  %result_column1 = index.add %result_column0, %c16 : index
  %result_column2 = index.add %result_column1, %c16 : index
  %result_column3 = index.add %result_column2, %c16 : index

  %context_noalias, %weight_noalias, %bias_noalias, %residual_noalias, %output_noalias = buffer.assume.noalias %context, %weight, %bias, %residual, %output : buffer, buffer, buffer, buffer, buffer
  %context_view = buffer.view %context_noalias[%origin] : buffer -> view<[%rows]x1152xi16>
  %weight_view = buffer.view %weight_noalias[%origin] : buffer -> view<1152x1152xi16>
  %bias_view = buffer.view %bias_noalias[%origin] : buffer -> view<1152xf32>
  %residual_view = buffer.view %residual_noalias[%origin] : buffer -> view<[%rows]x1152xf32>
  %output_view = buffer.view %output_noalias[%origin] : buffer -> view<[%rows]x1152xf32>
  %input_stage = buffer.alloca<workgroup> align(16) %input_stage_bytes : buffer
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %input_stage_view = buffer.view %input_stage[%origin] : buffer -> view<64x72xi16>
  %weight_stage_view = buffer.view %weight_stage[%origin] : buffer -> view<128x64xi16>

  %initial = vector.fragment<init> %c0_f32x8 shape [%c16, %c16] : vector<8xf32>
  %accumulated0, %accumulated1, %accumulated2, %accumulated3 = scf.for %column_origin = [%c0 to %c1152 step %c64](%current0 = %initial : vector<8xf32>, %current1 = %initial : vector<8xf32>, %current2 = %initial : vector<8xf32>, %current3 = %initial : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    scf.for %input_round = [%c0 to %c4 step %c1] unroll schedule(linear) {
      %input_packet = index.madd %input_round, %c256, %workitem : index
      %input_stage_row = index.div %input_packet, %c16 : index
      %input_stage_packet = index.rem %input_packet, %c16 : index
      %input_stage_column = index.mul %input_stage_packet, %c4 : index
      %global_input_row = index.add %row_origin, %input_stage_row : index
      %global_input_column = index.add %column_origin, %input_stage_column : index
      %input_row_valid = index.cmp ult, %global_input_row, %rows : index
      %input_available = scalar.ori %all_tiles_full, %input_row_valid : i1
      %input_values = scf.if %input_available -> (vector<4xi16>) {
        %loaded = vector.load %context_view[%global_input_row, %global_input_column] : view<[%rows]x1152xi16> -> vector<4xi16>
        scf.yield %loaded : vector<4xi16>
      } else {
        %padding = vector.constant 0 : vector<4xi16>
        scf.yield %padding : vector<4xi16>
      }
      vector.store %input_values, %input_stage_view[%input_stage_row, %input_stage_column] : vector<4xi16>, view<64x72xi16>
    }

    scf.for %weight_round = [%c0 to %c8 step %c1] unroll schedule(linear) {
      %packet = index.madd %weight_round, %c256, %workitem : index
      %stage_row = index.div %packet, %c16 : index
      %stage_packet = index.rem %packet, %c16 : index
      %stage_column = index.mul %stage_packet, %c4 : index
      %global_weight_row = index.add %output_origin, %stage_row : index
      %global_weight_column = index.add %column_origin, %stage_column : index
      %weight_values = vector.load %weight_view[%global_weight_row, %global_weight_column] : view<1152x1152xi16> -> vector<4xi16>
      %row_lane = index.rem %stage_row, %c8 : index
      %rotation = index.mul %row_lane, %c8 : index
      %physical_column0 = index.add %stage_column, %rotation : index
      %physical_column_raw = index.rem %physical_column0, %c64 : index
      %physical_column = index.assume %physical_column_raw [range(%physical_column_raw, 0, 60), multiple_of(%physical_column_raw, 4)] : index
      vector.store %weight_values, %weight_stage_view[%stage_row, %physical_column] : vector<4xi16>, view<128x64xi16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %next0, %next1, %next2, %next3 = scf.for %fragment_column = [%c0 to %c64 step %c16](%fragment0 = %current0 : vector<8xf32>, %fragment1 = %current1 : vector<8xf32>, %fragment2 = %current2 : vector<8xf32>, %fragment3 = %current3 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
      %lhs = func.call @qwen38_vision_load_input(%bf16, %c64, %c72, %input_stage, %wave_row, %fragment_column) : (i1, index, index, buffer, index, index) -> (vector<16xi16>)
      %weight_values0 = func.call @qwen38_vision_panel_weight_fragment(%c128, %weight_stage, %weight_stage_row0, %fragment_column) : (index, buffer, index, index) -> (vector<16xi16>)
      %weight_values1 = func.call @qwen38_vision_panel_weight_fragment(%c128, %weight_stage, %weight_stage_row1, %fragment_column) : (index, buffer, index, index) -> (vector<16xi16>)
      %weight_values2 = func.call @qwen38_vision_panel_weight_fragment(%c128, %weight_stage, %weight_stage_row2, %fragment_column) : (index, buffer, index, index) -> (vector<16xi16>)
      %weight_values3 = func.call @qwen38_vision_panel_weight_fragment(%c128, %weight_stage, %weight_stage_row3, %fragment_column) : (index, buffer, index, index) -> (vector<16xi16>)

      %updated0 = func.call @qwen38_vision_product(%bf16, %lhs, %weight_values0, %fragment0) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated1 = func.call @qwen38_vision_product(%bf16, %lhs, %weight_values1, %fragment1) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated2 = func.call @qwen38_vision_product(%bf16, %lhs, %weight_values2, %fragment2) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated3 = func.call @qwen38_vision_product(%bf16, %lhs, %weight_values3, %fragment3) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      scf.yield %updated0, %updated1, %updated2, %updated3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next0, %next1, %next2, %next3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }

  %bias_column0 = index.add %result_column0, %lane_column : index
  %bias_column1 = index.add %result_column1, %lane_column : index
  %bias_column2 = index.add %result_column2, %lane_column : index
  %bias_column3 = index.add %result_column3, %lane_column : index
  %bias0 = view.load %bias_view[%bias_column0] : view<1152xf32> -> f32
  %bias1 = view.load %bias_view[%bias_column1] : view<1152xf32> -> f32
  %bias2 = view.load %bias_view[%bias_column2] : view<1152xf32> -> f32
  %bias3 = view.load %bias_view[%bias_column3] : view<1152xf32> -> f32
  %bias_vector0 = vector.splat %bias0 : vector<8xf32>
  %bias_vector1 = vector.splat %bias1 : vector<8xf32>
  %bias_vector2 = vector.splat %bias2 : vector<8xf32>
  %bias_vector3 = vector.splat %bias3 : vector<8xf32>
  %biased0 = vector.addf %accumulated0, %bias_vector0 : vector<8xf32>
  %biased1 = vector.addf %accumulated1, %bias_vector1 : vector<8xf32>
  %biased2 = vector.addf %accumulated2, %bias_vector2 : vector<8xf32>
  %biased3 = vector.addf %accumulated3, %bias_vector3 : vector<8xf32>
  %result_end = index.add %result_row, %c16 : index
  %fragment_full = index.cmp ule, %result_end, %rows : index
  %output_full = scalar.ori %all_tiles_full, %fragment_full : i1
  scf.if %output_full {
    %residual_values0 = vector.fragment.load<result> %residual_view[%result_row, %result_column0] shape [%c16, %c16] : view<[%rows]x1152xf32> -> vector<8xf32>
    %residual_values1 = vector.fragment.load<result> %residual_view[%result_row, %result_column1] shape [%c16, %c16] : view<[%rows]x1152xf32> -> vector<8xf32>
    %residual_values2 = vector.fragment.load<result> %residual_view[%result_row, %result_column2] shape [%c16, %c16] : view<[%rows]x1152xf32> -> vector<8xf32>
    %residual_values3 = vector.fragment.load<result> %residual_view[%result_row, %result_column3] shape [%c16, %c16] : view<[%rows]x1152xf32> -> vector<8xf32>
    %result0 = vector.addf %residual_values0, %biased0 : vector<8xf32>
    %result1 = vector.addf %residual_values1, %biased1 : vector<8xf32>
    %result2 = vector.addf %residual_values2, %biased2 : vector<8xf32>
    %result3 = vector.addf %residual_values3, %biased3 : vector<8xf32>
    vector.fragment.store<result> %result0, %output_view[%result_row, %result_column0] shape [%c16, %c16] : vector<8xf32>, view<[%rows]x1152xf32>
    vector.fragment.store<result> %result1, %output_view[%result_row, %result_column1] shape [%c16, %c16] : vector<8xf32>, view<[%rows]x1152xf32>
    vector.fragment.store<result> %result2, %output_view[%result_row, %result_column2] shape [%c16, %c16] : vector<8xf32>, view<[%rows]x1152xf32>
    vector.fragment.store<result> %result3, %output_view[%result_row, %result_column3] shape [%c16, %c16] : vector<8xf32>, view<[%rows]x1152xf32>
  } else {
    %lane_row_parity = index.div %lane, %c16 : index
    scf.for %element = [%c0 to %c8 step %c1] unroll {
      %row_delta = index.madd %element, %c2, %lane_row_parity : index
      %row = index.add %result_row, %row_delta : index
      %row_valid = index.cmp ult, %row, %rows : index
      scf.if %row_valid {
        %residual0 = view.load %residual_view[%row, %bias_column0] : view<[%rows]x1152xf32> -> f32
        %value0 = vector.extract %biased0[%element] : vector<8xf32> -> f32
        %result0 = scalar.addf %residual0, %value0 : f32
        view.store %result0, %output_view[%row, %bias_column0] : f32, view<[%rows]x1152xf32>
        %residual1 = view.load %residual_view[%row, %bias_column1] : view<[%rows]x1152xf32> -> f32
        %value1 = vector.extract %biased1[%element] : vector<8xf32> -> f32
        %result1 = scalar.addf %residual1, %value1 : f32
        view.store %result1, %output_view[%row, %bias_column1] : f32, view<[%rows]x1152xf32>
        %residual2 = view.load %residual_view[%row, %bias_column2] : view<[%rows]x1152xf32> -> f32
        %value2 = vector.extract %biased2[%element] : vector<8xf32> -> f32
        %result2 = scalar.addf %residual2, %value2 : f32
        view.store %result2, %output_view[%row, %bias_column2] : f32, view<[%rows]x1152xf32>
        %residual3 = view.load %residual_view[%row, %bias_column3] : view<[%rows]x1152xf32> -> f32
        %value3 = vector.extract %biased3[%element] : vector<8xf32> -> f32
        %result3 = scalar.addf %residual3, %value3 : f32
        view.store %result3, %output_view[%row, %bias_column3] : f32, view<[%rows]x1152xf32>
      }
    }
  }
  template.return
}
