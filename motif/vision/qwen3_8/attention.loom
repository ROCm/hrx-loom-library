    %value_channel0 = index.add %c0, %value_channel00 : index
    %value_channel1 = index.add %c16, %value_channel00 : index
    %value_channel2 = index.add %c32, %value_channel00 : index
    %value_channel3 = index.add %c48, %value_channel00 : index
    %value_channel4 = index.add %c64, %value_channel00 : index
    %value_values0 = func.call @qwen38_vision_value_tile(%value_noalias, %cohort_offset, %rows, %value_channel0, %key_origin) : (buffer, offset, index, index, index) -> (vector<16xi16>)
    %value_values1 = func.call @qwen38_vision_value_tile(%value_noalias, %cohort_offset, %rows, %value_channel1, %key_origin) : (buffer, offset, index, index, index) -> (vector<16xi16>)
    %value_values2 = func.call @qwen38_vision_value_tile(%value_noalias, %cohort_offset, %rows, %value_channel2, %key_origin) : (buffer, offset, index, index, index) -> (vector<16xi16>)
    %value_values3 = func.call @qwen38_vision_value_tile(%value_noalias, %cohort_offset, %rows, %value_channel3, %key_origin) : (buffer, offset, index, index, index) -> (vector<16xi16>)
    %tail_channel_valid = index.cmp ult, %lane_column, %c8 : index
    %value_values4 = scf.if %tail_channel_valid -> (vector<16xi16>) {
      %loaded = func.call @qwen38_vision_value_tile(%value_noalias, %cohort_offset, %rows, %value_channel4, %key_origin) : (buffer, offset, index, index, index) -> (vector<16xi16>)
      scf.yield %loaded : vector<16xi16>
    } else {
