    %scaled_acc0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc0, %selected_old_scale : vector<8xf32>
    %scaled_acc1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc1, %selected_old_scale : vector<8xf32>
    %scaled_acc2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc2, %selected_old_scale : vector<8xf32>
    %scaled_acc3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc3, %selected_old_scale : vector<8xf32>
    %scaled_acc4 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc4, %selected_old_scale : vector<8xf32>

    %next_acc0 = func.call @qwen38_vision_product(%bf16, %probability_lhs, %value_values0, %scaled_acc0) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
    %next_acc1 = func.call @qwen38_vision_product(%bf16, %probability_lhs, %value_values1, %scaled_acc1) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
    %next_acc2 = func.call @qwen38_vision_product(%bf16, %probability_lhs, %value_values2, %scaled_acc2) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
    %next_acc3 = func.call @qwen38_vision_product(%bf16, %probability_lhs, %value_values3, %scaled_acc3) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
    %next_acc4 = func.call @qwen38_vision_product(%bf16, %probability_lhs, %value_values4, %scaled_acc4) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
