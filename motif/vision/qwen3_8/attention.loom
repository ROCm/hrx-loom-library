// Qwen3.8 vision query projection, online attention, and residual projection.
//
// attention consumes F32 residual [rows,1152], population statistics [rows,2],
// F32 affine vectors [1152], original half QKV weights [3456,1152], and F32
// bias [3456]. Patch extents are even values in 2..256 in the trained 2x2
// merge-block order. Cohort 0..3 selects four 72-channel heads. K [rows,288]
// and transposed V [288,rows] begin at cohort_offset bytes in their buffers;
// the caller supplies their completed publication. Output is the cohort's
// disjoint 288-column slice of a complete half context [rows,1152]. first_row
// selects the segment origin in stacked residual, statistics, and context
// storage. Rotary coordinates and softmax remain local to that segment.
//
// One 128-thread wave32 group owns sixteen queries and four heads. Query
// projection uses 32-column resident panels; online softmax streams sixteen
// keys at a time without a global score matrix. Maxima, sums, rescaling, and
// accumulation are F32. Native half probabilities feed the value products.
// A 2304-byte allocation holds padded input/probability rows (40/72 elements).
// The 18432-byte cyclic weight panel becomes F32 query storage, then padded
// half query rows of 296 elements. Each row is read before compact stores may
// reuse its F32 bytes; barriers preserve that shared-storage lifetime.
//
// attention_output consumes the completed half context, half [1152,1152]
// weight, F32 [1152] bias, and F32 residual. It writes a distinct F32 residual
// [rows,1152]. Each 256-thread group reuses a 64-row by 128-output tile, with
// padded 64x72 input storage and a cyclic 128x64 weight panel. Composition
// owns the context and residual lifetimes; both algorithms allocate only LDS.
// All buffer arguments of each invocation are disjoint. Precision and shape
// are compile-known facts supplied by a leaf. No checkpoint conversion or
// runtime half-type dispatch is required.

func.decl @qwen38_vision_round_scalar(%bf16: i1, %value: f32) -> (i16)

func.decl @qwen38_vision_round_packet(%bf16: i1, %values: vector<4xf32>) -> (vector<4xi16>)

func.decl @qwen38_vision_round_fragment(%bf16: i1, %values: vector<8xf32>) -> (vector<8xi16>)

func.decl @qwen38_vision_load_input(%bf16: i1, %rows: index, %columns: index, %input: buffer, %row: index, %column: index) -> (vector<16xi16>)

func.decl @qwen38_vision_store_result(%bf16: i1, %rows: index, %columns: index, %output: buffer, %row: index, %column: index, %values: vector<8xf32>)

func.decl @qwen38_vision_product(%bf16: i1, %left: vector<16xi16>, %right: vector<16xi16>, %accumulator: vector<8xf32>) -> (vector<8xf32>)

func.decl @qwen38_vision_panel_weight_fragment(%stage_rows: index, %stage: buffer, %row: index, %fragment_column: index) -> (vector<16xi16>)

// Loads one transposed value tile without requiring padded global storage.
// Every full tile remains one vector load; only the final partial tile takes
// the scalar path.
func.def inline @qwen38_vision_value_tile(%value: buffer, %cohort_offset: offset, %rows: index, %channel: index, %key_origin: index) -> (vector<16xi16>) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %padding_values = vector.constant 0 : vector<16xi16>
  %value_global = buffer.assume.memory_space<global> %value : buffer
  %value_view = buffer.view %value_global[%cohort_offset] : buffer -> view<288x[%rows]xi16>
  %key_end = index.add %key_origin, %c16 : index
  %full = index.cmp ule, %key_end, %rows : index
  %values = scf.if %full -> (vector<16xi16>) {
    %loaded = vector.load %value_view[%channel, %key_origin] : view<288x[%rows]xi16> -> vector<16xi16>
    scf.yield %loaded : vector<16xi16>
  } else {
    %loaded = scf.for %element = [%c0 to %c16 step %c1](%current = %padding_values : vector<16xi16>) -> (vector<16xi16>) unroll {
      %row = index.add %key_origin, %element : index
      %valid = index.cmp ult, %row, %rows : index
      %next = scf.if %valid -> (vector<16xi16>) {
        %scalar = view.load %value_view[%channel, %row] : view<288x[%rows]xi16> -> i16
        %inserted = vector.insert %scalar into %current[%element] : i16, vector<16xi16>
        scf.yield %inserted : vector<16xi16>
      } else {
        scf.yield %current : vector<16xi16>
      }
      scf.yield %next : vector<16xi16>
    }
    scf.yield %loaded : vector<16xi16>
  }
  func.return %values : vector<16xi16>
}

// Reconstructs one logical 16-value fragment from a densely stored cyclic-row
// weight stage. The two eight-value reads preserve the bank geometry selected
// by the cyclic-row K/V publication layout.
func.def inline @qwen38_vision_swizzled_weight_fragment(%stage: buffer, %row: index, %fragment_column: index) -> (vector<16xi16>) {
  %origin = index.constant 0 : offset
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %stage_local = buffer.assume.memory_space<workgroup> %stage : buffer
  %stage_view = buffer.view %stage_local[%origin] : buffer -> view<288x32xi16>
  %row_lane = index.rem %row, %c4 : index
  %rotation = index.mul %row_lane, %c8 : index
  %low_column0 = index.add %fragment_column, %rotation : index
  %low_column_raw = index.rem %low_column0, %c32 : index
  %low_column = index.assume %low_column_raw [range(%low_column_raw, 0, 24), multiple_of(%low_column_raw, 8)] : index
  %logical_high_column = index.add %fragment_column, %c8 : index
  %high_column0 = index.add %logical_high_column, %rotation : index
  %high_column_raw = index.rem %high_column0, %c32 : index
  %high_column = index.assume %high_column_raw [range(%high_column_raw, 0, 24), multiple_of(%high_column_raw, 8)] : index
  %low = vector.load %stage_view[%row, %low_column] : view<288x32xi16> -> vector<8xi16>
  %high = vector.load %stage_view[%row, %high_column] : view<288x32xi16> -> vector<8xi16>
  %values = vector.concat<0> %low, %high : vector<8xi16>, vector<8xi16> -> vector<16xi16>
  func.return %values : vector<16xi16>
}

// Rotates one logical NEOX pair from the F32 query tile and returns its half
// destination values. The caller sequences rows so compact in-place stores
// never overwrite an unread F32 row.
func.def inline @qwen38_vision_rotate_query_pair(%bf16: i1, %query: buffer, %patch_width: index, %local_row: index, %row: index, %pair: index, %left_column: index, %right_column: index) -> (i16, i16) {
  %origin = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c18 = index.constant 18 : index
  %query_local = buffer.assume.memory_space<workgroup> %query : buffer
  %query_view = buffer.view %query_local[%origin] : buffer -> view<16x288xf32>
  %left = view.load %query_view[%local_row, %left_column] : view<16x288xf32> -> f32
  %right = view.load %query_view[%local_row, %right_column] : view<16x288xf32> -> f32
  %uses_y = index.cmp ult, %pair, %c18 : index
  %axis_pair = scf.if %uses_y -> (index) {
    scf.yield %pair : index
  } else {
    %x_pair = index.sub %pair, %c18 : index
    scf.yield %x_pair : index
  }
  %axis_pair_i32 = index.cast %axis_pair : index to i32
  %axis_pair_f32 = scalar.uitofp %axis_pair_i32 : i32 to f32
  %log_step = scalar.constant -0.51168557622089905 : f32
  %log_frequency = scalar.mulf %axis_pair_f32, %log_step : f32
  %frequency = scalar.expf<afn> %log_frequency : f32
  %block_width = index.div %patch_width, %c2 : index
  %merge_block = index.div %row, %c4 : index
  %within_block = index.rem %row, %c4 : index
  %block_y = index.div %merge_block, %block_width : index
  %block_x = index.rem %merge_block, %block_width : index
  %delta_y = index.div %within_block, %c2 : index
  %delta_x = index.rem %within_block, %c2 : index
  %patch_y = index.madd %block_y, %c2, %delta_y : index
  %patch_x = index.madd %block_x, %c2, %delta_x : index
  %coordinate = scf.select %uses_y, %patch_y, %patch_x : index
  %coordinate_i32 = index.cast %coordinate : index to i32
  %coordinate_f32 = scalar.uitofp %coordinate_i32 : i32 to f32
  %angle = scalar.mulf %coordinate_f32, %frequency : f32
  %sine = scalar.sinf<afn> %angle : f32
  %cosine = scalar.cosf<afn> %angle : f32
  %left_cosine = scalar.mulf %left, %cosine : f32
  %right_sine = scalar.mulf %right, %sine : f32
  %left_sine = scalar.mulf %left, %sine : f32
  %right_cosine = scalar.mulf %right, %cosine : f32
  %rotated_left0 = scalar.subf %left_cosine, %right_sine : f32
  %rotated_right0 = scalar.addf %left_sine, %right_cosine : f32
  %rotated_left = func.call @qwen38_vision_round_scalar(%bf16, %rotated_left0) : (i1, f32) -> (i16)
  %rotated_right = func.call @qwen38_vision_round_scalar(%bf16, %rotated_right0) : (i1, f32) -> (i16)
  func.return %rotated_left, %rotated_right : i16, i16
}

template.decl @qwen38.vision.attention(%patch_height_value: index, %patch_width_value: index, %bf16: i1, %first_row: index, %cohort: index, %cohort_offset: offset, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %qkv_weight: buffer, %qkv_bias: buffer, %key: buffer, %value: buffer, %output: buffer)

template.decl @qwen38.vision.attention_output(%rows_value: index, %bf16: i1, %context: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)

template.def<@qwen38.vision.attention> device @qwen38_vision_attention_body(%patch_height_value: index, %patch_width_value: index, %bf16: i1, %first_row: index, %cohort: index, %cohort_offset: offset, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %qkv_weight: buffer, %qkv_bias: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c36 = index.constant 36 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %c128 = index.constant 128 : index
  %c144 = index.constant 144 : index
  %c18 = index.constant 18 : index
  %c288 = index.constant 288 : index
  %c1152 = index.constant 1152 : index
  %negative_large = scalar.constant -1000000000.0 : f32
  %attention_scale = scalar.constant 0.11785113019775793 : f32
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_i16 = scalar.constant 0 : i16
  %c0_i16x4 = vector.constant 0 : vector<4xi16>
  %c0_i16x8 = vector.constant 0 : vector<8xi16>
  %c0_i16x16 = vector.constant 0 : vector<16xi16>
  %c0_f32x8 = vector.constant 0.0 : vector<8xf32>
  %negative_vector = vector.splat %negative_large : vector<8xf32>
  %scale_vector = vector.splat %attention_scale : vector<8xf32>

  %patch_height = index.assume %patch_height_value [range(%patch_height_value, 2, 400), multiple_of(%patch_height_value, 2)] : index
  %patch_width = index.assume %patch_width_value [range(%patch_width_value, 2, 400), multiple_of(%patch_width_value, 2)] : index
  %rows0 = index.mul %patch_height, %patch_width : index
  %rows = index.assume %rows0 [range(%rows0, 4, 65536), multiple_of(%rows0, 4)] : index

  %query_tile = kernel.workgroup.id<x> : index
  %query_origin = index.mul %query_tile, %c16 : index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 3)] : index
  %lane = kernel.subgroup.lane.id : index
  %lane_column = index.rem %lane, %c16 : index
  %lane_row_parity = index.div %lane, %c16 : index
  %head_base = index.mul %subgroup, %c72 : index
  %probability_column = index.mul %subgroup, %c16 : index
  %cohort_output_base = index.mul %cohort, %c288 : index

  %residual_noalias, %statistics_noalias, %layernorm_weight_noalias, %layernorm_bias_noalias, %qkv_weight_noalias, %qkv_bias_noalias, %key_noalias, %value_noalias, %output_noalias = buffer.assume.noalias %residual, %statistics, %layernorm_weight, %layernorm_bias, %qkv_weight, %qkv_bias, %key, %value, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %residual_global = buffer.assume.memory_space<global> %residual_noalias : buffer
  %statistics_global = buffer.assume.memory_space<global> %statistics_noalias : buffer
  %layernorm_weight_global = buffer.assume.memory_space<global> %layernorm_weight_noalias : buffer
  %layernorm_bias_global = buffer.assume.memory_space<global> %layernorm_bias_noalias : buffer
  %qkv_weight_global = buffer.assume.memory_space<global> %qkv_weight_noalias : buffer
  %qkv_bias_global = buffer.assume.memory_space<global> %qkv_bias_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  // The softmax covers only this pair. Linear operators consume the flat
  // storage across pairs after every segment has published its context rows.
  %residual_stride = index.constant 4608 : offset
  %statistics_stride = index.constant 8 : offset
  %context_stride = index.constant 2304 : offset
  %residual_offset = index.scale %first_row, %residual_stride : index, offset -> offset
  %statistics_offset = index.scale %first_row, %statistics_stride : index, offset -> offset
  %context_offset = index.scale %first_row, %context_stride : index, offset -> offset
  %residual_view = buffer.view %residual_global[%residual_offset] : buffer -> view<[%rows]x1152xf32>
  %statistics_view = buffer.view %statistics_global[%statistics_offset] : buffer -> view<[%rows]x2xf32>
  %layernorm_weight_view = buffer.view %layernorm_weight_global[%origin] : buffer -> view<1152xf32>
  %layernorm_bias_view = buffer.view %layernorm_bias_global[%origin] : buffer -> view<1152xf32>
  %qkv_weight_view = buffer.view %qkv_weight_global[%origin] : buffer -> view<3456x1152xi16>
  %qkv_bias_view = buffer.view %qkv_bias_global[%origin] : buffer -> view<3456xf32>
  %key_view = buffer.view %key_global[%cohort_offset] : buffer -> view<[%rows]x288xi16>
  %context_view = buffer.view %output_global[%context_offset] : buffer -> view<[%rows]x1152xi16>

  %input_stage_bytes = index.constant 2304 : offset
  %weight_stage_bytes = index.constant 18432 : offset
  %input_stage = buffer.alloca<workgroup> align(16) %input_stage_bytes : buffer
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %input_stage_view = buffer.view %input_stage[%origin] : buffer -> view<16x40xi16>
  %weight_stage_view = buffer.view %weight_stage[%origin] : buffer -> view<288x32xi16>
  %query_f32_view = buffer.view %weight_stage[%origin] : buffer -> view<16x288xf32>
  %query_half_view = buffer.view %weight_stage[%origin] : buffer -> view<16x296xi16>

  %initial = vector.fragment<init> %c0_f32x8 shape [%c16, %c16] : vector<8xf32>
  %query_acc0, %query_acc1, %query_acc2, %query_acc3, %query_acc4 = scf.for %column_ordinal = [%c0 to %c1152 step %c32](%current0 = %initial : vector<8xf32>, %current1 = %initial : vector<8xf32>, %current2 = %initial : vector<8xf32>, %current3 = %initial : vector<8xf32>, %current4 = %initial : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    scf.for %weight_round = [%c0 to %c18 step %c1] unroll schedule(linear) {
      %packet = index.madd %weight_round, %c128, %workitem : index
      %weight_row = index.div %packet, %c8 : index
      %weight_packet = index.rem %packet, %c8 : index
      %weight_column = index.mul %weight_packet, %c4 : index
      %global_column0 = index.add %column_ordinal, %weight_column : index
      %global_column = index.assume %global_column0 [range(%global_column0, 0, 1148), multiple_of(%global_column0, 4)] : index
      %global_weight_row = index.add %cohort_output_base, %weight_row : index
      %weights = vector.load %qkv_weight_view[%global_weight_row, %global_column] : view<3456x1152xi16> -> vector<4xi16>
      %stage_lane = index.rem %weight_row, %c4 : index
      %rotation = index.mul %stage_lane, %c8 : index
      %physical_column0 = index.add %weight_column, %rotation : index
      %physical_column_raw = index.rem %physical_column0, %c32 : index
      %physical_column = index.assume %physical_column_raw [range(%physical_column_raw, 0, 28), multiple_of(%physical_column_raw, 4)] : index
      vector.store %weights, %weight_stage_view[%weight_row, %physical_column] : vector<4xi16>, view<288x32xi16>
    }
    scf.for %input_round = [%c0 to %c1 step %c1] unroll {
      %packet = index.madd %input_round, %c128, %workitem : index
      %stage_row = index.div %packet, %c8 : index
      %stage_packet = index.rem %packet, %c8 : index
      %stage_column = index.mul %stage_packet, %c4 : index
      %input_row = index.add %query_origin, %stage_row : index
      %input_valid = index.cmp ult, %input_row, %rows : index
      %rounded = scf.if %input_valid -> (vector<4xi16>) {
        %mean = view.load %statistics_view[%input_row, %c0] : view<[%rows]x2xf32> -> f32
        %inverse = view.load %statistics_view[%input_row, %c1] : view<[%rows]x2xf32> -> f32
        %input_column0 = index.add %column_ordinal, %stage_column : index
        %input_column = index.assume %input_column0 [range(%input_column0, 0, 1148), multiple_of(%input_column0, 4)] : index
        %values = vector.load %residual_view[%input_row, %input_column] : view<[%rows]x1152xf32> -> vector<4xf32>
        %scales = vector.load %layernorm_weight_view[%input_column] : view<1152xf32> -> vector<4xf32>
        %shifts = vector.load %layernorm_bias_view[%input_column] : view<1152xf32> -> vector<4xf32>
        %mean_vector = vector.splat %mean : vector<4xf32>
        %inverse_vector = vector.splat %inverse : vector<4xf32>
        %centered = vector.subf %values, %mean_vector : vector<4xf32>
        %normalized = vector.mulf %centered, %inverse_vector : vector<4xf32>
        %scaled = vector.mulf %normalized, %scales : vector<4xf32>
        %shifted = vector.addf %scaled, %shifts : vector<4xf32>
        %values_i16 = func.call @qwen38_vision_round_packet(%bf16, %shifted) : (i1, vector<4xf32>) -> (vector<4xi16>)
        scf.yield %values_i16 : vector<4xi16>
      } else {
        scf.yield %c0_i16x4 : vector<4xi16>
      }
      vector.store %rounded, %input_stage_view[%stage_row, %stage_column] : vector<4xi16>, view<16x40xi16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %next0, %next1, %next2, %next3, %next4 = scf.for %weight_fragment = [%c0 to %c2 step %c1](%fragment0 = %current0 : vector<8xf32>, %fragment1 = %current1 : vector<8xf32>, %fragment2 = %current2 : vector<8xf32>, %fragment3 = %current3 : vector<8xf32>, %fragment4 = %current4 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
      %fragment_column = index.mul %weight_fragment, %c16 : index
      %lhs = func.call @qwen38_vision_load_input(%bf16, %c16, %c40, %input_stage, %c0, %fragment_column) : (i1, index, index, buffer, index, index) -> (vector<16xi16>)
      %weight_row00 = index.add %head_base, %lane_column : index
      %weight_row0 = index.add %c0, %weight_row00 : index
      %weight_row1 = index.add %c16, %weight_row00 : index
      %weight_row2 = index.add %c32, %weight_row00 : index
      %weight_row3 = index.add %c48, %weight_row00 : index
      %weight_row4 = index.add %c64, %weight_row00 : index
      %weights0 = func.call @qwen38_vision_swizzled_weight_fragment(%weight_stage, %weight_row0, %fragment_column) : (buffer, index, index) -> (vector<16xi16>)
      %weights1 = func.call @qwen38_vision_swizzled_weight_fragment(%weight_stage, %weight_row1, %fragment_column) : (buffer, index, index) -> (vector<16xi16>)
      %weights2 = func.call @qwen38_vision_swizzled_weight_fragment(%weight_stage, %weight_row2, %fragment_column) : (buffer, index, index) -> (vector<16xi16>)
      %weights3 = func.call @qwen38_vision_swizzled_weight_fragment(%weight_stage, %weight_row3, %fragment_column) : (buffer, index, index) -> (vector<16xi16>)
      %tail_valid = index.cmp ult, %lane_column, %c8 : index
      %weights4 = scf.if %tail_valid -> (vector<16xi16>) {
        %loaded = func.call @qwen38_vision_swizzled_weight_fragment(%weight_stage, %weight_row4, %fragment_column) : (buffer, index, index) -> (vector<16xi16>)
        scf.yield %loaded : vector<16xi16>
      } else {
        scf.yield %c0_i16x16 : vector<16xi16>
      }

      %updated0 = func.call @qwen38_vision_product(%bf16, %lhs, %weights0, %fragment0) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated1 = func.call @qwen38_vision_product(%bf16, %lhs, %weights1, %fragment1) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated2 = func.call @qwen38_vision_product(%bf16, %lhs, %weights2, %fragment2) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated3 = func.call @qwen38_vision_product(%bf16, %lhs, %weights3, %fragment3) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      %updated4 = func.call @qwen38_vision_product(%bf16, %lhs, %weights4, %fragment4) : (i1, vector<16xi16>, vector<16xi16>, vector<8xf32>) -> (vector<8xf32>)
      scf.yield %updated0, %updated1, %updated2, %updated3, %updated4 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next0, %next1, %next2, %next3, %next4 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }

  %query_channel00 = index.add %head_base, %lane_column : index
  %query_channel0 = index.add %c0, %query_channel00 : index
  %query_channel1 = index.add %c16, %query_channel00 : index
  %query_channel2 = index.add %c32, %query_channel00 : index
  %query_channel3 = index.add %c48, %query_channel00 : index
  %query_channel4 = index.add %c64, %query_channel00 : index
  %query_tail_valid = index.cmp ult, %lane_column, %c8 : index
  %global_query_channel0 = index.add %cohort_output_base, %query_channel0 : index
  %global_query_channel1 = index.add %cohort_output_base, %query_channel1 : index
  %global_query_channel2 = index.add %cohort_output_base, %query_channel2 : index
  %global_query_channel3 = index.add %cohort_output_base, %query_channel3 : index
  %global_query_channel4 = index.add %cohort_output_base, %query_channel4 : index
  %query_bias0 = view.load %qkv_bias_view[%global_query_channel0] : view<3456xf32> -> f32
  %query_bias1 = view.load %qkv_bias_view[%global_query_channel1] : view<3456xf32> -> f32
  %query_bias2 = view.load %qkv_bias_view[%global_query_channel2] : view<3456xf32> -> f32
  %query_bias3 = view.load %qkv_bias_view[%global_query_channel3] : view<3456xf32> -> f32
  %query_bias4 = scf.if %query_tail_valid -> (f32) {
    %loaded = view.load %qkv_bias_view[%global_query_channel4] : view<3456xf32> -> f32
    scf.yield %loaded : f32
  } else {
    scf.yield %c0_f32 : f32
  }
  %query_bias_vector0 = vector.splat %query_bias0 : vector<8xf32>
  %query_bias_vector1 = vector.splat %query_bias1 : vector<8xf32>
  %query_bias_vector2 = vector.splat %query_bias2 : vector<8xf32>
  %query_bias_vector3 = vector.splat %query_bias3 : vector<8xf32>
  %query_bias_vector4 = vector.splat %query_bias4 : vector<8xf32>
  %biased_query0 = vector.addf %query_acc0, %query_bias_vector0 : vector<8xf32>
  %biased_query1 = vector.addf %query_acc1, %query_bias_vector1 : vector<8xf32>
  %biased_query2 = vector.addf %query_acc2, %query_bias_vector2 : vector<8xf32>
  %biased_query3 = vector.addf %query_acc3, %query_bias_vector3 : vector<8xf32>
  %biased_query4 = vector.addf %query_acc4, %query_bias_vector4 : vector<8xf32>
  vector.fragment.store<result> %biased_query0, %query_f32_view[%c0, %head_base] shape [%c16, %c16] : vector<8xf32>, view<16x288xf32>
  %query_fragment1 = index.add %head_base, %c16 : index
  %query_fragment2 = index.add %head_base, %c32 : index
  %query_fragment3 = index.add %head_base, %c48 : index
  vector.fragment.store<result> %biased_query1, %query_f32_view[%c0, %query_fragment1] shape [%c16, %c16] : vector<8xf32>, view<16x288xf32>
  vector.fragment.store<result> %biased_query2, %query_f32_view[%c0, %query_fragment2] shape [%c16, %c16] : vector<8xf32>, view<16x288xf32>
  vector.fragment.store<result> %biased_query3, %query_f32_view[%c0, %query_fragment3] shape [%c16, %c16] : vector<8xf32>, view<16x288xf32>
  scf.if %query_tail_valid {
    scf.for %element = [%c0 to %c8 step %c1] unroll {
      %local_row = index.madd %element, %c2, %lane_row_parity : index
      %value4 = vector.extract %biased_query4[%element] : vector<8xf32> -> f32
      view.store %value4, %query_f32_view[%local_row, %query_channel4] : f32, view<16x288xf32>
    }
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  %first_head = index.div %workitem, %c36 : index
  %first_pair = index.rem %workitem, %c36 : index
  %first_head_base = index.mul %first_head, %c72 : index
  %first_left_column = index.add %first_head_base, %first_pair : index
  %first_right_column0 = index.add %first_pair, %c36 : index
  %first_right_column = index.add %first_head_base, %first_right_column0 : index
  %second_pair0 = index.add %workitem, %c128 : index
  %second_pair_valid = index.cmp ult, %second_pair0, %c144 : index
  %second_linear_pair = scf.select %second_pair_valid, %second_pair0, %c0 : index
  %second_head = index.div %second_linear_pair, %c36 : index
  %second_pair = index.rem %second_linear_pair, %c36 : index
  %second_head_base = index.mul %second_head, %c72 : index
  %second_left_column = index.add %second_head_base, %second_pair : index
  %second_right_column0 = index.add %second_pair, %c36 : index
  %second_right_column = index.add %second_head_base, %second_right_column0 : index
  scf.for %local_row = [%c0 to %c16 step %c1] {
    %row = index.add %query_origin, %local_row : index
    %rotated_left0, %rotated_right0 = func.call @qwen38_vision_rotate_query_pair(%bf16, %weight_stage, %patch_width, %local_row, %row, %first_pair, %first_left_column, %first_right_column) : (i1, buffer, index, index, index, index, index, index) -> (i16, i16)
    %rotated_left1, %rotated_right1 = scf.if %second_pair_valid -> (i16, i16) {
      %rotated_left, %rotated_right = func.call @qwen38_vision_rotate_query_pair(%bf16, %weight_stage, %patch_width, %local_row, %row, %second_pair, %second_left_column, %second_right_column) : (i1, buffer, index, index, index, index, index, index) -> (i16, i16)
      scf.yield %rotated_left, %rotated_right : i16, i16
