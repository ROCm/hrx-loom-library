try-import %workspace%/.bazelrc.hrx
try-import %workspace%/.bazelrc.local

build --color=yes
build:amdgpu --@hrx//runtime/config/hal:drivers=task,amd
build:amdgpu --@hrx//libamdf/config:enabled=true
test --test_output=errors

# Keep selected source tools and their tests on the same sanitizer contract.
build:sanitizer --strip=never
build:sanitizer --features=sanitizer_debug_info
build:sanitizer --force_ignore_dash_static
build:sanitizer --test_timeout=120,600,1800,-1
build:sanitizer --@hrx//build_tools/bazel:sanitizer=true
build:sanitizer --test_env=VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING=1
build:asan --config=sanitizer
build:asan --features=asan
build:asan --copt=-fsanitize=address
build:asan --cc_output_directory_tag=asan
build:asan --copt=-DADDRESS_SANITIZER

build:tsan --config=sanitizer
build:tsan --features=tsan
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread
build:tsan --cc_output_directory_tag=tsan
build:tsan --copt=-DTHREAD_SANITIZER

build:ubsan --config=sanitizer
build:ubsan --features=ubsan
build:ubsan --copt=-fsanitize=undefined
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize=function
build:ubsan --cxxopt=-fno-sanitize=vptr
build:ubsan --cc_output_directory_tag=ubsan

build:opt --compilation_mode=opt
build:opt --features=thin_lto_link
build:opt --features=optimize_for_speed
build:opt --host_features=optimize_for_speed
