module(
    name = "hrx_loom_library",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "hrx", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Pin the complete Loom rule and source-toolchain identity to one immutable HRX
# revision. Local compiler development uses Bazel's --override_module flag and
# never edits this file.
git_override(
    module_name = "hrx",
    commit = "0308c6e906b021b211a4377ebb471868ef9fbeec",
    remote = "https://github.com/ROCm/hrx-system.git",
)

loom_sdk = use_repo_rule("//build_tools/bazel:sdk_repository.bzl", "loom_sdk_repository")

loom_sdk(name = "loom_sdk")

register_toolchains("@loom_sdk//:all")
