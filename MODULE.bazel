module(
    name = "hrx_loom_library",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "hrx", version = "0.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Pin the complete Loom rule and source-toolchain identity to one immutable HRX
# revision. Local compiler development uses Bazel's --override_module flag and
# never edits this file.
git_override(
    module_name = "hrx",
    commit = "a20cd9e8ecb5c75080dc55dcaefdeb7d247dd315",
    remote = "https://github.com/ROCm/hrx-system.git",
)

loom_sdk = use_repo_rule("//build_tools/bazel:sdk_repository.bzl", "loom_sdk_repository")

loom_sdk(name = "loom_sdk")

register_toolchains("@loom_sdk//:all")

# Independent prompt-normalization reference used only by Pocket's text tests.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "pocket_text_reference",
    downloaded_file_path = "text_chunking.py",
    sha256 = "215a78549b527495206b93e0941449a8ffb30be1bcf6aa311f5de8ea0d8716d3",
    url = "https://raw.githubusercontent.com/kyutai-labs/pocket-tts/ec569b2dd3fec4a601b391aace185791e92b3785/pocket_tts/models/text_chunking.py",
)
