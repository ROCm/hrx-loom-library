module(
    name = "hrx_loom_library",
    version = "0.0.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "hrx", version = "0.0.0")

# Pin the complete Loom rule and source-toolchain identity to one immutable HRX
# revision. Local compiler development uses Bazel's --override_module flag and
# never edits this file.
git_override(
    module_name = "hrx",
    commit = "aa58e4f4613e2a81029a8b4f8a051774d2cd5ee2",
    remote = "https://github.com/ROCm/hrx-system.git",
)

# Model assets are immutable build inputs. Bazel's repository cache or distdir
# can satisfy these without contacting the publisher again.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "moonshine_checkpoint",
    downloaded_file_path = "model.safetensors",
    sha256 = "0ab3443dabd95a4afb35f0a26155428c03b7c3c450fa6923ffdac4510ba3d040",
    urls = ["https://huggingface.co/moonshine-ai/moonshine-streaming-tiny/resolve/f8e9dfd8c562c257c151a907b7b7f2fe8ff8511a/model.safetensors"],
)

http_file(
    name = "moonshine_tokenizer",
    downloaded_file_path = "tokenizer.json",
    sha256 = "28bbc54a47dfa33673affa26010f23ac452685b18c76e81451d9b3ea25a54d54",
    urls = ["https://huggingface.co/moonshine-ai/moonshine-streaming-tiny/resolve/f8e9dfd8c562c257c151a907b7b7f2fe8ff8511a/tokenizer.json"],
)
